+package adapter
+
+import (
+	"context"
+	"encoding/json"
+	"errors"
+	"io"
+	"net"
+	"net/http"
+	"net/http/httptest"
+	"sync"
+	"sync/atomic"
+	"testing"
+	"time"
+
+	"github.com/metacubex/mihomo/adapter/outbound"
+	"github.com/metacubex/mihomo/common/utils"
+	"github.com/metacubex/mihomo/component/urltesttrace"
+	C "github.com/metacubex/mihomo/constant"
+)
+
+func probeExpected(t *testing.T) utils.IntRanges[uint16] {
+	t.Helper()
+	r, err := utils.NewUnsignedRanges[uint16]("204")
+	if err != nil {
+		t.Fatal(err)
+	}
+	return r
+}
+
+func probeUnified(t *testing.T) {
+	t.Helper()
+	previous := UnifiedDelay.Load()
+	UnifiedDelay.Store(true)
+	t.Cleanup(func() { UnifiedDelay.Store(previous) })
+}
+
+func probeProxy() *Proxy { return NewProxy(outbound.NewDirect()) }
+
+func TestPocketProbeWarmIsActualReusedConnection(t *testing.T) {
+	probeUnified(t)
+	var mu sync.Mutex
+	var peers []string
+	s := httptest.NewServer(http.HandlerFunc(func(w http.ResponseWriter, r *http.Request) {
+		mu.Lock()
+		peers = append(peers, r.RemoteAddr)
+		mu.Unlock()
+		time.Sleep(35 * time.Millisecond)
+		w.Header().Set("Content-Length", "0")
+		w.WriteHeader(204)
+	}))
+	defer s.Close()
+	ctx, trace := urltesttrace.WithContext(context.Background())
+	p := probeProxy()
+	delay, err := p.URLTest(ctx, s.URL, probeExpected(t))
+	if err != nil || delay == 0 {
+		t.Fatalf("delay=%d err=%v", delay, err)
+	}
+	mu.Lock()
+	defer mu.Unlock()
+	if len(peers) != 2 || peers[0] != peers[1] || !trace.SecondConnectionReused || !trace.WarmSucceeded || trace.Kind != "warm" {
+		t.Fatalf("Not actual same-connection warm response: peers=%v trace=%+v", peers, trace)
+	}
+	if delta := int64(delay) - trace.WarmMs; delta < 0 || delta > 3 {
+		t.Fatalf("delay does not match real second request: %+v delay=%d", trace, delay)
+	}
+	if trace.DialCount != 1 || trace.Attempts != 2 {
+		t.Fatalf("warm probe unexpectedly redialled: %+v", trace)
+	}
+	if !p.AliveForTestUrl(s.URL) || trace.FirstStatus != 204 || trace.SecondStatus != 204 || trace.WarmError != "" {
+		t.Fatalf("trace=%+v", trace)
+	}
+}
+
+func TestPocketProbeConnectionCloseMakesARealColdRetest(t *testing.T) {
+	probeUnified(t)
+	var received atomic.Int32
+	s := httptest.NewServer(http.HandlerFunc(func(w http.ResponseWriter, r *http.Request) {
+		received.Add(1)
+		time.Sleep(20 * time.Millisecond)
+		w.Header().Set("Connection", "close")
+		w.Header().Set("Content-Length", "0")
+		w.WriteHeader(204)
+	}))
+	defer s.Close()
+	ctx, trace := urltesttrace.WithContext(context.Background())
+	p := probeProxy()
+	delay, err := p.URLTest(ctx, s.URL, probeExpected(t))
+	if err != nil || received.Load() != 2 || trace.Kind != "cold-retest" || !trace.WarmSucceeded || trace.SecondConnectionReused || !trace.WarmAttempted || trace.DialCount != 2 || trace.Attempts != 2 {
+		t.Fatalf("delay=%d err=%v received=%d trace=%+v", delay, err, received.Load(), trace)
+	}
+	if int64(delay) != trace.WarmMs || !p.AliveForTestUrl(s.URL) {
+		t.Fatalf("cold retest's actual time changed: delay=%d trace=%+v", delay, trace)
+	}
+}
+
+func TestPocketProbeSecondResetCannotInflateFirstLatency(t *testing.T) {
+	probeUnified(t)
+	var received atomic.Int32
+	s := httptest.NewServer(http.HandlerFunc(func(w http.ResponseWriter, r *http.Request) {
+		if received.Add(1) >= 2 {
+			conn, _, err := w.(http.Hijacker).Hijack()
+			if err != nil {
+				panic(err)
+			}
+			time.Sleep(180 * time.Millisecond)
+			_ = conn.(*net.TCPConn).SetLinger(0)
+			_ = conn.Close()
+			return
+		}
+		time.Sleep(20 * time.Millisecond)
+		w.Header().Set("Content-Length", "0")
+		w.WriteHeader(204)
+	}))
+	defer s.Close()
+	ctx, trace := urltesttrace.WithContext(context.Background())
+	p := probeProxy()
+	delay, err := p.URLTest(ctx, s.URL, probeExpected(t))
+	if err != nil || received.Load() < 2 || trace.Kind != "cold-fallback" || trace.WarmSucceeded || trace.WarmError != "transport" {
+		t.Fatalf("delay=%d err=%v trace=%+v", delay, err, trace)
+	}
+	if int64(delay) != trace.FirstMs || trace.WarmMs < 170 || trace.TotalMs < trace.FirstMs+170 || !p.AliveForTestUrl(s.URL) {
+		t.Fatalf("failed second wait leaked into valid first latency: delay=%d trace=%+v", delay, trace)
+	}
+}
+
+func TestPocketProbeDeadlineIsNotWarmSuccess(t *testing.T) {
+	probeUnified(t)
+	var received atomic.Int32
+	s := httptest.NewServer(http.HandlerFunc(func(w http.ResponseWriter, r *http.Request) {
+		if received.Add(1) == 2 {
+			<-r.Context().Done()
+			return
+		}
+		time.Sleep(15 * time.Millisecond)
+		w.Header().Set("Content-Length", "0")
+		w.WriteHeader(204)
+	}))
+	defer s.Close()
+	base, cancel := context.WithTimeout(context.Background(), 150*time.Millisecond)
+	defer cancel()
+	ctx, trace := urltesttrace.WithContext(base)
+	delay, err := probeProxy().URLTest(ctx, s.URL, probeExpected(t))
+	if err != nil || !errors.Is(ctx.Err(), context.DeadlineExceeded) || trace.WarmError != "timeout" || trace.WarmSucceeded || trace.Kind != "cold-fallback" || int64(delay) != trace.FirstMs {
+		t.Fatalf("timeout became a successful warm sample: delay=%d err=%v trace=%+v", delay, err, trace)
+	}
+}
+
+func TestPocketProbeCancellationStopsInFlightSecondRequest(t *testing.T) {
+	probeUnified(t)
+	var received atomic.Int32
+	secondStarted := make(chan struct{})
+	serverCancelled := make(chan struct{})
+	s := httptest.NewServer(http.HandlerFunc(func(w http.ResponseWriter, r *http.Request) {
+		if received.Add(1) == 2 {
+			close(secondStarted)
+			<-r.Context().Done()
+			close(serverCancelled)
+			return
+		}
+		time.Sleep(15 * time.Millisecond)
+		w.Header().Set("Content-Length", "0")
+		w.WriteHeader(204)
+	}))
+	defer s.Close()
+	base, cancel := context.WithCancel(context.Background())
+	defer cancel()
+	ctx, trace := urltesttrace.WithContext(base)
+	done := make(chan error, 1)
+	go func() { _, err := probeProxy().URLTest(ctx, s.URL, probeExpected(t)); done <- err }()
+	select {
+	case <-secondStarted:
+	case <-time.After(time.Second):
+		t.Fatal("second HEAD never started")
+	}
+	cancel()
+	select {
+	case err := <-done:
+		if err != nil {
+			t.Fatal(err)
+		}
+	case <-time.After(time.Second):
+		t.Fatal("URLTest ignored context cancellation")
+	}
+	select {
+	case <-serverCancelled:
+	case <-time.After(time.Second):
+		t.Fatal("actual HTTP exchange did not cancel")
+	}
+	if trace.WarmSucceeded || trace.WarmError != "cancelled" || trace.Kind != "cold-fallback" {
+		t.Fatalf("trace=%+v", trace)
+	}
+}
+
+func TestPocketProbeUntrustedTlsCannotCreateAHealthySample(t *testing.T) {
+	probeUnified(t)
+	var received atomic.Int32
+	s := httptest.NewTLSServer(http.HandlerFunc(func(w http.ResponseWriter, r *http.Request) { received.Add(1); w.WriteHeader(204) }))
+	defer s.Close()
+	ctx, trace := urltesttrace.WithContext(context.Background())
+	p := probeProxy()
+	delay, err := p.URLTest(ctx, s.URL, probeExpected(t))
+	if err == nil || delay != 0 || p.AliveForTestUrl(s.URL) || received.Load() != 0 || trace.WarmAttempted || trace.FirstMs != -1 || trace.Error != "transport" {
+		t.Fatalf("TLS rejection was weakened: delay=%d err=%v trace=%+v", delay, err, trace)
+	}
+}
+
+func TestPocketProbeUnexpectedStatusStillFailsHealth(t *testing.T) {
+	probeUnified(t)
+	s := httptest.NewServer(http.HandlerFunc(func(w http.ResponseWriter, r *http.Request) { time.Sleep(5 * time.Millisecond); w.WriteHeader(403) }))
+	defer s.Close()
+	ctx, trace := urltesttrace.WithContext(context.Background())
+	p := probeProxy()
+	_, err := p.URLTest(ctx, s.URL, probeExpected(t))
+	if err != nil || p.AliveForTestUrl(s.URL) || trace.FirstStatus != 403 || trace.SecondStatus != 403 || trace.WarmSucceeded || trace.Error != "unexpected-status" {
+		t.Fatalf("expected status protection changed: err=%v trace=%+v", err, trace)
+	}
+}
+
+func TestPocketProbeSecondExpectedStatusKeepsOriginalHealthSemantics(t *testing.T) {
+	probeUnified(t)
+	var received atomic.Int32
+	s := httptest.NewServer(http.HandlerFunc(func(w http.ResponseWriter, r *http.Request) {
+		time.Sleep(5 * time.Millisecond)
+		if received.Add(1) == 1 {
+			w.WriteHeader(403)
+		} else {
+			w.WriteHeader(204)
+		}
+	}))
+	defer s.Close()
+	ctx, trace := urltesttrace.WithContext(context.Background())
+	p := probeProxy()
+	delay, err := p.URLTest(ctx, s.URL, probeExpected(t))
+	if err != nil || delay == 0 || !p.AliveForTestUrl(s.URL) || !trace.WarmSucceeded || trace.Kind != "warm" || trace.FirstStatus != 403 || trace.SecondStatus != 204 {
+		t.Fatalf("successful second expected response stopped being healthy: delay=%d err=%v trace=%+v", delay, err, trace)
+	}
+}
+
+type lateProbeAdapter struct {
+	C.ProxyAdapter
+	calls   atomic.Int32
+	started chan struct{}
+	release chan struct{}
+	closed  chan struct{}
+}
+
+type closingProbeConn struct {
+	C.Conn
+	closed chan struct{}
+	once   sync.Once
+}
+
+func (c *closingProbeConn) Close() error {
+	c.once.Do(func() { close(c.closed) })
+	return c.Conn.Close()
+}
+
+func (p *lateProbeAdapter) DialContext(ctx context.Context, metadata *C.Metadata) (C.Conn, error) {
+	if p.calls.Add(1) == 1 {
+		return p.ProxyAdapter.DialContext(ctx, metadata)
+	}
+	close(p.started)
+	<-p.release
+	// Deliberately violate cancellation in this fixture to reproduce a tardy
+	// asynchronous HTTP dial completion. Ownership must still close the socket.
+	conn, err := p.ProxyAdapter.DialContext(context.Background(), metadata)
+	if err != nil {
+		return nil, err
+	}
+	return &closingProbeConn{Conn: conn, closed: p.closed}, nil
+}
+
+func TestPocketProbeLateRedialCompletionCannotLeakAConnection(t *testing.T) {
+	probeUnified(t)
+	s := httptest.NewServer(http.HandlerFunc(func(w http.ResponseWriter, r *http.Request) {
+		time.Sleep(5 * time.Millisecond)
+		w.Header().Set("Connection", "close")
+		w.WriteHeader(204)
+	}))
+	defer s.Close()
+	proxy := &lateProbeAdapter{ProxyAdapter: outbound.NewDirect(), started: make(chan struct{}), release: make(chan struct{}), closed: make(chan struct{})}
+	base, cancel := context.WithCancel(context.Background())
+	defer cancel()
+	ctx, trace := urltesttrace.WithContext(base)
+	expected := probeExpected(t)
+	done := make(chan struct{})
+	go func() { _, _ = NewProxy(proxy).URLTest(ctx, s.URL, expected); close(done) }()
+	select {
+	case <-proxy.started:
+	case <-time.After(time.Second):
+		t.Fatal("redial never started")
+	}
+	cancel()
+	select {
+	case <-done:
+	case <-time.After(time.Second):
+		t.Fatal("probe could not cancel the held redial")
+	}
+	close(proxy.release)
+	select {
+	case <-proxy.closed:
+	case <-time.After(time.Second):
+		t.Fatal("late native connection was leaked after probe ended")
+	}
+	if trace.WarmSucceeded || trace.WarmError != "cancelled" {
+		t.Fatalf("trace=%+v", trace)
+	}
+}
+
+func TestPocketProbeOptionalTraceNeverLeaksRawErrors(t *testing.T) {
+	if urltesttrace.FromContext(context.Background()) != nil {
+		t.Fatal("untraced callers gained global trace state")
+	}
+	for _, sample := range []struct {
+		err  error
+		kind string
+	}{
+		{nil, ""}, {context.Canceled, "cancelled"}, {context.DeadlineExceeded, "timeout"},
+		{io.ErrUnexpectedEOF, "transport"}, {errors.New("https://user:secret@private.example/secret"), "transport"},
+	} {
+		if got := urltesttrace.ErrorKind(sample.err); got != sample.kind {
+			t.Fatalf("kind=%q want=%q", got, sample.kind)
+		}
+	}
+	_, trace := urltesttrace.WithContext(context.Background())
+	trace.WarmError = urltesttrace.ErrorKind(errors.New("https://user:secret@private.example/secret"))
+	data, err := json.Marshal(trace)
+	if err != nil {
+		t.Fatal(err)
+	}
+	var value map[string]any
+	if err := json.Unmarshal(data, &value); err != nil {
+		t.Fatal(err)
+	}
+	if value["schema"] != float64(1) || value["warmError"] != "transport" {
+		t.Fatalf("unexpected trace: %s", data)
+	}
+}

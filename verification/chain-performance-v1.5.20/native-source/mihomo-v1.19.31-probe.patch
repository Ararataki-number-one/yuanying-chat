+// Package urltesttrace records one optional controller probe, without changing
+// the Proxy.URLTest interface or retaining URLs, credentials or connection pools.
+package urltesttrace
+
+import (
+	"context"
+	"errors"
+	"net"
+)
+
+type key struct{}
+
+// Probe timings use monotonic durations. firstMs includes chain establishment;
+// warmMs is the second attempt's elapsed time, not a valid latency when it fails.
+// A successful second request is warm only when the HTTP transport proves reuse.
+type Probe struct {
+	Schema                 int    `json:"schema"`
+	DialCount              int    `json:"dialCount"`
+	Attempts               int    `json:"attempts"`
+	FirstMs                int64  `json:"firstMs"`
+	WarmMs                 int64  `json:"warmMs"`
+	TotalMs                int64  `json:"totalMs"`
+	WarmAttempted          bool   `json:"warmAttempted"`
+	WarmSucceeded          bool   `json:"warmSucceeded"`
+	SecondConnectionReused bool   `json:"secondConnectionReused"`
+	Kind                   string `json:"kind"`
+	FirstStatus            int    `json:"firstStatus"`
+	SecondStatus           int    `json:"secondStatus"`
+	WarmError              string `json:"warmError"`
+	Error                  string `json:"error,omitempty"`
+}
+
+func WithContext(ctx context.Context) (context.Context, *Probe) {
+	p := &Probe{Schema: 1, FirstMs: -1, WarmMs: -1, Kind: "first"}
+	return context.WithValue(ctx, key{}, p), p
+}
+
+func FromContext(ctx context.Context) *Probe {
+	p, _ := ctx.Value(key{}).(*Probe)
+	return p
+}
+
+// ErrorKind is a deliberately closed vocabulary: raw transport error strings
+// can contain a URL or proxy credentials and must never be copied into a trace.
+func ErrorKind(err error) string {
+	if err == nil {
+		return ""
+	}
+	if errors.Is(err, context.Canceled) {
+		return "cancelled"
+	}
+	if errors.Is(err, context.DeadlineExceeded) {
+		return "timeout"
+	}
+	var timeout net.Error
+	if errors.As(err, &timeout) && timeout.Timeout() {
+		return "timeout"
+	}
+	return "transport"
+}

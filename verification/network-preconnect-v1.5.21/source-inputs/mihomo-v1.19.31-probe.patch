+// A real duplex stream proves an authenticated socket can remain unbound until
+// checkout; the authentication helper cannot know or emit a future target.
+func TestPreconnectRealStreamAuthenticationAndLaterCommand(t *testing.T) {
+	client, server := net.Pipe()
+	defer client.Close()
+	defer server.Close()
+	_ = client.SetDeadline(time.Now().Add(2 * time.Second))
+	_ = server.SetDeadline(time.Now().Add(2 * time.Second))
+	result := make(chan error, 1)
+	go func() {
+		greeting := make([]byte, 3)
+		if _, err := io.ReadFull(server, greeting); err != nil {
+			result <- err
+			return
+		}
+		if !bytes.Equal(greeting, []byte{5, 1, 0}) {
+			result <- errors.New("wrong greeting")
+			return
+		}
+		if _, err := server.Write([]byte{5, 0}); err != nil {
+			result <- err
+			return
+		}
+		request := make([]byte, len(preconnectCommand))
+		if _, err := io.ReadFull(server, request); err != nil {
+			result <- err
+			return
+		}
+		if !bytes.Equal(request, preconnectCommand) {
+			result <- errors.New("wrong CONNECT bytes")
+			return
+		}
+		_, err := server.Write(preconnectSuccess)
+		result <- err
+	}()
+	if err := ClientAuthenticate(client, nil); err != nil {
+		t.Fatal(err)
+	}
+	// It returned with a real server waiting for a target; no command/payload was
+	// written by authentication. Checkout then commits exactly one CONNECT.
+	bind, err := ClientCommand(client, preconnectTarget, CmdConnect)
+	if err != nil || !bytes.Equal(bind, preconnectBind) {
+		t.Fatalf("real split transaction: bind=%x error=%v", bind, err)
+	}
+	if err := <-result; err != nil {
+		t.Fatal(err)
+	}
+}
+
+func TestPreconnectIdleAuthenticatedStreamCanBeDiscardedWithoutCommand(t *testing.T) {
+	client, server := net.Pipe()
+	defer server.Close()
+	_ = client.SetDeadline(time.Now().Add(2 * time.Second))
+	_ = server.SetDeadline(time.Now().Add(2 * time.Second))
+	result := make(chan error, 1)
+	go func() {
+		greeting := make([]byte, 3)
+		_, err := io.ReadFull(server, greeting)
+		if err == nil {
+			_, err = server.Write([]byte{5, 0})
+		}
+		if err != nil {
+			result <- err
+			return
+		}
+		one := make([]byte, 1)
+		n, err := server.Read(one)
+		if n != 0 || !errors.Is(err, io.EOF) {
+			result <- errors.New("discard must not send any command or payload")
+			return
+		}
+		result <- nil
+	}()
+	if err := ClientAuthenticate(client, nil); err != nil {
+		client.Close()
+		t.Fatal(err)
+	}
+	client.Close()
+	if err := <-result; err != nil {
+		t.Fatal(err)
+	}
+}

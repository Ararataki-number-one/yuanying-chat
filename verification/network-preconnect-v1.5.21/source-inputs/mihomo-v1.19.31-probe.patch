+type PocketRoute struct {
+	Key           string
+	Changed       <-chan struct{}
+	ConfigChanged <-chan struct{}
+	Valid         func() bool
+	Dial          func(context.Context, string) (net.Conn, error)
+}
+
+var pocketConfig = struct {
+	sync.Mutex
+	serial  uint64
+	changed chan struct{}
+}{serial: 1, changed: make(chan struct{})}
+
+// PocketInvalidateRoutes is called on every tunnel config replacement, before publication.
+func PocketInvalidateRoutes() {
+	pocketConfig.Lock()
+	pocketConfig.serial++
+	close(pocketConfig.changed)
+	pocketConfig.changed = make(chan struct{})
+	pocketConfig.Unlock()
+}
+
+func pocketConfigSnapshot() (uint64, <-chan struct{}) {

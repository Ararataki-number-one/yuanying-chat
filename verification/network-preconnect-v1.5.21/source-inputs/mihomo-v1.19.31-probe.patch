+package outbound
+
+import (
+	"context"
+	"errors"
+	"io"
+	"net"
+	"os"
+	"path/filepath"
+	"strings"
+	"sync"
+	"syscall"
+	"time"
+
+	"github.com/metacubex/mihomo/component/proxydialer"
+	C "github.com/metacubex/mihomo/constant"
+	"github.com/metacubex/mihomo/transport/socks5"
+	"github.com/metacubex/tls"
+)
+
+const pocketPreconnectTTL = 8 * time.Second
+const pocketEpochPoll = 50 * time.Millisecond
+
+var errPocketRouteChanged = errors.New("preconnect route changed")
+
+type pocketFreezer interface {
+	PocketFreeze(string) (*proxydialer.PocketRoute, error)
+}
+
+// The file is a private, atomically replaced Android network-generation receipt.
+// Missing/blocked/oversized files never grant socket reuse.
+func pocketReadEpoch(path string) string {
+	if !filepath.IsAbs(path) {
+		return ""
+	}
+	f, err := os.Open(path)
+	if err != nil {
+		return ""
+	}
+	defer f.Close()
+	stat, err := f.Stat()
+	if err != nil || !stat.Mode().IsRegular() || stat.Size() > 256 {
+		return ""
+	}
+	b, err := io.ReadAll(io.LimitReader(f, 257))
+	if err != nil || len(b) > 256 {
+		return ""
+	}
+	s := strings.TrimSuffix(string(b), "\n")
+	if !strings.HasPrefix(s, "ready:") || len(s) < 7 {
+		return ""
+	}
+	for _, r := range s[6:] {
+		if !(r >= 'A' && r <= 'Z' || r >= 'a' && r <= 'z' || r >= '0' && r <= '9' || r == '-' || r == '_') {
+			return ""
+		}
+	}
+	return s
+}
+
+type pocketSocksItem struct {
+	mu         sync.Mutex
+	ctx        context.Context
+	cancel     context.CancelFunc
+	conn       net.Conn
+	stopped    bool
+	done       chan struct{}
+	route      *proxydialer.PocketRoute
+	epoch, key string
+	expires    time.Time
+}
+
+func (i *pocketSocksItem) set(c net.Conn) bool {
+	i.mu.Lock()
+	defer i.mu.Unlock()
+	if i.stopped || i.ctx.Err() != nil || i.conn != nil {
+		c.Close()
+		return false
+	}
+	i.conn = c
+	return true
+}
+func (i *pocketSocksItem) wrap(old, wrapped net.Conn) bool {
+	i.mu.Lock()
+	defer i.mu.Unlock()
+	if i.stopped || i.ctx.Err() != nil || i.conn != old {
+		wrapped.Close()
+		return false
+	}
+	i.conn = wrapped
+	return true
+}
+func (i *pocketSocksItem) finish(closeConn bool) net.Conn {
+	i.mu.Lock()
+	defer i.mu.Unlock()
+	if i.stopped {
+		return nil
+	}
+	i.stopped = true
+	c := i.conn
+	i.conn = nil
+	close(i.done)
+	i.cancel()
+	if closeConn && c != nil {
+		c.Close()
+		return nil
+	}
+	return c
+}
+func (i *pocketSocksItem) current() net.Conn { i.mu.Lock(); defer i.mu.Unlock(); return i.conn }
+
+type pocketSocksPool struct {
+	mu               sync.Mutex
+	epochFile        string
+	ready, preparing *pocketSocksItem
+	leases           map[*pocketSocksItem]struct{}
+	closed           bool
+	ttl, poll        time.Duration
+}
+
+func newPocketSocksPool(path string) *pocketSocksPool {
+	return &pocketSocksPool{epochFile: path, leases: make(map[*pocketSocksItem]struct{}), ttl: pocketPreconnectTTL, poll: pocketEpochPoll}
+}
+func (p *pocketSocksPool) valid(i *pocketSocksItem) bool {
+	return i.ctx.Err() == nil && i.route.Valid() && pocketReadEpoch(p.epochFile) == i.epoch && (i.expires.IsZero() || time.Now().Before(i.expires))
+}
+func (p *pocketSocksPool) discard(i *pocketSocksItem) {
+	p.mu.Lock()
+	if p.ready == i {
+		p.ready = nil
+	}
+	// A cancelled preparer retains the single preparation slot until its worker exits.
+	// This prevents a slow cancellation from overlapping a replacement preparation.
+	delete(p.leases, i)
+	i.finish(true)
+	p.mu.Unlock()
+}
+func (p *pocketSocksPool) watch(i *pocketSocksItem) {
+	ticker := time.NewTicker(p.poll)
+	defer ticker.Stop()
+	for {
+		select {
+		case <-i.done:
+			return
+		case <-i.ctx.Done():
+			p.discard(i)
+			return
+		case <-i.route.Changed:
+			p.discard(i)
+			return
+		case <-i.route.ConfigChanged:
+			p.discard(i)
+			return
+		case <-ticker.C:
+			if !p.valid(i) {
+				p.discard(i)
+				return
+			}
+		}
+	}
+}
+func (p *pocketSocksPool) item(ctx context.Context, r *proxydialer.PocketRoute, epoch string, warm bool) *pocketSocksItem {
+	var cancel context.CancelFunc
+	var expiry time.Time
+	if warm {
+		ctx, cancel = context.WithTimeout(ctx, p.ttl)
+		expiry = time.Now().Add(p.ttl)
+	} else {
+		ctx, cancel = context.WithCancel(ctx)
+	}
+	return &pocketSocksItem{ctx: ctx, cancel: cancel, done: make(chan struct{}), route: r, epoch: epoch, key: r.Key + ":" + epoch, expires: expiry}
+}
+func (p *pocketSocksPool) checkout(ctx context.Context, r *proxydialer.PocketRoute, epoch string, consumeReady bool) (*pocketSocksItem, bool, error) {
+	p.mu.Lock()
+	defer p.mu.Unlock()
+	if p.closed {
+		return nil, false, errPocketRouteChanged
+	}
+	key := r.Key + ":" + epoch
+	var conn net.Conn
+	reused := false
+	if p.ready != nil && (consumeReady || p.ready.key != key || !p.valid(p.ready)) {
+		old := p.ready
+		p.ready = nil
+		if consumeReady && old.key == key && p.valid(old) {
+			conn = old.finish(false)
+			reused = conn != nil
+		} else {
+			old.finish(true)
+		}
+	}
+	if p.preparing != nil && p.preparing.key != key {
+		p.preparing.finish(true)
+	}
+	i := p.item(ctx, r, epoch, false)
+	if !p.valid(i) {
+		if conn != nil {
+			conn.Close()
+		}
+		i.finish(true)
+		return nil, false, errPocketRouteChanged
+	}
+	if conn != nil {
+		conn.SetDeadline(time.Time{})
+		i.set(conn)
+	}
+	p.leases[i] = struct{}{}
+	go p.watch(i)
+	return i, reused, nil
+}
+func (p *pocketSocksPool) release(i *pocketSocksItem, requestCtx context.Context) (net.Conn, error) {
+	p.mu.Lock()
+	defer p.mu.Unlock()
+	delete(p.leases, i)
+	if p.closed || !p.valid(i) {
+		i.finish(true)
+		return nil, errPocketRouteChanged
+	}
+	c := i.finish(false)
+	if c == nil {
+		return nil, errPocketRouteChanged
+	}
+	if requestCtx.Err() != nil || !i.route.Valid() || pocketReadEpoch(p.epochFile) != i.epoch {
+		c.Close()
+		if requestCtx.Err() != nil {
+			return nil, requestCtx.Err()
+		}
+		return nil, errPocketRouteChanged
+	}
+	c.SetDeadline(time.Time{})
+	return c, nil
+}
+func (p *pocketSocksPool) close() {
+	p.mu.Lock()
+	p.closed = true
+	if p.ready != nil {
+		p.ready.finish(true)
+		p.ready = nil
+	}
+	if p.preparing != nil {
+		p.preparing.finish(true)
+		p.preparing = nil
+	}
+	for i := range p.leases {
+		i.finish(true)
+		delete(p.leases, i)
+	}
+	p.mu.Unlock()
+}
+func (p *pocketSocksPool) refill(r *proxydialer.PocketRoute, epoch string, prepare func(*pocketSocksItem) error) {
+	p.mu.Lock()
+	if p.closed || p.preparing != nil || p.ready != nil {
+		p.mu.Unlock()
+		return
+	}
+	i := p.item(context.Background(), r, epoch, true)
+	if !p.valid(i) {
+		i.finish(true)
+		p.mu.Unlock()
+		return
+	}
+	p.preparing = i
+	go p.watch(i)
+	p.mu.Unlock()
+	go func() {
+		defer func() {
+			p.mu.Lock()
+			if p.preparing == i {
+				p.preparing = nil
+			}
+			p.mu.Unlock()
+		}()
+		if prepare(i) != nil {
+			p.discard(i)
+			return
+		}
+		p.mu.Lock()
+		defer p.mu.Unlock()
+		if p.closed || p.preparing != i || !p.valid(i) || p.ready != nil {
+			i.finish(true)
+			if p.preparing == i {
+				p.preparing = nil
+			}
+			return
+		}
+		p.preparing = nil
+		p.ready = i
+	}()
+}
+
+func (ss *Socks5) pocketPrepare(i *pocketSocksItem) (err error) {
+	c, err := i.route.Dial(i.ctx, ss.addr)
+	if err != nil {
+		return err
+	}
+	if !i.set(c) {
+		return errPocketRouteChanged
+	}
+	if deadline, ok := i.ctx.Deadline(); ok {
+		c.SetDeadline(deadline)
+	}
+	if ss.tls {
+		cc := tls.Client(c, ss.tlsConfig)
+		if !i.wrap(c, cc) {
+			return errPocketRouteChanged
+		}
+		c = cc
+		if err = cc.HandshakeContext(i.ctx); err != nil {
+			return err
+		}
+	}
+	var user *socks5.User
+	if ss.user != "" {
+		user = &socks5.User{Username: ss.user, Password: ss.pass}
+	}
+	if err = socks5.ClientAuthenticate(c, user); err != nil {
+		return err
+	}
+	if !ss.pocket.valid(i) {
+		return errPocketRouteChanged
+	}
+	return nil
+}
+func pocketStaleIdle(err error) bool {
+	return errors.Is(err, io.EOF) || errors.Is(err, io.ErrUnexpectedEOF) || errors.Is(err, net.ErrClosed) || errors.Is(err, syscall.EPIPE) || errors.Is(err, syscall.ECONNRESET)
+}
+func (ss *Socks5) pocketDial(ctx context.Context, metadata *C.Metadata) (C.Conn, error, bool) {
+	epoch := pocketReadEpoch(ss.pocket.epochFile)
+	if epoch == "" {
+		return nil, nil, false
+	}
+	freezer, ok := ss.dialer.(pocketFreezer)
+	if !ok {
+		return nil, nil, false
+	}
+	r, err := freezer.PocketFreeze(ss.addr)
+	if err != nil {
+		return nil, nil, false
+	}
+	i, reused, err := ss.pocket.checkout(ctx, r, epoch, true)
+	if err != nil {
+		return nil, err, true
+	}
+	for attempt := 0; attempt < 2; attempt++ {
+		if !reused {
+			err = ss.pocketPrepare(i)
+		}
+		if err == nil && !ss.pocket.valid(i) {
+			err = errPocketRouteChanged
+		}
+		if err == nil {
+			c := i.current()
+			if c == nil {
+				err = errPocketRouteChanged
+			} else {
+				if deadline, ok := ctx.Deadline(); ok {
+					c.SetDeadline(deadline)
+				}
+				_, err = socks5.ClientCommand(c, serializesSocksAddr(metadata), socks5.CmdConnect)
+			}
+		}
+		if err == nil {
+			c, finishErr := ss.pocket.release(i, ctx)
+			if finishErr != nil {
+				return nil, finishErr, true
+			}
+			ss.pocket.refill(r, epoch, ss.pocketPrepare)
+			return NewConn(c, ss), nil, true
+		}
+		ss.pocket.discard(i)
+		// Only a dead unused idle socket can be retried, before any browser bytes exist.
+		// SOCKS authentication/protocol/REP rejection and returned connections never retry.
+		if attempt != 0 || !reused || !pocketStaleIdle(err) || ctx.Err() != nil || !r.Valid() || pocketReadEpoch(ss.pocket.epochFile) != epoch {
+			return nil, err, true
+		}
+		i, _, err = ss.pocket.checkout(ctx, r, epoch, false)
+		reused = false
+		if err != nil {
+			return nil, err, true
+		}
+	}
+	return nil, err, true
+}

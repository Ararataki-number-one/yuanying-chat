+func newPocketWire(t testing.TB, delay time.Duration) *pocketWire {
+	t.Helper()
+	l, e := net.Listen("tcp", "127.0.0.1:0")
+	if e != nil {
+		t.Fatal(e)
+	}
+	w := &pocketWire{listener: l, conns: make(map[net.Conn]struct{}), delay: delay, closed: make(chan struct{}), commandRelease: make(chan struct{}), secondReceived: make(chan struct{}), secondRelease: make(chan struct{})}
+	go func() {
+		for {
+			c, e := l.Accept()
+			if e != nil {
+				return
+			}
+			w.accepted.Add(1)
+			w.active.Add(1)
+			w.mu.Lock()
+			w.conns[c] = struct{}{}
+			w.mu.Unlock()
+			go w.serve(c)
+		}
+	}()
+	t.Cleanup(func() {
+		l.Close()
+		w.mu.Lock()
+		for c := range w.conns {
+			c.Close()
+		}
+		w.mu.Unlock()
+		close(w.closed)
+	})
+	return w
+}
+func (w *pocketWire) serve(c net.Conn) {
+	defer c.Close()
+	defer w.active.Add(-1)
+	buf := make([]byte, 512)
+	if _, e := io.ReadFull(c, buf[:2]); e != nil {
+		return
+	}
+	methods := int(buf[1])
+	if _, e := io.ReadFull(c, buf[:methods]); e != nil {
+		return
+	}
+	time.Sleep(w.delay)
+	if _, e := c.Write([]byte{5, 2}); e != nil {
+		return
+	}
+	if _, e := io.ReadFull(c, buf[:2]); e != nil {
+		return
+	}
+	n := int(buf[1])
+	if _, e := io.ReadFull(c, buf[:n+1]); e != nil {
+		return
+	}
+	n = int(buf[n])
+	if _, e := io.ReadFull(c, buf[:n]); e != nil {
+		return
+	}
+	time.Sleep(w.delay)
+	if w.badAuth.Load() {
+		c.Write([]byte{1, 1})
+		return
+	}
+	if _, e := c.Write([]byte{1, 0}); e != nil {
+		return
+	}
+	w.authed.Add(1)
+	if _, e := io.ReadFull(c, buf[:3]); e != nil {
+		return
+	}
+	if buf[0] != 5 || buf[1] != 1 || buf[2] != 0 {
+		return
+	}
+	if _, e := socks5.ReadAddr(c, buf); e != nil {
+		return
+	}
+	number := w.commands.Add(1)
+	if number == 2 && w.abortSecond.Load() {
+		close(w.secondReceived)
+		select {
+		case <-w.secondRelease:
+		case <-w.closed:
+			return
+		}
+		return
+	}
+	if w.holdCommand.Load() {
+		select {
+		case <-w.commandRelease:
+		case <-w.closed:
+			return
+		}
+	}
+	time.Sleep(w.delay)
+	if _, e := c.Write([]byte{5, byte(w.reject.Load()), 0, 1, 127, 0, 0, 1, 0, 80}); e != nil {
+		return
+	}
+	for {
+		n, e := c.Read(buf)
+		if n > 0 {
+			w.payload.Add(int32(n))
+			c.Write(buf[:n])
+		}
+		if e != nil {
+			return
+		}
+	}
+}
+func (w *pocketWire) closeAll() {
+	w.mu.Lock()
+	for c := range w.conns {
+		c.Close()
+	}
+	w.mu.Unlock()
+}

+// PocketDialError ends the outer listener retry loop for this opt-in route attempt.
+// Its cause remains inspectable; no auth/REP/route rejection is silently retried.
+type PocketDialError struct{ Cause error }
+
+func (e *PocketDialError) Error() string       { return e.Cause.Error() }
+func (e *PocketDialError) Unwrap() error       { return e.Cause }
+func (e *PocketDialError) PocketNoRetry() bool { return true }

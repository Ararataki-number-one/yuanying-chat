[
  {
    "namespace": "pocketNativePhoto",
    "description": "Application-bundled, document-bound temporary native canvas permission for selected photo encoding. Origin and origin-attributes scope; no RFP preference changes.",
    "types": [{
      "id": "Receipt", "type": "object", "properties": {
        "schema": {"type": "integer", "minimum": 1, "maximum": 1},
        "status": {"type": "string", "enum": ["captured", "granted", "existing", "not-required", "denied"]},
        "requestToken": {"type": "string"}, "sessionId": {"type": "string"},
        "origin": {"type": "string"}, "documentId": {"type": "string"},
        "expiresAt": {"type": "number"},
        "scope": {"type": "string", "enum": ["origin-and-origin-attributes"]},
        "reason": {"type": "string"}
      }
    }],
    "functions": [
      {"name": "captureSession", "type": "function", "async": true, "parameters": [
        {"name": "sessionId", "type": "string", "minLength": 1, "maxLength": 160},
        {"name": "origin", "type": "string", "minLength": 1, "maxLength": 2048},
        {"name": "requestToken", "type": "string", "minLength": 1, "maxLength": 160}
      ], "returns": {"$ref": "Receipt"}},
      {"name": "grantSession", "type": "function", "async": true, "parameters": [
        {"name": "sessionId", "type": "string", "minLength": 1, "maxLength": 160},
        {"name": "requestToken", "type": "string", "minLength": 1, "maxLength": 160}
      ], "returns": {"$ref": "Receipt"}},
      {"name": "releaseSession", "type": "function", "async": true, "parameters": [
        {"name": "sessionId", "type": "string", "minLength": 1, "maxLength": 160},
        {"name": "requestToken", "type": "string", "minLength": 1, "maxLength": 160}
      ], "returns": {"type": "boolean"}},
      {"name": "releaseAll", "type": "function", "async": true, "parameters": [], "returns": {"type": "boolean"}}
    ]
  }
]

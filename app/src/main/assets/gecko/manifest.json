{
  "manifest_version": 2,
  "name": "PocketChat browser integration",
  "version": "2.0.22.75",
  "browser_specific_settings": {"gecko": {"id": "browser@pocketchat.local"}},
  "permissions": ["privacy", "storage", "proxy", "cookies", "<all_urls>", "nativeMessaging", "nativeMessagingFromContent", "geckoViewAddons"],
  "content_security_policy": "script-src 'self' 'unsafe-eval'; object-src 'self'",
  "background": {"scripts": ["background.js"]},
  "web_accessible_resources": ["main-world-audit.js"],
  "content_scripts": [{"matches": ["https://*/*", "http://*/*"], "js": ["appearance.js", "content.js"], "run_at": "document_start", "all_frames": false}]
}

{
  "manifest_version": 2,
  "name": "PocketChat browser integration",
  "version": "1.5.7",
  "browser_specific_settings": {"gecko": {"id": "browser@pocketchat.local"}},
  "permissions": ["proxy", "<all_urls>", "nativeMessaging", "nativeMessagingFromContent", "geckoViewAddons"],
  "content_security_policy": "script-src 'self' 'unsafe-eval'; object-src 'self'",
  "background": {"scripts": ["background.js"]},
  "content_scripts": [{"matches": ["https://*/*", "http://*/*"], "js": ["content.js"], "run_at": "document_start", "all_frames": false}]
}

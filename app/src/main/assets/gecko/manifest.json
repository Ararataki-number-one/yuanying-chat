{
  "manifest_version": 2,
  "name": "PocketChat browser integration",
  "version": "2.1.2.104",
  "browser_specific_settings": {"gecko": {"id": "browser@pocketchat.local"}},
  "permissions": ["privacy", "storage", "proxy", "cookies", "webRequest", "webRequestBlocking", "<all_urls>", "nativeMessaging", "nativeMessagingFromContent", "geckoViewAddons"],
  "content_security_policy": "script-src 'self' 'unsafe-eval'; object-src 'self'",
  "experiment_apis": {"pocketNativeTimezone": {"schema": "native-timezone-schema.json", "parent": {"scopes": ["addon_parent"], "paths": [["pocketNativeTimezone"]], "script": "native-timezone-api.js"}}},
  "background": {"scripts": ["request-headers.js", "request-identity-background.js", "native-timezone-bridge.js", "background.js"]},
  "web_accessible_resources": ["main-world-audit.js"],
  "content_scripts": [{"matches": ["https://*/*", "http://*/*"], "js": ["appearance.js", "request-identity-audit.js", "content.js"], "run_at": "document_start", "all_frames": false}]
}

<resources>
  <style name="AppTheme" parent="android:style/Theme.Material.NoActionBar">
    <item name="android:fontFamily">sans</item><item name="android:colorAccent">#1268FF</item>
    <item name="android:windowLightStatusBar">false</item><item name="android:statusBarColor">#04101E</item>
    <item name="android:navigationBarColor">#04101E</item><item name="android:windowLightNavigationBar">false</item>
    <item name="android:windowActionModeOverlay">true</item><item name="android:alertDialogTheme">@style/ChatDialogTheme</item>
  </style>
  <style name="ChatDialogTheme" parent="android:style/Theme.Material.Dialog.Alert">
    <item name="android:fontFamily">sans</item><item name="android:colorAccent">#1268FF</item><item name="android:windowBackground">@drawable/dialog_panel</item><item name="android:backgroundDimAmount">0.22</item><item name="android:windowMinWidthMajor">90%</item><item name="android:windowMinWidthMinor">90%</item>
  </style>
</resources>

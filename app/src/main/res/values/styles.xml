<resources>
  <style name="AppTheme" parent="android:style/Theme.Material.Light.NoActionBar">
    <item name="android:fontFamily">sans</item><item name="android:colorAccent">#1268FF</item>
    <item name="android:windowLightStatusBar">true</item><item name="android:statusBarColor">#F4F6FA</item>
    <item name="android:navigationBarColor">#F4F6FA</item><item name="android:windowLightNavigationBar">true</item>
    <item name="android:windowActionModeOverlay">true</item><item name="android:alertDialogTheme">@style/ChatDialogTheme</item>
  </style>
  <style name="ChatDialogTheme" parent="android:style/Theme.Material.Light.Dialog.Alert">
    <item name="android:fontFamily">sans</item><item name="android:colorAccent">#1268FF</item><item name="android:windowBackground">@drawable/dialog_panel</item><item name="android:backgroundDimAmount">0.22</item><item name="android:windowMinWidthMajor">90%</item><item name="android:windowMinWidthMinor">90%</item>
    <item name="android:buttonBarPositiveButtonStyle">@style/DialogPrimaryButton</item>
    <item name="android:buttonBarNegativeButtonStyle">@style/DialogSecondaryButton</item>
    <item name="android:buttonBarNeutralButtonStyle">@style/DialogPrimaryButton</item>
  </style>
  <style name="DialogPrimaryButton" parent="android:style/Widget.Material.Button.Borderless">
    <item name="android:minHeight">48dp</item><item name="android:textAllCaps">false</item><item name="android:textColor">#2563EB</item>
  </style>
  <style name="DialogSecondaryButton" parent="DialogPrimaryButton">
    <item name="android:textColor">#64748B</item>
  </style>
</resources>

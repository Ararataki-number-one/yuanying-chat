<resources>
  <style name="FloatingPanelAnimation">
    <item name="android:windowEnterAnimation">@anim/panel_enter</item>
    <item name="android:windowExitAnimation">@anim/panel_exit</item>
  </style>
  <style name="AppThemeBase" parent="android:style/Theme.Material.Light.NoActionBar">
    <item name="android:fontFamily">sans</item><item name="android:colorAccent">#0064D2</item>
    <item name="android:windowLightStatusBar">false</item><item name="android:statusBarColor">#181B21</item><item name="android:windowBackground">#181B21</item>
    <item name="android:navigationBarColor">#F2F2F7</item>
    <item name="android:windowActionModeOverlay">true</item><item name="android:alertDialogTheme">@style/ChatDialogTheme</item>
  </style>
  <style name="AppTheme" parent="AppThemeBase" />
  <style name="ChatDialogTheme" parent="android:style/Theme.Material.Light.Dialog.Alert">
    <item name="android:fontFamily">sans</item><item name="android:colorAccent">#0064D2</item><item name="android:windowBackground">@drawable/dialog_panel</item><item name="android:backgroundDimAmount">0.22</item><item name="android:windowMinWidthMajor">90%</item><item name="android:windowMinWidthMinor">90%</item>
    <item name="android:buttonBarPositiveButtonStyle">@style/DialogPrimaryButton</item>
    <item name="android:buttonBarNegativeButtonStyle">@style/DialogSecondaryButton</item>
    <item name="android:buttonBarNeutralButtonStyle">@style/DialogPrimaryButton</item>
  </style>
  <style name="DialogPrimaryButton" parent="android:style/Widget.Material.Button.Borderless">
    <item name="android:minHeight">48dp</item><item name="android:textAllCaps">false</item><item name="android:textColor">#0067D8</item>
  </style>
  <style name="DialogSecondaryButton" parent="DialogPrimaryButton">
    <item name="android:textColor">#686873</item>
  </style>
  <style name="AppThemeLight" parent="AppThemeBase">
    <item name="android:windowBackground">#F2F2F7</item><item name="android:colorBackground">#F2F2F7</item>
    <item name="android:textColorPrimary">#1B1B1F</item><item name="android:textColorSecondary">#686873</item><item name="android:editTextColor">#1B1B1F</item>
  </style>
  <style name="AppThemeDark" parent="android:style/Theme.Material.NoActionBar">
    <item name="android:fontFamily">sans</item><item name="android:colorAccent">#82B3FF</item><item name="android:colorControlNormal">#AAAAB4</item>
    <item name="android:windowBackground">#0C0C0F</item><item name="android:colorBackground">#0C0C0F</item><item name="android:colorBackgroundFloating">#1C1C1E</item>
    <item name="android:textColorPrimary">#F4F4F6</item><item name="android:textColorSecondary">#AAAAB4</item><item name="android:editTextColor">#F4F4F6</item><item name="android:textColorHint">#AAAAB4</item>
    <item name="android:windowLightStatusBar">false</item><item name="android:statusBarColor">#181B21</item><item name="android:navigationBarColor">#1C1C1E</item>
    <item name="android:windowActionModeOverlay">true</item><item name="android:alertDialogTheme">@style/ChatDialogDark</item>
  </style>
  <style name="ChatDialogDark" parent="android:style/Theme.Material.Dialog.Alert">
    <item name="android:fontFamily">sans</item><item name="android:colorAccent">#82B3FF</item><item name="android:colorControlNormal">#AAAAB4</item>
    <item name="android:colorBackground">#1C1C1E</item><item name="android:colorBackgroundFloating">#1C1C1E</item><item name="android:windowBackground">@drawable/dialog_panel_dark</item>
    <item name="android:textColorPrimary">#F4F4F6</item><item name="android:textColorSecondary">#AAAAB4</item><item name="android:editTextColor">#F4F4F6</item><item name="android:textColorHint">#AAAAB4</item>
    <item name="android:backgroundDimAmount">0.38</item><item name="android:windowMinWidthMajor">90%</item><item name="android:windowMinWidthMinor">90%</item>
  </style>
</resources>

<resources>
  <style name="AppThemeBase" parent="android:style/Theme.Material.Light.NoActionBar">
    <item name="android:fontFamily">sans</item><item name="android:colorAccent">#1268FF</item>
    <item name="android:windowLightStatusBar">false</item><item name="android:statusBarColor">#181B21</item><item name="android:windowBackground">#181B21</item>
    <item name="android:navigationBarColor">#F4F6FA</item>
    <item name="android:windowActionModeOverlay">true</item><item name="android:alertDialogTheme">@style/ChatDialogTheme</item>
  </style>
  <style name="AppTheme" parent="AppThemeBase" />
  <style name="ChatDialogTheme" parent="android:style/Theme.Material.Light.Dialog.Alert">
    <item name="android:fontFamily">sans</item><item name="android:colorAccent">#1268FF</item><item name="android:windowBackground">@drawable/dialog_panel</item><item name="android:backgroundDimAmount">0.22</item><item name="android:windowMinWidthMajor">90%</item><item name="android:windowMinWidthMinor">90%</item>
    <item name="android:buttonBarPositiveButtonStyle">@style/DialogPrimaryButton</item>
    <item name="android:buttonBarNegativeButtonStyle">@style/DialogSecondaryButton</item>
    <item name="android:buttonBarNeutralButtonStyle">@style/DialogPrimaryButton</item>
  </style>
  <style name="DialogPrimaryButton" parent="android:style/Widget.Material.Button.Borderless">
    <item name="android:minHeight">48dp</item><item name="android:textAllCaps">false</item><item name="android:textColor">#2563EB</item>
  </style>
  <style name="DialogSecondaryButton" parent="DialogPrimaryButton">
    <item name="android:textColor">#64748B</item>
  </style>
  <style name="AppThemeLight" parent="AppThemeBase">
    <item name="android:windowBackground">#F4F7FB</item><item name="android:colorBackground">#F4F7FB</item>
    <item name="android:textColorPrimary">#172033</item><item name="android:textColorSecondary">#64748B</item><item name="android:editTextColor">#172033</item>
  </style>
  <style name="AppThemeDark" parent="android:style/Theme.Material.NoActionBar">
    <item name="android:fontFamily">sans</item><item name="android:colorAccent">#8AAFFF</item><item name="android:colorControlNormal">#9EA8B8</item>
    <item name="android:windowBackground">#15181E</item><item name="android:colorBackground">#15181E</item><item name="android:colorBackgroundFloating">#20242C</item>
    <item name="android:textColorPrimary">#E3E7EF</item><item name="android:textColorSecondary">#9EA8B8</item><item name="android:editTextColor">#E3E7EF</item><item name="android:textColorHint">#9EA8B8</item>
    <item name="android:windowLightStatusBar">false</item><item name="android:statusBarColor">#181B21</item><item name="android:navigationBarColor">#20242C</item>
    <item name="android:windowActionModeOverlay">true</item><item name="android:alertDialogTheme">@style/ChatDialogDark</item>
  </style>
  <style name="ChatDialogDark" parent="android:style/Theme.Material.Dialog.Alert">
    <item name="android:fontFamily">sans</item><item name="android:colorAccent">#8AAFFF</item><item name="android:colorControlNormal">#9EA8B8</item>
    <item name="android:colorBackground">#20242C</item><item name="android:colorBackgroundFloating">#20242C</item><item name="android:windowBackground">@drawable/dialog_panel_dark</item>
    <item name="android:textColorPrimary">#E3E7EF</item><item name="android:textColorSecondary">#9EA8B8</item><item name="android:editTextColor">#E3E7EF</item><item name="android:textColorHint">#9EA8B8</item>
    <item name="android:backgroundDimAmount">0.38</item><item name="android:windowMinWidthMajor">90%</item><item name="android:windowMinWidthMinor">90%</item>
  </style>
</resources>

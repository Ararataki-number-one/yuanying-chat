+
+type pocketRetryDialer struct {
+	valid       atomic.Bool
+	changed     chan struct{}
+	dials       atomic.Int32
+	connected   atomic.Int32
+	failed      atomic.Int32
+	endpoints   chan string
+	unsupported bool
+}
+
+func (d *pocketRetryDialer) DialContext(ctx context.Context, network, address string) (net.Conn, error) {
+	d.dials.Add(1)
+	conn, err := (&net.Dialer{}).DialContext(ctx, network, address)
+	if err != nil {
+		d.failed.Add(1)
+	} else {
+		d.connected.Add(1)
+		d.endpoints <- conn.LocalAddr().String()
+	}
+	return conn, err
+}
+func (d *pocketRetryDialer) ListenPacket(context.Context, string, string, netip.AddrPort) (net.PacketConn, error) {
+	return nil, errors.New("unexpected UDP")
+}
+func (d *pocketRetryDialer) PocketFreeze(string) (*proxydialer.PocketRoute, error) {
+	if d.unsupported {
+		return nil, errors.New("unsupported leaf route")
+	}
+	return &proxydialer.PocketRoute{Key: "fixed-core-route", Changed: d.changed, Valid: d.valid.Load, Dial: func(ctx context.Context, address string) (net.Conn, error) { return d.DialContext(ctx, "tcp", address) }}, nil
+}
+func TestPocketPreconnectRealFixedExitRejectionStopsActualTunnelRetry(t *testing.T) {
+	for _, kind := range []string{"auth", "rep", "malformed", "route", "blocked", "unsupported"} {
+		t.Run(kind, func(t *testing.T) {
+			l, e := net.Listen("tcp", "127.0.0.1:0")
+			if e != nil {
+				t.Fatal(e)
+			}
+			defer l.Close()
+			var accepts, commands atomic.Int32
+			acceptedEndpoints := make(chan string, 16)
+			acceptLoopDone := make(chan struct{})
+			var handlers sync.WaitGroup
+			go func() {
+				defer close(acceptLoopDone)
+				for {
+					c, e := l.Accept()
+					if e != nil {
+						return
+					}
+					accepts.Add(1)
+					acceptedEndpoints <- c.RemoteAddr().String()
+					handlers.Add(1)
+					go func() {
+						defer handlers.Done()
+						defer c.Close()
+						_ = c.SetDeadline(time.Now().Add(time.Second))
+						buf := make([]byte, 512)
+						if _, e := io.ReadFull(c, buf[:3]); e != nil {
+							return
+						}
+						c.Write([]byte{5, 2})
+						if _, e := io.ReadFull(c, buf[:2]); e != nil {
+							return
+						}
+						n := int(buf[1])
+						if _, e := io.ReadFull(c, buf[:n+1]); e != nil {
+							return
+						}
+						n = int(buf[n])
+						if _, e := io.ReadFull(c, buf[:n]); e != nil {
+							return
+						}
+						if kind == "auth" || kind == "blocked" || kind == "unsupported" {
+							c.Write([]byte{1, 1})
+							return
+						}
+						c.Write([]byte{1, 0})
+						if _, e := io.ReadFull(c, buf[:3]); e != nil {
+							return
+						}
+						if _, e := socks5.ReadAddr(c, buf); e != nil {
+							return
+						}
+						commands.Add(1)
+						if kind == "rep" {
+							c.Write([]byte{5, 5, 0, 1, 127, 0, 0, 1, 0, 80})
+						} else {
+							c.Write([]byte{4, 0, 0, 1, 127, 0, 0, 1, 0, 80})
+						}
+					}()
+				}
+			}()
+			path := filepath.Join(t.TempDir(), "epoch")
+			os.WriteFile(path, []byte("ready:core-test-1\n"), 0600)
+			if kind == "blocked" {
+				os.WriteFile(path, []byte("blocked:core-test-2\n"), 0600)
+			}
+			host, port, _ := net.SplitHostPort(l.Addr().String())
+			p, _ := strconv.Atoi(port)
+			d := &pocketRetryDialer{changed: make(chan struct{}), endpoints: make(chan string, 16), unsupported: kind == "unsupported"}
+			d.valid.Store(kind != "route")
+			ss, e := outbound.NewSocks5(outbound.Socks5Option{BasicOption: outbound.BasicOption{DialerForAPI: d}, Name: "FixedExit", Server: host, Port: p, UserName: "user", Password: "password", PocketPreconnect: true, PocketPreconnectEpochFile: path})
+			if e != nil {
+				t.Fatal(e)
+			}
+			defer ss.Close()
+			var attempts int
+			budget := time.Second
+			if kind == "blocked" || kind == "unsupported" {
+				budget = 150 * time.Millisecond
+			}
+			ctx, cancel := context.WithTimeout(context.Background(), budget)
+			defer cancel()
+			conn, e := tunnel.PocketRetryForTest(ctx, func(ctx context.Context) (C.Conn, error) {
+				attempts++
+				return ss.DialContext(ctx, &C.Metadata{Host: "browser.test", DstPort: 443})
+			})
+			if kind == "blocked" || kind == "unsupported" {
+				var scoped *proxydialer.PocketDialError
+				tcpSuccess, tcpFailure := d.connected.Load(), d.failed.Load()
+				if conn != nil || e == nil || attempts < 2 || attempts > 10 || errors.As(e, &scoped) || d.dials.Load() != int32(attempts) || tcpSuccess+tcpFailure != d.dials.Load() || tcpSuccess < 1 {
+					t.Fatalf("non-pooled fallback retry changed: attempts=%d connected=%d failed=%d dials=%d err=%v", attempts, tcpSuccess, tcpFailure, d.dials.Load(), e)
+				}
+				// The retry deadline can cancel a final TCP attempt before DialContext
+				// returns a socket, even if Accept already observed its handshake.
+				// Match every returned socket by endpoint; only failed calls can
+				// account for additional accepts. This observation barrier does not
+				// extend the 150 ms retry context or initiate another dial.
+				pending := make(map[string]int)
+				for i := int32(0); i < tcpSuccess; i++ {
+					pending[<-d.endpoints]++
+				}
+				observation := time.NewTimer(time.Second)
+				defer observation.Stop()
+				observed, remaining := int32(0), tcpSuccess
+				for remaining > 0 {
+					select {
+					case endpoint := <-acceptedEndpoints:
+						observed++
+						if pending[endpoint] > 0 {
+							pending[endpoint]--
+							remaining--
+						}
+					case <-observation.C:
+						t.Fatalf("returned TCP sockets missing real Accept: %v", pending)
+					}
+				}
+				_ = l.Close()
+				select {
+				case <-acceptLoopDone:
+				case <-observation.C:
+					t.Fatal("Accept loop did not finish accounting")
+				}
+				close(acceptedEndpoints)
+				for range acceptedEndpoints {
+					observed++
+				}
+				settled := make(chan struct{})
+				go func() { handlers.Wait(); close(settled) }()
+				select {
+				case <-settled:
+				case <-observation.C:
+					t.Fatal("SOCKS handlers did not finish accounting")
+				}
+				unreturned := observed - tcpSuccess
+				if observed != accepts.Load() || unreturned < 0 || unreturned > tcpFailure || commands.Load() != 0 {
+					t.Fatalf("fallback TCP accounting changed: connected=%d failed=%d accepts=%d observed=%d commands=%d", tcpSuccess, tcpFailure, accepts.Load(), observed, commands.Load())
+				}
+				t.Logf("fallback TCP accounting: attempts=%d connected=%d failed=%d accepts=%d unreturned=%d", attempts, tcpSuccess, tcpFailure, observed, unreturned)
+				return
+			}
+			if conn != nil || e == nil || attempts != 1 {
+				t.Fatalf("listener replayed rejected FixedExit dial: attempts=%d err=%v", attempts, e)
+			}
+			var marker *proxydialer.PocketDialError
+			if !errors.As(e, &marker) || !tunnel.PocketShouldStopRetryForTest(e) {
+				t.Fatal("scoped marker lost")
+			}
+			want := int32(1)
+			if kind == "route" {
+				want = 0
+			}
+			if accepts.Load() != want || d.dials.Load() != want {
+				t.Fatal("rejected route redialed")
+			}
+			if kind == "auth" && commands.Load() != 0 {
+				t.Fatal("failed auth sent a target command")
+			}
+			if kind == "rep" {
+				var rep socks5.Error
+				if !errors.As(e, &rep) || rep != 5 {
+					t.Fatal("typed original REP cause lost")
+				}
+			}
+		})
+	}
+}
+func TestPocketPreconnectMarkerDoesNotChangeOrdinaryTunnelRetry(t *testing.T) {
+	ctx, cancel := context.WithTimeout(context.Background(), 100*time.Millisecond)
+	defer cancel()
+	calls := 0
+	_, e := tunnel.PocketRetryForTest(ctx, func(context.Context) (C.Conn, error) { calls++; return nil, io.EOF })
+	if e == nil || calls < 2 || calls > 10 || tunnel.PocketShouldStopRetryForTest(io.EOF) {
+		t.Fatalf("ordinary retry changed: %d %v", calls, e)
+	}
+	wrapped := &proxydialer.PocketDialError{Cause: context.Canceled}
+	if !errors.Is(wrapped, context.Canceled) || !tunnel.PocketShouldStopRetryForTest(wrapped) {
+		t.Fatal("original cancellation cause lost")
+	}
+}

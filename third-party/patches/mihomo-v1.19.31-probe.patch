+	if peak.Load() != 1 || active.Load() != 1 {
+		t.Fatal("replacement overlapped cancelled preparer")
+	}
+	close(barrier)
+	pocketAwait(t, func() bool { return pocketEmpty(ss.pocket) })
+	ss.pocket.refill(d.route, pocketReadEpoch(path), ss.pocketPrepare)
+	pocketAwait(t, func() bool { return pocketReady(ss.pocket) })
+	if peak.Load() != 1 {
+		t.Fatal("preparation bound exceeded")
+	}
+}

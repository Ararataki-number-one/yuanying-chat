+
+// The real manual Selector's snapshots/Set are used, but mutable-parent dialing
+// is a trap: a captured route must dial the captured actual leaf directly.
+type pocketParentDialTrap struct {
+	*outboundgroup.Selector
+	dials atomic.Int32
+}
+
+func (p *pocketParentDialTrap) DialContext(context.Context, *C.Metadata) (C.Conn, error) {
+	p.dials.Add(1)
+	return nil, errors.New("mutable parent dial must not be used")
+}
+
+func pocketFixture(t *testing.T, leaves ...C.Proxy) (*pocketTestProvider, *outboundgroup.Selector, *pocketParentDialTrap, *pocketTestTunnel) {
+	t.Helper()
+	provider := &pocketTestProvider{version: 1, proxies: leaves}
+	selector, err := outboundgroup.NewSelector(outboundgroup.GroupCommonOption{Name: "EntryChoice"}, outboundgroup.SelectorOption{DefaultSelected: leaves[0].Name()}, leaves[0], []P.ProxyProvider{provider})
+	if err != nil {
+		t.Fatal(err)
+	}
+	parent := &pocketParentDialTrap{Selector: selector}

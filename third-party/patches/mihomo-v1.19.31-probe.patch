+func pocketProviderFixture(name string) map[string]any {
+	return map[string]any{"type": "socks5", "name": name, "server": "127.0.0.1", "port": 1080, "username": "fixture-user", "password": "fixture-only-secret"}
+}
+func pocketProviderFingerprint(t *testing.T, node map[string]any) string {
+	t.Helper()
+	hash, err := adapter.ProxyConfigFingerprint(node)
+	if err != nil {
+		t.Fatal(err)
+	}
+	return hash
+}
+func pocketProviderDocument(t *testing.T, nodes ...map[string]any) []byte {
+	t.Helper()
+	data, err := json.Marshal(map[string]any{"proxies": nodes})
+	if err != nil {
+		t.Fatal(err)
+	}
+	return data
+}
+func pocketProviderOverride(hash, name string, pool bool) overrideSchema {
+	route := "EntryChoice"
+	epoch := "/private/pocketchat/profile/exit-epoch"
+	override := overrideSchema{PocketConfigFingerprint: &hash, DialerProxy: &route, PocketPreconnect: &pool, ProxyName: []overrideProxyNameSchema{{Pattern: regexp2.MustCompile(`^.*$`, regexp2.None), Target: name}}}
+	if pool {
+		override.PocketPreconnectEpochFile = &epoch
+	}
+	return override
+}
+func pocketParseProvider(t *testing.T, override overrideSchema, filter string, nodes ...map[string]any) ([]C.Proxy, error) {
+	t.Helper()
+	parser, err := NewProxiesParser("ExitSource", nil, filter, "", "", "", override, "")
+	if err != nil {
+		return nil, err
+	}
+	proxies, err := parser(pocketProviderDocument(t, nodes...))
+	for _, proxy := range proxies {
+		t.Cleanup(func() { _ = proxy.Close() })
+	}
+	return proxies, err
+}
+
+func TestPocketSelectedExitExactFingerprintSurvivesRefreshRename(t *testing.T) {

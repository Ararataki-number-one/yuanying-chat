+	proxies, err := pocketParseProvider(t, pocketProviderOverride(hash, "FixedExit", true), "", other, node)
+	if err != nil || len(proxies) != 1 {
+		t.Fatalf("selected source rejected: %v", err)
+	}
+	if proxies[0].Name() != "FixedExit" || proxies[0].ProxyInfo().DialerProxy != "EntryChoice" {
+		t.Fatal("fixed exit was not attached to its environment entry")
+	}
+	data, _ := proxies[0].MarshalJSON()
+	var info map[string]any
+	_ = json.Unmarshal(data, &info)
+	if info["configFingerprint"] != hash {
+		t.Fatal("generated override changed source fingerprint")
+	}
+}

+
+type pocketTestProvider struct {
+	P.ProxyProvider
+	mu      sync.RWMutex
+	version uint32
+	proxies []C.Proxy
+}
+
+func (p *pocketTestProvider) Version() uint32 { p.mu.RLock(); defer p.mu.RUnlock(); return p.version }
+func (p *pocketTestProvider) Proxies() []C.Proxy {
+	p.mu.RLock()
+	defer p.mu.RUnlock()
+	return append([]C.Proxy{}, p.proxies...)
+}
+func (p *pocketTestProvider) Touch() {}
+func (p *pocketTestProvider) replace(proxies ...C.Proxy) {
+	p.mu.Lock()
+	defer p.mu.Unlock()
+	p.proxies = proxies
+	p.version++
+}
+
+type pocketTestTunnel struct {
+	C.Tunnel
+	mu      sync.RWMutex
+	proxies map[string]C.Proxy
+}
+
+func (t *pocketTestTunnel) Proxies() map[string]C.Proxy {
+	t.mu.RLock()
+	defer t.mu.RUnlock()
+	copy := make(map[string]C.Proxy, len(t.proxies))
+	for name, proxy := range t.proxies {
+		copy[name] = proxy
+	}
+	return copy
+}
+func (t *pocketTestTunnel) set(name string, proxy C.Proxy) {
+	t.mu.Lock()
+	defer t.mu.Unlock()
+	t.proxies[name] = proxy
+}

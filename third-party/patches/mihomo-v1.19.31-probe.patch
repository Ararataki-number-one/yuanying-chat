+package adapter
+
+import (
+	"crypto/sha256"
+	"encoding"
+	"encoding/hex"
+	"encoding/json"
+	"errors"
+	"reflect"
+	"strings"
+
+	"github.com/metacubex/mihomo/adapter/outbound"
+	"github.com/metacubex/mihomo/common/structure"
+)
+
+// ProxyConfigFingerprint identifies source connection settings, never runtime
+// adapter identity. Names, app generated routing/pool fields and provider labels
+// are excluded. Protocol authentication uuid/password and all transport/TLS
+// settings remain included. Only the versioned digest is exposed to the API.
+func ProxyConfigFingerprint(mapping map[string]any) (string, error) {
+	proxyType, ok := mapping["type"].(string)
+	if !ok {
+		return "", errors.New("missing proxy fingerprint type")
+	}
+	var option any
+	switch proxyType {
+	case "ss":
+		option = &outbound.ShadowSocksOption{}
+	case "ssr":
+		option = &outbound.ShadowSocksROption{}
+	case "socks5":
+		option = &outbound.Socks5Option{}
+	case "http":
+		option = &outbound.HttpOption{}
+	case "vmess":
+		option = &outbound.VmessOption{}
+	case "vless":
+		option = &outbound.VlessOption{}
+	case "snell":
+		option = &outbound.SnellOption{}
+	case "trojan":
+		option = &outbound.TrojanOption{}
+	case "hysteria":
+		option = &outbound.HysteriaOption{}
+	case "hysteria2":
+		option = &outbound.Hysteria2Option{}
+	case "wireguard":
+		option = &outbound.WireGuardOption{}
+	case "tuic":
+		option = &outbound.TuicOption{}
+	case "shadowquic":
+		option = &outbound.ShadowQuicOption{}
+	case "gost-relay":
+		option = &outbound.GostRelayOption{}
+	case "direct":
+		option = &outbound.DirectOption{}
+	case "dns":
+		option = &outbound.DnsOption{}
+	case "reject":
+		option = &outbound.RejectOption{}
+	case "rematch":
+		option = &outbound.RematchOption{}
+	case "ssh":
+		option = &outbound.SshOption{}
+	case "mieru":
+		option = &outbound.MieruOption{}
+	case "anytls":
+		option = &outbound.AnyTLSOption{}
+	case "sudoku":
+		option = &outbound.SudokuOption{}
+	case "masque":
+		option = &outbound.MasqueOption{}
+	case "trusttunnel":
+		option = &outbound.TrustTunnelOption{}
+	case "openvpn":
+		option = &outbound.OpenVPNOption{}
+	case "tailscale":
+		option = &outbound.TailscaleOption{}
+	case "zerotier":
+		option = &outbound.ZeroTierOption{}
+	case "easytier":
+		option = &outbound.EasyTierOption{}
+	default:
+		return "", errors.New("unsupported proxy fingerprint type")
+	}
+	decoder := structure.NewDecoder(structure.Option{TagName: "proxy", WeaklyTypedInput: true, KeyReplacer: structure.DefaultKeyReplacer})
+	if err := pocketFingerprintCheckAliases(mapping, reflect.TypeOf(option)); err != nil {
+		return "", err
+	}
+	// These are the exact upstream typed options, so e.g. a quoted port and an
+	// integer port agree, but a quoted password keeps its exact bytes.
+	if err := decoder.Decode(mapping, option); err != nil {
+		return "", errors.New("invalid proxy fingerprint configuration")
+	}
+	canonical, err := pocketFingerprintValue(reflect.ValueOf(option), true)
+	if err != nil {
+		return "", err
+	}
+	config := map[string]any{"version": 1, "type": proxyType, "options": canonical}
+	if muxMapping, muxExist := mapping["smux"].(map[string]any); muxExist {
+		muxOption := &outbound.SingMuxOption{}
+		if err := pocketFingerprintCheckAliases(muxMapping, reflect.TypeOf(muxOption)); err != nil {
+			return "", err
+		}
+		if err := decoder.Decode(muxMapping, muxOption); err != nil {
+			return "", errors.New("invalid proxy fingerprint mux")
+		}
+		if muxOption.Enabled {
+			config["smux"], err = pocketFingerprintValue(reflect.ValueOf(muxOption), false)
+			if err != nil {
+				return "", err
+			}
+		}
+	}
+	data, err := json.Marshal(config)
+	if err != nil {
+		return "", errors.New("invalid proxy fingerprint value")
+	}
+	digest := sha256.Sum256(data)
+	return hex.EncodeToString(digest[:]), nil
+}
+
+func pocketFingerprintValue(value reflect.Value, root bool) (any, error) {
+	if !value.IsValid() {
+		return nil, nil
+	}
+	for value.Kind() == reflect.Pointer || value.Kind() == reflect.Interface {
+		if value.IsNil() {
+			return nil, nil
+		}
+		value = value.Elem()
+	}
+	if value.CanInterface() {
+		if text, ok := value.Interface().(encoding.TextMarshaler); ok {
+			data, err := text.MarshalText()
+			if err != nil {
+				return nil, errors.New("invalid proxy fingerprint text")
+			}
+			return string(data), nil
+		}
+	}
+	switch value.Kind() {
+	case reflect.Struct:
+		out := map[string]any{}
+		kind := value.Type()
+		for i := 0; i < value.NumField(); i++ {
+			field := kind.Field(i)
+			if !field.IsExported() {
+				continue
+			}
+			tag := strings.Split(field.Tag.Get("proxy"), ",")[0]
+			if tag == "-" {
+				continue
+			} // internal Dialer/Tunnel/provider objects
+			if field.Anonymous && value.Field(i).Kind() == reflect.Struct {
+				embedded, err := pocketFingerprintValue(value.Field(i), root)
+				if err != nil {
+					return nil, err
+				}
+				for key, item := range embedded.(map[string]any) {
+					out[key] = item
+				}
+				continue
+			}
+			if tag == "" {
+				tag = field.Name
+			}
+			if root && (tag == "name" || tag == "id" || tag == "dialer-proxy" || strings.HasPrefix(tag, "pocket-")) {
+				continue
+			}
+			item, err := pocketFingerprintValue(value.Field(i), false)
+			if err != nil {
+				return nil, err
+			}
+			out[tag] = item
+		}
+		return out, nil
+	case reflect.Map:
+		if value.Type().Key().Kind() != reflect.String {
+			return nil, errors.New("invalid proxy fingerprint map key")
+		}
+		if value.IsNil() {
+			return nil, nil
+		}
+		out := map[string]any{}
+		iterator := value.MapRange()
+		for iterator.Next() {
+			item, err := pocketFingerprintValue(iterator.Value(), false)
+			if err != nil {
+				return nil, err
+			}
+			out[iterator.Key().String()] = item
+		}
+		return out, nil
+	case reflect.Array, reflect.Slice:
+		if value.Kind() == reflect.Slice && value.IsNil() {
+			return nil, nil
+		}
+		out := make([]any, value.Len())
+		for i := range out {
+			item, err := pocketFingerprintValue(value.Index(i), false)
+			if err != nil {
+				return nil, err
+			}
+			out[i] = item
+		}
+		return out, nil
+	case reflect.String, reflect.Bool, reflect.Int, reflect.Int8, reflect.Int16, reflect.Int32, reflect.Int64,
+		reflect.Uint, reflect.Uint8, reflect.Uint16, reflect.Uint32, reflect.Uint64, reflect.Float32, reflect.Float64:
+		return value.Interface(), nil
+	default:
+		return nil, errors.New("unsupported proxy fingerprint value")
+	}
+}
+
+// WithConfigFingerprint supplies the already validated source identity when a
+// provider applies app owned routing/rename overrides. It never changes Id().
+func WithConfigFingerprint(fingerprint string) ProxyOption {
+	return func(option *proxyOption) { option.ConfigFingerprint = fingerprint }
+}
+
+// Upstream falls back to case-insensitive/underscore matching. Two such aliases
+// can otherwise decode differently in successive map iterations. Refuse that
+// ambiguity for typed option fields, while keeping arbitrary HTTP/header keys
+// intact (case and order are real transport data).
+func pocketFingerprintCheckAliases(mapping map[string]any, option reflect.Type) error {
+	for option.Kind() == reflect.Pointer {
+		option = option.Elem()
+	}
+	if option.Kind() != reflect.Struct {
+		return nil
+	}
+	for index := 0; index < option.NumField(); index++ {
+		field := option.Field(index)
+		if !field.IsExported() {
+			continue
+		}
+		tag := strings.Split(field.Tag.Get("proxy"), ",")[0]
+		if tag == "-" {
+			continue
+		}
+		fieldType := field.Type
+		for fieldType.Kind() == reflect.Pointer {
+			fieldType = fieldType.Elem()
+		}
+		if field.Anonymous && fieldType.Kind() == reflect.Struct {
+			if err := pocketFingerprintCheckAliases(mapping, field.Type); err != nil {
+				return err
+			}
+			continue
+		}
+		if tag == "" {
+			tag = field.Name
+		}
+		tag = strings.ToLower(strings.ReplaceAll(tag, "_", "-"))
+		matches := 0
+		var raw any
+		for key, value := range mapping {
+			if strings.ToLower(strings.ReplaceAll(key, "_", "-")) == tag {
+				matches++
+				raw = value
+			}
+		}
+		if matches > 1 {
+			return errors.New("ambiguous proxy fingerprint option aliases")
+		}
+		if nested, ok := raw.(map[string]any); ok && fieldType.Kind() == reflect.Struct {
+			if err := pocketFingerprintCheckAliases(nested, field.Type); err != nil {
+				return err
+			}
+		}
+		if items, ok := raw.([]any); ok && (fieldType.Kind() == reflect.Array || fieldType.Kind() == reflect.Slice) {
+			for _, item := range items {
+				if nested, ok := item.(map[string]any); ok {
+					if err := pocketFingerprintCheckAliases(nested, fieldType.Elem()); err != nil {
+						return err
+					}
+				}
+			}
+		}
+	}
+	return nil
+}

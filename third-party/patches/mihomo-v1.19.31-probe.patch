+type pocketChainWire struct {
+	listener                   net.Listener
+	accepted, authed, commands atomic.Int32
+	mu                         sync.Mutex
+	targets                    []string
+	connections                map[net.Conn]struct{}
+	username, password         string
+}
+
+func (w *pocketChainWire) Verify(user, password string) bool {
+	if user != w.username || password != w.password {
+		return false
+	}
+	w.authed.Add(1)
+	return true
+}
+func (w *pocketChainWire) Users() []string { return []string{w.username} }
+func newPocketChainWire(t *testing.T, username, password string) *pocketChainWire {
+	t.Helper()
+	listener, err := net.Listen("tcp", "127.0.0.1:0")
+	if err != nil {
+		t.Fatal(err)
+	}
+	wire := &pocketChainWire{listener: listener, connections: map[net.Conn]struct{}{}, username: username, password: password}
+	var _ auth.Authenticator = wire
+	go func() {
+		for {
+			connection, err := listener.Accept()
+			if err != nil {
+				return
+			}
+			wire.accepted.Add(1)
+			wire.mu.Lock()
+			wire.connections[connection] = struct{}{}
+			wire.mu.Unlock()
+			go func() {
+				defer connection.Close()
+				_ = connection.SetDeadline(time.Now().Add(10 * time.Second))
+				address, command, _, err := socks5.ServerHandshake(connection, wire)
+				if err != nil || command != socks5.CmdConnect {
+					return
+				}
+				wire.commands.Add(1)
+				wire.mu.Lock()
+				wire.targets = append(wire.targets, address.String())
+				wire.mu.Unlock()
+				remote, err := net.DialTimeout("tcp", address.String(), time.Second)
+				if err != nil {
+					return
+				}
+				defer remote.Close()
+				go func() { _, _ = io.Copy(remote, connection); _ = remote.Close() }()
+				_, _ = io.Copy(connection, remote)
+			}()
+		}
+	}()
+	t.Cleanup(func() {
+		_ = listener.Close()
+		wire.mu.Lock()
+		for connection := range wire.connections {
+			_ = connection.Close()
+		}
+		wire.mu.Unlock()
+	})
+	return wire
+}
+func pocketChainNode(w *pocketChainWire, name string) map[string]any {
+	host, p, _ := net.SplitHostPort(w.listener.Addr().String())
+	port, _ := strconv.Atoi(p)
+	return map[string]any{"name": name, "type": "socks5", "server": host, "port": port, "username": w.username, "password": w.password}
+}
+func pocketChainWait(t *testing.T, condition func() bool) {
+	t.Helper()
+	deadline := time.Now().Add(2 * time.Second)
+	for !condition() {
+		if time.Now().After(deadline) {
+			t.Fatal("controlled chain condition timed out")
+		}
+		time.Sleep(5 * time.Millisecond)
+	}
+}

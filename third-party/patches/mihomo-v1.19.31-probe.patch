+package proxydialer
+
+import (
+	"context"
+	"errors"
+	"fmt"
+	C "github.com/metacubex/mihomo/constant"
+	"github.com/metacubex/mihomo/tunnel/statistic"
+	"net"
+	"reflect"
+	"sync"
+)
+
+type PocketRoute struct {
+	Key           string
+	Changed       <-chan struct{}
+	ConfigChanged <-chan struct{}
+	Valid         func() bool
+	Dial          func(context.Context, string) (net.Conn, error)
+}
+
+var pocketConfig = struct {
+	sync.Mutex
+	serial  uint64
+	changed chan struct{}
+}{serial: 1, changed: make(chan struct{})}
+
+// PocketInvalidateRoutes is called on every tunnel config replacement, before publication.
+func PocketInvalidateRoutes() {
+	pocketConfig.Lock()
+	pocketConfig.serial++
+	close(pocketConfig.changed)
+	pocketConfig.changed = make(chan struct{})
+	pocketConfig.Unlock()
+}
+
+func pocketConfigSnapshot() (uint64, <-chan struct{}) {
+	pocketConfig.Lock()
+	defer pocketConfig.Unlock()
+	return pocketConfig.serial, pocketConfig.changed
+}
+
+type pocketSelector interface {
+	PocketRouteSnapshot(*C.Metadata) (C.Proxy, uint64, <-chan struct{})
+}
+
+// PocketFreeze deliberately supports only a manual selector and a flat leaf.
+// Unsupported dynamic/nested routes keep the original non-pooled dial path.
+func (d byNameProxyDialer) PocketFreeze(address string) (*PocketRoute, error) {
+	tunnel, ok := d.tunnel.(Tunnel)
+	if !ok {
+		return nil, errors.New("invalid route tunnel")
+	}
+	configSerial, configChanged := pocketConfigSnapshot()
+	parent, ok := tunnel.Proxies()[d.proxyName]
+	if !ok {
+		return nil, errors.New("route selector missing")
+	}
+	selector, ok := parent.Adapter().(pocketSelector)
+	if !ok {
+		return nil, errors.New("route is not a manual selector")
+	}
+	metadata := &C.Metadata{Type: C.INNER}
+	if err := metadata.SetRemoteAddress(address); err != nil {
+		return nil, err
+	}
+	leaf, revision, changed := selector.PocketRouteSnapshot(metadata)
+	if leaf == nil || leaf.Unwrap(metadata, false) != nil || leaf.ProxyInfo().DialerProxy != "" ||
+		leaf.Type() == C.Direct || leaf.Type() == C.Reject || leaf.Type() == C.RejectDrop || leaf.Type() == C.Pass || leaf.Type() == C.Compatible {
+		return nil, errors.New("route leaf is not eligible")
+	}
+	leafID, parentID := pocketProxyID(leaf), pocketProxyID(parent)
+	if leafID == "" || parentID == "" {
+		return nil, errors.New("route identity unavailable")
+	}
+	valid := func() bool {
+		serial, _ := pocketConfigSnapshot()
+		if serial != configSerial {
+			return false
+		}
+		current, exists := tunnel.Proxies()[d.proxyName]
+		if !exists || pocketProxyID(current) != parentID {
+			return false
+		}
+		now, revisionNow, _ := selector.PocketRouteSnapshot(metadata)
+		return revisionNow == revision && now != nil && pocketProxyID(now) == leafID
+	}
+	return &PocketRoute{Key: fmt.Sprintf("%d:%s:%d:%s", configSerial, parentID, revision, leafID), Changed: changed, ConfigChanged: configChanged, Valid: valid,
+		Dial: func(ctx context.Context, target string) (net.Conn, error) {
+			if target != address || !valid() {
+				return nil, errors.New("frozen route changed")
+			}
+			// Dial the captured actual leaf, never re-read mutable ByName selection.
+			dialMetadata := metadata.Clone()
+			conn, err := leaf.DialContext(ctx, dialMetadata)
+			if err != nil {
+				return nil, err
+			}
+			if !valid() {
+				conn.Close()
+				return nil, errors.New("frozen route changed")
+			}
+			conn.AppendToChains(parent)
+			return statistic.NewTCPTracker(conn, statistic.DefaultManager, dialMetadata, nil, 0, 0, false), nil
+		}}, nil
+}
+
+// Captured proxy references stay alive, so an old pointer cannot be recycled while a pool uses it.
+func pocketProxyID(proxy C.Proxy) string {
+	v := reflect.ValueOf(proxy)
+	if !v.IsValid() || v.Kind() != reflect.Pointer || v.IsNil() {
+		return ""
+	}
+	return fmt.Sprintf("%s:%x", v.Type(), v.Pointer())
+}
+
+// PocketDialError ends the outer listener retry loop for this opt-in route attempt.
+// Its cause remains inspectable; no auth/REP/route rejection is silently retried.
+type PocketDialError struct{ Cause error }
+
+func (e *PocketDialError) Error() string       { return e.Cause.Error() }
+func (e *PocketDialError) Unwrap() error       { return e.Cause }
+func (e *PocketDialError) PocketNoRetry() bool { return true }

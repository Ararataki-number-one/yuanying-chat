+package adapter
+
+import (
+	"encoding/json"
+	"regexp"
+	"strings"
+	"testing"
+)
+
+func pocketFingerprintFixture() map[string]any {
+	return map[string]any{"name": "Japan", "type": "socks5", "server": "127.0.0.1", "port": 1080, "username": "fixture-user", "password": "fixture-secret-only"}
+}
+func pocketFingerprint(t *testing.T, config map[string]any) string {
+	t.Helper()
+	fingerprint, err := ProxyConfigFingerprint(config)
+	if err != nil {
+		t.Fatal(err)
+	}
+	if !regexp.MustCompile(`^[0-9a-f]{64}$`).MatchString(fingerprint) {
+		t.Fatalf("invalid digest: %q", fingerprint)
+	}
+	return fingerprint
+}
+
+func TestPocketNodeFingerprintSurvivesRenameAndGeneratedFields(t *testing.T) {
+	source := pocketFingerprintFixture()
+	expected := pocketFingerprint(t, source)
+	source["name"] = "Exit|Renamed Tokyo"
+	source["id"] = "c3078f73-7493-4298-92d0-f7c8433162d6"
+	source["dialer-proxy"] = "EntryChoice"
+	source["pocket-preconnect"] = true
+	source["pocket-preconnect-epoch-file"] = "/private/app/epoch"
+	source["provider-name"] = "display-only"
+	if got := pocketFingerprint(t, source); got != expected {
+		t.Fatal("generated route/display changed source identity")
+	}
+}
+
+func TestPocketNodeFingerprintAuthenticationAndTLSChanges(t *testing.T) {
+	original := pocketFingerprint(t, pocketFingerprintFixture())
+	for key, value := range map[string]any{"type": "http", "server": "127.0.0.2", "port": 1081, "username": "different-user", "password": "different-secret", "tls": true, "skip-cert-verify": true, "name-cert-verify": "exit.example", "certificate": "fixture-certificate", "private-key": "fixture-private-key", "fingerprint": "sha256:fixture"} {
+		t.Run(key, func(t *testing.T) {
+			source := pocketFingerprintFixture()
+			source[key] = value
+			if got := pocketFingerprint(t, source); got == original {
+				t.Fatal("real connection change retained identity")
+			}
+		})
+	}
+}
+
+func TestPocketNodeFingerprintKeepsProtocolUUIDAndTransport(t *testing.T) {
+	source := map[string]any{"type": "vless", "name": "Entry", "server": "entry.example", "port": 443, "uuid": "0c8f8db3-dca5-4a88-86a8-f12954bcb1a2", "tls": true, "network": "ws", "ws-opts": map[string]any{"path": "/ws", "headers": map[string]any{"name": "real-header-value", "X-Authorization": "fixture-token"}}, "alpn": []any{"h2", "http/1.1"}}
+	baseline := pocketFingerprint(t, source)

+func TestPocketCancelPendingAndBoundedRefill(t *testing.T) {
+	ss, _, d, _, path := pocketFixture(t, 0)
+	ctx, cancel := context.WithCancel(context.Background())
+	d.coldDelay = time.Second
+	done := make(chan error, 1)
+	go func() { _, e := ss.DialContext(ctx, pocketMetadata()); done <- e }()
+	pocketAwait(t, func() bool { return d.dials.Load() == 1 })
+	cancel()
+	select {
+	case e := <-done:
+		if e == nil {
+			t.Fatal("cancelled request succeeded")
+		}
+	case <-time.After(time.Second):
+		t.Fatal("request cancel stuck")
+	}
+	pocketAwait(t, func() bool { return pocketEmpty(ss.pocket) })
+	start := make(chan struct{})
+	var prepares atomic.Int32
+	prepare := func(i *pocketSocksItem) error { prepares.Add(1); <-start; return context.Canceled }
+	var wg sync.WaitGroup
+	for j := 0; j < 32; j++ {
+		wg.Add(1)
+		go func() { defer wg.Done(); ss.pocket.refill(d.route, pocketReadEpoch(path), prepare) }()
+	}
+	wg.Wait()
+	pocketAwait(t, func() bool { return prepares.Load() == 1 })
+	ss.Close()
+	close(start)
+	pocketAwait(t, func() bool { return pocketEmpty(ss.pocket) })
+	if prepares.Load() != 1 {
+		t.Fatal("parallel preparation exceeded one")
+	}
+}

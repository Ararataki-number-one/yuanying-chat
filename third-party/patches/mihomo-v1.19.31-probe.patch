+type pocketTestDialer struct {
+	route      *proxydialer.PocketRoute
+	coldDelay  time.Duration
+	dials      atomic.Int32
+	failFreeze atomic.Bool
+}
+
+func (d *pocketTestDialer) DialContext(ctx context.Context, network, address string) (net.Conn, error) {
+	d.dials.Add(1)
+	if d.coldDelay > 0 {
+		select {
+		case <-time.After(d.coldDelay):
+		case <-ctx.Done():
+			return nil, ctx.Err()
+		}
+	}
+	return (&net.Dialer{}).DialContext(ctx, network, address)
+}
+func (d *pocketTestDialer) ListenPacket(context.Context, string, string, netip.AddrPort) (net.PacketConn, error) {
+	return nil, errors.New("unexpected UDP")
+}
+func (d *pocketTestDialer) PocketFreeze(string) (*proxydialer.PocketRoute, error) {
+	if d.failFreeze.Load() {
+		return nil, errors.New("unsupported")
+	}
+	return d.route, nil
+}
+func pocketFixture(t testing.TB, delay time.Duration) (*Socks5, *pocketWire, *pocketTestDialer, *atomic.Bool, string) {
+	t.Helper()
+	w := newPocketWire(t, delay)
+	path := filepath.Join(t.TempDir(), "epoch")
+	os.WriteFile(path, []byte("ready:network-A-1\n"), 0600)
+	host, port, _ := net.SplitHostPort(w.listener.Addr().String())
+	var p int
+	for _, r := range port {
+		p = p*10 + int(r-'0')
+	}
+	ss, e := NewSocks5(Socks5Option{Name: "FixedExit", Server: host, Port: p, UserName: "user", Password: "password", PocketPreconnect: true, PocketPreconnectEpochFile: path})
+	if e != nil {
+		t.Fatal(e)
+	}
+	alive := new(atomic.Bool)
+	alive.Store(true)
+	d := &pocketTestDialer{coldDelay: delay}
+	d.route = &proxydialer.PocketRoute{Key: "env-one:config-1:selector-1:leaf-A", Changed: make(chan struct{}), ConfigChanged: make(chan struct{}), Valid: alive.Load, Dial: func(ctx context.Context, address string) (net.Conn, error) { return d.DialContext(ctx, "tcp", address) }}
+	ss.dialer = d
+	t.Cleanup(func() { ss.Close() })
+	return ss, w, d, alive, path
+}
+func pocketMetadata() *C.Metadata { return &C.Metadata{Host: "website.test", DstPort: 443} }
+func pocketAwait(t testing.TB, predicate func() bool) {
+	t.Helper()
+	deadline := time.Now().Add(2 * time.Second)
+	for time.Now().Before(deadline) {
+		if predicate() {
+			return
+		}
+		time.Sleep(time.Millisecond)
+	}
+	t.Fatal("condition timeout")
+}
+func pocketReady(p *pocketSocksPool) bool { p.mu.Lock(); defer p.mu.Unlock(); return p.ready != nil }
+func pocketEmpty(p *pocketSocksPool) bool {
+	p.mu.Lock()
+	defer p.mu.Unlock()
+	return p.ready == nil && p.preparing == nil && len(p.leases) == 0
+}
+func pocketDialClose(t testing.TB, ss *Socks5) {
+	t.Helper()
+	c, e := ss.DialContext(context.Background(), pocketMetadata())
+	if e != nil {
+		t.Fatal(e)
+	}
+	c.Close()
+}

+// Copy source maps so filters/overrides cannot mutate the next refresh identity.
+// Strip generated controls recursively only at the node top-level; nested HTTP
+// headers named "name"/"pocket-*" remain real connection data.
+func pocketProviderMapping(source map[string]any) map[string]any {
+	clone := make(map[string]any, len(source))
+	for key, value := range source {
+		normalized := strings.ToLower(strings.ReplaceAll(key, "_", "-"))
+		if strings.HasPrefix(normalized, "pocket-") {
+			continue
+		}
+		clone[key] = pocketProviderCopy(value)
+	}
+	return clone
+}
+
+func pocketProviderCopy(value any) any {
+	switch value := value.(type) {
+	case map[string]any:
+		clone := make(map[string]any, len(value))
+		for key, item := range value {
+			clone[key] = pocketProviderCopy(item)
+		}
+		return clone
+	case []any:
+		clone := make([]any, len(value))
+		for index, item := range value {
+			clone[index] = pocketProviderCopy(item)
+		}
+		return clone
+	default:
+		return value
+	}
+}
+
+func pocketSelectedSocks(mapping map[string]any) bool {
+	if mapping["type"] != "socks5" {
+		return false
+	}
+	mux, ok := mapping["smux"].(map[string]any)
+	if !ok {
+		return true
+	}
+	decoder := structure.NewDecoder(structure.Option{TagName: "proxy", WeaklyTypedInput: true, KeyReplacer: structure.DefaultKeyReplacer})
+	option := &outbound.SingMuxOption{}
+	return decoder.Decode(mux, option) == nil && !option.Enabled
+}

+type lateProbeAdapter struct {
+	C.ProxyAdapter
+	calls   atomic.Int32
+	started chan struct{}
+	release chan struct{}
+	closed  chan struct{}
+}
+
+type closingProbeConn struct {
+	C.Conn
+	closed chan struct{}
+	once   sync.Once
+}
+
+func (c *closingProbeConn) Close() error {
+	c.once.Do(func() { close(c.closed) })
+	return c.Conn.Close()
+}
+
+func (p *lateProbeAdapter) DialContext(ctx context.Context, metadata *C.Metadata) (C.Conn, error) {
+	if p.calls.Add(1) == 1 {
+		return p.ProxyAdapter.DialContext(ctx, metadata)
+	}
+	close(p.started)
+	<-p.release
+	// Deliberately violate cancellation in this fixture to reproduce a tardy
+	// asynchronous HTTP dial completion. Ownership must still close the socket.
+	conn, err := p.ProxyAdapter.DialContext(context.Background(), metadata)
+	if err != nil {
+		return nil, err
+	}
+	return &closingProbeConn{Conn: conn, closed: p.closed}, nil
+}

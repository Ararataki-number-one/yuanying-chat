+func pocketFreeze(t *testing.T, tunnel C.Tunnel) *proxydialer.PocketRoute {
+	t.Helper()
+	freezer, ok := proxydialer.NewByName("EntryChoice", tunnel).(interface {
+		PocketFreeze(string) (*proxydialer.PocketRoute, error)
+	})
+	if !ok {
+		t.Fatal("actual ByName dialer lacks the route freezer")
+	}
+	route, err := freezer.PocketFreeze("exit.example:1080")
+	if err != nil {
+		t.Fatal(err)
+	}
+	return route
+}
+func pocketClosed(channel <-chan struct{}) bool {
+	select {
+	case <-channel:
+		return true
+	default:
+		return false
+	}
+}

+type pocketTestLeaf struct {
+	*outbound.Base
+	dials    atomic.Int32
+	info     C.ProxyInfo
+	nested   C.Proxy
+	onDial   func()
+	client   net.Conn
+	peer     net.Conn
+	metadata C.Metadata
+}
+
+func (l *pocketTestLeaf) ProxyInfo() C.ProxyInfo           { return l.info }
+func (l *pocketTestLeaf) Unwrap(*C.Metadata, bool) C.Proxy { return l.nested }
+func (l *pocketTestLeaf) DialContext(ctx context.Context, m *C.Metadata) (C.Conn, error) {
+	if err := ctx.Err(); err != nil {
+		return nil, err
+	}
+	l.dials.Add(1)
+	l.metadata = *m
+	l.client, l.peer = net.Pipe()
+	if l.onDial != nil {
+		l.onDial()
+	}
+	return outbound.NewConn(l.client, l), nil
+}
+func pocketLeaf(t *testing.T, name string, kind C.AdapterType) (*pocketTestLeaf, C.Proxy) {
+	t.Helper()
+	leaf := &pocketTestLeaf{Base: outbound.NewBase(outbound.BaseOption{Name: name, Type: kind, Addr: name + ":443"})}
+	t.Cleanup(func() {
+		if leaf.client != nil {
+			leaf.client.Close()
+		}
+		if leaf.peer != nil {
+			leaf.peer.Close()
+		}
+	})

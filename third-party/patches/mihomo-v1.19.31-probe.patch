+package outboundgroup_test
+
+import (
+	"sync"
+	"testing"
+
+	"github.com/metacubex/mihomo/adapter"
+	"github.com/metacubex/mihomo/adapter/outbound"
+	"github.com/metacubex/mihomo/adapter/outboundgroup"
+	C "github.com/metacubex/mihomo/constant"
+	P "github.com/metacubex/mihomo/constant/provider"
+)
+
+type preconnectSelectorProvider struct {
+	P.ProxyProvider
+	mu      sync.RWMutex
+	version uint32
+	proxies []C.Proxy
+}
+
+func (p *preconnectSelectorProvider) Version() uint32 {
+	p.mu.RLock()
+	defer p.mu.RUnlock()
+	return p.version
+}
+func (p *preconnectSelectorProvider) Proxies() []C.Proxy {
+	p.mu.RLock()
+	defer p.mu.RUnlock()
+	return append([]C.Proxy{}, p.proxies...)
+}
+func (p *preconnectSelectorProvider) Touch() {}
+func (p *preconnectSelectorProvider) replace(proxies ...C.Proxy) {
+	p.mu.Lock()
+	defer p.mu.Unlock()
+	p.proxies = proxies
+	p.version++
+}
+func preconnectSelectorLeaf(name string) C.Proxy {
+	return adapter.NewProxy(outbound.NewBase(outbound.BaseOption{Name: name, Type: C.Vless, Addr: name + ":443"}))
+}
+func preconnectSelector(t *testing.T) (*outboundgroup.Selector, *preconnectSelectorProvider, C.Proxy, C.Proxy) {
+	t.Helper()
+	a, b := preconnectSelectorLeaf("A"), preconnectSelectorLeaf("B")
+	provider := &preconnectSelectorProvider{version: 1, proxies: []C.Proxy{a, b}}
+	selector, err := outboundgroup.NewSelector(outboundgroup.GroupCommonOption{Name: "EntryChoice"}, outboundgroup.SelectorOption{DefaultSelected: "A"}, a, []P.ProxyProvider{provider})
+	if err != nil {
+		t.Fatal(err)
+	}
+	return selector, provider, a, b
+}
+func preconnectSelectorClosed(channel <-chan struct{}) bool {
+	select {
+	case <-channel:
+		return true
+	default:
+		return false
+	}
+}
+
+func TestSelectorPreconnectABAKeepsMonotonicRevisionAndClosesEachPriorSignal(t *testing.T) {
+	selector, _, a, b := preconnectSelector(t)
+	first, r1, c1 := selector.PocketRouteSnapshot(&C.Metadata{})
+	if first != a || preconnectSelectorClosed(c1) {
+		t.Fatal("initial actual leaf or cancellation signal is wrong")
+	}
+	if err := selector.Set("B"); err != nil {
+		t.Fatal(err)
+	}
+	second, r2, c2 := selector.PocketRouteSnapshot(&C.Metadata{})
+	if second != b || r2 <= r1 || !preconnectSelectorClosed(c1) || preconnectSelectorClosed(c2) || c1 == c2 {
+		t.Fatal("B did not publish a new revision and cancellation signal")
+	}
+	selector.ForceSet("A")
+	third, r3, c3 := selector.PocketRouteSnapshot(&C.Metadata{})
+	if third != a || r3 <= r2 || !preconnectSelectorClosed(c2) || preconnectSelectorClosed(c3) || c3 == c1 || c3 == c2 {
+		t.Fatal("return to A reused its former selector generation")
+	}
+}
+
+func TestSelectorPreconnectHealthyRepeatAndMissingNameDoNotInvalidate(t *testing.T) {
+	selector, _, a, _ := preconnectSelector(t)
+	_, before, signal := selector.PocketRouteSnapshot(&C.Metadata{})
+	for i := 0; i < 10; i++ {
+		if err := selector.Set("A"); err != nil {
+			t.Fatal(err)
+		}
+		selector.ForceSet("A")
+	}
+	if selector.Set("unknown") == nil {
+		t.Fatal("unknown selection unexpectedly succeeded")
+	}
+	current, revision, same := selector.PocketRouteSnapshot(&C.Metadata{})
+	if current != a || revision != before || same != signal || preconnectSelectorClosed(signal) {
+		t.Fatal("unchanged healthy or rejected selection churned generation")
+	}
+}
+
+func TestSelectorPreconnectSameNamedProviderReplacementReturnsActualNewLeaf(t *testing.T) {
+	selector, provider, a, b := preconnectSelector(t)
+	_, before, signal := selector.PocketRouteSnapshot(&C.Metadata{})
+	replacement := preconnectSelectorLeaf("A")
+	if replacement == a {
+		t.Fatal("fixture reused actual leaf ID")
+	}
+	provider.replace(replacement, b)
+	current, revision, same := selector.PocketRouteSnapshot(&C.Metadata{})
+	if current.Name() != "A" || current != replacement || revision != before || same != signal || preconnectSelectorClosed(signal) {
+		t.Fatal("provider replacement was confused with a manual selection change or returned the stale leaf")
+	}
+	// The route key additionally uses actual leaf identity. Provider replacement
+	// need not fabricate Set events to expose this different adapter.
+}
+
+func TestSelectorPreconnectConcurrentSnapshotAndSelectionUseActualLeaves(t *testing.T) {
+	selector, _, a, b := preconnectSelector(t)
+	done := make(chan error, 1)
+	go func() {
+		for i := 0; i < 200; i++ {
+			name := "A"
+			if i%2 == 0 {
+				name = "B"
+			}
+			if err := selector.Set(name); err != nil {
+				done <- err
+				return
+			}
+		}
+		done <- nil
+	}()
+	var previous uint64
+	for i := 0; i < 200; i++ {
+		leaf, revision, changed := selector.PocketRouteSnapshot(&C.Metadata{})
+		if leaf == nil || (leaf != a && leaf != b) || revision < previous || changed == nil {
+			t.Fatal("concurrent snapshot returned an unrelated leaf, regressed revision, or lacked a cancellation signal")
+		}
+		previous = revision
+	}
+	if err := <-done; err != nil {
+		t.Fatal(err)
+	}
+	selector.ForceSet("A")
+	leaf, revision, _ := selector.PocketRouteSnapshot(&C.Metadata{})
+	if leaf != a || revision < previous {
+		t.Fatal("final stable selection is inconsistent")
+	}
+}

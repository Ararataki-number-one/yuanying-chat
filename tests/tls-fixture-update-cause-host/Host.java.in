package local.pocketchat;
import android.content.*;import android.app.job.*;import java.util.*;
/** Explicit causal model of framework queues; never an observed Android cause. */
public final class Host {
 static int checks;static void check(String name,boolean value){if(!value)throw new AssertionError(name);checks++;}
 static void reset(){android.content.Context.resolver.reset();android.content.Context.jobs.reset();AppUpdateManager.queue.tasks.clear();AppSettings.autoCheck=true;Profiles.slot=1;}
 public static void main(String[]args){
  reset();AppSettings.autoCheck=false;AppUpdates.schedule(new MainActivity());
  check("Disabled auto-check cancels both jobs",Context.jobs.cancelled.equals(Arrays.asList(AppUpdates.ON_OPEN,AppUpdates.PERIODIC))&&Context.jobs.pending.isEmpty());
  check("Actual schedule still queues origin before auto-check",AppUpdateManager.queue.tasks.size()==1&&Context.resolver.launches==0);
  Context.resolver.mainRunning=false;AppUpdateManager.queue.drain();
  check("Declared pending-provider boundary can start main after modeled stop",Context.resolver.mainRunning&&Context.resolver.launches==1);
  check("Actual queued origin targets fixed own update provider",Context.resolver.uri.equals("content://local.pocketchat.test.app-updates")&&Context.resolver.action.equals("origin")&&Context.resolver.slot==1);
  reset();AppUpdates.schedule(new MainActivity());
  check("Default schedule creates original two jobs",Context.jobs.pending.size()==2&&AppUpdateManager.queue.tasks.size()==1);
  JobInfo opened=Context.jobs.pending.get(AppUpdates.ON_OPEN),periodic=Context.jobs.pending.get(AppUpdates.PERIODIC);
  check("On-open job retains exact original minimum latency",opened.latency==1000&&opened.network==JobInfo.NETWORK_TYPE_ANY);
  check("Periodic job uses exact update service and persistence",periodic.period==AppUpdatePolicy.DAY&&periodic.persisted&&periodic.component.equals("local.pocketchat.AppUpdateJob"));
  AppUpdateManager.queue.drain();check("Provider origin is independent from scheduled job execution",Context.resolver.launches==1&&Context.jobs.pending.size()==2);
  reset();AppUpdates.remember(new Context(),-1);AppUpdates.remember(new Context(),Profiles.MAX);check("Unknown slots cannot queue a provider launch",AppUpdateManager.queue.tasks.isEmpty());
  reset();AppSettings.autoCheck=false;AppUpdates.schedule(new Context());check("Generic context has no implicit origin request",AppUpdateManager.queue.tasks.isEmpty()&&Context.resolver.launches==0&&Context.jobs.pending.isEmpty());
  reset();AppSettings.autoCheck=false;Context.resolver.enabled=false;AppUpdates.schedule(new MainActivity());AppUpdateManager.queue.drain();
  check("Explicit modeled provider denial prevents its launch",Context.resolver.launches==0&&!Context.resolver.mainRunning&&Context.resolver.calls==1);
  check("Denied callback is bounded without automatic retry",AppUpdateManager.queue.tasks.isEmpty()&&Context.jobs.pending.isEmpty());
  System.out.println("{\"status\":\"passed\",\"checks\":"+checks+",\"actualAndroidExecution\":false,\"actualObservedProcessCause\":false}");
 }
}

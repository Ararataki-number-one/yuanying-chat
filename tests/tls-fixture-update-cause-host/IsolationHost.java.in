package local.pocketchat;
import android.content.*;import android.app.job.*;import java.util.*;import java.util.concurrent.atomic.*;
/** Actual setting methods/helpers/callbacks with explicit JVM framework boundaries. */
public final class IsolationHost {
 static int checks;static void check(String name,boolean yes){if(!yes)throw new AssertionError(name);checks++;}
 interface Work{void run()throws Exception;}
 static void reject(String name,Work work){boolean denied=false;try{work.run();}catch(Throwable expected){denied=true;}check(name,denied);}
 static void bg(Work work)throws Exception{AtomicReference<Throwable>error=new AtomicReference<>();Thread t=new Thread(()->{try{work.run();}catch(Throwable e){error.set(e);}});t.start();t.join(5000);if(t.isAlive())throw new AssertionError("bounded setup deadlocked");Throwable e=error.get();if(e!=null)throw new AssertionError("actual writer helper failed",e);}
 static void reset(){android.os.Looper.main=Thread.currentThread();Context.packageName="local.pocketchat.test";Context.available=true;Context.resolver.reset();Context.jobs.reset();ProfileCatalog.db.values.clear();ProfileCatalog.db.dropWrites=ProfileCatalog.db.rejectReads=false;Context.jobs.rejectCancel=false;AppUpdateManager.queue.tasks.clear();IsolationState.resumes=IsolationState.failures=0;}
 static JobInfo seed(int id){JobInfo value=new JobInfo.Builder(id,new ComponentName(new Context(),AppUpdateJob.class)).build();Context.jobs.pending.put(id,value);return value;}
 static void prepare(Context c)throws Exception{bg(()->GeckoTlsAcceptanceActivity.pauseFixtureUpdateChecks(c));}
 static void resume(MainActivity c){c.onResume();}
 public static void main(String[]args)throws Exception{
  MainActivity[]owners={new GeckoTlsAcceptanceActivity.Profile1(),new GeckoTlsAcceptanceActivity.Profile2(),new GeckoTlsCpuIpComboIntegrationActivity()};
  for(MainActivity c:owners){
   reset();seed(AppUpdates.ON_OPEN);seed(AppUpdates.PERIODIC);JobInfo transfer=seed(AppUpdates.TRANSFER),other=seed(7777);prepare(c);
   check("Actual shared storage exact false readback "+c.getClass().getName(),"false".equals(AppSettings.get(c,"updateAutoCheck","missing")));
   check("Only owned automatic jobs cancelled "+c.getClass().getName(),Context.jobs.cancelled.equals(Arrays.asList(AppUpdates.ON_OPEN,AppUpdates.PERIODIC))&&Context.jobs.pending.get(AppUpdates.TRANSFER)==transfer&&Context.jobs.pending.get(7777)==other);
   resume(c);check("Actual callback reaches original super exactly once",IsolationState.resumes==1&&IsolationState.failures==0);
   check("Repeated original schedule cannot recreate auto jobs",Context.jobs.pending.get(AppUpdates.ON_OPEN)==null&&Context.jobs.pending.get(AppUpdates.PERIODIC)==null&&Context.jobs.pending.get(AppUpdates.TRANSFER)==transfer);
   AppUpdateManager.queue.drain();check("Original origin provider remains available",Context.resolver.launches==1&&Context.resolver.action.equals("origin"));
  }
  reset();final MainActivity c=new GeckoTlsAcceptanceActivity.Profile1();prepare(c);ProfileCatalog.db.values.put("updateAutoCheck","true");
  reject("Late warm setting change rejects original callback",()->resume(c));check("Failed warm resume reports before any super schedule",IsolationState.failures==1&&IsolationState.resumes==0&&AppUpdateManager.queue.tasks.isEmpty());
  prepare(c);resume(c);check("Warm writer reestablishes setting before resume",IsolationState.resumes==1&&Context.jobs.pending.get(AppUpdates.ON_OPEN)==null);
  reset();final MainActivity unprepared=new GeckoTlsAcceptanceActivity.Profile2();reject("Unprepared cold resume fails closed",()->resume(unprepared));check("No unprepared schedule runs",IsolationState.resumes==0&&IsolationState.failures==1);
  reset();final Context scoped=new GeckoTlsAcceptanceActivity.Profile1();reject("Setup cannot run on main thread",()->GeckoTlsAcceptanceActivity.pauseFixtureUpdateChecks(scoped));check("Rejected main setup performs no write or cancellation",ProfileCatalog.db.values.isEmpty()&&Context.jobs.cancelled.isEmpty());
  reset();ProfileCatalog.db.dropWrites=true;reject("Actual silent SQLite insert failure is detected by readback",()->prepare(scoped));check("Failed write creates no false setting",ProfileCatalog.db.values.isEmpty());
  reset();ProfileCatalog.db.rejectReads=true;reject("Actual setting query exception fails closed",()->prepare(scoped));
  reset();Context.jobs.rejectCancel=true;seed(AppUpdates.ON_OPEN);reject("Scheduler cancellation failure is not ignored",()->prepare(scoped));check("Cancellation failure leaves known pending job visible",Context.jobs.pending.containsKey(AppUpdates.ON_OPEN));
  reset();Context.available=false;reject("Missing framework scheduler is not ready",()->prepare(scoped));
  reset();Context.packageName="local.pocketchat";reject("Production package cannot pause updates through test helper",()->prepare(scoped));check("Wrong package writes no setting",ProfileCatalog.db.values.isEmpty());
  reset();reject("Other integration activities cannot acquire scope",()->prepare(new MainActivity()));check("Foreign activity cancels no jobs",Context.jobs.cancelled.isEmpty());
  reset();GeckoTlsAcceptanceActivity.Profile1 completed=new GeckoTlsAcceptanceActivity.Profile1();prepare(completed);completed.terminal=true;completed.failure="";ProfileCatalog.db.values.put("updateAutoCheck","true");reject("Late resume retires a previously passed record",completed::onResume);check("Original terminal guard cannot preserve stale success",completed.terminal&&!completed.failure.isEmpty()&&IsolationState.failures==1&&IsolationState.resumes==0);
  reset();GeckoTlsCpuIpComboIntegrationActivity finished=new GeckoTlsCpuIpComboIntegrationActivity();prepare(finished);finished.terminal=true;finished.failure="";ProfileCatalog.db.values.put("updateAutoCheck","true");reject("Combined late resume retires previous success",finished::onResume);check("Combined original failure publisher is reached",finished.terminal&&!finished.failure.isEmpty()&&IsolationState.failures==1&&IsolationState.resumes==0);
  reset();completed=new GeckoTlsAcceptanceActivity.Profile1();prepare(completed);completed.terminal=true;completed.failure="OriginalFailure";ProfileCatalog.db.values.put("updateAutoCheck","true");final GeckoTlsAcceptanceActivity.Profile1 priorFailed=completed;reject("Already failed record remains failed",priorFailed::onResume);check("Previous failure reason is not overwritten",completed.failure.equals("OriginalFailure")&&IsolationState.resumes==0);
  reset();prepare(scoped);seed(AppUpdates.PERIODIC);final MainActivity late=new GeckoTlsAcceptanceActivity.Profile1();reject("Late owned pending job prevents schedule callback",()->resume(late));check("Late job remains visible and was not re-killed",Context.jobs.pending.containsKey(AppUpdates.PERIODIC)&&IsolationState.resumes==0);
  reset();prepare(new GeckoTlsAcceptanceActivity.Profile1());new GeckoTlsAcceptanceActivity.Profile2().onResume();check("Both environment profiles observe shared exact false",IsolationState.resumes==1);
  // Declared pm-clear boundary: the device runner already executes real pm clear
  // in finally; this only checks that absence retains the production default.
  ProfileCatalog.db.values.clear();Context.jobs.reset();AppUpdates.schedule(new MainActivity());check("Fresh isolated data restores original update default",Context.jobs.pending.containsKey(AppUpdates.ON_OPEN)&&Context.jobs.pending.containsKey(AppUpdates.PERIODIC));
  System.out.println("{\"status\":\"passed\",\"checks\":"+checks+",\"actualAndroidExecution\":false}");
 }
}

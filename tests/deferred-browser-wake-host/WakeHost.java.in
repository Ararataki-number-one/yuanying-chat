package local.pocketchat;
import java.util.*;import java.util.concurrent.Executor;import org.json.*;import android.os.SystemClock;

/** Scripted actor, persistence and DOM boundaries; extracted application methods remain unchanged. */
final class WorkQueue implements Executor {
 static final class Job {final Runnable task;final long at;Job(Runnable t,long a){task=t;at=a;}}
 final ArrayList<Job> jobs=new ArrayList<>();int posts;
 public void execute(Runnable task){post(task);}void post(Runnable task){postDelayed(task,0);}void postDelayed(Runnable task,long delay){posts++;jobs.add(new Job(task,SystemClock.now+delay));}
 void removeCallbacks(Runnable task){jobs.removeIf(j->j.task==task);}int count(Runnable task){return (int)jobs.stream().filter(j->j.task==task).count();}
 void runDue(){for(int i=0,limit=0;i<jobs.size();){Job j=jobs.get(i);if(j.at>SystemClock.now){i++;continue;}if(++limit>100)throw new AssertionError("Unexpected recurring actor work");jobs.remove(i);j.task.run();i=0;}}
 void advance(long ms){SystemClock.now+=ms;runDue();}
}
final class Prefs {final Map<String,Object> values=new HashMap<>();boolean contains(String k){return values.containsKey(k);}int getInt(String k,int f){Object o=values.get(k);return o instanceof Number?((Number)o).intValue():f;}boolean getBoolean(String k,boolean f){Object o=values.get(k);return o instanceof Boolean?(Boolean)o:f;}String getString(String k,String f){Object o=values.get(k);return o instanceof String?(String)o:f;}Editor edit(){return new Editor();}final class Editor{Editor putInt(String k,int v){values.put(k,v);return this;}Editor putBoolean(String k,boolean v){values.put(k,v);return this;}Editor putString(String k,String v){values.put(k,v);return this;}Editor remove(String k){values.remove(k);return this;}boolean commit(){return true;}}}
final class Context {boolean desktop;int displayWrites,draftWrites;}
final class Identity {final ChatSession s;boolean queueUnavailable;Identity(ChatSession s){this.s=s;}boolean pendingWork(){return !queueUnavailable&&DeferredBrowserSettings.pending(s);}}
final class Privacy {final ChatSession s;boolean desktop;Privacy(ChatSession s){this.s=s;}int level(){return s.prefs.getInt("privacyLevel",1);}boolean wantsDesktop(){return s.context.desktop;}}
final class Web {String url="https://127.0.0.1:19446/fixture";boolean failed,resourceDeferred,visible=true;int checkpoints,pauses,resumes;String getUrl(){return url;}boolean resourcePage(String u){return MainActivity.chatUrl(u);}boolean resourceSamePage(String a,String b){return Objects.equals(a,b);}boolean hasVisibleDocument(){return visible;}boolean hasOpenPopup(){return false;}void checkpointState(){checkpoints++;}void resumeTimers(){}void pauseTimers(){}void onResume(){resumes++;}void onPause(){pauses++;}void retryResourceStart(){throw new AssertionError("Cold runtime allocation outside wake host");}}
final class Page {String value="unsent user draft";int remembered;String scope(){return "owner:1/document:8";}void remember(String scope,String url,JSONObject state){remembered++;}}
final class Store {final WorkQueue worker=new WorkQueue();}
final class Uploads {boolean active;boolean active(long epoch){return active;}final JSONArray list=new JSONArray();boolean observe(JSONObject value,String doc,long epoch){if(value.optBoolean("released")){active=false;return true;}return false;}int stable(){return active?0:2;}JSONArray names(){return list;}}
final class BackgroundReplyPolicy {static boolean enabled;static boolean enabledCached(){return enabled;}}
final class ChatService {static boolean running;static int begins,completions,ends;static void begin(Object c){begins++;throw new AssertionError("Wake must not start reply service");}static void completed(Object c,String id,String url){completions++;}static void end(Object c){ends++;}}
final class NetworkRegion {static int refreshes;static void refresh(ChatSession s){refreshes++;}}
final class NativeNetwork {static NativeNetwork get(Object c){throw new AssertionError("Route mutation outside wake host");}void pauseBackgroundWhenBusy(){throw new AssertionError("Internal route outside wake host");}}
final class NetworkUiProvider {static int nativeEvents;static void nativeWorkChanged(ChatSession s){nativeEvents++;}@TASK_IDLE@}
final class ProfileUi {@PROFILE_WORKING@}
final class Profiles {static int slot(Object c){return 1;}}
final class ProfileCatalog {final Context c;ProfileCatalog(Context c){this.c=c;}static ProfileCatalog get(Context c){return new ProfileCatalog(c);}void browserDisplay(int slot,boolean desktop){c.desktop=desktop;c.displayWrites++;}}
final class MainActivity {@CHAT_URL@}
final class WebReplyObserver {static boolean same(String a,String b){return Objects.equals(a,b);}}
final class LoginPagePolicy {static boolean login(String u){return false;}}
final class Audit {boolean running;}
final class LocalDraftPolicy {static boolean enabled(Object c){return true;}static long revision(Object c){return 1;}}
final class DraftArchive {final Context c;DraftArchive(Context c){this.c=c;}static DraftArchive get(Context c){return new DraftArchive(c);}boolean save(String u,String draft,String why,long revision){c.draftWrites++;return true;}}
final class PageMemory {@COMPLETE_DRAFT@ @HAS_DRAFT@}
final class ChatSession {
 static ChatSession instance;
 final Context context=new Context();final Prefs prefs=new Prefs();final WorkQueue handler=new WorkQueue();final Web web=new Web();final Page pageMemory=new Page();final Store webStore=new Store();final Privacy privacy=new Privacy(this);final Identity identity=new Identity(this);final Audit audit=new Audit();final Uploads resourceUploads=new Uploads();
 final JSONArray attachments=new JSONArray();JSONObject pending,state=new JSONObject();String conversation=web.url,activeDeliveryId="",status="",replyHealthStatus="",resourceObserverDocument="document-observed",deliveryStage="";
 boolean resourceWebsiteUploading;boolean identityApplicationPending;boolean deleted,uiVisible,submitting,operation,inFlight,configurationCapture,transferActive,nativeFileWorkBusy,browserPaused,connecting,navigating,websiteRecovering,recoveryScheduled,offline,navigationFailed,networkReady=true,replyStalled,known=true,replyBusy;
 int resourceChoosers,resourceFilePreparations,applied,syncs,resourceUploadStable;JSONArray resourceUploadNames=new JSONArray();long resourceWebsiteEpoch=-1,lastDeferredBrowserAttempt,navigationEpoch=8,resourceObserverEpoch=8,fileWorkGeneration,navigationMono;
 static final class Action {final String name;final Result done;Action(String n,Result d){name=n;done=d;}}
 final ArrayDeque<Action> actions=new ArrayDeque<>();interface Result{void accept(JSONObject value);}
 ChatSession(){instance=this;prefs.edit().putInt("privacyLevel",1).commit();}
 void applyBrowserSettings(boolean protection){applied++;privacy.desktop=context.desktop;}void setStatus(String s){status=s;}void delivery(String id,String stage,String detail,boolean attempted,String key,String url){deliveryStage=stage;}void changed(){}
 boolean internalNetwork(){return false;}boolean resourceRestoreWork(){return false;}boolean currentReplyActive(){return replyBusy;}boolean resourcePageUnknown(){return web.resourcePage(web.getUrl())&&!known;}boolean webPerformance(){return true;}void sync(){syncs++;}void checkBackgroundAttachments(){}void checkResourceUploads(){}
 TaskGuardSnapshot taskGuardSnapshot(){return new TaskGuardSnapshot(known,replyBusy||pending!=null,fileWorkActive(),submitting,operation,transferActive,1,3,"owner-one",navigationEpoch,"binding-one","document-observed",1,fileWorkGeneration);}
 void asyncDriver(String action,JSONObject args,long timeout,Result done){actions.add(new Action(action,done));}
 void reply(String name,JSONObject value){Action action=actions.remove();if(!name.equals(action.name))throw new AssertionError("Unexpected bounded driver "+action.name);action.done.accept(value);}
 @CHAT_METHODS@
 @WAKE_MEMBERS@
 @TICK@
}
public final class WakeHost {
 static final JSONArray checks=new JSONArray();static boolean fixed=Boolean.getBoolean("fixed");
 static void check(String name,boolean pass){checks.put(J.obj("name",name,"pass",pass));if(!pass)throw new AssertionError(name);}
 static ChatSession fresh(boolean chat){SystemClock.now=20001;BackgroundReplyPolicy.enabled=false;ChatService.running=false;ChatSession s=new ChatSession();if(chat){s.web.url="https://chatgpt.com/c/controlled";s.conversation=s.web.url;}return s;}
 static void save(ChatSession s){DeferredBrowserSettings.save(s,2,true);}
 static void finish(ChatSession s){JSONObject job=s.pending==null?J.obj("id","job-one"):s.pending;s.completeReply(job,J.obj("url",s.web.getUrl(),"userKey","id:user"));}
 static JSONObject inspect(ChatSession s,boolean busy){return J.obj("url",s.web.getUrl(),"busy",busy,"draft",s.pageMemory.value,"draftRaw",s.pageMemory.value);}
 static JSONObject page(ChatSession s){return J.obj("ok",true,"draft",s.pageMemory.value,"draftComplete",true,"hasDraft",true,"draftLength",s.pageMemory.value.length());}
 static void captured(ChatSession s){s.reply("inspect",inspect(s,false));s.reply("page-state",page(s));s.webStore.worker.runDue();s.handler.runDue();s.reply("inspect",inspect(s,false));}
 static void quiet(ChatSession s,String name){int sync=s.syncs,posts=s.handler.posts;s.handler.advance(60000);check(name,s.handler.jobs.isEmpty()&&s.actions.isEmpty()&&s.syncs==sync&&s.handler.posts==posts&&!BackgroundReplyPolicy.enabled&&ChatService.begins==0);}
 static void baseline()throws Exception{ChatSession s=fresh(false);save(s);s.pending=J.obj("id","job-before");s.updateBrowserActivity();s.handler.runDue();finish(s);s.changed();s.tick.run();s.handler.advance(8500);check("Source7 pending settings remain stranded after actual completeReply with detection off",DeferredBrowserSettings.pending(s)&&s.applied==0&&s.pending==null&&s.handler.jobs.isEmpty());check("Source7 counterexample does not require enabling background polling or service",!BackgroundReplyPolicy.enabled&&ChatService.begins==0&&s.syncs==0);}
 static void current()throws Exception{
  ChatSession s=fresh(false);for(int i=0;i<20;i++)s.updateBrowserActivity();check("No queued browser configuration schedules no maintenance",s.handler.jobs.isEmpty());
  save(s);s.pending=J.obj("id","job-busy");for(int i=0;i<20;i++)s.updateBrowserActivity();check("Repeated activity events coalesce one pending-only wake",s.handler.count(s.deferredBrowserWake)==1);s.handler.runDue();check("Reply busy wake keeps stored settings without recurring jobs",s.applied==0&&DeferredBrowserSettings.pending(s)&&s.handler.jobs.isEmpty());finish(s);s.changed();s.handler.runDue();check("Actual completion applies legitimate non-chat settings without reply polling",s.applied==1&&s.pending==null&&!DeferredBrowserSettings.pending(s)&&s.syncs==0&&"completed".equals(s.deliveryStage));check("Completion preserves draft and optional detection stays off",s.pageMemory.value.equals("unsent user draft")&&!BackgroundReplyPolicy.enabled&&ChatService.begins==0);quiet(s,"Applied non-chat settings schedule no idle recurrence");
  s=fresh(true);save(s);s.known=false;s.updateBrowserActivity();s.handler.runDue();check("Unknown chat task guard cannot authorize queued settings",s.applied==0&&s.actions.isEmpty()&&DeferredBrowserSettings.pending(s));s.known=true;s.updateBrowserActivity(false);s.handler.runDue();check("Fresh known idle chat event starts the existing bounded draft capture",s.operation&&s.configurationCapture&&s.actions.size()==1);captured(s);check("Existing complete captured idle flow applies once",s.applied==1&&s.context.draftWrites==1&&s.web.checkpoints==1&&!s.operation&&!s.configurationCapture);quiet(s,"Captured application does not restart reply polls or service");
  s=fresh(true);save(s);s.replyBusy=true;s.updateBrowserActivity();s.handler.runDue();check("Known website reply work blocks maintenance",s.applied==0&&s.actions.isEmpty());s.replyBusy=false;s.updateBrowserActivity();s.handler.runDue();captured(s);check("Next genuine reply-work end retries the stored settings",s.applied==1);
  for(boolean chooser:new boolean[]{false,true}){s=fresh(false);save(s);s.resourceFileWork(chooser,true);s.handler.runDue();check("Native file work keeps settings pending "+chooser,s.applied==0&&DeferredBrowserSettings.pending(s));s.resourceFileWork(chooser,false);s.handler.runDue();check("Actual native file end wakes pending settings "+chooser,s.applied==1&&!DeferredBrowserSettings.pending(s));quiet(s,"File-end wake adds no idle recurrence "+chooser);}
  s=fresh(false);save(s);s.transferActive=true;s.updateBrowserActivity();s.handler.runDue();check("Active native download blocks application",s.applied==0);s.transferActive=false;s.updateBrowserActivity();s.handler.runDue();check("Download completion event applies the pending settings",s.applied==1);
  s=fresh(false);save(s);s.resourceUploads.active=true;s.updateBrowserActivity();s.handler.runDue();check("Active upload retains pending browser settings",s.applied==0);JSONArray names=s.resourceUploadNames;s.resourceUploadObservation(J.obj("released",true),s.navigationEpoch,names,s.web.getUrl());s.handler.runDue();check("Actual upload release callback wakes the pending settings",s.applied==1);
  s=fresh(false);save(s);s.updateBrowserActivity();s.deleted=true;s.handler.runDue();check("Deleted session cannot apply its queued callback",s.applied==0&&DeferredBrowserSettings.pending(s)&&s.handler.jobs.isEmpty());
  s=fresh(false);save(s);s.updateBrowserActivity();new ChatSession();s.handler.runDue();check("Retired owner cannot apply through a newer current session",s.applied==0&&DeferredBrowserSettings.pending(s));
  s=fresh(false);save(s);s.updateBrowserActivity();DeferredBrowserSettings.cancel(s);s.handler.runDue();check("Cancelled queue has no settings application",s.applied==0);
  s=fresh(false);save(s);s.identity.queueUnavailable=true;s.updateBrowserActivity();check("Unavailable candidate schedules no wake",s.handler.jobs.isEmpty());
  s=fresh(false);save(s);s.lastDeferredBrowserAttempt=SystemClock.now-1000;s.updateBrowserActivity();s.handler.advance(8999);check("Existing throttle cannot be bypassed by a work event",s.applied==0&&DeferredBrowserSettings.pending(s));s.handler.advance(1);check("Single delayed wake uses only the original remaining throttle",s.applied==1&&s.handler.jobs.isEmpty());
  s=fresh(true);save(s);s.updateBrowserActivity();s.handler.runDue();s.reply("inspect",inspect(s,true));check("Busy bounded inspection never applies or schedules a recurring retry",s.applied==0&&!s.operation&&!s.configurationCapture&&s.handler.jobs.isEmpty());s.handler.advance(10000);s.updateBrowserActivity();s.handler.runDue();captured(s);check("Later actual work end can retry after the unchanged original throttle",s.applied==1);
 }
 public static void main(String[] args)throws Exception{if(fixed)current();else baseline();System.out.print(J.obj("status",fixed?"passed":"expected-baseline-gap","checks",checks,"count",checks.length(),"actualAndroidExecution",false,"actualGeckoExecution",false,"backgroundReplyDetection",BackgroundReplyPolicy.enabled,"replyServiceStarts",ChatService.begins,"scope","Actual completion/activity/file-end/policy methods and DeferredBrowserSettings/TaskGuardSnapshot; explicit deterministic looper, DOM, storage, services and current resource-observation boundaries. No Android scheduling, Gecko, native file IO, network or phone acceptance claim."));}
}

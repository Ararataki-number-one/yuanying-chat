class ChatSession {final Handler handler=new Handler(Looper.getMainLooper());GeckoWebView web;boolean networkReady=true,offline,navigating;final Guard guard=new Guard();}
class Guard {boolean allowed(){return true;}}
class Context {final File root;Context(){try{root=Files.createTempDirectory("f06-cookie-").toFile();}catch(IOException e){throw new RuntimeException(e);}}File getCacheDir(){return root;}}
class Intent {final String nonce;Intent(String nonce){this.nonce=nonce;}String getStringExtra(String key){return nonce;}}
class Profiles {static int process=7,slot=7;static int processSlot(){return process;}static int slot(Context c){return slot;}}
class IntegrationEventStore {final JSONObject buildIdentity=J.obj("sourceCommit","d341-fixture-host-only");int slot=7;long command=1;String action="downloadResume",nonce="a".repeat(32);}
class WebExtension {static class Port {void postMessage(JSONObject value){throw new AssertionError("A real bridge must not be called");}}}
class CookieCallbacks {int add(WebExtension.Port p,Consumer<String> callback,int timeout){throw new AssertionError("Real cookie bridge used");}void complete(WebExtension.Port p,int id,String value){throw new AssertionError();}}
class DownloadTasks {static void put(JSONObject row,Object...values){try{for(int i=0;i<values.length;i+=2)row.put((String)values[i],values[i+1]);}catch(JSONException e){throw new RuntimeException(e);}}}
class AppPrefs {static void requireDownloadNetwork(Context context){}}
class BrowserNetworkGuard {static boolean publicHttps(android.net.Uri uri){return true;}}
class URLUtil {static String guessFileName(String a,String b,String c){return "fixture.bin";}}

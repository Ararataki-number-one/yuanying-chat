 DownloadResumeIntegrationActivity a;final Tasks tasks=new Tasks();File temp;JSONObject task;boolean active=true,cancelled,destroyed;long ticket=1,receivedBytes,totalBytes;
 String sourceId="",sourceUrl="",retryUrl="",resumeValidator="",resumeAddress="",mime="application/octet-stream",name="fixture.bin",imageLabel="",reason="";HttpURLConnection connection;int connects,chosen;static final long MAX=512L*1024*1024;
 FileDownloads(DownloadResumeIntegrationActivity a){this.a=a;}Proxy route(){return Proxy.NO_PROXY;}HttpURLConnection connect(String url,Proxy proxy)throws Exception{throw new AssertionError();}
 static boolean https(String url){return url.startsWith("https://");}static String safeName(String name){return name;}static String imageExtension(String type){return "png";}
 void transferProgress(){}void choose(long attempt){chosen++;}void fail(long attempt,String message){reason=message;}static class Tasks {boolean owned=true;void save(){}boolean owns(JSONObject row){return owned&&row!=null;}}

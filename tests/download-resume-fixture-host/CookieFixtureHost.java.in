package local.pocketchat;
import android.net.Uri;import android.os.*;import android.webkit.ValueCallback;import org.json.*;import java.io.*;import java.net.*;import java.nio.charset.StandardCharsets;import java.nio.file.*;import java.util.*;import java.util.concurrent.*;import java.util.function.Consumer;
public final class CookieFixtureHost {
 static final JSONArray checks=new JSONArray();
 static void check(String name,boolean pass){checks.put(J.obj("name",name,"pass",pass));if(!pass)throw new AssertionError(name);}
 static <T>T ui(Callable<T> work)throws Exception{CompletableFuture<T> done=new CompletableFuture<>();new Handler(Looper.getMainLooper()).post(()->{try{done.complete(work.call());}catch(Throwable e){done.completeExceptionally(e);}});return done.get(5,TimeUnit.SECONDS);}
 static DownloadResumeIntegrationActivity fresh(boolean old,int code)throws Exception{
  DownloadResumeIntegrationActivity f=new DownloadResumeIntegrationActivity();ChatSession session=f.session;
  f.remote=old?new DownloadResumeIntegrationActivity.OldFixtureView(f,session):new DownloadResumeIntegrationActivity.FixtureView(f,session,f,f.nonce);session.web=f.remote;
  DownloadResumeIntegrationActivity.MappedDownloads d=new DownloadResumeIntegrationActivity.MappedDownloads(f);f.current=d;
  d.endpoint=new DownloadResumeIntegrationActivity.Endpoint(code,new byte[]{5,6,7,8,9});
  d.expectedUrl=f.preparedUrl=DownloadResumeIntegrationActivity.REMOTE+UUID.randomUUID()+".bin";
  d.sourceId=f.preparedSource=UUID.randomUUID().toString();d.sourceUrl=f.conversation;d.retryUrl=d.expectedUrl;
  d.task=J.obj("id",UUID.randomUUID().toString());f.ownIds.add(d.task.optString("id"));
  d.temp=File.createTempFile("download-",".part",f.getCacheDir());Files.write(d.temp.toPath(),new byte[]{1,2,3,4});
  d.resumeValidator="\"f06-v1\"";d.resumeAddress=DownloadRange.resource(d.expectedUrl);return f;
 }
 static void oldFailure()throws Exception{
  DownloadResumeIntegrationActivity f=fresh(true,206);try{
   f.current.download(f.current.ticket,f.preparedUrl,"fixture");ui(()->null);
   check("Original complete production Cookie wait rejects old fixture null callback",f.current.reason.equals("当前环境的登录信息暂不可用，请重试下载"));
   check("Original production download creates connection but never sends request before Cookie failure",f.current.connects==1&&f.current.endpoint.request.isEmpty()&&f.current.endpoint.acceptedAt==0&&f.current.chosen==0);
   check("Original partial remains byte-identical after rejected Cookie read",Arrays.equals(Files.readAllBytes(f.current.temp.toPath()),new byte[]{1,2,3,4}));
  }finally{f.current.endpoint.close();}
 }
 static void transfer(int code)throws Exception{
  DownloadResumeIntegrationActivity f=fresh(false,code);try{
   f.current.download(f.current.ticket,f.preparedUrl,"fixture");f.current.endpoint.done.get(10,TimeUnit.SECONDS);ui(()->null);
   check("New owned empty Cookie permits actual production HTTP "+code,f.current.reason.isEmpty()&&f.current.chosen==1&&f.current.endpoint.method.equals("GET"));
   check("HTTP "+code+" sends original exact Range and If-Range",f.current.endpoint.range.equals("bytes=4-")&&f.current.endpoint.validator.equals("\"f06-v1\""));
   byte[] expected=code==206?new byte[]{1,2,3,4,5,6,7,8,9}:new byte[]{5,6,7,8,9};
   check("HTTP "+code+" full production body writes exact bytes",Arrays.equals(Files.readAllBytes(f.current.temp.toPath()),expected));
   JSONObject proof=f.syntheticCookieReads.getJSONObject(0);
   check("HTTP "+code+" synthetic callback has exact owner and no real bridge claim",f.syntheticCookieReads.length()==1&&proof.getString("runNonce").equals(f.nonce)&&proof.getString("taskId").equals(f.current.task.getString("id"))&&proof.getString("url").equals(f.preparedUrl)&&proof.getBoolean("emptyCookie")&&!proof.getBoolean("realCookieBridge"));
  }finally{f.current.endpoint.close();}
 }
 static void reject(String name,Consumer<DownloadResumeIntegrationActivity> alter)throws Exception{
  DownloadResumeIntegrationActivity f=fresh(false,206);DownloadResumeIntegrationActivity.MappedDownloads d=f.current;DownloadResumeIntegrationActivity.Endpoint endpoint=d.endpoint;GeckoWebView original=f.remote;try{
   ui(()->{alter.accept(f);return null;});boolean denied=false;try{original.downloadCookies(f.preparedUrl);}catch(IOException expected){denied=expected.getMessage().equals("当前环境的登录信息暂不可用，请重试下载");}
   check("Reject synthetic Cookie for "+name,denied&&f.syntheticCookieReads.length()==0);
  }finally{endpoint.close();Profiles.process=7;Profiles.slot=7;}
 }
 static void ownership()throws Exception{
  reject("wrong package",f->f.packageName="local.pocketchat");reject("wrong process",f->Profiles.process=1);reject("wrong profile",f->Profiles.slot=1);
  reject("finishing Activity",f->f.finishing=true);reject("destroyed Activity",f->f.dead=true);reject("replaced nonce",f->f.nonce="b".repeat(32));
  reject("missing event owner",f->f.events=null);reject("foreign event nonce",f->f.events.nonce="b".repeat(32));reject("foreign command",f->f.events.command=2);
  reject("foreign action",f->f.events.action="read");reject("foreign event slot",f->f.events.slot=1);reject("replaced session",f->f.session=new ChatSession());
  reject("replaced Activity view",f->f.remote=null);reject("replaced session view",f->f.session.web=null);reject("destroyed view",f->f.remote.destroyed=true);
  reject("offline session",f->f.session.offline=true);reject("unready session",f->f.session.networkReady=false);reject("navigating session",f->f.session.navigating=true);
  reject("missing download owner",f->f.current=null);reject("foreign download Activity",f->f.current.a=new DownloadResumeIntegrationActivity());
  reject("missing endpoint",f->f.current.endpoint=null);reject("closed endpoint",f->{try{f.current.endpoint.close();}catch(IOException e){throw new RuntimeException(e);}});
  reject("inactive task",f->f.current.active=false);reject("destroyed task",f->f.current.destroyed=true);reject("cancelled task",f->f.current.cancelled=true);
  reject("lost task lease",f->f.current.tasks.owned=false);reject("missing task",f->f.current.task=null);reject("foreign task ID",f->f.ownIds.clear());
  reject("foreign source ID",f->f.preparedSource="other");reject("empty source ID",f->{f.preparedSource="";f.current.sourceId="";});
  reject("foreign source page",f->f.current.sourceUrl="foreign");reject("changed conversation",f->f.conversation="foreign");
  reject("foreign request URL",f->f.preparedUrl="https://foreign.example/a.bin");reject("changed expected URL",f->f.current.expectedUrl="foreign");reject("changed retry URL",f->f.current.retryUrl="foreign");
  DownloadResumeIntegrationActivity f=fresh(false,206);try{
   boolean denied=ui(()->{try{f.remote.downloadCookies(f.preparedUrl);return false;}catch(IOException error){return error.getMessage().equals("不能在界面线程等待 Cookie");}});
   check("Original production Cookie wait still forbids main thread",denied&&f.syntheticCookieReads.length()==0);
   String[] received={"unset"};f.remote.readCookies(f.preparedUrl,v->received[0]=v);check("Synthetic callback refuses wrong callback thread",received[0]==null&&f.syntheticCookieReads.length()==0);
  }finally{f.current.endpoint.close();}
 }
 static void observations()throws Exception{
  for(String failure:new String[]{"accept","request-line","headers"}){
   DownloadResumeIntegrationActivity f=fresh(false,206);DownloadResumeIntegrationActivity.Endpoint endpoint=f.current.endpoint;
   try{
    if(failure.equals("accept")){long until=System.nanoTime()+TimeUnit.SECONDS.toNanos(2);while(!"accept".equals(endpoint.stage)&&System.nanoTime()<until)Thread.yield();endpoint.close();}
    else try(Socket client=new Socket("127.0.0.1",endpoint.socket.getLocalPort())){if(failure.equals("headers"))client.getOutputStream().write("GET /owned.bin HTTP/1.1\r\ninvalid-header\r\n\r\n".getBytes(StandardCharsets.ISO_8859_1));client.shutdownOutput();try{endpoint.done.get(10,TimeUnit.SECONDS);}catch(ExecutionException expected){}}
    try{endpoint.done.get(10,TimeUnit.SECONDS);}catch(ExecutionException expected){}
    JSONObject observed=endpoint.failureSnapshot();
    check("Failure snapshot distinguishes actual "+failure+" stage",observed.getString("stage").equals(failure)&&observed.getJSONArray("stack").length()>0&&observed.getJSONArray("stack").length()<=24);
    f.current.task.put("reason","owned task failure");f.observeRangeFailure(endpoint,f.current.task);JSONObject captured=f.result.getJSONObject("rangeFailureObservation");
    check("Failure-only "+failure+" snapshot retains task and owner without acceptance",captured.getBoolean("diagnosticOnly")&&!captured.getBoolean("acceptance")&&captured.getString("runNonce").equals(f.nonce)&&captured.getJSONObject("task").getString("reason").equals("owned task failure")&&captured.toString().getBytes(StandardCharsets.UTF_8).length<=8192);
    f.current.task.put("reason","长".repeat(10000));f.observeRangeFailure(endpoint,f.current.task);JSONObject omitted=f.result.getJSONObject("rangeFailureObservation");
    check("Oversize "+failure+" observation preserves only truthful size and SHA",omitted.getBoolean("omitted")&&omitted.getInt("bytes")>8192&&omitted.getInt("limit")==8192&&omitted.getString("sha256").matches("[0-9a-f]{64}")&&!omitted.has("task")&&!omitted.getBoolean("acceptance"));
   }finally{endpoint.close();}
  }
 }
 public static void main(String[] args)throws Exception{oldFailure();transfer(206);transfer(200);ownership();observations();System.out.println(J.obj("status","passed","checkCount",checks.length(),"checks",checks,"actualAndroidExecution",false,"actualGeckoExecution",false,"actualLoopbackHttp",true));}
}
class DownloadResumeIntegrationActivity extends Context {
 static final String PAGE="https://chatgpt.com/c/download-resume-fixture",REMOTE="https://download-fixture.example/";
 String nonce="a".repeat(32),packageName="local.pocketchat.test",conversation=PAGE,preparedSource="",preparedUrl="";boolean finishing,dead;
 final Handler handler=new Handler(Looper.getMainLooper());ChatSession session=new ChatSession();GeckoWebView remote;MappedDownloads current;IntegrationEventStore events=new IntegrationEventStore();
 final Set<String> ownIds=new HashSet<>();final JSONArray syntheticCookieReads=new JSONArray();final JSONObject result=new JSONObject();int prepares;
 DownloadResumeIntegrationActivity(){super();}String getPackageName(){return packageName;}Intent getIntent(){return new Intent(nonce);}boolean isFinishing(){return finishing;}boolean isDestroyed(){return dead;}
 /* FIXTURE_VIEW */
 /* OLD_FIXTURE_VIEW */
 static final class MappedDownloads extends FileDownloads {Endpoint endpoint;String expectedUrl="";MappedDownloads(DownloadResumeIntegrationActivity a){super(a);}HttpURLConnection connect(String url,Proxy proxy)throws Exception{connects++;if(!expectedUrl.equals(url)||proxy!=Proxy.NO_PROXY)throw new SecurityException();return (HttpURLConnection)new URL(endpoint.address()).openConnection(Proxy.NO_PROXY);}}
 <T>T ui(Callable<T> work)throws Exception{return CookieFixtureHost.ui(work);}
 /* SHA */

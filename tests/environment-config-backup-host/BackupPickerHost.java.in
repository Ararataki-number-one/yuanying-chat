package local.pocketchat;

import java.io.*;
import java.util.*;

public final class BackupPickerHost {
  static final class Backup extends ThemedActivity {
    /* PICKER_CONSTANTS */
    final java.util.concurrent.Executor worker = Runnable::run;
    long owner = 1;
    boolean busy;
    int picker, prompts;
    byte[] pending;
    TextView result;
    LinearLayout body;

    /* PICKER_CALLBACKS */

    void chooseSource() {}
    void password(boolean creating, java.util.function.Consumer<char[]> action) {
      if (creating) throw new AssertionError("Import must open the existing decrypt prompt");
      prompts++;
    }
    void decrypt(char[] secret) {}
  }

  static class ThemedActivity {
    static final int RESULT_OK = -1;
    int launched, reads;
    final Window window = new Window();
    void onCreate(Bundle state) {}
    void onSaveInstanceState(Bundle state) {}
    void onActivityResult(int request, int result, Intent data) {}
    Window getWindow() { return window; }
    void finish() {}
    boolean isDestroyed() { return false; }
    boolean isFinishing() { return false; }
    void startActivityForResult(Intent intent, int request) { launched = request; }
    String getPackageName() { return "local.pocketchat"; }
    void runOnUiThread(Runnable action) { action.run(); }
    void setContentView(LinearLayout layout) {}
    ThemedActivity getContentResolver() { return this; }
    InputStream openInputStream(Uri uri) { reads++; return new ByteArrayInputStream(new byte[]{1, 2, 3}); }
    OutputStream openOutputStream(Uri uri, String mode) { throw new AssertionError("Import must not write to a provider"); }
  }
  static final class Bundle {
    final Map<String, Boolean> entries = new HashMap<>();
    void putBoolean(String key, boolean value) { entries.put(key, value); }
    boolean getBoolean(String key) { return Boolean.TRUE.equals(entries.get(key)); }
  }
  static class View { static final int ACCESSIBILITY_LIVE_REGION_POLITE = 1; }
  static final class TextView extends View {
    String text;
    void setText(String value) { text = value; }
    void setAccessibilityLiveRegion(int mode) {}
  }
  static final class LinearLayout {
    Runnable restore;
    void addView(TextView view) {}
  }
  static final class DesignUi {
    static final int MUTED = 0;
    static LinearLayout screen(Backup activity) { return new LinearLayout(); }
    static LinearLayout body(Backup activity, LinearLayout root, String title, Runnable close) { return root; }
    static void note(LinearLayout body, String text) {}
    static void action(LinearLayout body, String title, boolean primary, Runnable callback) { body.restore = callback; }
    static TextView text(Backup activity, String text, int size, int color) { return new TextView(); }
  }
  static final class Window { void addFlags(int flags) {} }
  static final class WindowManager { static final class LayoutParams { static final int FLAG_SECURE = 1; } }
  static final class Uri {
    final String scheme, authority;
    Uri(String scheme, String authority) { this.scheme = scheme; this.authority = authority; }
    String getScheme() { return scheme; }
    String getAuthority() { return authority; }
  }
  static final class Intent {
    static final String ACTION_OPEN_DOCUMENT = "open", CATEGORY_OPENABLE = "openable";
    final Uri uri;
    Intent(String action) { uri = null; }
    Intent(Uri uri) { this.uri = uri; }
    Intent addCategory(String category) { return this; }
    Intent setType(String type) { return this; }
    Uri getData() { return uri; }
  }
  static final class EnvironmentConfigBackup {
    static byte[] read(InputStream stream) throws IOException { return stream.readAllBytes(); }
  }

  static int checks;
  static void check(boolean pass, String description) {
    if (!pass) throw new AssertionError(description);
    checks++;
  }
  static Backup activity(Bundle state) {
    Backup backup = new Backup();
    backup.onCreate(state);
    return backup;
  }
  static Bundle beginImport() {
    Backup original = activity(null);
    original.body.restore.run();
    check(original.launched == Backup.IMPORT, "The restore action opens the existing picker");
    Bundle state = new Bundle();
    original.onSaveInstanceState(state);
    return state;
  }

  public static void main(String[] args) {
    Intent selected = new Intent(new Uri("content", "fixture.documents"));
    Backup importing = activity(beginImport());
    importing.onActivityResult(Backup.EXPORT, -1, selected);
    importing.onActivityResult(Backup.IMPORT, -1, selected);
    check(importing.reads == 1 && importing.prompts == 1 && Arrays.equals(importing.pending, new byte[]{1, 2, 3}),
          "A recreated Activity must take the pending import to the password prompt");
    importing.onActivityResult(Backup.IMPORT, -1, selected);
    check(importing.reads == 1 && importing.prompts == 1, "Picker result only consumed once");

    Backup cancelled = activity(beginImport());
    cancelled.onActivityResult(Backup.IMPORT, 0, null);
    cancelled.onActivityResult(Backup.IMPORT, -1, selected);
    check(cancelled.reads == 0 && cancelled.prompts == 0, "Cancellation discards the pending result");
    cancelled.body.restore.run();
    check(cancelled.launched == Backup.IMPORT && cancelled.picker == Backup.IMPORT, "Cancellation permits another selection");

    Backup invalid = activity(beginImport());
    invalid.onActivityResult(Backup.IMPORT, -1, new Intent(new Uri("content", "local.pocketchat.private")));
    check(invalid.reads == 0 && invalid.prompts == 0 && invalid.picker == 0, "Private provider stays rejected after recreation");

    Backup unowned = activity(null);
    unowned.onActivityResult(Backup.IMPORT, -1, selected);
    check(unowned.reads == 0 && unowned.prompts == 0, "No unsolicited result when nothing is waiting");

    Backup exporting = activity(null);
    exporting.picker = Backup.EXPORT;
    exporting.pending = new byte[]{7, 8};
    Bundle state = new Bundle();
    exporting.onSaveInstanceState(state);
    Backup recreatedExport = activity(state);
    check(state.entries.size() == 1 && !state.entries.containsValue(true), "Only the import-pending boolean is saved");
    check(recreatedExport.picker == 0 && recreatedExport.pending == null, "No export or ciphertext restored");
    System.out.println("Passed " + checks + " backup picker callback checks");
  }
}

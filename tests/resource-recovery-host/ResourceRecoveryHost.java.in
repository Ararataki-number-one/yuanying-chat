package local.pocketchat;
import java.util.*;import java.io.IOException;import org.json.*;import android.os.SystemClock;

/** Every asynchronous startup/SDK callback here is a declared host boundary. */
public final class ResourceRecoveryHost {
  static final JSONArray checks=new JSONArray();
  static void check(String name,boolean value){checks.put(J.obj("name",name,"pass",value));if(!value)throw new AssertionError(name);}
  static void alive(Fixture fixture){if(fixture.finished)throw new AssertionError("Actual fixture assertion failed: "+fixture.failure,fixture.failure);}
  static void admitted()throws Exception{
    Fixture host=new Fixture();View view=host.view;Owner owner=host.owner;long old=owner.navigationEpoch;
    owner.pending=J.obj("id","recovery");view.queued="";
    check("Admitted asynchronous recovery is a real retry",view.retryResourceStart());
    check("Asynchronous admitted recovery renews original navigation deadline",owner.navigationEpoch==old+1&&host.target.equals(owner.navigationTarget));
    check("CPU preparation does not fabricate a runtime or native creation counter",view.runtime==null&&owner.resources.created==0&&view.cpuRequested&&!view.tlsRequested);
    check("Memory admission alone stays distinct from native creation",!view.resourceDeferred&&view.resourceAdmission==ResourcePressureController.Admission.RECOVERY);
    owner.navigationTimeout(old);check("Actual old timeout cannot fail admitted asynchronous recovery",!owner.navigationFailed&&owner.navigating);
    owner.handler.until(100);check("TLS preparation follows CPU while native runtime remains absent",view.cpuDone&&view.tlsRequested&&view.runtime==null&&owner.resources.created==0);
    owner.handler.until(200);check("Both asynchronous startup callbacks create exactly one real-boundary runtime",view.cpuDone&&view.tlsDone&&view.runtime!=null&&owner.resources.created==1);
    check("Asynchronous callbacks do not renew or replace the same navigation twice",owner.navigationEpoch==old+1&&owner.beginCount==1);
    owner.handler.until(45000);check("The actual renewed navigation deadline is still enforced for an unseen document",owner.navigationFailed&&!owner.navigating&&owner.pageError.equals("网页还未显示，请重试或检查网络"));
  }
  static void deferredAndStopped(){
    Fixture host=new Fixture();long epoch=host.owner.navigationEpoch;
    host.view.retryResourceStart();check("Fresh low memory without recovery remains deferred with no deadline renewal",host.view.resourceDeferred&&host.view.runtime==null&&host.owner.resources.created==0&&host.owner.navigationEpoch==epoch);
    for(int state=0;state<3;state++){
      host=new Fixture();host.owner.pending=J.obj("id","recovery");epoch=host.owner.navigationEpoch;
      if(state==0)host.view.destroyed=true;else if(state==1)host.view.failed=true;else host.owner.deleted=true;
      host.view.retryResourceStart();host.owner.handler.until(1000);
      check("Destroyed, failed or deleted startup "+state+" never creates a runtime or renews navigation",host.view.runtime==null&&host.owner.resources.created==0&&host.owner.navigationEpoch==epoch);
    }
    for(String failure:new String[]{"cpu","tls"}){
      host=new Fixture();host.owner.pending=J.obj("id","recovery");host.view.failureAt=failure;host.view.retryResourceStart();host.owner.handler.until(1000);
      check("A genuine asynchronous "+failure+" failure remains uncreated and failed closed",host.view.failed&&host.view.runtime==null&&host.owner.resources.created==0);
    }
  }
  static void continuation(boolean early)throws Exception{
    Fixture host=new Fixture();host.armStartup();if(early)host.beginCase();host.coldAllocation();alive(host);
    check("Delayed startup does not run original creation assertions early "+early,host.resourceChecks.length()==6&&!host.recoveryAllocationComplete&&host.view.runtime==null);
    check("Native-ready cannot start resource controls before cold assertions "+early,!host.controlsStarted&&host.documentWaits==0);
    host.owner.handler.until(200);alive(host);
    check("Original nine cold assertions complete only after actual creation "+early,host.resourceChecks.length()==9&&host.recoveryAllocationComplete&&host.owner.resources.created==1);
    check("Original allocation receipt keeps real runtime and renewed epoch "+early,host.allocation.getInt("actualRuntimeObject")==System.identityHashCode(host.view.runtime)&&host.allocation.getLong("newEpoch")>host.allocation.getLong("oldEpoch"));
    if(!early)host.beginCase();host.beginCase();
    check("Ready before or after creation starts resource controls once "+early,host.documentWaits==1&&host.controlsStarted);
    host.resourceDone=true;host.beginCase();host.owner.handler.until(60000);alive(host);
    check("Completing resources retains the original parent startup guard semantics "+early,host.caseIndex==0&&host.superCalls==1);
  }
  static void absoluteDeadline()throws Exception{
    for(String stall:new String[]{"cpu","tls"}){
      Fixture host=new Fixture();host.view.stallAt=stall;host.armStartup();host.coldAllocation();host.beginCase();host.owner.handler.until(59999);
      check("Stalled "+stall+" keeps all creation assertions pending before the original deadline",!host.finished&&host.resourceChecks.length()==6&&host.view.runtime==null);
      host.owner.handler.until(60000);
      check("Stalled "+stall+" fails at the original absolute60s deadline",host.finished&&host.failure!=null&&host.failure.getMessage().equals("Official Gecko startup did not become ready")&&host.owner.resources.created==0&&host.allocation.length()==0);
    }
    for(int state=0;state<3;state++){
      Fixture host=new Fixture();host.coldAllocation();if(state==0)host.view.destroyed=true;else if(state==1)host.view.failed=true;else host.owner.deleted=true;
      host.owner.handler.until(200);
      check("Retired recovery continuation "+state+" refuses old startup callbacks",host.finished&&!host.recoveryAllocationComplete&&host.owner.resources.created==0&&host.allocation.length()==0);
    }
  }
  static void navigationOwners(){
    for(int mutation=0;mutation<3;mutation++){
      Fixture host=new Fixture();host.owner.pending=J.obj("id","resource-recovery");final int change=mutation;
      host.owner.onStatus=()->{
        if(change==0){host.owner.navigationEpoch++;host.view.queued="https://chatgpt.com/c/newer";}
        else if(change==1)host.view.current=new GeckoSession();
        else host.owner.deleted=true;
      };
      host.view.retryResourceStart();
      check("Superseded resource retry cannot wake an older navigation "+mutation,host.owner.wakes==0&&(mutation!=0||host.view.queued.equals("https://chatgpt.com/c/newer")));
    }
    Fixture host=new Fixture();host.owner.pending=J.obj("id","resource-recovery");final Fixture initializing=host;
    host.view.onInitialize=()->{initializing.owner.navigationEpoch++;initializing.owner.navigationTarget="https://chatgpt.com/c/newer";};
    host.view.retryResourceStart();
    check("Initialization reentry cannot replace the newer navigation deadline",host.owner.beginCount==0&&host.owner.wakes==0&&host.owner.navigationTarget.equals("https://chatgpt.com/c/newer"));
    host=new Fixture();host.owner.pending=J.obj("id","resource-recovery");host.view.queued="";host.owner.navigationTarget="";final Fixture noTarget=host;
    host.owner.onStatus=()->noTarget.owner.navigationEpoch++;
    host.view.retryResourceStart();
    check("Status-only resource retry also respects a newer navigation",host.owner.wakes==0&&host.owner.beginCount==0);
    host=new Fixture();String target="https://chatgpt.com/c/resource-recovery";
    host.view.queued=target;host.owner.navigationTarget=target;
    JSONObject pending=J.obj("id","same-page-web","kind","web","confirmed",true,"confirmedUrl",target,"attempted",true);
    host.owner.pending=pending;String bytes=pending.toString();host.owner.prefs.edit().putString("pending",bytes).commit();
    host.view.retryResourceStart();host.owner.handler.until(200);
    check("Same-page ChatGPT recovery retains its actual web task through asynchronous CPU and TLS admission",host.owner.pending==pending&&host.owner.prefs.getString("pending","").equals(bytes)&&host.view.runtime!=null&&host.owner.resources.created==1&&host.view.resourceAdmission==ResourcePressureController.Admission.RECOVERY&&host.owner.beginCount==1);
  }
  public static void main(String[] args)throws Exception{admitted();deferredAndStopped();continuation(true);continuation(false);absoluteDeadline();int originalChecks=checks.length();navigationOwners();System.out.println(J.obj("status","passed","passed",checks.length(),"originalChecks",originalChecks,"checks",checks));}
}
class Parent {int caseIndex=-1,superCalls;void beginCase(){caseIndex++;superCalls++;}}
class Fixture extends Parent {
  final String run="aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa";
  final Owner owner=new Owner();final View view=owner.web;final Queue handler=owner.handler;final String target="http://127.0.0.1:40000/resource?run=aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa&phase=parent";
  final JSONArray resourceChecks=new JSONArray();JSONObject allocation=new JSONObject();String pendingBytes;final Runnable pressureObserver=()->{};
  boolean finished,coldChecked,resourceDone,controlsStarted,recoveryAllocationComplete,resourceReadyForControls;Throwable failure;int documentWaits;
  Fixture(){owner.navigationTarget=target;view.queued=target;}
  void armStartup(){@STARTUP@}
  @COLD@
  @ALLOCATED@
  @READY@
  void awaitResourceDocument(){documentWaits++;}
  void resourceCheck(String name,boolean value){resourceChecks.put(J.obj("name",name,"pass",value));if(!value)throw new AssertionError(name);}
  void finish(Throwable error){if(finished)return;failure=error;finished=true;view.destroyed=true;owner.deleted=true;}
}
class Owner {
  final Queue handler=new Queue();final ResourcePressureController resources=new ResourcePressureController(null);final View web=new View(this);final Runnable tick=()->{};final Prefs prefs=new Prefs();final Deliveries deliveries=new Deliveries();final Audit audit=new Audit();final Trace trace=new Trace();
  JSONObject pending;boolean uiVisible=true,navigating=true,navigationFailed,recoveryScheduled,deleted,replyStalled,websiteConnectionIssue,spaTransition,documentNavigationSeen,navigationDispatched,awaitNewDocument,browserNavigationStopped;String pageError="",navigationTarget="",navigationLabel="",lastDocumentId="",priorDocumentId="",spaSignature="";long navigationEpoch=7,resourceObserverEpoch=-1,navigationStarted,navigationMono,firstPageVisible,pageUsableAt;int spaStable,beginCount,wakes;
  long syncRun,resourceUploadCheckGeneration,resourceInspectionGeneration;boolean resourceUploadChecking,backgroundAttachmentCheck,inFlight;int backgroundAttachmentStable;Runnable onStatus;
  final WebObserver webObserver=new WebObserver(this);
  @INVALIDATE@
  @NAVIGATION@
  @TIMEOUT@
  void resetReplyStability(){}void setStatus(String value){Runnable callback=onStatus;onStatus=null;if(callback!=null)callback.run();}void wakePolling(){wakes++;}void finishNavigation(String value,boolean retry){pageError=value;navigationFailed=true;navigating=false;}
  boolean resourceRestoreWork(){return pending!=null;}void remove(Runnable observer){}
  void updateBrowserActivity(){if(web.resourceDeferred&&resourceRestoreWork())web.retryResourceStart();}
  void foreground(boolean value){uiVisible=value;if(web.resourceDeferred)web.retryResourceStart();updateBrowserActivity();}
  final Guard guard=new Guard();static class Guard {boolean allowed(){return true;}}
  static class Audit {void retirePageCheck(){}}class Trace {void page(String value){beginCount++;}}
  static class Prefs {final Map<String,String> values=new HashMap<>();Prefs edit(){return this;}Prefs putString(String key,String value){values.put(key,value);return this;}boolean commit(){return true;}String getString(String key,String fallback){return values.getOrDefault(key,fallback);}}
  static class Deliveries {void recover(JSONObject value){}}
}
class View {
  final Owner owner;boolean resourceDeferred=true,destroyed,failed,enabled=true,cpuRequested,cpuDone,tlsRequested,tlsDone;Object runtime;GeckoSession current;Runnable onInitialize;String queued="",failureAt="",stallAt="";ResourcePressureController.Admission resourceAdmission=ResourcePressureController.Admission.DEFER;
  View(Owner owner){this.owner=owner;owner.resources.deferred=1;}
  @RETRY@
  @CURRENT@
  boolean allowedUrl(String target){return target.startsWith("http://127.0.0.1:40000/")||MainActivity.chatUrl(target);}boolean hasVisibleDocument(){return false;}
  void initialize(){
    Runnable callback=onInitialize;onInitialize=null;if(callback!=null)callback.run();
    if(!enabled||destroyed||owner.deleted||runtime!=null||failed)return;
    ResourcePressureController.MemorySample memory=new ResourcePressureController.MemorySample(true,true,1024,4096,2048,SystemClock.elapsedRealtime(),"synthetic-pressure-control");
    resourceAdmission=owner.resources.request(false,owner.resourceRestoreWork(),memory);
    if(resourceAdmission==ResourcePressureController.Admission.DEFER){resourceDeferred=true;return;}resourceDeferred=false;
    if(!cpuDone){if(!cpuRequested){cpuRequested=true;if(!stallAt.equals("cpu"))owner.handler.postDelayed(()->complete("cpu"),100);}return;}
    if(!tlsDone){if(!tlsRequested){tlsRequested=true;if(!stallAt.equals("tls"))owner.handler.postDelayed(()->complete("tls"),100);}return;}
    runtime=new Object();current=new GeckoSession();owner.resources.runtimeCreated();
  }
  void complete(String phase){if(destroyed||owner.deleted||failed)return;if(failureAt.equals(phase)){failed=true;return;}if(phase.equals("cpu"))cpuDone=true;else tlsDone=true;initialize();}
}
class GeckoSession{}
class WebObserver {
  final Owner session;WebObserver(Owner owner){session=owner;}
  @WEB_JOB@
  @WEB_NAVIGATION@
  @SAME@
  @BINDING_ROUTE@
  boolean archiveNavigation(JSONObject job){throw new AssertionError("Cross-page web archival belongs to the page-lifecycle host");}
}
class MainActivity {@CHAT_URL@}
class Uri {
  final java.net.URI value;Uri(String value){this.value=java.net.URI.create(value);}static Uri parse(String value){return new Uri(value);}
  String getPath(){return value.getPath();}String getScheme(){return value.getScheme();}String getHost(){return value.getHost();}String getUserInfo(){return value.getUserInfo();}int getPort(){return value.getPort();}
}
class Queue {
  static final class Job {final long at,serial;final Runnable task;Job(long at,long serial,Runnable task){this.at=at;this.serial=serial;this.task=task;}}
  final PriorityQueue<Job> tasks=new PriorityQueue<>((a,b)->a.at==b.at?Long.compare(a.serial,b.serial):Long.compare(a.at,b.at));long now,serial;
  Queue(){SystemClock.set(0);}void postDelayed(Runnable task,long delay){tasks.add(new Job(now+delay,++serial,task));}void removeCallbacks(Runnable task){tasks.removeIf(job->job.task==task);}
  void until(long target){int count=0;while(!tasks.isEmpty()&&tasks.peek().at<=target){if(++count>10000)throw new AssertionError("Unbounded host queue");Job job=tasks.poll();now=job.at;SystemClock.set(now);job.task.run();}now=target;SystemClock.set(now);}
}

package local.pocketchat;

import java.io.*;
import java.net.URI;
import java.nio.charset.StandardCharsets;
import java.nio.file.*;
import java.util.*;
import org.json.*;

/** Actual download admission/response consumers with declared JVM boundaries. */
public final class DownloadSourceHost {
  static final String OLD_GPT="https://chatgpt.com/c/last-cached",HTTP_PAGE="http://example.com/downloads",HTTPS_PAGE="https://www.wikipedia.org/wiki/Download";
  static final byte[] BYTES="controlled native HTTP response bytes\n".getBytes(StandardCharsets.UTF_8);
  static final JSONArray checks=new JSONArray();static final List<FileDownloads> fixtures=new ArrayList<>();
  static void check(String name,boolean pass){checks.put(J.obj("name",name,"pass",pass));if(!pass)throw new AssertionError(name);}
  static FileDownloads fresh(String page)throws Exception{MainActivity owner=new MainActivity(Files.createTempDirectory("generic-download-source-").toFile());owner.remote.url=page;FileDownloads downloads=new FileDownloads(owner);fixtures.add(downloads);return downloads;}
  static ResponseBoundary response(String address){return new ResponseBoundary(address,BYTES);}
  static void nativeSource(String page)throws Exception{
    FileDownloads d=fresh(page);ResponseBoundary response=response("http://cdn.example.com/controlled.bin");d.acceptResponse(response);
    check("Native task records the current generic page: "+page,page.equals(d.task.optString("conversation")));
    check("Native in-memory source uses the same captured page: "+page,page.equals(d.sourceUrl)&&d.a.remote.reads==1);
    check("Native response keeps its existing transfer kind and ticket",d.active&&d.ticket==1&&d.task.optString("transferKind").equals("gecko-response")&&d.a.session.transferActive&&d.worker.queue.size()==1&&response.timeout==25000);
    d.worker.drain();d.a.handler.drain();
    check("Existing native HTTP stream path copies exact controlled bytes",d.temp!=null&&Arrays.equals(Files.readAllBytes(d.temp.toPath()),BYTES)&&d.receivedBytes==BYTES.length&&d.totalBytes==BYTES.length&&d.chosen==1&&response.body.closed&&d.nativeInput==null&&d.failures.isEmpty());
    check("Native response never starts a DOM driver or URL client",d.a.driverCalls==0&&d.a.remote.scripts==0&&d.urlDownloads==0&&d.blobStarts==0&&d.a.networkChecks>=2);
    check("Generic native source is not promoted to a GPT DOM binding",!d.sameSource());
  }
  static void urlSource(String page)throws Exception{
    FileDownloads d=fresh(page);d.accept("https://cdn.example.com/controlled.bin","controlled-UA","","application/octet-stream",BYTES.length);
    check("URL task records the current generic page: "+page,page.equals(d.task.optString("conversation")));
    check("URL in-memory source uses the same captured page: "+page,page.equals(d.sourceUrl)&&d.a.remote.reads==1);
    check("HTTPS URL activation retains its original worker path",d.active&&d.task.optString("transferKind").equals("http-range")&&d.worker.queue.size()==1&&d.agent.equals("controlled-UA"));
    d.worker.drain();check("HTTPS URL activation dispatches no DOM automation",d.urlDownloads==1&&d.a.driverCalls==0&&d.a.remote.scripts==0&&d.blobStarts==0);
  }
  static void captureOnce()throws Exception{
    for(boolean nativeResponse:new boolean[]{true,false}){
      FileDownloads d=fresh(HTTPS_PAGE);d.a.remote.afterRead="https://other.example.com/replacement";
      if(nativeResponse)d.acceptResponse(response("http://cdn.example.com/controlled.bin"));else d.accept("https://cdn.example.com/controlled.bin","","","application/octet-stream",-1);
      check("Source is sampled once and shared by task and active metadata: native="+nativeResponse,d.a.remote.reads==1&&d.sourceUrl.equals(HTTPS_PAGE)&&d.task.optString("conversation").equals(HTTPS_PAGE)&&d.a.remote.url.equals("https://other.example.com/replacement"));
    }
    FileDownloads d=fresh(null);check("Missing current URL cannot borrow the last GPT conversation",d.downloadSource().isEmpty());
  }
  static void gpt()throws Exception{
    for(boolean nativeResponse:new boolean[]{true,false}){
      FileDownloads d=fresh(OLD_GPT);
      if(nativeResponse)d.acceptResponse(response("https://files.example.com/controlled.bin"));else d.accept("https://files.example.com/controlled.bin","","","application/octet-stream",-1);
      check("GPT download keeps the established conversation metadata: native="+nativeResponse,d.sourceUrl.equals(OLD_GPT)&&d.task.optString("conversation").equals(OLD_GPT)&&d.sameSource());
      d.a.conversation="https://chatgpt.com/c/replacement";check("GPT DOM source still refuses a changed conversation",!d.sameSource());
      d.a.conversation=OLD_GPT;d.a.session.navigating=true;check("GPT DOM source still refuses an in-flight navigation",!d.sameSource());
      d.a.session.navigating=false;d.a.remote.url=HTTPS_PAGE;check("GPT DOM source still refuses a non-GPT document",!d.sameSource());
      d.a.remote.url="https://chatgpt.com:8443/c/last-cached";check("GPT DOM source still refuses a wrong origin port",!d.sameSource());
    }
  }
  static void httpRefusal()throws Exception{
    for(String address:new String[]{"http://cdn.example.com/controlled.bin","blob:http://example.com/controlled","javascript:controlled","file:///controlled"}){
      FileDownloads d=fresh(HTTP_PAGE);d.accept(address,"","","application/octet-stream",-1);
      check("URL activation still refuses HTTP or unsafe address: "+address,!d.active&&d.task==null&&d.tasks.rows.isEmpty()&&d.worker.queue.isEmpty()&&d.a.remote.reads==0&&!d.a.message.isEmpty());
      check("Refused URL cannot run a DOM driver or client: "+address,d.a.driverCalls==0&&d.a.remote.scripts==0&&d.urlDownloads==0&&d.blobStarts==0);
    }
  }
  static void refusalAndExisting()throws Exception{
    FileDownloads d=fresh(HTTP_PAGE);ResponseBoundary blocked=response("http://cdn.example.com/controlled.bin");d.a.session.guard.permit=false;d.acceptResponse(blocked);
    check("Blocked native response closes its body before task creation",blocked.body.closed&&d.task==null&&d.tasks.rows.isEmpty()&&d.worker.queue.isEmpty()&&d.a.remote.reads==0);
    d=fresh(HTTP_PAGE);d.tasks.failAdd=true;ResponseBoundary failed=response("http://cdn.example.com/controlled.bin");d.acceptResponse(failed);
    check("Task persistence failure still closes the native body without starting",d.persistenceBlocked&&failed.body.closed&&d.task==null&&!d.active&&d.worker.queue.isEmpty());
    d=fresh(HTTP_PAGE);d.task=d.tasks.add("attachment","key",OLD_GPT);d.sourceId="attachment";d.sourceKey="key";d.sourceUrl=OLD_GPT;d.active=true;d.acceptResponse(response("https://files.example.com/controlled.bin"));
    check("Existing attachment task retains its original source and DOM keys",d.tasks.rows.size()==1&&d.sourceUrl.equals(OLD_GPT)&&d.task.optString("conversation").equals(OLD_GPT)&&d.sourceId.equals("attachment")&&d.sourceKey.equals("key")&&d.a.remote.reads==0);
  }
  static void cleanup()throws Exception{for(FileDownloads d:fixtures){if(d.nativeInput!=null)d.nativeInput.close();try(java.util.stream.Stream<Path> paths=Files.walk(d.a.cache.toPath())){for(Path path:(Iterable<Path>)paths.sorted(Comparator.reverseOrder())::iterator)Files.deleteIfExists(path);}}}
  public static void main(String[] args)throws Exception{try{
    if(args.length==1){if(args[0].equals("native"))nativeSource(HTTP_PAGE);else if(args[0].equals("url"))urlSource(HTTPS_PAGE);else if(args[0].equals("http"))httpRefusal();else throw new AssertionError("Unknown focus");}
    else{for(String page:new String[]{HTTP_PAGE,HTTPS_PAGE,"https://chatgpt.com:8443/c/other","http://chatgpt.com/c/other"}){nativeSource(page);urlSource(page);}captureOnce();gpt();httpRefusal();refusalAndExisting();}
    System.out.println(J.obj("status","passed","passed",checks.length(),"total",checks.length(),"checks",checks,"syntheticControlledHost",true,"actualAndroidExecution",false,"actualGeckoExecution",false,"actualNetworkExecution",false).toString());
  }finally{cleanup();}}
}

class FileDownloads {
  @PRODUCTION_MEMBERS@
  static final long MAX=512L*1024*1024;final MainActivity a;final WorkerBoundary worker=new WorkerBoundary();final DownloadTasks tasks=new DownloadTasks();
  InputStream nativeInput;boolean cancelled,active,destroyed,awaitingPicker,retiringPartial,persistenceBlocked,resumeRequested,minimized,completeFile;
  File temp;String imageLabel="",name="文件",mime="application/octet-stream",sourceId="",sourceKey="",sourceUrl="",retryUrl="",agent="",resumeValidator="",resumeAddress="";long ticket,ignoreUntil,receivedBytes,totalBytes=-1;
  JSONObject task;int chosen,urlDownloads,blobStarts;final List<String> failures=new ArrayList<>();
  FileDownloads(MainActivity owner){a=owner;}
  void mark(String state,String reason){DownloadTasks.put(task,"state",state,"reason",reason);}
  boolean saveTask(){return true;}
  void showProgress(String message){}
  void transferProgress(){}
  void choose(long attempt){if(valid(attempt))chosen++;}
  void fail(long attempt,String reason){failures.add(reason);}
  void startBlob(long attempt,String url){blobStarts++;throw new AssertionError("Unexpected blob JavaScript boundary");}
  void download(long attempt,String url,String userAgent){urlDownloads++;if(!url.startsWith("https://"))throw new AssertionError("Unexpected insecure URL client dispatch");}
}
class MainActivity {
  final RemoteBoundary remote=new RemoteBoundary();final SessionBoundary session=new SessionBoundary();final HandlerBoundary handler=new HandlerBoundary();final File cache;
  String conversation=DownloadSourceHost.OLD_GPT,message="";int driverCalls,networkChecks;
  MainActivity(File cache){this.cache=cache;}
  static boolean chatUrl(String value){try{return BrowserRuntimePolicy.official(URI.create(value));}catch(Exception invalid){return false;}}
  File getCacheDir(){return cache;}
  void status(String value){message=value;}
  void runDriver(String action,JSONObject args,Object callback){driverCalls++;throw new AssertionError("Unexpected DOM driver");}
}
class RemoteBoundary {String url,afterRead;int reads,scripts;String getUrl(){reads++;String value=url;if(afterRead!=null){url=afterRead;afterRead=null;}return value;}}
class SessionBoundary {boolean transferActive,navigating;final GuardBoundary guard=new GuardBoundary();int updates;void updateBrowserActivity(){updates++;}}
class GuardBoundary {boolean permit=true;boolean allowed(){return permit;}}
class HandlerBoundary {final List<Runnable> queue=new ArrayList<>();void post(Runnable task){queue.add(task);}void drain(){while(!queue.isEmpty())queue.remove(0).run();}}
class WorkerBoundary {final List<Runnable> queue=new ArrayList<>();void execute(Runnable task){queue.add(task);}void drain(){while(!queue.isEmpty())queue.remove(0).run();}}
class AppPrefs {static void requireDownloadNetwork(MainActivity owner)throws IOException{owner.networkChecks++;}}
class DownloadTasks {
  static class PersistenceFailure extends RuntimeException {PersistenceFailure(){super("Controlled durable task failure");}}
  final List<JSONObject> rows=new ArrayList<>();boolean failAdd;
  JSONObject add(String id,String key,String source){if(failAdd)throw new PersistenceFailure();JSONObject row=J.obj("source",id,"key",key,"conversation",source);rows.add(row);return row;}
  boolean owns(JSONObject row){return rows.contains(row);}
  static void put(JSONObject row,Object... values){try{for(int i=0;i<values.length;i+=2)row.put((String)values[i],values[i+1]);}catch(Exception ignored){}}
}
class ResponseBoundary {final CloseProbe body;final String uri;final int statusCode=200;final Map<String,String> headers=new HashMap<>();int timeout;ResponseBoundary(String uri,byte[] bytes){this.uri=uri;body=new CloseProbe(bytes);headers.put("Content-Type","application/octet-stream");headers.put("Content-Length",String.valueOf(bytes.length));}void setReadTimeoutMillis(int value){timeout=value;}}
class CloseProbe extends ByteArrayInputStream {boolean closed;CloseProbe(byte[] bytes){super(bytes);}@Override public void close()throws IOException{closed=true;super.close();}}
class GeckoWebView {static String header(ResponseBoundary response,String name){return response.headers.getOrDefault(name,"");}}
class URLUtil {static String guessFileName(String url,String disposition,String type){return "controlled.bin";}}
class MimeTypeMap {static MimeTypeMap getSingleton(){return new MimeTypeMap();}String getMimeTypeFromExtension(String ext){return null;}String getExtensionFromMimeType(String type){return null;}}
class SealedFileIo {interface Action<T>{T run()throws Exception;}static <T>T lease(File file,Action<T> action)throws Exception{return action.run();}}
class Clock {static long wallMillis(){return 2000000;}}

package local.pocketchat;

import java.net.*;
import java.util.*;
import java.util.function.Consumer;
import org.json.*;

/** JVM boundaries only: no Android, SDK, native protection, or real network execution. */
public final class FixtureNetworkHost {
  static int checks;
  static void check(boolean value,String message){checks++;if(!value)throw new AssertionError(message);}
  static ChromeCollapseIntegration fresh(){SystemClock.now=1000;return new ChromeCollapseIntegration();}
  static void admission(){
    ChromeCollapseIntegration f=fresh();ChatSession s=f.a.session;Object pending=s.pending;
    check(s.appliedIdentity.isEmpty()&&s.networkReady,"original bootstrap lacks an applied route identity");
    check(f.admitFixtureNetwork(),"owned actual fixture passes production admission");
    check(s.appliedIdentity.equals("external:socks://127.0.0.1:1080"),"admission records the actual external proxy identity");
    check(s.networkReady&&!s.connecting&&!s.guard.blocked&&s.identityAcknowledgements==1,"admission completes original protection and identity hooks");
    check(s.web.loads==0&&s.web.stops==0&&s.pending==pending,"admission preserves live document and native pending task");
    check(s.connectionEpoch==1&&s.web.exitPageCloses==1,"admission takes the production lease");
    for(String kind:new String[]{"slot","generation","environment","deleted","catalogue"}){
      f=fresh();s=f.a.session;
      if(kind.equals("slot"))f.a.catalog.identity=new EnvironmentSpec.Identity(1,4,ChatSession.ENVIRONMENT);
      if(kind.equals("generation"))f.a.catalog.identity=new EnvironmentSpec.Identity(0,5,ChatSession.ENVIRONMENT);
      if(kind.equals("environment"))f.a.catalog.identity=new EnvironmentSpec.Identity(0,4,"00000000-0000-0000-0000-000000000002");
      if(kind.equals("deleted"))s.deleted=true;
      if(kind.equals("catalogue"))f.a.catalog.fail=true;
      check(!f.admitFixtureNetwork(),"wrong actual owner rejected: "+kind);
      check(s.connectionEpoch==0&&s.appliedIdentity.isEmpty()&&s.web.exitPageCloses==0,"wrong owner cannot take a lease: "+kind);
    }
    for(String kind:new String[]{"view","visible","protection","virtual","actual","binding","nonce","source","internal","proxy"}){
      f=fresh();s=f.a.session;
      if(kind.equals("view"))s.web=new ChromeCollapseIntegration.CollapseView();
      if(kind.equals("visible"))f.a.remote.visible=false;
      if(kind.equals("protection"))f.a.remote.protection=false;
      if(kind.equals("virtual"))f.a.remote.url="https://chatgpt.com/c/other";
      if(kind.equals("actual"))f.a.remote.raw="http://other.example/c/reload-collapse";
      if(kind.equals("binding"))f.a.remote.bound=false;
      if(kind.equals("nonce"))f.a.remote.boundNonce="other";
      if(kind.equals("source"))f.a.remote.boundSource="other";
      if(kind.equals("internal"))s.prefs.putString("networkMode","internal");
      if(kind.equals("proxy"))s.prefs.putString("proxy","socks://127.0.0.1:1081");
      check(!f.admitFixtureNetwork(),"foreign document or unprepared route rejected: "+kind);
      check(s.connectionEpoch==0&&s.appliedIdentity.isEmpty(),"fixture must not claim a route before its actual prerequisite: "+kind);
    }
    for(String kind:new String[]{"stale","offline","protection","route","proxy","proof"}){
      f=fresh();s=f.a.session;long lease=s.beginNetworkApplication(f.a.catalog.identity);
      if(kind.equals("stale"))s.connectionEpoch++;
      if(kind.equals("offline"))s.offline=true;
      if(kind.equals("protection"))s.web.protection=false;
      if(kind.equals("route"))s.guard.protectedRoute=false;
      if(kind.equals("proxy"))s.prefs.putString("proxy","invalid proxy");
      check(!s.adoptNetworkApplication(lease,kind.equals("proof")?new NetworkCoreApplication():null),"original production adoption guard rejects: "+kind);
      check(s.appliedIdentity.isEmpty()&&!s.networkReady&&s.guard.blocked,"rejected adoption cannot publish a successful route: "+kind);
    }
  }
  static void recovery(){
    for(boolean admitted:new boolean[]{false,true}){
      ChromeCollapseIntegration f=fresh();ChatSession s=f.a.session;Object pending=s.pending;
      if(admitted)check(f.admitFixtureNetwork(),"prepare retained fixture");
      s.networkChanged();
      check(s.web.stops==1&&!s.networkReady&&s.guard.blocked,"actual network switch still stops and blocks the route: "+admitted);
      check(s.handler.tasks.size()==1&&s.handler.tasks.get(0).delay==1000,"original first recovery delay remains one second: "+admitted);
      s.handler.runNext();
      check(s.networkReady&&!s.guard.blocked&&s.pending==pending,"actual recovery retains native pending task: "+admitted);
      if(admitted){
        check(s.web.loads==0&&s.web.stops==1,"admitted same route retains document without exempting original stop");
        check(s.observerConnections==1&&s.webObserver.readyCalls==1&&s.probes==1,"retained route executes original observer and read-only recovery probe");
      }else check(s.web.loads==1,"original missing applied identity actually dispatches replacement navigation");
    }
    ChromeCollapseIntegration f=fresh();ChatSession s=f.a.session;
    check(f.admitFixtureNetwork(),"prepare changed route control");s.prefs.putString("proxy","socks://127.0.0.1:1081");s.networkChanged();s.handler.runNext();
    check(s.web.loads==1&&s.web.stops==1,"different actual proxy identity must not retain the document");
    f=fresh();s=f.a.session;check(f.admitFixtureNetwork(),"prepare foreign chosen page control");s.browserNavigationChosen=true;s.browsingUrl="https://chatgpt.com/c/other";s.networkChanged();s.handler.runNext();
    check(s.web.loads==1,"retention cannot override an explicit different browser destination");
  }
  static void readiness(){
    ChromeCollapseIntegration f=fresh();f.a.session.manualAttention=true;f.ready(16000);
    check(f.a.session.appliedIdentity.equals("external:socks://127.0.0.1:1080"),"actual ready callback admits before creating the retention task");
    check(f.a.remote.progressCalls==1&&f.a.remote.tracking,"actual ready callback prepares the controlled page resource workload");
    check(f.task.matches("legacy-collapse-[0-9a-f-]{36}")&&f.a.session.pending!=null&&f.a.session.pending.optString("id").equals(f.task)&&f.a.session.pending.optBoolean("confirmed")&&f.a.session.pending.optBoolean("webSuspended")&&f.a.session.pending.optString("expectedUrl").equals(ChromeCollapseIntegration.TARGET),"actual ready callback retains its owned suspended legacy cursor");
    check(f.a.session.conversation.equals(ChromeCollapseIntegration.TARGET)&&f.a.session.prefs.getString("pending","").equals(f.a.session.pending.toString())&&f.a.session.prefs.getString("conversation","").equals(ChromeCollapseIntegration.TARGET),"actual ready callback persists the same retained document cursor");
    check(f.a.session.deliveries.starts==0,"actual ready callback never starts a reply delivery worker");
    check(!f.a.session.manualAttention&&f.a.loading.updates==1,"actual usable page dismisses its loading cover");
    check(f.snapshots==0&&f.a.handler.tasks.size()==1&&f.a.handler.tasks.get(0).delay==300,"original first ready snapshot delay remains 300 ms");
    f.a.handler.runNext();check(f.snapshots==1&&f.errors.isEmpty(),"snapshot follows successful production admission");
    for(String prerequisite:new String[]{"DOM","telemetry","visible","protection","binding"}){
      f=fresh();
      if(prerequisite.equals("DOM"))f.a.remote.domReady=false;
      if(prerequisite.equals("telemetry"))f.a.remote.telemetryReady=false;
      if(prerequisite.equals("visible"))f.a.remote.visible=false;
      if(prerequisite.equals("protection"))f.a.remote.protection=false;
      if(prerequisite.equals("binding"))f.a.remote.bound=false;
      f.ready(16000);
      check(f.a.session.connectionEpoch==0&&f.a.remote.progressCalls==0&&f.a.session.deliveries.starts==0,"actual ready waits for prerequisite: "+prerequisite);
      check(f.a.handler.tasks.size()==1&&f.a.handler.tasks.get(0).delay==100,"original bounded readiness polling remains 100 ms: "+prerequisite);
      SystemClock.now=16001;f.a.handler.runNext();
      check(f.errors.size()==1&&f.snapshots==0&&f.a.session.appliedIdentity.isEmpty()&&f.a.handler.tasks.isEmpty(),"missing prerequisite expires within original deadline: "+prerequisite);
    }
    f=fresh();f.a.remote.protection=false;f.ready(16000);f.a.remote.protection=true;f.a.handler.runNext();f.a.handler.runNext();
    check(f.snapshots==1&&f.a.session.networkReady,"late real protection readiness can complete within the original budget");
    f=fresh();f.a.catalog.identity=new EnvironmentSpec.Identity(0,5,ChatSession.ENVIRONMENT);f.ready(16000);
    check(f.errors.size()==1&&f.snapshots==0&&f.a.remote.progressCalls==0&&f.a.session.deliveries.starts==0,"wrong owner cannot emit a ready receipt");
    for(String invalid:new String[]{"not-installed","foreign-document","expired"}){
      f=fresh();JSONObject previous=f.a.session.pending;
      if(invalid.equals("not-installed"))f.a.remote.progressInstalled=false;
      if(invalid.equals("foreign-document"))f.a.remote.progressDocument="foreign-document";
      if(invalid.equals("expired"))f.a.remote.progressAt=16001;
      f.ready(16000);
      check(f.errors.size()==1&&f.snapshots==0&&f.task.isEmpty()&&f.a.session.pending==previous&&!f.a.session.prefs.values.containsKey("pending")&&f.a.handler.tasks.isEmpty()&&!f.a.remote.tracking&&f.a.loading.updates==0&&f.a.session.deliveries.starts==0,"unusable or stale page resource proof cannot publish retention: "+invalid);
    }
  }
  public static void main(String[] args){
    String focus=args.length==0?"all":args[0];
    if(focus.equals("all")||focus.equals("admission"))admission();
    if(focus.equals("all")||focus.equals("recovery"))recovery();
    if(focus.equals("all")||focus.equals("readiness"))readiness();
    System.out.println(J.obj("status","passed","checks",checks,"actualAndroidExecution",false,"actualGeckoExecution",false));
  }
}

class ChromeCollapseIntegration {
  static final String TARGET="https://chatgpt.com/c/reload-collapse";
  static final String TELEMETRY="controlled-DOM-boundary",TELEMETRY_READY="controlled-telemetry-boundary",REPLY_PROGRESS_SCRIPT="controlled-reply-progress-boundary";
  final CompactChromeIntegrationActivity a=new CompactChromeIntegrationActivity();final String nonce="owned-nonce";final EventBoundary events=new EventBoundary();
  String task="";int readyEvaluations,readyCallbacks,snapshots;final List<JSONObject> errors=new ArrayList<>();
  CollapseView web(){return a.remote;}void diagnostic(String stage){}void emit(String kind,JSONObject row){if(!kind.equals("error"))throw new AssertionError("Unexpected event");errors.add(row);}
  void snapshot(String kind){if(!kind.equals("ready")||a.session.appliedIdentity.isEmpty()||!a.session.networkReady)throw new AssertionError("Ready without admitted route");snapshots++;}
  @FIXTURE_MEMBERS@
  static class CollapseView {
    boolean visible=true,protection=true,bound=true,domReady=true,telemetryReady=true,tracking,progressInstalled=true;
    String progressDocument="owned-document";long progressAt;
    String url=TARGET,raw=CompactChromeIntegrationActivity.ReloadView.LOCAL+"c/reload-collapse",boundNonce="owned-nonce",boundSource="controlled-source";
    final Object current=new Object();final Map<Object,Object> ports=new IdentityHashMap<>();int loads,stops,exitPageCloses,progressCalls;
    CollapseView(){ports.put(current,new Object());}
    boolean hasVisibleDocument(){return visible;}boolean protectionAllowsNetwork(){return protection;}String getUrl(){return url;}String rawUrl(){return raw;}
    String inputDocument(String nonce,String source){return bound&&boundNonce.equals(nonce)&&boundSource.equals(source)?"owned-document":"";}
    void closeExitIpPage(){exitPageCloses++;}void stopLoading(){stops++;}void loadUrl(String value){loads++;url=value;}
    void evaluateJavascript(String script,Consumer<String> callback){
      if(script.contains("fixtureDocument:"))callback.accept(J.obj("ready",domReady,"telemetryReady",telemetryReady,"fixtureDocument","owned-document").toString());
      else if(script.startsWith("("+REPLY_PROGRESS_SCRIPT+")")){progressCalls++;if(progressAt>0)SystemClock.now=progressAt;callback.accept(J.obj("installed",progressInstalled,"document",progressDocument).toString());}
      else throw new AssertionError("Unexpected JavaScript boundary");
    }
  }
}
class CompactChromeIntegrationActivity {
  static class ReloadView {static final String LOCAL="http://127.0.0.1:8765/";}
  final ChromeCollapseIntegration.CollapseView remote=new ChromeCollapseIntegration.CollapseView();final ChatSession session=new ChatSession(remote);final HandlerBoundary handler=new HandlerBoundary();
  final ProfileCatalog catalog=new ProfileCatalog();final LoadingBoundary loading=new LoadingBoundary();
}
class ChatSession {
  static final String ENVIRONMENT="00000000-0000-0000-0000-000000000001";
  final ContextBoundary context=new ContextBoundary();final int environmentGeneration=4;final String environmentId=ENVIRONMENT;
  final PrefsBoundary prefs=new PrefsBoundary();ChromeCollapseIntegration.CollapseView web;final HandlerBoundary handler=new HandlerBoundary();
  final GuardBoundary guard=new GuardBoundary();final AuditBoundary audit=new AuditBoundary();final MemoryBoundary pageMemory=new MemoryBoundary();final PrivacyBoundary privacy=new PrivacyBoundary();
  final TraceBoundary trace=new TraceBoundary();final ObserverBoundary webObserver=new ObserverBoundary();final DeliveryBoundary deliveries=new DeliveryBoundary();
  JSONObject pending=J.obj("id","existing-owned-task");String conversation="",appliedIdentity="",networkIssue="",connectionStage="",pageError="",browsingUrl="";
  boolean deleted,offline,connecting,manualAttention,recoveryScheduled,navigating,navigationFailed,submitting,operation,browserNavigationStopped,browserNavigationChosen,websiteConnectionIssue,keepPageCandidate;
  boolean networkReady=true,navigationDispatched=true;long connectionEpoch,navigationEpoch,recoveryToken,connectionStarted,proxyReadyAt,pageUsableAt;int recoveryAttempt,identityAcknowledgements,observerConnections,probes,wakes,activityUpdates;
  ChatSession(ChromeCollapseIntegration.CollapseView view){web=view;prefs.putString("proxy","socks://127.0.0.1:1080").putBoolean("networkConfigured",true);}
  @SESSION_MEMBERS@
  void identityPolicyAcknowledged(){identityAcknowledgements++;}void updateBrowserActivity(){activityUpdates++;}void setStatus(String value){}void resetReplyStability(){}void finishResourceInspection(){}void wakePolling(){wakes++;}
  void connectionFailed(long epoch,String message,boolean retry){throw new AssertionError("Unexpected failed recovery boundary: "+message);}
  ReloadTarget reloadTarget(){throw new AssertionError("Internal route outside this host");}boolean retainExistingConnection(long epoch,ReloadTarget target,NativeNetwork n,NativeNetwork.RecoveryOutcome result){throw new AssertionError("Internal route outside this host");}
  String resumeUrl(){return browserNavigationChosen?browsingUrl:web.getUrl();}void navigate(String url,String label){web.loadUrl(url);}
  void resourceObserverConnected(Object port){if(port!=web.ports.get(web.current))throw new AssertionError("Foreign observer port");observerConnections++;}
  void asyncDriver(String action,JSONObject args,long timeout,Consumer<JSONObject> callback){if(!action.equals("page-recover")||timeout!=3200||!args.optString("expectedUrl").equals(web.getUrl()))throw new AssertionError("Unexpected recovery probe");probes++;}
  void observeWebsiteProbe(long connection,long page,String url,JSONObject result){throw new AssertionError("No native recovery probe result supplied");}
}
class ProfileCatalog {EnvironmentSpec.Identity identity=new EnvironmentSpec.Identity(0,4,ChatSession.ENVIRONMENT);boolean fail;static ProfileCatalog get(CompactChromeIntegrationActivity a){return a.catalog;}EnvironmentSpec.Identity identity(int slot)throws java.io.IOException{if(fail)throw new java.io.IOException("Controlled catalogue unavailable");return identity;}}
class Profiles {static int slot(Object context){return 0;}}
class EventBoundary {final JSONObject buildIdentity=J.obj("sourceCommit","controlled-source");}
class PrefsBoundary {final Map<String,Object> values=new HashMap<>();String getString(String key,String fallback){Object v=values.get(key);return v instanceof String?(String)v:fallback;}boolean getBoolean(String key,boolean fallback){Object v=values.get(key);return v instanceof Boolean?(Boolean)v:fallback;}PrefsBoundary edit(){return this;}PrefsBoundary putString(String k,String v){values.put(k,v);return this;}PrefsBoundary putBoolean(String k,boolean v){values.put(k,v);return this;}boolean commit(){return true;}}
class GuardBoundary {boolean blocked,protectedRoute=true;boolean routeProtected(){return protectedRoute;}void setBlocked(boolean value){blocked=value;}boolean requiresVpn(){return false;}boolean vpnActive(){return true;}String vpnProtectionFailureMessage(){return "Controlled VPN unavailable";}}
class AuditBoundary {void refresh(boolean force){}boolean requestIdentityPageSelected(){return false;}void cancel(){throw new AssertionError("No diagnostic page");}void retirePageCheck(){}}
class MemoryBoundary {void capture(Runnable done){done.run();}}
class PrivacyBoundary {boolean canNavigate(){return true;}}
class TraceBoundary {long visible,usable;void begin(){}void network(Object value){if(value!=null)throw new AssertionError("No internal route");}void page(String label){}}
class ObserverBoundary {int readyCalls;void pageReady(){readyCalls++;}}
class DeliveryBoundary {int starts;String begin(String url,String prompt,JSONArray attachments,String kind,Object callback){starts++;return "controlled-native-task";}}
class LoadingBoundary {int updates;void update(){updates++;}}
class HandlerBoundary {static class Task {final Runnable action;final long delay;Task(Runnable action,long delay){this.action=action;this.delay=delay;}}final List<Task> tasks=new ArrayList<>();void postDelayed(Runnable task,long delay){tasks.add(new Task(task,delay));}void runNext(){Task task=tasks.remove(0);SystemClock.now+=task.delay;task.action.run();}}
class SystemClock {static long now=1000;static long elapsedRealtime(){return now;}}
class ContextBoundary {}
class SecretStore {SecretStore(ContextBoundary c){}void importPrivateProvision(){}}
class ReloadTarget {}
class NetworkCoreApplication {EnvironmentSpec.Identity identity=new EnvironmentSpec.Identity(0,4,ChatSession.ENVIRONMENT);boolean current(NativeNetwork n){return false;}}
class NativeNetwork {
  String fingerprint="",message="";JSONObject settings;boolean recoveryBlocked;
  interface Callback {void result(boolean ok,String message);}enum RecoveryState {RECOVERED}static class RecoveryOutcome {RecoveryState state;String message;}
  static NativeNetwork get(ContextBoundary c){throw new AssertionError("Internal route outside this host");}static NativeNetwork peek(){throw new AssertionError("Internal route outside this host");}static String hash(String value){throw new AssertionError("Internal route outside this host");}
  String proxy(){throw new AssertionError("Internal route outside this host");}void start(Callback c){throw new AssertionError("Internal route outside this host");}void restart(Callback c){throw new AssertionError("Internal route outside this host");}void recoverOutcome(Consumer<RecoveryOutcome> c){throw new AssertionError("Internal route outside this host");}
}
class MainActivity {@ACTIVITY_MEMBERS@}
class Uri {final URI value;Uri(URI value){this.value=value;}static Uri parse(String value){return new Uri(URI.create(value));}String getScheme(){return value.getScheme();}String getHost(){return value.getHost();}int getPort(){return value.getPort();}String getUserInfo(){return value.getUserInfo();}String getPath(){return value.getPath();}String getQuery(){return value.getQuery();}String getFragment(){return value.getFragment();}}
class RequestIdentityAudit {static final String PATH="/pocketchat-identity/v1/";@DIAGNOSTIC_MEMBERS@}

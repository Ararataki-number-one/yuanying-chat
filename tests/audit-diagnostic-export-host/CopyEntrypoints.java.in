package local.pocketchat;
import org.json.*;
import java.util.*;
import java.text.SimpleDateFormat;

/** Exact production copy/format entrypoints; only lifecycle/configuration collaborators are host doubles. */
final class Session {
  final Object context=new Object();final Web web=new Web();boolean deleted;final String environmentId="11111111-1111-4111-8111-111111111111";final int environmentGeneration=4;long navigationEpoch=7;
  long identityAuditAppliedRevision(){return 8;}
}
final class Web {JSONObject protectionStatus(){return J.obj("state","confirmed","received",true,"settingsReadbackConfirmed",true,"desiredLevel",2,"level",2,"observedFingerprinting",true);}}
final class Profiles {static int slot(Object c){return 0;}static String display(Object c,int slot){return "Controlled environment";}}
final class BrowserNetworkGuard {static boolean localHost(String value){return value.startsWith("127.")||value.equals("::1");}}
final class FingerprintReportComparison {static JSONObject restore(JSONObject v,String env,int gen){return v;}}
final class ServiceProbe {boolean active;JSONObject result=new JSONObject();boolean resultCurrent(){return true;}}
final class RequestIdentityAudit {static String endpoint(String value){return value;}}
final class RequestIdentityAuditSession {
  final EnvironmentAudit audit;final Session session;boolean active;
  RequestIdentityAuditSession(EnvironmentAudit a){audit=a;session=a.session;}
  String configuredEndpoint(){return "https://controlled.invalid/pocketchat-identity/v1/";}String configuredFrameEndpoint(){return "";}
  __REQUEST_SUMMARY__
}
final class EnvironmentAudit {
  final Session session=new Session();final ServiceProbe serviceProbe=new ServiceProbe();final RequestIdentityAuditSession requestIdentity=new RequestIdentityAuditSession(this);
  JSONObject report=new JSONObject(),pinnedDeepBaseline=new JSONObject(),fingerprintContextBaselines=new JSONObject(),fingerprintComparison=new JSONObject(),requestIdentityReport=new JSONObject();JSONArray changes=new JSONArray();boolean running;String storageIssue="",lastError="";
  void refresh(boolean force){}
  boolean deepObservationCurrent(){return true;}boolean observationCurrent(JSONObject value){return true;}String policyStamp(){return "";}String routeStamp(){return "";}boolean hasChanges(){return false;}
  String requestIdentitySummary(boolean redact){return requestIdentity.summary(redact);}
  __ADDRESS__
  __SUMMARY__
  __DEEP_COPY__
  __SAFE_COPY__
  __DIAGNOSTIC_COPY__
  __COMPARISON_DIAGNOSTIC_COPY__
}
public final class CopyEntrypoints {
  static final String SECRET="secret-cookie-password-chat-attachment-path";
  static final String ENV="11111111-1111-4111-8111-111111111111";
  static int checks;
  static void check(String name,boolean ok){checks++;if(!ok)throw new AssertionError(name);System.out.println("PASS "+name);}
  static EnvironmentAudit fixture()throws Exception{
    EnvironmentAudit a=new EnvironmentAudit();
    JSONObject sample=J.obj("provenance","page-main-world","mainWorld",J.obj("observed",true),"parent",J.obj("ua","Mozilla/5.0 Firefox/156.0"),"password",SECRET,"nested",J.obj("Cookie",SECRET),"apiChecks",J.obj("schema",1,"probeVersion",1,"requested",true,"source","page-main-world","protectionVerified",false,"limits",J.obj("canvasPixels",4096,"audioFrames",2048,"fontCandidates",5,"totalBudgetMs",1200),"probes",J.obj("canvas",J.obj("state","available","pixels",4096,"reason",SECRET))));
    a.report=AuditReport.build(sample,new JSONObject(),J.obj("engine","gecko","major",157,"ua","Mozilla/5.0 Firefox/157.0","level",2),false,true);
    a.report.put("observationMetadata",J.obj("environmentId",ENV,"environmentGeneration",4,"configurationRevision",8,"appVersionCode",84));
    a.requestIdentityReport=J.obj("environmentId",ENV,"environmentGeneration",4,"status","issue","fresh",true,"endpoint",a.requestIdentity.configuredEndpoint(),"configurationRevision",8,"rows",J.arr(J.obj("key","request-document-ua","state","issue","name",SECRET,"detail",SECRET)),"browser",J.obj("document",J.obj("ua",SECRET,"language",SECRET,"languages",J.arr(SECRET))),"expected",J.obj("environmentId",ENV,"environmentGeneration",4,"ua",SECRET,"templateId",SECRET));
    return a;
  }
  public static void main(String[] args)throws Exception{
    boolean fixed=Boolean.parseBoolean(args[0]);EnvironmentAudit a=fixture();String before=a.report.toString(),requests=a.requestIdentityReport.toString();
    String deep=a.deepRecordCopy(),brief=a.safeCopy();
    check("Actual deep copy entrypoint matches paired secret-boundary expectation",deep.contains(SECRET)!=fixed);
    check("Actual brief copy entrypoint matches paired secret-boundary expectation",brief.contains(SECRET)!=fixed);
    check("Copy leaves stored report and request record unchanged",before.equals(a.report.toString())&&requests.equals(a.requestIdentityReport.toString()));
    if(fixed){JSONObject record=new JSONObject(deep),summary=new JSONObject(brief);check("Deep copy explicitly reports redacted schema",record.getBoolean("rawTextIncluded")==false&&record.getString("detail").equals("deep"));check("Brief copy explicitly retains difference state",summary.getJSONObject("observation").getJSONObject("rows").getJSONObject("states").getString("ua").equals("issue"));check("Both copy entrypoints cannot attest protection",!record.getBoolean("protectionVerified")&&!summary.getBoolean("protectionVerified"));}
    System.out.println("TOTAL "+checks);System.out.println("PAIRED {\"deepContainsControlledSecret\":"+deep.contains(SECRET)+",\"briefContainsControlledSecret\":"+brief.contains(SECRET)+"}");
  }
}

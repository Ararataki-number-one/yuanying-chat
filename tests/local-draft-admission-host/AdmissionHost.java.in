package local.pocketchat;
import android.content.*;import android.net.Uri;import java.util.*;import org.json.*;import java.nio.charset.StandardCharsets;import java.security.MessageDigest;

public class AdmissionHost {
 static final String NONCE="0123456789abcdef0123456789abcdef";
 static final JSONArray checks=new JSONArray(),beforeFailures=new JSONArray();
 static void check(String name,boolean ok){checks.put(J.obj("name",name,"pass",ok));if(!ok)throw new AssertionError(name);}
 interface Throwing{void run()throws Exception;}
 static void refuses(String name,Throwing operation)throws Exception{boolean rejected=false;try{operation.run();}catch(IllegalArgumentException|IllegalStateException error){rejected=true;}check(name,rejected);}
 static JSONObject dom(FixtureBase f)throws Exception{String text=f.text(false);return J.obj("ok",true,"url",f.target+"#f04-saved","draft",text,"draftLength",text.length(),"draftComplete",true,"hasDraft",true,"selectionStart",2,"selectionEnd",5,"cookie","sessionOnly=controlled; f04Draft=kept","token","synthetic-session-2","history",8,"scroll",720,"sends",0,"document",1720000000123L,"nested",J.obj("values",new JSONArray().put("kept").put(2)));}
 static JSONObject copy(JSONObject v)throws Exception{return new JSONObject(v.toString());}
 static void run()throws Exception{
  for(boolean enabled:new boolean[]{true,false}){
   BeforeFixture f=new BeforeFixture();AppPrefs.apply(f.a,J.obj("saveDraft",enabled));JSONObject dom=dom(f);String raw=dom.toString();boolean failed=false;String reason="";
   try{f.rememberCheck(dom,enabled);}catch(IllegalStateException expected){failed=true;reason=expected.getMessage();}
   check("Original rememberCheck fails for actual loopback admission with policy "+enabled,failed&&reason.equals("Production PageMemory policy mismatch"));
   check("Original fixture cannot create a loopback memory entry or advance serial with policy "+enabled,f.s.pageMemory.pages.isEmpty()&&f.s.pageMemory.serial==0&&raw.equals(dom.toString()));
   beforeFailures.put(J.obj("enabled",enabled,"exception",reason,"entries",f.s.pageMemory.pages.size(),"serial",f.s.pageMemory.serial,"sameLoopback",WebReplyObserver.same(dom.getString("url"),dom.getString("url"))));
  }
  check("Production same admits ChatGPT same path while rejecting loopback even against itself",WebReplyObserver.same(MainActivity.ORIGIN+"c/a?x=1",MainActivity.ORIGIN+"c/a#fragment")&&!WebReplyObserver.same("http://127.0.0.1:8765/browser-session","http://127.0.0.1:8765/browser-session"));
  for(String url:new String[]{"http://chatgpt.com/c/a","https://foreign.example/c/a","https://user@chatgpt.com/c/a","https://chatgpt.com:444/c/a"})check("Production chatUrl rejects "+url,!MainActivity.chatUrl(url));
  Fixture f=new Fixture();JSONObject original=dom(f);String originalRaw=original.toString();JSONObject adapted=Fixture.memoryInput(original,NONCE);String logical=Fixture.memoryUrl(NONCE);
  check("URL-only adapter produces a real production-admissible unique ChatGPT key",logical.equals(MainActivity.ORIGIN+"c/f04-"+NONCE)&&MainActivity.chatUrl(logical)&&WebReplyObserver.same(logical,adapted.getString("url")));
  JSONObject restored=copy(adapted);restored.put("url",original.getString("url"));check("Adapter preserves every non URL value and original DOM bytes",originalRaw.equals(original.toString())&&Fixture.canonical(original).equals(Fixture.canonical(restored))&&original!=adapted);
  adapted.getJSONObject("nested").getJSONArray("values").put("copy-only");check("Adapter deep copy cannot mutate nested source data",originalRaw.equals(original.toString()));
  f.rememberCheck(original,true);JSONObject enabled=f.s.pageMemory.pages.get(f.s.pageMemory.scope()+"|"+PageMemory.address(logical));
  check("Exact revised rememberCheck creates one enabled snapshot through production admission",enabled!=null&&f.s.pageMemory.pages.size()==1&&f.s.pageMemory.serial==1&&f.text(false).equals(enabled.getString("draft"))&&PageMemory.completeDraft(enabled)&&LocalDraftPolicy.mayRestore(f.a,enabled));
  check("Enabled snapshot retains selections and source DOM remains unchanged",enabled.getInt("selectionStart")==2&&enabled.getInt("selectionEnd")==5&&originalRaw.equals(original.toString()));
  AppPrefs.apply(f.a,J.obj("saveDraft",false));check("Actual AppPrefs disable increments revision and invalidates old snapshot",LocalDraftPolicy.revision(f.a)==1&&!LocalDraftPolicy.mayRestore(f.a,enabled));
  f.rememberCheck(original,false);JSONObject disabled=f.s.pageMemory.pages.get(f.s.pageMemory.scope()+"|"+PageMemory.address(logical));
  check("Exact revised rememberCheck replaces entry with disabled redaction",disabled!=null&&disabled.isNull("draft")&&!PageMemory.completeDraft(disabled)&&PageMemory.hasDraft(disabled)&&!LocalDraftPolicy.mayRestore(f.a,disabled)&&f.s.pageMemory.serial==2&&f.s.pageMemory.pages.size()==1);
  check("Disabled snapshot removes selection offsets without altering source input",!disabled.has("selectionStart")&&!disabled.has("selectionEnd")&&disabled.getLong("localDraftPolicyRevision")==1&&originalRaw.equals(original.toString()));
  JSONObject evidence=f.result.getJSONObject("adapter");check("Exact fixture records source versus logical URL and explicit non ChatGPT scope",evidence.getString("sourceDomUrl").equals(original.getString("url"))&&evidence.getString("logicalMemoryUrl").equals(logical)&&evidence.getBoolean("onlyUrlAdapted")&&!evidence.getBoolean("realChatGPT")&&evidence.getJSONArray("checks").length()==2);
  for(int i=0;i<2;i++){JSONObject row=evidence.getJSONArray("checks").getJSONObject(i);check("Fixture evidence proves rejected loopback followed by one actual write "+i,!row.getBoolean("loopbackEntryPresent")&&row.getBoolean("storedEntryPresent")&&row.getLong("loopbackSerialBefore")==row.getLong("loopbackSerialAfter")&&row.getLong("storedSerial")==row.getLong("loopbackSerialBefore")+1&&row.getString("sourceDomRaw").equals(row.getString("sourceDomAfterRaw")));}
  AppPrefs.apply(f.a,J.obj("saveDraft",true));check("Re-enabling actual policy cannot restore the earlier disabled-revision snapshot",LocalDraftPolicy.revision(f.a)==2&&!LocalDraftPolicy.mayRestore(f.a,disabled));JSONObject stale=LocalDraftPolicy.snapshot(f.a,original,0);check("Stale capture revision is redacted even after saving is enabled",stale.isNull("draft")&&!PageMemory.completeDraft(stale)&&stale.getLong("localDraftPolicyRevision")==2);
  for(String nonce:new String[]{null,"","a".repeat(31),"a".repeat(33),"A".repeat(32),"../"+"a".repeat(29)})refuses("Invalid nonce rejected "+String.valueOf(nonce),()->Fixture.memoryUrl(nonce));
  for(Object bad:new Object[]{"http://127.0.0.1:8765/browser-session?context=1&localDraft="+NONCE+"#f04-saved","http://localhost:8765/browser-session?context=2&localDraft="+NONCE+"#f04-saved",f.target,f.target+"#other",f.target+"&extra=1#f04-saved",f.target.replace(NONCE,"e".repeat(32))+"#f04-saved",logical,JSONObject.NULL,42}){JSONObject foreign=copy(original);foreign.put("url",bad);refuses("Foreign or invalid source URL rejected "+String.valueOf(bad),()->Fixture.memoryInput(foreign,NONCE));}
  refuses("Null source rejected",()->Fixture.memoryInput(null,NONCE));refuses("Source object cannot serve as adapted copy",()->Fixture.verifyMemoryInput(original,original,NONCE));
  for(String field:new String[]{"ok","draft","draftLength","draftComplete","hasDraft","selectionStart","selectionEnd","cookie","token","history","scroll","sends","document","nested"}){JSONObject changed=Fixture.memoryInput(original,NONCE);changed.put(field,"changed");refuses("Actual fixture verifier rejects changed non URL field "+field,()->Fixture.verifyMemoryInput(original,changed,NONCE));}
  JSONObject missing=Fixture.memoryInput(original,NONCE);missing.remove("selectionEnd");refuses("Actual fixture verifier rejects a removed non URL field",()->Fixture.verifyMemoryInput(original,missing,NONCE));JSONObject extra=Fixture.memoryInput(original,NONCE);extra.put("injected",true);refuses("Actual fixture verifier rejects an added non URL field",()->Fixture.verifyMemoryInput(original,extra,NONCE));
  JSONObject wrongLogical=Fixture.memoryInput(original,NONCE);wrongLogical.put("url",MainActivity.ORIGIN+"c/other");refuses("Actual fixture verifier rejects changed logical URL",()->Fixture.verifyMemoryInput(original,wrongLogical,NONCE));
  Fixture absent=new Fixture();JSONObject rejected=dom(absent);rejected.put("ok",false);refuses("Revised fixture rejects absent adapted entry when real PageMemory refuses invalid state",()->absent.rememberCheck(rejected,true));check("No mocked entry fills rejected admission",absent.s.pageMemory.pages.isEmpty()&&absent.s.pageMemory.serial==0);
  Fixture namespace=new Fixture();JSONObject input=Fixture.memoryInput(dom(namespace),NONCE);String oldScope=namespace.s.pageMemory.scope();namespace.s.web.cookieStamp="replacement-cookie-journal";namespace.s.pageMemory.remember(oldScope,logical,input);check("Production changed-cookie scope rejects previously captured namespace",namespace.s.pageMemory.pages.isEmpty()&&namespace.s.pageMemory.serial==0&&!oldScope.equals(namespace.s.pageMemory.scope()));
  check("Remember failure retains only observations actually reached",absent.partial.has("domSource")&&absent.partial.has("memoryInput")&&!absent.partial.has("memoryStored")&&!absent.partial.has("sdkSource")&&absent.partial.length()==2);
  JSONObject retainedInput=new JSONObject(absent.partial.getJSONObject("memoryInput").getString("rawUtf8"));check("Failed admission does not fabricate an OK memory input",!retainedInput.getBoolean("ok")&&retainedInput.getString("url").equals(logical));
  JSONObject retainedDisabled=new JSONObject(f.partial.getJSONObject("memoryStored").getString("rawUtf8"));check("Partial stored observation preserves actual disabled redaction",retainedDisabled.isNull("draft")&&!retainedDisabled.getBoolean("draftComplete")&&!retainedDisabled.has("selectionStart"));
  Fixture observation=new Fixture();check("New partial evidence starts empty",observation.partial.length()==0);
  observation.retainPartial("sdkSource","already observed SDK summary");JSONObject shortRaw=observation.partial.getJSONObject("sdkSource");check("Actual retainPartial preserves bounded UTF8 bytes and actual SHA",shortRaw.getString("rawUtf8").equals("already observed SDK summary")&&shortRaw.getInt("utf8Bytes")==28&&shortRaw.getString("sha256").equals(Sha256.hash("already observed SDK summary"))&&!shortRaw.has("rawOmitted"));
  String exact="x".repeat(8192);observation.retainPartial("domSource",exact);JSONObject exactRaw=observation.partial.getJSONObject("domSource");check("Exact 8192 byte ASCII boundary retains complete raw value",exactRaw.getInt("utf8Bytes")==8192&&exactRaw.getString("rawUtf8").equals(exact)&&!exactRaw.has("rawOmitted"));
  String unicode="中".repeat(2730)+"é";observation.retainPartial("memoryInput",unicode);JSONObject utf8=observation.partial.getJSONObject("memoryInput");check("8192 byte multibyte boundary counts UTF8 bytes rather than Java characters",unicode.length()<8192&&utf8.getInt("utf8Bytes")==8192&&utf8.getString("rawUtf8").equals(unicode)&&utf8.getString("sha256").equals(Sha256.hash(unicode)));
  String oversized="中".repeat(2731);observation.retainPartial("memoryStored",oversized);JSONObject omitted=observation.partial.getJSONObject("memoryStored");check("8193 byte input retains only summary with explicit omission",oversized.length()<8192&&omitted.getInt("utf8Bytes")==8193&&omitted.getBoolean("rawOmitted")&&!omitted.has("rawUtf8")&&omitted.getString("sha256").equals(Sha256.hash(oversized))&&omitted.length()==3);
  String supplementary="😀".repeat(2048);observation.retainPartial("domSource",supplementary);JSONObject emoji=observation.partial.getJSONObject("domSource");check("Supplementary Unicode is retained by its exact UTF8 byte count",emoji.getInt("utf8Bytes")==8192&&emoji.getString("rawUtf8").equals(supplementary)&&emoji.getString("sha256").equals(Sha256.hash(supplementary)));
  String observations=Fixture.canonical(observation.partial);observation.retainPartial("outsideWhitelist","ignored");observation.retainPartial("memoryInput",null);check("Unknown key and failed diagnostic capture do not invent or replace observations",observation.partial.length()==4&&observations.equals(Fixture.canonical(observation.partial)));
  Fixture missingObservation=new Fixture();missingObservation.retainPartial("sdkSource",null);check("Missing raw observation remains missing without synthesizing other keys",missingObservation.partial.length()==0);
  Throwable originalFailure=new IllegalStateException("original admission failed");JSONObject partialIdentity=absent.partial;String partialBefore=Fixture.canonical(partialIdentity);absent.retainPartial("outsideWhitelist","diagnostic failure");absent.fail(originalFailure);JSONObject event=absent.a.lastEvent;
  check("Actual fail emits original error and the same partial object without acceptance",absent.finished&&absent.worker.stopped&&absent.a.events==1&&absent.a.lastSerial==absent.serial&&absent.a.lastKind.equals("error")&&event.getString("error").equals("F04 actual SDK regression: "+originalFailure)&&event.getBoolean("diagnosticOnly")&&!event.getBoolean("acceptance")&&!event.has("status")&&event.opt("partial")==partialIdentity&&partialBefore.equals(Fixture.canonical(partialIdentity)));
  absent.fail(new IllegalArgumentException("late failure"));check("Finished fixture cannot overwrite the original failure event",absent.a.events==1&&absent.a.lastEvent==event);
  Fixture retired=new Fixture();retired.a.run++;retired.fail(new IllegalStateException("obsolete command"));check("Retired command failure cannot publish into a replacement invocation",retired.a.events==0&&!retired.finished&&!retired.worker.stopped);
 }
 public static void main(String[]args){Throwable error=null;try{run();}catch(Throwable failure){error=failure;}JSONObject report=J.obj("status",error==null?"passed":"failed","checks",checks,"checkCount",checks.length(),"beforeFailures",beforeFailures);if(error!=null){NetworkCatalog.put(report,"error",error.toString());error.printStackTrace(System.err);}System.out.println(report);if(error!=null)System.exit(1);}
}
class FixtureBase {
 /* FIXTURE_CONSTANTS */
 final EventContext a=new EventContext();final ChatSession s=new ChatSession(a);final SharedPreferences prefs=a.getSharedPreferences("f04-local-draft-fixture",0);String phase="seed",target="http://127.0.0.1:8765/browser-session?context=2&localDraft="+AdmissionHost.NONCE;final JSONObject result=J.obj("fixtureNonce",AdmissionHost.NONCE);final JSONObject partial=new JSONObject();final long serial=7;final Worker worker=new Worker();boolean finished;
 FixtureBase(){prefs.edit().putString("target",target).commit();}
 /* BASE */
}
class BeforeFixture extends FixtureBase{/* BEFORE */}
class Fixture extends FixtureBase{/* FIXTURE */}
class EventContext extends Context{long run=7,lastSerial;int events;String lastKind;JSONObject lastEvent;void event(long serial,String kind,JSONObject value){events++;lastSerial=serial;lastKind=kind;lastEvent=value;}}
class Worker{boolean stopped;void shutdown(){stopped=true;}}
class ChatSession {final Context context;final Web web=new Web();final PageMemory pageMemory;String appliedIdentity="host-environment-fixed-route";ChatSession(Context c){context=c;pageMemory=new PageMemory(this);}}
class Web{String cookieStamp="host-cookie-checkpoint";}
class PageMemory{final ChatSession session;final LinkedHashMap<String,JSONObject> pages=new LinkedHashMap<>(16,.75f,true);long serial;PageMemory(ChatSession s){session=s;}/* MEMORY */}
class MainActivity{/* MAIN_ORIGIN */ /* CHAT_URL */}
class WebReplyObserver{/* SAME */}
class LocalDraftPolicy{/* POLICY */}
class AppPrefs{/* APP_KEYS */ /* APP_PREFS */}
class NativeNetwork{/* HASH */}
class J{/* JSON */}
class NetworkCatalog{/* PUT */}

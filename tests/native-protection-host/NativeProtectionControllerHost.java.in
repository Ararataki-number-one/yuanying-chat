package local.pocketchat;

import java.util.*;
import java.net.URI;
import java.net.URLDecoder;

/** Executes extracted production controller methods with synthetic Handler/SDK boundaries. */
final class NativeProtectionControllerHost {
  static final List<String> checks=new ArrayList<>();
  static void check(String name,boolean value){if(!value)throw new AssertionError(name);checks.add(name);}
  static String quote(String value){return "\""+value.replace("\\","\\\\").replace("\"","\\\"")+"\"";}
  static final class JSONObject extends HashMap<String,Object> {
    Object opt(String key){return get(key);}
    String optString(String key){return optString(key,"");}
    String optString(String key,String fallback){Object v=get(key);return v instanceof String?(String)v:fallback;}
    int optInt(String key){return optInt(key,0);}int optInt(String key,int fallback){Object v=get(key);return v instanceof Number?((Number)v).intValue():fallback;}
    long optLong(String key,long fallback){Object v=get(key);return v instanceof Number?((Number)v).longValue():fallback;}
    boolean optBoolean(String key){return Boolean.TRUE.equals(get(key));}
  }
  static final class J {static JSONObject obj(Object...pairs){JSONObject o=new JSONObject();for(int i=0;i<pairs.length;i+=2)o.put((String)pairs[i],pairs[i+1]);return o;}}
  static final class RequestIdentityAudit {__IDENTITY_POLICY__}
  static final class Audit {
    String endpoint="https://detector.invalid/pocketchat-identity/v1/",nonce="aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa";
    boolean active,registered=true,fresh=true;long now,deadline=10000;
    boolean requestIdentityAllowsRequest(String target){return RequestIdentityAudit.requestAllowed(target,endpoint,nonce,active,registered,fresh,now,deadline);}
  }
  static final class Handler {
    static final class Task {final Runnable action;final long at;Task(Runnable r,long t){action=r;at=t;}}
    final List<Task> tasks=new ArrayList<>();long now;
    void postDelayed(Runnable action,long delay){tasks.add(new Task(action,now+delay));}
    void post(Runnable action){postDelayed(action,0);}
    void removeCallbacks(Runnable action){tasks.removeIf(t->t.action==action);}
    void advance(long delta){long end=now+delta;for(;;){Task first=null;for(Task t:tasks)if(t.at<=end&&(first==null||t.at<first.at))first=t;if(first==null)break;tasks.remove(first);now=first.at;first.action.run();}now=end;}
  }
  static final class Privacy {int value=2;int level(){return value;}}
  static final class Guard {boolean usable=true;boolean allowed(){return usable;}}
  static final class Prefs {String proxy="";String getString(String key,String fallback){return proxy;}}
  static final class Owner {
    final Handler handler=new Handler();final Privacy privacy=new Privacy();final Guard guard=new Guard();final Prefs prefs=new Prefs();final Object context=new Object();
    long navigationEpoch,connectionEpoch;int changes;String status="";boolean internal,deleted;Audit audit=new Audit();
    boolean internalNetwork(){return internal;}void changed(){changes++;}void setStatus(String value){status=value;}
  }
  static final class Metadata {boolean rfpAcknowledged,policyAcknowledged;}
  static final class GeckoSession {
    final List<String> loads=new ArrayList<>();final List<SessionState> restored=new ArrayList<>();
    void loadUri(String target){loads.add(target);}void restoreState(SessionState state){restored.add(state);}boolean isOpen(){return true;}
    static final class SessionState {
      final String url;SessionState(){this("");}SessionState(String value){url=value;}
      static SessionState fromString(String value){return new SessionState(value);}int size(){return url.isEmpty()?0:1;}public String toString(){return url;}
    }
  }
  enum AllowOrDeny {ALLOW,DENY}
  static final class GeckoResult<T> {final T value;GeckoResult(T v){value=v;}static <T>GeckoResult<T> fromValue(T value){return new GeckoResult<>(value);}}
  static final class LoadRequest {final String uri;LoadRequest(String value){uri=value;}}
  static final class LocalDraftPolicy {static boolean enabled(Object context){return true;}static long revision(Object context){return 4;}static String checkpoint(String value,boolean forms){return value;}}
  static final class SessionStore {final java.util.concurrent.Executor io=Runnable::run;}
  static final class WebExtension {static final class Port {
    final List<JSONObject> sent=new ArrayList<>();boolean throwing;
    void postMessage(JSONObject value){if(throwing)throw new IllegalStateException("synthetic disconnect");sent.add(value);}
    JSONObject last(){return sent.get(sent.size()-1);}
  }}
  static final class CookieCallbacks {int cancelled;void cancel(Object port){cancelled++;}void complete(Object port,int id,String value){}}
  static final class MainActivity {static boolean validProxy(String value){return false;}}
  static final class Profiles {static int slot(Object context){return 1;}}
  static final class Uri {static Uri parse(String value){return new Uri();}String getScheme(){return "http";}String getHost(){return "synthetic.invalid";}int getPort(){return 8080;}}
  static final class NativeNetwork {
    static NativeNetwork get(Object context){return new NativeNetwork();}
    static final class Transport {JSONObject state=new JSONObject();}
    static final class ExitRouteReceipt {int proxy=8080;boolean matches(NativeNetwork n,JSONObject state){return true;}}
    boolean ready=true,starting,recoveryBlocked;ExitRouteReceipt verifiedRoute=new ExitRouteReceipt();Transport transport=new Transport();
  }
  // Original protection cases have no auxiliary IP document. Its real lifecycle
  // is exercised elsewhere; never simulate successful auxiliary behavior here.
  static final class AuxiliaryPageBoundary {boolean fresh(){throw new AssertionError("Auxiliary IP page is outside this protection fixture");}}
  static final class View {
    final Owner owner=new Owner();final Metadata metadata=new Metadata();final CookieCallbacks cookieCallbacks=new CookieCallbacks();
    final NativeProtectionState nativeProtection=new NativeProtectionState();
    final Map<GeckoSession,String> locations=new IdentityHashMap<>();final List<GeckoSession> popups=new ArrayList<>();
    final Map<GeckoSession,GeckoSession.SessionState> states=new IdentityHashMap<>();final Map<GeckoSession,Long> stateDraftRevisions=new IdentityHashMap<>();final Set<GeckoSession> crashed=new HashSet<>();
    final SessionStore sessionStore=new SessionStore();GeckoSession.SessionState startupState;long startupDraftRevision;
    boolean destroyed,failed,ready,privacyReady,fingerprintingProtected,routePrepared,enabled=true,checkpointReady=true,identityPrepared=true;
    int protectionLevel=-1,configuredProtection=2,requestedProtection=-1,opens;
    long protectionRequest;String queued="";Object surface,extension=new Object();
    GeckoSession current,primary;WebExtension.Port routePort=new WebExtension.Port();Runnable protectionTimeout,protectionRetry;
    ProtectionRestore protectionRestore;
    AuxiliaryPageBoundary exitIpPage;
    boolean closeExitIpPage(){if(exitIpPage!=null)throw new AssertionError("Auxiliary IP page is outside this protection fixture");return false;}
    __PROTECTION_RESTORE__
    void acknowledgeIdentity(){metadata.policyAcknowledged=privacyReady&&metadata.rfpAcknowledged;}
    void open(){opens++;ready=true;}
    int loadCount(){return current==null?0:current.loads.size();}int restoreCount(){return current==null?0:current.restored.size();}String lastLoad(){return current.loads.get(current.loads.size()-1);}
    boolean reopenCurrent(){return true;}static String stateUrl(GeckoSession.SessionState state){return state.url;}
    GeckoSession newSession(){return new GeckoSession();}void activate(GeckoSession session){current=session;}
    void failure(String value){failed=true;owner.status=value;}
    String internalPoolKey(NativeNetwork n){return "synthetic-pool";}
    boolean allowedUrl(String value){return value!=null&&value.startsWith("https://");}
    __PRODUCTION_METHODS__
    __MAYBE_OPEN__
    __BLOCKED__
    __ROUTE__
    __LOAD_URL__
    __RESTORE_CHECKPOINT__
    GeckoResult<AllowOrDeny> navigation(GeckoSession s,LoadRequest request)__NAVIGATION_BODY__
    GeckoResult<GeckoSession> popup(GeckoSession s,String target)__POPUP_BODY__
    void receive(Object message,WebExtension.Port incoming)__PORT_MESSAGE_BODY__
    void disconnected(WebExtension.Port incoming)__DISCONNECT_BODY__
    void reply(boolean ack,boolean enabled){JSONObject request=routePort.last();receive(J.obj("kind","protectionReady","token",request.get("token"),"generation",request.get("generation"),"level",request.get("level"),"acknowledged",ack,"fingerprinting",enabled),routePort);}
    void start(int level){owner.privacy.value=level;configuredProtection=level;prepareProtectionBridge(routePort);}
  }
  static void basicPolicy(){
    NativeProtectionState state=new NativeProtectionState();check("Unrequested strong protection denies admission",!state.allows(2));
    check("Standard and compatibility preserve their original admission semantics",state.allows(0)&&state.allows(1));
    state.begin(2);long token=state.request(),generation=state.generation();
    check("Pending setting denies strong admission",!state.allows(2)&&state.state().equals("pending"));
    check("Missing acknowledgment cannot confirm a true setting",state.receive(token,generation,2,false,true,"setting-error")&&!state.confirmed()&&!state.allows(2));
    state.awaitingRetry();long second=state.request();check("Each retry has a new correlated token",second>token);
    check("Old attempt reply is rejected",!state.receive(token,generation,2,true,true,"")&&!state.allows(2));
    check("Wrong level reply is rejected",!state.receive(second,generation,1,true,true,"")&&!state.allows(2));
    check("Wrong generation reply is rejected",!state.receive(second,generation-1,2,true,true,"")&&!state.allows(2));
    check("Exact true readback confirms strong protection",state.receive(second,generation,2,true,true,"")&&state.confirmed()&&state.allows(2));
    check("Duplicate callback cannot change a settled result",!state.receive(second,generation,2,false,false,"setting-error")&&state.confirmed());
    check("Observed setting change invalidates confirmation",state.changed(second,generation,2)&&!state.allows(2));
    state.begin(2);long retry=state.request();check("Manual same-level cycle has a new generation",state.generation()>generation&&retry>second);
    state.disconnected();check("Disconnection invalidates pending and confirmed admission",!state.allows(2)&&!state.receive(retry,state.generation()-1,2,true,true,"")&&!state.received());
    state.begin(1);long standard=state.request();check("Standard false setting must have an exact readback to be confirmed",state.receive(standard,state.generation(),1,true,false,"")&&state.confirmed()&&state.allows(1)&&!state.allows(2));
    state.begin(2);long mismatch=state.request();check("Acknowledged false setting cannot confirm strong protection",state.receive(mismatch,state.generation(),2,true,false,"")&&!state.allows(2));
    state.begin(9);check("Invalid requested levels fail closed without throwing",state.state().equals("failed")&&!state.allows(9)&&!state.allows(-1)&&!state.canRetry());
    state.begin(2);state.request();state.closed();check("Closed state cannot grant admission or automatic retries",!state.allows(2)&&!state.canRetry());
    check("Reason text cannot carry arbitrary bridge error details",NativeProtectionState.safeReason("secret://unsafe detail","setting-failed").equals("setting-failed"));
  }
  static void controller(){
    View view=new View();view.start(2);JSONObject first=view.routePort.last();
    check("Controller sends generation and finite attempt timeout",first.optLong("generation",0)>0&&first.optLong("timeoutMs",0)==8000&&view.nativeProtection.attempt()==1);
    check("Native route remains closed before confirmation",view.route("https://target.invalid/").optInt("port")==9);
    view.receive(J.obj("kind","ready"),view.routePort);check("Cookie readiness cannot open strong bootstrap",view.opens==0);
    view.reply(false,true);check("Failed acknowledgment schedules a bounded retry and stays closed",view.protectionRetry!=null&&!view.privacyReady&&!view.metadata.rfpAcknowledged&&view.route("https://target.invalid/").optInt("port")==9);
    view.owner.handler.advance(499);check("Retry respects its backoff",view.routePort.sent.size()==1);view.owner.handler.advance(1);
    check("Second request replaces the timed out token",view.routePort.sent.size()==2&&view.protectionRequest>first.optLong("token",0));
    view.receive(J.obj("kind","protectionReady","token",first.get("token"),"generation",first.get("generation"),"level",2,"acknowledged",true,"fingerprinting",true),view.routePort);
    check("Late prior successful reply cannot open the browser",view.opens==0&&!view.privacyReady);
    view.reply(true,true);check("Correlated true readback opens bootstrap once",view.opens==1&&view.privacyReady&&view.fingerprintingProtected&&view.metadata.rfpAcknowledged);
    check("Confirmed strong protection admits the existing guard route",view.route("https://target.invalid/").optString("type").equals("direct"));
    check("A confirmed result retires every retry and timeout task",view.owner.handler.tasks.isEmpty());
    check("No queued navigation means confirmation does not reload the page",view.loadCount()==0&&view.restoreCount()==0);
    check("Manual retry cannot reset a confirmed or pending attempt",!view.retryProtection());
    View changedConfig=new View();changedConfig.start(1);changedConfig.reply(true,false);changedConfig.owner.privacy.value=2;
    check("A prior confirmed mode cannot be displayed as the new desired mode",changedConfig.protectionStatus().optString("state").equals("pending")&&!changedConfig.protectionStatus().optBoolean("settingsReadbackConfirmed"));
    check("A changed desired level is denied and described without a false confirmed label",!changedConfig.protectionAllowsNetwork()&&!changedConfig.protectionSummary().contains("已确认"));
    check("User retry can rebind a changed desired level",changedConfig.retryProtection()&&changedConfig.requestedProtection==2&&!changedConfig.protectionAllowsNetwork());
    JSONObject valid=view.routePort.last();view.receive(J.obj("kind","protectionChanged","token",valid.get("token"),"generation",valid.get("generation"),"level",2),view.routePort);
    check("Current native setting change immediately closes new requests",!view.privacyReady&&view.route("https://target.invalid/").optInt("port")==9);

    View timeout=new View();timeout.start(2);timeout.owner.handler.advance(25000);
    check("A hung API exhausts exactly three attempts",timeout.routePort.sent.size()==3&&timeout.nativeProtection.attempt()==3&&timeout.nativeProtection.state().equals("failed"));
    check("Exhausted retries have no live timer and no route",timeout.owner.handler.tasks.isEmpty()&&timeout.route("https://target.invalid/").optInt("port")==9);
    long generation=timeout.nativeProtection.generation();check("User retry begins a fresh same-level generation",timeout.retryProtection()&&timeout.nativeProtection.generation()>generation&&timeout.nativeProtection.attempt()==1);
    check("Repeated user taps cannot multiply active pending requests",!timeout.retryProtection()&&timeout.routePort.sent.size()==4);
    JSONObject previous=timeout.routePort.last();timeout.start(1);check("An explicit standard selection retires strong retry work",timeout.owner.handler.tasks.size()==1&&timeout.requestedProtection==1);
    timeout.receive(J.obj("kind","protectionReady","token",previous.get("token"),"generation",previous.get("generation"),"level",2,"acknowledged",true,"fingerprinting",true),timeout.routePort);
    check("An old strong reply cannot masquerade as the user's standard selection",!timeout.privacyReady&&!timeout.metadata.rfpAcknowledged);
    timeout.owner.handler.advance(8000);check("Unavailable standard readback keeps legacy navigation but no false confirmation",timeout.privacyReady&&!timeout.metadata.rfpAcknowledged&&timeout.route("https://target.invalid/").optString("type").equals("direct"));
    View cookieBarrier=new View();cookieBarrier.routePrepared=true;cookieBarrier.start(1);cookieBarrier.owner.handler.advance(8000);
    check("A replacement bridge cannot reuse prior cookie readiness after a setting timeout",!cookieBarrier.routePrepared&&cookieBarrier.opens==0);
    cookieBarrier.receive(J.obj("kind","cookiePrepared"),cookieBarrier.routePort);
    check("Standard bootstrap opens only after this bridge's real cookie barrier",cookieBarrier.opens==1);
    for(String field:Arrays.asList("token","generation","level","acknowledged","fingerprinting")){
      View malformed=new View();malformed.start(2);JSONObject request=malformed.routePort.last();
      JSONObject receipt=J.obj("kind","protectionReady","token",request.get("token"),"generation",request.get("generation"),"level",2,"acknowledged",true,"fingerprinting",true);
      receipt.put(field,String.valueOf(receipt.get(field)));malformed.receive(receipt,malformed.routePort);
      check("String-typed "+field+" cannot confirm strict protection",!malformed.privacyReady&&!malformed.metadata.rfpAcknowledged&&!malformed.protectionAllowsNetwork());
    }
    View fractional=new View();fractional.start(2);JSONObject fractionRequest=fractional.routePort.last();
    fractional.receive(J.obj("kind","protectionReady","token",fractionRequest.optLong("token",0)+.5,"generation",fractionRequest.get("generation"),"level",2,"acknowledged",true,"fingerprinting",true),fractional.routePort);
    check("Fractional counters cannot be truncated into a valid acknowledgment",!fractional.privacyReady);

    View disconnected=new View();disconnected.start(2);WebExtension.Port old=disconnected.routePort;JSONObject oldRequest=old.last();disconnected.disconnected(old);
    check("Current bridge disconnect retires timers and closes strong admission",disconnected.routePort==null&&disconnected.owner.handler.tasks.isEmpty()&&!disconnected.protectionAllowsNetwork());
    disconnected.routePort=new WebExtension.Port();disconnected.prepareProtectionBridge(disconnected.routePort);
    disconnected.receive(J.obj("kind","protectionReady","token",oldRequest.get("token"),"generation",oldRequest.get("generation"),"level",2,"acknowledged",true,"fingerprinting",true),old);
    check("Old port reply cannot confirm a reconnected bridge",!disconnected.privacyReady);
    long activeToken=disconnected.protectionRequest;disconnected.disconnected(old);
    check("Late old port disconnect does not invalidate its replacement",disconnected.routePort!=null&&disconnected.protectionRequest==activeToken);
    disconnected.reply(true,true);check("Replacement bridge can confirm normally",disconnected.protectionAllowsNetwork());
    disconnected.owner.guard.usable=false;check("RFP confirmation never bypasses the independent network guard",disconnected.route("https://target.invalid/").optInt("port")==9);

    View sending=new View();sending.routePort.throwing=true;sending.start(2);sending.owner.handler.advance(1500);
    check("Synchronous send failure is contained and bounded",sending.nativeProtection.attempt()==3&&sending.owner.handler.tasks.isEmpty()&&!sending.protectionAllowsNetwork());
    View live=new View();live.ready=true;live.current=new GeckoSession();live.start(2);live.queued="https://target.invalid/chosen";live.reply(true,true);
    check("Only an explicitly queued navigation is resumed once",live.loadCount()==1&&live.lastLoad().equals("https://target.invalid/chosen"));
    View restoring=new View();restoring.ready=true;restoring.current=new GeckoSession();restoring.start(2);restoring.protectionRestore=new View.ProtectionRestore(restoring.current,new GeckoSession.SessionState("https://target.invalid/history"),"https://target.invalid/history",4,restoring.owner.navigationEpoch);restoring.reply(true,true);
    check("A deferred matching checkpoint resumes without replacing history by a fresh load",restoring.restoreCount()==1&&restoring.loadCount()==0);
    View replaced=new View();replaced.ready=true;replaced.current=new GeckoSession();replaced.start(2);replaced.protectionRestore=new View.ProtectionRestore(replaced.current,new GeckoSession.SessionState(),"https://target.invalid/old",4,0);replaced.owner.navigationEpoch=1;replaced.queued="https://target.invalid/new";replaced.reply(true,true);
    check("Old restore ownership never overrides a newer navigation",replaced.restoreCount()==0&&replaced.loadCount()==1&&replaced.lastLoad().equals("https://target.invalid/new"));
  }
  static View blockedBootstrap(){View v=new View();v.start(2);v.owner.handler.advance(25000);return v;}
  static void bootstrap(){
    check("Only a never-opened failed strong bootstrap is eligible for explicit recovery",blockedBootstrap().protectionBootstrapBlocked());
    for(String guard:Arrays.asList("ready","destroyed","failed","surface","current","primary","locations","popups","standard","pending","different-level")){
      View v=blockedBootstrap();
      switch(guard){case "ready":v.ready=true;break;case "destroyed":v.destroyed=true;break;case "failed":v.failed=true;break;case "surface":v.surface=new Object();break;case "current":v.current=new GeckoSession();break;case "primary":v.primary=new GeckoSession();break;case "locations":v.locations.put(new GeckoSession(),"");break;case "popups":v.popups.add(new GeckoSession());break;case "standard":v.owner.privacy.value=1;break;case "pending":v.retryProtection();break;case "different-level":v.owner.privacy.value=3;break;}
      check("Bootstrap recovery rejects "+guard,!v.protectionBootstrapBlocked());
    }
  }
  static View browsing(){View v=new View();v.ready=true;v.current=v.primary=new GeckoSession();v.start(1);v.reply(true,false);return v;}
  static void identityAdmission(){
    String nonce="aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa",base="https://detector.invalid/pocketchat-identity/v1/",document=base+"document?nonce="+nonce;
    View cold=browsing();cold.queued="https://target.invalid/retained";GeckoSession.SessionState checkpoint=new GeckoSession.SessionState(document);cold.startupState=checkpoint;
    check("Cold diagnostic URLs cannot receive a route without an active scope",cold.route(document).optInt("port")==9);
    cold.loadUrl(document);check("Rejected cold diagnostic navigation is never added to the queue",cold.queued.equals("https://target.invalid/retained")&&cold.loadCount()==0&&cold.startupState==checkpoint);
    check("Cold diagnostic load requests are denied by the real navigation delegate",cold.navigation(cold.current,new LoadRequest(document)).value==AllowOrDeny.DENY);
    check("A popup cannot reopen an old diagnostic nonce",cold.popup(cold.current,document).value==null&&cold.popups.isEmpty());
    cold.restoreCheckpoint(cold.current,checkpoint,document,4);check("Cold checkpoint restore cannot hydrate an old diagnostic document",cold.restoreCount()==0&&cold.protectionRestore==null);
    cold.owner.audit=null;check("Missing audit ownership is a closed diagnostic scope",cold.route(document).optInt("port")==9);
    check("Ordinary HTTPS URLs keep their existing guard route",cold.route("https://target.invalid/chat").optString("type").equals("direct"));
    cold.loadUrl("https://target.invalid/chat");check("Ordinary HTTPS navigation is still delivered to the SDK",cold.loadCount()==1&&cold.lastLoad().equals("https://target.invalid/chat"));
    check("About-blank remains local and does not require a diagnostic scope",cold.navigation(cold.current,new LoadRequest("about:blank")).value==AllowOrDeny.ALLOW);

    View active=browsing();active.owner.audit.active=true;
    check("An active exact diagnostic document receives the selected existing route",active.route(document).optString("type").equals("direct"));
    check("The current scoped document passes the real navigation delegate",active.navigation(active.current,new LoadRequest(document)).value==AllowOrDeny.ALLOW);
    active.loadUrl(document);check("Only current scoped diagnostic loads reach the SDK",active.loadCount()==1&&active.lastLoad().equals(document));
    check("The current Dedicated Worker script and observation request are admitted",active.route(base+"worker.js?nonce="+nonce).optString("type").equals("direct")&&active.route(base+"observe?nonce="+nonce+"&source=worker").optString("type").equals("direct"));
    for(String variant:Arrays.asList(document.replace(nonce,"bbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbb"),document.replace("detector.invalid","other.invalid"),document.replace("detector.invalid","detector.invalid:8443"),document+"&extra=1"))
      check("Changed endpoint nonce or query is never part of the admitted scope "+variant,active.route(variant).optInt("port")==9);
    for(String field:Arrays.asList("active","registered","fresh","deadline")){
      View expired=browsing();expired.owner.audit.active=true;
      switch(field){case "active":expired.owner.audit.active=false;break;case "registered":expired.owner.audit.registered=false;break;case "fresh":expired.owner.audit.fresh=false;break;case "deadline":expired.owner.audit.now=10001;break;}
      check("A diagnostic request is blocked after "+field+" becomes invalid",expired.route(document).optInt("port")==9&&expired.navigation(expired.current,new LoadRequest(document)).value==AllowOrDeny.DENY);
    }
    for(String path:Arrays.asList("/%70ocketchat-identity/v1/document","/POCKETCHAT-IDENTITY/v1/document","//pocketchat-identity/v1/document","/other/../pocketchat-identity/v1/document")){
      String encoded="https://detector.invalid"+path+"?nonce="+nonce;
      check("Encoded or normalized diagnostic namespace cannot fall through as ordinary traffic "+path,active.route(encoded).optInt("port")==9&&active.navigation(active.current,new LoadRequest(encoded)).value==AllowOrDeny.DENY);
    }
    View pending=browsing();pending.owner.audit.active=true;pending.start(2);pending.loadUrl(document);
    check("Unconfirmed RFP can retain only the currently authorized diagnostic target",pending.queued.equals(document)&&pending.loadCount()==0);
    pending.owner.audit.active=false;pending.reply(true,true);
    check("A cancelled diagnostic target is not opened when RFP later confirms",pending.queued.isEmpty()&&pending.loadCount()==0);
    View staleRestore=browsing();staleRestore.owner.audit.active=true;staleRestore.start(2);staleRestore.protectionRestore=new View.ProtectionRestore(staleRestore.current,checkpoint,document,4,0);staleRestore.owner.audit.active=false;staleRestore.reply(true,true);
    check("A cancelled diagnostic checkpoint cannot resume after RFP confirmation",staleRestore.restoreCount()==0&&staleRestore.loadCount()==0);
  }
  public static void main(String[] args){
    basicPolicy();controller();bootstrap();identityAdmission();
    StringBuilder out=new StringBuilder("{\"status\":\"passed\",\"passed\":").append(checks.size()).append(",\"checks\":[");
    for(int i=0;i<checks.size();i++){if(i>0)out.append(',');out.append("{\"name\":").append(quote(checks.get(i))).append(",\"pass\":true}");}
    System.out.println(out.append("],\"actualAndroidExecution\":false,\"actualGeckoExecution\":false}"));
  }
}

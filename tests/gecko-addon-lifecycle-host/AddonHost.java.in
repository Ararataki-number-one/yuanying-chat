package local.pocketchat;
import java.util.*;import java.util.function.*;import java.util.concurrent.Executor;import org.json.*;
public final class AddonHost {
 static final String SITE="https://example.test/owned";static final List<String> checks=new ArrayList<>();
 static void check(String name,boolean value){if(!value)throw new AssertionError(name);checks.add(name);}
 static WebExtension extension(String id,boolean builtin,Boolean enabled){return new WebExtension(id,builtin,enabled==null?null:new WebExtension.MetaData(enabled));}
 static WebExtension enabled(){return extension("browser@pocketchat.local",true,true);}static WebExtension disabled(){return extension("browser@pocketchat.local",true,false);}
 static View disabledView(){View v=new View();v.addonStateChanged(v.runtime,disabled(),true);v.owner.finishes=0;return v;}
 static void authority(){
  for(String wrong:new String[]{"runtime","id","builtin","metadata","enabled","destroyed","null"}){
   View v=new View();WebExtension value=disabled();GeckoRuntime expected=v.runtime;if(wrong.equals("runtime"))expected=new GeckoRuntime();if(wrong.equals("id"))value=extension("foreign",true,false);if(wrong.equals("builtin"))value=extension("browser@pocketchat.local",false,false);if(wrong.equals("metadata"))value=extension("browser@pocketchat.local",true,null);if(wrong.equals("enabled"))value=enabled();if(wrong.equals("destroyed"))v.destroyed=true;if(wrong.equals("null"))value=null;
   v.addonStateChanged(expected,value,true);check("Foreign or retired authority cannot disable current builtin: "+wrong,!v.addonDisabled&&v.addonStateSerial==0&&v.extension.metaData.enabled);
  }
  View v=new View();WebExtension old=v.extension,off=disabled();v.owner.navigating=true;v.queued=SITE;WebExtension.Port port=v.routePort;GeckoSession second=new GeckoSession();v.locations.put(second,"about:blank");v.timeZoneLoads.put(v.current,SITE);v.generalRestore=new View.ProtectionRestore(v.current,new GeckoSession.SessionState(),SITE,0,0);v.protectionRestore=v.generalRestore;v.startupState=new GeckoSession.SessionState();v.addonStateChanged(v.runtime,off,true);
  check("Disabled authority installs its exact fresh immutable snapshot",v.extension==off&&!v.extension.metaData.enabled&&old.metaData.enabled&&v.addonDisabled&&v.addonStateSerial==1);
  check("Disabled authority ends pending navigation with an explicit error",v.owner.finishes==1&&v.owner.navigationFailed&&!v.owner.navigating&&!v.owner.lastRetry&&v.owner.pageError.contains("停用")&&v.queued.isEmpty());
  check("Terminal addon state does not mark the runtime permanently failed",!v.failed&&v.current.isOpen());
  check("Retired bridge policy cannot retain old readiness",v.routePort==null&&!v.requestHeadersInstalled&&!v.routePrepared&&!v.privacyReady&&!v.fingerprintingProtected&&!v.metadata.policyAcknowledged&&!v.metadata.rfpAcknowledged&&!v.nativeProtection.confirmed());
  check("Disabled authority retires prepared work and checkpoint references",v.timeZoneRetirements==1&&v.headerRetirements==1&&v.routeReleases==1&&v.deferredGeneralLoads.isEmpty()&&v.generalRestore==null&&v.protectionRestore==null&&v.startupState==null);
  check("Disabled authority stops native sessions without dispatching a new load",v.current.stops==1&&second.stops==1&&v.current.loads==0&&second.loads==0&&v.current.restores==0&&port.disconnected==1&&v.cookieCallbacks.cancelled.contains(port));
  v.acceptBuiltinAddon(v.runtime,old,0);check("Late initial ensure result cannot resurrect a disabled epoch",v.addonDisabled&&v.extension==off&&v.addonStateSerial==1);
  v.applyAddonState(v.runtime,old,false,0);check("A stale event commit cannot replace a newer immutable snapshot",v.addonDisabled&&v.extension==off);
 }
 static void entries(){
  for(String path:new String[]{"loadUrl","loadSessionUri","restoreCheckpoint","onLoadRequest"}){
   View v=disabledView();v.timeZoneLoads.put(v.current,SITE);v.timeZoneIntents.put(v.current,new Object());v.nativeTimeZoneIntents.put(v.current,new Object());v.deferredGeneralLoads.put(v.current,SITE);
   if(path.equals("loadUrl"))v.loadUrl(SITE);if(path.equals("loadSessionUri"))v.loadSessionUri(v.current,SITE);if(path.equals("restoreCheckpoint"))v.restoreCheckpoint(v.current,new GeckoSession.SessionState(),SITE,7);if(path.equals("onLoadRequest")){GeckoResult<AllowOrDeny> result=v.onLoadRequest(v.current,new LoadRequest(SITE));check("Direct native load request is denied before SDK admission",result.value==AllowOrDeny.DENY);}
   check("Disabled "+path+" clears pending intent without SDK network or checkpoint dispatch",v.current.loads==0&&v.current.restores==0&&v.queued.isEmpty()&&v.timeZoneLoads.isEmpty()&&v.timeZoneIntents.isEmpty()&&v.nativeTimeZoneIntents.isEmpty()&&v.deferredGeneralLoads.isEmpty());
   check("Disabled "+path+" reports explicit failed navigation rather than success",v.owner.finishes==1&&v.owner.navigationFailed&&!v.owner.lastRetry&&v.owner.pageError.contains("停用"));
  }
  View v=disabledView();GeckoSession second=new GeckoSession();v.locations.put(second,"secondary");v.queued="current retained target";v.timeZoneLoads.put(second,SITE);check("Secondary disabled navigation is rejected",v.rejectDisabledNavigation(second,SITE));check("Secondary rejection cannot falsely finish the selected document",v.owner.finishes==0&&v.queued.equals("current retained target")&&v.timeZoneLoads.isEmpty());
  View popup=disabledView();GeckoResult<GeckoSession> result=popup.onNewSession(popup.current,SITE);check("Disabled addon cannot allocate or return a popup",result.value==null&&popup.newSessions==0&&popup.popups.isEmpty());
  View gate=new View();gate.addonDisabled=true;gate.ready=false;gate.testMaybeOpen();check("Disabled terminal flag cannot bypass the blank-session open gate",gate.opens==0);
 }
 static void enable(){
  View v=disabledView();WebExtension fresh=enabled();long serial=v.addonStateSerial;v.addonStateChanged(v.runtime,fresh,false);
  check("Enabled authority updates only its exact native snapshot and terminal epoch",!v.addonDisabled&&v.extension==fresh&&v.addonStateSerial==serial+1&&!v.failed&&fresh.bindings==1&&fresh.delegate==v.routeMessages&&fresh.host.equals("pocketroute"));
  check("Enable cannot forge retired header privacy timezone or route completion",!v.requestHeadersInstalled&&!v.routePrepared&&!v.privacyReady&&!v.metadata.policyAcknowledged&&!v.metadata.rfpAcknowledged&&!v.timeZonePermitted&&v.routePort==null&&!v.nativeProtection.confirmed());
  v.loadUrl(SITE);check("Enabled addon still waits for a new real protection handshake",v.current.loads==0&&v.owner.finishes==0);
  v.privacyReady=v.routePrepared=v.requestHeadersInstalled=true;v.routePort=new WebExtension.Port();v.timeZonePermitted=true;v.nativeProtection.begin(1);long token=v.nativeProtection.request();v.nativeProtection.receive(token,v.nativeProtection.generation(),1,true,false,"");v.loadUrl(SITE);
  check("Declared fresh-handshake boundary permits a later real method dispatch",v.current.loads==1&&v.queued.isEmpty());check("Dispatch never invents a document completion",v.owner.finishes==0);
  View disconnect=new View();WebExtension.Port old=disconnect.routePort;disconnect.onDisconnect(old);check("Transient native port disconnect is not authoritative addon disable",!disconnect.addonDisabled&&disconnect.addonStateSerial==0&&disconnect.owner.finishes==0&&!disconnect.failed&&disconnect.extension.metaData.enabled);
  View restored=disabledView();WebExtension.Port retired=new WebExtension.Port();restored.addonStateChanged(restored.runtime,enabled(),false);restored.routePort=new WebExtension.Port();restored.requestHeadersInstalled=restored.privacyReady=restored.routePrepared=true;restored.onDisconnect(retired);check("Retired port callback cannot erase a newer enabled bridge",restored.routePort!=null&&restored.requestHeadersInstalled&&restored.privacyReady&&restored.routePrepared&&!restored.addonDisabled);
 }
 static void progress(){
  View stop=disabledView();stop.rejectDisabledNavigation(stop.current,SITE);stop.url=SITE;stop.loadingTargets.put(stop.current,SITE);stop.onPageStop(stop.current,true);
  check("Late successful native page-stop cannot clear terminal navigation failure",stop.owner.navigationFailed&&stop.client.finished==0&&!stop.owner.navigating);
  View visible=disabledView();visible.url=SITE;visible.loadingTargets.put(visible.current,SITE);visible.testPageVisible(visible.current);check("Late content visibility cannot publish a disabled document",visible.client.committed==0&&visible.painted.isEmpty());
  View start=disabledView();start.onPageStart(start.current,SITE);check("Late page-start cannot create new disabled document work",start.pendingLoads.isEmpty()&&start.appearanceLoads.isEmpty());
  View location=disabledView();location.pendingLoads.add(location.current);location.onLocationChange(location.current,SITE,Collections.emptyList(),false);check("Late location commit cannot restart the spinner or timezone work",location.client.started==0&&!location.owner.navigating&&location.revalidations==0&&location.locations.get(location.current).equals("about:blank"));
  View ordinary=new View();ordinary.onPageStart(ordinary.current,SITE);ordinary.onLocationChange(ordinary.current,SITE,Collections.emptyList(),false);ordinary.onPageStop(ordinary.current,true);check("Enabled native document still publishes normal start visible and finish callbacks",ordinary.client.started==1&&ordinary.client.committed==1&&ordinary.client.finished==1&&!ordinary.owner.navigationFailed&&!ordinary.owner.navigating);
 }
 static void audit(){View v=new View();v.owner.audit.consume=true;GeckoResult<String> result=v.nativeNavigationFailure(v.current,SITE,"failure");check("Existing request-audit branch retains its own failure handling",result!=null&&result.value==null&&v.owner.finishes==0&&v.owner.audit.calls==1);v.owner.audit.consume=false;v.nativeNavigationFailure(v.current,"about:blank","failure");check("Blank bootstrap cannot be mislabeled as a failed website",v.owner.finishes==0);v.nativeNavigationFailure(new GeckoSession(),SITE,"failure");check("Foreign native session cannot finish the selected navigation",v.owner.finishes==0);v.destroyed=true;v.nativeNavigationFailure(v.current,SITE,"failure");check("Retired view cannot publish a late navigation failure",v.owner.finishes==0);}
 public static void main(String[] args){String focus=args.length==0?"all":args[0];if(focus.equals("all")||focus.equals("authority"))authority();if(focus.equals("all")||focus.equals("entries"))entries();if(focus.equals("all")||focus.equals("enable"))enable();if(focus.equals("all")||focus.equals("progress"))progress();if(focus.equals("all")||focus.equals("audit"))audit();System.out.println(J.obj("status","passed","passed",checks.size(),"total",checks.size(),"checks",new JSONArray(checks)));}
}
class View {
 @@MEMBERS@@
 final Owner owner=new Owner();GeckoRuntime runtime=new GeckoRuntime();WebExtension extension=AddonHost.enabled();GeckoSession current=new GeckoSession(),primary=current;
 boolean destroyed,failed,addonDisabled,enabled=true,ready=true,checkpointReady=true,identityPrepared=true,requestHeadersInstalled=true,privacyReady=true,routePrepared=true,fingerprintingProtected=true,timeZonePermitted=true;long addonStateSerial,protectionRequest,startupDraftRevision;String queued="",url="";int opens,newSessions,timeZoneRetirements,headerRetirements,routeReleases;
 void testMaybeOpen(){maybeOpen();}void testPageVisible(GeckoSession s){pageVisible(s);}
 final Client client=new Client(owner);final Set<GeckoSession> pendingLoads=new HashSet<>(),painted=new HashSet<>(),usable=new HashSet<>();final Map<GeckoSession,String> loadingTargets=new IdentityHashMap<>();final Map<GeckoSession,Long> appearanceLoads=new IdentityHashMap<>();final Map<GeckoSession,Float> pageScales=new IdentityHashMap<>(),viewportWidths=new IdentityHashMap<>();final Map<GeckoSession,WebExtension.Port> ports=new IdentityHashMap<>();long appearanceLoadSerial;int revalidations;String cookieStamp="";
 void appearanceCommitted(GeckoSession s){}void revalidateTimeZone(GeckoSession s){revalidations++;}void appearance(WebExtension.Port port){}void forgetGeneralRoute(GeckoSession s){}void cancelZoom(){}void readCookies(String site,Consumer<String> done){throw new AssertionError("Unexpected cookie SDK boundary");}
 final NativeProtectionState nativeProtection=new NativeProtectionState();final Metadata metadata=new Metadata();final Object routeMessages=new Object();WebExtension.Port routePort=new WebExtension.Port();final Cookies cookieCallbacks=new Cookies();
 final Map<GeckoSession,String> locations=new IdentityHashMap<>(),timeZoneLoads=new IdentityHashMap<>(),deferredGeneralLoads=new IdentityHashMap<>();final Map<GeckoSession,Object> timeZoneIntents=new IdentityHashMap<>(),nativeTimeZoneIntents=new IdentityHashMap<>();final Map<GeckoSession,TimeZoneGate> timeZoneGates=new IdentityHashMap<>();final Map<GeckoSession,GeckoSession.SessionState> states=new IdentityHashMap<>();final Map<GeckoSession,Long> stateDraftRevisions=new IdentityHashMap<>();
 final Set<GeckoSession> crashed=new HashSet<>(),generalSessions=new HashSet<>();final List<GeckoSession> popups=new ArrayList<>();final Map<GeckoSession,ChromiumRouteLease.Handle> generalRoutes=new IdentityHashMap<>();ProtectionRestore generalRestore,protectionRestore;GeckoSession.SessionState startupState;final Store sessionStore=new Store();
 View(){locations.put(current,"about:blank");nativeProtection.begin(1);long token=nativeProtection.request();nativeProtection.receive(token,nativeProtection.generation(),1,true,false,"");}
 void open(){opens++;ready=true;}void closeExitIpPage(){}void cancelProtectionTasks(){}void retireTimeZones(){timeZoneRetirements++;timeZonePermitted=false;timeZoneLoads.clear();timeZoneIntents.clear();nativeTimeZoneIntents.clear();}void retireRequestHeaderPolicy(){headerRetirements++;}void releaseGeneralRoutes(){routeReleases++;generalRoutes.clear();}
 boolean identityRequestAllowed(String target){return true;}boolean allowedUrl(String target){return target!=null&&target.startsWith("https:");}boolean timeZoneSessionAlive(GeckoSession session){return session!=null&&session.isOpen()&&locations.containsKey(session);}boolean timeZoneAllows(GeckoSession session){return timeZonePermitted;}void prepareTimeZone(GeckoSession s,Consumer<Boolean> ready){throw new AssertionError("Unexpected modeled native preparation");}
 boolean retainGeneralRoute(GeckoSession s,String target){return true;}boolean generalRouteReady(){return true;}boolean reopenCurrent(){return true;}Object claimTimeZoneIntent(GeckoSession s,boolean restore){Object value=new Object();timeZoneIntents.put(s,value);return value;}void clearTimeZoneIntent(GeckoSession s,Object value){timeZoneIntents.remove(s);}boolean hasTimeZoneIntent(GeckoSession s){return timeZoneIntents.containsKey(s);}String protectionSummary(){return "protection boundary";}GeckoSession newSession(){newSessions++;return new GeckoSession();}void activate(GeckoSession s){current=s;}
 static final class TimeZoneGate {long documentSerial;}
 static final class ProtectionRestore {final GeckoSession session;final GeckoSession.SessionState state;final String url;final long draftRevision,navigation;ProtectionRestore(GeckoSession s,GeckoSession.SessionState state,String url,long revision,long epoch){this.session=s;this.state=state;this.url=url;draftRevision=revision;navigation=epoch;}}
}
class GeckoRuntime {}
class GeckoSession {interface PermissionDelegate{class ContentPermission {}}int loads,restores,stops;boolean open=true;boolean isOpen(){return open;}void stop(){stops++;}void loadUri(String url){loads++;}void restoreState(SessionState value){restores++;}static class SessionState {static SessionState fromString(String value){return new SessionState();}int size(){return 1;}int getCurrentIndex(){return 0;}Item get(int index){return new Item();}}static class Item{String getUri(){return AddonHost.SITE;}}}
class WebExtension {final String id;final boolean isBuiltIn;final MetaData metaData;int bindings;Object delegate;String host;WebExtension(String id,boolean builtin,MetaData data){this.id=id;isBuiltIn=builtin;metaData=data;}void setMessageDelegate(Object delegate,String host){bindings++;this.delegate=delegate;this.host=host;}static class MetaData{final boolean enabled;final int disabledFlags;MetaData(boolean enabled){this.enabled=enabled;disabledFlags=enabled?0:2;}}static class Port {int disconnected;void disconnect(){disconnected++;}}}
class Metadata {boolean policyAcknowledged=true,rfpAcknowledged=true;}
class Owner {boolean deleted,navigating,navigationFailed,lastRetry;int finishes,changes;long navigationEpoch;String navigationTarget=AddonHost.SITE,pageError="",status="";Object context=new Object();final Audit audit=new Audit();final Privacy privacy=new Privacy();final Guard guard=new Guard();final TimeZone timeZone=new TimeZone();final Queue handler=new Queue();final Prefs prefs=new Prefs();int remembered;void rememberBrowserLocation(String target){remembered++;}void finishNavigation(String message,boolean retry){finishes++;navigating=false;navigationFailed=!message.isEmpty();lastRetry=retry;}void setStatus(String value){status=value;}void changed(){changes++;}}
class Audit {boolean consume;int calls;boolean identityPageFailed(String target,String message){calls++;return consume;}}
class Privacy{int level(){return 1;}}class Guard{boolean allowed(){return true;}}class TimeZone{boolean popupAllowed(){return true;}}
class Queue {final List<Runnable> tasks=new ArrayList<>();void post(Runnable task){tasks.add(task);}}
class Cookies {final List<WebExtension.Port> cancelled=new ArrayList<>();void cancel(WebExtension.Port port){cancelled.add(port);}}
class Store {final Executor io=task->{throw new AssertionError("Unexpected checkpoint writer dispatch");};}
class LocalDraftPolicy {static boolean enabled(Object context){return true;}static long revision(Object context){return 7;}static String checkpoint(String value,boolean draft){return value;}}
class MainActivity {static final String ORIGIN="https://chatgpt.com";static boolean chatUrl(String target){return false;}}
class GeckoNavigationPolicy {static boolean publicWeb(String target){return target!=null&&target.startsWith("https:");}}
class ChromiumRouteLease {static final class Handle{void close(){}}static Handle acquireSurface(){return new Handle();}}
class GeckoResult<T> {final T value;GeckoResult(T value){this.value=value;}static <T>GeckoResult<T> fromValue(T value){return new GeckoResult<>(value);}}
enum AllowOrDeny {ALLOW,DENY}
class LoadRequest {final String uri;LoadRequest(String uri){this.uri=uri;}}

class Client {final Owner owner;int started,committed,finished;Client(Owner owner){this.owner=owner;}void onPageStarted(Object view,String target,Object icon){started++;owner.navigating=true;}void onPageCommitVisible(Object view,String target){committed++;}void onPageFinished(Object view,String target){finished++;owner.navigationFailed=false;owner.navigating=false;}}
class Prefs {Prefs edit(){return this;}Prefs putString(String name,String value){return this;}void apply(){}}
class LoginPagePolicy {static boolean login(String target){return false;}}
class NativeNetwork {static String hash(String value){return value;}}

package local.pocketchat;
import org.json.*;import java.util.*;import java.util.function.Consumer;

/** Exact ChatSession methods. All scheduler/browser/proof boundaries below are doubles. */
public final class GuardHost {
 @PRODUCTION_MEMBERS@
 Object resourceObserverPort;
 final Object context=new Object();final Handler handler=new Handler();final Web web=new Web();final Guard guard=new Guard();final Prefs prefs=new Prefs();final Observer webObserver=new Observer();
 final Map<String,Consumer<TaskGuardSnapshot>> taskGuardRequests=new HashMap<>();
 JSONObject pending,state=new JSONObject();JSONArray attachments=new JSONArray();
 int environmentGeneration=1,resourceChoosers,resourceFilePreparations,recoveryAttempt=3;String environmentId="10000000-0000-4000-8000-000000000002",resourceObserverBinding="",resourceObserverDocument="",resourceObserverUrl="",connectionStage="",networkIssue="old",appliedIdentity="",status="";
 boolean deleted,resourceWebsiteBusy,resourceWebsiteUploading,uiVisible,submitting,operation,transferActive,inFlight,networkReady=true,connecting,recoveryScheduled=true,manualAttention=true,offline;
 long resourceWebsiteEpoch=-1,resourceObserverEpoch=-1,resourceObserverSequence,resourceObservedAt,resourceInspectionGeneration,webWorkGeneration,fileWorkGeneration,operationGeneration,navigationEpoch=7,stateEpoch=-1,connectionEpoch=11,recoveryToken,syncRun;
 final Uploads resourceUploads=new Uploads();int activityUpdates,taskTicks;final Runnable tick=()->taskTicks++;
 interface Result{void accept(JSONObject value);}
 // Explicit native activity-policy boundary: production wakePolling/evaluateDriver are
 // tested separately, while this hook records requests without simulating Gecko life.
 void updateBrowserActivity(){activityUpdates++;}
 boolean internalNetwork(){return "internal".equals(prefs.getString("networkMode","external"));}
 String networkIdentity(){return "current-owned-network";}
 void setStatus(String value){status=value;}
 int identityAcknowledgments;boolean acknowledgmentAfterAdmission;
 // The real identity controller is an explicit acknowledgment boundary, not a
 // host model writer. Record only call ordering; never change task/browser data.
 void identityPolicyAcknowledged(){identityAcknowledgments++;acknowledgmentAfterAdmission=networkReady&&!connecting&&!guard.blocked&&!appliedIdentity.isEmpty();}
 // WebReplyObserver's observed trusted intent boundary, checked against its exact
 // source invalidation block by the runner; the observer itself is not executed.
 void trustedIntentBoundary(){webWorkGeneration++;resourceObservedAt=0;}
 static final JSONArray checks=new JSONArray();static int failed;
 static void check(boolean passed,String name){checks.put(J.obj("name",name,"pass",passed));if(!passed)failed++;}
 static GuardHost fresh(){Clock.reset();Looper.current=Looper.MAIN;BackgroundReplyPolicy.enabled=false;NativeNetwork.peeks=0;NetworkUiProvider.notifications=0;GuardHost s=new GuardHost();s.prefs.values.put("networkMode","internal");Object port=new Object();s.web.ports.put(s.web.current,port);s.resourceObserverConnected(port);s.observe("",false,false);return s;}
 void observe(String request,boolean busy,boolean upload){resourceWebsiteObservation(event(request,busy,upload),resourceObserverPort);}
 JSONObject event(String request,boolean busy,boolean upload){return J.obj("resourceBinding",resourceObserverBinding,"documentId",resourceObserverDocument.isEmpty()?"document-1234567890123456":resourceObserverDocument,"resourceSequence",resourceObserverSequence+1,"busy",busy,"uploading",upload,"url",web.url,"capturedAt",Clock.wallMillis(),"guardRequestId",request);}
 static String nonce(Web web,int index)throws Exception{String script=web.scripts.get(index);int start=script.indexOf('('),end=script.lastIndexOf(')');return new JSONArray("["+script.substring(start+1,end)+"]").getString(0);}
 static NetworkCoreApplication proof(GuardHost s){return new NetworkCoreApplication(new EnvironmentSpec.Identity(2,s.environmentGeneration,s.environmentId));}
 static void freshness(){
  GuardHost s=fresh();JSONObject pending=J.obj("id","stale-pending","prompt","KEEP_PRIVATE");s.pending=pending;String before=pending.toString();TaskGuardSnapshot idle=s.taskGuardSnapshot();check(idle.known&&!idle.busyOrUnknown(),"Fresh idle resource receipt can supersede stale native pending guard");check(s.pending==pending&&s.pending.toString().equals(before),"Fresh idle guard never clears or modifies pending task");
  Clock.mono+=10001;check(!s.taskGuardSnapshot().known&&s.taskGuardSnapshot().busyOrUnknown(),"Resource observation older than ten seconds is unknown");
  s=fresh();TaskGuardSnapshot old=s.taskGuardSnapshot();s.trustedIntentBoundary();check(!s.resourceObservationCurrent()&&!old.sameWork(s.taskGuardSnapshot()),"Trusted intent invalidates old idle resource observation/work generation");s.observe("",true,false);check(s.taskGuardSnapshot().known&&s.taskGuardSnapshot().replyBusy,"Fresh trusted-task resource busy is preserved");
  s=fresh();s.resourceUploads.uncertain=true;check(s.taskGuardSnapshot().fileBusy&&s.taskGuardSnapshot().busyOrUnknown(),"Uncertain file work independently blocks idle switching");
  s=fresh();s.submitting=true;check(s.taskGuardSnapshot().submitting&&s.taskGuardSnapshot().busyOrUnknown(),"Submitting blocks switch");s.submitting=false;s.operation=true;check(s.taskGuardSnapshot().operation&&s.taskGuardSnapshot().busyOrUnknown(),"Web operation blocks switch");s.operation=false;s.transferActive=true;check(s.taskGuardSnapshot().downloading&&s.taskGuardSnapshot().busyOrUnknown(),"Download transfer blocks switch");
  s=fresh();s.web.visible=false;check(!s.resourceObservationCurrent(),"Hidden document observation is unknown");s.web.visible=true;s.web.ports.put(s.web.current,new Object());check(!s.resourceObservationCurrent(),"Retired document port observation is unknown");
  s=fresh();s.navigationEpoch++;check(!s.resourceObservationCurrent(),"Old navigation epoch is unknown");s=fresh();s.web.url="https://chatgpt.com/c/other";check(!s.resourceObservationCurrent(),"Old route observation is unknown");
 }
 static void requests()throws Exception{
  GuardHost s=fresh();List<TaskGuardSnapshot> answers=new ArrayList<>();s.requestTaskGuardStatus("caller",answers::add);String request=nonce(s.web,0);check(request.matches("[0-9a-f-]{36}")&&s.taskGuardRequests.size()==1,"Finite guard allocates one bounded UUID nonce");s.observe(request,false,false);check(answers.size()==1&&answers.get(0).known&&!answers.get(0).busyOrUnknown(),"Owned fresh nonce produces one idle receipt");s.observe(request,false,false);s.handler.advance(2500);check(answers.size()==1&&s.taskGuardRequests.isEmpty(),"Duplicate event and timeout cannot deliver nonce twice");
  s=fresh();answers=new ArrayList<>();s.requestTaskGuardStatus("caller",answers::add);s.handler.advance(2499);check(answers.isEmpty(),"Guard waits at most the declared finite deadline");s.handler.advance(1);check(answers.size()==1&&!answers.get(0).known&&answers.get(0).busyOrUnknown()&&s.taskGuardRequests.isEmpty(),"Timeout returns unknown despite cached idle state and retires nonce");
  s=fresh();List<TaskGuardSnapshot> a=new ArrayList<>(),b=new ArrayList<>();s.requestTaskGuardStatus("same external id",a::add);String na=nonce(s.web,0);s.requestTaskGuardStatus("same external id",b::add);String nb=nonce(s.web,1);check(!na.equals(nb),"Overlapping external IDs still get distinct native nonces");s.observe(nb,true,false);check(a.isEmpty()&&b.size()==1&&b.get(0).replyBusy,"Out-of-order second nonce only completes its callback");s.observe(na,false,false);s.handler.advance(2500);check(a.size()==1&&!a.get(0).replyBusy&&b.size()==1,"First nonce completion cannot reuse second response");
  s=fresh();answers=new ArrayList<>();s.requestTaskGuardStatus("caller",answers::add);Object oldPort=s.resourceObserverPort;Object nextPort=new Object();s.web.ports.put(s.web.current,nextPort);s.resourceObserverConnected(nextPort);s.web.callback(0);check(answers.size()==1&&!answers.get(0).known,"Evaluation completion on expired port returns unknown");s.handler.advance(2500);check(answers.size()==1,"Expired port request only completes once");
  s=fresh();answers=new ArrayList<>();s.requestTaskGuardStatus("caller",answers::add);request=nonce(s.web,0);JSONObject mismatch=s.event(request,false,false);mismatch.put("documentId","different-document-123456789");s.resourceWebsiteObservation(mismatch,s.resourceObserverPort);check(answers.isEmpty(),"A different document cannot acknowledge original document request");s.handler.advance(2500);check(answers.size()==1&&!answers.get(0).known,"Mismatched document ends as unknown");
  s=fresh();answers=new ArrayList<>();s.resourceObserverDisconnected(s.resourceObserverPort);s.requestTaskGuardStatus("caller",answers::add);check(answers.size()==1&&!answers.get(0).known&&s.web.scripts.isEmpty(),"Missing observer returns unknown without starting browser work");
  s=fresh();answers=new ArrayList<>();Looper.current=new Object();s.requestTaskGuardStatus("caller",answers::add);check(s.web.scripts.isEmpty()&&s.taskGuardRequests.isEmpty(),"Off-main request dispatches to handler before accessing observer");s.handler.flush();check(s.taskGuardRequests.size()==1&&s.web.scripts.size()==1,"Handler owns native nonce admission");Looper.current=Looper.MAIN;
 }
 static void staleDelivery()throws Exception{
  // A request can be evaluated by a replacement document before its evaluate
  // callback runs. The nonce callback must retain the original native port lease.
  GuardHost s=fresh();List<TaskGuardSnapshot> answers=new ArrayList<>();s.requestTaskGuardStatus("caller",answers::add);String request=nonce(s.web,0);Object next=new Object();s.web.ports.put(s.web.current,next);s.resourceObserverConnected(next);s.observe(request,false,false);check(answers.size()==1&&!answers.get(0).known,"Replacement port cannot turn an old nonce into a known idle receipt");s.web.callback(0);s.handler.advance(2500);check(answers.size()==1,"Replacement port race does not produce a second callback");
  s=fresh();answers=new ArrayList<>();s.requestTaskGuardStatus("caller",answers::add);request=nonce(s.web,0);Object samePort=s.resourceObserverPort;s.resourceObserverConnected(samePort);s.observe(request,false,false);check(answers.size()==1&&!answers.get(0).known,"Rebound observer binding cannot acknowledge an old nonce as idle");
 }
 static void workGenerationRaces()throws Exception{
  GuardHost s=fresh();List<TaskGuardSnapshot> answers=new ArrayList<>();s.requestTaskGuardStatus("caller",answers::add);String request=nonce(s.web,0);s.trustedIntentBoundary();s.observe(request,false,false);check(answers.size()==1&&!answers.get(0).known,"Trusted intent during finite request cannot reuse its old idle lease");s.handler.advance(2500);check(answers.size()==1,"Trusted-work invalidation still completes at most once");
  s=fresh();answers=new ArrayList<>();s.requestTaskGuardStatus("caller",answers::add);request=nonce(s.web,0);s.fileWorkGeneration++;s.observe(request,false,false);check(answers.size()==1&&!answers.get(0).known,"New file work generation cannot acknowledge an old idle request");
  s=fresh();answers=new ArrayList<>();s.requestTaskGuardStatus("caller",answers::add);request=nonce(s.web,0);s.operationGeneration++;s.observe(request,false,false);check(answers.size()==1&&!answers.get(0).known,"New operation generation cannot acknowledge an old idle request");
  s=fresh();answers=new ArrayList<>();Object port=s.resourceObserverPort;s.resourceObserverConnected(port);s.requestTaskGuardStatus("first-document",answers::add);request=nonce(s.web,0);s.observe(request,false,false);check(answers.size()==1&&answers.get(0).known&&!answers.get(0).busyOrUnknown(),"Empty document can acquire its first fresh receipt on the same port/binding/work lease");
 }
 static void rejectMalformed(){GuardHost s=fresh();long before=s.resourceObserverSequence;JSONObject wrong=s.event("",false,false);try{wrong.put("busy","false");}catch(Exception e){throw new RuntimeException(e);}s.resourceWebsiteObservation(wrong,s.resourceObserverPort);check(s.resourceObserverSequence==before,"Untyped busy data is rejected");wrong=s.event("",false,false);try{wrong.put("capturedAt",Clock.wallMillis()-10001);}catch(Exception e){throw new RuntimeException(e);}s.resourceWebsiteObservation(wrong,s.resourceObserverPort);check(s.resourceObserverSequence==before,"Stale wall timestamp is rejected");wrong=s.event("",false,false);s.resourceWebsiteObservation(wrong,new Object());check(s.resourceObserverSequence==before,"Wrong native port cannot update observation");}
 static void policy(){
  GuardHost s=fresh();s.pending=J.obj("id","keep-reply");s.attachments=J.arr(J.obj("name","keep-file","state","ready"));JSONObject job=s.pending;JSONArray files=s.attachments;s.resourceWebsiteBusy=true;s.inFlight=true;s.handler.post(s.tick);long nav=s.navigationEpoch;s.replyObservationPolicyChanged();check(!s.inFlight&&s.syncRun==1&&s.resourceInspectionGeneration==1&&s.webObserver.resets==1,"Disabling optional observation invalidates only inspection/completion work");check(!s.handler.contains(s.tick),"Disabling optional observation removes existing tick");s.wakePolling();check(!s.handler.contains(s.tick),"Disabled reply-only wake cannot schedule polling");
  List<JSONObject> result=new ArrayList<>();int scripts=s.web.scripts.size();for(String action:new String[]{"inspect","web-inspect","transcript","web-transcript","poll"})s.evaluateDriver(action,"DO_NOT_CAPTURE",result::add);check(result.size()==5&&result.stream().allMatch(v->v.optBoolean("cancelled"))&&s.web.scripts.size()==scripts,"Disabled heavy reply/response drivers are cancelled before Gecko evaluation");check(s.pending==job&&s.attachments==files&&s.resourceWebsiteBusy&&s.navigationEpoch==nav&&s.web.stopLoads==0&&s.web.loads==0&&s.web.sends==0,"Policy change preserves current reply/files/document and never resends");
  s.resourceChoosers=1;s.wakePolling();check(s.handler.contains(s.tick),"Independent active file guard retains its necessary finite work");scripts=s.web.scripts.size();s.evaluateDriver("web-transcript","DO_NOT_CAPTURE",v->{});check(s.web.scripts.size()==scripts,"File protection cannot reopen optional response capture");
  s=fresh();s.uiVisible=true;s.replyObservationPolicyChanged();check(s.replyObservationAllowed()&&s.webObserver.resets==0,"Foreground reply observation remains available with global off");s.wakePolling();check(s.handler.contains(s.tick),"Foreground page can schedule normal observation");
 }
 static void network(){
  GuardHost s=fresh();EnvironmentSpec.Identity owner=new EnvironmentSpec.Identity(2,1,s.environmentId);JSONObject job=J.obj("id","keep-reply");s.pending=job;s.attachments=J.arr(J.obj("name","keep-file","state","uploading"));JSONArray files=s.attachments;long nav=s.navigationEpoch,previous=s.connectionEpoch;String url=s.web.url;s.prefs.values.put("draft","KEEP_DRAFT");long lease=s.beginNetworkApplication(owner);check(lease==previous+1&&s.connecting&&!s.networkReady&&s.guard.blocked,"Begin replaces only connection lease and blocks new network admission");check(s.identityAcknowledgments==0,"Beginning a network attempt cannot acknowledge unvalidated identity");check(s.pending==job&&s.attachments==files&&s.navigationEpoch==nav&&s.web.url.equals(url)&&s.web.stopLoads==0&&s.web.loads==0&&s.web.sends==0&&"KEEP_DRAFT".equals(s.prefs.getString("draft","")),"Network begin preserves pending/files/draft/document without stopLoading or replay");check(s.adoptNetworkApplication(lease,proof(s))&&s.networkReady&&!s.connecting&&!s.guard.blocked,"Matching current actual core proof adopts protected connection");check(s.identityAcknowledgments==1&&s.acknowledgmentAfterAdmission,"Validated core adoption acknowledges browser identity only after protected admission");check(s.pending==job&&s.attachments==files&&s.navigationEpoch==nav&&s.web.stopLoads==0&&s.web.loads==0&&s.web.sends==0,"Adoption never reloads or resends original document/task");
  s=fresh();long epoch=s.connectionEpoch;check(s.beginNetworkApplication(new EnvironmentSpec.Identity(3,1,s.environmentId))==-1&&s.connectionEpoch==epoch&&s.web.closedIp==0,"Wrong environment slot cannot begin network lease");check(s.beginNetworkApplication(new EnvironmentSpec.Identity(2,2,s.environmentId))==-1&&s.connectionEpoch==epoch,"Wrong owner generation cannot begin lease");
  for(String invalid:new String[]{"lease","negative","owner","generation","proof","offline","browser","route","missing"}){s=fresh();lease=s.beginNetworkApplication(new EnvironmentSpec.Identity(2,1,s.environmentId));NetworkCoreApplication proof=proof(s);if(invalid.equals("lease"))lease--;if(invalid.equals("negative"))lease=-1;if(invalid.equals("owner"))proof.identity=new EnvironmentSpec.Identity(2,1,"other-env");if(invalid.equals("generation"))proof.identity=new EnvironmentSpec.Identity(2,2,s.environmentId);if(invalid.equals("proof"))proof.valid=false;if(invalid.equals("offline"))s.offline=true;if(invalid.equals("browser"))s.web.protectedNetwork=false;if(invalid.equals("route"))s.guard.protectedRoute=false;if(invalid.equals("missing"))proof=null;check(!s.adoptNetworkApplication(lease,proof)&&!s.networkReady&&s.guard.blocked,"Invalid "+invalid+" cannot adopt/unblock protected document");check(s.identityAcknowledgments==0,"Invalid "+invalid+" never acknowledges browser identity");}
  s=fresh();owner=new EnvironmentSpec.Identity(2,1,s.environmentId);long older=s.beginNetworkApplication(owner),newer=s.beginNetworkApplication(owner);check(!s.adoptNetworkApplication(older,proof(s))&&s.adoptNetworkApplication(newer,proof(s)),"Overlapping network attempts cannot adopt a retired connection lease");
  s=fresh();s.prefs.values.put("networkMode","external");lease=s.beginNetworkApplication(new EnvironmentSpec.Identity(2,1,s.environmentId));check(s.adoptNetworkApplication(lease,null),"External protected route adopts without inventing a core proof");check(s.identityAcknowledgments==1&&s.acknowledgmentAfterAdmission,"Validated external adoption acknowledges identity through normal hook");s=fresh();s.prefs.values.put("networkMode","external");s.prefs.values.put("proxy","bad");lease=s.beginNetworkApplication(new EnvironmentSpec.Identity(2,1,s.environmentId));check(!s.adoptNetworkApplication(lease,null),"Invalid explicit external proxy remains blocked");check(s.identityAcknowledgments==0,"Rejected explicit proxy cannot acknowledge browser identity");
  s=fresh();s.prefs.values.put("networkMode","external");lease=s.beginNetworkApplication(new EnvironmentSpec.Identity(2,1,s.environmentId));check(!s.adoptNetworkApplication(lease,proof(s))&&s.identityAcknowledgments==0,"External mode rejects unrelated native proof before identity acknowledgment");
  s=fresh();s.prefs.values.put("networkMode","external");s.guard.protectedRoute=false;lease=s.beginNetworkApplication(new EnvironmentSpec.Identity(2,1,s.environmentId));check(!s.adoptNetworkApplication(lease,null)&&s.identityAcknowledgments==0,"Unprotected external route cannot acknowledge browser identity");
 }
 public static void main(String[] args)throws Exception{freshness();requests();staleDelivery();workGenerationRaces();rejectMalformed();policy();network();System.out.println(J.obj("status",failed==0?"passed":"failed","passed",checks.length()-failed,"total",checks.length(),"checks",checks,"actualAndroidExecution",false,"actualGeckoExecution",false,"actualNativeExecution",false,"scope","Exact ChatSession task guards/policy/network begin-adopt methods and TaskGuardSnapshot with explicit scheduler/clock/Gecko port/proof/activity-policy doubles").toString());if(failed>0)System.exit(1);}
}
class Clock {static long mono,wall;static void reset(){mono=1000;wall=2000000;}static long wallMillis(){return wall;}}
class SystemClock {static long elapsedRealtime(){return Clock.mono;}}
class Looper {static final Object MAIN=new Object();static Object current=MAIN;static Object myLooper(){return current;}static Object getMainLooper(){return MAIN;}}
class Handler {static class Row{long at;Runnable task;Row(long at,Runnable task){this.at=at;this.task=task;}}final List<Row> queue=new ArrayList<>();void post(Runnable r){queue.add(new Row(Clock.mono,r));}void postDelayed(Runnable r,long delay){queue.add(new Row(Clock.mono+delay,r));}void removeCallbacks(Runnable r){queue.removeIf(row->row.task==r);}boolean contains(Runnable r){return queue.stream().anyMatch(row->row.task==r);}void advance(long ms){Clock.mono+=ms;Clock.wall+=ms;flush();}void flush(){Object prior=Looper.current;Looper.current=Looper.MAIN;for(;;){Row found=null;for(Row r:queue)if(r.at<=Clock.mono){found=r;break;}if(found==null)break;queue.remove(found);found.task.run();}Looper.current=prior;}}
class Web {Object current=new Object();final Map<Object,Object> ports=new HashMap<>();String url="https://chatgpt.com/c/owned";boolean visible=true,ready=true,protectedNetwork=true;int stopLoads,loads,sends,closedIp;final List<String> scripts=new ArrayList<>();final List<Consumer<String>> callbacks=new ArrayList<>();String getUrl(){return url;}boolean hasVisibleDocument(){return visible;}boolean resourcePage(String s){return s.startsWith("https://chatgpt.com/");}boolean resourceSamePage(String a,String b){return a.equals(b);}void evaluateJavascript(String code,Consumer<String> cb){scripts.add(code);callbacks.add(cb);}void callback(int i){if(callbacks.get(i)!=null)callbacks.get(i).accept("{}");}void closeExitIpPage(){closedIp++;}boolean protectionAllowsNetwork(){return protectedNetwork;}void stopLoading(){stopLoads++;}void loadUrl(String url){loads++;}void submit(){sends++;}}
class Guard {boolean blocked=true,protectedRoute=true;void setBlocked(boolean value){blocked=value;}boolean routeProtected(){return protectedRoute;}}
class Prefs {final Map<String,String> values=new HashMap<>();String getString(String k,String fallback){return values.getOrDefault(k,fallback);}}
class Observer {int resets;void resetCompletion(){resets++;}}
class Uploads {boolean active,uncertain;boolean active(long epoch){return active;}boolean unknown(long epoch){return uncertain;}}
class Profiles {static int slot(Object c){return 2;}}
class WebReplyObserver {static boolean same(String a,String b){return a.equals(b);}}
class BackgroundReplyPolicy {static boolean enabled;static boolean enabledCached(){return enabled;}}
class NetworkUiProvider {static int notifications;static void sessionAvailable(){notifications++;}}
class EnvironmentSpec {static class Identity{final int slot,generation;final String environmentId;Identity(int slot,int generation,String id){this.slot=slot;this.generation=generation;environmentId=id;}}}
class NetworkCoreApplication {EnvironmentSpec.Identity identity;boolean valid=true;NetworkCoreApplication(EnvironmentSpec.Identity owner){identity=owner;}boolean current(NativeNetwork n){return valid&&n!=null;}}
class NativeNetwork {static int peeks;static final NativeNetwork N=new NativeNetwork();static NativeNetwork peek(){peeks++;return N;}static NativeNetwork get(Object c){throw new AssertionError("Network construction must not occur");}}
class MainActivity {static boolean validProxy(String s){return !"bad".equals(s);}}
class WebPerfStats {static void driver(String action,int length){}static void response(String action,int length,long elapsed,JSONObject response){}}

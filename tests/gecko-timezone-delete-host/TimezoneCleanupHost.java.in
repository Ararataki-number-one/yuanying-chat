  final Context context;
/*ACTUAL_SECRET_CONSTRUCTOR*/
/*ACTUAL_SECRET_FILE*/
/*ACTUAL_SECRET_REMOVE*/
}

final class ActualDeletionCleanup {
  static void run(File data,int slot,Context profile)throws Exception{
/*ACTUAL_CLEANUP_BRANCH*/
  }
/*ACTUAL_ERASE_METHOD*/
}

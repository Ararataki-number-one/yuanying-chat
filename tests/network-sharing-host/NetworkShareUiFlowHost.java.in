package local.pocketchat;
import org.json.*;import java.util.*;
public final class NetworkShareUiFlowHost {
 @PRODUCTION_MEMBERS@
 static int checks,nodeCalls;static NetworkShareCodec.Bundle payload;static Prepared delivered;static int retried=-1;
 static void show(Activity a,NetworkShareCodec.Bundle b,String unavailable,Prepared owner){payload=b;delivered=owner;}
 static void retry(Activity a,Prepared p,int side){retried=side;}
 static void node(Activity a,JSONObject source,String name){nodeCalls++;}
 static void check(boolean ok,String message){if(!ok)throw new AssertionError(message);checks++;}
 static void reset(){NativeNetwork.pending.clear();NativeNetwork.requested.clear();ReferenceUi.latest=null;DesignUi.actions.clear();payload=null;delivered=null;retried=-1;nodeCalls=0;NetworkCatalog.failIndex=false;}
 static JSONObject node(String name)throws Exception{return J.obj("name",name,"type","socks5","server","127.0.0.1","port",1080);}
 static Prepared pair()throws Exception{Prepared p=new Prepared("Route","route");p.nodes[0]=node("Entry");p.nodes[1]=node("Exit");return p;}
 static final String KEY="a".repeat(64),OTHER="b".repeat(64);
 static void answer(boolean ok,String key){NativeNetwork.pending.remove(0).done(ok,"SYNTHETIC_RAW_PASSWORD_URL_TOKEN",J.arr("Selected"),ok?J.arr(J.obj("configFingerprint",key,"configFingerprintVersion",1)):new JSONArray(),null);}
 public static void main(String[] args)throws Exception{
  reset();Activity a=new Activity();Prepared p=pair();ReferenceUi.Modal wait=new ReferenceUi.Modal(a,"wait");verifyPrepared(a,wait,p,0,KEY,KEY);answer(true,KEY);answer(true,KEY);check(payload!=null&&payload.kind.equals("route"),"Complete requested route payload");
  reset();p=pair();wait=new ReferenceUi.Modal(a,"wait");verifyPrepared(a,wait,p,0,KEY,KEY);answer(false,"");check(NativeNetwork.pending.size()==1,"Exit still checked after entry failure");answer(true,KEY);check(payload==null&&ReferenceUi.latest.title.equals("分享整条线路"),"Partial request keeps route title and has no payload");check(DesignUi.actions.containsKey("仅分享出口")&&DesignUi.actions.containsKey("重试入口"),"Partial route requires explicit narrow or same-side retry");check(!ReferenceUi.latest.notes.toString().contains("SYNTHETIC_RAW_PASSWORD_URL_TOKEN"),"Raw native secret never appears");DesignUi.actions.get("仅分享出口").run();check(payload!=null&&payload.kind.equals("exit")&&payload.entry==null,"Only explicit narrowing creates exit payload");
  reset();p=pair();wait=new ReferenceUi.Modal(a,"wait");verifyPrepared(a,wait,p,0,KEY,KEY);answer(true,KEY);answer(false,"");check(payload==null&&ReferenceUi.latest.title.equals("分享整条线路")&&DesignUi.actions.containsKey("仅分享入口")&&DesignUi.actions.containsKey("重试出口"),"Symmetric exit failure explicit route choice");
  reset();p=pair();wait=new ReferenceUi.Modal(a,"wait");verifyPrepared(a,wait,p,0,KEY,KEY);answer(false,"");answer(false,"");check(payload==null&&DesignUi.actions.containsKey("重试入口")&&DesignUi.actions.containsKey("重试出口"),"Both failures produce no portable payload");
  reset();p=pair();p.verified[1]=true;wait=new ReferenceUi.Modal(a,"wait");verifyPrepared(a,wait,p,0,KEY,KEY);answer(true,KEY);check(NativeNetwork.requested.equals(Arrays.asList("entry"))&&payload!=null,"Retry reuses already verified successful side");
  reset();p=pair();wait=new ReferenceUi.Modal(a,"wait");verifyPrepared(a,wait,p,0,KEY,KEY);answer(true,OTHER);answer(true,KEY);check(payload==null&&p.nodes[0]==null&&p.problems[0].code.equals("IDENTITY_MISMATCH"),"Fingerprint mismatch excluded with typed reason");
  reset();p=pair();wait=new ReferenceUi.Modal(a,"wait");verifyPrepared(a,wait,p,0,KEY,KEY);a.destroyed=true;answer(true,KEY);check(payload==null&&NativeNetwork.pending.isEmpty(),"Destroyed Activity ignores late native callback");
  reset();a=new Activity();p=pair();wait=new ReferenceUi.Modal(a,"wait");verifyPrepared(a,wait,p,0,KEY,KEY);wait.dismiss();answer(true,KEY);check(payload==null&&NativeNetwork.pending.isEmpty(),"Dismissed progress ignores late native callback");
  reset();a=new Activity();p=pair();p.nodes[0]=null;p.problems[0]=problem("SUBSCRIPTION_CACHE","UNREADABLE",0);wait=new ReferenceUi.Modal(a,"wait");verifyPrepared(a,wait,p,0,KEY,KEY);check(NativeNetwork.requested.equals(Arrays.asList("exit")),"Read-stage entry failure still independently checks exit");answer(true,KEY);check(payload==null&&DesignUi.actions.containsKey("仅分享出口"),"Read-stage failure cannot silently narrow payload");DesignUi.actions.get("仅分享出口").run();check(payload!=null&&payload.entry==null&&payload.exit!=null,"Explicit read-stage narrowing contains verified exit only");
  reset();a=new Activity();p=pair();p.nodes[1]=null;p.problems[1]=problem("SUBSCRIPTION_CACHE","UNREADABLE",1);wait=new ReferenceUi.Modal(a,"wait");verifyPrepared(a,wait,p,0,KEY,KEY);check(NativeNetwork.requested.equals(Arrays.asList("entry")),"Read-stage subscribed exit failure still checks entry");answer(true,KEY);check(payload==null&&DesignUi.actions.containsKey("仅分享入口"),"Exit read-stage failure retains route before explicit narrow");
  for(String availability:new String[]{"budget","unavailable"}){reset();JSONObject source=J.obj("role","entry","detail",J.obj("shareAvailability",availability));nodeMenu(new Activity(),source,"Entry|Selected");check(DesignUi.actions.size()==1,"Cache miss retains selected-node share action for "+availability);DesignUi.actions.values().iterator().next().run();check(nodeCalls==1,"Cache miss invokes selected-node fallback for "+availability);}
  reset();nodeMenu(new Activity(),J.obj("role","entry","detail",J.obj("shareAvailability","unsupported-format")),"Entry|Selected");check(DesignUi.actions.isEmpty(),"Known unsupported URI/Base64 source disclosed before sharing");
  reset();NetworkCatalog.failIndex=true;JSONObject fallback=selected(new NetworkCatalog(new Activity()),new JSONObject(),NetworkShareCodec.provider(node("Selected")),"Entry|Selected","entry",KEY);check(fallback.getString("name").equals("Selected"),"Optional index failure falls back to selected immutable source");
  System.out.println(J.obj("passed",checks,"actualAndroidExecution",false,"actualNativeExecution",false,"scope","Exact production Prepared/verifyPrepared/show partial-route methods with explicit Activity/native adapters").toString());
 }
}
class Activity extends android.content.Context {boolean destroyed;Activity(){super("ui");}boolean isDestroyed(){return destroyed;}}
class ReferenceUi {static Modal latest;static class Modal{final Object body=new Object();final String title;final List<String> notes=new ArrayList<>();boolean showing=true;Modal(Activity a,String title){this.title=title;latest=this;}void note(String s){notes.add(s);}boolean isShowing(){return showing;}void dismiss(){showing=false;}void show(){}void buttons(String a,Runnable b,String c,Runnable d){}}static void message(Activity a,String title,String text){}}
class DesignUi {static final Map<String,Runnable> actions=new LinkedHashMap<>();static void action(Object body,String label,boolean strong,Runnable action){actions.put(label,action);}}

class NetworkWorkspaceUi {static String nodeName(String name){return name;}}

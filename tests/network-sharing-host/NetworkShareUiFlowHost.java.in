package local.pocketchat;
import org.json.*;
import java.util.*;
import java.nio.charset.StandardCharsets;
import java.io.*;
import java.util.concurrent.*;

/** Production route loader and asynchronous native-verification callback bodies;
 * all Activity/storage/native-callback boundaries are explicit host adapters. */
public final class NetworkShareUiFlowHost {
  static int checks,nodeCalls;static NetworkShareCodec.Bundle shown;static String note="",failed="";static ReferenceUi.Modal current;
  @PRODUCTION_MEMBERS@
  static void node(Activity a,JSONObject source,String name){nodeCalls++;}
  static void prepareRoute(Activity a,RouteLoad load,String entry,String exit){current=new ReferenceUi.Modal();try{verifyPrepared(a,current,load.run(),0,entry,exit);}catch(Exception e){failure(a,current,NetworkShareCodec.explanation(e));}}
  static void show(Activity a,NetworkShareCodec.Bundle b,String text){shown=b;note=text;}
  static void failure(Activity a,ReferenceUi.Modal wait,String message){if(!a.isDestroyed()&&wait.isShowing())failed=message;}
  static void check(boolean ok,String text){if(!ok)throw new AssertionError(text);checks++;}
  static void reset(){shown=null;failed="";note="";current=null;NativeNetwork.pending.clear();NativeNetwork.requested.clear();SecretStore.entry=null;SecretStore.exit=null;SecretStore.failRead=false;SecretStore.config=new JSONObject();Race.enabled=false;DesignUi.actions=0;DesignUi.click=null;nodeCalls=0;NetworkCatalog.failIndex=false;}
  static final String KEY="a".repeat(64),OTHER="b".repeat(64);
  static JSONObject node(String name)throws Exception{return J.obj("name",name,"type","socks5","server","127.0.0.1","port",1080);}
  static Prepared pair()throws Exception{Prepared p=new Prepared("route");p.nodes[0]=node("Entry");p.nodes[1]=node("Exit");return p;}
  static void answer(boolean ok,String key){NativeNetwork.pending.remove(0).done(ok,"PRIVATE-PARSER-MARKER",new JSONArray(),ok?J.arr(J.obj("configFingerprint",key,"configFingerprintVersion",1)):new JSONArray(),null);}
  static WindowNetworkState state(){WindowNetworkState s=new WindowNetworkState();s.internal=true;s.entry="Entry|Entry";s.name="window";s.config=J.obj("entry",s.entry,"entryNodeKey",KEY,"exitHost","127.0.0.1","exitPort",1080,"exitName","Exit","fingerprint","live");SecretStore.config=NetworkCatalog.copy(s.config);return s;}
  public static void main(String[] args)throws Exception{
    reset();Activity a=new Activity();Prepared p=pair();current=new ReferenceUi.Modal();verifyPrepared(a,current,p,0,KEY,KEY);answer(true,KEY);answer(true,KEY);check(shown!=null&&shown.kind.equals("route")&&note.isEmpty(),"Both verified nodes retain complete-route sharing");
    reset();a=new Activity();p=pair();current=new ReferenceUi.Modal();verifyPrepared(a,current,p,0,KEY,KEY);answer(false,"");check(NativeNetwork.pending.size()==1,"Entry native failure still verifies independent exit");answer(true,KEY);check(shown!=null&&shown.kind.equals("exit")&&note.contains("入口内核解析阶段")&&!note.contains("PRIVATE-PARSER-MARKER"),"Native failure exposes only verified exit and sanitized stage");
    reset();a=new Activity();p=pair();current=new ReferenceUi.Modal();verifyPrepared(a,current,p,0,KEY,KEY);answer(true,OTHER);answer(true,KEY);check(shown!=null&&shown.kind.equals("exit")&&note.contains("身份核对阶段"),"Entry fingerprint mismatch cannot leak entry into partial share");
    reset();a=new Activity();p=pair();current=new ReferenceUi.Modal();verifyPrepared(a,current,p,0,KEY,KEY);answer(true,KEY);answer(false,"");check(shown!=null&&shown.kind.equals("entry")&&note.contains("出口内核解析阶段"),"Exit failure retains independently verified entry");
    reset();a=new Activity();p=pair();current=new ReferenceUi.Modal();verifyPrepared(a,current,p,0,KEY,KEY);answer(false,"");answer(false,"");check(shown==null&&failed.contains("入口")&&failed.contains("出口"),"Both failures generate no share");
    reset();a=new Activity();p=pair();current=new ReferenceUi.Modal();verifyPrepared(a,current,p,0,KEY,KEY);current.dismiss();answer(true,KEY);check(shown==null&&NativeNetwork.pending.isEmpty(),"Dismissed progress ignores late native callback");
    reset();a=new Activity();p=pair();current=new ReferenceUi.Modal();verifyPrepared(a,current,p,0,KEY,KEY);a.destroyed=true;answer(true,KEY);check(shown==null&&NativeNetwork.pending.isEmpty(),"Destroyed Activity ignores late native callback");
    reset();a=new Activity();WindowNetworkState s=state();SecretStore.entry="unsupported URI cache PRIVATE-PARSER-MARKER".getBytes(StandardCharsets.UTF_8);route(a,s);check(NativeNetwork.requested.equals(Arrays.asList("exit")),"Exact production route loader continues manual exit after entry read failure");answer(true,KEY);check(shown!=null&&shown.kind.equals("exit")&&note.contains("入口读取阶段")&&!note.contains("PRIVATE-PARSER-MARKER"),"Read-stage partial share contains only verified exit");
    reset();a=new Activity();s=state();s.config.put("entryNodeKey","");SecretStore.config=NetworkCatalog.copy(s.config);route(a,s);check(NativeNetwork.requested.equals(Arrays.asList("exit")),"Missing entry identity does not hide manual exit share");answer(true,KEY);check(shown!=null&&shown.entry==null&&shown.exit!=null,"Missing entry produces exit-only payload");
    reset();a=new Activity();s=state();SecretStore.config.put("fingerprint","changed");route(a,s);check(NativeNetwork.pending.isEmpty()&&shown==null&&failed.contains("线路已变化"),"Changed active route rejects whole stale loader before extracting secrets");
    reset();a=new Activity();s=state();SecretStore.entry=NetworkShareCodec.provider(node("Entry"));s.config.put("subscribedExit",true).put("exitNodeName","Exit|Exit").put("exitNodeKey",KEY);SecretStore.config=NetworkCatalog.copy(s.config);SecretStore.exit="unsupported".getBytes(StandardCharsets.UTF_8);route(a,s);check(NativeNetwork.requested.equals(Arrays.asList("entry")),"Subscribed-exit read failure still verifies original entry");answer(true,KEY);check(shown!=null&&shown.kind.equals("entry")&&note.contains("出口读取阶段"),"Subscribed-exit failure excludes its missing data");
    reset();final Activity raceActivity=new Activity();final WindowNetworkState raceState=state();JSONObject oldNode=node("Entry");oldNode.put("password","captured-before-save");SecretStore.entry=NetworkShareCodec.provider(oldNode);Race.enabled=true;Race.captured=new CountDownLatch(1);Race.writerHeld=new CountDownLatch(1);final Throwable[] errors=new Throwable[2];
    Thread writer=new Thread(()->{try{synchronized(NetworkCatalog.lock){Race.writerHeld.countDown();if(!Race.captured.await(2,TimeUnit.SECONDS))throw new AssertionError("Snapshot was not captured");NetworkSourceSelection.withActiveSnapshot(raceActivity,()->{SecretStore.config=J.obj("fingerprint","saved-new-generation");JSONObject changed=node("Entry");changed.put("password","saved-after-capture");SecretStore.entry=NetworkShareCodec.provider(changed);return null;});}}catch(Throwable error){errors[0]=error;}},"catalog-then-snapshot-writer");
    Thread sharing=new Thread(()->{try{route(raceActivity,raceState);}catch(Throwable error){errors[1]=error;}},"snapshot-capture-then-catalog-share");writer.setDaemon(true);sharing.setDaemon(true);writer.start();check(Race.writerHeld.await(2,TimeUnit.SECONDS),"Concurrent writer owns catalogue first");sharing.start();writer.join(3000);sharing.join(3000);Race.enabled=false;
    check(!writer.isAlive()&&!sharing.isAlive()&&errors[0]==null&&errors[1]==null,"Production route releases active-snapshot lock before catalogue lookup: no ABBA deadlock");
    answer(true,KEY);answer(true,KEY);check(shown!=null&&shown.kind.equals("route")&&shown.entry.getString("password").equals("captured-before-save")&&SecretStore.config.getString("fingerprint").equals("saved-new-generation"),"Concurrent save cannot mix captured bytes with a later route generation");
    for(String availability:new String[]{"budget","unavailable"}){reset();JSONObject source=J.obj("role","entry","detail",J.obj("shareAvailability",availability));nodeMenu(new Activity(),source,"Entry|Selected");check(DesignUi.actions==1&&DesignUi.click!=null,"Production node menu retains share action for "+availability);DesignUi.click.run();check(nodeCalls==1,"Cache miss menu invokes selected-node fallback for "+availability);}
    reset();nodeMenu(new Activity(),J.obj("role","entry","detail",J.obj("shareAvailability","unsupported-format")),"Entry|Selected");check(DesignUi.actions==0,"Known unsupported source format is disclosed before attempting sharing");
    reset();NetworkCatalog.failIndex=true;JSONObject fallback=selected(new NetworkCatalog(new Activity()),new JSONObject(),NetworkShareCodec.provider(node("Selected")),"Entry|Selected","entry",KEY);check(fallback.getString("name").equals("Selected"),"Optional sidecar read failure falls back to selected source rather than disabling sharing");
    System.out.println(J.obj("passed",checks,"total",checks,"actualAndroidExecution",false,"actualNativeExecution",false,"scope","Exact production route loader, selected-source method and asynchronous verifyPrepared callbacks with explicit Activity/storage/native adapters").toString());
  }
}
class Activity {boolean destroyed;boolean isDestroyed(){return destroyed;}}
class ReferenceUi {static class Modal {final Object body=new Object();boolean showing=true;Modal(){}Modal(Activity a,String title){}void note(String s){}void buttons(String a,Runnable b,String c,Runnable d){}void show(){}boolean isShowing(){return showing;}void dismiss(){showing=false;}}static void message(Activity a,String title,String text){NetworkShareUiFlowHost.failed=text;}}
class WindowNetworkState {boolean internal;JSONObject config;String entry,name;int slot;}
class Profiles {static Object context(Activity a,int slot){return a;}}
class SecretStore {static JSONObject config;static byte[] entry,exit;static boolean failRead;final Object context;SecretStore(Object c){context=c;}JSONObject settings(){return config;}byte[] get(String key)throws Exception{if(failRead)throw new IOException("PRIVATE-PARSER-MARKER");if(Race.enabled&&key.equals("subscription")){Race.captured.countDown();if(!Race.writerHeld.await(2,TimeUnit.SECONDS))throw new IOException("Writer not ready");}return key.equals("subscription")?entry:exit;}}
class NetworkCatalog {static final Object lock=new Object();static boolean failIndex;static final String ENTRY="entry",EXIT="exit";NetworkCatalog(Activity a){}static JSONObject copy(JSONObject o){return J.parse(o.toString());}JSONObject subscription(String role,String id){return null;}JSONObject shareCandidate(JSONObject row,byte[] bytes,String name,String fingerprint){synchronized(lock){if(failIndex)throw new IllegalStateException("PRIVATE-INDEX-MARKER");return null;}}}
class NetworkSourceSelection {static final Object activeLock=new Object();static JSONObject byName(JSONObject source,String name){return source.optJSONObject("detail");}interface Read<T>{T run()throws Exception;}static <T>T withActiveSnapshot(Object context,Read<T> read)throws Exception{synchronized(activeLock){return read.run();}}}
class NativeNetwork {interface Callback{void done(boolean ok,String message,JSONArray names,JSONArray details,byte[] bytes);}static final List<Callback> pending=new ArrayList<>();static final List<String> requested=new ArrayList<>();static String transportFingerprint(JSONObject value){return value.optString("fingerprint");}static boolean subscribedExit(JSONObject config){return config.optBoolean("subscribedExit");}static void previewSubscription(Activity a,String role,String url,byte[] provider,Callback callback){requested.add(role);pending.add(callback);}}

class Race {static volatile boolean enabled;static CountDownLatch captured,writerHeld;}

class DesignUi {static int actions;static Runnable click;static void action(Object body,String title,boolean destructive,Runnable run){actions++;click=run;}}
class NetworkWorkspaceUi {static String nodeName(String name){return name;}}

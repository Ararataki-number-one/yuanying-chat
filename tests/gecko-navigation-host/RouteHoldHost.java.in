package local.pocketchat;

import java.net.URI;
import java.util.*;
import org.json.*;

/** Actual Gecko route helpers and lease registry, with declared JVM boundaries. */
public final class RouteHoldHost {
  static final String FIRST="https://www.wikipedia.org/wiki/Main_Page",SECOND="http://example.com/popup";
  static final JSONArray checks=new JSONArray();
  static void check(String name,boolean pass){checks.put(J.obj("name",name,"pass",pass));if(!pass)throw new AssertionError(name);}
  static WebBoundary fresh(){check("Prior fixture left no route lease",!ChromiumRouteLease.held()&&ChromiumRouteLease.snapshot().changes==0);Looper.current=Looper.MAIN;return new WebBoundary();}
  static SessionBoundary site(WebBoundary web,String url){SessionBoundary session=new SessionBoundary();web.locations.put(session,url);return session;}
  static void dispose(WebBoundary web){web.destroyed=true;ChromiumRouteLease.removeListener(web.routeLeaseChanged);web.releaseGeneralRoutes();web.generalSessions.clear();web.deferredGeneralLoads.clear();web.owner.handler.drain();}
  static void readiness(){
    WebBoundary web=fresh();try{
      check("Empty generic set needs no generic lease",web.generalRouteReady());
      SessionBoundary primary=site(web,FIRST),popup=site(web,SECOND);
      check("Generic primary acquires one real surface lease",web.retainGeneralRoute(primary,FIRST)&&ChromiumRouteLease.snapshot().surfaces==1&&web.generalRouteReady());
      check("Retaining the same generic page is idempotent",web.retainGeneralRoute(primary,FIRST)&&ChromiumRouteLease.snapshot().surfaces==1);
      check("Generic popup acquires its own real surface lease",web.retainGeneralRoute(popup,SECOND)&&ChromiumRouteLease.snapshot().surfaces==2&&web.generalRouteReady());
      web.owner.handler.drain();check("Queued acquire notifications do not duplicate held leases",ChromiumRouteLease.snapshot().surfaces==2);
      SessionBoundary gpt=site(web,"https://chatgpt.com/c/controlled");check("ChatGPT-only page does not acquire a generic route lease",web.retainGeneralRoute(gpt,web.locations.get(gpt))&&!web.generalSessions.contains(gpt)&&ChromiumRouteLease.snapshot().surfaces==2);
      check("Null generic session never admits a page",!web.retainGeneralRoute(null,FIRST)&&ChromiumRouteLease.snapshot().surfaces==2);
      web.forgetGeneralRoute(primary);check("Forgetting primary keeps popup protected",ChromiumRouteLease.snapshot().surfaces==1&&web.generalRoutes.containsKey(popup)&&web.generalRouteReady());
      web.forgetGeneralRoute(popup);check("Final generic close releases both retained page leases",!ChromiumRouteLease.held()&&web.generalRouteReady());
    }finally{dispose(web);}
  }
  static void identityReadiness(){
    WebBoundary web=fresh();try{
      SessionBoundary primary=site(web,FIRST),missing=site(web,SECOND),unrelated=new SessionBoundary();
      web.generalSessions.add(primary);web.generalSessions.add(missing);web.generalRoutes.put(primary,ChromiumRouteLease.acquireSurface());web.generalRoutes.put(unrelated,ChromiumRouteLease.acquireSurface());
      check("Readiness requires the exact desired session keys, not matching map sizes",!web.generalRouteReady());
      check("Missing desired session can acquire its own lease",web.retainGeneralRoute(missing,SECOND)&&web.generalRouteReady()&&ChromiumRouteLease.snapshot().surfaces==3);
    }finally{dispose(web);}
  }
  static void denial(String kind){
    WebBoundary web=fresh();try{
      SessionBoundary session=site(web,FIRST);
      if(kind.equals("destroyed"))web.destroyed=true;
      else if(kind.equals("failed"))web.failed=true;
      else if(kind.equals("crashed"))web.crashed.add(session);
      else if(kind.equals("blocked"))web.owner.guard.blocked=true;
      else if(kind.equals("unprotected"))web.owner.guard.protectedRoute=false;
      else if(kind.equals("native-protection"))web.networkAllowed=false;
      else throw new AssertionError("Unknown denial boundary");
      check("Unavailable page acquires no route lease: "+kind,!web.retainGeneralRoute(session,FIRST)&&!ChromiumRouteLease.held()&&web.generalRoutes.isEmpty());
      web.owner.handler.drain();check("Unavailable page notification never acquires later: "+kind,!ChromiumRouteLease.held()&&session.loads.isEmpty());
    }finally{dispose(web);}
  }
  static void deniedExisting(){
    for(String kind:new String[]{"destroyed","failed","crashed"})deniedExisting(kind);
  }
  static void deniedExisting(String kind){
    WebBoundary web=fresh();try{
      SessionBoundary session=site(web,FIRST);check("Existing page initially has a lease: "+kind,web.retainGeneralRoute(session,FIRST));
      if(kind.equals("destroyed"))web.destroyed=true;else if(kind.equals("failed"))web.failed=true;else web.crashed.add(session);
      check("Unavailable existing lease cannot authorize another admission: "+kind,!web.retainGeneralRoute(session,FIRST)&&ChromiumRouteLease.snapshot().surfaces==1);
    }finally{dispose(web);}
  }
  static void blockedRelease(){
    WebBoundary web=fresh();try{
      SessionBoundary first=site(web,FIRST),second=site(web,SECOND);web.retainGeneralRoute(first,FIRST);web.retainGeneralRoute(second,SECOND);web.owner.handler.drain();
      web.owner.guard.blocked=true;web.routeAdmissionChanged();
      check("Blocked admission releases actual held routes before callback work",!ChromiumRouteLease.held()&&web.generalRoutes.isEmpty()&&web.generalSessions.size()==2&&!web.generalRouteReady());
      web.owner.handler.drain();check("Blocked admission callbacks cannot reacquire or load",!ChromiumRouteLease.held()&&first.loads.isEmpty()&&second.loads.isEmpty());
      web.owner.guard.blocked=false;web.routeAdmissionChanged();web.owner.handler.drain();
      check("Protected admission reacquires desired routes after the block",ChromiumRouteLease.snapshot().surfaces==2&&web.generalRouteReady());
      web.owner.guard.protectedRoute=false;web.routeAdmissionChanged();web.owner.handler.drain();
      check("Lost native route protection releases and stays blocked",!ChromiumRouteLease.held()&&!web.generalRouteReady());
    }finally{dispose(web);}
  }
  static void barrier(){
    WebBoundary web=fresh();ChromiumRouteLease.Handle change=ChromiumRouteLease.tryChange();try{
      check("Actual change barrier is acquired without a page",change!=null&&ChromiumRouteLease.snapshot().changes==1);
      SessionBoundary session=site(web,FIRST);web.current=session;web.deferredGeneralLoads.put(session,FIRST);
      check("Held change barrier permits zero generic page admission",!web.retainGeneralRoute(session,FIRST)&&web.generalRoutes.isEmpty()&&!web.generalRouteReady()&&ChromiumRouteLease.snapshot().surfaces==0);
      web.owner.handler.drain();check("Queued retry under the barrier performs no load or admission",session.loads.isEmpty()&&web.generalRoutes.isEmpty()&&web.deferredGeneralLoads.containsKey(session));
      change.close();web.owner.handler.drain();
      check("Closing the barrier wakes actual deferred retry",web.generalRouteReady()&&ChromiumRouteLease.snapshot().surfaces==1&&session.loads.equals(Arrays.asList(FIRST))&&web.deferredGeneralLoads.isEmpty());
      web.owner.handler.drain();check("Coalesced acquisition notifications do not replay a deferred load",session.loads.size()==1&&ChromiumRouteLease.snapshot().surfaces==1);
    }finally{if(change!=null)change.close();dispose(web);}
  }
  static void releaseAndDownload(){
    WebBoundary web=fresh();ChromiumRouteLease.Handle download=null;final int[] finalWake={0},lockChecks={0};
    Runnable listener=()->{if(Thread.holdsLock(ChromiumRouteLease.PROCESS))throw new AssertionError("Registry mutex held during callback");lockChecks[0]++;if(!ChromiumRouteLease.held()&&ChromiumRouteLease.snapshot().changes==0)finalWake[0]++;};
    ChromiumRouteLease.addListener(listener);try{
      SessionBoundary first=site(web,FIRST),popup=site(web,SECOND);web.retainGeneralRoute(first,FIRST);web.retainGeneralRoute(popup,SECOND);download=ChromiumRouteLease.acquireDownload();web.deferredGeneralLoads.put(first,FIRST);web.deferredGeneralLoads.put(popup,SECOND);
      web.forgetGeneralRoute(first);check("Forgetting one page preserves popup and native download",ChromiumRouteLease.snapshot().surfaces==1&&ChromiumRouteLease.snapshot().downloads==1&&!web.generalSessions.contains(first)&&!web.deferredGeneralLoads.containsKey(first)&&web.generalRoutes.containsKey(popup));
      web.forgetGeneralRoute(popup);check("Closing all generic pages keeps native download ownership",ChromiumRouteLease.snapshot().surfaces==0&&ChromiumRouteLease.snapshot().downloads==1&&finalWake[0]==0&&web.generalRouteReady());
      download.close();check("Final native work release notifies one unlocked empty-state wake",!ChromiumRouteLease.held()&&finalWake[0]==1&&lockChecks[0]==6);
      download.close();web.forgetGeneralRoute(first);web.forgetGeneralRoute(popup);check("Duplicate closes do not notify or decrement again",finalWake[0]==1&&lockChecks[0]==6&&ChromiumRouteLease.snapshot().surfaces==0&&ChromiumRouteLease.snapshot().downloads==0);
      web.owner.handler.drain();check("Final close leaves no desired page to reacquire or reload",!ChromiumRouteLease.held()&&first.loads.isEmpty()&&popup.loads.isEmpty());
    }finally{ChromiumRouteLease.removeListener(listener);if(download!=null)download.close();dispose(web);}
  }
  static void offMainRetry(){
    WebBoundary web=fresh();try{
      SessionBoundary session=site(web,FIRST);web.generalSessions.add(session);Looper.current=null;web.queueGeneralRouteRetry();
      check("Off-main callback posts before reading or acquiring route state",web.owner.handler.queue.size()==1&&!ChromiumRouteLease.held());
      web.owner.handler.drain();check("Main-owned retry acquires the desired route once",web.generalRouteReady()&&ChromiumRouteLease.snapshot().surfaces==1);
    }finally{Looper.current=Looper.MAIN;dispose(web);}
  }
  static void popupCreation(){
    for(String target:new String[]{FIRST,SECOND,"https://chatgpt.com/c/popup","about:blank"}){
      WebBoundary web=fresh();try{
        SessionBoundary opener=site(web,"https://chatgpt.com/c/opener");web.current=opener;
        ResultBoundary<SessionBoundary> result=web.onNewSession(opener,target);boolean generic=target.equals(FIRST)||target.equals(SECOND);
        check("Actual popup callback constructs one admitted page: "+target,result!=null&&result.value!=null&&web.constructCalls==1&&web.popups.equals(Arrays.asList(result.value))&&web.locations.get(result.value).equals(target));
        check("Only generic popup targets retain an actual surface lease: "+target,ChromiumRouteLease.snapshot().surfaces==(generic?1:0)&&web.generalSessions.contains(result.value)==generic&&web.generalRoutes.containsKey(result.value)==generic);
        check("Actual popup activation waits for the main handler",web.activations==0&&web.current==opener);
        web.owner.handler.drain();check("Actual admitted popup activates once on its posted callback",web.activations==1&&web.current==result.value);
      }finally{dispose(web);}
    }
  }
  static void popupFailure(){
    WebBoundary web=fresh();try{
      SessionBoundary opener=site(web,"https://chatgpt.com/c/opener");web.current=opener;web.failConstruction=true;
      ResultBoundary<SessionBoundary> result=web.onNewSession(opener,FIRST);
      check("Popup constructor failure releases its unregistered acquired lease",result!=null&&result.value==null&&!ChromiumRouteLease.held()&&ChromiumRouteLease.snapshot().surfaces==0);
      check("Failed popup constructor never registers or activates a partial page",web.constructCalls==1&&web.popups.isEmpty()&&web.generalSessions.isEmpty()&&web.generalRoutes.isEmpty()&&web.locations.size()==1&&!web.owner.message.isEmpty());
      web.owner.handler.drain();check("Failed popup callbacks cannot recreate a page or acquire again",web.constructCalls==1&&web.activations==0&&!ChromiumRouteLease.held());
      ChromiumRouteLease.Handle change=ChromiumRouteLease.tryChange();check("Constructor failure leaves subsequent route maintenance admissible",change!=null);if(change!=null)change.close();
    }finally{dispose(web);}
    web=fresh();ChromiumRouteLease.Handle download=null;try{
      SessionBoundary opener=site(web,FIRST);web.current=opener;web.retainGeneralRoute(opener,FIRST);download=ChromiumRouteLease.acquireDownload();web.failConstruction=true;
      ResultBoundary<SessionBoundary> result=web.onNewSession(opener,SECOND);
      check("Failed popup releases only its own acquired lease",result.value==null&&ChromiumRouteLease.snapshot().surfaces==1&&ChromiumRouteLease.snapshot().downloads==1&&web.generalRoutes.containsKey(opener)&&web.popups.isEmpty());
    }finally{if(download!=null)download.close();dispose(web);}
  }
  static void popupBarrier(){
    WebBoundary web=fresh();ChromiumRouteLease.Handle change=ChromiumRouteLease.tryChange();try{
      SessionBoundary opener=site(web,"https://chatgpt.com/c/opener");web.current=opener;
      ResultBoundary<SessionBoundary> blocked=web.onNewSession(opener,FIRST);
      check("Actual popup callback refuses before construction under change barrier",blocked.value==null&&web.constructCalls==0&&web.popups.isEmpty()&&ChromiumRouteLease.snapshot().surfaces==0);
      change.close();web.owner.handler.drain();ResultBoundary<SessionBoundary> retry=web.onNewSession(opener,FIRST);
      check("Explicit popup retry succeeds after the change barrier closes",retry.value!=null&&web.constructCalls==1&&ChromiumRouteLease.snapshot().surfaces==1);
    }finally{if(change!=null)change.close();dispose(web);}
  }
  static void popupDenial(){
    for(String kind:new String[]{"destroyed","failed","crashed","wrong-opener","native-protection","identity","guard","limit","private-target"}){
      WebBoundary web=fresh();try{
        SessionBoundary opener=site(web,"https://chatgpt.com/c/opener");web.current=opener;SessionBoundary caller=opener;String target=FIRST;
        if(kind.equals("destroyed"))web.destroyed=true;else if(kind.equals("failed"))web.failed=true;else if(kind.equals("crashed"))web.crashed.add(opener);else if(kind.equals("wrong-opener"))caller=new SessionBoundary();else if(kind.equals("native-protection"))web.networkAllowed=false;else if(kind.equals("identity"))web.identityAllowed=false;else if(kind.equals("guard"))web.owner.guard.blocked=true;else if(kind.equals("limit"))for(int i=0;i<8;i++)web.popups.add(new SessionBoundary());else target="http://127.0.0.1/private";
        ResultBoundary<SessionBoundary> denied=web.onNewSession(caller,target);
        check("Denied actual popup callback acquires no lease or session: "+kind,denied.value==null&&web.constructCalls==0&&!ChromiumRouteLease.held());
      }finally{dispose(web);}
    }
  }
  static void popupLate(String kind){
    WebBoundary web=fresh();ChromiumRouteLease.Handle download=null;try{
      SessionBoundary opener=site(web,FIRST);web.current=opener;web.retainGeneralRoute(opener,FIRST);download=ChromiumRouteLease.acquireDownload();
      if(kind.equals("failed"))web.failed=true;else web.crashed.add(opener);
      ResultBoundary<SessionBoundary> result=web.onNewSession(opener,SECOND);
      check("Late unavailable opener cannot construct or acquire a popup: "+kind,result.value==null&&web.constructCalls==0&&web.popups.isEmpty()&&ChromiumRouteLease.snapshot().surfaces==1&&ChromiumRouteLease.snapshot().downloads==1&&web.generalRoutes.containsKey(opener));
    }finally{if(download!=null)download.close();dispose(web);}
  }
  public static void main(String[] args){
    if(args.length==1){if(args[0].equals("identity"))identityReadiness();else if(args[0].equals("barrier"))barrier();else if(args[0].equals("release"))blockedRelease();else if(args[0].equals("destroyed"))deniedExisting("destroyed");else if(args[0].equals("popup-failure"))popupFailure();else if(args[0].equals("popup-failed"))popupLate("failed");else if(args[0].equals("popup-crashed"))popupLate("crashed");else denial(args[0]);}
    else{readiness();identityReadiness();for(String kind:new String[]{"destroyed","failed","crashed","blocked","unprotected","native-protection"})denial(kind);deniedExisting();blockedRelease();barrier();releaseAndDownload();offMainRetry();popupCreation();popupFailure();popupBarrier();popupDenial();popupLate("failed");popupLate("crashed");}
    check("Fixture ends with no actual process registry hold or barrier",!ChromiumRouteLease.held()&&ChromiumRouteLease.snapshot().changes==0);
    System.out.println(J.obj("status","passed","passed",checks.length(),"total",checks.length(),"checks",checks,"syntheticControlledHost",true,"actualAndroidExecution",false,"actualGeckoExecution",false,"actualNetworkExecution",false).toString());
  }
}

class WebBoundary {
  @PRODUCTION_FIELDS@
  @PRODUCTION_MEMBERS@
  final OwnerBoundary owner=new OwnerBoundary();boolean destroyed,failed,ready=true,networkAllowed=true,generalRouteRetryQueued,failConstruction,identityAllowed=true;int constructCalls,activations;
  SessionBoundary current;ProtectionRestore generalRestore;String queued="";
  WebBoundary(){ChromiumRouteLease.addListener(routeLeaseChanged);}
  boolean protectionAllowsNetwork(){return networkAllowed;}
  boolean allowedUrl(String value){return GeckoNavigationPolicy.publicWeb(value);}
  boolean identityRequestAllowed(String value){return identityAllowed;}
  SessionBoundary newSession(){constructCalls++;if(failConstruction)throw new IllegalStateException("Controlled SDK constructor failure");return new SessionBoundary();}
  void activate(SessionBoundary session){activations++;current=session;}
  void restoreCheckpoint(SessionBoundary session,SessionBoundary.SessionState state,String url,long revision){throw new AssertionError("Unexpected SDK state restore boundary");}
  void loadUrl(String url){throw new AssertionError("Unexpected native URL dispatch boundary");}
}
class SessionBoundary {
  static class SessionState {}
  final List<String> loads=new ArrayList<>();boolean open=true;
  boolean isOpen(){return open;}
  void loadUri(String uri){loads.add(uri);}
}
class ResultBoundary<T> {final T value;ResultBoundary(T value){this.value=value;}static <T>ResultBoundary<T> fromValue(T value){return new ResultBoundary<>(value);}}
class OwnerBoundary {final GuardBoundary guard=new GuardBoundary();final HandlerBoundary handler=new HandlerBoundary();long navigationEpoch=1;String message="";void setStatus(String value){message=value;}}
class GuardBoundary {boolean blocked,protectedRoute=true;boolean allowed(){return !blocked&&protectedRoute;}boolean routeProtected(){return protectedRoute;}}
class MainActivity {static boolean chatUrl(String url){try{return BrowserRuntimePolicy.official(URI.create(url));}catch(Exception invalid){return false;}}}
class Looper {static final Object MAIN=new Object();static Object current=MAIN;static Object myLooper(){return current;}}
class HandlerBoundary {
  final List<Runnable> queue=new ArrayList<>();Object getLooper(){return Looper.MAIN;}void post(Runnable task){queue.add(task);}
  void drain(){Object prior=Looper.current;Looper.current=Looper.MAIN;try{int count=0;while(!queue.isEmpty()){if(++count>1000)throw new AssertionError("Unbounded retry loop");queue.remove(0).run();}}finally{Looper.current=prior;}}
}

package local.pocketchat;

import java.net.URI;
import java.util.*;
import org.json.*;

/** Actual session navigation/persistence methods with explicit JVM boundaries. */
public final class SessionNavigationHost {
  static final String GPT="https://chatgpt.com/c/cached",HTTP="http://example.com/article?q=1",HTTPS="https://www.wikipedia.org/wiki/Browser",DIAGNOSTIC="https://detector.example.com/pocketchat-identity/v1/document?nonce=0123456789abcdef0123456789abcdef";
  static final JSONArray checks=new JSONArray();
  static void check(String name,boolean pass){checks.put(J.obj("name",name,"pass",pass));if(!pass)throw new AssertionError(name);}
  static ChatSession fresh(){ChatSession s=new ChatSession();s.conversation=GPT;s.web.url="https://source.example.com/start";s.prefs.values.put("conversation",GPT);s.prefs.values.put("url",GPT);s.entries=J.arr(J.obj("fixture","cached GPT text"));s.state=J.obj("fixture","cached GPT state");s.stateEpoch=4;s.pageMemory.restorePending=true;return s;}
  static void generic(){
    for(String url:new String[]{HTTP,HTTPS}){
      ChatSession s=fresh();s.browse(url,"Open generic page");
      check("Generic browse reaches the actual loadNavigation dispatch: "+url,s.web.loads.equals(Arrays.asList(url))&&s.navigationTarget.equals(url)&&s.navigationEpoch==5&&s.navigationDispatched);
      check("Generic browse preserves GPT conversation and saved conversation: "+url,s.conversation.equals(GPT)&&s.prefs.getString("conversation","").equals(GPT)&&s.prefs.getString("url","").equals(GPT));
      check("Generic browse has no GPT transcript store binding: "+url,s.webStore.current.equals("")&&s.webStore.flushes==1&&s.webMirror.resets==1);
      check("Generic browse clears old GPT entries state and restore request: "+url,s.entries.length()==0&&s.state.length()==0&&s.stateEpoch==-1&&!s.showingCache&&!s.pageMemory.restorePending&&s.cache.reads==0);
      check("Generic page is remembered in its own browser URL preference: "+url,s.browsingUrl.equals(url)&&s.prefs.getString("geckoBrowserUrl","").equals(url));
      check("Generic source navigation injects no GPT navigation-token script: "+url,s.web.scripts.isEmpty()&&s.pageMemory.captures==1);
    }
    ChatSession s=fresh();s.offline=true;s.navigate(HTTP,"Offline browse",false);
    check("Offline generic navigation keeps intent without dispatching network",s.web.loads.isEmpty()&&s.finishes==1&&s.lastFinish.contains("离线")&&s.navigationTarget.equals(HTTP)&&!s.pageMemory.restorePending&&s.conversation.equals(GPT));
    s=fresh();s.navigate(HTTPS,"Without capture",false);
    check("Explicit no-capture overload still loads a generic website",s.web.loads.equals(Arrays.asList(HTTPS))&&s.pageMemory.captures==0&&s.web.scripts.isEmpty());
  }
  static void gpt(){
    ChatSession s=fresh();String next="https://chatgpt.com/c/next";s.compact=false;s.browse(next,"Open GPT");
    check("GPT positive navigation retains its conversation and transcript binding",s.conversation.equals(next)&&s.webStore.current.equals(next)&&s.pageMemory.restorePending&&s.web.loads.equals(Arrays.asList(next)));
    check("GPT positive navigation uses its existing cache path",s.cache.reads==1&&s.entries==s.cache.messages&&s.entries.length()==1&&s.showingCache);
    s=fresh();s.compact=true;s.browse(next,"Compact GPT");
    check("Compact GPT positive navigation avoids the legacy cached transcript",s.cache.reads==0&&s.entries.length()==0&&s.webStore.current.equals(next)&&s.pageMemory.restorePending);
    s=fresh();s.web.url=GPT;s.browse(HTTP,"Leave GPT");
    check("Leaving GPT retains only the existing explicit navigation token",s.web.scripts.size()==1&&s.web.scripts.get(0).equals("window.__pocketNavigationToken="+s.navigationEpoch)&&s.conversation.equals(GPT)&&!s.pageMemory.restorePending);
  }
  static void persistence(){
    ChatSession s=fresh();s.rememberBrowserLocation(HTTPS);int writes=s.prefs.applies;s.rememberBrowserLocation(HTTPS);
    check("Remembering an unchanged generic location avoids duplicate writes",s.prefs.applies==writes&&s.browsingUrl.equals(HTTPS)&&s.prefs.getString("conversation","").equals(GPT));
    for(String url:new String[]{DIAGNOSTIC,"https://detector.example.com/x/../pocketchat-identity/v1/result?nonce=0123456789abcdef0123456789abcdef","https://detector.example.com/%70ocketchat-identity/v1/document?nonce=0123456789abcdef0123456789abcdef","http://127.0.0.1/","http://192.168.1.1/","javascript:controlled","https://chatgpt.com/auth/login"}){
      s=fresh();s.rememberBrowserLocation(HTTPS);s.rememberBrowserLocation(url);
      check("Private diagnostic or login location never replaces saved browser URL: "+url,s.browsingUrl.equals(MainActivity.chatUrl(url)&&LoginPagePolicy.login(url)?url:HTTPS)&&s.prefs.getString("geckoBrowserUrl","").equals(HTTPS)&&s.prefs.getString("conversation","").equals(GPT));
      check("Private diagnostic or login location is not resumable: "+url,!ChatSession.resumable(url));
    }
    for(String url:new String[]{DIAGNOSTIC,"https://detector.example.com/%70ocketchat-identity/v1/document?nonce=0123456789abcdef0123456789abcdef","http://127.0.0.1/","file:///private","javascript:controlled"}){
      s=fresh();s.browse(url,"Must refuse");
      check("Private or diagnostic browse never navigates or mutates persistence: "+url,s.web.loads.isEmpty()&&s.navigationEpoch==4&&s.webStore.flushes==0&&s.prefs.applies==0&&s.conversation.equals(GPT)&&s.web.scripts.isEmpty()&&!s.status.isEmpty());
    }
    for(String login:new String[]{"https://accounts.google.com/o/oauth2/v2/auth","https://appleid.apple.com/auth/authorize","https://login.microsoftonline.com/common/oauth2/authorize","https://auth.openai.com/authorize"}){
      s=fresh();s.browse(login,"Explicit public login");
      check("Ordinary public login saves its browser location independently of GPT: "+login,s.web.loads.equals(Arrays.asList(login))&&s.browsingUrl.equals(login)&&s.prefs.getString("geckoBrowserUrl","").equals(login)&&s.conversation.equals(GPT)&&s.prefs.getString("conversation","").equals(GPT)&&!s.pageMemory.restorePending);
      // Loading is an explicit boundary, so separately supply its committed URL.
      s.web.url=login;
      check("Ordinary public login remains a resumable live generic website: "+login,ChatSession.resumable(login)&&s.resumeUrl().equals(login));
    }
  }
  static void resume(){
    ChatSession s=fresh();s.web.url=HTTP;s.browsingUrl=HTTPS;s.prefs.values.put("geckoBrowserUrl","https://saved.example.com/start");
    check("Live generic current page wins over old GPT and saved browser URLs",s.resumeUrl().equals(HTTP));
    s.web.url="";check("In-memory generic browser location precedes old GPT",s.resumeUrl().equals(HTTPS));
    s.browsingUrl="";check("Saved generic browser location precedes old GPT conversation",s.resumeUrl().equals("https://saved.example.com/start"));
    s.prefs.values.put("geckoBrowserUrl",DIAGNOSTIC);check("Diagnostic saved browser URL is skipped for known GPT",s.resumeUrl().equals(GPT));
    s.prefs.values.put("geckoBrowserUrl",HTTPS);s.requestedConversation="https://chatgpt.com/c/explicit";check("Explicit requested GPT conversation retains its priority",s.resumeUrl().equals(s.requestedConversation));
    for(String bad:new String[]{DIAGNOSTIC,"http://127.0.0.1/","https://chatgpt.com/auth/login"}){
      s=fresh();s.web.url=bad;s.browsingUrl=bad;s.prefs.values.put("geckoBrowserUrl",bad);check("Unsafe current browser state is never resumed: "+bad,s.resumeUrl().equals(GPT));
    }
  }
  static void pending(){
    ChatSession s=fresh();s.web.url=HTTP;s.browsingUrl=HTTPS;s.prefs.values.put("geckoBrowserUrl",HTTPS);s.requestedConversation="https://chatgpt.com/c/requested";String confirmed="https://chatgpt.com/c/confirmed",expected="https://chatgpt.com/c/expected";
    s.pending=J.obj("confirmedUrl",confirmed,"expectedUrl",expected);
    check("Bound pending confirmed GPT URL wins over all browser restoration",s.resumeUrl().equals(confirmed));
    s.pending=J.obj("confirmedUrl",DIAGNOSTIC,"expectedUrl",expected);check("Pending expected GPT conversation remains the next recovery target",s.resumeUrl().equals(expected));
    s.pending=J.obj("confirmedUrl","https://chatgpt.com/auth/login","expectedUrl","https://chatgpt.com/");check("Unbound pending home and GPT login do not replace the explicit conversation",s.resumeUrl().equals(s.requestedConversation));
  }
  static void homepage(){
    ChatSession s=fresh();s.conversation="";s.web.url="";s.prefs.values.clear();s.context.preferences=s.prefs;s.prefs.values.put("browserHomeUrl","https://docs.example.com/start");
    check("Fresh session honors configured BrowserPreferences home",s.resumeUrl().equals("https://docs.example.com/start"));
    s.prefs.values.put("browserHomeUrl","EXAMPLE.COM/Welcome");check("Fresh session home uses the actual saved-home normalizer",s.resumeUrl().equals("https://example.com/Welcome"));
    s.prefs.values.put("browserHomeUrl","http://127.0.0.1/");check("Invalid configured home retains the established safe default",s.resumeUrl().equals("https://chatgpt.com/"));
    s.prefs.values.put("browserHomeUrl","https://docs.example.com/start");s.prefs.values.put("url","http://localhost/private");check("Invalid old URL falls back to the configured generic home",s.resumeUrl().equals("https://docs.example.com/start"));
  }
  static void matching(){
    ChatSession s=fresh();s.navigationTarget="https://example.com/path?old=1";
    check("Actual session target matching ignores only query and fragment",s.targetMatches("https://example.com/path?new=2#part"));
    check("Same path on another host is never the current navigation target",!s.targetMatches("https://other.example.com/path"));
    check("Different scheme or port is never the current navigation target",!s.targetMatches("http://example.com/path")&&!s.targetMatches("https://example.com:8443/path"));
  }
  static void busy(){
    for(String kind:new String[]{"pending","submitting","operation","chooser","preparation","transfer"}){
      ChatSession s=fresh();
      if(kind.equals("pending"))s.pending=J.obj("id","confirmed-task");
      else if(kind.equals("submitting"))s.submitting=true;
      else if(kind.equals("operation"))s.operation=true;
      else if(kind.equals("chooser"))s.resourceChoosers=1;
      else if(kind.equals("preparation"))s.resourceFilePreparations=1;
      else s.transferActive=true;
      JSONObject task=s.pending;boolean submitting=s.submitting,operation=s.operation,transfer=s.transferActive;
      int choosers=s.resourceChoosers,preparations=s.resourceFilePreparations;
      boolean accepted=s.browse(HTTPS,"Explicit browser navigation");
      check("A pending task does not block explicit browser navigation: "+kind,accepted&&s.web.loads.equals(Arrays.asList(HTTPS))&&s.navigationEpoch==5);
      check("Browser navigation preserves independent native task state: "+kind,s.pending==task&&s.submitting==submitting&&s.operation==operation&&s.transferActive==transfer&&s.resourceChoosers==choosers&&s.resourceFilePreparations==preparations);
    }
    for(String source:new String[]{"https://source.example.com/start",GPT}){
      ChatSession s=fresh();s.web.url=source;s.resourceUploads.add(Arrays.asList("controlled.txt"),"",s.navigationEpoch,1000);
      check("Upload fixture uses actual unknown active ResourceUploadState: "+source,s.resourceUploads.unknown(s.navigationEpoch)&&s.resourceUploads.active(s.navigationEpoch));
      boolean accepted=s.browse(HTTPS,"Leave upload document");
      check("An unknown upload does not block its document from navigating: "+source,accepted&&s.web.loads.equals(Arrays.asList(HTTPS)));
      check("Old upload observation does not belong to the new navigation epoch: "+source,!s.resourceUploads.active(s.navigationEpoch));
    }
    ChatSession s=fresh();s.web.url=GPT;s.attachments=J.arr(J.obj("state","uploading"));
    check("Observed GPT attachment upload does not lock URL entry",s.browse(HTTPS,"Leave GPT upload")&&s.web.loads.equals(Arrays.asList(HTTPS)));
    s=fresh();s.deleted=true;
    check("A deleted environment cannot accept browser navigation",!s.browse(HTTPS,"Deleted environment")&&s.web.loads.isEmpty()&&s.navigationEpoch==4);
  }
  static JSONObject webPending(String url,boolean confirmed){return J.obj("id","background-web-task","kind","web","engine","gecko","confirmed",confirmed,"confirmedUrl",confirmed?url:"","expectedUrl",url,"prompt","Preserve this original prompt");}
  static void replyScope(){
    for(String source:new String[]{"https://source.example.com/start",GPT,"https://chatgpt.com/c/another"}){
      ChatSession s=fresh();JSONObject job=webPending(GPT,true);String original=job.toString();s.pending=job;s.prefs.values.put("pending",original);s.web.url=source;
      check("A web reply never blocks explicit URL entry: "+source,s.browse(HTTPS,"Leave reply")&&s.web.loads.equals(Arrays.asList(HTTPS)));
      check("Session delegates page observation retirement to its observer: "+source,s.webObserver.navigationTargets.equals(Arrays.asList(HTTPS))&&s.pending==job&&original.equals(job.toString())&&s.prefs.getString("pending","").equals(original));
    }
    for(String source:new String[]{"https://chatgpt.com/","https://chatgpt.com/g/test-gpt/"}){
      ChatSession s=fresh();s.pending=webPending(source,false);s.web.url=source+"c/new-conversation";
      check("An unconfirmed first reply does not block switching websites: "+source,s.browse(HTTPS,"Leave first reply")&&s.web.loads.equals(Arrays.asList(HTTPS)));
    }
    ChatSession s=fresh();s.pending=webPending(GPT,false);s.pending.remove("expectedUrl");s.web.url=GPT;
    check("An unknown reply route cannot lock URL entry",s.browse(HTTPS,"Leave unknown reply")&&s.web.loads.equals(Arrays.asList(HTTPS)));
    s=fresh();s.web.url=GPT;s.state=J.obj("url",GPT,"busy",true);s.stateEpoch=s.navigationEpoch;
    check("Current observed generation without a pending record does not lock URL entry",s.browse(HTTPS,"Leave observed reply")&&s.web.loads.equals(Arrays.asList(HTTPS)));
    for(boolean staleEpoch:new boolean[]{true,false}){
      s=fresh();s.web.url=GPT;s.state=J.obj("url",staleEpoch?GPT:"https://chatgpt.com/c/old","busy",true);s.stateEpoch=staleEpoch?s.navigationEpoch-1:s.navigationEpoch;
      check("A stale reply observation never blocks navigation: "+staleEpoch,s.browse(HTTPS,"Ignore old observation")&&s.web.loads.equals(Arrays.asList(HTTPS)));
    }
    s=fresh();s.web.url=GPT;Object port=new Object();s.web.ports.put(s.web.current,port);s.resourceObserverPort=port;s.resourceObserverEpoch=s.navigationEpoch;s.resourceWebsiteEpoch=s.navigationEpoch;s.resourceObserverBinding="current-binding";s.resourceObserverDocument="current-document";s.resourceObserverUrl=GPT;s.resourceObservedAt=500;s.resourceWebsiteBusy=true;
    check("A live resource observation does not lock URL entry",s.browse(HTTPS,"Leave observed document")&&s.web.loads.equals(Arrays.asList(HTTPS)));
    check("A new navigation invalidates its old resource observer",s.resourceObserverEpoch==-1);
    s=fresh();s.pending=J.obj("id","native-task");JSONObject task=s.pending;s.transferActive=true;s.resourceChoosers=1;s.resourceFilePreparations=1;s.inFlight=true;s.resourceUploadChecking=true;s.backgroundAttachmentCheck=true;s.backgroundAttachmentStable=3;s.resourceObserverEpoch=s.navigationEpoch;
    long epoch=s.prepareBrowserNavigation();
    check("History preparation invalidates old document callback ownership",epoch==5&&s.syncRun==1&&s.resourceInspectionGeneration==1&&s.resourceUploadCheckGeneration==1&&s.resourceObserverEpoch==-1&&!s.inFlight&&!s.resourceUploadChecking&&!s.backgroundAttachmentCheck&&s.backgroundAttachmentStable==0);
    check("History preparation leaves independent tasks and rendering dispatch to the caller",s.pending==task&&s.transferActive&&s.resourceChoosers==1&&s.resourceFilePreparations==1&&s.web.loads.isEmpty()&&s.web.stops==1&&!s.navigationDispatched);
    check("History back is available while independent native work continues",s.dispatchBrowserHistory(-1,epoch)&&s.web.back==1&&s.navigationDispatched&&s.pending==task&&s.transferActive);
    long next=s.prepareBrowserNavigation();
    check("A replaced history command cannot dispatch after a newer navigation",!s.dispatchBrowserHistory(1,epoch)&&s.web.forward==0&&!s.navigationDispatched);
    check("Current forward dispatch uses its captured epoch",s.dispatchBrowserHistory(1,next)&&s.web.forward==1&&s.navigationDispatched);
    s.prepareBrowserNavigation();
    check("Invalid history direction never reaches the browser",!s.dispatchBrowserHistory(0,s.navigationEpoch)&&s.web.back==1&&s.web.forward==1&&s.navigationDispatched);
    s.web.backAvailable=false;s.web.forwardAvailable=false;
    check("Unavailable history leaves the page unchanged",!s.dispatchBrowserHistory(-1,s.navigationEpoch)&&!s.dispatchBrowserHistory(1,s.navigationEpoch)&&s.web.back==1&&s.web.forward==1);
    s.deleted=true;
    check("A deleted environment cannot dispatch history",!s.dispatchBrowserHistory(-1,s.navigationEpoch)&&s.prepareBrowserNavigation()==-1);
  }
  static void reentrant(){
    for(String boundary:new String[]{"observer","audit","status","preferences","stop","script"}){
      ChatSession s=fresh();s.web.url=GPT;s.pending=J.obj("id","native-background");JSONObject nativeTask=s.pending;s.transferActive=true;
      Runnable newer=()->s.browse(HTTPS,"Newer command");
      if(boundary.equals("observer"))s.webObserver.onNavigation=newer;
      else if(boundary.equals("audit"))s.audit.onRetire=newer;
      else if(boundary.equals("status"))s.onStatus=newer;
      else if(boundary.equals("preferences"))s.prefs.onApply=newer;
      else if(boundary.equals("stop"))s.web.onStop=newer;
      else s.web.onScript=newer;
      check("Synchronous "+boundary+" callback cannot overwrite the newer browser command",s.browse(HTTP,"Older command")&&s.web.loads.equals(Arrays.asList(HTTPS))&&s.navigationTarget.equals(HTTPS)&&s.browsingUrl.equals(HTTPS)&&s.navigationDispatched&&(!boundary.equals("observer")||s.audit.retired==1));
      check("Synchronous "+boundary+" callback preserves independent native work",s.pending==nativeTask&&s.transferActive);
    }
    ChatSession s=fresh();s.web.onStop=()->s.browse(HTTPS,"Newer than history");long epoch=s.prepareBrowserNavigation();
    check("History preparation cannot adopt a reentrant command's epoch",epoch==-1&&!s.dispatchBrowserHistory(-1,epoch)&&s.web.back==0&&s.web.loads.equals(Arrays.asList(HTTPS))&&s.navigationDispatched);
    long current=s.navigationEpoch;s.cancelBrowserNavigation(current-1);
    check("Stale history cancellation cannot clear a newer loading command",s.navigationEpoch==current&&s.navigating&&s.navigationTarget.equals(HTTPS));
  }
  static void connectionNavigation(){
    for(boolean capturePending:new boolean[]{false,true}){
      for(boolean keep:new boolean[]{false,true}){
        ChatSession s=fresh();s.connecting=true;s.keepPageCandidate=keep;s.appliedIdentity=keep?"controlled-route":"";s.pageMemory.defer=capturePending;
        JSONObject nativeTask=J.obj("id","independent-native-task","kind","native","confirmedUrl",GPT);s.pending=nativeTask;
        s.browse(HTTPS,"Latest explicit browser command");long command=s.navigationEpoch;s.applyProxy("",s.connectionEpoch);
        check("Late connection preserves latest explicit target and epoch: "+capturePending+"/"+keep,s.navigationEpoch==command&&s.navigationTarget.equals(HTTPS)&&s.browsingUrl.equals(HTTPS)&&s.navigating&&s.pending==nativeTask);
        if(capturePending)s.pageMemory.complete(0);
        check("Connection recovery never dispatches the old page over an explicit URL: "+capturePending+"/"+keep,s.web.loads.equals(Arrays.asList(HTTPS))&&s.pending==nativeTask);
      }
    }
    ChatSession s=fresh();s.connecting=true;s.pageMemory.defer=true;s.browse(HTTP,"First URL");s.browse(HTTPS,"Latest URL");long latest=s.navigationEpoch;s.applyProxy("",s.connectionEpoch);
    check("Connection completion does not replace a newer queued command",s.navigationEpoch==latest&&s.navigationTarget.equals(HTTPS)&&s.web.loads.isEmpty());
    s.pageMemory.complete(0);s.pageMemory.complete(0);
    check("Only the latest URL dispatches after connection and late captures",s.web.loads.equals(Arrays.asList(HTTPS)));
    JSONObject nativeTask=J.obj("id","offline-native-task","kind","native","confirmedUrl",GPT);
    for(boolean keep:new boolean[]{false,true}){
      s=fresh();s.offline=true;s.keepPageCandidate=keep;s.appliedIdentity=keep?"controlled-route":"";s.pending=nativeTask;
      check("Offline URL entry is accepted without claiming a network load: "+keep,s.browse(HTTPS,"Offline choice")&&s.web.loads.isEmpty()&&!s.navigating);
      s.offline=false;s.connecting=true;s.applyProxy("",s.connectionEpoch);
      check("Coming online opens the user offline choice before an old native task: "+keep,s.web.loads.equals(Arrays.asList(HTTPS))&&s.navigationTarget.equals(HTTPS)&&s.pending==nativeTask);
    }
    s=fresh();s.browse(HTTPS,"Chosen page");s.web.url=HTTPS;s.navigating=false;s.pending=nativeTask;s.applyProxy("",s.connectionEpoch);
    check("A committed user page stays selected during later recovery",s.navigationTarget.equals(HTTPS)&&s.web.loads.stream().allMatch(HTTPS::equals)&&s.pending==nativeTask);
    s=fresh();s.pending=nativeTask;s.applyProxy("",s.connectionEpoch);
    check("Without an explicit browser command original pending recovery priority remains",s.web.loads.equals(Arrays.asList(GPT))&&s.pending==nativeTask);
    s=fresh();s.connecting=true;long history=s.prepareBrowserNavigation();s.applyProxy("",s.connectionEpoch);
    check("Connection completion does not retire a pending history command",s.navigationEpoch==history&&!s.navigationDispatched&&s.web.loads.isEmpty());
    check("The original history callback can dispatch once the connection is ready",s.dispatchBrowserHistory(-1,history)&&s.web.back==1&&s.navigationDispatched);
    s=fresh();s.pending=nativeTask;s.pageMemory.defer=true;s.browse(HTTPS,"Before network change");long connection=s.connectionEpoch;
    s.invalidateConnection();long invalidated=s.navigationEpoch;
    check("Network invalidation preserves explicit destination while retiring pending page work",!s.navigating&&s.navigationDispatched&&s.browsingUrl.equals(HTTPS)&&s.pending==nativeTask&&s.connectionEpoch==connection+1);
    s.applyProxy("",connection);
    check("Old connection completion cannot restart an invalidated route",!s.networkReady&&s.web.loads.isEmpty()&&s.navigationEpoch==invalidated);
    s.applyProxy("",s.connectionEpoch);
    check("An invalidated connection can restart the latest explicit browser target",s.networkReady&&s.navigationEpoch>invalidated&&s.navigationTarget.equals(HTTPS)&&s.pageMemory.pending.size()==2);
    s.pageMemory.complete(0);s.pageMemory.complete(0);
    check("Network recovery and old capture cannot dispatch a superseded URL",s.web.loads.equals(Arrays.asList(HTTPS))&&s.pending==nativeTask);
    s=fresh();s.navigating=true;s.stopBrowserNavigation();history=s.prepareBrowserNavigation();
    check("New history after Stop claims an active browser command",history>=0&&!s.browserNavigationStopped&&s.navigating&&!s.navigationDispatched);
    s.applyProxy("",s.connectionEpoch);
    check("Old Stop does not block the next explicit history command",s.dispatchBrowserHistory(-1,history)&&s.web.back==1&&!s.browserNavigationStopped);
    for(String boundary:new String[]{"guard","identity","audit"}){
      ChatSession current=fresh();current.browse(HTTP,"First page");Runnable newer=()->current.browse(HTTPS,"Newer command from network callback");
      if(boundary.equals("guard"))current.guard.onUnblock=newer;
      else if(boundary.equals("identity"))current.onIdentity=newer;
      else current.audit.onRefresh=newer;
      current.applyProxy("",current.connectionEpoch);
      check("A network "+boundary+" callback does not touch the newer page",current.navigationTarget.equals(HTTPS)&&current.browsingUrl.equals(HTTPS)&&current.web.loads.equals(Arrays.asList(HTTP,HTTPS))&&current.navigationDispatched&&(!boundary.equals("guard")||current.identityAcknowledgements==0)&&(!boundary.equals("identity")||current.audit.refreshes==0));
    }
    s=fresh();s.browse(HTTPS,"Explicit browser page");String login="https://chatgpt.com/auth/login";s.web.url=login;s.rememberBrowserLocation(login);
    check("A live login redirect remains the explicit browser resume destination",s.resumeUrl().equals(login)&&s.prefs.getString("geckoBrowserUrl","").equals(HTTPS)&&!ChatSession.resumable(login));
    ChatSession cold=fresh();cold.web.url="";cold.prefs.values.put("geckoBrowserUrl",s.prefs.getString("geckoBrowserUrl",""));
    check("A login redirect is not persisted as a cold-start destination",cold.resumeUrl().equals(HTTPS));
  }
  static void lateCapture(){
    ChatSession s=fresh();s.pageMemory.defer=true;s.browse(HTTP,"Deferred capture");check("Actual navigation waits for the declared capture completion boundary",s.web.loads.isEmpty()&&s.pageMemory.pending.size()==1);
    s.browse(HTTPS,"Replacement navigation");check("A newer navigation captures a distinct epoch",s.navigationEpoch==6&&s.pageMemory.pending.size()==2);
    s.pageMemory.complete(0);check("Late old capture cannot load the replaced target",s.web.loads.isEmpty());s.pageMemory.complete(0);check("Current capture still loads the newest target",s.web.loads.equals(Arrays.asList(HTTPS)));
  }
  static void stopNavigation(){
    ChatSession s=fresh();s.pending=webPending(GPT,true);JSONObject pending=s.pending;s.connecting=true;s.pageMemory.defer=true;s.browse(HTTP,"Deferred navigation");
    long connection=s.connectionEpoch,inspection=s.syncRun;s.inFlight=true;s.stopBrowserNavigation();s.pageMemory.complete(0);
    check("A stopped navigation cannot be revived by its late draft capture",s.web.loads.isEmpty()&&!s.navigating&&s.browserNavigationStopped&&s.web.stops==2);
    check("Stop preserves the independent network lease and background reply",s.connectionEpoch==connection&&s.connecting&&s.pending==pending&&!s.inFlight&&s.syncRun>inspection&&!s.pageMemory.restorePending);
    s.applyProxy("",connection);
    check("A late network connection can finish without restarting a stopped page",s.networkReady&&!s.connecting&&!s.guard.blocked&&s.identityAcknowledgements==1&&s.connectionEpoch==connection&&s.web.loads.isEmpty()&&s.browserNavigationStopped);
    check("A stopped page retains its reply record after network completion",s.pending==pending&&s.webObserver.readyCalls==0&&s.status.contains("已停止网页加载"));
    s.pageMemory.defer=false;s.browse(HTTPS,"Navigate after Stop");
    check("A new explicit navigation clears Stop and loads normally",!s.browserNavigationStopped&&s.navigating&&s.web.loads.equals(Arrays.asList(HTTPS))&&s.pending==pending);
    s=fresh();s.web.url=GPT;Object port=new Object();s.web.ports.put(s.web.current,port);s.navigating=true;s.resourceObserverPort=port;s.resourceObserverEpoch=s.navigationEpoch;s.resourceObserverBinding="old-binding";long previous=s.navigationEpoch;s.stopBrowserNavigation();
    check("Stopping a visible ChatGPT document rebinds observation to its new epoch",s.navigationEpoch==previous+1&&s.resourceObserverEpoch==s.navigationEpoch&&s.resourceObserverPort==port&&!s.resourceObserverBinding.isEmpty()&&!s.resourceObserverBinding.equals("old-binding")&&s.webObserver.readyCalls==1&&!s.awaitNewDocument);
    for(String task:new String[]{"reply","chooser","preparation","transfer","native"}){
      s=fresh();s.navigating=true;if(task.equals("reply")){s.web.url=GPT;s.state=J.obj("url",GPT,"busy",true);s.stateEpoch=s.navigationEpoch;}else if(task.equals("chooser"))s.resourceChoosers=1;else if(task.equals("preparation"))s.resourceFilePreparations=1;else if(task.equals("transfer"))s.transferActive=true;else s.pending=J.obj("id","native-task");
      previous=s.navigationEpoch;s.stopBrowserNavigation();
      check("Stop remains available during an active task: "+task,!s.navigating&&s.browserNavigationStopped&&s.navigationEpoch==previous+1&&s.web.stops==1);
      check("Stop does not cancel independent native work: "+task,task.equals("chooser")?s.resourceChoosers==1:task.equals("preparation")?s.resourceFilePreparations==1:task.equals("transfer")?s.transferActive:task.equals("native")?s.pending!=null:true);
    }
    s=fresh();s.navigating=true;s.stopBrowserNavigation();s.keepPageCandidate=true;s.appliedIdentity="controlled-route";s.applyProxy("",s.connectionEpoch);
    check("Keeping an existing page after connection recovery does not clear Stop",s.networkReady&&s.browserNavigationStopped&&s.web.loads.isEmpty());
    s=fresh();s.navigating=true;s.stopBrowserNavigation();s.applyProxy("",s.connectionEpoch-1);
    check("A stale connection callback cannot admit the network or clear Stop",!s.networkReady&&s.browserNavigationStopped&&s.web.loads.isEmpty());
  }
  public static void main(String[] args){
    if(args.length==1){switch(args[0]){case "generic":generic();break;case "persistence":persistence();break;case "resume":resume();break;case "pending":pending();break;case "home":homepage();break;case "busy":busy();break;case "reply-scope":replyScope();break;case "matching":matching();break;case "stop":stopNavigation();break;case "reentrant":reentrant();break;case "connection":connectionNavigation();break;default:throw new AssertionError("Unknown focus");}}
    else{generic();gpt();persistence();resume();pending();homepage();matching();busy();replyScope();lateCapture();stopNavigation();reentrant();connectionNavigation();}
    System.out.println(J.obj("status","passed","passed",checks.length(),"total",checks.length(),"checks",checks,"syntheticControlledHost",true,"actualAndroidExecution",false,"actualGeckoExecution",false,"actualNetworkExecution",false).toString());
  }
}


package local.pocketchat;
import java.net.URI;
import java.util.*;
import org.json.*;

/** Actual callbacks and observer dispatch; all browser/Android interfaces are boundaries. */
public final class ClientReadyHost {
  @CALLBACKS@
  final WebBoundary web=new WebBoundary();final ReadingBoundary reading=new ReadingBoundary();
  final AuditBoundary audit=new AuditBoundary();final ObserverBoundary webObserver=new ObserverBoundary(this);
  final PrefsBoundary prefs=new PrefsBoundary();final TraceBoundary trace=new TraceBoundary();
  String pageError="",connectionStage="",status="",resourceObserverBinding="synthetic-binding";
  long pageUsableAt;int awaiting,finishes,wakes,remembered,googleReads;boolean retry;
  boolean targetMatches(String url){return url.equals(web.url);}
  boolean replyObservationAllowed(){return true;}
  void rememberBrowserLocation(String url){remembered++;}
  void awaitLogin(String message){awaiting++;status=message;}
  void finishNavigation(String message,boolean value){finishes++;pageError=message;retry=value;}
  void setStatus(String message){status=message;}
  void checkGoogleLogin(String url){googleReads++;web.evaluateJavascript(LoginPagePolicy.blockedScript(),null);}
  void wakePolling(){wakes++;}
  static final JSONArray checks=new JSONArray();
  static void check(String name,boolean pass){checks.put(J.obj("name",name,"pass",pass));if(!pass)throw new AssertionError(name);}
  static ClientReadyHost page(String url){ClientReadyHost h=new ClientReadyHost();h.web.url=url;return h;}
  static void generic(){
    for(String url:new String[]{"https://example.org/form","http://example.org/form","https://chatgpt.com:8443/form","https://other.chatgpt.com/form"}){
      ClientReadyHost h=page(url);h.onPageFinished(h.web,url);
      check("Public page is ready without ChatGPT script: "+url,h.web.scripts.isEmpty()&&h.googleReads==0);
      check("Public page reports real ready state: "+url,h.finishes==1&&h.pageError.isEmpty()&&h.pageUsableAt>0&&h.trace.usable>0&&h.awaiting==0);
      check("Public page remembers only browser location: "+url,h.remembered==1&&h.prefs.values.isEmpty()&&h.wakes==0);
      check("HTTP visibility is explicit: "+url,h.status.contains("HTTP 连接未加密")==url.startsWith("http:"));
    }
  }
  static void google(){
    ClientReadyHost h=page("https://accounts.google.com/signin/v2/identifier");h.onPageFinished(h.web,h.web.url);
    check("Google login ready does not inspect website DOM",h.googleReads==0&&h.web.scripts.isEmpty());
    check("Google login page is ordinary ready website",h.awaiting==0&&h.finishes==1&&h.pageError.isEmpty()&&h.status.equals("网页已打开")&&h.remembered==1);
  }
  static void logins(){
    for(String host:new String[]{"accounts.google.com","appleid.apple.com","login.live.com","login.microsoftonline.com","auth.openai.com","auth0.openai.com"}){
      ClientReadyHost h=page("https://"+host+"/login");h.onPageFinished(h.web,h.web.url);
      check("External login is browser ready: "+host,h.awaiting==0&&h.finishes==1&&h.pageError.isEmpty()&&h.status.equals("网页已打开"));
      check("External login has no GPT DOM or cookie dispatch: "+host,h.web.scripts.isEmpty()&&h.googleReads==0&&h.prefs.values.isEmpty());
    }
  }
  static void chat(){
    ClientReadyHost h=page("https://chatgpt.com/c/owned");h.onPageFinished(h.web,h.web.url);
    check("ChatGPT observer still dispatches on its exact origin",h.web.scripts.size()==1&&h.web.scripts.get(0).contains("CONTROLLED_GPT_OBSERVER"));
    check("ChatGPT URL persistence and polling remain",h.web.url.equals(h.prefs.values.get("url"))&&h.remembered==1&&h.wakes==1&&h.awaiting==0&&h.finishes==0);
    h=page("https://chatgpt.com/auth/login");h.onPageFinished(h.web,h.web.url);
    check("ChatGPT auth retains its waiting-login behavior",h.awaiting==1&&h.finishes==0&&h.prefs.values.isEmpty());
    h=page("https://chatgpt.com/c/current");h.onPageFinished(h.web,"https://accounts.google.com/login");
    check("Stale finish callback changes no current page state",h.web.scripts.isEmpty()&&h.reading.visible==0&&h.remembered==0&&h.awaiting==0&&h.finishes==0);
    h=page("https://chatgpt.com/c/owned");h.audit.selected=true;h.onPageFinished(h.web,h.web.url);
    check("Selected diagnostic retains its independent lifecycle",h.web.scripts.isEmpty()&&h.prefs.values.isEmpty()&&h.finishes==0&&h.awaiting==0);
  }
  static void errors(){
    for(String host:new String[]{"example.org","accounts.google.com","appleid.apple.com","login.microsoftonline.com","auth.openai.com"}){
      ClientReadyHost h=page("https://"+host+"/auth/login");h.onReceivedHttpError(h.web,new RequestBoundary(h.web.url,true),new ResponseBoundary(401));
      check("External login HTTP error is a website error: "+host,h.awaiting==0&&h.finishes==1&&h.pageError.contains("401")&&!h.retry&&h.web.scripts.isEmpty());
    }
    ClientReadyHost h=page("https://chatgpt.com/auth/login");h.onReceivedHttpError(h.web,new RequestBoundary(h.web.url,true),new ResponseBoundary(401));
    check("ChatGPT auth HTTP 401 still waits for login",h.awaiting==1&&h.finishes==0);
    h=page("https://example.org/login");h.onReceivedHttpError(h.web,new RequestBoundary(h.web.url,true),new ResponseBoundary(503));
    check("Public HTTP 503 keeps the existing error retry classification",h.finishes==1&&h.retry&&h.pageError.contains("503"));
    h=page("https://example.org/page");h.onReceivedHttpError(h.web,new RequestBoundary(h.web.url,false),new ResponseBoundary(401));
    check("Subresource HTTP errors do not replace the page status",h.awaiting==0&&h.finishes==0&&h.pageError.isEmpty());
  }
  public static void main(String[] args){String focus=args.length==0?"all":args[0];if(focus.equals("all")||focus.equals("generic"))generic();if(focus.equals("all")||focus.equals("google"))google();if(focus.equals("all")||focus.equals("logins"))logins();if(focus.equals("all")||focus.equals("chat"))chat();if(focus.equals("all")||focus.equals("errors"))errors();System.out.println(J.obj("status","passed","passed",checks.length(),"total",checks.length(),"checks",checks,"actualAndroidExecution",false,"actualGeckoExecution",false));}
}
final class ObserverBoundary {
  final ClientReadyHost session;String script="CONTROLLED_GPT_OBSERVER";
  ObserverBoundary(ClientReadyHost session){this.session=session;}
  @OBSERVER_READY@
}
final class WebBoundary {String url="";final List<String> scripts=new ArrayList<>();String getUrl(){return url;}boolean resourcePage(String value){return MainActivity.chatUrl(value);}void evaluateJavascript(String script,Object callback){scripts.add(script);}}
final class MainActivity {static boolean chatUrl(String value){try{return BrowserRuntimePolicy.official(new URI(value));}catch(Exception invalid){return false;}}}
final class ReadingBoundary {int visible;void visible(String url){visible++;}}
final class AuditBoundary {boolean selected;boolean identityPageFinished(String url){return false;}boolean requestIdentityPageSelected(){return selected;}boolean identityPageFailed(String url,String message){return false;}}
final class TraceBoundary {long usable;}
final class SystemClock {static long elapsedRealtime(){return 1000;}}
final class RequestBoundary {final URI uri;final boolean main;RequestBoundary(String url,boolean main){uri=URI.create(url);this.main=main;}URI getUrl(){return uri;}boolean isForMainFrame(){return main;}}
final class ResponseBoundary {final int code;ResponseBoundary(int code){this.code=code;}int getStatusCode(){return code;}}
final class PrefsBoundary {final Map<String,String> values=new HashMap<>();Editor edit(){return new Editor();}final class Editor {Editor putString(String key,String value){values.put(key,value);return this;}void apply(){}}}

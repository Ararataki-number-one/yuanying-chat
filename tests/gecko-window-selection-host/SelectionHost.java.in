package local.pocketchat;

import java.util.*;
import java.util.function.Consumer;

/** Controlled boundaries only; marked members and the request registry are production source. */
class GeckoRuntime {}
class GeckoSession {
  final String name;final Object document=new Object();final String draft,cookie;final int scroll=271;
  boolean open=true,active=true;int activationCalls;
  GeckoSession(String name){this.name=name;draft="unsent-"+name;cookie="session-"+name;}
  boolean isOpen(){return open;}
  void setActive(boolean value){active=value;activationCalls++;}
  void loadUri(String url){throw new AssertionError("Selecting a retained window must not load "+name);}
  void reload(){throw new AssertionError("Selecting a retained window must not reload "+name);}
  void stop(){throw new AssertionError("Selecting a retained window must not stop "+name);}
  void close(){open=false;}
}
class WebExtension {static class Port {final GeckoSession page;Port(GeckoSession page){this.page=page;}}}
class DisplayContext {Object base;Object getBaseContext(){return base;}}
class Surface {
  GeckoSession session;int releases,attachments;
  GeckoSession getSession(){return session;}
  void releaseSession(){releases++;session=null;}
  void setSession(GeckoSession value){attachments++;session=value;}
}
class Metadata {Object timeZonePolicy;}
class Privacy {int level(){return 2;}}
class Reading {
  final List<String> starts=new ArrayList<>(),visible=new ArrayList<>();int measured;
  void started(String value){starts.add(value);}
  void viewportMeasured(float value){measured++;}
  void visible(String value){visible.add(value);}
}
class Owner {
  GeckoWebView web;long navigationEpoch=17;boolean deleted,browserPaused;String pageError="previous error";
  int begins,changes,cancelled;long cancelledEpoch;Runnable beginHook;
  final Reading reading=new Reading();final Privacy privacy=new Privacy();
  final List<String> targets=new ArrayList<>();final List<Object> observerPorts=new ArrayList<>();
  long beginNavigation(String target,String label){
    begins++;targets.add(target);long epoch=++navigationEpoch;
    Runnable hook=beginHook;beginHook=null;if(hook!=null)hook.run();return epoch;
  }
  void cancelBrowserNavigation(long value){cancelled++;cancelledEpoch=value;}
  void resourceObserverConnected(Object value){observerPorts.add(value);}
  void changed(){changes++;}
}
class MainActivity {
  boolean destroyed,finishing;GeckoWebView remote;Owner session;
  boolean isFinishing(){return finishing;}
}
class GeckoAddressUi {
  /* ACTUAL_HOST_AVAILABILITY */
}
class WebViewClient {
  final GeckoWebView web;final List<GeckoSession> committed=new ArrayList<>(),finished=new ArrayList<>();
  final List<String> urls=new ArrayList<>();Runnable commitHook,finishHook;
  WebViewClient(GeckoWebView web){this.web=web;}
  void onPageCommitVisible(Object unused,String url){committed.add(web.current);urls.add(url);Runnable hook=commitHook;commitHook=null;if(hook!=null)hook.run();}
  void onPageFinished(Object unused,String url){finished.add(web.current);urls.add(url);Runnable hook=finishHook;finishHook=null;if(hook!=null)hook.run();}
}
class Clock implements BrowserBridgeRequests.Timer {
  final Set<Runnable> tasks=new HashSet<>();
  public void schedule(Runnable value,long millis){tasks.add(value);}
  public void cancel(Runnable value){tasks.remove(value);}
}
class GeckoWebView {
  final Owner owner=new Owner();final DisplayContext displayContext=new DisplayContext();
  GeckoRuntime runtime=new GeckoRuntime();Surface surface=new Surface();
  GeckoSession primary=new GeckoSession("primary"),current=primary;
  final ArrayList<GeckoSession> popups=new ArrayList<>();
  final Map<GeckoSession,String> locations=new IdentityHashMap<>();
  final Map<GeckoSession,WebExtension.Port> ports=new IdentityHashMap<>();
  final Map<GeckoSession,Boolean> backStates=new IdentityHashMap<>(),forwardStates=new IdentityHashMap<>();
  final Map<GeckoSession,Float> pageScales=new IdentityHashMap<>(),viewportWidths=new IdentityHashMap<>();
  final Set<GeckoSession> painted=Collections.newSetFromMap(new IdentityHashMap<>()),crashed=Collections.newSetFromMap(new IdentityHashMap<>());
  final Metadata metadata=new Metadata();final Clock clock=new Clock();
  final BrowserBridgeRequests callbacks=new BrowserBridgeRequests(clock,"null");
  final class Blocked {int invalidations;void invalidate(){invalidations++;}}
  final Blocked blockedPopups=new Blocked();
  boolean destroyed,failed,desktop,canBack,canForward,ready=true,exitIp;float readingLayout=1,scale=1;
  long aiHostRevision;
  String url;int auxiliaryCloses,zooms,configures;Runnable closeHook,configureHook;
  WebViewClient client=new WebViewClient(this);final MainActivity activity=new MainActivity();
  GeckoWebView(){owner.web=this;activity.remote=this;activity.session=owner;displayContext.base=activity;surface.session=primary;register(primary);url=locations.get(primary);}
  void register(GeckoSession value){locations.put(value,"https://example.test/"+value.name);ports.put(value,new WebExtension.Port(value));painted.add(value);}
  GeckoSession popup(String name){GeckoSession value=new GeckoSession(name);register(value);popups.add(value);return value;}
  boolean hasExitIpPage(){return exitIp;}
  boolean closeExitIpPage(){auxiliaryCloses++;boolean previous=exitIp;exitIp=false;Runnable hook=closeHook;closeHook=null;if(hook!=null)hook.run();return previous;}
  void cancelZoom(){zooms++;}
  Object timeZoneStatus(){return "controlled-system-timezone";}
  void configure(boolean desktop,int protection){configures++;Runnable hook=configureHook;configureHook=null;if(hook!=null)hook.run();}
  /* ACTUAL_WEB_MEMBERS */
}

public final class SelectionHost {
  static int checks;
  static void check(boolean condition,String label){if(!condition)throw new AssertionError(label);checks++;}
  static GeckoWebView.BrowserWindow row(GeckoWebView view,GeckoSession page){for(GeckoWebView.BrowserWindow value:view.browserWindows())if(value.page==page)return value;throw new AssertionError("Missing real open window "+page.name);}
  static void noNavigation(GeckoWebView view,String label){check(view.owner.begins==0&&view.client.committed.isEmpty()&&view.client.finished.isEmpty(),label);}
  static void retained(GeckoSession page,Object document,String label){check(page.document==document&&page.draft.equals("unsent-"+page.name)&&page.cookie.equals("session-"+page.name)&&page.scroll==271,label);}

  static void inventory(){
    GeckoWebView view=new GeckoWebView();GeckoSession open=view.popup("open"),closed=view.popup("closed"),crashed=view.popup("crashed"),untracked=view.popup("untracked");
    closed.close();view.crashed.add(crashed);view.locations.remove(untracked);
    GeckoSession foreign=new GeckoSession("startup-auxiliary");view.register(foreign);view.popups.add(view.primary);
    List<GeckoWebView.BrowserWindow> values=view.browserWindows();
    check(values.size()==2,"Only live tracked primary and popup sessions appear once");
    check(values.get(0).page==view.primary&&values.get(1).page==open,"Retain primary/popup order and exact SDK identity");
    check(values.get(0).primary&&values.get(0).selected&&!values.get(1).primary&&!values.get(1).selected,"Inventory selection describes actual foreground page");
    check(values.get(0).owner==view&&values.get(0).runtime==view.runtime&&values.get(0).source==view.current&&values.get(0).navigation==17,"Inventory captures original owner/runtime/source/epoch");
    check(values.get(1).url.equals(view.locations.get(open)),"Inventory retains actual per-session URL");
    view.exitIp=true;check(!row(view,view.primary).selected,"Auxiliary display does not falsely select the retained document");
    for(int condition=0;condition<5;condition++){
      GeckoWebView unavailable=new GeckoWebView();unavailable.popup("retained");
      if(condition==0)unavailable.destroyed=true;else if(condition==1)unavailable.owner.deleted=true;else if(condition==2)unavailable.ready=false;else if(condition==3)unavailable.runtime=null;else unavailable.surface=null;
      check(unavailable.browserWindows().isEmpty(),"Unavailable surface/runtime cannot expose switchable windows "+condition);
    }
    view.primary.close();check(view.browserWindows().size()==1&&view.browserWindows().get(0).page==open,"A closed primary is not reopened or inferred");
  }

  static void currentAndRetained(){
    GeckoWebView same=new GeckoWebView();Object document=same.primary.document;long epoch=same.owner.navigationEpoch;same.exitIp=true;
    check(same.selectBrowserWindow(row(same,same.primary),same.activity),"Selecting the same real page succeeds");
    check(!same.exitIp&&same.auxiliaryCloses==1,"Same-page selection only dismisses the auxiliary IP display");
    check(same.owner.navigationEpoch==epoch&&same.surface.releases==0&&same.surface.attachments==0&&same.configures==0,"Same-page selection does not activate or begin navigation");
    check(same.aiHostRevision==0,"Selecting the same tab preserves diagnostic host epoch");
    noNavigation(same,"Same-page selection has no fabricated page callbacks");retained(same.primary,document,"Same-page document/draft/cookie/position boundary stays unchanged");
    GeckoWebView view=new GeckoWebView();GeckoSession page=view.popup("popup");Object primaryDocument=view.primary.document,popupDocument=page.document;
    WebExtension.Port source=view.ports.get(view.primary),other=view.ports.get(page);List<String> cancelled=new ArrayList<>(),untouched=new ArrayList<>();
    view.callbacks.add(source,cancelled::add,1000);view.callbacks.add(other,untouched::add,1000);
    check(view.selectBrowserWindow(row(view,page),view.activity),"An existing real popup can be selected");
    check(view.aiHostRevision==1,"Switching native tabs retires prior diagnostic selection");
    check(view.current==page&&view.surface.session==page&&!view.primary.active&&page.active,"Actual activation transfers the retained surface");
    check(view.surface.releases==1&&view.surface.attachments==1&&view.configures==1,"Retained selection attaches once without constructing sessions");
    check(cancelled.equals(Collections.singletonList("null"))&&untouched.isEmpty()&&view.callbacks.size()==1&&view.clock.tasks.size()==1,"Production request registry cancels only the previous session's callbacks");
    check(view.owner.begins==1&&view.owner.targets.equals(Collections.singletonList(view.locations.get(page))),"Navigation observer announces exactly the retained selected URL");
    check(view.client.committed.equals(Collections.singletonList(page))&&view.client.finished.equals(Collections.singletonList(page)),"Painted session callbacks belong to the selected existing document");
    check(view.owner.observerPorts.get(view.owner.observerPorts.size()-1)==other,"Resource observer binds to the selected session's exact port");
    retained(view.primary,primaryDocument,"Primary document/draft/cookie/position is retained");retained(page,popupDocument,"Popup document/draft/cookie/position is retained");
    check(view.selectBrowserWindow(row(view,view.primary),view.activity)&&view.aiHostRevision==2,"Switch away and back cannot revive a previous diagnostic host epoch");
    GeckoWebView blank=new GeckoWebView();GeckoSession empty=blank.popup("blank");blank.locations.put(empty,"about:blank");blank.painted.remove(empty);
    check(blank.selectBrowserWindow(row(blank,empty),blank.activity)&&blank.owner.cancelled==1&&blank.owner.cancelledEpoch==blank.owner.navigationEpoch,"A retained blank window cancels only its own observer epoch");
    check(blank.client.committed.isEmpty()&&blank.client.finished.isEmpty(),"Unpainted blank page has no invented visible/finished callback");
  }

  static void staleSelections(){
    String[] faults={"null","foreign-owner","runtime","source","epoch","closed","removed","untracked","crashed","destroyed","deleted","unready","surface","host-context","host-remote","host-session","session-web","host-finishing","host-destroyed","host-null"};
    for(String fault:faults){
      GeckoWebView view=new GeckoWebView();GeckoSession page=view.popup("target");GeckoWebView.BrowserWindow selected=row(view,page);MainActivity host=view.activity;
      switch(fault){
        case "null":selected=null;break;case "foreign-owner":GeckoWebView other=new GeckoWebView();selected=row(other,other.primary);break;
        case "runtime":view.runtime=new GeckoRuntime();break;case "source":view.current=view.popup("new-source");break;
        case "epoch":view.owner.navigationEpoch++;break;case "closed":page.close();break;case "removed":view.popups.remove(page);break;
        case "untracked":view.locations.remove(page);break;case "crashed":view.crashed.add(page);break;case "destroyed":view.destroyed=true;break;
        case "deleted":view.owner.deleted=true;break;case "unready":view.ready=false;break;case "surface":view.surface=null;break;
        case "host-context":view.displayContext.base=new MainActivity();break;case "host-remote":host.remote=new GeckoWebView();break;
        case "host-session":host.session=new Owner();break;case "session-web":view.owner.web=new GeckoWebView();break;
        case "host-finishing":host.finishing=true;break;case "host-destroyed":host.destroyed=true;break;case "host-null":host=null;break;
      }
      check(!view.selectBrowserWindow(selected,host),"Stale selection is rejected: "+fault);
      noNavigation(view,"Stale selection cannot announce a navigation or page callback: "+fault);
      check(view.configures==0&&(view.surface==null||view.surface.releases==0),"Stale selection cannot activate any session: "+fault);
    }
  }

  static void activationReentry(){
    for(String fault:new String[]{"navigation","current","closed-target","deleted","destroyed","runtime","host-context","host-session","host-remote"}){
      GeckoWebView view=new GeckoWebView();GeckoSession target=view.popup("target"),winner=view.popup("winner");GeckoWebView.BrowserWindow selected=row(view,target);
      view.callbacks.add(view.ports.get(view.primary),value->{
        switch(fault){case "navigation":view.owner.navigationEpoch++;break;case "current":view.current=winner;break;
          case "closed-target":target.close();break;case "deleted":view.owner.deleted=true;break;case "destroyed":view.destroyed=true;break;
          case "runtime":view.runtime=new GeckoRuntime();break;case "host-context":view.displayContext.base=new MainActivity();break;
          case "host-session":view.activity.session=new Owner();break;case "host-remote":view.activity.remote=new GeckoWebView();break;}
      },1000);
      check(!view.selectBrowserWindow(selected,view.activity),"Synchronous cancellation retires the captured selection: "+fault);
      noNavigation(view,"Cancellation reentry cannot begin or finish the obsolete selection: "+fault);
      check(view.callbacks.size()==0&&view.clock.tasks.isEmpty(),"Actual cancelled bridge request and timer retire: "+fault);
    }
    GeckoWebView view=new GeckoWebView();GeckoSession target=view.popup("loser"),winner=view.popup("winner");GeckoWebView.BrowserWindow first=row(view,target),second=row(view,winner);
    view.callbacks.add(view.ports.get(view.primary),value->{check(view.selectBrowserWindow(second,view.activity),"A newer actual selection can take ownership inside old-port cancellation");},1000);
    check(!view.selectBrowserWindow(first,view.activity)&&view.current==winner,"Outer selection cannot overwrite the nested selected session");
    check(view.owner.begins==1&&view.owner.targets.equals(Collections.singletonList(view.locations.get(winner))),"Only the winning actual selection begins an observer epoch");
    check(view.client.committed.equals(Collections.singletonList(winner))&&view.client.finished.equals(Collections.singletonList(winner)),"No loser callback is delivered after nested selection");
    check(view.surface.releases==1&&view.surface.attachments==1,"Nested ownership change does not detach or reactivate twice");
  }

  static void observerReentry(){
    for(String fault:new String[]{"navigation","current","closed","client","runtime","host"}){
      GeckoWebView view=new GeckoWebView();GeckoSession target=view.popup("target"),winner=view.popup("winner");WebViewClient receiver=view.client,replacement=new WebViewClient(view);
      receiver.commitHook=()->{switch(fault){case "navigation":view.owner.navigationEpoch++;break;case "current":view.current=winner;break;
        case "closed":target.close();break;case "client":view.client=replacement;break;case "runtime":view.runtime=new GeckoRuntime();break;
        case "host":view.activity.session=new Owner();break;}};
      view.selectBrowserWindow(row(view,target),view.activity);
      check(receiver.committed.equals(Collections.singletonList(target)),"Commit callback initially names the selected target: "+fault);
      check(receiver.finished.isEmpty()&&replacement.finished.isEmpty(),"Reentrant commit cannot finish a retired receiver/session: "+fault);
    }
    GeckoWebView view=new GeckoWebView();GeckoSession target=view.popup("target"),winner=view.popup("winner");
    view.owner.beginHook=()->view.current=winner;
    check(!view.selectBrowserWindow(row(view,target),view.activity),"Navigation observer reentry retires the target before callbacks");
    check(view.client.committed.isEmpty()&&view.client.finished.isEmpty(),"Changed current session receives no stale commit/finish");
    GeckoWebView finished=new GeckoWebView();GeckoSession completed=finished.popup("completed");
    finished.client.finishHook=()->finished.owner.navigationEpoch++;
    check(!finished.selectBrowserWindow(row(finished,completed),finished.activity),"A newer navigation inside page-finished retires the old selection result");
    check(finished.client.finished.equals(Collections.singletonList(completed))&&finished.owner.changes==0,"Finished callback belongs to the original receiver and cannot publish a stale owner change");
    GeckoWebView replaced=new GeckoWebView();GeckoSession retained=replaced.popup("retained");WebViewClient old=replaced.client,fresh=new WebViewClient(replaced);
    old.finishHook=()->replaced.client=fresh;
    check(replaced.selectBrowserWindow(row(replaced,retained),replaced.activity),"Replacing only the client after its valid finished callback keeps the real selected session");
    check(old.finished.equals(Collections.singletonList(retained))&&fresh.committed.isEmpty()&&fresh.finished.isEmpty(),"The new client never receives an old completed document callback");
    GeckoWebView same=new GeckoWebView();GeckoSession alternative=same.popup("alternative");same.exitIp=true;same.closeHook=()->same.current=alternative;
    check(!same.selectBrowserWindow(row(same,same.primary),same.activity),"Same-page auxiliary-close reentry cannot report a stale selection");
    noNavigation(same,"Same-page reentry does not fabricate navigation");
  }

  public static void main(String[] args){
    inventory();currentAndRetained();staleSelections();activationReentry();observerReentry();
    System.out.println("{\"status\":\"passed\",\"checks\":"+checks+",\"actualAndroidExecution\":false,\"actualGeckoExecution\":false}");
  }
}

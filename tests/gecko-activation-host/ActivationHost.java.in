package local.pocketchat;

import java.util.*;
import org.json.*;

/** Exact production activation and request cancellation; explicit native/UI boundaries. */
public final class ActivationHost {
  static final String OLD="https://old.example/",TARGET="https://target.example/",NEW="https://new.example/";
  static final List<String> checks=new ArrayList<>();
  static void check(String name,boolean value){if(!value)throw new AssertionError(name);checks.add(name);}

  static final class Timer implements BrowserBridgeRequests.Timer {
    final Set<Runnable> tasks=new HashSet<>();
    public void schedule(Runnable task,long delay){tasks.add(task);}
    public void cancel(Runnable task){tasks.remove(task);}
  }
  static final class GeckoSession {
    boolean open=true,active;int activeCalls,closes,stops;
    boolean isOpen(){return open;}
    void setActive(boolean active){this.active=active;activeCalls++;}
    void close(){open=false;active=false;closes++;}
    void stop(){stops++;}
    static final class SessionState {}
  }
  static final class WebExtension {static final class Port {}}
  static final class WebViewClient {
    int committed,finished;Runnable onCommit;
    void onPageCommitVisible(Object view,String url){committed++;Runnable callback=onCommit;onCommit=null;if(callback!=null)callback.run();}
    void onPageFinished(Object view,String url){finished++;}
  }
  static final class Surface {
    GeckoSession session;int releases,attachments;
    GeckoSession getSession(){return session;}
    void releaseSession(){session=null;releases++;}
    void setSession(GeckoSession session){this.session=session;attachments++;}
  }
  static final class Metadata {Object timeZonePolicy;}
  static final class Privacy {int level(){return 1;}}
  static final class Reading {
    final List<String> started=new ArrayList<>(),visible=new ArrayList<>();
    final List<Float> widths=new ArrayList<>();Runnable onStarted,onMeasured,onVisible;
    void started(String url){started.add(url);Runnable callback=onStarted;onStarted=null;if(callback!=null)callback.run();}
    void viewportMeasured(float width){widths.add(width);Runnable callback=onMeasured;onMeasured=null;if(callback!=null)callback.run();}
    void visible(String url){visible.add(url);Runnable callback=onVisible;onVisible=null;if(callback!=null)callback.run();}
  }
  static final class Owner {
    boolean deleted,browserPaused;long navigationEpoch=7;String pageError="";Runnable onBeginNavigation;
    final Privacy privacy=new Privacy();final Reading reading=new Reading();
    Object observed;int connections;void resourceObserverConnected(Object port){observed=port;connections++;}
    long beginNavigation(String url,String status){long accepted=++navigationEpoch;Runnable callback=onBeginNavigation;onBeginNavigation=null;if(callback!=null)callback.run();return accepted;}
  }
  static final class BlockedPopups {
    Runnable onInvalidate;int invalidations;
    void invalidate(){invalidations++;Runnable callback=onInvalidate;onInvalidate=null;if(callback!=null)callback.run();}
  }
  static final class View {
    final Owner owner=new Owner();final Timer timer=new Timer();
    final BrowserBridgeRequests callbacks=new BrowserBridgeRequests(timer,"null");
    final Surface surface=new Surface();final Metadata metadata=new Metadata();final BlockedPopups blockedPopups=new BlockedPopups();
    final Map<GeckoSession,String> locations=new IdentityHashMap<>();
    final Map<GeckoSession,WebExtension.Port> ports=new IdentityHashMap<>();
    final Map<GeckoSession,Boolean> backStates=new IdentityHashMap<>(),forwardStates=new IdentityHashMap<>();
    final Map<GeckoSession,Float> pageScales=new IdentityHashMap<>(),viewportWidths=new IdentityHashMap<>();
    final Set<GeckoSession> crashed=Collections.newSetFromMap(new IdentityHashMap<>()),painted=Collections.newSetFromMap(new IdentityHashMap<>());
    final Set<GeckoSession> measuredCompositors=Collections.newSetFromMap(new IdentityHashMap<>()),pendingLoads=Collections.newSetFromMap(new IdentityHashMap<>()),usable=Collections.newSetFromMap(new IdentityHashMap<>());
    final Map<GeckoSession,String> loadingTargets=new IdentityHashMap<>(),deferredGeneralLoads=new IdentityHashMap<>();
    final Map<GeckoSession,GeckoSession.SessionState> states=new IdentityHashMap<>();
    final Map<GeckoSession,Long> stateDraftRevisions=new IdentityHashMap<>(),appearanceLoads=new IdentityHashMap<>();
    final List<GeckoSession> popups=new ArrayList<>();
    final Set<GeckoSession> generalSessions=Collections.newSetFromMap(new IdentityHashMap<>());
    final Map<GeckoSession,ChromiumRouteLease.Handle> generalRoutes=new IdentityHashMap<>();
    final ChromiumRouteLease.Registry leases=new ChromiumRouteLease.Registry();
    final GeckoSession original=add(OLD),target=add(TARGET),other=add(NEW);
    GeckoSession current=original,primary=original;WebViewClient client;boolean destroyed,desktop,failed,canBack,canForward;
    String url=OLD,queued="";float readingLayout=1,scale=1;int configured,zoomCancels,auxiliaryCloses,reopens;
    Object generalRestore;GeckoSession.SessionState startupState;
    final List<GeckoSession> configuredSessions=new ArrayList<>();
    Runnable onCloseAuxiliary,onConfigure,onRetireTimeZone;
    View(){surface.session=original;original.active=true;}
    GeckoSession add(String url){GeckoSession session=new GeckoSession();locations.put(session,url);ports.put(session,new WebExtension.Port());return session;}
    void closeExitIpPage(){auxiliaryCloses++;Runnable callback=onCloseAuxiliary;onCloseAuxiliary=null;if(callback!=null)callback.run();}
    void cancelZoom(){zoomCancels++;}
    Object timeZoneStatus(){return "declared-timezone-status";}
    void configure(boolean desktop,int protection){configured++;configuredSessions.add(current);Runnable callback=onConfigure;onConfigure=null;if(callback!=null)callback.run();}
    void retireTimeZone(GeckoSession session){Runnable callback=onRetireTimeZone;onRetireTimeZone=null;if(callback!=null)callback.run();}
    void retireAppearance(WebExtension.Port port){}
    void contentStopped(GeckoSession session,String reason){failed=true;}
    boolean reopenCurrent(){reopens++;current.open=true;return true;}
    void newerNavigation(){owner.navigationEpoch++;url=NEW;locations.put(current,NEW);}
    void closeTarget(){target.open=false;locations.remove(target);ports.remove(target);}
    void destroyBoundary(){destroyed=true;for(GeckoSession session:locations.keySet())session.open=false;locations.clear();surface.releaseSession();}
    void onCancel(Runnable callback){callbacks.add(ports.get(current),ignored->callback.run(),1000);}
    ChromiumRouteLease.Handle hold(GeckoSession session){ChromiumRouteLease.Handle lease=leases.acquireSurface();generalSessions.add(session);generalRoutes.put(session,lease);return lease;}
    __METHODS__
  }

  static void normal(){
    View v=new View();List<String> cancelled=new ArrayList<>();v.callbacks.add(v.ports.get(v.original),cancelled::add,1000);
    v.readingLayout=1.25f;v.pageScales.put(v.target,2f);v.viewportWidths.put(v.target,320f);v.backStates.put(v.target,true);v.forwardStates.put(v.target,false);v.painted.add(v.target);
    v.activate(v.target);
    check("Ordinary activation selects and displays the requested tracked session",v.current==v.target&&v.surface.session==v.target&&v.target.active&&!v.original.active);
    check("Previous-page requests and their timers are cancelled exactly once",cancelled.equals(Arrays.asList("null"))&&v.callbacks.size()==0&&v.timer.tasks.isEmpty());
    check("Ordinary activation keeps target history scale and observer identity",TARGET.equals(v.url)&&v.canBack&&!v.canForward&&v.scale==2.5f&&v.owner.observed==v.ports.get(v.target));
    check("Ordinary activation preserves configuration and reading notifications",v.configured==1&&v.owner.reading.started.equals(Arrays.asList(TARGET))&&v.owner.reading.widths.equals(Arrays.asList(400f))&&v.owner.reading.visible.equals(Arrays.asList(TARGET)));
    View paused=new View();paused.owner.browserPaused=true;paused.activate(paused.target);
    check("Background activation does not make the native target active",paused.current==paused.target&&paused.surface.session==paused.target&&!paused.target.active);
    View blank=new View();blank.locations.put(blank.target,"about:blank");blank.activate(blank.target);
    check("Blank target keeps configuration without reading a website",blank.configured==1&&blank.owner.reading.started.isEmpty()&&blank.owner.reading.widths.isEmpty());
    View popup=new View();popup.target.open=false;popup.activate(popup.target);
    check("A newly allocated popup may attach before Gecko opens its native session",popup.current==popup.target&&popup.surface.session==popup.target&&popup.configured==1);
    View crashed=new View();crashed.target.open=false;crashed.crashed.add(crashed.target);crashed.activate(crashed.target);
    check("A previously crashed tracked target retains the existing failure selection",crashed.current==crashed.target&&crashed.failed&&crashed.surface.session==null&&crashed.target.activeCalls==0);
  }

  static void cancellation(){
    View navigation=new View();navigation.onCancel(navigation::newerNavigation);navigation.activate(navigation.target);
    check("Cancellation cannot replace a newer command with an older selected session",navigation.current==navigation.original&&navigation.surface.session==navigation.original&&navigation.original.active&&NEW.equals(navigation.url)&&navigation.configured==0);
    check("Superseded activation still consumes the previous bridge callback",navigation.callbacks.size()==0&&navigation.timer.tasks.isEmpty());

    View popup=new View();popup.onCancel(()->popup.activate(popup.other));popup.activate(popup.target);
    check("Cancellation cannot overwrite a recursively selected popup",popup.current==popup.other&&popup.surface.session==popup.other&&popup.other.active&&popup.target.activeCalls==0&&popup.owner.reading.started.equals(Arrays.asList(NEW)));

    View destroyed=new View();destroyed.onCancel(destroyed::destroyBoundary);destroyed.activate(destroyed.target);
    check("Cancellation after destruction cannot attach or configure any target",destroyed.destroyed&&destroyed.surface.session==null&&destroyed.surface.attachments==0&&destroyed.configured==0&&destroyed.target.activeCalls==0);

    View removed=new View();removed.onCancel(removed::closeTarget);removed.activate(removed.target);
    check("Cancellation cannot select a target removed from tracked sessions",removed.current==removed.original&&removed.surface.session==removed.original&&removed.original.active&&removed.target.activeCalls==0&&removed.configured==0);

    View closed=new View();closed.onCancel(()->closed.target.open=false);closed.activate(closed.target);
    check("Cancellation cannot attach a target that closed during activation",closed.current==closed.original&&closed.surface.session==closed.original&&closed.original.active&&closed.target.activeCalls==0&&closed.configured==0);

    View renewed=new View();List<String> deliveries=new ArrayList<>();renewed.onCancel(()->{renewed.newerNavigation();renewed.callbacks.add(renewed.ports.get(renewed.current),deliveries::add,1000);});renewed.activate(renewed.target);
    check("A newer navigation keeps the bridge request it registered during cancellation",renewed.current==renewed.original&&renewed.surface.session==renewed.original&&renewed.callbacks.size()==1&&renewed.timer.tasks.size()==1&&deliveries.isEmpty());
    View throwing=new View();IllegalStateException expected=new IllegalStateException("declared consumer failure");throwing.onCancel(()->{throw expected;});RuntimeException received=null;
    try{throwing.activate(throwing.target);}catch(RuntimeException failure){received=failure;}
    check("A throwing cancellation consumer leaves the original native surface usable",received==expected&&throwing.current==throwing.original&&throwing.surface.session==throwing.original&&throwing.original.active&&throwing.callbacks.size()==0&&throwing.timer.tasks.isEmpty()&&throwing.configured==0);
  }

  static void auxiliary(){
    View navigation=new View();navigation.onCloseAuxiliary=navigation::newerNavigation;navigation.activate(navigation.target);
    check("Auxiliary-page close callback keeps the newer navigation owner",navigation.current==navigation.original&&navigation.surface.session==navigation.original&&navigation.original.active&&NEW.equals(navigation.url)&&navigation.zoomCancels==0&&navigation.configured==0);
    View popup=new View();popup.onCloseAuxiliary=()->popup.activate(popup.other);popup.activate(popup.target);
    check("Auxiliary-page close cannot overwrite a newly selected popup",popup.current==popup.other&&popup.surface.session==popup.other&&popup.other.active&&popup.configuredSessions.equals(Arrays.asList(popup.other)));
    View destroyed=new View();destroyed.onCloseAuxiliary=destroyed::destroyBoundary;destroyed.activate(destroyed.target);
    check("Auxiliary-page close after destruction cannot issue native attachment",destroyed.surface.attachments==0&&destroyed.configured==0&&destroyed.surface.session==null);
    View blocked=new View();blocked.blockedPopups.onInvalidate=blocked::newerNavigation;blocked.activate(blocked.target);
    check("Popup-action invalidation cannot overwrite its synchronous navigation",blocked.current==blocked.original&&blocked.surface.session==blocked.original&&NEW.equals(blocked.url)&&blocked.auxiliaryCloses==0&&blocked.configured==0);
  }

  static void targetValidity(){
    View removed=new View();removed.closeTarget();removed.activate(removed.target);
    check("An untracked target is rejected before changing the visible surface",removed.current==removed.original&&removed.surface.session==removed.original&&removed.original.active&&removed.surface.releases==0&&removed.configured==0);
    View missing=new View();missing.activate(null);
    check("A missing target leaves the current native page intact",missing.current==missing.original&&missing.surface.session==missing.original&&missing.configured==0);
    View destroyed=new View();destroyed.destroyed=true;destroyed.activate(destroyed.target);
    check("Already destroyed view cannot perform a late posted activation",destroyed.current==destroyed.original&&destroyed.surface.releases==0&&destroyed.surface.attachments==0&&destroyed.configured==0);
    View deleted=new View();deleted.owner.deleted=true;deleted.activate(deleted.target);
    check("Deleted owner cannot perform a late posted activation",deleted.current==deleted.original&&deleted.surface.releases==0&&deleted.surface.attachments==0&&deleted.configured==0);
  }

  static void afterSelection(){
    View configured=new View();configured.onConfigure=configured::newerNavigation;configured.activate(configured.target);
    check("Configuration reentry cannot publish reading state for its retired navigation",configured.current==configured.target&&NEW.equals(configured.url)&&configured.owner.reading.started.isEmpty()&&configured.owner.reading.widths.isEmpty()&&configured.owner.reading.visible.isEmpty());
    View popup=new View();popup.onConfigure=()->popup.activate(popup.other);popup.activate(popup.target);
    check("Configuration reentry leaves only the newly selected popup reading state",popup.current==popup.other&&popup.surface.session==popup.other&&popup.owner.reading.started.equals(Arrays.asList(NEW))&&popup.owner.reading.widths.size()==1);
    View started=new View();started.painted.add(started.target);started.owner.reading.onStarted=started::newerNavigation;started.activate(started.target);
    check("Reading-start reentry cannot measure or reveal the superseded page",started.owner.reading.started.equals(Arrays.asList(TARGET))&&started.owner.reading.widths.isEmpty()&&started.owner.reading.visible.isEmpty()&&NEW.equals(started.url));
    View measured=new View();measured.painted.add(measured.target);measured.owner.reading.onMeasured=()->measured.activate(measured.other);measured.activate(measured.target);
    check("Reading-measurement reentry cannot publish old-page visibility",measured.current==measured.other&&measured.surface.session==measured.other&&measured.owner.reading.visible.isEmpty()&&measured.owner.reading.started.equals(Arrays.asList(TARGET,NEW)));
    View destroyed=new View();destroyed.onConfigure=destroyed::destroyBoundary;destroyed.activate(destroyed.target);
    check("Configuration destruction prevents later reading notifications",destroyed.destroyed&&destroyed.owner.reading.started.isEmpty()&&destroyed.owner.reading.widths.isEmpty()&&destroyed.owner.reading.visible.isEmpty());
    View removed=new View();removed.onConfigure=removed::closeTarget;removed.activate(removed.target);
    check("Configuration cannot publish reading state after its target is retired",removed.owner.reading.started.isEmpty()&&removed.owner.reading.widths.isEmpty()&&removed.owner.reading.visible.isEmpty());
    View closed=new View();closed.onConfigure=()->closed.target.open=false;closed.activate(closed.target);
    check("Configuration cannot publish reading state after its open target closes",closed.owner.reading.started.isEmpty()&&closed.owner.reading.widths.isEmpty()&&closed.owner.reading.visible.isEmpty());
    View changedAtStart=new View();changedAtStart.painted.add(changedAtStart.target);changedAtStart.owner.reading.onStarted=()->changedAtStart.url=NEW;changedAtStart.activate(changedAtStart.target);
    check("A same-epoch URL change during reading start cannot publish old-document measurements",changedAtStart.owner.navigationEpoch==7&&NEW.equals(changedAtStart.url)&&changedAtStart.owner.reading.widths.isEmpty()&&changedAtStart.owner.reading.visible.isEmpty());
    View changedAtMeasure=new View();changedAtMeasure.painted.add(changedAtMeasure.target);changedAtMeasure.owner.reading.onMeasured=()->changedAtMeasure.url=NEW;changedAtMeasure.activate(changedAtMeasure.target);
    check("A same-epoch URL change during measurement cannot reveal the previous document",changedAtMeasure.owner.navigationEpoch==7&&NEW.equals(changedAtMeasure.url)&&changedAtMeasure.owner.reading.widths.size()==1&&changedAtMeasure.owner.reading.visible.isEmpty());
  }

  static View popup(){View view=new View();view.primary=view.target;view.popups.add(view.original);return view;}

  static void closingPopup(){
    View ordinary=popup();ChromiumRouteLease.Handle oldLease=ordinary.hold(ordinary.original),download=ordinary.leases.acquireDownload();ordinary.painted.add(ordinary.target);ordinary.client=new WebViewClient();ordinary.onCancel(()->{});
    check("Ordinary popup close returns to its parent and retires the old native surface",ordinary.closePopup(ordinary.original,true)&&ordinary.current==ordinary.target&&ordinary.surface.session==ordinary.target&&!ordinary.original.isOpen()&&ordinary.original.closes==1&&!ordinary.popups.contains(ordinary.original)&&!ordinary.locations.containsKey(ordinary.original)&&!ordinary.ports.containsKey(ordinary.original)&&oldLease.closed&&ordinary.callbacks.size()==0);
    check("Ordinary popup close preserves independent downloads and parent notification",!download.closed&&ordinary.leases.snapshot().downloads==1&&ordinary.leases.snapshot().surfaces==0&&ordinary.owner.navigationEpoch==8&&ordinary.client.committed==1&&ordinary.client.finished==1);
    download.close();

    View navigation=popup();ChromiumRouteLease.Handle retained=navigation.hold(navigation.original);WebExtension.Port renewed=new WebExtension.Port();List<String> renewedResults=new ArrayList<>();navigation.onCancel(()->{navigation.newerNavigation();navigation.ports.put(navigation.current,renewed);navigation.callbacks.add(renewed,renewedResults::add,1000);});
    check("Popup close cannot close a newer navigation that still owns the original surface",!navigation.closePopup(navigation.original,true)&&navigation.current==navigation.original&&navigation.surface.session==navigation.original&&navigation.original.isOpen()&&navigation.original.active&&navigation.popups.contains(navigation.original)&&navigation.locations.containsKey(navigation.original)&&navigation.ports.get(navigation.original)==renewed&&navigation.callbacks.size()==1&&navigation.timer.tasks.size()==1&&renewedResults.isEmpty()&&NEW.equals(navigation.url)&&!retained.closed);
    retained.close();

    View timezone=popup();ChromiumRouteLease.Handle timezoneLease=timezone.hold(timezone.original);timezone.onRetireTimeZone=timezone::newerNavigation;
    check("Popup retirement cannot overwrite a newer navigation from its time-zone callback",!timezone.closePopup(timezone.original,true)&&timezone.current==timezone.original&&timezone.surface.session==timezone.original&&timezone.original.isOpen()&&timezone.popups.contains(timezone.original)&&NEW.equals(timezone.url)&&!timezoneLease.closed&&timezone.configured==0);
    timezoneLease.close();

    View selected=popup();ChromiumRouteLease.Handle completed=selected.hold(selected.original);selected.onCancel(()->selected.activate(selected.other));
    check("Popup close still retires its old resources after another surface takes ownership",selected.closePopup(selected.original,true)&&selected.current==selected.other&&selected.surface.session==selected.other&&selected.other.isOpen()&&!selected.original.isOpen()&&!selected.locations.containsKey(selected.original)&&!selected.ports.containsKey(selected.original)&&completed.closed&&selected.owner.reading.started.equals(Arrays.asList(NEW)));

    View reselected=popup();ChromiumRouteLease.Handle reselectedLease=reselected.hold(reselected.original);reselected.owner.onBeginNavigation=()->reselected.activate(reselected.original);
    check("A return-navigation callback can reclaim the original popup before retirement",!reselected.closePopup(reselected.original,true)&&reselected.current==reselected.original&&reselected.surface.session==reselected.original&&reselected.original.isOpen()&&reselected.popups.contains(reselected.original)&&reselected.locations.containsKey(reselected.original)&&!reselectedLease.closed);
    reselectedLease.close();

    View backgroundSelected=popup();backgroundSelected.current=backgroundSelected.target;backgroundSelected.surface.session=backgroundSelected.target;backgroundSelected.original.active=false;backgroundSelected.target.active=true;ChromiumRouteLease.Handle backgroundSelectedLease=backgroundSelected.hold(backgroundSelected.original);
    backgroundSelected.onRetireTimeZone=()->backgroundSelected.activate(backgroundSelected.original);
    check("Time-zone retirement cannot close a background popup that was newly selected",!backgroundSelected.closePopup(backgroundSelected.original,true)&&backgroundSelected.current==backgroundSelected.original&&backgroundSelected.surface.session==backgroundSelected.original&&backgroundSelected.original.isOpen()&&backgroundSelected.popups.contains(backgroundSelected.original)&&!backgroundSelectedLease.closed);
    backgroundSelectedLease.close();

    for(boolean atTimezone:new boolean[]{false,true}){
      View nested=popup();ChromiumRouteLease.Handle nestedLease=nested.hold(nested.original);boolean[] innerAccepted={false};Runnable close=()->innerAccepted[0]=nested.closePopup(nested.original,true);
      if(atTimezone)nested.onRetireTimeZone=close;else nested.onCancel(close);
      check("Nested popup close retires its native session exactly once at "+(atTimezone?"time-zone":"request cancellation"),nested.closePopup(nested.original,true)&&innerAccepted[0]&&nested.current==nested.target&&nested.surface.session==nested.target&&nested.original.closes==1&&!nested.popups.contains(nested.original)&&nested.owner.navigationEpoch==8&&nestedLease.closed&&nested.leases.snapshot().surfaces==0);
    }

    View background=popup();background.current=background.target;background.surface.session=background.target;background.original.active=false;background.target.active=true;ChromiumRouteLease.Handle backgroundLease=background.hold(background.original);
    background.callbacks.add(background.ports.get(background.original),ignored->background.activate(background.original),1000);
    check("Retirement callbacks cannot reactivate an already untracked popup",background.closePopup(background.original,true)&&background.current==background.target&&background.surface.session==background.target&&background.target.isOpen()&&!background.original.isOpen()&&!background.locations.containsKey(background.original)&&backgroundLease.closed);

    View leaseListener=popup();leaseListener.current=leaseListener.target;leaseListener.surface.session=leaseListener.target;ChromiumRouteLease.Handle listenerLease=leaseListener.hold(leaseListener.original);int[] notifications={0};
    leaseListener.leases.addListener(()->{notifications[0]++;leaseListener.activate(leaseListener.original);});
    check("A real route-lease listener cannot reactivate a retiring popup",leaseListener.closePopup(leaseListener.original,true)&&notifications[0]==1&&listenerLease.closed&&leaseListener.current==leaseListener.target&&leaseListener.surface.session==leaseListener.target&&!leaseListener.original.isOpen()&&!leaseListener.locations.containsKey(leaseListener.original));

    View currentRenewed=popup();currentRenewed.current=currentRenewed.target;currentRenewed.surface.session=currentRenewed.target;ChromiumRouteLease.Handle retiredLease=currentRenewed.hold(currentRenewed.original);WebExtension.Port freshPort=new WebExtension.Port();List<String> freshResults=new ArrayList<>();
    currentRenewed.callbacks.add(currentRenewed.ports.get(currentRenewed.original),ignored->{currentRenewed.newerNavigation();currentRenewed.ports.put(currentRenewed.current,freshPort);currentRenewed.callbacks.add(freshPort,freshResults::add,1000);},1000);
    check("Old-popup cleanup preserves the new current page URI port and requests",currentRenewed.closePopup(currentRenewed.original,true)&&currentRenewed.current==currentRenewed.target&&NEW.equals(currentRenewed.url)&&currentRenewed.ports.get(currentRenewed.target)==freshPort&&currentRenewed.callbacks.size()==1&&currentRenewed.timer.tasks.size()==1&&freshResults.isEmpty()&&retiredLease.closed&&!currentRenewed.original.isOpen());

    View throwing=popup();throwing.current=throwing.target;throwing.surface.session=throwing.target;ChromiumRouteLease.Handle throwingLease=throwing.hold(throwing.original);IllegalStateException expected=new IllegalStateException("declared retiring callback failure");RuntimeException received=null;
    throwing.callbacks.add(throwing.ports.get(throwing.original),ignored->{throw expected;},1000);
    try{throwing.closePopup(throwing.original,true);}catch(RuntimeException failure){received=failure;}
    check("A retiring consumer exception cannot leak the now-untracked native popup",received==expected&&throwing.current==throwing.target&&throwing.surface.session==throwing.target&&throwing.original.closes==1&&!throwing.locations.containsKey(throwing.original)&&!throwing.ports.containsKey(throwing.original)&&throwingLease.closed&&throwing.callbacks.size()==0&&throwing.timer.tasks.isEmpty());

    View closeAll=popup();closeAll.onCancel(closeAll::newerNavigation);ChromiumRouteLease.Handle closeAllLease=closeAll.hold(closeAll.original);
    check("Close-all caller preserves its existing navigation ownership gate",!closeAll.closePopup(closeAll.original,false)&&closeAll.current==closeAll.original&&closeAll.surface.session==closeAll.original&&closeAll.original.isOpen()&&closeAll.popups.contains(closeAll.original)&&!closeAllLease.closed&&NEW.equals(closeAll.url));
    closeAllLease.close();
  }

  static void closingAll(){
    View ordinary=popup();ordinary.popups.add(ordinary.other);ordinary.hold(ordinary.original);ordinary.hold(ordinary.other);ordinary.hold(ordinary.target);ChromiumRouteLease.Handle download=ordinary.leases.acquireDownload();ordinary.client=new WebViewClient();
    check("Close-all composes real popup activation without claiming a return navigation",ordinary.closeWebsitePages()&&ordinary.current==ordinary.target&&ordinary.surface.session==ordinary.target&&ordinary.owner.navigationEpoch==7&&ordinary.popups.isEmpty()&&ordinary.original.closes==1&&ordinary.other.closes==1&&ordinary.target.isOpen()&&ordinary.target.stops==1&&ordinary.reopens==1&&ordinary.ports.isEmpty()&&ordinary.url.isEmpty()&&ordinary.client.committed==0&&ordinary.client.finished==0);
    check("Close-all composition releases only page leases and retains native downloads",ordinary.leases.snapshot().surfaces==0&&ordinary.leases.snapshot().downloads==1&&!download.closed);download.close();
    View reentered=popup();ChromiumRouteLease.Handle keep=reentered.hold(reentered.original);WebExtension.Port fresh=new WebExtension.Port();List<String> results=new ArrayList<>();
    reentered.onCancel(()->{reentered.newerNavigation();reentered.ports.put(reentered.current,fresh);reentered.callbacks.add(fresh,results::add,1000);});
    check("Close-all composition cannot erase a new page accepted during popup cancellation",!reentered.closeWebsitePages()&&reentered.current==reentered.original&&reentered.surface.session==reentered.original&&reentered.original.isOpen()&&reentered.popups.contains(reentered.original)&&reentered.ports.get(reentered.original)==fresh&&reentered.callbacks.size()==1&&results.isEmpty()&&NEW.equals(reentered.url)&&!keep.closed&&reentered.reopens==0);keep.close();
  }

  public static void main(String[] args){
    String focus=args.length==0?"all":args[0];
    if(focus.equals("all")||focus.equals("normal"))normal();
    if(focus.equals("all")||focus.equals("cancellation"))cancellation();
    if(focus.equals("all")||focus.equals("auxiliary"))auxiliary();
    if(focus.equals("all")||focus.equals("target"))targetValidity();
    if(focus.equals("all")||focus.equals("selected"))afterSelection();
    if(focus.equals("all")||focus.equals("closing"))closingPopup();
    if(focus.equals("all")||focus.equals("close-all"))closingAll();
    System.out.println(J.obj("status","passed","passed",checks.size(),"total",checks.size(),"checks",new JSONArray(checks)));
  }
}

package local.pocketchat;

import org.json.*;
import java.util.*;
import java.text.DateFormat;

/** Exact selected production methods with counted SQL and deterministic View adapters. */
public final class DownloadNamesHost {
  static final JSONArray checks=new JSONArray(),measurements=new JSONArray();
  static boolean before=Boolean.getBoolean("before");
  static void check(String name,boolean pass){checks.put(J.obj("name",name,"pass",pass));}
  static ProfileCatalog setup(){
    ProfileCatalog c=new ProfileCatalog();ProfileCatalog.instance=c;
    for(int slot=0;slot<8;slot++)c.db.rows.put(slot,profile(slot,"环境名 "+slot));
    return c;
  }
  static Map<String,Object> profile(int slot,String name){
    Map<String,Object> r=new LinkedHashMap<>();
    for(String k:new String[]{"slot","created","pid","seen","connected","waiting","opened","favorite","privacy","desktop","generation","deleting","resetting"})r.put(k,0);
    for(String k:new String[]{"name","draft","mode","problem","page","group_name","notes","environment_id"})r.put(k,"");
    r.put("slot",slot);r.put("name",name);r.put("draft","PRIVATE_DRAFT_NOT_FOR_LABELS");r.put("notes","PRIVATE_NOTES_NOT_FOR_LABELS");return r;
  }
  static JSONObject row(String id,int slot,String state){return J.obj("id",id,"slot",slot,"state",state,"uri","content://download/"+id,"name",id+".txt","time",0,"total",100,"received",10);}
  static JSONArray rows(int n){JSONArray out=new JSONArray();for(int i=0;i<n;i++)out.put(row("task"+i,i%8,"saved"));return out;}
  static void resetQueries(ProfileCatalog c){c.db.queries.clear();UiPerfStats.reads=0;}
  static boolean projection(ProfileCatalog c){return before?c.db.queries.stream().allMatch(q->q.columns==null):c.db.queries.stream().allMatch(q->Arrays.equals(q.columns,new String[]{"slot","name"})&&q.where==null&&q.order==null);}
  static String label(DesignDownloads.Controller c,JSONObject r){return c.views.get(DownloadListPolicy.key(r)).status.getText().toString();}
  static void counts(){
    for(int n:new int[]{1,100,1000,10000}){
      ProfileCatalog p=setup();DesignDownloads.Controller c=new DesignDownloads.Controller();JSONArray data=rows(n);resetQueries(p);c.apply(data,0,1000);
      int q=p.db.queries.size();check("Actual apply and bind query count for "+n+" unique rows",q==(before?n:1));
      check("SQL projection for "+n+" rows",projection(p));check("Counter records every actual catalogue label query for "+n,UiPerfStats.reads==q);
      check("All unique rows remain bound for "+n,c.list.getChildCount()==n&&c.views.size()==n);
      check("Names and status remain exact for first and last of "+n,label(c,data.getJSONObject(0)).equals("环境名 0 · saved")&&label(c,data.getJSONObject(n-1)).equals("环境名 "+((n-1)%8)+" · saved"));
      measurements.put(J.obj("rows",n,"labelSqlQueries",q,"projection",before?"all environment fields":"slot,name only","rowCreations",c.createdRows()));
    }
  }
  static void freshnessAndFallbacks(){
    ProfileCatalog p=setup();DesignDownloads.Controller c=new DesignDownloads.Controller();JSONArray data=rows(100);c.apply(data,0,1000);
    Map<String,DesignDownloads.Row> identities=new LinkedHashMap<>(c.views);p.db.rows.get(3).put("name","已重新命名");resetQueries(p);c.apply(data,0,2000);
    check("Next apply reads renamed environment instead of caching across refreshes",label(c,data.getJSONObject(3)).equals("已重新命名 · saved"));
    check("Rename refresh uses the same query bound",p.db.queries.size()==(before?100:1));
    check("Stable data keeps every Row and card identity",identities.entrySet().stream().allMatch(e->c.views.get(e.getKey())==e.getValue())&&c.createdRows()==100);
    check("Reading names does not mutate download row slots",data.getJSONObject(3).getInt("slot")==3&&c.views.get(DownloadListPolicy.key(data.getJSONObject(3))).value==data.getJSONObject(3));
    p.db.rows.remove(0);p.db.rows.get(2).put("name","");p.db.rows.get(4).put("name",null);
    JSONArray odd=new JSONArray().put(row("missing-default",0,"saved")).put(row("unknown",99,"saved")).put(row("negative",-3,"saved")).put(row("blank",2,"saved")).put(row("null",4,"saved"));resetQueries(p);c.apply(odd,0,3000);
    check("Absent slot zero keeps the original default fallback",label(c,odd.getJSONObject(0)).equals("默认环境 · saved"));
    check("Unknown positive slot keeps original arithmetic fallback",label(c,odd.getJSONObject(1)).equals("环境 100 · saved"));
    check("Unknown negative slot is not clamped to a different environment",label(c,odd.getJSONObject(2)).equals("环境 -2 · saved"));
    check("A present empty name remains empty",label(c,odd.getJSONObject(3)).equals(" · saved"));
    check("Null unavailable name keeps original fallback",label(c,odd.getJSONObject(4)).equals("环境 5 · saved"));
    check("Fallbacks share one projected read",p.db.queries.size()==(before?5:1));
    p.db.rows.put(0,profile(0,"新建默认环境"));resetQueries(p);c.apply(odd,0,4000);
    check("Reused slot name is read fresh on the next apply",label(c,odd.getJSONObject(0)).equals("新建默认环境 · saved"));
  }
  static void filteringAndDuplicates(){
    ProfileCatalog p=setup();DesignDownloads.Controller c=new DesignDownloads.Controller();JSONArray data=rows(10);resetQueries(p);c.apply(data,1,1000);
    check("Fully filtered data does not query environment labels",p.db.queries.isEmpty()&&c.views.isEmpty()&&c.list.getChildCount()==0);
    resetQueries(p);c.apply(new JSONArray(),0,2000);check("Empty data does not query environment labels",p.db.queries.isEmpty()&&c.views.isEmpty());
    JSONObject first=row("duplicate",1,"saved");JSONArray duplicate=new JSONArray().put(first).put(first).put(row("same-slot-another-id",1,"saved"));resetQueries(p);c.apply(duplicate,0,3000);
    check("Duplicate identity remains one row; duplicate slot remains distinct records",c.list.getChildCount()==2&&c.views.size()==2);
    check("Repeated slots do not repeat the projected query",p.db.queries.size()==(before?2:1));
    JSONArray mixed=new JSONArray().put(row("live",2,"downloading")).put(row("saved",2,"saved")).put(row("failed",2,"failed"));
    for(int selected:new int[]{1,2,3}){resetQueries(p);c.apply(mixed,selected,4000);JSONObject expected=mixed.getJSONObject(selected-1);check("Filter "+selected+" retains the original selected state",c.views.size()==1&&c.views.containsKey(DownloadListPolicy.key(expected)));check("Filter "+selected+" has exactly one label query",p.db.queries.size()==1);}
  }
  static void anchors(){
    ProfileCatalog p=setup();DesignDownloads.Controller c=new DesignDownloads.Controller();JSONArray original=rows(3);c.apply(original,0,1000);DesignDownloads.Row kept=c.views.get(DownloadListPolicy.key(original.getJSONObject(1)));c.scroll.scrollTo(0,150);int beforeOffset=kept.card.getTop()-c.scroll.getScrollY(),posts=c.scroll.posts;
    c.apply(original,0,2000);check("Nonstructural bind preserves the selected scroll and schedules no restore",c.scroll.getScrollY()==150&&c.scroll.posts==posts);
    JSONArray prepend=new JSONArray().put(row("new-head",7,"saved"));for(int i=0;i<original.length();i++)prepend.put(original.getJSONObject(i));c.apply(prepend,0,3000);
    check("Actual apply keeps the same anchor card after prepend",c.views.get(DownloadListPolicy.key(original.getJSONObject(1)))==kept&&kept.card.getTop()-c.scroll.getScrollY()==beforeOffset);
    c.apply(prepend,1,4000);check("Changing filter preserves original scroll-to-top behavior",c.scroll.getScrollY()==0);
  }
  public static void main(String[] ignored){Locale.setDefault(Locale.ROOT);TimeZone.setDefault(TimeZone.getTimeZone("UTC"));counts();freshnessAndFallbacks();filteringAndDuplicates();anchors();int passed=0;for(int i=0;i<checks.length();i++)if(checks.getJSONObject(i).getBoolean("pass"))passed++;System.out.println(J.obj("status",passed==checks.length()?"passed":"failed","passed",passed,"total",checks.length(),"variant",before?"published20":"candidate","measurements",measurements,"checks",checks));if(passed!=checks.length())System.exit(1);}
}

class ProfileCatalog {
  static ProfileCatalog instance;final SQLiteDatabase db=new SQLiteDatabase();
  static ProfileCatalog get(Context ignored){return instance;}SQLiteDatabase getReadableDatabase(){return db;}
  /* CATALOG */
}
class Profiles {/* PROFILES_DISPLAY */}
class UiPerfStats{static int reads;static void catalogRead(){reads++;}}
class DesignDownloads {
  /* DOWNLOAD_HELPERS */
  static final class Controller {
    final Activity a=new Activity();final LinearLayout box=new LinearLayout(),packages=new LinearLayout(),list=new LinearLayout(),empty=new LinearLayout();final ScrollView scroll=new ScrollView();final java.util.function.IntConsumer choose=n->{};final SavedFileActions actions=new SavedFileActions();final Map<String,Row> views=new LinkedHashMap<>();int filter=0;String packageKey="";LinearLayout tabs=new LinearLayout();final int firstRowCounter=Row.created;
    Controller(){scroll.addView(box);box.addView(tabs);box.addView(list);box.addView(empty);}
    int createdRows(){return Row.created-firstRowCounter;}
    /* CONTROLLER_APPLY */
  }
  static final class Row {
    static int created;final Activity a;final LinearLayout card=new LinearLayout();final ImageView icon=new ImageView();final TextView name=new TextView(),status=new TextView(),time=new TextView(),progressText=new TextView(),reason=new TextView(),stale=new TextView(),location=new TextView(),arrow=new TextView();final Button menu=new Button();final ProgressBar progress=new ProgressBar();JSONObject value;String appearance="";
    Row(Activity a,SavedFileActions ignored){this.a=a;created++;}
    /* ROW_BIND */
    /* ROW_TEXT */
    /* ROW_VISIBLE */
  }
}
class Context{}class Activity extends Context{}class SavedFileActions{}
class View {
  static final int VISIBLE=0,GONE=8;LinearLayout parent;int top,height=100,visibility=VISIBLE;String description="";
  Object getParent(){return parent;}int getTop(){return top;}int getHeight(){return height;}int getVisibility(){return visibility;}void setVisibility(int value){visibility=value;}void setBackground(Object ignored){}void setContentDescription(String value){description=value;}
}
class LinearLayout extends View {
  final ArrayList<View> children=new ArrayList<>();static class LayoutParams{int topMargin;LayoutParams(int w,int h){}}
  int getChildCount(){return children.size();}View getChildAt(int at){return children.get(at);}void layout(){for(int i=0;i<children.size();i++)children.get(i).top=i*100;}
  void addView(View view){addView(view,children.size(),new LayoutParams(-1,-2));}void addView(View view,int at){addView(view,at,new LayoutParams(-1,-2));}void addView(View view,int at,LayoutParams ignored){if(view.parent!=null)throw new AssertionError("View already attached");children.add(at,view);view.parent=this;layout();}
  void removeView(View view){if(children.remove(view)){view.parent=null;layout();}}void removeAllViews(){for(View v:children)v.parent=null;children.clear();}
}
class ScrollView extends LinearLayout{int y,posts;int getScrollY(){return y;}void scrollTo(int x,int value){y=value;}void post(Runnable task){posts++;task.run();}}
class TextView extends View{String text="";CharSequence getText(){return text;}void setText(String value){text=value;}void setTextColor(int ignored){}}
class Button extends TextView{}class ImageView extends View{void setImageDrawable(Object ignored){}}
class ProgressBar extends View{boolean indefinite;int percent;boolean isIndeterminate(){return indefinite;}void setIndeterminate(boolean value){indefinite=value;}int getProgress(){return percent;}void setProgress(int value){percent=value;}}
class DesignUi{static final int RED=1,CYAN=2,GREEN=3;static LinearLayout tabs(Activity a,String[] labels,int selected,java.util.function.IntConsumer choose){return new LinearLayout();}static int dp(Activity a,int value){return value;}static Object surface(Activity a,int color,int radius,int border){return new Object();}static void empty(LinearLayout target,String title,String detail,String action,Runnable run){target.addView(new TextView());}}
class Ui{static final class Icon{Icon(String shape,int color){}}}
class DownloadTasks{static String label(String state){return state;}static String progress(JSONObject value){return value.optLong("received")+"/"+value.optLong("total");}}
class J{static JSONObject obj(Object...pairs){JSONObject out=new JSONObject();for(int i=0;i<pairs.length;i+=2)out.put((String)pairs[i],pairs[i+1]);return out;}}
interface Cursor extends AutoCloseable{boolean moveToFirst();boolean moveToNext();int getColumnIndexOrThrow(String key);String getString(int index);int getInt(int index);long getLong(int index);void close();}
class SQLiteDatabase {
  final LinkedHashMap<Integer,Map<String,Object>> rows=new LinkedHashMap<>();final ArrayList<Query> queries=new ArrayList<>();
  static final class Query{final String[] columns;final String where,order;Query(String[] p,String w,String o){columns=p==null?null:p.clone();where=w;order=o;}}
  Cursor query(String table,String[] columns,String where,String[] args,String group,String having,String order){if(!table.equals("environments"))throw new AssertionError(table);queries.add(new Query(columns,where,order));ArrayList<Map<String,Object>> selected=new ArrayList<>();if(where==null)selected.addAll(rows.values());else {if(!where.equals("slot=?"))throw new AssertionError(where);Map<String,Object> r=rows.get(Integer.parseInt(args[0]));if(r!=null)selected.add(r);}return new Rows(selected,columns);}
  static final class Rows implements Cursor{
    final List<Map<String,Object>> rows;final List<String> columns;int index=-1;Rows(List<Map<String,Object>> rows,String[] projection){this.rows=rows;columns=projection==null?(rows.isEmpty()?new ArrayList<>():new ArrayList<>(rows.get(0).keySet())):Arrays.asList(projection);}
    public boolean moveToFirst(){index=0;return !rows.isEmpty();}public boolean moveToNext(){return ++index<rows.size();}public int getColumnIndexOrThrow(String key){int at=columns.indexOf(key);if(at<0)throw new AssertionError("Projected field is unavailable: "+key);return at;}
    Object value(int at){return rows.get(index).get(columns.get(at));}public String getString(int at){Object v=value(at);return v==null?null:String.valueOf(v);}public int getInt(int at){return ((Number)value(at)).intValue();}public long getLong(int at){return ((Number)value(at)).longValue();}public void close(){}
  }
}

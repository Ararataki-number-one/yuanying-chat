package local.pocketchat;

import java.util.*;
import java.util.function.Consumer;
import org.json.*;

/** Actual selected methods; every SDK/application replacement is declared below. */
public final class HttpWaitHost {
  static final String TARGET="https://fp-a.pocketchat.test/document.js";
  static final List<JSONObject> checks=new ArrayList<>();
  static void check(String name,boolean ok){if(!ok)throw new AssertionError(name);checks.add(J.obj("name",name,"pass",true));}
  // A plain JVM asynchronous-result boundary, never org.mozilla SDK execution.
  static final class ResultBoundary<T> {
    T value;Throwable error;int completions;boolean done;Consumer<T> success;Consumer<Throwable> failure;
    static <T> ResultBoundary<T> fromValue(T value){ResultBoundary<T> result=new ResultBoundary<>();result.complete(value);return result;}
    void complete(T value){this.value=value;done=true;completions++;if(success!=null)success.accept(value);}
    void accept(Consumer<T> success,Consumer<Throwable> failure){this.success=success;this.failure=failure;if(done){if(error==null)success.accept(value);else failure.accept(error);}}
    void fail(Throwable error){this.error=error;done=true;completions++;if(failure!=null)failure.accept(error);}
  }
  static final class SessionBoundary {boolean open=true,sdkReady=true;final String sdkIdentity="same-controlled-sdk-id";boolean isOpen(){return open;}}
  static final class PortBoundary {}
  static final class HandlerBoundary {
    static final class Task {final Runnable runnable;final long due;Task(Runnable runnable,long due){this.runnable=runnable;this.due=due;}}
    long now;final ArrayList<Task> tasks=new ArrayList<>();final ArrayList<Long> delays=new ArrayList<>();
    void postDelayed(Runnable runnable,long delay){delays.add(delay);tasks.add(new Task(runnable,now+delay));}
    void removeCallbacks(Runnable runnable){tasks.removeIf(task->task.runnable==runnable);}
    void advance(long amount){long end=now+amount;for(;;){Task next=null;for(Task candidate:tasks)if(candidate.due<=end&&(next==null||candidate.due<next.due))next=candidate;if(next==null)break;now=next.due;tasks.remove(next);next.runnable.run();}now=end;}
  }
  // Native readback/controller boundary: its permission is exact object+open epoch.
  // SDK readiness is independently controlled, never inferred from HTTP completion.
  static final class ControllerBoundary {
    final IdentityHashMap<SessionBoundary,String> grants=new IdentityHashMap<>();long desiredRevision=7;boolean includeDesired=true;
    boolean allowed(SessionBoundary session,String epoch){return session.sdkReady&&epoch.equals(grants.get(session));}
    boolean popupAllowed(){return false;}
    JSONObject status(){return includeDesired?J.obj("desiredRevision",desiredRevision):J.obj();}
    void grant(SessionBoundary session,String epoch){grants.put(session,epoch);}
  }
  static final class OwnerBoundary {
    boolean deleted;long navigationEpoch=11,connectionEpoch=19;int changes,statusUpdates;
    final HandlerBoundary handler=new HandlerBoundary();final ControllerBoundary timeZone=new ControllerBoundary();
    void changed(){changes++;}void setStatus(String message){statusUpdates++;}
  }
  static final class ProtectionBoundary {long generation=23;long token(){return generation;}}
  static final class MetadataBoundary {JSONObject timeZonePolicy;}
  static final class ExitBoundary {SessionBoundary aux;}
  static final class WebBoundary {
    final OwnerBoundary owner=new OwnerBoundary();final ProtectionBoundary nativeProtection=new ProtectionBoundary();final MetadataBoundary metadata=new MetadataBoundary();
    SessionBoundary current=new SessionBoundary();PortBoundary routePort=new PortBoundary();boolean destroyed;long identityPolicyRevision=31;
    final Map<SessionBoundary,TimeZoneGate> timeZoneGates=new IdentityHashMap<>();final Map<SessionBoundary,String> locations=new IdentityHashMap<>();final List<SessionBoundary> popups=new ArrayList<>();ExitBoundary exitIpPage;
    int routeCalls,headerCalls;boolean routeGuard=true,headerGuard=true,targetAllowed=true,headerFails,headerDeferred;String lastRoute,lastHeader;ResultBoundary<Object> pendingHeader;final List<String> events=new ArrayList<>();
    WebBoundary(){locations.put(current,TARGET);TimeZoneGate gate=new TimeZoneGate();gate.preparing=true;gate.revalidating=true;timeZoneGates.put(current,gate);}
    JSONObject timeZoneStatus(){return J.obj("issue","");}
    JSONObject blocked(){return J.obj("allowed",false,"boundary","blocked");}
    // Counting application boundaries for existing route/header guards. Their
    // actual bodies are independently covered by the route/header host suites.
    JSONObject route(String target){routeCalls++;events.add("route");lastRoute=target;return J.obj("allowed",routeGuard&&targetAllowed&&timeZoneAllows(current),"target",target);}
    ResultBoundary<Object> requestHeaderPolicy(String target){headerCalls++;events.add("headers");lastHeader=target;ResultBoundary<Object> result=new ResultBoundary<>();if(headerDeferred){pendingHeader=result;return result;}if(headerFails){result.fail(new IllegalStateException("declared header boundary failure"));return result;}result.complete(J.obj("allowed",headerGuard&&targetAllowed&&timeZoneAllows(current),"target",target).toString());return result;}
    // Real current lease map/release; no IP lookup or native transport is modeled.
    @IP_ROUTE_FIELDS@
    static final class IpLookupBoundary {SessionBoundary session;TimeZoneGate gate;private IpLookupBoundary(){throw new UnsupportedOperationException("IP lookup is outside this manual HTTP-wait boundary");}}
    IpLookupBoundary ipLookup=null;
    void cancelIpLookup(){throw new UnsupportedOperationException("IP lookup is outside this manual HTTP-wait boundary");}
    boolean manualTimeZonePolicy=true;int manualIpFailureNotifications;
    void finishIpNavigationFailure(SessionBoundary session,TimeZoneGate gate,String issue){if(!manualTimeZonePolicy)throw new UnsupportedOperationException("IP failure UI is outside this manual HTTP-wait boundary");manualIpFailureNotifications++;}
    @METHODS@
  }
  static WebBoundary.TimeZoneGate gate(WebBoundary web){return web.timeZoneGates.get(web.current);}
  static void ready(WebBoundary web){WebBoundary.TimeZoneGate gate=gate(web);gate.preparing=false;gate.revalidating=false;gate.ready=true;web.owner.timeZone.grant(web.current,gate.epoch);}
  static boolean allowed(ResultBoundary<Object> result){return result.done&&J.parse(String.valueOf(result.value)).optBoolean("allowed");}
  static void denied(String name,ResultBoundary<Object> result){check(name,result.done&&!allowed(result)&&result.completions==1);}
  static void entry(){
    for(String kind:List.of("no-gate","idle","bootstrap","not-preparing")){
      WebBoundary web=new WebBoundary();WebBoundary.TimeZoneGate gate=gate(web);
      if(kind.equals("no-gate"))web.timeZoneGates.clear();if(kind.equals("idle")){gate.preparing=false;gate.revalidating=false;}if(kind.equals("bootstrap"))gate.revalidating=false;if(kind.equals("not-preparing"))gate.preparing=false;
      ResultBoundary<Object> route=web.guardedRoute(TARGET),header=web.guardedRequestHeaderPolicy(TARGET);
      check("Only committed native revalidation holds HTTP: "+kind,route.done&&header.done&&!allowed(route)&&!allowed(header)&&web.routeCalls==1&&web.headerCalls==1&&gate.networkWaiting.isEmpty()&&web.owner.handler.tasks.isEmpty());
    }
    WebBoundary web=new WebBoundary();ready(web);check("An already verified document uses the existing helpers immediately",allowed(web.guardedRoute(TARGET))&&allowed(web.guardedRequestHeaderPolicy(TARGET))&&web.routeCalls==1&&web.headerCalls==1);
  }
  static void success(){
    WebBoundary web=new WebBoundary();WebBoundary.TimeZoneGate gate=gate(web);List<Boolean> privateCompletion=new ArrayList<>();gate.waiting.add(privateCompletion::add);
    ResultBoundary<Object> route=web.guardedRoute(TARGET),header=web.guardedRequestHeaderPolicy(TARGET);
    check("Revalidation holds both HTTP helpers without invoking them",!route.done&&!header.done&&web.routeCalls==0&&web.headerCalls==0&&gate.networkWaiting.size()==2&&web.owner.handler.delays.equals(List.of(4000L,4000L)));
    web.owner.timeZone.grant(web.current,gate.epoch);web.finishTimeZone(web.current,gate,true);
    check("Private native completion releases both HTTP helpers exactly once",allowed(route)&&allowed(header)&&route.completions==1&&header.completions==1&&web.routeCalls==1&&web.headerCalls==1&&gate.networkWaiting.isEmpty()&&web.owner.handler.tasks.isEmpty());
    check("Private completion does not wait for a public HTTP result callback",privateCompletion.equals(List.of(true))&&web.owner.changes==1);
    WebBoundary independent=new WebBoundary();WebBoundary.TimeZoneGate separate=gate(independent);List<Boolean> done=new ArrayList<>();separate.waiting.add(done::add);ResultBoundary<Object> throwing=independent.guardedRoute(TARGET);throwing.accept(value->{throw new IllegalStateException("controlled public HTTP listener failure");},error->{});ResultBoundary<Object> survivor=independent.guardedRequestHeaderPolicy(TARGET);independent.owner.timeZone.grant(independent.current,separate.epoch);independent.finishTimeZone(independent.current,separate,true);
    check("One throwing public HTTP listener cannot block private completion or other HTTP waiters",allowed(survivor)&&done.equals(List.of(true))&&separate.networkWaiting.isEmpty()&&independent.owner.handler.tasks.isEmpty());
  }
  static void fence(String kind){
    WebBoundary web=new WebBoundary();SessionBoundary original=web.current;WebBoundary.TimeZoneGate initial=gate(web);ResultBoundary<Object> route=web.guardedRoute(TARGET),header=web.guardedRequestHeaderPolicy(TARGET);ready(web);
    switch(kind){
      case "current":web.current=new SessionBoundary();web.locations.put(web.current,TARGET);web.timeZoneGates.put(web.current,initial);web.owner.timeZone.grant(web.current,initial.epoch);break;
      case "gate":WebBoundary.TimeZoneGate replacement=new WebBoundary.TimeZoneGate();replacement.ready=true;web.timeZoneGates.put(original,replacement);web.owner.timeZone.grant(original,replacement.epoch);break;
      case "document":initial.documentSerial++;break;
      case "port":web.routePort=new PortBoundary();break;
      case "null-port":web.routePort=null;break;
      case "navigation":web.owner.navigationEpoch++;break;
      case "connection":web.owner.connectionEpoch++;break;
      case "identity-policy":web.identityPolicyRevision++;break;
      case "protection":web.nativeProtection.generation++;break;
      case "desired-revision":web.owner.timeZone.desiredRevision++;break;
      case "desired-missing":web.owner.timeZone.includeDesired=false;break;
      case "sdk-readiness":original.sdkReady=false;break;
      case "controller-open-epoch":web.owner.timeZone.grant(original,"retired-open-epoch");break;
      case "controller-object":web.owner.timeZone.grants.clear();web.owner.timeZone.grant(new SessionBoundary(),initial.epoch);break;
      case "gate-readiness":initial.ready=false;break;
      case "closed":original.open=false;break;
      case "deleted":web.owner.deleted=true;break;
      case "destroyed":web.destroyed=true;break;
      case "unknown-session":web.locations.clear();break;
      default:throw new AssertionError("Unknown fence "+kind);
    }
    web.completeTimeZoneRequests(initial,true);
    check("Held HTTP denies changed fence before either helper: "+kind,route.done&&header.done&&!allowed(route)&&!allowed(header)&&route.completions==1&&header.completions==1&&web.routeCalls==0&&web.headerCalls==0&&initial.networkWaiting.isEmpty()&&web.owner.handler.tasks.isEmpty());
  }
  static void helpers(){
    for(String kind:List.of("target","route-guard","header-guard")){
      WebBoundary web=new WebBoundary();WebBoundary.TimeZoneGate gate=gate(web);ResultBoundary<Object> route=web.guardedRoute(TARGET),header=web.guardedRequestHeaderPolicy(TARGET);ready(web);
      if(kind.equals("target"))web.targetAllowed=false;if(kind.equals("route-guard"))web.routeGuard=false;if(kind.equals("header-guard"))web.headerGuard=false;web.completeTimeZoneRequests(gate,true);
      check("Successful release reruns current target and application helpers: "+kind,web.routeCalls==1&&web.headerCalls==1&&TARGET.equals(web.lastRoute)&&TARGET.equals(web.lastHeader)&&allowed(route)==(!kind.equals("target")&&!kind.equals("route-guard"))&&allowed(header)==(!kind.equals("target")&&!kind.equals("header-guard")));
    }
    WebBoundary failure=new WebBoundary();WebBoundary.TimeZoneGate fg=gate(failure);ResultBoundary<Object> failed=failure.guardedRequestHeaderPolicy(TARGET);failure.headerFails=true;ready(failure);failure.completeTimeZoneRequests(fg,true);denied("Held header helper failure produces an explicit denial",failed);
    WebBoundary delayed=new WebBoundary();WebBoundary.TimeZoneGate dg=gate(delayed);ResultBoundary<Object> answer=delayed.guardedRequestHeaderPolicy(TARGET);delayed.headerDeferred=true;ready(delayed);delayed.completeTimeZoneRequests(dg,true);check("The wrapper preserves asynchronous header helper completion",!answer.done&&delayed.headerCalls==1&&delayed.owner.handler.tasks.isEmpty());delayed.pendingHeader.complete(J.obj("allowed",true).toString());check("Asynchronous header completion resolves the held request once",allowed(answer)&&answer.completions==1);
  }
  static void cap(){
    WebBoundary web=new WebBoundary();WebBoundary.TimeZoneGate gate=gate(web);List<ResultBoundary<Object>> held=new ArrayList<>();for(int i=0;i<128;i++)held.add(web.guardedRoute(TARGET));ResultBoundary<Object> overflow=web.guardedRoute(TARGET);
    check("The 129th HTTP waiter is denied without growing the 128-entry queue",held.stream().noneMatch(result->result.done)&&overflow.done&&!allowed(overflow)&&overflow.completions==1&&gate.networkWaiting.size()==128&&web.owner.handler.tasks.size()==128&&web.routeCalls==0);
    web.completeTimeZoneRequests(gate,false);web.completeTimeZoneRequests(gate,false);check("Close or next-commit failure releases every bounded waiter once",held.stream().allMatch(result->result.done&&!allowed(result)&&result.completions==1)&&gate.networkWaiting.isEmpty()&&web.owner.handler.tasks.isEmpty()&&overflow.completions==1);
  }
  static void timeout(){
    WebBoundary web=new WebBoundary();WebBoundary.TimeZoneGate gate=gate(web);ResultBoundary<Object> route=web.guardedRoute(TARGET),header=web.guardedRequestHeaderPolicy(TARGET);web.owner.handler.advance(3999);check("HTTP revalidation stays pending before its four-second deadline",!route.done&&!header.done&&gate.networkWaiting.size()==2);web.owner.handler.advance(1);
    check("At four seconds timed-out HTTP waiters are removed and denied once",route.done&&header.done&&!allowed(route)&&!allowed(header)&&route.completions==1&&header.completions==1&&gate.networkWaiting.isEmpty()&&web.owner.handler.tasks.isEmpty()&&web.routeCalls==0&&web.headerCalls==0);ready(web);web.completeTimeZoneRequests(gate,true);check("Native completion after HTTP timeout cannot retry public work",route.completions==1&&header.completions==1&&web.routeCalls==0&&web.headerCalls==0);
  }
  static void race(){
    for(boolean completionFirst:new boolean[]{true,false}){
      WebBoundary web=new WebBoundary();WebBoundary.TimeZoneGate gate=gate(web);ResultBoundary<Object> result=web.guardedRoute(TARGET);Runnable deadline=web.owner.handler.tasks.get(0).runnable;
      if(completionFirst){ready(web);web.completeTimeZoneRequests(gate,true);deadline.run();}else{deadline.run();ready(web);web.completeTimeZoneRequests(gate,true);deadline.run();}
      check("HTTP completion and a dequeued timeout resolve only once: "+completionFirst,result.completions==1&&allowed(result)==completionFirst&&web.routeCalls==(completionFirst?1:0)&&gate.networkWaiting.isEmpty()&&web.owner.handler.tasks.isEmpty());
    }
    WebBoundary web=new WebBoundary();WebBoundary.TimeZoneGate gate=gate(web);int[] called={0};gate.networkWaiting.add(value->{called[0]++;throw new IllegalArgumentException("controlled waiter exception");});gate.networkWaiting.add(value->called[0]++);web.completeTimeZoneRequests(gate,false);web.completeTimeZoneRequests(gate,false);check("A failing waiter cannot prevent queue draining or release a callback twice",called[0]==2&&gate.networkWaiting.isEmpty());
  }
  static void failedPrivate(){
    for(String kind:List.of("native-failure","sdk-not-ready")){
      WebBoundary web=new WebBoundary();WebBoundary.TimeZoneGate gate=gate(web);ResultBoundary<Object> result=web.guardedRoute(TARGET);List<Boolean> privateCompletion=new ArrayList<>();gate.waiting.add(privateCompletion::add);web.owner.timeZone.grant(web.current,gate.epoch);if(kind.equals("sdk-not-ready"))web.current.sdkReady=false;web.finishTimeZone(web.current,gate,!kind.equals("native-failure"));
      check("An unfinished private native proof releases HTTP as denied: "+kind,result.done&&!allowed(result)&&result.completions==1&&privateCompletion.equals(List.of(false))&&web.routeCalls==0&&gate.networkWaiting.isEmpty()&&web.owner.handler.tasks.isEmpty());
    }
  }
  static void proofOrder(){
    WebBoundary web=new WebBoundary();WebBoundary.TimeZoneGate gate=gate(web);gate.proofWaiting.add(ready->web.events.add(ready?"proof":"proof-denied"));ResultBoundary<Object> route=web.guardedRoute(TARGET),header=web.guardedRequestHeaderPolicy(TARGET);web.owner.timeZone.grant(web.current,gate.epoch);web.finishTimeZone(web.current,gate,true);
    check("Private document proof callbacks run before public HTTP helpers",web.events.equals(List.of("proof","route","headers"))&&allowed(route)&&allowed(header)&&gate.proofWaiting.isEmpty()&&gate.networkWaiting.isEmpty()&&web.owner.handler.tasks.isEmpty());
  }
  static void actualIpLease(){
    WebBoundary web=new WebBoundary();WebBoundary.TimeZoneGate gate=gate(web);ChromiumRouteLease.Registry registry=new ChromiumRouteLease.Registry();ChromiumRouteLease.Handle handle=registry.acquireSurface();web.ipRouteLeases.put(gate,handle);
    web.releaseIpRoute(new WebBoundary.TimeZoneGate());check("An unrelated gate cannot release the current IP lease",registry.held()&&web.ipRouteLeases.get(gate)==handle&&!handle.closed);
    web.releaseIpRoute(gate);check("Actual IP lease release removes its exact gate entry",web.ipRouteLeases.isEmpty());check("Actual IP lease release closes its real registry handle",handle.closed&&!registry.held());
    long revision=registry.snapshot().revision;web.releaseIpRoute(gate);check("Actual IP lease release is idempotent after removal",registry.snapshot().revision==revision&&!registry.held());
    handle=registry.acquireSurface();web.ipRouteLeases.put(gate,handle);web.owner.timeZone.grant(web.current,gate.epoch);web.finishTimeZone(web.current,gate,true);check("Actual finish method closes its owned IP lease",web.ipRouteLeases.isEmpty()&&handle.closed&&!registry.held());
  }
  static void run(String focus){
    if(focus.startsWith("fence:")){fence(focus.substring(6));return;}
    switch(focus){case "entry":entry();return;case "success":success();return;case "helpers":helpers();return;case "cap":cap();return;case "timeout":timeout();return;case "race":race();return;case "failed-private":failedPrivate();return;case "proof-order":proofOrder();return;case "ip-lease":actualIpLease();return;default:throw new AssertionError("Unknown focus "+focus);}
  }
  public static void main(String[] args){
    if(args.length>0)run(args[0]);else{for(String group:List.of("entry","success","helpers","cap","timeout","race","failed-private","proof-order","ip-lease"))run(group);for(String kind:List.of("current","gate","document","port","null-port","navigation","connection","identity-policy","protection","desired-revision","desired-missing","sdk-readiness","controller-open-epoch","controller-object","gate-readiness","closed","deleted","destroyed","unknown-session"))fence(kind);}
    JSONArray values=new JSONArray();for(JSONObject check:checks)values.put(check);System.out.println(J.obj("status","passed","passed",checks.size(),"total",checks.size(),"checks",values,"actualAndroidExecution",false,"actualGeckoExecution",false,"scope","Actual selected GeckoWebView HTTP wait/gate methods with declared SDK, Handler, private-controller and counting route/header application boundaries; no browser, native SDK, network or performance execution"));
  }
}

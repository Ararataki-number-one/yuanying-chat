package local.pocketchat;
import android.content.*;import android.net.Uri;import org.json.*;import java.util.*;

/** Exact producer/current/receipt predicates, controlled proof construction and cached core state. */
public final class ColdCoreWindowStateHost {
 static final JSONArray checks=new JSONArray();static final String OWNER="00000000-0000-4000-8000-000000000007";
 static void check(String name,boolean pass){checks.put(J.obj("name",name,"pass",pass));if(!pass)throw new AssertionError(name);}
 static JSONObject row(String owner,int generation){return J.obj("slot",7,"environmentId",owner,"generation",generation,"name","Cold core");}
 static NativeNetwork core(){NativeNetwork n=new NativeNetwork();n.settings=J.obj("_fingerprint","configuration-a","subscriptionUrl","controlled-subscription","subscriptionName","Controlled","entryMode","manual","entry","Entry|A","exitHost","192.0.2.9","exitPort",1080,"exitRegion","Controlled region");n.transport.state=J.obj("alive",true,"generation","core-a","pid",100,"servicePid",101,"configuration","configuration-a","controllerPort",n.controllerPort,"proxyPort",n.proxyPort);n.verifiedRoute=new NativeNetwork.ExitRouteReceipt(n,n.transport.state);return n;}
 static void seed(NativeNetwork n){NetworkCoreApplication.observed=new NetworkCoreApplication(new EnvironmentSpec.Identity(7,2,OWNER),n);}
 static void replace(NativeNetwork n){try{n.transport.state=new JSONObject(n.transport.state.toString()).put("generation","core-b");n.verifiedRoute=new NativeNetwork.ExitRouteReceipt(n,n.transport.state);seed(n);}catch(JSONException failure){throw new IllegalStateException(failure);}}
 static WindowNetworkState shown(JSONObject row,NativeNetwork n){JSONObject live=WindowNetworkState.live(null,n);return new WindowNetworkState(n.context,row,n.settings==null?new JSONObject():n.settings,live,true,System.currentTimeMillis());}
 static void current()throws Exception{
  NativeNetwork n=core();seed(n);JSONObject running=WindowNetworkState.running(null,n),live=WindowNetworkState.live(null,n);
  check("Cold running identity and scope come from exact current proof",running.optString("environmentId").equals(OWNER)&&running.optInt("generation")==2&&running.optString("scope").equals("core")&&running.optBoolean("verified"));
  check("Cold live producer is connected only with current VERIFIED proof",live.optString("environmentId").equals(OWNER)&&live.optInt("generation")==2&&live.optBoolean("connected")&&live.getJSONObject("runningConfiguration").optString("scope").equals("core"));
  check("Owned current cold producer reaches original constructor",shown(row(OWNER,2),n).connected&&shown(row(OWNER,2),n).state.equals("正常"));
  check("Reused slot UUID rejects cold proof observation",!shown(row("00000000-0000-4000-8000-000000000008",2),n).connected&&shown(row("00000000-0000-4000-8000-000000000008",2),n).runtime.length()==0);
  check("Recreated environment generation rejects cold proof observation",!shown(row(OWNER,3),n).connected&&shown(row(OWNER,3),n).runtime.length()==0);
  check("Cold running projection copies no saved credentials",!running.has("exitPassword")&&!running.has("exitUser")&&!running.has("subscriptionUrl")&&running.optString("configurationFingerprint").equals("configuration-a"));
  NetworkCoreApplication.observed=null;check("Ready alive core without captured proof is not admission",WindowNetworkState.running(null,n).length()==0&&!WindowNetworkState.live(null,n).optBoolean("connected"));
  JSONObject historical=J.obj("applicationState","applied","scope","core","environmentId",OWNER,"generation",2,"configurationFingerprint","configuration-a","coreGeneration","core-a");
  check("Historical application event cannot manufacture observed proof",historical.optString("applicationState").equals("applied")&&NetworkCoreApplication.observed(n)==null&&WindowNetworkState.running(null,n).length()==0&&!WindowNetworkState.live(null,n).optBoolean("connected"));
  seed(n);n.admission=NetworkHealthPolicy.Admission.DEGRADED_VERIFICATION;check("Cold degraded admission rejects captured proof and connection",NetworkCoreApplication.observed(n)==null&&WindowNetworkState.running(null,n).length()==0&&!WindowNetworkState.live(null,n).optBoolean("connected"));
  ChatSession warm=new ChatSession();JSONObject retained=WindowNetworkState.running(warm,n);check("Existing warm session retains its original degraded route semantics",retained.optString("scope").equals("session")&&!retained.optBoolean("verified")&&WindowNetworkState.live(warm,n).optBoolean("connected"));
  warm.guard.allowed=false;check("Existing session guard still rejects a warm running configuration",WindowNetworkState.running(warm,n).length()==0&&!WindowNetworkState.live(warm,n).optBoolean("connected"));
  for(String mutation:new String[]{"not-ready","starting","blocked","transport-missing","settings-missing","receipt-replaced","core-generation","core-pid","service-pid","core-dead","route-serial","entry","configuration","token","controller","proxy","state-configuration","other-native-instance"}){
   n=core();seed(n);
   switch(mutation){case "not-ready":n.ready=false;break;case "starting":n.starting=true;break;case "blocked":n.recoveryBlocked=true;break;case "transport-missing":n.transport=null;break;case "settings-missing":n.settings=null;break;case "receipt-replaced":n.verifiedRoute=new NativeNetwork.ExitRouteReceipt(n,n.transport.state);break;case "core-generation":n.transport.state.put("generation","core-b");break;case "core-pid":n.transport.state.put("pid",102);break;case "service-pid":n.transport.state.put("servicePid",103);break;case "core-dead":n.transport.state.put("alive",false);break;case "route-serial":n.routeSerial++;break;case "entry":n.currentEntry="Entry|B";break;case "configuration":n.settings.put("_fingerprint","configuration-b");break;case "token":n.token="replacement-token";break;case "controller":n.controllerPort++;break;case "proxy":n.proxyPort++;break;case "state-configuration":n.transport.state.put("configuration","configuration-b");break;case "other-native-instance":n=core();break;default:throw new AssertionError(mutation);}
   check("Current proof rejects stale core/route "+mutation,NetworkCoreApplication.observed(n)==null&&WindowNetworkState.running(null,n).length()==0&&!WindowNetworkState.live(null,n).optBoolean("connected"));
  }
  check("Null native cannot create a running configuration",WindowNetworkState.running(null,null).length()==0);
  NativeNetwork raced=core();ReplacementState state=new ReplacementState(raced.transport.state.toString());raced.transport.state=state;seed(raced);state.replace=()->replace(raced);
  check("Running rejects replacement between observed proof and receipt reads",WindowNetworkState.running(null,raced).length()==0&&raced.transport.state.optString("generation").equals("core-b")&&raced.connectionAdmission()==NetworkHealthPolicy.Admission.VERIFIED);
  check("A fresh read of the replacement proof recovers normally",WindowNetworkState.running(null,raced).optBoolean("verified"));
  NativeNetwork between=core();seed(between);Context.beforeRead=()->replace(between);JSONObject replaced=WindowNetworkState.live(null,between);
  check("Live rejects replacement between first proof and running projection",!replaced.optBoolean("connected")&&replaced.optString("admission").equals("BLOCKED")&&replaced.optJSONObject("runningConfiguration").length()==0);
  NativeNetwork after=core();seed(after);after.refreshHook=()->replace(after);JSONObject finalRace=WindowNetworkState.live(null,after);
  check("Live rejects replacement after running but before final projection",!finalRace.optBoolean("connected")&&finalRace.optString("admission").equals("BLOCKED")&&finalRace.optJSONObject("runningConfiguration").length()==0);
  NativeNetwork ownerRace=core();seed(ownerRace);Context.beforeRead=()->NetworkCoreApplication.observed=new NetworkCoreApplication(new EnvironmentSpec.Identity(7,3,"00000000-0000-4000-8000-000000000008"),ownerRace);JSONObject rebound=WindowNetworkState.live(null,ownerRace);
  check("Live cannot attach old proof ownership to replacement owner",!rebound.optBoolean("connected")&&rebound.optString("admission").equals("BLOCKED")&&rebound.optJSONObject("runningConfiguration").length()==0);
 }
 public static void main(String[] ignored)throws Exception{String failure="";try{current();}catch(AssertionError error){failure=error.toString();}int passed=0;for(int i=0;i<checks.length();i++)if(checks.optJSONObject(i).optBoolean("pass"))passed++;boolean ok=failure.isEmpty()&&passed==checks.length();System.out.println(J.obj("status",ok?"passed":"failed","total",checks.length(),"passed",passed,"checks",checks,"failure",failure,"actualAndroidExecution",false,"actualCoreCaptureIpc",false,"historicalEventIsAdmission",false));if(!ok)System.exit(1);}
}
class WindowNetworkState{/* STATE_FIELDS *//* STATE_IDENTITY *//* STATE_CONSTRUCTOR *//* STATE_RUNNING *//* STATE_LIVE */}
class NetworkCoreApplication {
 static volatile NetworkCoreApplication observed;final EnvironmentSpec.Identity identity;final NativeNetwork nativeNetwork;final NativeNetwork.ExitRouteReceipt route;final String configuration;
 NetworkCoreApplication(EnvironmentSpec.Identity identity,NativeNetwork n){this.identity=identity;nativeNetwork=n;route=n.verifiedRoute;configuration=route.configuration;}
 /* CORE_OBSERVED */
 /* CORE_CURRENT */
}
class ChatSession {boolean deleted,offline,connecting;boolean networkReady=true;String environmentId=ColdCoreWindowStateHost.OWNER,appliedIdentity="controlled-applied",networkIssue="";int environmentGeneration=2;final SharedPreferences prefs=new Context().getSharedPreferences("chat",0);final Guard guard=new Guard();boolean internalNetwork(){return true;}String networkIdentity(){return "controlled-applied";}long identityAuditAppliedRevision(){return 4;}}
class Guard {boolean allowed=true;boolean allowed(){return allowed;}}
class NativeNetwork {
 final Context context=new Context();boolean ready=true,starting,recoveryBlocked,latencyRefreshQueued,measuringLatency;JSONObject settings,latencyReading=new JSONObject(),websiteResult=new JSONObject();String currentEntry="Entry|A",fingerprint="fixed-exit",token="controlled-token",healthStatus="unknown",exitIp="192.0.2.42",observedExitIp="",message="",activeDns="";int controllerPort=9000,proxyPort=9001,healthTargetCode;long routeSerial=1,lastVerified=1000,healthObservedAt;java.lang.Process process;Transport transport=new Transport();ExitRouteReceipt verifiedRoute;NetworkHealthPolicy.Admission admission=NetworkHealthPolicy.Admission.VERIFIED;final Quality quality=new Quality();final Dns dns=new Dns();
 static String transportFingerprint(JSONObject settings){return settings.optString("_fingerprint");} // Opaque controlled fingerprint input, not a copied hash algorithm.
 Runnable refreshHook;void refreshLatency(){Runnable hook=refreshHook;refreshHook=null;if(hook!=null)hook.run();}String probeRouteKey(){return "controlled-probe";}long latencyRemaining(long now){return 120000;}
 /* NATIVE_METHODS */
 /* NATIVE_ADMISSION */
 /* NATIVE_RECEIPT */
}
class Transport {JSONObject state;}
class ReplacementState extends JSONObject {int proxyReads;Runnable replace;ReplacementState(String source)throws JSONException{super(source);}@Override public int optInt(String key){int value=super.optInt(key);if(key.equals("proxyPort")&&++proxyReads==2&&replace!=null){Runnable hook=replace;replace=null;hook.run();}return value;}}
class Quality {JSONObject stats(String entry,long now){return new JSONObject();}JSONObject currentSample(String entry,long now,String key){return J.obj("delay",12,"at",now);}}
class Dns {String primary(long now){return "";}}
class Profiles {static Context context(Context c,int slot){return c;}}
class NetworkRegion {static boolean latencyRunning;static String region(Context c,String ip){return "";}static void refreshLatency(ChatSession s,Object unused){}static JSONObject latency(Context c,ChatSession s){return new JSONObject();}static String latencyRoute(ChatSession s){return "";}static long latencyRemaining(ChatSession s,long now){return 0;}static String exitIp(Context c,ChatSession s){return "";}}
class NetworkCatalog {/* CATALOG_EXIT_ID *//* CATALOG_SUBSCRIPTION *//* CATALOG_PUT */}

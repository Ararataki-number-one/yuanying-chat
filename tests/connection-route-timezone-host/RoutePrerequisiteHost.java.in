package local.pocketchat;
import java.util.*;import java.util.function.Consumer;import org.json.*;
public final class RoutePrerequisiteHost {
  static final List<String> checks=new ArrayList<>();
  static void verified(String name,boolean pass){if(!pass)throw new AssertionError(name);checks.add(name);}
  static final class Fixture {
    static final String ORIGIN="https://127.0.0.1:9879";
    final ChatSession session=new ChatSession();final GeckoWebView view=new GeckoWebView(session);
    final Object fixtureIdentity=new Object();final JSONObject report=new JSONObject();
    String acknowledgement="accepted";int setupPolls;long budget;Throwable failure;
    @@FIELD@@
    interface Work<T>{T run()throws Exception;}
    <T>T ui(Work<T> task)throws Exception{return task.run();}
    void event(String name,JSONObject state){}
    void check(String name,boolean pass){if(!pass)throw new AssertionError(name);checks.add(name);}
    void await(String name,Work<Boolean> predicate,long timeout)throws Exception{
      budget=timeout;
      for(int poll=0;poll<4;poll++){
        setupPolls++;if(predicate.run())return;
        if(view.callback!=null&&poll==0){
          view.allows=true;view.nativeAck=acknowledgement.equals("string")?"true":acknowledgement.equals("missing")?Boolean.FALSE:Boolean.TRUE;
          if(acknowledgement.equals("replaced-gate"))view.timeZoneGates.put(view.current,new Object());
          view.callback.accept(true);
        }
      }
      throw new SetupBlocked();
    }
    void setup()throws Exception{
      @@SETUP@@
    }
  }
  static final class SetupBlocked extends Exception {}
  static Fixture run(String acknowledgement)throws Exception{
    Fixture fixture=new Fixture();fixture.acknowledgement=acknowledgement;
    try{fixture.setup();}catch(SetupBlocked expected){fixture.failure=expected;}
    return fixture;
  }
  public static void main(String[] args)throws Exception{
    Fixture ready=run("accepted");
    verified("Original setup keeps its sixty-second budget",ready.budget==60000);
    verified("Actual native prerequisite waits for one asynchronous callback",ready.setupPolls==2&&ready.view.prepares==1);
    verified("Exactly the original controlled document is dispatched",ready.view.loads==1&&ready.view.queued.isEmpty()&&ready.session.navigationEpoch==0);
    verified("Both original before-load and after-load observations were retained",ready.report.has("beforeControlledLoad")&&ready.report.has("afterControlledLoad"));
    for(String state:new String[]{"missing","string","replaced-gate"}){
      Fixture blocked=run(state);
      verified("Setup cannot dispatch without its exact typed native confirmation: "+state,blocked.failure instanceof SetupBlocked&&blocked.view.loads==0&&blocked.view.prepares==1);
      verified("Rejected prerequisite never reaches the original document load: "+state,!blocked.report.has("afterControlledLoad"));
    }
    System.out.println(J.obj("status","passed","passed",checks.size(),"total",checks.size(),"checks",new JSONArray(checks),"actualAndroidExecution",false,"actualGeckoExecution",false,"actualNativeReadback",false));
  }
}
final class GeckoSession {boolean open=true;boolean isOpen(){return open;}}
final class Guard {boolean allowed=true;boolean allowed(){return allowed;}}
final class DefaultNetwork {DefaultNetwork snapshot(){return this;}boolean usable(){return true;}}
final class ChatSession {String environmentId="original";int environmentGeneration=1;boolean deleted,connecting,networkReady=true;long navigationEpoch;final Guard guard=new Guard();final DefaultNetwork browserDefaultNetwork=new DefaultNetwork();}
final class GeckoWebView {
  final ChatSession owner;GeckoSession current=new GeckoSession();Object runtime=new Object(),routePort=new Object();boolean ready=true,privacyReady=true,identityPrepared=true,routePrepared=true,requestHeadersInstalled=true,allows;
  Object nativeAck=Boolean.FALSE;long identityPolicyRevision=1,revision=1;final Map<GeckoSession,Object> timeZoneGates=new IdentityHashMap<>();int prepares,loads;String queued="";Consumer<Boolean> callback;
  GeckoWebView(ChatSession owner){this.owner=owner;}
  boolean protectionAllowsNetwork(){return true;}Object nativeRuntimeIdentity(){return runtime;}boolean timeZoneAllows(GeckoSession session){return session==current&&allows;}
  JSONObject timeZoneStatus(){return J.obj("desiredRevision",revision,"nativeSettingReadback",nativeAck,"currentSessionPrepared",Boolean.TRUE,"scope","top-browsing-context");}
  void prepareTimeZone(GeckoSession session,Consumer<Boolean> done){if(session!=current)throw new AssertionError("Wrong session prepared");prepares++;timeZoneGates.putIfAbsent(session,new Object());callback=done;}
  // Explicit queue boundary: actual Gecko load/prepare semantics are independently
  // exercised by timezone-routing-host. No SDK or HTTP runs in this fixture.
  void loadUrl(String url){queued=url;if(timeZoneAllows(current)){queued="";loads++;}}
}
final class GeckoConnectionPoolIntegrationActivity {
  @@HELPER@@
  @@SETTLED@@
  static JSONObject startupState(ChatSession session,GeckoWebView view,Object identity){return J.obj("ready",view.ready,"privacyReady",view.privacyReady,"identityPrepared",true,"routePrepared",true,"bridgeReady",true,"guardAllowed",true,"networkReady",true,"connecting",false,"navigating",false,"pendingBrowserSettings",false,"identityApplicationPending",false,"queueUnavailable",false,"privacyLevel",0,"protectionLevel",0,"requestedProtection",0,"identityMatches",true,"desiredMatches",true,"epoch",session.navigationEpoch,"queued",view.queued,"environmentSpecIssue","");}
}
final class NetworkCatalog {static void put(JSONObject report,String name,JSONObject value)throws Exception{report.put(name,value);}}

package local.pocketchat;
import java.util.*;import java.util.concurrent.*;import java.util.function.*;import java.net.*;import org.json.*;
/** Current methods with explicit SDK, monotonic clock, UI/executor and report-builder boundaries. */
public final class Host {
 static final List<String> checks=new ArrayList<>();static void check(String name,boolean value){if(!value)throw new AssertionError(name);checks.add(name);}
 static ChatSession fresh(){SystemClock.now=0;return new ChatSession();}
 static int[] done(){return new int[1];}
 static void quiet(String label,ChatSession s){check(label+" has not captured expected or report",s.audit.captures==0&&s.audit.builds==0&&s.audit.report.length()==0);check(label+" sends no script or native query",s.web.auditMessages()==0&&s.audit.worker.tasks.isEmpty()&&s.audit.nativeQueries==0);check(label+" cannot be fresh or admit diagnostic network",!s.audit.fresh());}
 static void ready(){ChatSession s=fresh();s.web.prove(true);int[] done=done();check("Already confirmed current document starts exactly one ordinary audit",s.audit.start(false,()->done[0]++)&&s.audit.pendingPageAudit==null&&s.audit.captures==1&&s.web.auditMessages()==1);s.web.answer();check("A successful owned script completes a fresh report once",done[0]==1&&!s.audit.running&&s.audit.report.optBoolean("fresh")&&s.audit.builds==1);}
 static void asynchronous(){ChatSession s=fresh();int[] done=done();check("Visible document can enter a distinct cancellable pending state",s.audit.start(true,()->done[0]++)&&s.audit.running&&s.audit.pendingPageAudit!=null&&!s.audit.geckoRun);quiet("Pending request",s);check("Pending audit rejects a second start without replacing completion",!s.audit.start(false,()->{throw new AssertionError("replaced completion");}));s.handler.advance(2500);s.timeZone.boundary();check("Owned native-proof transition does not cancel unsampled request",s.audit.running&&s.audit.pendingPageAudit!=null&&done[0]==0);quiet("Waiting after native boundary",s);s.web.prove(true);check("Only actual modeled proof callback permits sampling",s.audit.pendingPageAudit==null&&s.audit.captures==1&&s.web.auditMessages()==1&&s.audit.worker.tasks.size()==1);check("Sampling uses the latest complete native proof stamp",s.audit.policy.equals(s.audit.policyStamp())&&s.audit.initial.optLong("proofSerial")==s.timeZone.auditSerial);check("Time spent pending reduces the original script budget",s.web.lastBudget()==11500&&s.audit.deadline==14000);s.audit.worker.runAll();s.handler.advance(0);s.web.answer();check("Owned network and web callbacks complete only once",done[0]==1&&s.audit.builds==1&&s.audit.nativeQueries==1&&!s.audit.running);s.web.prove(true);s.handler.advance(20000);check("Late proof and old hard deadline cannot repeat completion",done[0]==1&&s.audit.builds==1);}
 static void rejection(){for(String cause:new String[]{"native-false","timeout","user-cancel","destroyed"}){ChatSession s=fresh();int[] done=done();s.audit.start(true,()->done[0]++);if(cause.equals("native-false"))s.web.prove(false);if(cause.equals("timeout"))s.handler.advance(6000);if(cause.equals("user-cancel"))s.audit.cancel();if(cause.equals("destroyed")){s.web.destroyed=true;s.web.completeTimeZoneProofs(s.web.gate(),false);}check("Pending failure ends exactly once: "+cause,!s.audit.running&&s.audit.pendingPageAudit==null&&done[0]==1);quiet("Retired "+cause,s);s.web.prove(true);s.handler.advance(20000);check("Retired request ignores late ACK and all deadlines: "+cause,done[0]==1&&s.audit.captures==0);}}
 static void ownerChanges(){for(String cause:new String[]{"navigation-before-epoch","route-before-epoch","configuration","desired","identity","policy-revision","connection","url","uuid","privacy","runtime","open","page-port","route-port","document","session","environment","deleted","protected-token"}){ChatSession s=fresh();int[] done=done();s.audit.start(false,()->done[0]++);
  switch(cause){case"navigation-before-epoch":case"route-before-epoch":s.audit.retirePageCheck();break;case"configuration":s.timeZone.configuration++;break;case"desired":s.timeZone.desired++;break;case"identity":s.applied++;break;case"policy-revision":s.web.identityPolicyRevision++;break;case"connection":s.connectionEpoch++;break;case"url":s.web.url+="/other";break;case"uuid":s.environmentId="replacement-environment";break;case"privacy":s.privacy.level++;break;case"runtime":s.web.runtime=new GeckoRuntime();break;case"open":s.web.timeZoneGates.put(s.web.current,new GeckoWebView.TimeZoneGate());break;case"page-port":s.web.ports.put(s.web.current,new WebExtension.Port());break;case"route-port":s.web.routePort=new WebExtension.Port();break;case"document":s.web.gate().documentSerial++;break;case"session":s.web.current=new GeckoSession();break;case"environment":s.environmentGeneration++;break;case"deleted":s.deleted=true;break;case"protected-token":s.web.nativeProtection.value++;break;}
  s.timeZone.boundary();check("Any changed owner or configuration retires pending work: "+cause,!s.audit.running&&s.audit.pendingPageAudit==null&&done[0]==1);quiet("Changed "+cause,s);s.web.prove(true);check("Changed owner cannot be resurrected by ACK: "+cause,s.audit.captures==0&&done[0]==1);
 }}
 static void staleAndBusy(){ChatSession s=fresh();int[] first=done(),second=done();s.audit.start(false,()->first[0]++);List<Consumer<Boolean>> old=new ArrayList<>(s.web.gate().proofWaiting);s.audit.cancel();s.audit.start(false,()->second[0]++);for(Consumer<Boolean> callback:old)callback.accept(true);check("A stale request ID cannot adopt the next audit",s.audit.pendingPageAudit!=null&&s.audit.captures==0&&first[0]==1&&second[0]==0);s.web.prove(true);s.web.answer();check("New audit still completes its own result",second[0]==1&&s.audit.captures==1);s=fresh();int[] done=done();s.audit.start(true,true,()->done[0]++);s.busy=true;s.web.prove(true);check("Work that begins while waiting prevents late diagnostic dispatch",done[0]==1&&!s.audit.running&&s.audit.captures==0&&s.audit.worker.tasks.isEmpty()&&s.web.auditMessages()==0);}
 static void foreignProof(){for(String cause:new String[]{"foreign-native-session","old-open-epoch","configuration-boundary"}){ChatSession s=fresh();int[] done=done();s.audit.start(false,()->done[0]++);Object nativeSession=cause.equals("foreign-native-session")?new GeckoSession():cause.equals("configuration-boundary")?null:s.web.current;String epoch=cause.equals("old-open-epoch")?"retired-open":s.web.gate().epoch;s.timeZone.foreignBoundary(nativeSession,epoch);check("Only the exact pending native session and epoch may finish without retirement: "+cause,!s.audit.running&&done[0]==1&&s.audit.captures==0);s.web.prove(true);check("Foreign operation cannot release an ordinary audit: "+cause,s.web.auditMessages()==0&&done[0]==1);}}
 static void busyWindows(){
  for(String cause:new String[]{"api-working","api-reply","api-uncertain","network-working","network-lost","guard-lost","protection-lost"}){ChatSession s=fresh();int[] done=done();boolean network=cause.startsWith("network")||cause.endsWith("lost");s.audit.start(network,!network,()->done[0]++);if(cause.endsWith("working"))s.busy=true;if(cause.equals("api-reply"))s.replyActive=true;if(cause.equals("api-uncertain"))s.resourceUncertain=true;if(cause.equals("network-lost"))s.networkReady=false;if(cause.equals("guard-lost"))s.guard.allowed=false;if(cause.equals("protection-lost"))s.web.protection=false;s.web.prove(true);check("Dispatch rechecks the independent original admission prerequisite: "+cause,done[0]==1&&!s.audit.running&&s.audit.captures==0&&s.audit.worker.tasks.isEmpty()&&s.web.auditMessages()==0);}
 }
 static void running(){ChatSession s=fresh();s.web.prove(true);int[] done=done();s.audit.start(false,()->done[0]++);String initial=s.audit.policy;s.timeZone.boundary();check("After sampling starts every native boundary still cancels",!s.audit.running&&done[0]==1&&s.audit.builds==0);s.web.answer();check("Late script cannot publish after running retirement",s.audit.builds==0&&s.audit.report.length()==0);s=fresh();s.web.prove(true);s.audit.start(false,()->{});check("Running ordinary observation keeps the full proof stamp",s.audit.fresh());s.timeZone.auditSerial++;check("Unretired proof change still fails original full-stamp freshness",!s.audit.fresh()&&!s.audit.policyStamp().equals(s.audit.policy));}
 static void deadlines(){ChatSession s=fresh();int[] done=done();s.audit.start(false,()->done[0]++);s.handler.advance(5000);s.web.prove(true);check("Delayed ACK cannot restart the fourteen second sample budget",s.web.lastBudget()==9000&&s.audit.deadline==14000);s.handler.advance(8999);check("Reduced request stays pending immediately before original deadline",s.audit.running&&done[0]==0);s.handler.advance(1);check("Real bridge timeout expires at original fourteen second boundary",!s.audit.running&&done[0]==1&&s.audit.builds==1);s.handler.advance(500);check("Original14.5s hard finish cannot run twice",done[0]==1);s=fresh();s.web.prove(true);s.audit.start(true,()->{});s.handler.advance(14500);check("Original hard finish also includes pending native worker",!s.audit.running&&s.audit.builds==1);s.audit.worker.runAll();check("Cancelled native work does not issue a late query",s.audit.nativeQueries==0);}
 static void budgets(){for(Object value:new Object[]{Boolean.TRUE,0,-1,14001,1.5,JSONObject.NULL,"100"}){ChatSession s=fresh();int[] calls=done();s.web.runEnvironmentAudit(J.obj("budgetMillis",value),raw->calls[0]++);check("Invalid internal budget cannot register a request: "+value,calls[0]==1&&s.web.callbacks.size()==0&&s.web.auditMessages()==0);}ChatSession s=fresh();s.web.runEnvironmentAudit(J.obj("id","legacy"),raw->{});check("Existing callers retain the original fourteen second timeout",s.web.callbacks.size()==1&&s.handler.lastDelay==14000);}
 public static void main(String[] args){ready();asynchronous();rejection();ownerChanges();staleAndBusy();foreignProof();busyWindows();running();deadlines();budgets();System.out.println(J.obj("status","passed","passed",checks.size(),"total",checks.size(),"checks",new JSONArray(checks)));}
}
class EnvironmentAudit {
 @@AUDIT@@
 PendingPageAudit pendingPageAudit;final ChatSession session;final QueueExecutor worker=new QueueExecutor(),closer=new QueueExecutor();final Dedicated serviceProbe=new Dedicated(),requestIdentity=new Dedicated();JSONObject report=new JSONObject(),observed=new JSONObject(),initial=new JSONObject(),sample=new JSONObject(),nativeResult=new JSONObject();String lastError="",auditUrl="",stamp="",policy="";boolean running,networkRun,webDone,nativeDone,geckoRun;long serial,deadline,auditNavigation,identityAppliedRevision,epoch;Object nativeRuntimeIdentity;Runnable completed;Future<?> nativeWork;HttpURLConnection connection;int captures,builds,nativeQueries;static final String OBSERVATION_EXECUTION_ID="explicit-host";
 EnvironmentAudit(ChatSession session){this.session=session;}
 static String hash(String value){return value;}
 JSONObject localExpected(){captures++;return J.obj("proofSerial",session.timeZone.auditSerial);}
 JSONObject queryNative(long id){nativeQueries++;return J.obj("ip","203.0.113.1");}
 void decorateObservation(JSONObject report,String url,long navigation){}void recordObservation(JSONObject report,String url){}void refresh(boolean force){}boolean save(){return true;}
}
class GeckoWebView {
 @@WEB@@
 static boolean active(GeckoWebView view){return view.enabled;}
 final ChatSession owner;boolean destroyed,addonDisabled,enabled=true,protection=true;String url="https://controlled.invalid/page";GeckoSession current=new GeckoSession();GeckoRuntime runtime=new GeckoRuntime();WebExtension.Port routePort=new WebExtension.Port();long identityPolicyRevision=7;final GeckoSettings metadata=new GeckoSettings();final Protection nativeProtection=new Protection();
 final Map<GeckoSession,TimeZoneGate> timeZoneGates=new IdentityHashMap<>();final Map<GeckoSession,WebExtension.Port> ports=new IdentityHashMap<>();final Set<WebExtension.Port> staleAppearanceConnections=new HashSet<>();final BrowserBridgeRequests callbacks;
 static final String VERSION="157-pinned-host";
 static class TimeZoneGate {String epoch="owned-open-epoch";long documentSerial=11;boolean preparing=true,revalidating=true;final List<Consumer<Boolean>> proofWaiting=new ArrayList<>();}
 GeckoWebView(ChatSession owner){this.owner=owner;timeZoneGates.put(current,new TimeZoneGate());ports.put(current,new WebExtension.Port());callbacks=new BrowserBridgeRequests(new BrowserBridgeRequests.Timer(){public void schedule(Runnable r,long d){owner.handler.postDelayed(r,d);}public void cancel(Runnable r){owner.handler.removeCallbacks(r);}},"null");}
 TimeZoneGate gate(){return timeZoneGates.get(current);}String getUrl(){return url;}Object nativeRuntimeIdentity(){return destroyed||owner.deleted?null:runtime;}GeckoSettings getSettings(){return metadata;}boolean hasVisibleDocument(){return true;}boolean protectionAllowsNetwork(){return protection&&!addonDisabled&&!destroyed;}
 boolean timeZoneSessionAlive(GeckoSession s){return !destroyed&&!owner.deleted&&s!=null&&s.open&&s==current;}
 boolean timeZoneAllows(GeckoSession s){return owner.timeZone.ready&&s==current;}
 void prove(boolean ready){owner.timeZone.ready=ready;owner.timeZone.boundary();TimeZoneGate gate=gate();if(gate!=null){gate.preparing=gate.revalidating=false;completeTimeZoneProofs(gate,ready);}}
 int auditMessages(){WebExtension.Port port=ports.get(current);if(port==null)return 0;int count=0;for(JSONObject m:port.messages)if(m.optString("kind").equals("audit"))count++;return count;}
 long lastBudget(){WebExtension.Port port=ports.get(current);return port.messages.get(port.messages.size()-1).optJSONObject("configuration").optLong("budgetMillis");}
 void answer(){WebExtension.Port port=ports.get(current);if(port==null||port.messages.isEmpty())return;for(JSONObject message:new ArrayList<>(port.messages))if(message.optString("kind").equals("audit"))callbacks.complete(port,message.optInt("id"),J.obj("id",message.optJSONObject("configuration").optString("id"),"parent",J.obj("ua","Firefox")).toString());}
 void cancelEnvironmentAudit(){callbacks.clear();}
}
class GeckoTimeZoneController {
 @@TIMEZONE@@
 final ChatSession session;long auditSerial,configuration,desired=1;boolean ready;
 GeckoTimeZoneController(ChatSession owner){session=owner;}
 String auditConfigurationStamp(){return "host-configuration:"+configuration+":"+desired;}JSONObject status(){return J.obj("desiredRevision",desired);}JSONObject status(Object session,String epoch){return J.obj("nativeSettingReadback",ready);}
 void boundary(){boundaryChanged(session.web.current,session.web.gate()==null?"missing":session.web.gate().epoch);}void foreignBoundary(Object nativeSession,String epoch){boundaryChanged(nativeSession,epoch);}
}
class ChatSession {final Handler handler=new Handler();final Privacy privacy=new Privacy();final Guard guard=new Guard();final Prefs prefs=new Prefs();final GeckoWebView web;final GeckoTimeZoneController timeZone;final EnvironmentAudit audit;Object context;String environmentId="environment-1";int environmentGeneration=1;long applied=9,navigationEpoch=3,connectionEpoch=4;boolean deleted,networkReady=true,busy,replyActive,resourceUncertain;ChatSession(){web=new GeckoWebView(this);timeZone=new GeckoTimeZoneController(this);audit=new EnvironmentAudit(this);AuditReport.CURRENT=audit;}long identityAuditAppliedRevision(){return applied;}boolean internalNetwork(){return false;}boolean currentReplyActive(){return replyActive;}boolean resourceFilesUncertain(){return resourceUncertain;}void updateBrowserActivity(){}void identityObserved(JSONObject report){} }
class Handler {static class Task{final Runnable action;final long at;Task(Runnable action,long at){this.action=action;this.at=at;}}final List<Task> tasks=new ArrayList<>();long lastDelay;void post(Runnable r){postDelayed(r,0);}void postDelayed(Runnable r,long delay){lastDelay=delay;tasks.add(new Task(r,SystemClock.now+delay));}void removeCallbacks(Runnable r){tasks.removeIf(t->t.action==r);}void advance(long delay){long end=SystemClock.now+delay;for(;;){Task first=null;for(Task t:tasks)if(t.at<=end&&(first==null||t.at<first.at))first=t;if(first==null)break;tasks.remove(first);SystemClock.now=first.at;first.action.run();}SystemClock.now=end;} }
class SystemClock {static long now;static long elapsedRealtime(){return now;}}
class QueueExecutor extends AbstractExecutorService {final List<Runnable> tasks=new ArrayList<>();public void execute(Runnable r){tasks.add(r);}void runAll(){for(Runnable r:new ArrayList<>(tasks)){tasks.remove(r);r.run();}}public void shutdown(){}public List<Runnable> shutdownNow(){tasks.clear();return Collections.emptyList();}public boolean isShutdown(){return false;}public boolean isTerminated(){return false;}public boolean awaitTermination(long n,TimeUnit u){return false;}}
class Dedicated {boolean active;void cancel(){active=false;}}
class ProfileUi {static boolean working(ChatSession s){return s.busy;}}
class GeckoSession {boolean open=true;}class GeckoRuntime {}class WebExtension {static class Port{final List<JSONObject> messages=new ArrayList<>();void postMessage(JSONObject value){messages.add(value);}}}
class Protection{long value=8;long token(){return value;}}class GeckoSettings{boolean desktop,policyAcknowledged=true;String[] requestedLocales={"zh-CN"};String getUserAgentString(){return "Firefox/157 Android";}}
class Privacy {int level;int level(){return level;}}class Guard {boolean allowed=true;boolean allowed(){return allowed;}}class Prefs{String getString(String k,String v){return v;}boolean getBoolean(String k,boolean v){return v;}}class NativeNetwork{String token="route";static NativeNetwork get(Object c){return new NativeNetwork();}}
interface ValueCallback<T>{void onReceiveValue(T value);}
class AuditReport{static JSONObject build(JSONObject sample,JSONObject nativeResult,JSONObject initial,boolean network,boolean fresh){CURRENT.builds++;return J.obj("fresh",fresh,"signals",sample);}static EnvironmentAudit CURRENT;static boolean v4(String value){return false;}static String ip(JSONObject value){return "";}}

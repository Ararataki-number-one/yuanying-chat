package local.pocketchat;
import android.content.Context;import android.os.Bundle;import java.io.*;import java.nio.charset.StandardCharsets;import java.util.*;import java.util.concurrent.*;import org.json.*;

/** Explicit storage/IPC/process adapters. Marked methods and complete proof/coordinator are production. */
final class SecretStore {final Context context;int writes;SecretStore(Context c){context=c;}byte[] get(String key){byte[] value=context.records.get(key);return value==null?null:value.clone();}void put(String key,byte[] value)throws Exception{if("before".equals(context.storeFailure))throw new IOException("synthetic write rejected");writes++;context.records.put(key,value.clone());if("pending-network".equals(key))context.pending=new String(value,StandardCharsets.UTF_8);if("after".equals(context.storeFailure))throw new IOException("synthetic lost acknowledgment");if("replace".equals(context.storeFailure))context.pending=J.obj("environmentIntent",J.obj("id","candidate-b")).toString();}void remove(String key){context.records.remove(key);}}
final class Profiles {static int slot(Context c){return ((EnvironmentSpec.Identity)c.identity).slot;}static Context context(Object object,int slot){return object instanceof GuardedService?((GuardedService)object).context:(Context)object;}}
final class ProfileCatalog {final Context context;ProfileCatalog(Context c){context=c;}static ProfileCatalog get(Context c){return new ProfileCatalog(c);}EnvironmentSpec.Identity identity(int slot)throws Exception{EnvironmentSpec.Identity value=(EnvironmentSpec.Identity)context.identity;if(value.slot!=slot)throw new IOException("owner");return value;}interface Action<T>{T run()throws Exception;}<T>T withIdentity(EnvironmentSpec.Identity expected,Action<T> action)throws Exception{synchronized(context.monitor){if(!expected.equals(context.identity))throw new IOException("owner changed");return action.run();}}}
final class EnvironmentSpecRepository {final Context context;EnvironmentSpecRepository(Context c){context=c;}EnvironmentSpec load(){return (EnvironmentSpec)context.model;}static JSONObject strictObject(byte[] bytes)throws Exception{if(bytes==null)throw new IOException("absent");return new JSONObject(new String(bytes,StandardCharsets.UTF_8));}}
final class EnvironmentSpecRuntime {interface Action<T>{T run()throws Exception;}static <T>T withIntent(Context c,Action<T> action)throws Exception{synchronized(c.monitor){return action.run();}}static void requireIdentity(Context c,EnvironmentSpec.Identity identity)throws Exception{if(!identity.equals(c.identity))throw new IOException("owner changed");}static EnvironmentSpec.NetworkBinding binding(EnvironmentSpec.Identity id,String mode,JSONObject settings,String proxy){return new EnvironmentSpec.NetworkBinding(mode,"entry-source",settings.optString("entry"),"exit-source",settings.optString("exit"),"manual","fixed-exit",NativeNetwork.transportFingerprint(settings),"exit-revision");}
 @SELECT_POLICY@
}
final class NetworkChanges {static String hash(Context c){return c.hash;}static JSONObject pendingStrict(Context c)throws Exception{c.pendingReads++;return new JSONObject(c.pending);}static JSONObject intent(JSONObject p){return p.optJSONObject("environmentIntent");}static void validateSaved(Context c,JSONObject p)throws Exception{if(!c.cacheValid)throw new IOException("source cache changed");}}
final class NetworkSourceSelection {interface Action<T>{T run()throws Exception;}static <T>T withActiveSnapshot(Context c,Action<T> action)throws Exception{synchronized(c.monitor){return action.run();}}static String payloadHash(byte[] bytes){return Sha256.hash(bytes);}static String snapshotGeneration(String role,String id,long revision,byte[] bytes){return Sha256.hash(role+"|"+id+"|"+revision+"|"+payloadHash(bytes));}static void restore(SecretStore vault,String slot,byte[] bytes)throws Exception{if(bytes==null)vault.remove(slot);else vault.put(slot,bytes);}static final class ActiveSnapshot {@AUTHORITY_RECORDS@
 final SecretStore vault;final Map<String,byte[]> before=new LinkedHashMap<>(),after=new LinkedHashMap<>();boolean writing;ActiveSnapshot(SecretStore vault){this.vault=vault;}
 @ACTIVE_MATCHES@
 @ACTIVE_RESTORE@
 @ACTIVE_ROLLBACK@
}}
final class NetworkCatalog {static final String ENTRY="entry",EXIT="exit";static void put(JSONObject value,String key,Object item){try{value.put(key,item);}catch(Exception failure){throw new IllegalArgumentException(failure);}}}
final class NetworkShareSelection {static int published;static void runningApplied(Context c,NetworkCoreApplication proof){published++;}}
final class ChatSession {
 static ChatSession current;static ChatSession peek(){return current;}final Context context;boolean deleted,transferActive,submitting,operation,configurationCapture,upload,known;int resourceChoosers,resourceFilePreparations,requests;final int environmentGeneration;final String environmentId;long navigationEpoch=1,work=1,sequence=1;String binding="bound-resource",document="document-12345678";Object pendingCapture=new Object();java.util.function.Consumer<TaskGuardSnapshot> callback;
 ChatSession(Context c){context=c;EnvironmentSpec.Identity owner=(EnvironmentSpec.Identity)c.identity;environmentGeneration=owner.generation;environmentId=owner.environmentId;}boolean uploading(){return upload;}TaskGuardSnapshot taskGuardSnapshot(){return new TaskGuardSnapshot(known,false,false,submitting,operation,transferActive,0,environmentGeneration,environmentId,navigationEpoch,binding,document,sequence,work);}void requestTaskGuardStatus(String id,java.util.function.Consumer<TaskGuardSnapshot> callback){requests++;this.callback=callback;}void idleReply(){known=true;sequence++;java.util.function.Consumer<TaskGuardSnapshot> value=callback;callback=null;value.accept(taskGuardSnapshot());}
}
final class NetworkUiProvider {
 static int wakes;static NetworkUiProvider instance;static void sessionAvailable(){wakes++;}final Context profile;final NativeNetwork.Main main=new NativeNetwork.Main();final Executor io=Runnable::run;boolean maintenanceStopped;long nativeWorkEpoch,drainRevision;int drains;NetworkUiProvider(Context c){profile=c;}
 void observeSession(){}void drainPending(){if(ChatSession.peek()!=null&&taskIdle(ChatSession.peek(),ChatSession.peek().taskGuardSnapshot()))drains++;}
 @TASK_IDLE@
 @NATIVE_BUSY@
 @NATIVE_STATIC_EVENT@
 @NATIVE_REFRESH@
}
final class NetworkDiagnostics {enum Reason{REQUESTED,REPLACE,START_FAILED} }

final class GuardedService {
 static final class Node {final int slot=0;String generation="original",configuration="old";int starts,stops;boolean alive=true;}
 static final class StaleGeneration extends IOException{}
 final Context context;final Node node=new Node();GuardedService(Context c){context=c;}
 @SERVICE_GUARD@
 void launch(Node n,String configuration){n.stops++;n.starts++;n.generation="generation-"+n.starts;n.configuration=configuration;n.alive=true;}
 void stop(Node n,boolean announce,NetworkDiagnostics.Reason reason){n.stops++;n.generation="stopped-"+n.stops;n.alive=false;}
 static final class NetworkDiagnostics {enum Reason{REQUESTED}static Reason reason(String ignored){return Reason.REQUESTED;}}
}

final class NativeNetwork {
 interface Callback{void done(boolean ok,String message);}final Context context;final SecretStore secrets;final Transport transport;
 final ThreadLocal<ConfigurationSources> configurationSources=new ThreadLocal<>();volatile NetworkApplyCoordinator.RuntimeBinding activeConfiguration;
 final WorkQueue worker=new WorkQueue();static final class WorkQueue implements Executor{boolean paused;final List<Runnable> tasks=new ArrayList<>();public void execute(Runnable r){if(paused)tasks.add(r);else r.run();}void runAll(){paused=false;for(Runnable r:new ArrayList<>(tasks)){tasks.remove(r);r.run();}}}final Main main=new Main();static final class Main{void post(Runnable run){run.run();}}
 boolean starting,ready=true,recoveryBlocked,fresh=true,failAfterLaunch;int stops,freshCalls;String message="connected",fingerprint="fixed",token="token",currentEntry="Entry|chosen";long routeSerial=2,lastVerified=123;int controllerPort=7001,proxyPort=7002;Process process;JSONObject settings;List<String> names=Arrays.asList("Entry|chosen");ExitRouteReceipt verifiedRoute;Runnable beforeLaunch;
 NetworkHealthPolicy.Admission admission=NetworkHealthPolicy.Admission.VERIFIED;final File provider,root;ExitRouteReceipt queuedProof;boolean proofQueued;
 NativeNetwork(Context c,File provider)throws Exception{context=c;secrets=new SecretStore(c);this.provider=provider;root=new File(provider.getParentFile(),provider.getName()+".runtime");root.mkdirs();java.nio.file.Files.copy(provider.toPath(),new File(root,"subscription.yaml").toPath());settings=EnvironmentSpecRepository.strictObject(secrets.get("network"));transport=new Transport(c);transport.service.node.configuration=transportFingerprint(settings);transport.refresh();verifiedRoute=new ExitRouteReceipt(this,transport.state);}
 static String hash(String value){return Sha256.hash(value);}static String transportFingerprint(JSONObject value){return Sha256.hash(value.toString());}
 @RECEIPT@
 @SCHEDULE_PROOF@
 @SOURCE_CACHE_MATCHES@
 @SUBSCRIBED_EXIT@
 @SOURCE_META@
 @AUTHORITY_CURRENT@
 @CONFIGURATION_SOURCES@
 @CONFIGURATION_OPERATION@
 @RUN_CONFIGURATION@
 @PUBLISH_SOURCE@
 @ADMISSION@
 boolean verifiedRouteCurrent(){freshCalls++;transport.refresh();return fresh&&verifiedRoute!=null&&verifiedRoute.matches(this,transport.state);}
 void cancelMaintenance(){}JSONArray safeNodeDetails(JSONArray nodes){return nodes;}
 void startNow()throws Exception{ConfigurationSources frozen=configurationSources.get();settings=EnvironmentSpecRepository.strictObject(frozen.bytes("network"));publishStartupSource(provider,true,frozen.bytes("subscription"),EnvironmentSpecRepository.strictObject(frozen.bytes("subscription-meta")),123,new JSONArray());if(beforeLaunch!=null)beforeLaunch.run();transport.callBound("launch",transportFingerprint(settings),NetworkDiagnostics.Reason.REPLACE,frozen.previousGeneration,frozen.binding.identity);ready=true;verifiedRoute=new ExitRouteReceipt(this,transport.state);if(failAfterLaunch)throw new IOException("synthetic postlaunch failure");}
 void stopOwnedCore(ExitRouteReceipt owned,NetworkDiagnostics.Reason reason){if(owned!=null&&owned.sameCore(this,transport.state)){stops++;ready=false;transport.service.node.alive=false;}}
 static final class Transport {final GuardedService service;JSONObject state;Transport(Context c){service=new GuardedService(c);}void refresh(){state=J.obj("slot",0,"alive",service.node.alive,"generation",service.node.generation,"configuration",service.node.configuration,"pid",201,"servicePid",202,"controllerPort",7001,"proxyPort",7002);}JSONObject call(String action,String configuration){refresh();return state;}JSONObject callBound(String action,String configuration,NetworkDiagnostics.Reason reason,String generation,EnvironmentSpec.Identity identity)throws Exception{Bundle request=new Bundle();request.putString("expectedOwner",identity.json().toString());request.putString("expectedGeneration",generation);request.putString("configuration",configuration);service.guardedChange(service.node,request,action);refresh();return state;}}
}


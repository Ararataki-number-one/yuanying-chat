package local.pocketchat;
import org.json.*;
import java.lang.ref.WeakReference;
import java.util.*;

/** Explicit host-only page/looper adapters. Provider observer methods and
 * ChatSession add/remove are extracted unchanged from production. */
final class ChatSession {
  interface Observer {void changed();}
  static ChatSession current;static ChatSession peek(){return current;}
  final List<WeakReference<Observer>> observers=new ArrayList<>();
  final Web web=new Web();JSONObject state=J.obj("url",web.url,"documentId","doc-1","composer",true);
  Object pending;boolean configurationCapture,resourceKnown=true,resourceBusy;long resourceSequence=1,workGeneration=1;boolean deleted,submitting,transferActive,connecting,navigating,recoveryScheduled,files;
  String environmentId="environment-a",resourceObserverBinding="resource-1",lastDocumentId="doc-1";
  int environmentGeneration=1;long stateEpoch=1,navigationEpoch=1;
  boolean fileWorkActive(){return files;}
  TaskGuardSnapshot taskGuardSnapshot(){return new TaskGuardSnapshot(resourceKnown&&state.optBoolean("composer"),resourceBusy,files,submitting,false,transferActive,0,environmentGeneration,environmentId,navigationEpoch,resourceObserverBinding,lastDocumentId,resourceSequence,workGeneration);}
  @CHAT_OBSERVER_METHODS@
  static final class Web {String url="https://chatgpt.com/c/retry-test";String getUrl(){return url;}}
}
final class WebReplyObserver {static boolean same(String left,String right){return left.equals(right);}}
final class PendingHandler {
  final List<Runnable> queued=new ArrayList<>();
  void removeCallbacks(Runnable action){queued.removeIf(item->item==action);}
  void post(Runnable action){queued.add(action);}
}

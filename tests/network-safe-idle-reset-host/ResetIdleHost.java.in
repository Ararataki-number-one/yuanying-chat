package local.pocketchat;

import java.io.*;
import java.util.*;
import java.util.concurrent.*;

/** Declared host boundaries: main queue, clock, guard transport and diagnostic JSON.
 * The Activity wait/predicate and production TaskGuardSnapshot/taskIdle are verbatim.
 * No Android, Gecko, native input or website execution is claimed. */
final class ResetIdleHost {
  static final String DOCUMENT="11111111-1111-4111-8111-111111111111",BINDING="22222222-2222-4222-8222-222222222222";
  final ChatSession session=new ChatSession();final Handler handler=new Handler();String caseName="prepare-send";
  volatile JSONObject lastResetPage=J.obj("documentId",DOCUMENT,"lastGestureAt",1000,"observedAt",2000),lastResetObservation=new JSONObject();
  final List<JSONObject> events=new ArrayList<>();
  void event(String kind,JSONObject value){events.add(J.obj("kind",kind,"value",value));}

@RESET_CURRENT@
@RESET_JSON@
@RESET_WAIT@

  static void require(boolean value,String message){if(!value)throw new AssertionError(message);}
  public static void main(String[] args)throws Exception{
    String mode=args[0];ResetIdleHost host=new ResetIdleHost();host.session.mode=mode;
    TaskGuardSnapshot owner=host.session.current;
    if(mode.equals("delayed-ui"))Clock.uiDelay=5000;
    boolean positive=Set.of("idle","cooldown","unknown-then-idle").contains(mode);
    try{
      TaskGuardSnapshot result=host.awaitResetIdle(owner,DOCUMENT);
      require(positive,"Invalid observation accepted: "+mode);
      require(NetworkUiProvider.taskIdle(host.session,result),"Original idle predicate must still pass");
      require(result.sameWork(host.session.current),"Accepted observation no longer current");
      require(Clock.now<5000,"Accepted after original budget");
      if(mode.equals("cooldown"))require(Clock.now>=1500&&host.session.requests>1,"Interaction protection was not actually waited out");
      if(mode.equals("unknown-then-idle"))require(host.session.requests==2,"Unknown was accepted or fresh known state missed");
      require(Boolean.TRUE.equals(host.lastResetObservation.get("fresh"))&&Boolean.TRUE.equals(host.lastResetObservation.get("idle")),"Missing accepted-boundary diagnostic");
    }catch(IOException expected){
      require(!positive,"Valid fresh idle rejected: "+mode+" "+expected);
      require(Clock.now==5000,"Reset changed its one total 5,000ms deadline: "+Clock.now);
      require("deadline-expired".equals(host.lastResetObservation.get("state")),"Missing deadline diagnostic");
      require(expected.getMessage().startsWith("Controlled reset did not obtain a current idle task guard:"),"Original assertion lost");
      if(mode.equals("delayed-ui"))require(host.session.requests==0,"A request was dispatched after the deadline");
      else require(host.session.requests>0,"Guard transport was not exercised");
      if(mode.equals("late")||mode.equals("missing")){
        JSONObject terminal=host.lastResetObservation;int events=host.events.size();
        Clock.advanceTo(6000);
        require(host.lastResetObservation==terminal&&host.events.size()==events,"Late callback rewrote the failure evidence");
      }else if(!mode.equals("delayed-ui")){
        JSONObject last=(JSONObject)host.lastResetObservation.get("lastObservation");
        JSONObject guard=(JSONObject)last.get("guard");
        require(guard!=null&&guard.containsKey("known")&&guard.containsKey("replyBusy")&&guard.containsKey("fileBusy"),"Failure omitted actual guard fields");
        require(last.containsKey("requestedSequence")&&last.containsKey("current")&&last.containsKey("owner"),"Failure omitted observation ownership");
      }
    }
    require(!Clock.waitBudgets.isEmpty()||mode.equals("delayed-ui"),"No bounded wait occurred");
    require(Clock.waitBudgets.stream().allMatch(v->v>0&&v<=5000),"A wait exceeded the original total budget");
    require(host.events.size()<=5,"Repeated observations overflowed the bounded diagnostic event allowance");
    System.out.println("PASS "+mode+"; host boundaries only");
  }
}

final class ChatSession {
  String mode;int requests;long resourceObserverSequence=1;boolean configurationCapture;
  TaskGuardSnapshot current=snapshot(1,false,false,false,false,false,true,0,0,"environment",0,ResetIdleHost.BINDING,ResetIdleHost.DOCUMENT,0);
  static TaskGuardSnapshot snapshot(long sequence,boolean busy,boolean file,boolean submitting,boolean operation,boolean downloading,boolean known,int slot,int generation,String environment,long epoch,String binding,String document,long work){
    return new TaskGuardSnapshot(known,busy,file,submitting,operation,downloading,slot,generation,environment,epoch,binding,document,sequence,work);
  }
  TaskGuardSnapshot taskGuardSnapshot(){return current;}
  void requestTaskGuardStatus(String id,java.util.function.Consumer<TaskGuardSnapshot> callback){
    ResetIdleHost.require(id.equals("fixture-reset"),"Unexpected guard request");requests++;
    if(mode.equals("missing"))return;
    Clock.schedule(Clock.now+(mode.equals("late")?5100:20),()->{
      long sequence=resourceObserverSequence+(mode.equals("unchanged-sequence")?0:1);
      boolean busy=mode.equals("busy")||mode.equals("cooldown")&&Clock.now<1500;
      boolean known=!mode.equals("unknown")&&!(mode.equals("unknown-then-idle")&&requests==1);
      TaskGuardSnapshot observed=snapshot(sequence,busy,mode.equals("file"),mode.equals("submitting"),mode.equals("operation"),mode.equals("downloading"),known,
        mode.equals("foreign-slot")?1:0,mode.equals("foreign-generation")?1:0,mode.equals("foreign-environment")?"other":"environment",
        mode.equals("foreign-epoch")?1:0,mode.equals("foreign-binding")?"other-binding":ResetIdleHost.BINDING,
        mode.equals("foreign-document")?"33333333-3333-4333-8333-333333333333":ResetIdleHost.DOCUMENT,0);
      current=observed;resourceObserverSequence=sequence;
      if(mode.equals("current-changed"))current=snapshot(sequence,false,false,false,false,false,true,0,0,"environment",0,ResetIdleHost.BINDING,ResetIdleHost.DOCUMENT,1);
      ChromiumRouteLease.held=mode.equals("route-held");
      callback.accept(observed);
    });
  }
}
final class NetworkUiProvider {
@TASK_IDLE@
}
final class ChromiumRouteLease {static boolean held;static boolean held(){return held;}}

final class Clock {
  static long now,uiDelay,order;static final List<Long> waitBudgets=new ArrayList<>();
  static final PriorityQueue<Scheduled> queue=new PriorityQueue<>(Comparator.comparingLong((Scheduled v)->v.at).thenComparingLong(v->v.order));
  static final class Scheduled {final long at,order;final Runnable action;Scheduled(long at,Runnable action){this.at=at;this.action=action;order=Clock.order++;}}
  static void schedule(long at,Runnable action){queue.add(new Scheduled(at,action));}
  static boolean runNext(long end){if(queue.isEmpty()||queue.peek().at>end)return false;Scheduled next=queue.remove();now=next.at;next.action.run();return true;}
  static void advanceTo(long end){while(runNext(end)){}now=end;}
}
final class SystemClock {static long elapsedRealtime(){return Clock.now;}}
final class Thread {static void sleep(long millis){Clock.advanceTo(Clock.now+millis);}}
final class Handler {boolean post(Runnable action){Clock.schedule(Clock.now+Clock.uiDelay,action);return true;}}
final class CompletableFuture<T> extends java.util.concurrent.CompletableFuture<T> {
  @Override public T get(long timeout,TimeUnit unit)throws InterruptedException,ExecutionException,TimeoutException{
    long budget=unit.toMillis(timeout),end=Clock.now+budget;Clock.waitBudgets.add(budget);
    while(!isDone())if(!Clock.runNext(end)){Clock.now=end;throw new TimeoutException("Controlled transport has no current result before deadline");}
    return super.get(0,TimeUnit.MILLISECONDS);
  }
}
final class JSONObject extends LinkedHashMap<String,Object> {}
final class J {static JSONObject obj(Object... values){JSONObject result=new JSONObject();for(int i=0;i<values.length;i+=2)result.put((String)values[i],values[i+1]);return result;}}

package local.pocketchat;

import java.nio.charset.StandardCharsets;
import java.nio.file.*;
import java.util.*;
import org.json.*;

/** Extracted policy/ownership/parser methods. Provider, view and route are declared boundaries. */
public final class PolicyHost {
  __METHODS__
  final List<Tab> tabs=new ArrayList<>();
  final String fingerprintRuntimeEpoch="controlled-runtime-a";
  ChromiumFingerprintStore.State fingerprintState;
  boolean fingerprintStateReady=true,fingerprintLoading,fingerprintSaving,foreground=true,destroyed;
  RuntimeBoundary runtime=new RuntimeBoundary();Tab selected;
  static final String ID="00000000-0000-0000-0000-000000000002",OTHER_ID="00000000-0000-0000-0000-000000000003";
  static final JSONArray checks=new JSONArray();static Path root;static int serial;

  static final class PackageInfo {
    final String packageName,versionName;
    PackageInfo(String name,String version){packageName=name;versionName=version;}
  }
  static final class WebView {
    static PackageInfo provider=new PackageInfo("controlled.provider","1.0");static boolean providerThrows;
    static PackageInfo getCurrentWebViewPackage(){if(providerThrows)throw new IllegalStateException("Controlled provider read failure");return provider;}
  }
  static final class Tab {
    WebView web;ChromiumFingerprintStore.State fingerprintPolicy;
    ChromiumFingerprintStore.Binding fingerprintBinding;
    ChromiumFingerprintRuntime.Prepared fingerprint;
    boolean fingerprintReady=true,loading;long surfaceGeneration=11,generation=19;
    String fingerprintProviderPackage="controlled.provider",fingerprintProviderVersion="1.0";
  }
  static final class RuntimeBoundary {boolean allowed=true;boolean allowed(){return allowed;}}
  interface Checked {void run()throws Exception;}
  static void check(String name,boolean pass){checks.put(J.obj("name",name,"pass",pass));if(!pass)throw new AssertionError(name);}
  static void rejects(String name,Checked run)throws Exception{boolean rejected=false;try{run.run();}catch(JSONException expected){rejected=true;}check(name,rejected);}
  static TestContext context(String name,EnvironmentSpec.Identity identity)throws Exception{return new TestContext(root.resolve(name+"-"+(serial++)),identity);}
  static PolicyHost fresh()throws Exception{
    WebView.providerThrows=false;WebView.provider=new PackageInfo("controlled.provider","1.0");
    TestContext context=context("view",new EnvironmentSpec.Identity(2,4,ID));PolicyHost host=new PolicyHost();host.fingerprintState=ChromiumFingerprintStore.load(context);
    Tab tab=new Tab();tab.web=new WebView();tab.fingerprintPolicy=host.fingerprintState;tab.fingerprint=new ChromiumFingerprintRuntime.Prepared();
    tab.fingerprintBinding=new ChromiumFingerprintStore.Binding(tab.fingerprintProviderPackage,tab.fingerprintProviderVersion,host.fingerprintRuntimeEpoch,tab.surfaceGeneration,tab.generation);
    host.tabs.add(tab);host.selected=tab;return host;
  }
  boolean current(){return fingerprintCurrent(selected,selected.web,fingerprintState,selected.fingerprintBinding);}
  boolean traffic(){return fingerprintTraffic(selected,selected.web);}

  static ChromiumFingerprintStore.State variant(ChromiumFingerprintStore.State base,String field)throws Exception{
    EnvironmentSpec.Identity identity=field.equals("identity")?new EnvironmentSpec.Identity(2,4,OTHER_ID):base.identity;
    TestContext context=context("policy-"+field,identity);
    JSONObject value=J.obj("schema",1,"engine","chromium","identity",identity.json(),"revision",base.revision,
        "seed",base.seed,"spec",base.spec(),"receipt",new JSONObject());
    if(field.equals("revision"))value.put("revision",base.revision+1);
    if(field.equals("seed"))value.put("seed",base.seed.charAt(0)=='a'?"bbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbb":"aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa");
    if(field.equals("spec"))value.put("spec",ChromiumFingerprintSpec.defaults().json().put("display","desktop"));
    // Valid host vault DTOs exercise the actual store reader and catalog binding;
    // the fixture does not construct private State objects or publish seed bytes.
    new SecretStore(context).raw(value.toString().getBytes(StandardCharsets.UTF_8));return ChromiumFingerprintStore.load(context);
  }
  static void policies()throws Exception{
    PolicyHost host=fresh();ChromiumFingerprintStore.State state=host.fingerprintState,copy=variant(state,"same");
    check("Equivalent separately loaded desired policies compare equal",state!=copy&&sameFingerprintPolicy(state,copy)&&sameFingerprintPolicy(copy,state));
    check("Missing desired policy is never equivalent",!sameFingerprintPolicy(null,state)&&!sameFingerprintPolicy(state,null)&&!sameFingerprintPolicy(null,null));
    for(String field:new String[]{"identity","revision","seed","spec"})check("Policy comparison binds actual "+field,!sameFingerprintPolicy(state,variant(state,field)));
    check("Self policy equivalence remains available",sameFingerprintPolicy(state,state));
  }
  static void providers()throws Exception{
    PolicyHost host=fresh();Tab tab=host.selected;check("Current provider package and version match",host.fingerprintProviderMatches(tab));
    WebView.provider=new PackageInfo("changed.provider","1.0");check("Provider package change invalidates ownership",!host.fingerprintProviderMatches(tab)&&!host.current());
    WebView.provider=new PackageInfo("controlled.provider","2.0");check("Provider version change invalidates ownership",!host.fingerprintProviderMatches(tab)&&!host.current());
    WebView.provider=null;check("Missing actual provider rejects acknowledgement",!host.fingerprintProviderMatches(tab)&&!host.current());
    WebView.provider=new PackageInfo("controlled.provider",null);check("Missing actual provider version cannot inherit old version",!host.fingerprintProviderMatches(tab));
    WebView.providerThrows=true;check("Provider inspection failure rejects acknowledgement",!host.fingerprintProviderMatches(tab)&&!host.current());
    WebView.providerThrows=false;WebView.provider=new PackageInfo("controlled.provider","1.0");check("Same provider can still acknowledge the unchanged surface",host.current());
  }
  static void trafficGates()throws Exception{
    PolicyHost host=fresh();check("Ready native policy and current route allow traffic",host.traffic());
    for(String reason:new String[]{"destroyed","loading","saving","unready","tab-ready","prepared","state","policy-object","runtime","route","view"}){
      host=fresh();Tab tab=host.selected;WebView view=tab.web;
      if(reason.equals("destroyed"))host.destroyed=true;
      if(reason.equals("loading"))host.fingerprintLoading=true;
      if(reason.equals("saving"))host.fingerprintSaving=true;
      if(reason.equals("unready"))host.fingerprintStateReady=false;
      if(reason.equals("tab-ready"))tab.fingerprintReady=false;
      if(reason.equals("prepared"))tab.fingerprint=null;
      if(reason.equals("state"))host.fingerprintState=null;
      if(reason.equals("policy-object"))tab.fingerprintPolicy=variant(host.fingerprintState,"same");
      if(reason.equals("runtime"))host.runtime=null;
      if(reason.equals("route"))host.runtime.allowed=false;
      if(reason.equals("view"))view=new WebView();
      check("Traffic rejects invalid "+reason,!host.fingerprintTraffic(tab,view));
    }
    host=fresh();check("Missing tab or WebView cannot pass traffic",!host.fingerprintTraffic(null,host.selected.web)&&!host.fingerprintTraffic(host.selected,null));
    host.foreground=false;check("Protected background tabs retain network traffic",host.traffic());
  }
  static void ownership()throws Exception{
    PolicyHost host=fresh();check("Current foreground surface can accept its own receipt",host.current());
    for(String reason:new String[]{"destroyed","background","selected","membership","view","loading","saving","unready","state-object","tab-policy-object","prepared","tab-ready","binding-missing","binding-object","provider-package","provider-version","runtime-epoch","surface","navigation"}){
      host=fresh();Tab tab=host.selected;WebView view=tab.web;ChromiumFingerprintStore.State state=host.fingerprintState;ChromiumFingerprintStore.Binding binding=tab.fingerprintBinding;
      if(reason.equals("destroyed"))host.destroyed=true;
      if(reason.equals("background"))host.foreground=false;
      if(reason.equals("selected"))host.selected=new Tab();
      if(reason.equals("membership"))host.tabs.clear();
      if(reason.equals("view"))view=new WebView();
      if(reason.equals("loading"))host.fingerprintLoading=true;
      if(reason.equals("saving"))host.fingerprintSaving=true;
      if(reason.equals("unready"))host.fingerprintStateReady=false;
      if(reason.equals("state-object"))host.fingerprintState=variant(state,"same");
      if(reason.equals("tab-policy-object"))tab.fingerprintPolicy=variant(state,"same");
      if(reason.equals("prepared"))tab.fingerprint=null;
      if(reason.equals("tab-ready"))tab.fingerprintReady=false;
      if(reason.equals("binding-missing"))binding=null;
      if(reason.equals("binding-object"))binding=new ChromiumFingerprintStore.Binding("controlled.provider","1.0",host.fingerprintRuntimeEpoch,tab.surfaceGeneration,tab.generation);
      if(reason.equals("provider-package")){binding=new ChromiumFingerprintStore.Binding("changed.provider","1.0",host.fingerprintRuntimeEpoch,tab.surfaceGeneration,tab.generation);tab.fingerprintBinding=binding;}
      if(reason.equals("provider-version")){binding=new ChromiumFingerprintStore.Binding("controlled.provider","2.0",host.fingerprintRuntimeEpoch,tab.surfaceGeneration,tab.generation);tab.fingerprintBinding=binding;}
      if(reason.equals("runtime-epoch")){binding=new ChromiumFingerprintStore.Binding("controlled.provider","1.0","old-runtime",tab.surfaceGeneration,tab.generation);tab.fingerprintBinding=binding;}
      if(reason.equals("surface"))tab.surfaceGeneration++;
      if(reason.equals("navigation"))tab.generation++;
      check("Acknowledgement rejects changed "+reason,!host.fingerprintCurrent(tab,view,state,binding));
    }
    host=fresh();check("Null tab cannot accept a page acknowledgement",!host.fingerprintCurrent(null,host.selected.web,host.fingerprintState,host.selected.fingerprintBinding));
    check("Null captured desired state cannot replace current state",!host.fingerprintCurrent(host.selected,host.selected.web,null,host.selected.fingerprintBinding));
  }
  static JSONObject observation(){
    return J.obj("schema",1,"scope","document-start-frames","fingerprintProtectionVerified",false,"fields",J.obj(
        "canvas",J.obj("state","page-observed"),"webgl",J.obj("state","unsupported"),"audio",J.obj("state","failed"),"webrtc",J.obj("state","not-requested")));
  }
  static String encoded(JSONObject value){return JSONObject.quote(value.toString());}
  static Set<String> keys(JSONObject value){Set<String> result=new HashSet<>();for(Iterator<String> iterator=value.keys();iterator.hasNext();)result.add(iterator.next());return result;}
  static void parsing()throws Exception{
    JSONObject original=observation(),value=fingerprintObservation(encoded(original));
    check("Current-page self-test preserves only the four named states",keys(value.getJSONObject("fields")).equals(new HashSet<>(Arrays.asList("canvas","webgl","audio","webrtc")))&&value.getJSONObject("fields").getJSONObject("canvas").getString("state").equals("page-observed"));
    check("Page self-test never claims full fingerprint verification",Boolean.FALSE.equals(value.opt("fingerprintProtectionVerified"))&&value.getString("scope").equals("document-start-frames"));
    for(String state:new String[]{"page-observed","unsupported","failed","not-requested"}){JSONObject input=observation();input.getJSONObject("fields").getJSONObject("canvas").put("state",state);check("Allowed page state remains explicit: "+state,fingerprintObservation(encoded(input)).getJSONObject("fields").getJSONObject("canvas").getString("state").equals(state));}
    JSONObject sensitive=observation().put("cookie","DO_NOT_EXPORT").put("url","DO_NOT_EXPORT").put("seed","DO_NOT_EXPORT").put("nativeSetup",J.obj("state","native-readback","value","DO_NOT_EXPORT"));
    sensitive.getJSONObject("fields").put("nativeSetup",J.obj("state","native-readback","value","DO_NOT_EXPORT"));
    for(String field:new String[]{"canvas","webgl","audio","webrtc"})sensitive.getJSONObject("fields").getJSONObject(field).put("value","DO_NOT_EXPORT").put("seed","DO_NOT_EXPORT").put("engineNative",true);
    JSONObject safe=fingerprintObservation(encoded(sensitive));
    check("Untrusted page content cannot add native, seed, URL or cookie fields",!safe.toString().contains("DO_NOT_EXPORT")&&keys(safe).equals(new HashSet<>(Arrays.asList("schema","scope","fingerprintProtectionVerified","fields"))));
    for(String field:new String[]{"canvas","webgl","audio","webrtc"})check("Page field strips all values and unsupported claims: "+field,keys(safe.getJSONObject("fields").getJSONObject(field)).equals(Collections.singleton("state")));
    rejects("Null self-test response is rejected",()->fingerprintObservation(null));
    rejects("Empty self-test response is rejected",()->fingerprintObservation(""));
    rejects("Raw JSON object is not a WebView string acknowledgement",()->fingerprintObservation(observation().toString()));
    rejects("Missing outer string is rejected",()->fingerprintObservation("null"));
    rejects("Non-string outer value is rejected",()->fingerprintObservation("1"));
    rejects("Oversized self-test response is rejected",()->fingerprintObservation(new String(new char[32769]).replace('\0',' ')));
    rejects("Outer trailing data is rejected",()->fingerprintObservation(encoded(observation())+" true"));
    rejects("Inner trailing data is rejected",()->fingerprintObservation(JSONObject.quote(observation().toString()+" true")));
    rejects("Inner array is rejected",()->fingerprintObservation(JSONObject.quote("[]")));
    rejects("Unexpected extra string encoding is rejected",()->fingerprintObservation(JSONObject.quote(encoded(observation()))));
    for(Object schema:new Object[]{2,"1",true,JSONObject.NULL,1.5}){JSONObject invalid=observation().put("schema",schema);rejects("Invalid self-test schema type/value: "+schema,()->fingerprintObservation(encoded(invalid)));}
    for(String scope:new String[]{"all-sites","workers","engine-native",""}){JSONObject invalid=observation().put("scope",scope);rejects("Unsupported page coverage is rejected: "+scope,()->fingerprintObservation(encoded(invalid)));}
    for(Object verified:new Object[]{true,"false",0,JSONObject.NULL}){JSONObject invalid=observation().put("fingerprintProtectionVerified",verified);rejects("Page cannot claim native verification: "+verified,()->fingerprintObservation(encoded(invalid)));}
    for(String field:new String[]{"canvas","webgl","audio","webrtc"}){
      JSONObject missing=observation();missing.getJSONObject("fields").remove(field);rejects("Missing page field is rejected: "+field,()->fingerprintObservation(encoded(missing)));
      for(Object state:new Object[]{"native-readback","requested","saved","protected",true,JSONObject.NULL}){JSONObject invalid=observation();invalid.getJSONObject("fields").getJSONObject(field).put("state",state);rejects("Unaccepted page state is rejected: "+field+"/"+state,()->fingerprintObservation(encoded(invalid)));}
    }
  }
  static void acknowledgementLevels()throws Exception{
    PolicyHost host=fresh();JSONObject receipt=J.obj("documentStartRegistered",true,"javascriptEnabled",true,"scope","document-start-frames");JSONObject nativeFields=host.fingerprintNativeFields(receipt);
    check("Native setup acknowledgement remains engine readback",nativeFields.getJSONObject("nativeSetup").getString("state").equals("native-readback")&&nativeFields.getJSONObject("nativeSetup").getJSONObject("value").getBoolean("javascriptEnabled"));
    check("Document-start registration remains requested rather than page-observed",nativeFields.getJSONObject("documentStart").getString("state").equals("requested")&&nativeFields.getJSONObject("documentStart").getBoolean("registered"));
    check("Native acknowledgement never invents Worker coverage",nativeFields.getJSONObject("workers").getString("state").equals("unsupported")&&nativeFields.getJSONObject("workers").getString("detail").contains("Worker"));
    check("Native readback has no automatic page self-test",!nativeFields.has("pageSelfTest")&&!nativeFields.has("canvas")&&!nativeFields.has("audio"));
    JSONObject unregistered=host.fingerprintNativeFields(J.obj("documentStartRegistered",false));check("Absent document-start registration remains saved-only",unregistered.getJSONObject("documentStart").getString("state").equals("saved")&&!unregistered.getJSONObject("documentStart").getBoolean("registered"));
    JSONObject observed=fingerprintObservation(encoded(observation()));check("Page-level result cannot upgrade native or Worker acknowledgements",!observed.has("nativeSetup")&&!observed.has("workers")&&Boolean.FALSE.equals(observed.get("fingerprintProtectionVerified")));
  }
  public static void main(String[] args)throws Exception{
    root=Paths.get(args[0]);Files.createDirectories(root);policies();providers();trafficGates();ownership();parsing();acknowledgementLevels();
    System.out.println(J.obj("status","passed","passed",checks.length(),"total",checks.length(),"checks",checks,"actualAndroidExecution",false,"actualChromiumExecution",false,"scope","Actual BrowserActivity policy/traffic/current-provider/parser/native-field methods with real Store/Spec/EnvironmentSpec/J and declared Context/vault/catalog, provider, view, route and Prepared boundaries. No WebView setting, JavaScript page, fingerprint API, Android or route execution."));
  }
}
/** Prepared presence is the Activity ownership boundary; native setup is tested separately. */
final class ChromiumFingerprintRuntime {static final class Prepared {}}

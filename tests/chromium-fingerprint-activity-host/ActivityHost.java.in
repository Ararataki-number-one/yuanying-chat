package local.pocketchat;

import android.content.Context;
import java.nio.file.*;
import java.util.*;
import java.util.concurrent.*;
import org.json.*;

/** Actual Activity method bodies; manual UI/worker queues and explicit WebView/chooser boundaries. */
public final class ActivityHost {
  static final int RESULT_OK=-1,RESULT_CANCELED=0;
  final ArrayList<Tab> tabs=new ArrayList<>();final ManualExecutor fingerprintWorker=new ManualExecutor();final ManualHandler fingerprintMain=new ManualHandler();
  final String fingerprintRuntimeEpoch="host-runtime";final TestContext context;final ChromiumFingerprintJobs fingerprintJobs;
  ChromiumFingerprintStore.State fingerprintState;ChromiumFingerprintSpec fingerprintSpec;
  boolean destroyed,foreground=true,fingerprintStateReady=true,fingerprintLoading,fingerprintSaving,fingerprintObserving;
  long fingerprintObservationGeneration;Runnable fingerprintObservationTimeout;JSONObject fingerprintReceipt=new JSONObject();
  Tab selected;ChromiumRuntime runtime=new ChromiumRuntime();BrowserFiles files=new BrowserFiles();Permissions permissions=new Permissions();BrowserLibrary library;int bindingRequests;
  FingerprintFileChoice fingerprintFileChoice;Intent fingerprintFileResult;int fingerprintFileRequest;String lastMessage="";
  ActivityHost(Path path)throws Exception{context=new TestContext(path,new EnvironmentSpec.Identity(2,4,"00000000-0000-0000-0000-000000000002"));fingerprintJobs=new ChromiumFingerprintJobs(context,fingerprintWorker,fingerprintMain::post);library=new BrowserLibrary(context);fingerprintState=ChromiumFingerprintStore.load(context);fingerprintSpec=ChromiumFingerprintSpec.from(fingerprintState.spec());
    Tab tab=new Tab("https://example.com/one");tab.web=new WebView(tab.url);tab.fingerprintPolicy=fingerprintState;tab.fingerprint=new ChromiumFingerprintRuntime.Prepared();tab.fingerprintReady=true;tab.fingerprintStarted=true;tab.surfaceGeneration=1;tab.generation=2;tab.fingerprintProviderPackage="host.webview";tab.fingerprintProviderVersion="157.0";tab.fingerprintBinding=fingerprintBinding(tab);tab.fingerprintBindingReady=true;tabs.add(tab);selected=tab;ChromiumFingerprintStore.activate(context,fingerprintState.identity,fingerprintState.revision,tab.fingerprintBinding);}
  Context getApplicationContext(){return context;}WebView web(){return selected==null?null:selected.web;}
  void message(String value){lastMessage=value;}void failFingerprintSurface(Tab tab,WebView view,Exception error){tab.fingerprintReady=false;lastMessage="failed";}
  void retire(Tab tab){throw new AssertionError("Unexpected WebView settings failure");}
  void ensureFingerprintBinding(Tab tab){bindingRequests++;}void loadFingerprintState(){throw new AssertionError("Unexpected policy reload boundary");}
  void hideKeyboard(){}void closeFind(){}void updateChrome(){}void showSelected(){if(selected!=null&&selected.web!=null)startFingerprintSurface(selected,selected.web);}void newTab(String url){throw new AssertionError("Unexpected new tab");}
  __TAB__
  __CHOICE__
  __METHODS__
  final class ClientBoundary {final Tab tab;ClientBoundary(Tab tab){this.tab=tab;}__NATIVE_CALLBACKS__}

  static final ArrayList<String> checks=new ArrayList<>();static Path base;static int sequence;
  interface Checked{void run()throws Exception;}
  static void check(String id,boolean pass){if(!pass)throw new AssertionError(id);checks.add(id);}
  static ActivityHost fresh()throws Exception{return new ActivityHost(base.resolve("case-"+(sequence++)));}
  static void queues(ActivityHost h)throws Exception{h.fingerprintWorker.drain();h.fingerprintMain.drain();}
  void choose(){BrowserFiles.Pending pending=new BrowserFiles.Pending(web(),0x5001);files.pending=pending;files.callback=()->{files.networkOpenAtDelivery=!web().getSettings().blocked;files.deliveredView=web();};fingerprintFileChoice=new FingerprintFileChoice(pending,selected);}
  static JSONObject observed(String state){JSONObject fields=new JSONObject();for(String name:new String[]{"canvas","webgl","audio","webrtc"})try{fields.put(name,J.obj("state",state));}catch(JSONException impossible){throw new AssertionError(impossible);}return J.obj("schema",1,"scope","document-start-frames","fingerprintProtectionVerified",false,"fields",fields);}
  static String raw(String state){return JSONObject.quote(observed(state).toString());}
  static void upload()throws Exception{
    ActivityHost h=fresh();h.choose();h.foreground=false;h.fingerprintStateReady=false;h.fingerprintLoading=true;h.syncFingerprintTraffic();
    check("Positive chooser result is accepted for deferred processing",h.fingerprintFileResult(0x5001,RESULT_OK,new Intent()));h.fingerprintMain.drain();check("Result before resume never reaches blocked renderer",h.files.deliveries==0&&h.fingerprintFileResult!=null&&h.web().settings.blocked);
    h.foreground=true;h.fingerprintLoading=false;h.fingerprintStateReady=true;h.selected.fingerprintBindingReady=false;h.syncFingerprintTraffic();h.drainFingerprintFileResult();check("Same-policy recheck still waits current native receipt",h.files.deliveries==0);
    h.selected.fingerprintBindingReady=true;h.drainFingerprintFileResult();check("Genuine result delivered once with change-fetch network open",h.files.deliveries==1&&h.files.networkOpenAtDelivery&&h.files.deliveredView==h.web()&&h.files.lastResult==RESULT_OK);h.drainFingerprintFileResult();check("Deferred result cannot replay",h.files.deliveries==1&&h.fingerprintFileResult==null);
    ActivityHost resumed=fresh();resumed.choose();resumed.fingerprintFileResult(0x5001,RESULT_OK,new Intent());check("Already resumed result still posts later UI task",resumed.files.deliveries==0);resumed.fingerprintMain.drain();check("Already ready foreground delivers without extra reload",resumed.files.deliveries==1&&resumed.files.networkOpenAtDelivery);
    ActivityHost cancel=fresh();cancel.choose();cancel.foreground=false;cancel.fingerprintLoading=true;cancel.fingerprintFileResult(0x5001,RESULT_CANCELED,null);check("Native cancellation remains immediate during resume recheck",cancel.files.deliveries==1&&cancel.files.lastResult==RESULT_CANCELED&&cancel.fingerprintFileResult==null);
    for(String mutation:new String[]{"navigation","surface","view","policy","provider","tab","url","destroyed"}){
      ActivityHost stale=fresh();stale.choose();stale.foreground=false;stale.fingerprintFileResult(0x5001,RESULT_OK,new Intent());
      if(mutation.equals("navigation"))stale.selected.generation++;if(mutation.equals("surface"))stale.selected.surfaceGeneration++;if(mutation.equals("view"))stale.selected.web=new WebView(stale.selected.url);if(mutation.equals("policy"))stale.fingerprintState=ChromiumFingerprintStore.load(stale.context);if(mutation.equals("provider"))WebView.provider.versionName="158.0";if(mutation.equals("tab"))stale.selected=new Tab("https://other.example/");if(mutation.equals("url"))stale.web().url="https://example.com/two";if(mutation.equals("destroyed"))stale.destroyed=true;
      stale.foreground=true;stale.drainFingerprintFileResult();check("Deferred selected files cancelled on changed "+mutation,stale.files.deliveries==1&&stale.files.lastResult==RESULT_CANCELED&&stale.fingerprintFileResult==null&&!stale.lastMessage.isEmpty());WebView.provider.versionName="157.0";
    }
    ActivityHost newer=fresh();newer.choose();newer.foreground=false;newer.fingerprintFileResult(0x5001,RESULT_OK,new Intent());BrowserFiles.Pending replacement=new BrowserFiles.Pending(newer.web(),0x5002);newer.files.pending=replacement;newer.drainFingerprintFileResult();check("Stale result cannot cancel newer chooser",newer.files.pending==replacement&&newer.files.deliveries==0);
    check("Unrelated activity result passes through",!newer.fingerprintFileResult(0x2800,RESULT_OK,new Intent()));
  }
  static void navigation()throws Exception{
    ActivityHost h=fresh();WebView view=h.web();h.fingerprintLoading=true;h.fingerprintStateReady=false;h.syncFingerprintTraffic();h.go("https://example.com/new");check("Address entered during recheck remains queued and old DOM retained",view.loads.isEmpty()&&"https://example.com/new".equals(h.selected.fingerprintNavigation)&&h.web()==view);
    h.fingerprintLoading=false;h.fingerprintStateReady=true;h.syncFingerprintTraffic();h.startFingerprintSurface(h.selected,view);check("Queued address starts once after actual traffic gate",view.loads.equals(Arrays.asList("https://example.com/new"))&&h.selected.fingerprintNavigation==null&&!view.settings.blocked);h.startFingerprintSurface(h.selected,view);check("Queued address is not repeated",view.loads.size()==1);
    ActivityHost latest=fresh();latest.fingerprintSaving=true;latest.go("https://example.com/a");latest.go("https://example.com/b");latest.fingerprintSaving=false;latest.startFingerprintSurface(latest.selected,latest.web());check("Latest explicit address wins while profile save blocks loading",latest.web().loads.equals(Arrays.asList("https://example.com/b")));
    ActivityHost blank=fresh();blank.go("  ");check("Empty address uses configured shared home",blank.web().loads.equals(Arrays.asList(BrowserPreferences.HOME)));
    ActivityHost restore=fresh();restore.selected.fingerprintStarted=false;restore.selected.saved=new Bundle();restore.selected.fingerprintReady=false;restore.startFingerprintSurface(restore.selected,restore.web());check("Session restore blocked before native preparation confirmation",restore.web().restores==0);restore.selected.fingerprintReady=true;restore.startFingerprintSurface(restore.selected,restore.web());check("Session restored only after native confirmation",restore.web().restores==1&&restore.web().loads.isEmpty());
    ActivityHost popup=fresh();popup.selected.fingerprintStarted=false;Message message=new Message();message.obj=new WebView.WebViewTransport();popup.selected.fingerprintPopup=message;popup.runtime.ready=false;popup.startFingerprintSurface(popup.selected,popup.web());check("Popup transport remains withheld while route blocked",message.sent==0);popup.runtime.ready=true;popup.startFingerprintSurface(popup.selected,popup.web());check("Prepared popup transport sent once before any navigation",message.sent==1&&((WebView.WebViewTransport)message.obj).view==popup.web()&&popup.web().loads.isEmpty());
    ActivityHost popupAddress=fresh();Message abandoned=new Message();abandoned.obj=new WebView.WebViewTransport();popupAddress.selected.fingerprintPopup=abandoned;popupAddress.fingerprintLoading=true;popupAddress.go("https://example.com/explicit");check("Explicit address cancels pending popup transport without leaving opener waiting",abandoned.sent==1&&((WebView.WebViewTransport)abandoned.obj).view==null&&popupAddress.selected.fingerprintPopup==null&&"https://example.com/explicit".equals(popupAddress.selected.fingerprintNavigation));
  }
  static void navigationReentry()throws Exception{
    String older="https://example.com/older",newer="https://example.com/newer";
    ActivityHost picker=fresh();picker.choose();picker.files.onCancel=()->picker.go(newer);picker.go(older);
    check("Picker cancellation cannot overwrite a newer address",picker.web().loads.equals(Arrays.asList(newer))&&picker.selected.url.equals(newer));
    check("Superseded address does not invalidate newer permission requests",picker.permissions.navigations==1);

    ActivityHost permission=fresh();permission.web().backAvailable=true;permission.permissions.onCancel=()->permission.go(newer);permission.history(-1);
    check("Permission cancellation cannot dispatch stale history",permission.web().backCalls==0&&permission.web().loads.equals(Arrays.asList(newer)));

    ActivityHost refresh=fresh();refresh.permissions.onCancel=()->refresh.go(newer);refresh.reloadOrStop();
    check("Permission cancellation cannot reload the newer page",refresh.web().reloadCalls==0&&refresh.web().loads.equals(Arrays.asList(newer)));

    ActivityHost changedTab=fresh();Tab original=changedTab.selected;WebView originalView=changedTab.web();Tab other=new Tab("https://other.example/");other.web=new WebView(other.url);changedTab.tabs.add(other);changedTab.choose();changedTab.files.onCancel=()->changedTab.selected=other;changedTab.go(older);
    check("Picker cancellation cannot navigate a different selected tab",changedTab.selected==other&&originalView.loads.isEmpty()&&other.web.loads.isEmpty()&&original.url.equals("https://example.com/one"));

    ActivityHost closed=fresh();WebView closedView=closed.web();closed.choose();closed.files.onCancel=()->closed.destroyed=true;closed.go(older);
    check("Closed Activity cannot continue an outer navigation",closedView.loads.isEmpty());

    ActivityHost queue=fresh();queue.choose();queue.files.onCancel=()->{queue.fingerprintLoading=true;queue.go(newer);};queue.go(older);
    check("Nested queued address keeps newest intent and network gate",queue.web().loads.isEmpty()&&newer.equals(queue.selected.fingerprintNavigation)&&newer.equals(queue.selected.url));
    queue.fingerprintLoading=false;queue.startFingerprintSurface(queue.selected,queue.web());
    check("Nested queued address is the only later load",queue.web().loads.equals(Arrays.asList(newer)));

    ActivityHost nativeStart=fresh();nativeStart.choose();nativeStart.files.onCancel=()->nativeStart.go(newer);nativeStart.new ClientBoundary(nativeStart.selected).onPageStarted(nativeStart.web(),older,null);
    check("Reentered native start cannot replace current page state",newer.equals(nativeStart.selected.url)&&nativeStart.web().loads.equals(Arrays.asList(newer)));

    ActivityHost startup=fresh();startup.selected.fingerprintStarted=false;startup.choose();startup.files.onCancel=()->startup.go(newer);startup.startFingerprintSurface(startup.selected,startup.web());
    check("Initial surface cannot restore an obsolete page after reentry",startup.web().loads.equals(Arrays.asList(newer))&&startup.selected.fingerprintStarted);

    ActivityHost popup=fresh();Message abandoned=new Message();abandoned.obj=new WebView.WebViewTransport();abandoned.onSend=()->popup.go(newer);popup.selected.fingerprintPopup=abandoned;popup.go(older);
    check("Popup cancellation cannot replace a newer address",popup.web().loads.equals(Arrays.asList(newer))&&newer.equals(popup.selected.url));

    ActivityHost unavailable=fresh();unavailable.choose();BrowserFiles.Pending choice=unavailable.files.pending;unavailable.history(-1);
    check("Unavailable history leaves the current file choice intact",unavailable.files.pending==choice&&unavailable.files.deliveries==0&&unavailable.permissions.navigations==0);

    ActivityHost download=fresh();download.files.activeDownload=true;download.choose();download.go(newer);
    check("Navigation cancels page picker without cancelling independent transfer",download.files.pending==null&&download.files.deliveries==1&&download.files.activeDownload&&download.files.downloadCancellations==0&&download.web().loads.equals(Arrays.asList(newer)));

    ActivityHost stop=fresh();stop.selected.loading=true;stop.choose();stop.files.onCancel=stop::reloadOrStop;stop.go(older);
    check("Explicit stop during cancellation prevents outer load",stop.web().loads.isEmpty()&&stop.web().stops==1&&!stop.selected.loading);
    check("Stopped current document requests its new native binding",stop.bindingRequests==1);
  }
  static void observation()throws Exception{
    ActivityHost current=fresh();current.observeFingerprint();check("Observation uses explicit synthetic function and one active callback",current.fingerprintObserving&&current.web().evaluation.contains("__pocketchatChromiumFingerprintObserve"));current.web().answer(raw("page-observed"));check("Observation persistence stays off callback UI task",current.fingerprintReceipt.length()==0&&current.fingerprintWorker.tasks.size()==1);queues(current);JSONObject receipt=ChromiumFingerprintStore.lastReceipt(current.context,current.fingerprintState.identity,current.fingerprintState.revision,current.selected.fingerprintBinding);check("Current document observation recorded separately from native setup",receipt.getJSONObject("fields").has("nativeSetup")&&receipt.getJSONObject("fields").getJSONObject("pageSelfTest").getString("state").equals("page-observed")&&!receipt.getBoolean("fingerprintProtectionVerified"));
    for(String change:new String[]{"navigation","selected","provider","pause","state","new-operation","url"}){ActivityHost h=fresh();h.observeFingerprint();WebView original=h.web();if(change.equals("navigation"))h.beforeFingerprintNavigation(h.selected);if(change.equals("selected"))h.selected=new Tab("https://other.example/");if(change.equals("provider"))WebView.provider.versionName="158.0";if(change.equals("pause"))h.foreground=false;if(change.equals("state"))h.fingerprintState=ChromiumFingerprintStore.load(h.context);if(change.equals("new-operation"))h.invalidateFingerprintObservation();if(change.equals("url"))original.url="https://example.com/changed";int queued=h.fingerprintWorker.tasks.size();original.answer(raw("page-observed"));check("Late observation cannot enqueue receipt after "+change,h.fingerprintWorker.tasks.size()==queued&&h.fingerprintReceipt.length()==0);WebView.provider.versionName="157.0";}
    ActivityHost late=fresh();late.observeFingerprint();late.web().answer(raw("page-observed"));late.fingerprintWorker.drain();late.beforeFingerprintNavigation(late.selected);late.fingerprintMain.drain();check("Navigation between durable write and UI callback rejects old receipt",late.fingerprintReceipt.length()==0);
    ActivityHost protectedFailure=fresh();WebView dom=protectedFailure.web();protectedFailure.observeFingerprint();dom.answer(raw("failed"));queues(protectedFailure);check("Protected failed self-test blocks traffic and retains unsaved DOM",protectedFailure.web()==dom&&dom.settings.blocked&&!protectedFailure.selected.fingerprintReady&&dom.stops==1&&protectedFailure.fingerprintReceipt.getJSONObject("fields").getJSONObject("pageSelfTest").getString("state").equals("failed"));
    ActivityHost compatible=fresh();compatible.fingerprintSpec=ChromiumFingerprintSpec.from(J.obj("protection","compatibility"));compatible.observeFingerprint();compatible.web().answer(raw("failed"));queues(compatible);check("Compatibility failed self-test stays truthful without retiring DOM",compatible.selected.fingerprintReady&&compatible.web().stops==0&&compatible.fingerprintReceipt.getJSONObject("fields").getJSONObject("pageSelfTest").getString("state").equals("failed"));
    ActivityHost timeout=fresh();timeout.observeFingerprint();timeout.fingerprintMain.delayed.remove().run();queues(timeout);check("Missing observation explicitly fails closed for protected page",timeout.web().settings.blocked&&!timeout.fingerprintObserving);
  }
  static void observationFailureIsolation()throws Exception{
    ActivityHost failed=fresh();WebView paused=failed.web();failed.observeFingerprint();paused.answer(raw("failed"));
    check("Protected failure blocks traffic before the receipt worker runs",paused.settings.blocked&&!failed.selected.fingerprintReady&&paused.stops==1&&failed.fingerprintReceipt.length()==0);
    failed.context.vault.failPut=true;queues(failed);
    check("Protected failed self-test blocks traffic even if receipt write fails",paused.settings.blocked&&!failed.selected.fingerprintReady&&paused.stops==1&&failed.fingerprintReceipt.length()==0&&failed.lastMessage.contains("已暂停")&&failed.lastMessage.contains("未保存"));

    ActivityHost rejected=fresh();WebView rejectedPage=rejected.web();rejected.fingerprintWorker.reject=true;
    rejected.observeFingerprint();rejectedPage.answer(raw("failed"));
    check("Rejected receipt worker leaves protected page paused and reports failure",rejectedPage.settings.blocked&&!rejected.selected.fingerprintReady&&rejectedPage.stops==1&&rejected.lastMessage.contains("未保存")&&rejected.fingerprintWorker.tasks.isEmpty());

    ActivityHost compatible=fresh();compatible.fingerprintSpec=ChromiumFingerprintSpec.from(J.obj("protection","compatibility"));compatible.context.vault.failPut=true;
    compatible.observeFingerprint();compatible.web().answer(raw("failed"));queues(compatible);
    check("Compatibility receipt failure keeps the existing traffic policy",compatible.selected.fingerprintReady&&!compatible.web().settings.blocked&&compatible.web().stops==0&&compatible.lastMessage.contains("未保存"));

    ActivityHost workers=fresh();workers.fingerprintSpec=ChromiumFingerprintSpec.from(J.obj("protection","compatibility","workers","restrict"));workers.context.vault.failPut=true;
    workers.observeFingerprint();workers.web().answer(raw("page-observed"));queues(workers);
    check("Unconfirmed restricted Worker observation pauses despite receipt failure",!workers.selected.fingerprintReady&&workers.web().settings.blocked&&workers.lastMessage.contains("未保存"));

    ActivityHost stale=fresh();WebView current=stale.web();stale.observeFingerprint();stale.selected.generation++;
    current.answer(raw("failed"));
    check("Failed observation from an older binding cannot pause current page",stale.selected.fingerprintReady&&!current.settings.blocked&&current.stops==0&&stale.fingerprintWorker.tasks.isEmpty());

    ActivityHost deferred=fresh();deferred.observeFingerprint();deferred.web().answer(raw("failed"));deferred.fingerprintWorker.drain();
    deferred.beforeFingerprintNavigation(deferred.selected);deferred.fingerprintReceipt=J.obj("owner","newer-page");deferred.fingerprintMain.drain();
    check("Late failed receipt cannot replace a newer page receipt",deferred.fingerprintReceipt.optString("owner").equals("newer-page"));

    String newer="https://example.com/newer-after-failed-observation";
    ActivityHost picker=fresh();picker.choose();picker.files.activeDownload=true;picker.files.onCancel=()->picker.go(newer);
    picker.observeFingerprint();picker.web().answer(raw("failed"));
    check("Failed-observation picker callback preserves its newer address",newer.equals(picker.selected.fingerprintNavigation)&&newer.equals(picker.selected.url));
    check("Failed-observation cleanup stops after picker callback changes owner",picker.files.activeDownload&&picker.files.downloadCancellations==0&&picker.fingerprintReceipt.length()==0);

    ActivityHost stopped=fresh();stopped.choose();stopped.files.activeDownload=true;
    stopped.web().onStop=()->{stopped.beforeFingerprintNavigation(stopped.selected);stopped.selected.url=newer;stopped.web().url=newer;};
    stopped.observeFingerprint();stopped.web().answer(raw("failed"));
    check("Failed-observation stop callback prevents later stale cancellation",stopped.files.pending!=null&&stopped.files.activeDownload&&stopped.files.downloadCancellations==0&&newer.equals(stopped.selected.url));

    ActivityHost download=fresh();download.files.activeDownload=true;
    download.files.onDownloadCancel=()->{download.beforeFingerprintNavigation(download.selected);download.fingerprintReceipt=J.obj("owner","download-callback");};
    download.observeFingerprint();download.web().answer(raw("failed"));queues(download);
    check("Download cancellation reentry cannot publish a stale failed receipt",download.fingerprintReceipt.optString("owner").equals("download-callback")&&download.files.downloadCancellations==1);
  }
  static void completedHistory()throws Exception{
    ActivityHost h=fresh();WebView view=h.web();Tab tab=h.selected;ClientBoundary client=h.new ClientBoundary(tab);String first=view.getUrl(),next="https://example.com/two";h.finishedPage(tab,view,first);check("First native completion exposes original history synchronously",h.library.list("history").length()==1);
    h.go(next);view.title="Second page";view.progress=100;check("Explicit go marks loading before getter updates and native start callback",tab.loading&&view.getUrl().equals(next)&&h.library.list("history").length()==1);
    client.onPageStarted(view,next,null);check("Actual native start preserves pending loading and clears previous error",tab.loading&&!tab.failed);h.finishedPage(tab,view,next);check("Actual native completion clears loading after real history is in memory",!tab.loading&&h.library.list("history").length()==2);
    WebView stale=new WebView(next);tab.loading=true;h.finishedPage(tab,stale,next);check("Retired WebView completion cannot clear current loading",tab.loading&&h.library.list("history").length()==2);h.finishedPage(tab,view,first);check("Old URL completion cannot acknowledge newer native document",tab.loading&&h.library.list("history").length()==2);h.finishedPage(tab,view,next);
    h.library.clearHistory();tab.failed=true;h.finishedPage(tab,view,next);check("Failed native completion remains visible but cannot record history",!tab.loading&&tab.failed&&h.library.list("history").length()==0);h.go(first);check("Go does not silently clear the previous native failure",tab.loading&&tab.failed);client.onPageStarted(view,first,null);check("Only actual native start resets the prior failure",tab.loading&&!tab.failed);h.finishedPage(tab,view,first);
    view.backAvailable=true;h.history(-1);check("Back dispatch synchronously marks loading",tab.loading&&view.backCalls==1);h.finishedPage(tab,view,view.getUrl());view.forwardAvailable=true;h.history(1);check("Forward dispatch synchronously marks loading",tab.loading&&view.forwardCalls==1);h.finishedPage(tab,view,view.getUrl());view.backAvailable=false;view.forwardAvailable=false;h.history(-1);check("Unavailable history dispatch remains idle",!tab.loading);
    h.reloadOrStop();check("Reload dispatch synchronously marks loading",tab.loading&&view.reloadCalls==1);h.reloadOrStop();check("Stop during pending native navigation stops without redispatching",!tab.loading&&view.stops==1&&view.reloadCalls==1);h.finishedPage(tab,view,view.getUrl());
    long previous=tab.generation;String spa="https://example.com/spa";view.url=spa;client.doUpdateVisitedHistory(view,spa,false);check("SPA history callback remains idle without a native finish",!tab.loading&&tab.generation>previous&&tab.url.equals(spa));
    h.fingerprintLoading=true;h.go("https://example.com/queued");check("Undispatched queued address retains current idle DOM state",!tab.loading&&tab.fingerprintNavigation!=null);h.fingerprintLoading=false;
    ActivityHost rejected=fresh();rejected.fingerprintStateReady=false;rejected.new ClientBoundary(rejected.selected).onPageStarted(rejected.web(),rejected.selected.url,null);check("Unconfirmed native start preserves fail-closed error semantics",rejected.selected.failed&&!rejected.selected.loading&&rejected.web().stops==1);
  }
  public static void main(String[] args)throws Exception{base=Paths.get(args[0]);upload();navigation();navigationReentry();observation();observationFailureIsolation();completedHistory();System.out.println(J.obj("status","passed","passed",checks.size(),"total",checks.size(),"checks",new JSONArray(checks)));}
  static final class PackageInfo {String packageName="host.webview",versionName="157.0";}
  static final class WebView {Runnable onStop;
    static final PackageInfo provider=new PackageInfo();static PackageInfo getCurrentWebViewPackage(){return provider;}
    final Settings settings=new Settings();String url,evaluation,title="";java.util.function.Consumer<String> callback;boolean backAvailable,forwardAvailable;int restores,stops,backCalls,forwardCalls,reloadCalls,progress;final List<String> loads=new ArrayList<>();WebView(String url){this.url=url;}
    Settings getSettings(){return settings;}String getUrl(){return url;}String getTitle(){return title;}int getProgress(){return progress;}boolean canGoBack(){return backAvailable;}boolean canGoForward(){return forwardAvailable;}void goBack(){backCalls++;}void goForward(){forwardCalls++;}void reload(){reloadCalls++;}void loadUrl(String value){loads.add(value);url=value;}Object restoreState(Bundle value){restores++;return new Object();}void stopLoading(){stops++;Runnable action=onStop;onStop=null;if(action!=null)action.run();}void evaluateJavascript(String script,java.util.function.Consumer<String> answer){evaluation=script;callback=answer;}void answer(String value){java.util.function.Consumer<String> cb=callback;callback=null;cb.accept(value);}
    static final class WebViewTransport {WebView view;void setWebView(WebView value){view=value;}}
  }
  static final class Settings {boolean blocked;void setBlockNetworkLoads(boolean value){blocked=value;}}
  static final class Bitmap {}static final class Bundle {}static final class Message {Object obj;int sent;Runnable onSend;void sendToTarget(){sent++;Runnable callback=onSend;onSend=null;if(callback!=null)callback.run();}}
  static final class Intent {Intent(){}Intent(Intent source){}}
  static final class ManualHandler {final ArrayDeque<Runnable> tasks=new ArrayDeque<>(),delayed=new ArrayDeque<>();void post(Runnable task){tasks.add(task);}void postDelayed(Runnable task,long timeout){delayed.add(task);}void removeCallbacks(Runnable task){tasks.remove(task);delayed.remove(task);}void drain(){while(!tasks.isEmpty())tasks.remove().run();}}
  static final class ManualExecutor extends AbstractExecutorService {final ArrayDeque<Runnable> tasks=new ArrayDeque<>();boolean reject,closed;public void execute(Runnable task){if(reject||closed)throw new RejectedExecutionException("Injected worker rejection");tasks.add(task);}void drain()throws Exception{while(!tasks.isEmpty()){Runnable task=tasks.remove();Thread worker=new Thread(task,"actual-method-host-worker");worker.start();worker.join();}}public void shutdown(){closed=true;}public List<Runnable> shutdownNow(){return Collections.emptyList();}public boolean isShutdown(){return false;}public boolean isTerminated(){return false;}public boolean awaitTermination(long time,TimeUnit unit){return false;}}

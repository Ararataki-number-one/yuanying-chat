  static final class BrowserFiles {static final int FIRST_REQUEST=0x5000,LAST_REQUEST=0x7fff;Pending pending;int deliveries,lastResult,downloadCancellations;boolean networkOpenAtDelivery,activeDownload;WebView deliveredView;Runnable callback,onCancel,onDownloadCancel;static final class Pending {final WebView owner;final int request;final String url;Pending(WebView view,int request){owner=view;this.request=request;url=view.getUrl();}}boolean result(int request,int result,Intent data){if(request<FIRST_REQUEST||request>LAST_REQUEST)return false;if(pending!=null&&pending.request==request){pending=null;deliveries++;lastResult=result;if(result==RESULT_OK&&callback!=null)callback.run();}return true;}void cancelFor(WebView view){if(pending!=null&&pending.owner==view){result(pending.request,RESULT_CANCELED,null);Runnable callback=onCancel;onCancel=null;if(callback!=null)callback.run();}}void cancelActiveDownload(){activeDownload=false;downloadCancellations++;Runnable action=onDownloadCancel;onDownloadCancel=null;if(action!=null)action.run();}}

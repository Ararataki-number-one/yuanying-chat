package local.pocketchat;

import android.content.Context;
import java.nio.file.Path;
import java.nio.file.Paths;
import java.util.*;
import java.util.concurrent.*;
import org.json.*;

/** Actual Activity preparation/persistence methods; native surfaces and UI are boundaries. */
public final class PreparationHost {
  final ArrayList<Tab> tabs=new ArrayList<>();
  final Worker worker=new Worker();final Queue ui=new Queue();final TestContext context;
  final ChromiumFingerprintJobs fingerprintJobs;
  final String fingerprintRuntimeEpoch="preparation-host";
  ChromiumFingerprintStore.State fingerprintState;
  ChromiumFingerprintSpec fingerprintSpec;
  String fingerprintScript="cached-script",fingerprintError="",fingerprintProvider="host.webview/157.0";
  JSONObject fingerprintReceipt=new JSONObject();
  boolean destroyed,foreground=true,fingerprintStateReady=true,fingerprintLoading,fingerprintSaving,fingerprintOpenAfterLoad;
  long fingerprintLoadGeneration;
  Tab selected;ChromiumRuntime runtime=new ChromiumRuntime();BrowserFiles files=new BrowserFiles();
  int retired,created,started,shown,delivered,cancelled,settingsOpened,invalidated,dialogs;
  boolean restoredOldState;String lastMessage="";

  PreparationHost(Path path)throws Exception{
    context=new TestContext(path,new EnvironmentSpec.Identity(2,4,"00000000-0000-0000-0000-000000000002"));
    fingerprintJobs=new ChromiumFingerprintJobs(context,worker,ui::post);
    fingerprintState=ChromiumFingerprintStore.load(context);fingerprintSpec=ChromiumFingerprintSpec.from(fingerprintState.spec());
    selected=addTab("https://example.com/first");
  }
  Tab addTab(String url){
    Tab tab=new Tab(url);tabs.add(tab);tab.web=new WebView();tab.fingerprintPolicy=fingerprintState;
    tab.fingerprint=new ChromiumFingerprintRuntime.Prepared();tab.fingerprintReady=true;tab.surfaceGeneration=tabs.size();tab.generation=2;
    tab.fingerprintProviderPackage=WebView.provider.packageName;tab.fingerprintProviderVersion=WebView.provider.versionName;
    return tab;
  }
  Context getApplicationContext(){return context;}
  void message(String text){lastMessage=text;}
  void invalidateFingerprintObservation(){invalidated++;}
  void cancelFingerprintFileResult(String reason){cancelled++;}
  void drainFingerprintFileResult(){delivered++;}
  void showSelected(){shown++;}
  void showFingerprintSettings(){settingsOpened++;}
  void updateChrome(){}
  void retire(Tab tab){
    retired++;retireFingerprintBinding(tab);tab.web=null;tab.fingerprintPolicy=null;tab.fingerprint=null;
    tab.fingerprintReady=false;tab.fingerprintValidating=false;tab.fingerprintStarted=false;tab.saved=new Bundle();
  }
  void createSurface(Tab tab){
    if(!fingerprintStateReady||fingerprintLoading||fingerprintSaving)throw new AssertionError("Surface created before policy readiness");
    created++;restoredOldState|=tab.saved!=null;tab.web=new WebView();tab.web.settings.blocked=true;
    tab.fingerprintPolicy=fingerprintState;tab.fingerprint=new ChromiumFingerprintRuntime.Prepared();
    tab.fingerprintProviderPackage=WebView.provider.packageName;tab.fingerprintProviderVersion=WebView.provider.versionName;
  }
  void startFingerprintSurface(Tab tab,WebView view){
    if(!fingerprintTraffic(tab,view))throw new AssertionError("Surface started before policy readiness");
    started++;tab.fingerprintStarted=true;
  }
  void failFingerprintSurface(Tab tab,WebView view,Exception failure){
    if(tab.web!=view)throw new AssertionError("Failure applied to an obsolete native view");
    retire(tab);tab.fingerprintError="failed surface";lastMessage=tab.fingerprintError;
  }
  __TAB__
  __METHODS__

  static Path base;static int sequence;static final ArrayList<String> checks=new ArrayList<>();
  static void check(String label,boolean condition){if(!condition)throw new AssertionError(label);checks.add(label);}
  static PreparationHost fresh()throws Exception{return new PreparationHost(base.resolve("case-"+sequence++));}
  void drain()throws Exception{
    int steps=0;
    while(!worker.tasks.isEmpty()||!ui.tasks.isEmpty()){
      if(++steps>12)throw new AssertionError("Preparation did not settle");
      worker.drain();ui.drain();
    }
  }

  static void loading()throws Exception{
    PreparationHost h=fresh();Tab original=h.selected;WebView page=original.web;ChromiumFingerprintStore.State policy=h.fingerprintState;
    h.loadFingerprintState();
    check("Policy reload blocks traffic before dispatching storage work",h.fingerprintLoading&&!h.fingerprintStateReady&&page.settings.blocked&&h.runtime.beginCalls==1);
    h.drain();
    check("Same-policy reload preserves the page and policy owner",h.fingerprintState==policy&&original.web==page&&h.retired==0&&h.created==0);
    check("Reload reopens traffic only after Worker policy confirmation",h.fingerprintStateReady&&!h.fingerprintLoading&&!page.settings.blocked&&h.runtime.confirmCalls==1&&h.shown==1&&h.delivered==1);

    PreparationHost changed=fresh();changed.addTab("https://example.com/second");
    for(Tab tab:changed.tabs)tab.saved=new Bundle();
    ChromiumFingerprintStore.save(changed.context,changed.fingerprintState.identity,changed.fingerprintState.revision,ChromiumFingerprintSpec.from(J.obj("display","desktop")).json());
    changed.loadFingerprintState();changed.drain();
    check("Reloaded changed policy rebuilds every tab without old saved state",changed.retired==2&&changed.created==2&&!changed.restoredOldState&&changed.tabs.stream().allMatch(tab->tab.saved==null&&tab.desktop&&tab.fingerprintPolicy==changed.fingerprintState));

    PreparationHost denied=fresh();denied.runtime.confirm=false;denied.loadFingerprintState();denied.drain();
    check("Missing Worker confirmation keeps existing page network blocked",!denied.fingerprintStateReady&&denied.selected.web.settings.blocked&&denied.shown==0&&denied.lastMessage.contains("Worker"));

    PreparationHost provider=fresh();WebView old=provider.selected.web;WebView.provider.versionName="158.0";
    provider.loadFingerprintState();provider.drain();
    check("Provider change rebuilds surfaces even when desired policy is unchanged",provider.retired==1&&provider.created==1&&provider.selected.web!=old&&provider.fingerprintProvider.endsWith("158.0"));
    WebView.provider.versionName="157.0";

    PreparationHost failed=fresh();failed.context.vault.failRead=true;failed.loadFingerprintState();failed.drain();
    check("Policy read failure clears loading and keeps the page blocked",!failed.fingerprintLoading&&!failed.fingerprintStateReady&&failed.selected.web.settings.blocked&&failed.cancelled==1&&failed.lastMessage.contains("未确认"));

    PreparationHost rejected=fresh();rejected.worker.reject=true;rejected.loadFingerprintState();
    check("Rejected policy load cannot leave loading stuck",!rejected.fingerprintLoading&&!rejected.fingerprintStateReady&&rejected.selected.web.settings.blocked&&rejected.lastMessage.contains("未确认"));

    PreparationHost destroyed=fresh();destroyed.loadFingerprintState();destroyed.worker.drain();destroyed.destroyed=true;destroyed.ui.drain();
    check("Destroyed Activity cannot publish a loaded policy to its UI",destroyed.shown==0&&destroyed.runtime.confirmCalls==0&&!destroyed.fingerprintStateReady);
  }

  static void saving()throws Exception{
    PreparationHost h=fresh();h.addTab("https://example.com/second");for(Tab tab:h.tabs)tab.saved=new Bundle();
    ChromiumFingerprintStore.State old=h.fingerprintState;h.saveFingerprint(old,J.obj("display","desktop"),false);
    check("Policy save blocks all current pages before writing",h.fingerprintSaving&&h.tabs.stream().allMatch(tab->tab.web.settings.blocked)&&h.files.downloadCancellations==1);
    h.drain();
    check("Policy save rebuilds all tabs and discards old restore state",h.retired==2&&h.created==2&&!h.restoredOldState&&h.tabs.stream().allMatch(tab->tab.saved==null&&tab.desktop&&tab.fingerprintPolicy==h.fingerprintState));
    check("Saved policy becomes ready only after its exact Worker confirmation",h.fingerprintStateReady&&!h.fingerprintSaving&&h.runtime.confirmedRevision==h.fingerprintState.revision&&h.fingerprintState.revision==old.revision+1);

    PreparationHost blocked=fresh();blocked.runtime.confirm=false;blocked.saveFingerprint(blocked.fingerprintState,J.obj("display","desktop"),false);blocked.drain();
    check("Saved policy with denied Worker confirmation cannot create new surfaces",!blocked.fingerprintStateReady&&!blocked.fingerprintSaving&&blocked.retired==1&&blocked.created==0&&blocked.selected.web==null);

    PreparationHost failed=fresh();WebView retained=failed.selected.web;long revision=failed.fingerprintState.revision;failed.context.vault.failPut=true;
    failed.saveFingerprint(failed.fingerprintState,J.obj("display","desktop"),false);failed.worker.drain();failed.ui.drain();
    check("Policy publication failure remains blocked while rereading actual state",!failed.fingerprintStateReady&&!failed.fingerprintSaving&&failed.fingerprintLoading&&retained.settings.blocked&&failed.dialogs==1);
    failed.drain();
    check("Failed save rereads the actual retained revision",failed.fingerprintState.revision==revision&&failed.selected.web==retained&&failed.fingerprintStateReady&&!failed.fingerprintSpec.desktop());

    PreparationHost rotate=fresh();rotate.saveFingerprint(rotate.fingerprintState,J.obj("display","desktop"),true);
    check("Seed rotation cannot silently include unsaved policy edits",!rotate.fingerprintSaving&&rotate.worker.tasks.isEmpty()&&rotate.lastMessage.contains("请先保存配置"));

    PreparationHost rejected=fresh();rejected.worker.reject=true;rejected.saveFingerprint(rejected.fingerprintState,J.obj("display","desktop"),false);
    check("Rejected save and reread leave no loading flags stuck or traffic enabled",!rejected.fingerprintSaving&&!rejected.fingerprintLoading&&!rejected.fingerprintStateReady&&rejected.selected.web.settings.blocked&&rejected.dialogs==1);
  }

  static void validation()throws Exception{
    PreparationHost h=fresh();Tab tab=h.selected;WebView view=tab.web;tab.fingerprintReady=false;
    h.validateFingerprintSurface(tab,view);
    check("Surface validation waits for stored policy and binding receipt",tab.fingerprintValidating&&tab.fingerprintBindingPending&&!tab.fingerprintReady&&h.started==0);
    h.drain();
    check("Validated current surface gains its own receipt and traffic permission",tab.fingerprintReady&&tab.fingerprintBindingReady&&!tab.fingerprintValidating&&!view.settings.blocked&&h.fingerprintReceipt.length()>0&&h.started==1);

    PreparationHost background=fresh();Tab other=background.addTab("https://example.com/background");other.fingerprintReady=false;
    background.validateFingerprintSurface(other,other.web);background.drain();
    check("Background surface validation does not publish a foreground receipt",other.fingerprintReady&&other.fingerprintBinding==null&&!other.fingerprintBindingReady&&background.fingerprintReceipt.length()==0);

    PreparationHost stale=fresh();stale.selected.fingerprintReady=false;stale.validateFingerprintSurface(stale.selected,stale.selected.web);stale.worker.drain();
    WebView newer=new WebView();newer.settings.blocked=true;stale.selected.web=newer;stale.ui.drain();
    check("Old native-view validation cannot enable a replacement surface",!stale.selected.fingerprintReady&&newer.settings.blocked&&stale.started==0&&stale.fingerprintReceipt.length()==0);

    PreparationHost provider=fresh();provider.selected.fingerprintReady=false;provider.validateFingerprintSurface(provider.selected,provider.selected.web);provider.worker.drain();
    WebView.provider.versionName="158.0";provider.ui.drain();
    check("Provider change invalidates a completed old native confirmation",provider.selected.web==null&&!provider.selected.fingerprintReady&&provider.started==0);
    WebView.provider.versionName="157.0";

    PreparationHost changed=fresh();changed.selected.fingerprintReady=false;
    ChromiumFingerprintStore.save(changed.context,changed.fingerprintState.identity,changed.fingerprintState.revision,ChromiumFingerprintSpec.from(J.obj("display","desktop")).json());
    changed.validateFingerprintSurface(changed.selected,changed.selected.web);changed.worker.drain();changed.ui.drain();
    check("Changed durable policy rejects the stale surface before reread",changed.selected.web==null&&!changed.fingerprintStateReady&&changed.fingerprintLoading&&changed.started==0);
    changed.drain();
    check("Rejected surface validation reloads the current policy",changed.fingerprintStateReady&&changed.fingerprintSpec.desktop()&&changed.created==1);

    PreparationHost binding=fresh();binding.ensureFingerprintBinding(binding.selected);
    check("Binding receipt remains pending until durable acknowledgement",binding.selected.fingerprintBindingPending&&!binding.selected.fingerprintBindingReady&&binding.delivered==0);
    binding.drain();
    check("Current binding acknowledgement releases deferred file processing",!binding.selected.fingerprintBindingPending&&binding.selected.fingerprintBindingReady&&binding.fingerprintReceipt.length()>0&&binding.delivered==1);

    PreparationHost offline=fresh();offline.runtime.ready=false;offline.ensureFingerprintBinding(offline.selected);
    check("Unavailable route cannot request a binding receipt",offline.worker.tasks.isEmpty()&&offline.selected.fingerprintBinding==null);

    PreparationHost rejected=fresh();rejected.worker.reject=true;rejected.selected.fingerprintReady=false;rejected.validateFingerprintSurface(rejected.selected,rejected.selected.web);
    check("Rejected validation retires the surface without stuck flags",rejected.selected.web==null&&!rejected.selected.fingerprintValidating&&!rejected.fingerprintLoading&&!rejected.fingerprintStateReady);

    PreparationHost rejectedBinding=fresh();rejectedBinding.worker.reject=true;rejectedBinding.ensureFingerprintBinding(rejectedBinding.selected);
    check("Rejected binding cannot wait forever or retain its old surface",rejectedBinding.selected.web==null&&!rejectedBinding.selected.fingerprintBindingPending&&!rejectedBinding.fingerprintStateReady&&!rejectedBinding.fingerprintLoading);
  }

  public static void main(String[] args)throws Exception{
    base=Paths.get(args[0]);loading();saving();validation();
    System.out.println(J.obj("status","passed","passed",checks.size(),"total",checks.size(),"checks",new JSONArray(checks)));
  }
  static final class Bundle {}static final class Message {}
  static final class PackageInfo {String packageName="host.webview",versionName="157.0";}
  static final class WebView {static final PackageInfo provider=new PackageInfo();final Settings settings=new Settings();static PackageInfo getCurrentWebViewPackage(){return provider;}Settings getSettings(){return settings;}}
  static final class Settings {boolean blocked;void setBlockNetworkLoads(boolean blocked){this.blocked=blocked;}}
  static final class Queue {final ArrayDeque<Runnable> tasks=new ArrayDeque<>();void post(Runnable task){tasks.add(task);}void drain(){while(!tasks.isEmpty())tasks.remove().run();}}
  static final class Worker extends AbstractExecutorService {
    final ArrayDeque<Runnable> tasks=new ArrayDeque<>();boolean reject,closed;
    public void execute(Runnable task){if(reject||closed)throw new RejectedExecutionException("Injected worker rejection");tasks.add(task);}
    void drain()throws Exception{while(!tasks.isEmpty()){Runnable task=tasks.remove();Thread thread=new Thread(task,"preparation-host-worker");thread.start();thread.join();}}
    public void shutdown(){closed=true;}public List<Runnable> shutdownNow(){closed=true;return Collections.emptyList();}
    public boolean isShutdown(){return closed;}public boolean isTerminated(){return closed&&tasks.isEmpty();}public boolean awaitTermination(long timeout,TimeUnit unit){return isTerminated();}
  }
  static final class ChromiumRuntime {
    boolean ready=true,confirm=true;long policy,confirmedRevision;int beginCalls,confirmCalls;
    boolean allowed(){return ready;}long beginWorkerPolicy(){beginCalls++;return ++policy;}
    boolean confirmWorkerPolicy(long expected,EnvironmentSpec.Identity identity,long revision,boolean workers){confirmCalls++;confirmedRevision=revision;return confirm&&expected==policy;}
    JSONObject workerPolicyReceipt(){return new JSONObject();}
  }
  static final class BrowserFiles {int downloadCancellations;void cancelActiveDownload(){downloadCancellations++;}}
  static final class AppAppearance {
    static Dialog dialog(PreparationHost host){return new Dialog(host);}
    static final class Dialog {final PreparationHost host;Dialog(PreparationHost host){this.host=host;}Dialog setTitle(String text){return this;}Dialog setMessage(String text){return this;}Dialog setPositiveButton(String text,Object callback){return this;}void show(){host.dialogs++;}}
  }
}
final class ChromiumFingerprintRuntime {static final class Prepared {JSONObject receipt(){return J.obj("documentStartRegistered",true);}void close(){}}}
final class ChromiumRouteLease {static final class Handle {}}

package local.pocketchat;
import java.util.*;
import org.json.*;

/** Current fixture completion predicates with explicit native callback receipts. */
public final class NativePageHost {
  static final String ORIGIN="http://browser-fixture.example";
  final Map<Tab,NativePageCompletion> nativePageCompletions=new IdentityHashMap<>();
  Tab selected=new Tab();WebView surface=new WebView();WebView web(){return surface;}
  __COMPLETION_CLASS__
  __METHODS__
  __OLD_PAGE__
  void completed(){nativePageCompletions.put(selected,new NativePageCompletion(surface,surface.url,selected.generation));}
  static final JSONArray checks=new JSONArray();static void check(String name,boolean pass){checks.put(J.obj("name",name,"pass",pass));if(!pass)throw new AssertionError(name);}
  public static void main(String[] args){
    NativePageHost h=new NativePageHost();
    check("Previous getter-only predicate advances before native completion",h.oldPage("/start"));
    check("Current fixture does not advance before native completion",!h.page("/start"));
    h.completed();check("Current exact native completion permits page readiness",h.page("/start"));
    h.selected.failed=true;check("Failed native completion remains eligible for original history assertion",h.page("/start"));h.selected.failed=false;
    h.selected.generation++;check("Earlier navigation completion cannot acknowledge current epoch",!h.page("/start"));h.completed();check("Current epoch completion restores readiness",h.page("/start"));
    WebView original=h.surface;h.surface=new WebView();check("Retired surface completion cannot acknowledge new WebView",!h.page("/start"));h.surface=original;
    Tab old=h.selected;h.selected=new Tab();check("Another tab cannot borrow native completion even at equal generation",!h.page("/start"));h.selected=old;
    h.nativePageCompletions.put(h.selected,new NativePageCompletion(h.surface,ORIGIN+"/second",h.selected.generation));check("Wrong URL completion cannot acknowledge fixture page",!h.page("/start"));h.completed();
    h.selected.loading=true;check("Native completion cannot hide current pending navigation",!h.page("/start"));h.selected.loading=false;
    h.surface.title="Old title";check("Original exact title requirement remains",!h.page("/start"));h.surface.title="Fixture /start";
    h.surface.url=ORIGIN+"/second";check("Original exact URL requirement remains",!h.page("/start"));h.surface.url=ORIGIN+"/start";
    for(String path:new String[]{"/start","/second","/tab","/blocked","/file.txt"})check("Known synthetic path retained: "+path,controlledPagePath(ORIGIN+path).equals(path));
    for(String url:new String[]{"https://private.invalid/body",ORIGIN+"/unknown",ORIGIN+"/start?secret=raw",null})check("Unknown URL is reduced to fixed label",controlledPagePath(url).equals("other"));
    System.out.println(J.obj("status","passed","passed",checks.length(),"total",checks.length(),"checks",checks,"actualAndroidExecution",false));
  }
  static final class Tab {long generation=2;boolean loading,failed;}
  static final class WebView {String url=ORIGIN+"/start",title="Fixture /start";String getUrl(){return url;}String getTitle(){return title;}}
}

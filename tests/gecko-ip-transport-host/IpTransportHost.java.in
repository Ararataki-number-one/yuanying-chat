package local.pocketchat;

import java.io.*;
import java.net.URI;
import java.nio.file.*;
import java.util.*;
import java.util.function.Consumer;
import org.json.*;

/** Real app protocol/store/lease methods; declared SDK/OS/native inputs only. */
public final class IpTransportHost {
  static Path root;static int serial;static final List<String> checks=new ArrayList<>();
  static final String SOURCE=GeckoIpTimeZonePolicy.SOURCE,TOKEN=new String(new char[64]).replace('\0','a');
  static void check(String name,boolean pass){if(!pass)throw new AssertionError(name);checks.add(name);}
  static JSONObject json(ResultBoundary<Object> result){return result.complete?J.parse(String.valueOf(result.value)):new JSONObject();}
  static boolean blocked(JSONObject value){return value.optInt("port")==9;}
  static boolean changeBlocked(){ChromiumRouteLease.Handle handle=ChromiumRouteLease.tryChange();if(handle==null)return true;handle.close();return false;}
  static JSONObject query(WebBoundary w,String kind){WebBoundary.IpLookup q=w.ipLookup;return J.obj("kind",kind,"url",SOURCE,"method","GET","requestToken",q.token,"routeStamp",q.stamp);}
  static String envelope(WebBoundary.IpLookup q){return J.obj("schema",1,"status","observed","requestToken",q.token,"routeStamp",q.stamp,"source",SOURCE,"body",J.obj("success",true,"ip","8.8.8.8","timezone",J.obj("id","America/New_York")).toString()).toString();}
  static final class Fixture implements AutoCloseable {
    final ChatSession s;final WebBoundary w;final List<Boolean> done=new ArrayList<>();
    Fixture()throws Exception{
      check("A new fixture starts with no retained process route lease",!ChromiumRouteLease.held()&&ChromiumRouteLease.snapshot().changes==0);
      ClockBoundary.now=0;NetworkBoundary.active=null;s=new ChatSession(new TestContext(root.resolve("case-"+(++serial)),new EnvironmentSpec.Identity(2,4,GeckoTimeZoneHost.ID)));w=s.web;s.timeZone.load();s.pump();
    }
    void start(){w.prepareTimeZone(w.current,done::add);}
    void sdk(){w.current.nextUa("SdkUserAgent/157");s.pump();}
    void pending(){start();sdk();check("Actual SDK readiness enters an authenticated pending geo request",w.ipLookup!=null&&w.ipLookup.sent&&ChromiumRouteLease.snapshot().downloads==1);}
    void pendingOrFailure(String kind){if(kind.equals("post")){start();sdk();}else pending();}
    JSONObject message(String kind){for(int i=w.routePort.messages.size()-1;i>=0;i--){JSONObject row=w.routePort.messages.get(i);if(kind.equals(row.optString("kind")))return row;}throw new AssertionError("Expected actual native request: "+kind);}
    void reply(String kind,int id,String result){w.onPortMessage(J.obj("kind",kind,"id",id,"result",result),w.routePort);}
    void geo(){WebBoundary.IpLookup claim=w.ipLookup;reply("timezoneIpReady",claim.id,envelope(claim));}
    String ack(JSONObject request,String zone,String status){return J.obj("schema",1,"status",status,"sessionId",w.current.id,"requestToken",request.optString("requestToken"),"requestedZoneId",zone,"nativeZoneId",zone,"contextId","123","nativeSettingReadback",true,"scope","top-browsing-context","workerCoverageVerified",false,"serviceWorkerCoverageVerified",false).toString();}
    void read(){JSONObject request=message("timezoneRead");reply("timezoneReady",request.optInt("id"),ack(request,"","read"));s.pump();}
    void apply(){JSONObject request=message("timezoneApply");reply("timezoneReady",request.optInt("id"),ack(request,request.optString("zoneId"),"applied"));}
    public void close(){w.destroyed=true;ChromiumRouteLease.removeListener(w.leaseChanged);w.retireTimeZones();w.cookieCallbacks.clear();s.pump();check("Closing a fixture releases every actual retained lookup lease",!ChromiumRouteLease.held()&&ChromiumRouteLease.snapshot().changes==0);}
  }
  static void protocol()throws Exception{try(Fixture f=new Fixture()){
    f.start();check("No geo request or route lease exists before the SDK window barrier",f.w.ipLookup==null&&!ChromiumRouteLease.held());f.sdk();WebBoundary w=f.w;WebBoundary.IpLookup claim=w.ipLookup;
    JSONObject valid=query(w,"timezoneIpRoute");ResultBoundary<Object> route=w.onMessage("pocketroute",valid,new SenderBoundary(SenderBoundary.ENV_TYPE_EXTENSION));
    check("Exact private extension GET claim receives the current remote-DNS SOCKS route",json(route).optString("type").equals("socks")&&json(route).optString("host").equals("proxy.example")&&json(route).optInt("port")==1080&&json(route).optBoolean("proxyDNS")&&json(route).optString("connectionIsolationKey").equals("environment-2-1"));
    check("An ordinary route cannot borrow the pending service URL",blocked(w.route(SOURCE)));
    check("Content native-message caller cannot borrow IP bootstrap",blocked(json(w.onMessage("pocketroute",valid,new SenderBoundary(SenderBoundary.ENV_TYPE_CONTENT_SCRIPT)))));
    check("Another native application cannot borrow the private claim",blocked(json(w.onMessage("other",valid,new SenderBoundary(SenderBoundary.ENV_TYPE_EXTENSION)))));
    check("Wrong native lookup token is denied even for exact source",!w.ipBootstrapRequest(SOURCE,"GET",claim.token.equals(TOKEN)?TOKEN.replace('a','b'):TOKEN,claim.stamp));
    check("Wrong route stamp cannot authorize a fixed-endpoint request",!w.ipBootstrapRequest(SOURCE,"GET",claim.token,new String(new char[64]).replace('\0','f')));
    for(String target:new String[]{SOURCE+"&extra=1",SOURCE+"#fragment","http://ipwho.is/?fields=success,ip,timezone.id","https://other.example/", "https://ipwho.is/other"})check("Other URL cannot use bootstrap: "+target,!w.ipBootstrapRequest(target,"GET",claim.token,claim.stamp));
    for(String method:new String[]{"POST","HEAD","get",""})check("Only the exact fixed GET is admitted: "+method,!w.ipBootstrapRequest(SOURCE,method,claim.token,claim.stamp));
    ResultBoundary<Object> headers=w.ipBootstrapHeaders(SOURCE,"GET",claim.token,claim.stamp);check("Bootstrap headers await a fresh SDK UA result",!headers.complete);w.current.nextUa("SdkUserAgent/157");check("Actual bootstrap headers expose only allowed UA policy fields",headers.complete&&json(headers).optBoolean("allowed")&&json(headers).length()==3&&json(headers).optString("userAgent").equals("SdkUserAgent/157"));
    w.identityAllowed=false;int reads=w.current.ua.size();ResultBoundary<Object> denied=w.ipBootstrapHeaders(SOURCE,"GET",claim.token,claim.stamp);check("Changed diagnostic admission denies bootstrap before SDK UA read",denied.complete&&!json(denied).optBoolean("allowed",true)&&w.current.ua.size()==reads);w.identityAllowed=true;
    String good=envelope(claim);f.reply("timezoneIpReady",claim.id+1,good);check("Wrong native response request id cannot finish the lookup",w.ipLookup==claim&&w.ipRouteLeases.isEmpty()&&f.done.isEmpty());
    PortBoundary foreign=new PortBoundary();w.onPortMessage(J.obj("kind","timezoneIpReady","id",claim.id,"result",good),foreign);check("A foreign port cannot finish a native geo request",w.ipLookup==claim&&w.ipRouteLeases.isEmpty());
  }}
  static void commitLease()throws Exception{try(Fixture f=new Fixture()){
    f.pending();WebBoundary w=f.w;WebBoundary.TimeZoneGate gate=w.timeZoneGates.get(w.current);f.geo();
    check("Geo response transfers rather than releases its actual route lease",w.ipLookup==null&&w.ipRouteLeases.containsKey(gate)&&ChromiumRouteLease.snapshot().downloads==1&&changeBlocked());
    check("Geo observation is not native or page readiness",f.done.isEmpty()&&!f.s.timeZone.status().optBoolean("nativeSettingReadback")&&!w.timeZoneAllows(w.current));
    f.s.handler.drain();check("Actual native read starts only after parsed geo delivery",f.message("timezoneRead").optString("sessionId").equals(w.current.id));
    f.read();JSONObject request=f.message("timezoneApply");check("Actual native apply uses the resolved IANA zone",request.optString("zoneId").equals("America/New_York")&&ChromiumRouteLease.snapshot().downloads==1&&changeBlocked());
    f.apply();f.s.handler.drain();check("Route lease stays held before the real receipt writer",f.s.environmentIo.tasks.size()==1&&ChromiumRouteLease.snapshot().downloads==1&&f.done.isEmpty());
    f.s.environmentIo.drain();check("Durable publication alone cannot release the lease before UI ownership recheck",ChromiumRouteLease.snapshot().downloads==1&&f.done.isEmpty());
    f.s.handler.drain();JSONObject saved=GeckoTimeZoneHost.rawObject(f.s.context).getJSONObject("receipt");check("Only actual store publication and native final gate release the lookup lease",f.done.equals(List.of(true))&&saved.getString("effectiveZoneId").equals("America/New_York")&&w.timeZoneAllows(w.current)&&ChromiumRouteLease.snapshot().downloads==0&&w.ipRouteLeases.isEmpty());
    check("A completed bootstrap cannot lend authorization to later service requests",!w.ipBootstrapRequest(SOURCE,"GET",request.optString("requestToken"),w.ipRouteStamp()));
    check("Transport completion makes no page or Worker coverage claim",!f.s.timeZone.status().optBoolean("pageObservationVerified")&&!f.s.timeZone.status().optBoolean("workerCoverageVerified")&&!f.s.timeZone.status().optBoolean("serviceWorkerCoverageVerified"));
    ChromiumRouteLease.Handle change=ChromiumRouteLease.tryChange();check("A route change may begin after native and storage completion",change!=null);change.close();
  }}
  static void proxyRoutes()throws Exception{
    for(String scheme:new String[]{"http","https","socks"})try(Fixture f=new Fixture()){
      f.s.prefs.values.put("proxy",scheme+"://proxy.example:1234");f.pending();JSONObject route=json(f.w.onMessage("pocketroute",query(f.w,"timezoneIpRoute"),new SenderBoundary(SenderBoundary.ENV_TYPE_EXTENSION)));
      check("Bootstrap preserves the exact admitted "+scheme+" proxy without native direct fallback",route.optString("type").equals(scheme)&&route.optString("host").equals("proxy.example")&&route.optInt("port")==1234&&(scheme.equals("socks")?route.optBoolean("proxyDNS"):!route.has("proxyDNS")));
      f.s.guard.blocked=true;check("A lost guard never turns "+scheme+" bootstrap into direct",blocked(json(f.w.onMessage("pocketroute",query(f.w,"timezoneIpRoute"),new SenderBoundary(SenderBoundary.ENV_TYPE_EXTENSION)))));
    }
    try(Fixture f=new Fixture()){
      f.s.prefs.values.put("networkMode","internal");NetworkBoundary.active=new NetworkBoundary();f.pending();JSONObject route=json(f.w.onMessage("pocketroute",query(f.w,"timezoneIpRoute"),new SenderBoundary(SenderBoundary.ENV_TYPE_EXTENSION)));
      check("Internal bootstrap uses only its current controlled receipt proxy and opaque pool",route.optString("type").equals("http")&&route.optString("host").equals("127.0.0.1")&&route.optInt("port")==5678&&route.optString("connectionIsolationKey").startsWith("environment-pool-")&&!route.optString("connectionIsolationKey").contains("receipt"));
      NetworkBoundary.active.verifiedRoute.matches=false;check("A stale internal receipt never lends the private bootstrap route",blocked(json(f.w.onMessage("pocketroute",query(f.w,"timezoneIpRoute"),new SenderBoundary(SenderBoundary.ENV_TYPE_EXTENSION)))));
    }
  }
  static void stale(String kind)throws Exception{try(Fixture f=new Fixture()){
    f.pending();WebBoundary w=f.w;WebBoundary.IpLookup q=w.ipLookup;String stamp=q.stamp;
    switch(kind){case "port":w.routePort=new PortBoundary();break;case "session":w.current.open=false;break;case "runtime":w.runtime=new RuntimeBoundary();break;case "gate":w.timeZoneGates.put(w.current,new WebBoundary.TimeZoneGate());break;case "document":q.gate.documentSerial++;break;case "revision":f.s.timeZone.cached=GeckoTimeZoneStore.save(f.s.context,f.s.timeZone.cached.identity,f.s.timeZone.cached.revision,GeckoTimeZoneSpec.of("UTC"));break;case "environment":f.s.environmentId=GeckoTimeZoneHost.OTHER;break;case "generation":f.s.environmentGeneration++;break;case "connection":f.s.connectionEpoch++;break;case "identity":w.identityPolicyRevision++;break;case "protection":w.nativeProtection.token++;break;case "dns":w.ipRoutes.link("default-A","changed-dns");break;case "network":f.s.browserDefaultNetwork.initial("default-B",true,false);break;case "proxy":f.s.prefs.values.put("proxy","https://other.example:8443");break;case "blocked":f.s.guard.blocked=true;break;case "route-ready":w.generalReady=false;break;case "reload":w.ipRouteNeedsReload=true;break;case "addon":w.addonDisabled=true;break;case "destroyed":w.destroyed=true;break;case "deleted":f.s.deleted=true;break;default:throw new AssertionError(kind);}
    check("Changed "+kind+" authority cannot use old bootstrap",!w.ipBootstrapRequest(SOURCE,"GET",q.token,stamp));
    if(kind.equals("gate"))check("A replacement native gate cannot borrow the old lookup",!w.ipLookupCurrent(q));
    if(kind.equals("document"))check("A new document serial cannot borrow the old lookup",!w.ipLookupCurrent(q));
    w.onPortMessage(J.obj("kind","timezoneIpReady","id",q.id,"result",envelope(q)),q.port);f.s.pump();check("Changed "+kind+" reply never becomes a current native confirmation",!f.s.timeZone.status().optBoolean("nativeSettingReadback"));
    w.cancelIpLookup();f.s.pump();
  }}
  static void cancellations()throws Exception{
    for(String kind:new String[]{"cancel","parse","null","post","retire"})try(Fixture f=new Fixture()){
      if(kind.equals("post"))f.w.routePort.throwPost=true;f.pendingOrFailure(kind);WebBoundary w=f.w;WebBoundary.IpLookup q=w.ipLookup;
      if(kind.equals("cancel"))w.cancelIpLookup();if(kind.equals("parse"))f.reply("timezoneIpReady",q.id,"{}");if(kind.equals("null"))f.reply("timezoneIpReady",q.id,"null");if(kind.equals("retire"))w.retireTimeZone(w.current);
      f.s.pump();check("Unsuccessful "+kind+" releases actual lease without matching",ChromiumRouteLease.snapshot().downloads==0&&!f.s.timeZone.status().optBoolean("ipMatched")&&!w.timeZoneAllows(w.current));
      if(q!=null){f.reply("timezoneIpReady",q.id,envelope(q));f.s.pump();check("Late reply after "+kind+" cannot revive readiness",!w.timeZoneAllows(w.current));}
    }
    try(Fixture f=new Fixture()){
      f.pending();WebBoundary.IpLookup q=f.w.ipLookup;f.s.handler.advance(7999);f.s.pump();check("Native lookup remains authorized immediately before its eight-second deadline",f.w.ipLookup==q&&ChromiumRouteLease.snapshot().downloads==1&&f.done.isEmpty());
      f.s.handler.advance(1);f.s.pump();check("Controller timeout immediately cancels the native lookup and releases its lease",f.w.ipLookup==null&&ChromiumRouteLease.snapshot().downloads==0&&f.done.equals(List.of(false))&&f.w.routePort.messages.stream().anyMatch(row->row.optString("kind").equals("timezoneIpCancel")&&row.optInt("id")==q.id));
      f.w.retireTimeZone(f.w.current);List<Boolean> retry=new ArrayList<>();f.w.prepareTimeZone(f.w.current,retry::add);f.sdk();WebBoundary.IpLookup fresh=f.w.ipLookup;check("Immediate retry is not blocked by the old longer callback timeout",fresh!=null&&fresh.id!=q.id&&ChromiumRouteLease.snapshot().downloads==1&&retry.isEmpty());
      f.reply("timezoneIpReady",q.id,envelope(q));f.s.pump();check("Old timeout packet cannot finish the replacement lookup",f.w.ipLookup==fresh&&retry.isEmpty()&&f.done.equals(List.of(false)));
    }
    try(Fixture f=new Fixture()){f.pending();f.geo();f.s.handler.drain();f.read();f.s.context.vault.failPut=true;f.apply();f.s.pump();check("Actual receipt publication failure releases the handoff lease and keeps first navigation closed",f.done.equals(List.of(false))&&ChromiumRouteLease.snapshot().downloads==0&&f.w.ipRouteLeases.isEmpty()&&!f.w.timeZoneAllows(f.w.current));}
    try(Fixture f=new Fixture()){f.pending();WebBoundary.TimeZoneGate gate=f.w.timeZoneGates.get(f.w.current);f.geo();f.s.handler.drain();f.w.retireTimeZone(f.w.current);f.s.pump();check("Retiring native gate releases handoff route lease",!f.w.ipRouteLeases.containsKey(gate)&&ChromiumRouteLease.snapshot().downloads==0&&f.done.equals(List.of(false)));}
  }
  static void barrierAndHeaders()throws Exception{
    try(Fixture f=new Fixture()){
      ChromiumRouteLease.Handle changing=ChromiumRouteLease.tryChange();check("Actual change barrier is acquired before lookup",changing!=null);f.start();f.sdk();check("Lookup does not issue a packet across an active route change",f.w.ipLookup!=null&&!f.w.ipLookup.sent&&f.w.routePort.messages.isEmpty()&&ChromiumRouteLease.snapshot().downloads==0);changing.close();f.s.pump();check("Closing the actual change barrier starts the retained lookup once",f.w.ipLookup.sent&&f.w.routePort.messages.stream().filter(row->row.optString("kind").equals("timezoneIpLookup")).count()==1&&ChromiumRouteLease.snapshot().downloads==1);
    }
    try(Fixture f=new Fixture()){
      WebBoundary w=f.w;WebBoundary.TimeZoneGate gate=new WebBoundary.TimeZoneGate();gate.preparing=true;w.timeZoneGates.put(w.current,gate);List<String> first=new ArrayList<>(),second=new ArrayList<>();w.lookupIpTimeZone(w.current,gate,TOKEN,first::add,error->{});WebBoundary.IpLookup a=w.ipLookup;ResultBoundary<Object> old=w.ipBootstrapHeaders(SOURCE,"GET",a.token,a.stamp);w.cancelIpLookup();w.lookupIpTimeZone(w.current,gate,TOKEN,second::add,error->{});check("Sequential same-token lookups still have distinct callback identities",w.ipLookup!=a&&w.ipLookup.id!=a.id);w.current.nextUa("SdkUserAgent/157");check("Old SDK UA callback cannot borrow a replacement lookup",old.complete&&!json(old).optBoolean("allowed",true));
    }
  }
  static void initialIntent(Fixture f){f.s.navigationEpoch++;f.s.navigationTarget="https://example.com/next";f.s.navigating=true;f.s.navigationFailed=false;f.s.pageError="";f.w.queued=f.s.navigationTarget;f.w.timeZoneIntents.put(f.w.current,new Object());}
  static void spinnerFailure()throws Exception{
    try(Fixture f=new Fixture()){
      initialIntent(f);f.pending();SessionBoundary old=f.w.current;WebBoundary.TimeZoneGate failedGate=f.w.timeZoneGates.get(old);WebBoundary.IpLookup oldLookup=f.w.ipLookup;
      f.s.handler.advance(8000);f.s.pump();
      check("Eight-second initial IP failure stops spinner and preserves its exact queued target",!f.s.navigating&&f.s.navigationFailed&&!f.s.pageError.isEmpty()&&f.s.status.equals(f.s.pageError)&&f.w.queued.equals(f.s.navigationTarget)&&f.w.ipNavigationFailed(old)&&f.s.finishedNavigations==0);
      f.w.loadingTargets.put(old,f.s.navigationTarget);int started=f.w.client.started,stopped=f.w.client.finished,committed=f.w.client.committed;f.w.nativeNavigationFailure(old,f.s.navigationTarget,"late transport error");f.w.onPageStart(old,f.s.navigationTarget);f.w.onPageStop(old,true);f.w.onPageStop(old,false);f.w.invokePageVisible(old);f.w.onLocationChange(old,f.s.navigationTarget,List.of(),true);
      check("Late native errors and progress cannot overwrite exact failed initial IP state",f.s.navigationFailed&&!f.s.navigating&&f.s.finishedNavigations==0&&f.w.client.started==started&&f.w.client.finished==stopped&&f.w.client.committed==committed&&f.w.locations.get(old).isEmpty()&&f.w.painted.isEmpty()&&f.w.pendingLoads.isEmpty());
      f.w.loadUrl(f.s.navigationTarget);f.s.pump();check("Same failed navigation notifications never automatically retry the IP service",f.w.current==old&&f.w.ipLookup==null&&f.w.timeZoneGates.get(old)==failedGate);
      f.s.navigationEpoch++;f.s.navigating=true;f.s.navigationFailed=false;f.s.pageError="";f.w.loadUrl(f.s.navigationTarget);
      check("Explicit retry uses actual loadUrl and retires the failed native window before a fresh SDK barrier",f.w.current!=old&&!old.isOpen()&&!f.w.locations.containsKey(old)&&f.w.ipLookup==null&&f.w.current.ua.size()==1&&f.w.ipNavigationFailure==null&&f.w.timeZoneGates.get(f.w.current)!=failedGate);
      f.sdk();WebBoundary.IpLookup fresh=f.w.ipLookup;check("Explicit retry starts a fresh authenticated geo request",fresh!=null&&fresh!=oldLookup&&fresh.session==f.w.current&&ChromiumRouteLease.snapshot().downloads==1);
      f.w.nativeNavigationFailure(old,f.s.navigationTarget,"retired native error");f.w.onPageStart(old,f.s.navigationTarget);f.w.onPageStop(old,false);f.w.invokePageVisible(old);f.w.onLocationChange(old,f.s.navigationTarget,List.of(),true);check("Retired SDK callbacks cannot claim the fresh blank window or its task",f.w.current!=old&&f.s.navigating&&!f.s.navigationFailed&&f.s.pageError.isEmpty()&&f.s.finishedNavigations==0&&f.w.locations.get(f.w.current).isEmpty());f.reply("timezoneIpReady",oldLookup.id,envelope(oldLookup));f.s.pump();check("Retired-window response cannot complete the fresh retry",f.w.ipLookup==fresh&&f.w.current.navigated.isEmpty());
      f.geo();f.s.handler.drain();f.read();f.apply();f.s.pump();check("Fresh retry opens only the retained target after native and durable confirmation",f.w.current.navigated.equals(List.of(f.s.navigationTarget))&&f.w.queued.isEmpty()&&f.w.timeZoneAllows(f.w.current)&&!ChromiumRouteLease.held());
    }
    for(String reason:new String[]{"pending","submitting","operation","transfer","chooser","preparation","file-work","visible","location"})try(Fixture f=new Fixture()){
      initialIntent(f);f.pending();SessionBoundary old=f.w.current;f.s.handler.advance(8000);f.s.pump();check("Retry safety starts from a real timed-out IP navigation: "+reason,f.w.ipNavigationFailed(old));f.s.navigationEpoch++;f.s.navigating=true;
      switch(reason){case "pending":f.s.pending=new Object();break;case "submitting":f.s.submitting=true;break;case "operation":f.s.operation=true;break;case "transfer":f.s.transferActive=true;break;case "chooser":f.s.resourceChoosers=1;break;case "preparation":f.s.resourceFilePreparations=1;break;case "file-work":f.s.fileWork=true;break;case "visible":f.w.visible=true;break;case "location":f.w.locations.put(old,"https://example.com/live");break;default:throw new AssertionError(reason);}
      f.w.loadUrl(f.s.navigationTarget);check("Explicit IP retry does not replace a protected live task: "+reason,f.w.current==old&&old.isOpen()&&f.w.ipLookup==null&&f.w.current.navigated.isEmpty()&&f.w.queued.equals(f.s.navigationTarget));
    }
    for(String reason:new String[]{"pending","submitting","operation","transfer","chooser","preparation","file-work","visible","location","document","revalidating","ready","no-intent","target","not-navigating","manual"})try(Fixture f=new Fixture()){
      initialIntent(f);WebBoundary w=f.w;WebBoundary.TimeZoneGate gate=new WebBoundary.TimeZoneGate();w.timeZoneGates.put(w.current,gate);
      switch(reason){case "pending":f.s.pending=new Object();break;case "submitting":f.s.submitting=true;break;case "operation":f.s.operation=true;break;case "transfer":f.s.transferActive=true;break;case "chooser":f.s.resourceChoosers=1;break;case "preparation":f.s.resourceFilePreparations=1;break;case "file-work":f.s.fileWork=true;break;case "visible":w.visible=true;break;case "location":w.locations.put(w.current,"https://example.com/live");break;case "document":gate.documentSerial++;break;case "revalidating":gate.revalidating=true;break;case "ready":gate.ready=true;break;case "no-intent":w.timeZoneIntents.clear();break;case "target":w.queued="https://example.com/other";break;case "not-navigating":f.s.navigating=false;break;case "manual":f.s.timeZone.cached=GeckoTimeZoneStore.save(f.s.context,f.s.timeZone.cached.identity,f.s.timeZone.cached.revision,GeckoTimeZoneSpec.system());break;default:throw new AssertionError(reason);}
      boolean navigating=f.s.navigating;String queued=w.queued;w.finishIpNavigationFailure(w.current,gate,"controlled failure");check("Initial IP failure preserves protected state: "+reason,w.ipNavigationFailure==null&&f.s.navigating==navigating&&!f.s.navigationFailed&&f.s.pageError.isEmpty()&&w.queued.equals(queued)&&f.s.finishedNavigations==0);
    }
  }
  static void visibleRouteFailure()throws Exception{
    try(Fixture f=new Fixture()){
      f.pending();f.geo();f.s.handler.drain();f.read();f.apply();f.s.pump();
      WebBoundary w=f.w;SessionBoundary old=w.current;String a="https://example.com/visible-a";
      SessionBoundary.SessionState saved=new SessionBoundary.SessionState();saved.url=a;
      w.visible=true;w.url=a;w.locations.put(old,a);w.loadingTargets.put(old,a);w.usable.add(old);w.states.put(old,saved);w.stateDraftRevisions.put(old,7L);f.s.remembered=a;
      w.observedIpRoute=w.ipRouteStamp();w.ipRouteObserved=true;w.ipRoutes.link("default-A","changed-after-visible");f.s.pump();
      check("Actual route invalidation preserves visible A and retires its native proof",w.ipRouteNeedsReload&&w.visible&&w.current==old&&w.locations.get(old).equals(a)&&!w.timeZoneAllows(old)&&w.ipLookup==null&&w.timeZoneGates.isEmpty());
      initialIntent(f);String b=f.s.navigationTarget;long epoch=f.s.navigationEpoch;w.loadUrl(b);
      check("Explicit B remains queued while the actual SDK window callback is pending",f.s.navigating&&w.queued.equals(b)&&old.ua.size()==1&&old.navigated.isEmpty()&&w.ipLookup==null);

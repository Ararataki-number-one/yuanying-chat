  }
  static void externalHandoff(){
    try(Fixture f=new Fixture()){
      String url="https://example.test/file.pdf?token=destination";f.files.handoff(f.web,url,"temporary export");
      check("External handoff requires confirmation before launching",f.activity.started.isEmpty()&&f.files.externalDialog!=null);
      check("Handoff explains independent external login and network settings",f.files.externalDialog.message.contains("自己的登录状态和网络设置")&&f.files.externalDialog.message.contains("不会转交 Cookie"));
      f.files.externalDialog.confirm();Intent chooser=f.activity.started.get(0);
      check("Handoff launches an Android chooser rather than an implicit default browser",Intent.ACTION_CHOOSER.equals(chooser.action));
      Object excluded=chooser.extras.get(Intent.EXTRA_EXCLUDE_COMPONENTS);ComponentName[] components=excluded instanceof ComponentName[]?(ComponentName[])excluded:new ComponentName[0];
      check("External chooser excludes the exported app browser to prevent default-app loops",components.length==1&&components[0].packageName.equals(f.activity.getPackageName())&&components[0].className.equals(BrowserActivity.class.getName()));
      Object nested=chooser.extras.get(Intent.EXTRA_INTENT);check("External chooser retains one explicit nested VIEW target",nested instanceof Intent&&Intent.ACTION_VIEW.equals(((Intent)nested).action));Intent target=(Intent)nested;
      check("Nested external target retains only the requested HTTP URL and BROWSABLE category",target.data!=null&&target.data.toString().equals(url)&&target.categories.size()==1&&target.categories.contains(Intent.CATEGORY_BROWSABLE));
      check("No headers, Cookie, agent, MIME, grants or picker extras are forwarded",target.extras.isEmpty()&&target.type==null&&target.flags==0&&target.clip==null);
      check("Handoff success requests external selection without claiming a saved file",f.messages.get(f.messages.size()-1).equals("请选择外部浏览器继续"));
    }
    try(Fixture f=new Fixture()){
      f.files.handoff(f.web,"https://example.test/file","export");AlertDialog stale=f.files.externalDialog;f.web.url="https://example.test/another";stale.confirm();
      check("A changed source page prevents an old confirmation from launching",f.activity.startAttempts==0&&f.messages.get(f.messages.size()-1).contains("未移交"));
    }
    try(Fixture f=new Fixture()){
      f.files.handoff(f.web,"https://example.test/file","export");AlertDialog stale=f.files.externalDialog;f.files.destroy();stale.confirm();
      check("A destroyed helper cannot launch a queued external confirmation",f.activity.startAttempts==0&&stale.dismissed>0);
    }
    try(Fixture f=new Fixture()){
      f.files.handoff(f.web,"https://example.test/file","export");f.files.externalDialog.cancel();check("Canceling external handoff starts no activity",f.activity.startAttempts==0);
      AlertDialog old=f.files.externalDialog;f.files.handoff(f.web,"https://example.test/second","export");check("A new handoff dismisses its old dialog",old.dismissed>0&&f.files.externalDialog!=old);
    }
    for(RuntimeException failure:new RuntimeException[]{new ActivityNotFoundException(),new SecurityException("denied")})try(Fixture f=new Fixture()){
      f.activity.viewLaunchFailure=failure;f.files.handoff(f.web,"https://example.test/file","export");f.files.externalDialog.confirm();
      check("External launch failure never records a successful handoff: "+failure.getClass().getSimpleName(),f.activity.started.isEmpty()&&f.activity.startAttempts==1&&!f.messages.contains("请选择外部浏览器继续"));
      check("External launch failure reports its actionable reason: "+failure.getClass().getSimpleName(),f.messages.get(f.messages.size()-1).contains(failure instanceof SecurityException?"未允许":"没有可用"));
    }
    for(String url:new String[]{"intent://example.test/file","blob:https://example.test/file","data:text/plain,secret","file:///private/file","content://documents/private","https://user:password@example.test/file","https://127.0.0.1/file"})try(Fixture f=new Fixture()){
      f.files.handoff(f.web,url,"export");check("Unsafe external URL creates no actionable dialog: "+url,f.files.externalDialog==null&&f.activity.startAttempts==0);
    }
  }
  public static void main(String[] args)throws Exception {
    staleAndMultiple();lifecycle();reentry();invalidAndLaunch();selections();grants();malformedResults();mimeAndFlags();exhaustion();storeSlots();globalSaveSuccess();globalSaveRollback();externalHandoff();
    System.out.println(new JSONObject().put("status","passed").put("passed",checks.size()).put("checks",new JSONArray(checks)).toString());
  }

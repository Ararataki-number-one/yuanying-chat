package local.pocketchat;
import org.json.*;import java.util.*;import android.content.Context;import java.nio.charset.StandardCharsets;
public final class Share46UiHost {
 @PRODUCTION_MEMBERS@
 static int checks;static NetworkShareCodec.Bundle payload;static Prepared delivered;static int retried=-1;
 static void show(Activity a,NetworkShareCodec.Bundle b,String unavailable,Prepared owner){payload=b;delivered=owner;}
 static void check(boolean ok,String message){if(!ok)throw new AssertionError(message);checks++;}
 static void reset(){Share46Host.reset();NetworkBridge.requests.clear();NetworkBridge.frozen.clear();android.app.AlertDialog.Builder.reset();NativeNetwork.pending.clear();NativeNetwork.requested.clear();ReferenceUi.latest=null;DesignUi.actions.clear();payload=null;delivered=null;retried=-1;}
 static JSONObject node(String name)throws Exception{return J.obj("name",name,"type","socks5","server","127.0.0.1","port",1080);}
 static Prepared pair()throws Exception{Prepared p=new Prepared("Route","route");p.nodes[0]=node("Entry");p.nodes[1]=node("Exit");return p;}
 static final String KEY="a".repeat(64),OTHER="b".repeat(64);
 static void answer(boolean ok,String key){NativeNetwork.pending.remove(0).done(ok,"SYNTHETIC_RAW_PASSWORD_URL_TOKEN",J.arr("Selected"),ok?J.arr(J.obj("configFingerprint",key,"configFingerprintVersion",1)):new JSONArray(),null);}
 static Activity seed(boolean automatic)throws Exception{
  reset();Activity a=new Activity();JSONObject config=Share46Host.config();
  if(automatic)config.put("entryMode","latency").put("entryPool",J.arr("Entry|A","Entry|C")).put("entryPoolNodeKeys",J.obj("Entry|A",KEY,"Entry|C",OTHER));
  byte[] entry=("proxies:\n  - name: A\n    type: socks5\n    server: entry-a.invalid\n    port: 1080\n  - name: C\n    type: socks5\n    server: entry-c.invalid\n    port: 1080\n").getBytes(StandardCharsets.UTF_8);
  byte[] exit=("proxies:\n  - name: B\n    type: socks5\n    server: exit.invalid\n    port: 1080\n").getBytes(StandardCharsets.UTF_8);
  SecretStore store=new SecretStore(a);store.put("subscription",entry);store.put("exit-subscription",exit);
  NetworkShareSelection.savedActive(a,ProfileCatalog.identity,config,Share46Host.model(4,"v4"));SecretStore.reads.clear();return a;
 }
 static NetworkSharePreparation.Request requested(Activity a,String scope)throws Exception{
  return new NetworkSharePreparation.Request(ProfileCatalog.identity,"saved",scope,NetworkShareSelection.readHead(a,"saved").getString("version"),"");
 }
 static String entrySelection(Activity a)throws Exception{return NetworkShareSelection.readHead(a,"saved").getString("entry");}
 static Map<String,String> vaultBytes(){Map<String,String> snapshot=new TreeMap<>();for(Map.Entry<String,byte[]> entry:SecretStore.data.entrySet())snapshot.put(entry.getKey(),Base64.getEncoder().encodeToString(entry.getValue()));return snapshot;}
 static void unreadableEntryPreflight()throws Exception{
  Activity a=seed(false);NetworkSharePreparation.Request request=requested(a,"route");String selection=entrySelection(a);SecretStore.data.remove(selection);SecretStore.reads.clear();Map<String,String> beforeShare=vaultBytes();chooseEntry(a,request);
  check(NetworkBridge.requests.size()==1&&NetworkBridge.requests.get(0).same(request),"Entry selection preflight failure preserves exact route/source/version/request at real capture");
  check(NetworkBridge.frozen.get(0).parts[0].failure.stage.equals("CONFIG_READ")&&NetworkBridge.frozen.get(0).parts[1].failure==null,"Missing entry selection stays config-stage while exit captures successfully");
  check(NativeNetwork.requested.equals(Arrays.asList("exit"))&&NativeNetwork.pending.size()==1,"Real preflight failure still extracts and verifies the readable exit");
  answer(true,OTHER);check(payload==null&&ReferenceUi.latest.title.equals("分享整条线路"),"Preflight selection failure preserves requested route title before explicit narrowing");
  check(DesignUi.actions.containsKey("仅分享出口")&&DesignUi.actions.containsKey("重试入口"),"Preflight selection failure exposes actual exit-only and entry retry controls");
  DesignUi.actions.get("仅分享出口").run();check(payload!=null&&payload.kind.equals("exit")&&payload.entry==null&&payload.exit.optString("server").equals("exit.invalid"),"Only explicit exit action exports captured exit parameters after preflight failure");
  check(vaultBytes().equals(beforeShare),"Entry-preflight fallback, parameter verification and explicit narrowing never write any vault source/head/provider bytes");
  check(SecretStore.reads.stream().noneMatch(k->k.equals("network")||k.equals("pending-network")),"Preflight fallback never reads whole network configuration");
  a=seed(false);request=requested(a,"entry");SecretStore.data.remove(entrySelection(a));SecretStore.reads.clear();chooseEntry(a,request);
  check(NetworkBridge.requests.isEmpty()&&NativeNetwork.requested.isEmpty(),"Entry-only unreadable selection does not capture or verify opposite side");
  check(SecretStore.reads.stream().noneMatch(k->k.contains("exit")),"Entry-only failure never reads exit selection or provider");
  check(ReferenceUi.latest.notes.toString().contains("入口配置暂时无法读取"),"Entry-only failure remains an entry configuration error");
  a=seed(false);request=requested(a,"exit");SecretStore.fail="share-entry-selection-";SecretStore.reads.clear();chooseEntry(a,request);
  check(NetworkBridge.requests.size()==1&&NativeNetwork.requested.equals(Arrays.asList("exit")),"Exit-only path bypasses broken entry preflight and reaches only exit verification");
  check(SecretStore.reads.stream().noneMatch(k->k.contains("entry")),"Exit-only path never reads entry selection or provider");answer(true,OTHER);
  check(payload!=null&&payload.kind.equals("exit"),"Exit-only broken-entry control still produces its own payload");
  a=seed(false);request=requested(a,"route");new SecretStore(a).put(entrySelection(a),"PRIVATE_BAD_SELECTION-{TOKEN".getBytes(StandardCharsets.UTF_8));chooseEntry(a,request);
  check(NetworkBridge.frozen.get(0).parts[0].failure.stage.equals("CONFIG_READ"),"Malformed selection is classified as config read rather than subscription cache");answer(true,OTHER);
  check(!ReferenceUi.latest.notes.toString().contains("PRIVATE_BAD_SELECTION")&&!NetworkBridge.frozen.get(0).parts[0].failure.diagnostic().contains("TOKEN"),"Preflight partial errors never disclose raw selection or parser content");
  a=seed(true);request=requested(a,"route");selection=entrySelection(a);byte[] retained=SecretStore.data.remove(selection);chooseEntry(a,request);answer(true,OTHER);SecretStore.data.put(selection,retained);new SecretStore(a).put("exit-subscription","proxies:\n  - name: B\n    type: socks5\n    server: newer-exit.invalid\n    port: 1080\n".getBytes(StandardCharsets.UTF_8));DesignUi.actions.get("重试入口").run();
  check(android.app.AlertDialog.Builder.names!=null&&android.app.AlertDialog.Builder.names.length==2&&NetworkBridge.requests.size()==1,"Retry after restored automatic entry asks for explicit node without guessing");
  android.app.AlertDialog.Builder.pick(1);NetworkSharePreparation.Request selected=NetworkBridge.requests.get(1);
  check(selected.entry.equals("Entry|C")&&selected.scope.equals(request.scope)&&selected.source.equals(request.source)&&selected.version.equals(request.version)&&selected.id.equals(request.id),"Recovered explicit entry choice retains original route/source/version/request identity");
  check(Arrays.equals(NetworkBridge.frozen.get(0).parts[1].bytes,NetworkBridge.frozen.get(1).parts[1].bytes),"Recovered route recaptures exact retained exit bytes despite newer origin cache");check(NativeNetwork.pending.size()==1&&NativeNetwork.requested.equals(Arrays.asList("exit","entry")),"Recovered selected entry is verified before a new route payload is created");answer(true,OTHER);answer(true,OTHER);
  check(payload!=null&&payload.kind.equals("route")&&payload.entry.optString("server").equals("entry-c.invalid")&&payload.exit.optString("server").equals("exit.invalid"),"Recovered route retains chosen entry and original-version exit parameters");
  a=seed(false);request=requested(a,"route");SecretStore.fail="share-entry-selection-";ReferenceUi.cancelOnShow=true;chooseEntry(a,request);
  check(NetworkBridge.requests.isEmpty()&&NativeNetwork.requested.isEmpty(),"Cancelled entry-preflight wait does not start late fallback work");ReferenceUi.cancelOnShow=false;
 }
 public static void main(String[] args)throws Exception{
  reset();Activity a=new Activity();Prepared p=pair();ReferenceUi.Modal wait=new ReferenceUi.Modal(a,"wait");verifyPrepared(a,wait,p,0,KEY,KEY);answer(true,KEY);answer(true,KEY);check(payload!=null&&payload.kind.equals("route"),"Complete requested route payload");
  reset();p=pair();wait=new ReferenceUi.Modal(a,"wait");verifyPrepared(a,wait,p,0,KEY,KEY);answer(false,"");check(NativeNetwork.pending.size()==1,"Exit still checked after entry failure");answer(true,KEY);check(payload==null&&ReferenceUi.latest.title.equals("分享整条线路"),"Partial request keeps route title and has no payload");check(DesignUi.actions.containsKey("仅分享出口")&&DesignUi.actions.containsKey("重试入口"),"Partial route requires explicit narrow or same-side retry");check(!ReferenceUi.latest.notes.toString().contains("SYNTHETIC_RAW_PASSWORD_URL_TOKEN"),"Raw native secret never appears");DesignUi.actions.get("仅分享出口").run();check(payload!=null&&payload.kind.equals("exit")&&payload.entry==null,"Only explicit narrowing creates exit payload");
  reset();p=pair();wait=new ReferenceUi.Modal(a,"wait");verifyPrepared(a,wait,p,0,KEY,KEY);answer(true,KEY);answer(false,"");check(payload==null&&ReferenceUi.latest.title.equals("分享整条线路")&&DesignUi.actions.containsKey("仅分享入口")&&DesignUi.actions.containsKey("重试出口"),"Symmetric exit failure explicit route choice");
  reset();p=pair();wait=new ReferenceUi.Modal(a,"wait");verifyPrepared(a,wait,p,0,KEY,KEY);answer(false,"");answer(false,"");check(payload==null&&DesignUi.actions.containsKey("重试入口")&&DesignUi.actions.containsKey("重试出口"),"Both failures produce no portable payload");
  reset();p=pair();p.verified[1]=true;wait=new ReferenceUi.Modal(a,"wait");verifyPrepared(a,wait,p,0,KEY,KEY);answer(true,KEY);check(NativeNetwork.requested.equals(Arrays.asList("entry"))&&payload!=null,"Retry reuses already verified successful side");
  reset();p=pair();wait=new ReferenceUi.Modal(a,"wait");verifyPrepared(a,wait,p,0,KEY,KEY);answer(true,OTHER);answer(true,KEY);check(payload==null&&p.nodes[0]==null&&p.problems[0].code.equals("IDENTITY_MISMATCH"),"Fingerprint mismatch excluded with typed reason");
  reset();p=pair();wait=new ReferenceUi.Modal(a,"wait");verifyPrepared(a,wait,p,0,KEY,KEY);a.destroyed=true;answer(true,KEY);check(payload==null&&NativeNetwork.pending.isEmpty(),"Destroyed Activity ignores late native callback");
  unreadableEntryPreflight();
  System.out.println(J.obj("passed",checks,"actualAndroidExecution",false,"actualNativeExecution",false,"scope","Exact production chooseEntry/prepare/capture/extract/retry/verify/show; explicit Activity/bridge/native adapters").toString());
 }
}
class Activity extends android.content.Context {boolean destroyed;Activity(){super("ui");}boolean isDestroyed(){return destroyed;}void runOnUiThread(Runnable action){action.run();}}
class ReferenceUi {static Modal latest;static boolean cancelOnShow;static class Body{void removeAllViews(){}}static class Modal{final Body body=new Body();final String title;final List<String> notes=new ArrayList<>();boolean showing=true;Modal(Activity a,String title){this.title=title;latest=this;}void note(String s){notes.add(s);}boolean isShowing(){return showing;}void dismiss(){showing=false;}void show(){if(cancelOnShow)showing=false;}void resize(){}void buttons(String a,Runnable b,String c,Runnable d){}}static void message(Activity a,String title,String text){}}
class DesignUi {static final Map<String,Runnable> actions=new LinkedHashMap<>();static void action(Object body,String label,boolean strong,Runnable action){actions.put(label,action);}}

class NetworkWorkspaceUi {static void libraryWork(Runnable action){action.run();}static String nodeName(String name){return name;}}
class NetworkBridge {
 interface SnapshotResult {void done(NetworkSharePreparation.Frozen frozen,NetworkSharePreparation.Failure failed);}
 static final List<NetworkSharePreparation.Request> requests=new ArrayList<>();static final List<NetworkSharePreparation.Frozen> frozen=new ArrayList<>();
 static void shareSnapshot(Activity activity,NetworkSharePreparation.Request request,SnapshotResult result){requests.add(request);try{NetworkSharePreparation.Frozen value=NetworkShareSelection.capture(Profiles.context(activity,request.owner.slot),request);frozen.add(value);result.done(value,null);}catch(Exception error){result.done(null,error instanceof NetworkSharePreparation.Failure?(NetworkSharePreparation.Failure)error:NetworkSharePreparation.fail("CONFIG_READ","UNREADABLE",""));}}
}

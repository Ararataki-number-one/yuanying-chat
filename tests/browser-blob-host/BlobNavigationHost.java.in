package local.pocketchat;

import java.util.*;
import java.util.function.BooleanSupplier;

/** Exact activity entry methods; WebView, callbacks and UI are controlled adapters. */
public final class BlobNavigationHost {
  static final String PAGE="https://example.com/editor",BLOB="blob:https://example.com/export-123";
  static int checks;
  static void check(String label,boolean value){if(!value)throw new AssertionError(label);checks++;}
  static BrowserActivity activity(){return new BrowserActivity(PAGE);}
  static BrowserActivity.Tab popup(BrowserActivity activity){
    BrowserActivity.Tab original=activity.selected;
    check("gesture creates native popup",activity.new Chrome(original).onCreateWindow(original.web,false,true,new Message()));
    return activity.selected;
  }
  public static void main(String[] args){
    BrowserActivity a=activity();BrowserActivity.Tab tab=a.selected;WebView source=tab.web;
    check("same-page Blob is consumed",a.new Client(tab).shouldOverrideUrlLoading(source,new WebResourceRequest(BLOB,true,true)));
    check("same-page download retains original document",a.files.blobs==1&&a.files.owner==source&&a.files.page.equals(PAGE)&&a.files.current.getAsBoolean()&&a.navigationCalls==0&&a.externalCalls==0);
    tab.generation++;check("same URL new navigation expires reader authority",!a.files.current.getAsBoolean());

    a=activity();tab=a.selected;source=tab.web;source.url=BLOB;
    a.new Client(tab).onPageStarted(source,BLOB,null);
    check("onPageStarted fallback stops Blob navigation before retiring document",source.stops==1&&a.navigationCalls==0&&a.files.blobs==1&&a.files.page.equals(PAGE)&&a.files.current.getAsBoolean());

    a=activity();tab=a.selected;source=tab.web;
    check("subframe Blob stays outside download entry",a.new Client(tab).shouldOverrideUrlLoading(source,new WebResourceRequest(BLOB,false,true))&&a.files.blobs==0&&a.externalCalls==0);
    check("ordinary HTTPS retains normal navigation",!a.new Client(tab).shouldOverrideUrlLoading(source,new WebResourceRequest("https://example.com/next",true,true))&&a.files.blobs==0);
    check("other schemes retain existing external path",a.new Client(tab).shouldOverrideUrlLoading(source,new WebResourceRequest("intent:example",true,true))&&a.externalCalls==1&&a.files.blobs==0);

    a=activity();tab=a.selected;source=tab.web;
    a.new Client(tab).onPageStarted(source,"blob:https://other.example/file",null);
    check("cross-origin Blob cannot replace or read source page",a.files.blobs==0&&a.navigationCalls==0&&source.stops==1&&!a.status.isEmpty());

    a=activity();tab=a.selected;source=tab.web;a.wireDownload(tab,source);
    source.listener.onDownloadStart(BLOB,"agent","attachment; filename=report.pdf","application/pdf",123);
    check("native download listener uses same source-bound path",a.files.blobs==1&&a.files.owner==source&&a.files.disposition.contains("report.pdf")&&a.files.mime.equals("application/pdf")&&a.files.bytes==123);
    source.listener.onDownloadStart("https://example.com/report.pdf","agent","","application/pdf",123);
    check("ordinary HTTP listener keeps transfer path",a.files.http==1);

    a=activity();BrowserActivity.Tab original=a.selected;BrowserActivity.Tab pop=popup(a);
    BrowserActivity.BlobDocument captured=pop.blobOpener;
    check("popup captures exact native opener identity",captured.tab==original&&captured.view==original.web&&captured.url.equals(PAGE)&&captured.navigation==original.generation&&captured.surface==original.surfaceGeneration&&captured.policy==a.fingerprintState);
    a.new Client(pop).onPageStarted(pop.web,"about:blank",null);
    check("initial blank page retains opener",pop.blobOpener==captured);
    a.new Client(pop).shouldOverrideUrlLoading(pop.web,new WebResourceRequest(BLOB,true,true));
    check("popup Blob reads in original WebView and closes empty child",a.files.blobs==1&&a.files.owner==original.web&&a.files.page.equals(PAGE)&&a.selected==original&&!a.tabs.contains(pop)&&a.closed==1&&a.files.current.getAsBoolean());
    check("popup handoff leaves original navigation unchanged",original.generation==captured.navigation);

    a=activity();original=a.selected;pop=popup(a);a.wireDownload(pop,pop.web);
    pop.web.listener.onDownloadStart(BLOB,"agent","","application/pdf",123);
    check("popup native download uses original source",a.files.blobs==1&&a.files.owner==original.web&&a.selected==original&&!a.tabs.contains(pop));

    a=activity();original=a.selected;pop=popup(a);pop.web.url=BLOB;
    a.new Client(pop).onPageStarted(pop.web,BLOB,null);
    check("popup onPageStarted fallback returns to original document",a.files.blobs==1&&a.files.owner==original.web&&a.selected==original&&a.navigationCalls==0);

    for(int mutation=0;mutation<12;mutation++){
      a=activity();original=a.selected;pop=popup(a);WebView popupView=pop.web;
      switch(mutation){
        case 0:original.generation++;break;
        case 1:original.surfaceGeneration++;break;
        case 2:original.web=new WebView(PAGE);break;
        case 3:original.web.url="https://example.com/new-document";break;
        case 4:a.tabs.remove(original);break;
        case 5:original.fingerprintReady=false;break;
        case 6:pop.fingerprintReady=false;break;
        case 7:a.runtime.allowed=false;break;
        case 8:a.foreground=false;break;
        case 9:a.selected=original;break;
        case 10:a.fingerprintState=new ChromiumFingerprintStore.State();break;
        case 11:a.destroyed=true;break;
      }
      check("stale or unprotected popup never reads opener "+mutation,a.downloadBlobNavigation(pop,popupView,BLOB,"","application/pdf",123)&&a.files.blobs==0&&a.closed==0);
    }

    a=activity();original=a.selected;pop=popup(a);
    check("first HTTP popup navigation remains ordinary",!a.new Client(pop).shouldOverrideUrlLoading(pop.web,new WebResourceRequest("https://other.example/page",true,true))&&pop.blobOpener==null);
    a.downloadBlobNavigation(pop,pop.web,BLOB,"","application/pdf",123);
    check("navigated child cannot borrow retired opener",a.files.blobs==0);

    a=activity();pop=popup(a);BrowserActivity.BlobDocument retained=pop.blobOpener;
    a.new Client(pop).onPageStarted(new WebView(PAGE),"https://other.example/page",null);
    check("stale surface callback cannot clear live opener",pop.blobOpener==retained&&a.navigationCalls==0);
    a.new Client(pop).onPageStarted(pop.web,"https://other.example/page",null);
    check("page-start HTTP clears opener and uses normal lifecycle",pop.blobOpener==null&&a.navigationCalls==1);

    a=activity();original=a.selected;
    check("popup needs a user gesture",!a.new Chrome(original).onCreateWindow(original.web,false,false,new Message())&&a.tabs.size()==1);
    a.foreground=false;
    check("background popup cannot capture opener",!a.new Chrome(original).onCreateWindow(original.web,false,true,new Message())&&a.tabs.size()==1);
    System.out.println("{\"status\":\"passed\",\"checks\":"+checks+",\"actualAndroidExecution\":false,\"actualWebViewExecution\":false}");
  }
}

class BrowserActivity {
  static final int MAX_TABS=8;
  final ArrayList<Tab> tabs=new ArrayList<>();final BrowserFiles files=new BrowserFiles();
  final Runtime runtime=new Runtime();ChromiumFingerprintStore.State fingerprintState=new ChromiumFingerprintStore.State();
  boolean destroyed,foreground=true,fingerprintStateReady=true,fingerprintLoading,fingerprintSaving;
  Tab selected;int navigationCalls,externalCalls,closed;String status="";
  static final class Tab {
    WebView web;String url;boolean loading,failed,fingerprintReady=true;Object fingerprint=new Object();
    long generation=7,surfaceGeneration=11;ChromiumFingerprintStore.State fingerprintPolicy;Message fingerprintPopup;BlobDocument blobOpener;
    Tab(String url){this.url=url;}
  }
  /* DOCUMENT */
  /* METHODS */
  BrowserActivity(String page){Tab tab=new Tab(page);tab.web=new WebView(page);tab.fingerprintPolicy=fingerprintState;tabs.add(tab);selected=tab;}
  void select(Tab tab){selected=tab;if(tab.web==null){tab.web=new WebView("about:blank");tab.fingerprintPolicy=fingerprintState;}}
  void closeTab(Tab tab){tabs.remove(tab);closed++;}
  void message(String value){status=value;}
  void external(String url){externalCalls++;}
  boolean beginPageNavigation(Tab tab,WebView view){if(!live(tab,view))return false;navigationCalls++;tab.generation++;return true;}
  void ensureFingerprintBinding(Tab tab){}void updateChrome(){}
  void wireDownload(Tab tab,WebView view){/* LISTENER */}
  final class Client extends WebViewClient {
    final Tab tab;Client(Tab tab){this.tab=tab;}
    /* CLIENT */
  }
  final class Chrome extends WebChromeClient {
    final Tab tab;Chrome(Tab tab){this.tab=tab;}
    /* CHROME */
  }
}
class WebView {
  String url;int stops;DownloadListener listener;
  WebView(String url){this.url=url;}String getUrl(){return url;}void stopLoading(){stops++;}
  void setDownloadListener(DownloadListener listener){this.listener=listener;}
  static class WebViewTransport{}
}
interface DownloadListener{void onDownloadStart(String url,String agent,String disposition,String mime,long bytes);}
class BrowserFiles {
  int blobs,http;WebView owner;String page,disposition,mime;long bytes;BooleanSupplier current;
  void downloadBlob(WebView view,String target,String disposition,String mime,long bytes,String page,BooleanSupplier current){blobs++;owner=view;this.page=page;this.disposition=disposition;this.mime=mime;this.bytes=bytes;this.current=current;}
  void download(WebView view,String target,String agent,String disposition,String mime,long bytes){http++;}
}
class WebViewClient{public boolean shouldOverrideUrlLoading(WebView source,WebResourceRequest request){return false;}public void onPageStarted(WebView source,String url,Bitmap icon){}}
class WebChromeClient{public boolean onCreateWindow(WebView source,boolean dialog,boolean gesture,Message result){return false;}}
class WebResourceRequest {
  final String url;final boolean main,gesture;WebResourceRequest(String url,boolean main,boolean gesture){this.url=url;this.main=main;this.gesture=gesture;}
  Object getUrl(){return url;}boolean isForMainFrame(){return main;}boolean hasGesture(){return gesture;}
}
class Message{Object obj=new WebView.WebViewTransport();}
class Bitmap{}
class BrowserPreferences{static String home(BrowserActivity activity){return "https://home.example/";}}
class ChromiumFingerprintStore{static class State{}}
class Runtime{boolean allowed=true;boolean allowed(){return allowed;}}

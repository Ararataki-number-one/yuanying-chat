  static void workspaceCards()throws Exception{
    setup();DesignDownloads.Controller controller=new DesignDownloads.Controller();controller.preparedOwners=new HashMap<>();
    String reason="服务器拒绝了这次请求。\n请检查原页面中的下载链接，再重新尝试。";
    JSONObject task=row("failed-empty",0,"failed").put("received",0).put("total",-1).put("reason",reason);controller.preparedOwners.put(DownloadListPolicy.key(task),"环境");
    controller.apply(new JSONArray().put(task),0,1000);DesignDownloads.Row current=controller.views.get(DownloadListPolicy.key(task));
    check("Failed task without received bytes hides empty progress and keeps state",current.progress.getVisibility()==View.GONE&&current.progressText.getVisibility()==View.GONE&&label(controller,task).equals("环境 · 失败待处理"));
    check("Failed reason stays complete and task remains actionable",current.reason.getVisibility()==View.VISIBLE&&current.reason.getText().toString().equals(reason)&&current.menu.getVisibility()==View.GONE&&current.arrow.getVisibility()==View.VISIBLE&&((Ui.Icon)current.icon.drawable).shape.equals("info"));
    task.put("total",100);controller.apply(new JSONArray().put(task),0,1001);check("Known total alone does not make failed zero-byte progress meaningful",current.progress.getVisibility()==View.GONE&&current.progressText.getVisibility()==View.GONE);
    task.put("total",0);controller.apply(new JSONArray().put(task),0,1002);check("Failed zero-byte zero-total task does not expose an empty bar or zero-byte label",current.progress.getVisibility()==View.GONE&&current.progressText.getVisibility()==View.GONE);
    task.put("total",-1).put("received",12);controller.apply(new JSONArray().put(task),0,1003);check("Failed partial download with unknown total keeps received bytes without an empty percent bar",current.progress.getVisibility()==View.GONE&&current.progressText.getVisibility()==View.VISIBLE&&current.progressText.getText().toString().equals("12 B")&&label(controller,task).equals("环境 · 失败待处理 · 12 B"));
    task.put("total",24);controller.apply(new JSONArray().put(task),0,1004);check("Failed partial download with known total retains real progress",current.progress.getVisibility()==View.VISIBLE&&current.progress.getProgress()==50&&!current.progress.isIndeterminate()&&current.progressText.getText().toString().equals("12 B / 24 B"));
    int images=current.icon.imageWrites,iconFaces=current.icon.backgroundWrites,chips=current.stateLabel.backgroundWrites,stateColors=current.stateLabel.colorWrites;task.put("received",13);Meter.reset();controller.apply(new JSONArray().put(task),0,1005);
    check("Byte-only update binds once without rewriting icon or state-chip appearance",Meter.binds==1&&current.icon.imageWrites==images&&current.icon.backgroundWrites==iconFaces&&current.stateLabel.backgroundWrites==chips&&current.stateLabel.colorWrites==stateColors);
    task.put("state","downloading").put("received",0).put("total",-1).put("reason","");controller.apply(new JSONArray().put(task),0,1006);check("Retry restores unknown-total activity and removes the old failure reason",current.progress.getVisibility()==View.VISIBLE&&current.progress.isIndeterminate()&&current.progressText.getVisibility()==View.VISIBLE&&current.reason.getVisibility()==View.GONE&&((Ui.Icon)current.icon.drawable).shape.equals("download")&&current.stateLabel.getText().toString().equals("下载中"));
    task.put("state","paused");controller.apply(new JSONArray().put(task),0,1007);check("Pausing after retry preserves the paused label and icon",!current.progress.isIndeterminate()&&((Ui.Icon)current.icon.drawable).shape.equals("pause")&&((Ui.Icon)current.icon.drawable).color==DesignUi.MUTED&&current.stateLabel.getText().toString().equals("已暂停"));
    JSONObject saved=row("typed-file",0,"saved").put("name","declared-name.txt").put("actualName","report.PDF").put("savedBytes",0);controller.preparedOwners.put(DownloadListPolicy.key(saved),"环境");controller.apply(new JSONArray().put(saved),0,1010);DesignDownloads.Row file=controller.views.get(DownloadListPolicy.key(saved));
    check("Actual PDF name colors the file while saved state stays green and zero bytes stay visible",((Ui.Icon)file.icon.drawable).shape.equals("file")&&((Ui.Icon)file.icon.drawable).color==ReferenceUi.ORANGE&&file.stateLabel.textColor==DesignUi.GREEN&&file.stateLabel.background!=null&&label(controller,saved).equals("环境 · 已保存 · 0 B")&&file.progress.getVisibility()==View.GONE&&file.progressText.getVisibility()==View.GONE);
    saved.put("actualName","cover.PNG");Meter.reset();controller.apply(new JSONArray().put(saved),0,1011);check("Provider filename change rebinds the same row with its new image icon",Meter.binds==1&&controller.views.get(DownloadListPolicy.key(saved))==file&&file.name.getText().toString().equals("cover.PNG")&&((Ui.Icon)file.icon.drawable).shape.equals("image")&&((Ui.Icon)file.icon.drawable).color==DesignUi.GREEN);
    JSONObject replacement=new JSONObject(saved.toString()).put("mime","application/pdf").put("actualMime","application/pdf");Meter.reset();controller.apply(new JSONArray().put(replacement),0,1012);check("MIME-only action changes do not invalidate filename-only decoration",Meter.binds==0&&file.value==replacement&&((Ui.Icon)file.icon.drawable).shape.equals("image")&&((Ui.Icon)file.icon.drawable).color==DesignUi.GREEN);
    replacement.put("actualName","photo.png.backup");Meter.reset();controller.apply(new JSONArray().put(replacement),0,1013);check("Unknown final extension restores the generic file icon",Meter.binds==1&&((Ui.Icon)file.icon.drawable).shape.equals("file")&&((Ui.Icon)file.icon.drawable).color==DesignUi.CYAN);
    replacement.put("actualName","photo.JPEG");controller.apply(new JSONArray().put(replacement),0,1014);check("Image extension matching remains case insensitive",((Ui.Icon)file.icon.drawable).shape.equals("image")&&((Ui.Icon)file.icon.drawable).color==DesignUi.GREEN);
  }
  public static void main(String[] ignored)throws Exception{Locale.setDefault(Locale.ROOT);TimeZone.setDefault(TimeZone.getTimeZone("UTC"));
    for(int count:new int[]{100,1000,10000}){ProfileCatalog catalog=setup();JSONArray data=rows(count);data.getJSONObject(0).put("savedBytes",0);data.getJSONObject(1).put("savedBytes",1234);DownloadPageWindow page=new DownloadPageWindow(data,0,"");DesignDownloads.Controller controller=new DesignDownloads.Controller();controller.preparedNames=new HashMap<>();for(int slot=0;slot<8;slot++)controller.preparedNames.put(slot,"环境名 "+slot);controller.preparedTimes=new HashMap<>();controller.preparedOwners=new HashMap<>();Map<Integer,DownloadOwnerLabels.Owner> ownerMap=DownloadDisplaySnapshot.owners(controller.a);for(int i=0;i<page.rows.length();i++){JSONObject row=page.rows.getJSONObject(i);controller.preparedTimes.put(DownloadListPolicy.key(row),"时间未记录");controller.preparedOwners.put(DownloadListPolicy.key(row),DownloadOwnerLabels.label(row,ownerMap));}
      resetQueries(catalog);Meter.reset();controller.apply(page.rows,0,1000);check(count+" main cards bound <=40",Meter.binds==40&&controller.views.size()==40&&controller.list.getChildCount()==40);check(count+" main SQL and time formatting remain zero",catalog.db.queries.size()==0&&Meter.formats==0);check(count+" known zero and unknown remain visibly different",label(controller,data.getJSONObject(0)).equals("环境名 0 · 已保存 · 0 B")&&label(controller,data.getJSONObject(2)).endsWith("大小未知"));
      Map<String,DesignDownloads.Row> keep=new LinkedHashMap<>(controller.views);controller.scroll.scrollTo(0,150);Meter.reset();controller.apply(page.rows,0,2000);check(count+" unchanged page binds zero and preserves row/scroll",Meter.binds==0&&controller.scroll.getScrollY()==150&&keep.entrySet().stream().allMatch(e->controller.views.get(e.getKey())==e.getValue()));
      data.getJSONObject(1).put("savedBytes",5678);Meter.reset();controller.apply(page.rows,0,3000);check(count+" one size update binds one",Meter.binds==1);
      JSONObject changed=new JSONObject(data.getJSONObject(1).toString()).put("location","/must/not/be/visible").put("uri","content://replacement-action");JSONArray fresh=new JSONArray();for(int i=0;i<page.rows.length();i++)fresh.put(i==1?changed:page.rows.getJSONObject(i));Meter.reset();controller.apply(fresh,0,4000);DesignDownloads.Row action=controller.views.get(DownloadListPolicy.key(changed));check(count+" hidden path/action change binds zero and refreshes action payload",Meter.binds==0&&action.value==changed&&action.location.getVisibility()==View.GONE&&action.location.getText().length()==0);
      DesignDownloads.Row viewed=controller.views.get(DownloadListPolicy.key(data.getJSONObject(1)));controller.scroll.scrollTo(0,controller.list.getTop()+150);int offset=viewed.card.getTop()-controller.scroll.getScrollY();DesignDownloads.Row resized=controller.views.get(DownloadListPolicy.key(data.getJSONObject(0)));Meter.resize=()->{resized.card.height=200;controller.list.layout();};data.getJSONObject(0).put("actualName","resized-name-from-provider.txt");controller.apply(page.rows,0,4500);boolean reflowKept=controller.views.get(DownloadListPolicy.key(data.getJSONObject(1)))==viewed&&viewed.card.getTop()-controller.scroll.getScrollY()==offset;check(count+" filename reflow above viewed row preserves file and offset",reflowKept);
      controller.apply(data,0,5000);check(count+" defensive main bound also rejects an unpaged full input",controller.views.size()==40&&controller.list.getChildCount()==40);
      measurements.put(J.obj("history",count,"attachedCards",controller.list.getChildCount(),"initialMainBinds",40,"unchangedMainBinds",0,"oneSizeMainBinds",1,"mainSqlCalls",catalog.db.queries.size(),"mainTimeFormatCalls",Meter.formats,"reflowAnchorPreserved",reflowKept,"phoneFrameMeasurement",false));
    }
    ProfileCatalog catalog=setup();DesignDownloads.Controller controller=new DesignDownloads.Controller();controller.preparedNames=new HashMap<>();controller.preparedNames.put(0,"环境");JSONObject task=row("active",0,"downloading").put("received",12).put("total",-1);controller.preparedOwners=new HashMap<>();controller.preparedOwners.put(DownloadListPolicy.key(task),"环境");controller.apply(new JSONArray().put(task),0,1);check("Unknown total shows received only",label(controller,task).equals("环境 · 下载中 · 12 B"));task.put("total",24);controller.apply(new JSONArray().put(task),0,2);check("Known total shows received and total",label(controller,task).equals("环境 · 下载中 · 12 B / 24 B"));
    JSONObject legacy=row("old-owner",0,"saved");legacy.remove("environmentId");legacy.remove("environmentGeneration");JSONObject rebuilt=row("rebuilt-owner",0,"saved").put("environmentId","10000000-0000-0000-0000-000000000000");Map<Integer,DownloadOwnerLabels.Owner> currentOwners=DownloadDisplaySnapshot.owners(controller.a);controller.preparedOwners.put(DownloadListPolicy.key(legacy),DownloadOwnerLabels.label(legacy,currentOwners));controller.preparedOwners.put(DownloadListPolicy.key(rebuilt),DownloadOwnerLabels.label(rebuilt,currentOwners));controller.apply(new JSONArray().put(legacy).put(rebuilt),0,3);check("Card labels never attach old or unconfirmed files to the new slot owner",label(controller,legacy).startsWith("归属待确认 · ")&&label(controller,rebuilt).startsWith("原环境（已重建） · "));
    workspaceCards();int passed=0;for(int i=0;i<checks.length();i++)if(checks.getJSONObject(i).getBoolean("pass"))passed++;System.out.println(J.obj("status",passed==checks.length()?"passed":"failed","passed",passed,"total",checks.length(),"checks",checks,"measurements",measurements,"actualAndroidExecution",false,"actualSqliteExecution",false,"phonePerformanceMeasured",false,"scope","Exact production apply/bind and filename-decoration methods plus actual metadata/page/row-revision classes with counted widget/catalog adapters. Forty-row page, 100/1000/10000 histories; no Android frame claim."));if(passed!=checks.length())System.exit(1);
  }

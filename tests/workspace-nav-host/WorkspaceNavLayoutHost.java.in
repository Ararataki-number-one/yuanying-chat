package local.pocketchat;

import java.util.ArrayList;

/** Controlled measurement boundaries, not Android typography or rendering. */
public final class WorkspaceNavLayoutHost {
  static int passed;
  static void check(boolean value,String message){if(!value)throw new AssertionError(message);passed++;}
  static int dp(Context c,int value){return value;}
  /* PRODUCTION_BAR */
  /* PRODUCTION_CENTER */

  static WorkspaceNavBar bar(int minimum,int labelHeight,int wrapAt){
    Context c=new Context();GlassDock dock=new GlassDock(c);dock.setPadding(5,2,5,2);
    WorkspaceNavBar bar=new WorkspaceNavBar(c,dock,minimum);bar.setPadding(12,10,12,12);
    for(int i=0;i<5;i++)dock.addView(new Button(c,labelHeight,i==0?wrapAt:1),new LinearLayout.LayoutParams(0,-1));
    return bar;
  }
  static void measure(WorkspaceNavBar bar,int width){
    bar.measure(View.MeasureSpec.makeMeasureSpec(width,View.MeasureSpec.EXACTLY),
      View.MeasureSpec.makeMeasureSpec(1000,View.MeasureSpec.AT_MOST));
    for(View child:bar.dock.children)centerDockContents((Button)child);
  }
  static void fits(WorkspaceNavBar bar){
    int min=Integer.MAX_VALUE,max=0;
    for(View child:bar.dock.children){
      Button b=(Button)child;min=Math.min(min,b.getMeasuredWidth());max=Math.max(max,b.getMeasuredWidth());
      check(b.contentHeight()+b.getPaddingTop()+b.getPaddingBottom()==b.getHeight(),"Complete icon and all label lines remain centered");
      check(b.getPaddingTop()>=8&&b.getPaddingBottom()>=8,"Native content retains vertical breathing room");
    }
    check(max-min<=1,"Five destinations keep equal pixel widths");
    check(bar.getMeasuredHeight()==bar.dock.getMeasuredHeight()+22,"Bar includes complete dock and outer padding");
  }
  public static void main(String[] args){
    WorkspaceNavBar large=bar(86,25,62);measure(large,320);
    check(large.dock.getMeasuredHeight()==94,"320dp enlarged label grows dock to two native lines");fits(large);
    int first=large.getMeasuredHeight();
    for(int i=0;i<5;i++)measure(large,320);
    check(large.getMeasuredHeight()==first,"Centering remeasure stabilizes without accumulating padding");fits(large);
    measure(large,480);check(large.dock.getMeasuredHeight()==86,"Widening restores original minimum once label fits");fits(large);
    measure(large,320);check(large.getMeasuredHeight()==first,"Returning narrow restores the full wrapped height");
    WorkspaceNavBar normal=bar(72,17,40);measure(normal,320);
    check(normal.dock.getMeasuredHeight()==72,"Normal labels retain original minimum dock");fits(normal);
    WorkspaceNavBar largest=bar(94,31,76);measure(largest,320);
    check(largest.dock.getMeasuredHeight()==106,"Larger native fallback metrics also grow without font scaling");fits(largest);
    WorkspaceNavBar rounding=bar(86,25,60);measure(rounding,333);
    check(rounding.dock.getMeasuredHeight()==94,"Smallest equal column controls height despite pixel rounding");fits(rounding);
    Context c=new Context();WorkspaceNavBar empty=new WorkspaceNavBar(c,new GlassDock(c),72);measure(empty,320);
    check(empty.getMeasuredHeight()==72,"Empty measurement does not divide by zero");
    System.out.println("{\"passed\":"+passed+",\"actualAndroidExecution\":false}");
  }
}

class Context {}
class Rect {int height;Rect(int height){this.height=height;}int height(){return height;}}
class Drawable {final Rect bounds=new Rect(20);Rect getBounds(){return bounds;}}
class Layout {final int height;Layout(int height){this.height=height;}int getHeight(){return height;}}
class View {
  static final class MeasureSpec {
    static final int UNSPECIFIED=0,EXACTLY=1,AT_MOST=2;
    static int makeMeasureSpec(int size,int mode){return size*4+mode;}
    static int getSize(int spec){return spec/4;}static int getMode(int spec){return spec%4;}
  }
  final Context context;int width,height,left,top,right,bottom;LinearLayout.LayoutParams params;
  View(Context c){context=c;}Context getContext(){return context;}
  void measure(int widthSpec,int heightSpec){onMeasure(widthSpec,heightSpec);}
  protected void onMeasure(int widthSpec,int heightSpec){width=MeasureSpec.getSize(widthSpec);height=MeasureSpec.getSize(heightSpec);}
  int getMeasuredWidth(){return width;}int getMeasuredHeight(){return height;}int getHeight(){return height;}
  int getPaddingLeft(){return left;}int getPaddingRight(){return right;}int getPaddingTop(){return top;}int getPaddingBottom(){return bottom;}
  void setPadding(int l,int t,int r,int b){left=l;top=t;right=r;bottom=b;}
  LinearLayout.LayoutParams getLayoutParams(){return params;}
}
class Button extends View {
  final int lineHeight,wrapAt;final Drawable icon=new Drawable();int lines=1;
  Button(Context c,int lineHeight,int wrapAt){super(c);this.lineHeight=lineHeight;this.wrapAt=wrapAt;setPadding(2,8,2,8);}
  int contentHeight(){return 24+lineHeight*lines;}
  @Override protected void onMeasure(int widthSpec,int heightSpec){
    width=MeasureSpec.getSize(widthSpec);lines=width<wrapAt?2:1;
    height=MeasureSpec.getMode(heightSpec)==MeasureSpec.UNSPECIFIED?contentHeight()+top+bottom:MeasureSpec.getSize(heightSpec);
  }
  Drawable[] getCompoundDrawables(){return new Drawable[]{null,icon,null,null};}
  int getCompoundDrawablePadding(){return 4;}Layout getLayout(){return new Layout(lines*lineHeight);}
}
class LinearLayout extends View {
  static final int VERTICAL=1;int orientation;final ArrayList<View> children=new ArrayList<>();
  static class LayoutParams {int width,height;LayoutParams(int w,int h){width=w;height=h;}}
  LinearLayout(Context c){super(c);}void setOrientation(int value){orientation=value;}
  void addView(View v,LayoutParams p){v.params=p;children.add(v);}int getChildCount(){return children.size();}View getChildAt(int i){return children.get(i);}
  @Override protected void onMeasure(int widthSpec,int heightSpec){
    width=MeasureSpec.getSize(widthSpec);
    if(orientation==VERTICAL){
      height=top+bottom;
      for(View child:children){child.measure(MeasureSpec.makeMeasureSpec(width-left-right,MeasureSpec.EXACTLY),
        MeasureSpec.makeMeasureSpec(child.params.height,MeasureSpec.EXACTLY));height+=child.getMeasuredHeight();}
    }else{
      height=MeasureSpec.getSize(heightSpec);int remaining=width-left-right;
      for(int i=0;i<children.size();i++){int share=remaining/(children.size()-i);remaining-=share;
        children.get(i).measure(MeasureSpec.makeMeasureSpec(share,MeasureSpec.EXACTLY),
          MeasureSpec.makeMeasureSpec(height-top-bottom,MeasureSpec.EXACTLY));}
    }
  }
}
class GlassDock extends LinearLayout {GlassDock(Context c){super(c);}}

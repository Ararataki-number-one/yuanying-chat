package local.pocketchat;

import java.util.ArrayList;

/** Exact production row with explicit text-metric and View measurement boundaries. */
public final class BrowserAddressLayoutHost {
  static int checks;
  static void check(boolean value,String message){if(!value)throw new AssertionError(message);checks++;}
  /* PRODUCTION_ROW */

  static BrowserAddressRow row(String text,float fontScale,float density){
    Context context=new Context(density);Button address=new Button(context,text,fontScale);
    address.setPadding(Math.round(12*density),Math.round(8*density),Math.round(12*density),Math.round(8*density));
    BrowserAddressRow row=new BrowserAddressRow(context,address,new Button(context,"",fontScale),
      new Button(context,"",fontScale),new Button(context,"",fontScale),new Button(context,"",fontScale));
    row.setPadding(0,Math.round(3*density),0,Math.round(7*density));return row;
  }
  static void measure(BrowserAddressRow row,int width){
    row.measure(View.MeasureSpec.makeMeasureSpec(width,View.MeasureSpec.EXACTLY),
      View.MeasureSpec.makeMeasureSpec(4000,View.MeasureSpec.AT_MOST));
    row.layout(0,0,row.getMeasuredWidth(),row.getMeasuredHeight());
  }
  static void geometry(BrowserAddressRow row,boolean stacked){
    check(row.stacked==stacked,"Expected inline or stacked mode");
    int action=Math.round(48*row.getResources().getDisplayMetrics().density);
    int inner=row.getWidth()-row.getPaddingLeft()-row.getPaddingRight();
    check(row.getChildCount()==5,"All five original button objects remain attached");
    check(row.address.getWidth()==(stacked?inner:inner-4*action),"Address receives the complete available row width");
    check(row.address.getWidth()>=row.readableAddressWidth(),"Measured authority and ellipsis remain recognizable");
    int previousRight=-1;
    for(Button button:row.actions){
      check(button.getWidth()==action&&button.getHeight()==action,"Every action retains a 48dp square target");
      check(button.getTop()==row.actions[0].getTop(),"Actions stay together on one aligned row");
      check(button.getLeft()>=previousRight,"History refresh and home stay ordered without overlap");
      previousRight=button.getRight();
    }
    check(row.address.getTop()>=row.getPaddingTop(),"Address stays within top padding");
    check(Math.max(row.address.getBottom(),row.actions[0].getBottom())<=row.getHeight()-row.getPaddingBottom(),"Natural row height contains complete controls");
    if(stacked){
      check(row.address.getBottom()+Math.round(4*row.getResources().getDisplayMetrics().density)==row.actions[0].getTop(),"Stacked address and actions have a separate gap");
      check(row.address.getLeft()==row.actions[0].getLeft()&&row.address.getRight()==row.actions[3].getRight(),"Stacked address spans the entire action row");
    }else{
      check(row.actions[1].getRight()==row.address.getLeft()&&row.address.getRight()==row.actions[2].getLeft(),"Inline address remains between history and page actions");
      check(Math.abs(row.address.getTop()+row.address.getBottom()-row.actions[0].getTop()-row.actions[0].getBottom())<=1,"Inline controls are vertically centered");
    }
  }
  public static void main(String[] args){
    // The outer toolbar uses 16dp padding on each side: 412 -> 380, 320 -> 288.
    BrowserAddressRow normal=row("chatgpt.com/c/"+"a".repeat(180),1,1);
    measure(normal,380);geometry(normal,false);
    BrowserAddressRow narrow=row("chatgpt.com/c/"+"a".repeat(180),1.6f,1);
    measure(narrow,288);geometry(narrow,true);
    check(narrow.address.getWidth()>=narrow.address.getPaint().measureText("chatgpt.com…")+24,"320dp enlarged ChatGPT host fits without relying on XML full text");
    Button[] identities=narrow.actions.clone();Button address=narrow.address;
    int height=narrow.getHeight(),hierarchy=narrow.hierarchyWrites,requests=narrow.layoutRequests,invalidates=narrow.invalidations;
    float font=narrow.address.getPaint().textSize;
    for(int i=0;i<100;i++)measure(narrow,288);
    check(narrow.getHeight()==height,"Repeated measurement stabilizes at the same height");
    check(narrow.hierarchyWrites==hierarchy&&narrow.layoutRequests==requests&&narrow.invalidations==invalidates,"Repeated measure and layout cause no hierarchy or invalidation churn");
    check(narrow.address==address&&narrow.address.getPaint().textSize==font,"The original address button and system font size are preserved");
    for(int i=0;i<identities.length;i++)check(narrow.actions[i]==identities[i],"Original control identity is preserved");
    measure(narrow,380);geometry(narrow,false);measure(narrow,288);geometry(narrow,true);
    BrowserAddressRow largest=row("chatgpt.com/c/example",2,3);measure(largest,864);geometry(largest,true);
    check(largest.address.getHeight()>=Math.ceil(18*2*3)+48,"Large native text metrics determine address height");
    BrowserAddressRow https=row("chatgpt.com/"+"path".repeat(100),1.6f,1);
    measure(https,380);geometry(https,false);
    BrowserAddressRow http=row("http://chatgpt.com/"+"path".repeat(100),1.6f,1);
    measure(http,380);geometry(http,true);
    check(http.readableAddressWidth()>https.readableAddressWidth(),"Visible HTTP scheme is included in the hostname budget");
    BrowserAddressRow query=row("chatgpt.com?"+"query".repeat(100),1,1);measure(query,380);geometry(query,false);
    BrowserAddressRow fragment=row("chatgpt.com#"+"fragment".repeat(100),1,1);measure(fragment,380);geometry(fragment,false);
    BrowserAddressRow density=row("chatgpt.com/c/example",1,3);measure(density,1140);geometry(density,false);
    System.out.println("{\"checks\":"+checks+",\"actualAndroidExecution\":false,\"actualGlyphRendering\":false,\"productionMeasureAndLayoutExecuted\":true}");
  }
}

class Context {final Resources resources;Context(float density){resources=new Resources(density);}}
class Resources {final DisplayMetrics metrics;Resources(float density){metrics=new DisplayMetrics(density);}DisplayMetrics getDisplayMetrics(){return metrics;}}
class DisplayMetrics {final float density;DisplayMetrics(float density){this.density=density;}}
class View {
  static final class MeasureSpec {
    static final int UNSPECIFIED=0,EXACTLY=1,AT_MOST=2;
    static int makeMeasureSpec(int size,int mode){return size*4+mode;}
    static int getSize(int spec){return spec/4;}static int getMode(int spec){return spec%4;}
  }
  final Context context;int measuredWidth,measuredHeight,left,top,right,bottom,padLeft,padTop,padRight,padBottom;
  int layoutRequests,invalidations;
  View(Context context){this.context=context;}
  Resources getResources(){return context.resources;}
  static int resolveSize(int size,int spec){return MeasureSpec.getMode(spec)==MeasureSpec.EXACTLY?MeasureSpec.getSize(spec):MeasureSpec.getMode(spec)==MeasureSpec.AT_MOST?Math.min(size,MeasureSpec.getSize(spec)):size;}
  void measure(int width,int height){onMeasure(width,height);}
  protected void onMeasure(int width,int height){setMeasuredDimension(MeasureSpec.getSize(width),MeasureSpec.getSize(height));}
  protected void setMeasuredDimension(int width,int height){measuredWidth=width;measuredHeight=height;}
  void layout(int l,int t,int r,int b){boolean changed=left!=l||top!=t||right!=r||bottom!=b;left=l;top=t;right=r;bottom=b;onLayout(changed,l,t,r,b);}
  protected void onLayout(boolean changed,int l,int t,int r,int b){}
  void requestLayout(){layoutRequests++;}void invalidate(){invalidations++;}
  int getMeasuredWidth(){return measuredWidth;}int getMeasuredHeight(){return measuredHeight;}
  int getWidth(){return right-left;}int getHeight(){return bottom-top;}
  int getLeft(){return left;}int getTop(){return top;}int getRight(){return right;}int getBottom(){return bottom;}
  int getPaddingLeft(){return padLeft;}int getPaddingTop(){return padTop;}int getPaddingRight(){return padRight;}int getPaddingBottom(){return padBottom;}
  void setPadding(int l,int t,int r,int b){padLeft=l;padTop=t;padRight=r;padBottom=b;}
}
class ViewGroup extends View {
  final ArrayList<View> children=new ArrayList<>();int hierarchyWrites;
  ViewGroup(Context context){super(context);}void addView(View child){children.add(child);hierarchyWrites++;}int getChildCount(){return children.size();}
}
class Paint {
  final float textSize;Paint(float textSize){this.textSize=textSize;}
  float measureText(String text){return text.length()*textSize/2;}
}
class Button extends View {
  final String text;final Paint paint;final float fontScale;
  Button(Context context,String text,float scale){super(context);this.text=text;this.fontScale=scale;paint=new Paint(14*scale*getResources().getDisplayMetrics().density);}
  CharSequence getText(){return text;}Paint getPaint(){return paint;}
  int getCompoundPaddingLeft(){return getPaddingLeft();}int getCompoundPaddingRight(){return getPaddingRight();}
  @Override protected void onMeasure(int width,int height){
    float density=getResources().getDisplayMetrics().density;
    int natural=Math.max(Math.round(48*density),(int)Math.ceil(18*fontScale*density)+getPaddingTop()+getPaddingBottom());
    setMeasuredDimension(resolveSize(0,width),resolveSize(natural,height));
  }
}

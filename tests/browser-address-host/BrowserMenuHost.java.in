package local.pocketchat;

import java.util.ArrayList;
import java.util.Arrays;
import java.util.LinkedHashMap;
import java.util.List;
import java.util.Map;

/** Exact production menu assembly/callbacks on explicit JVM UI boundaries. */
public final class BrowserMenuHost {
  static int checks;
  static boolean extraActions;
  static void check(String message,boolean value){if(!value)throw new AssertionError(message);checks++;}

  static final class Button {
    String title;final Runnable action;boolean enabled=true;float alpha=1;
    android.graphics.drawable.Drawable[] icons=new android.graphics.drawable.Drawable[4];
    Button(String title,Runnable action){this.title=title;this.action=action;}
    void setEnabled(boolean enabled){this.enabled=enabled;}
    void click(){if(enabled)action.run();}
    void setAlpha(float value){alpha=value;}void setText(String value){title=value;}String getText(){return title;}
    void setContentDescription(String value){check("Page action label remains accessible",title.equals(value));}
    android.graphics.drawable.Drawable[] getCompoundDrawables(){return icons;}
    void setCompoundDrawables(android.graphics.drawable.Drawable l,android.graphics.drawable.Drawable t,android.graphics.drawable.Drawable r,android.graphics.drawable.Drawable b){icons=new android.graphics.drawable.Drawable[]{l,t,r,b};}
    void invalidate(){}void setTextColor(int value){}void setTextSize(int value){}void setGravity(int value){}
    void setSingleLine(boolean value){}void setMaxLines(int value){}void setMinWidth(int value){}void setMinimumWidth(int value){}
    void setMinHeight(int value){}void setMinimumHeight(int value){}void setPadding(int l,int t,int r,int b){}void setCompoundDrawablePadding(int value){}
  }
  static final class Gravity {static final int CENTER=17;}
  static final class Ui {static final class Icon extends android.graphics.drawable.Drawable {String name;Icon(String name,int color){this.name=name;}void setBounds(int l,int t,int r,int b){}}}
  static final class ReferenceUi {
    static final int TEXT=1;static int dp(MainActivity a,int value){return value;}static void readable(Button button){}
    static Button link(MainActivity a,String label,Runnable run){return new Button(label,run);}
    static final class Modal {
      static Modal latest;final MainActivity owner;final String title;
      final List<Button> actions=new ArrayList<>();boolean sheet,shown;int dismisses,statusRows;
      java.util.function.Consumer<Modal> dismissed;
      Modal(MainActivity owner,String title){this.owner=owner;this.title=title;latest=this;}
      Modal asSheet(){sheet=true;return this;}
      void show(){shown=true;}
      void dismiss(){shown=false;dismisses++;owner.events.add("dismiss");if(dismissed!=null)dismissed.accept(this);}
      void setOnDismissListener(java.util.function.Consumer<Modal> run){dismissed=run;}
    }
    static Button menuAction(Modal dialog,String title,Runnable action){
      Button button=new Button(title,action);dialog.actions.add(button);return button;
    }
  }
  static final class DesignChrome {void addMenuStatus(ReferenceUi.Modal d){d.statusRows++;}}
  static final class Privacy {boolean desktop;}
  static final class Session {final Privacy privacy=new Privacy();boolean websiteConnectionIssue,replyStalled,navigating;String pageError="";}
  static final class Web {final MainActivity owner;Web(MainActivity owner){this.owner=owner;}String url="https://chatgpt.com/c/preserved";String getUrl(){return url;}boolean hasWebsitePages(){return extraActions;}boolean canGoBack(){return owner.backAvailable;}}
  static final class AppHub {
    static final int DOWNLOADS=3,SETTINGS=4;final MainActivity owner;
    AppHub(MainActivity owner){this.owner=owner;}
    void select(int page){owner.called(page==DOWNLOADS?"downloads":page==SETTINGS?"settings":"unknown-page");}
    void networkFor(int slot){owner.called("network:"+slot);}
  }
  static final class Profiles {static int slot(MainActivity a){return 7;}}
  static final class GeckoAddressUi {
    static boolean available(MainActivity a){return !a.destroyed&&!a.finishing;}
    static boolean canForward(MainActivity a){return a.forwardAvailable;}
    static void show(MainActivity a){a.called("address");}
    static void home(MainActivity a){a.called("home");}
    static void closeSites(MainActivity a){a.called("close-sites");}
  }
  static final class BrowserReadingPolicy {static boolean chat(String url){return extraActions;}}
  static final class LoginPagePolicy {static boolean google(String url){return extraActions;}}
  static final class ActionSearchUi {static void show(MainActivity a){a.called("search");}}
  static final class EnvironmentSwitcherUi {static void show(MainActivity a){a.called("switch-environment");}}
  static final class BrowserActivity {static void resume(MainActivity a){a.called("chromium");}}
  static final class BrowserSettingsUi {static void show(MainActivity a){a.called("browser-settings");}}
  static final class BrowserReadingUi {static void show(MainActivity a){a.called("zoom");}}
  static final class PageConnectionUi {static void show(MainActivity a){a.called("recover");}}
  static final class EnvironmentEditorUi {static final int BROWSER=5;static void show(MainActivity a){a.called("edit-environment");}static void editTab(MainActivity a,int tab){check("Page display uses the actual browser tab",tab==BROWSER);a.called("display");}}
  static final class SitePermissionsUi {static void show(MainActivity a){a.called("permissions");}}
  static final class ExitIpPageUi {static void open(MainActivity a){a.called("exit-ip");}}
  static final class ProfileUi {static void manage(MainActivity a){a.called("manage-environments");}}
  static final class LocalDraftsUi {static void show(MainActivity a){a.called("draft-rescue");}}
  static final class LocalHistoryUi {static void show(MainActivity a){a.called("offline-history");}}
  static final class LoginHelpUi {static void show(MainActivity a){a.called("login-help");}}
  static final class ClipData {
    final String value;ClipData(String value){this.value=value;}
    static ClipData newPlainText(String label,String value){return new ClipData(value);}
  }
  static final class ClipboardManager {
    final MainActivity owner;ClipboardManager(MainActivity owner){this.owner=owner;}
    void setPrimaryClip(ClipData data){owner.called("copy:"+data.value);}
  }
  static final class Toast {
    static final int LENGTH_SHORT=0;
    static Toast makeText(MainActivity a,String message,int duration){return new Toast();}
    void show(){}
  }
  static final class MainActivity {
    static final String CLIPBOARD_SERVICE="clipboard";
    final List<String> events=new ArrayList<>();final DesignChrome designChrome=new DesignChrome();
    final AppHub hub=new AppHub(this);final Web remote=new Web(this);final Session session=new Session();
    boolean focusReading,backAvailable,forwardAvailable,destroyed,finishing;BrowserToolsUi toolsPanel;
    boolean isFinishing(){return finishing;}boolean isDestroyed(){return destroyed;}
    Object getSystemService(String service){return new ClipboardManager(this);}
    void called(String value){events.add(value);}
    void browserHistory(int direction){called("history:"+direction);}
    void setFocusReading(boolean reading){focusReading=reading;called("reading:"+reading);}
    void requestReload(){called("reload");}
    void browserReloadOrStop(){called(session.navigating?"stop":"reload");}
    void copyLegacyDraft(){called("save-draft");}
    /* PRODUCTION_MENU */
    /* PRODUCTION_TOOLS */
    /* PRODUCTION_OPTION */
  }

  /** UI construction is controlled; all production action/state methods execute. */
  static final class BrowserToolsUi {
    final MainActivity activity;final ReferenceUi.Modal panel;final ActionGrid navigation,tools;
    Button backButton,forwardButton,reloadButton;
    static final class ActionGrid {final ReferenceUi.Modal panel;ActionGrid(ReferenceUi.Modal panel){this.panel=panel;}void addView(Button button){panel.actions.add(button);}}
    BrowserToolsUi(MainActivity a,String description){activity=a;panel=new ReferenceUi.Modal(a,"网页工具").asSheet();navigation=new ActionGrid(panel);tools=new ActionGrid(panel);}
    /* PRODUCTION_TOOL_ACTIONS */
    void show(){panel.show();}
  }

  static LinkedHashMap<String,String> expected(boolean tools,boolean reading,boolean loading){
    LinkedHashMap<String,String> rows=new LinkedHashMap<>();
    if(tools){
      rows.put("后退","history:-1");rows.put("前进","history:1");rows.put(loading?"停止加载":"刷新网页",loading?"stop":"reload");
      rows.put("复制当前网址","copy:https://chatgpt.com/c/preserved");
      rows.put(reading?"退出专注阅读":"进入专注阅读","reading:"+!reading);
      rows.put("网页显示方式","display");rows.put("站点权限","permissions");
      if(extraActions){rows.put("网页缩放","zoom");rows.put("恢复网页连接","recover");rows.put("登录帮助","login-help");}
      return rows;
    }
    rows.put("下载管理","downloads");rows.put("当前环境网络","network:7");
    rows.put("管理全部环境","manage-environments");rows.put("应用设置","settings");
    rows.put("编辑当前环境","edit-environment");rows.put("浏览器与启动偏好","browser-settings");
    rows.put("搜索操作","search");rows.put("切换到 Chromium 浏览器","chromium");
    rows.put("查询当前环境 IP","exit-ip");rows.put("暂存草稿","save-draft");
    rows.put("草稿救援","draft-rescue");rows.put("离线会话检索","offline-history");
    return rows;
  }
  static MainActivity activity(boolean tools,boolean reading,boolean back,boolean forward,boolean loading){
    MainActivity a=new MainActivity();a.focusReading=reading;a.backAvailable=back;a.forwardAvailable=forward;a.session.navigating=loading;
    a.session.privacy.desktop=extraActions;a.session.websiteConnectionIssue=extraActions;
    if(tools)a.toolsSheet();else a.moreSheet();return a;
  }
  public static void main(String[] args){
    for(boolean tools:new boolean[]{false,true})for(boolean extras:new boolean[]{false,true})for(boolean reading:new boolean[]{false,true})for(boolean back:new boolean[]{false,true})for(boolean forward:new boolean[]{false,true})for(boolean loading:new boolean[]{false,true}){
      extraActions=extras;MainActivity a=activity(tools,reading,back,forward,loading);ReferenceUi.Modal dialog=ReferenceUi.Modal.latest;
      check("Actual browser menu remains a shown sheet",dialog.shown&&dialog.sheet&&dialog.title.equals(tools?"网页工具":"浏览器菜单"));
      check("Current environment status remains in the menu",dialog.statusRows==(tools?0:1));
      Map<String,String> expected=expected(tools,reading,loading);List<String> titles=new ArrayList<>();
      for(Button button:dialog.actions)titles.add(button.title);
      check("Every declared action remains exactly once in its actual panel",titles.size()==expected.size()&&new java.util.HashSet<>(titles).equals(expected.keySet()));
      check("Common browser and workspace actions precede secondary options",titles.subList(0,tools?3:4).equals(new ArrayList<>(expected.keySet()).subList(0,tools?3:4)));
      check("Opening the menu does not perform any action",a.events.isEmpty());
      for(Map.Entry<String,String> entry:expected.entrySet()){
        a=activity(tools,reading,back,forward,loading);dialog=ReferenceUi.Modal.latest;Button found=null;
        for(Button button:dialog.actions)if(button.title.equals(entry.getKey()))found=button;
        check("The real forward control reflects native history",!entry.getKey().equals("前进")||found.enabled==forward);
        check("The real back control reflects native history",!entry.getKey().equals("后退")||found.enabled==back);
        check("Other original actions remain enabled",entry.getKey().equals("前进")||entry.getKey().equals("后退")||found.enabled);
        found.click();
        if(entry.getKey().equals("前进")&&!forward||entry.getKey().equals("后退")&&!back){
          check("Disabled history does not dismiss or navigate",a.events.isEmpty()&&dialog.shown&&dialog.dismisses==0);
        }else{
          check("Every callback dismisses before its original action: "+entry.getKey(),a.events.equals(Arrays.asList("dismiss",entry.getValue()))&&!dialog.shown&&dialog.dismisses==1);
          if(tools)check("Dismissed page tools release their activity reference",a.toolsPanel==null);
        }
      }
      if(tools){
        a=activity(true,reading,back,forward,loading);BrowserToolsUi pageTools=a.toolsPanel;
        pageTools.navigationState(!back,!forward,!loading);
        check("Open tool history states update from native capabilities",pageTools.backButton.enabled==!back&&pageTools.forwardButton.enabled==!forward);
        check("Open tool loading text follows the real current state",pageTools.reloadButton.title.equals(!loading?"停止加载":"刷新网页"));
        check("Open tool loading icon follows the real current state",((Ui.Icon)pageTools.reloadButton.icons[1]).name.equals(!loading?"close":"refresh"));
        a.destroyed=true;pageTools.reloadButton.click();check("Destroyed activity dismisses without executing a page action",a.events.equals(Arrays.asList("dismiss")));
      }
    }
    System.out.println("{\"checks\":"+checks+",\"actualAndroidExecution\":false}");
  }
}

package local.pocketchat;

import android.content.Context;
import android.content.SharedPreferences;
import android.database.sqlite.SQLiteDatabase;
import java.nio.file.*;
import java.util.*;
import org.json.*;

/** Actual persistence methods; only Android storage, service and scheduling edges are modeled. */
public final class ReplyTaskPersistenceHost {
  static final String URL="https://chatgpt.com/c/persisted-reply";
  static final JSONArray checks=new JSONArray();
  static Path root;static int caseNumber;
  interface Scenario {void run()throws Exception;}
  static void scenario(String name,Scenario action){try{action.run();}catch(Throwable error){checks.put(J.obj("name",name+" must not throw","pass",false,"error",error.toString()));}}
  static void check(String name,boolean pass){checks.put(J.obj("name",name,"pass",pass));}
  static ChatSession fresh()throws Exception{return new ChatSession(new Context(root.resolve("case-"+(++caseNumber))));}
  static JSONObject install(ChatSession s,String id){
    s.deliveries.begin(URL,"original prompt",new JSONArray(),"web",id);
    s.deliveries.update(id,"awaiting","waiting",true,"id:user",URL);
    JSONObject job=J.obj("id",id,"kind","web","engine","gecko","confirmed",true,"confirmedUrl",URL,
      "expectedUrl",URL,"prompt","original prompt","userKey","id:user","attachmentNames",new JSONArray(),"attempted",true);
    if(!s.prefs.edit().putString("pending",job.toString()).commit())throw new AssertionError("Fixture installation failed");
    s.pending=job;s.activeDeliveryId=id;s.webWorkGeneration++;s.context.serviceJob=id;return job;
  }
  static String state(ChatSession s,String id){JSONObject receipt=s.deliveries.get(id);return receipt==null?"":receipt.optString("state");}
  static String diskPending(ChatSession s){return s.prefs.diskString("pending","");}
  static void finish(ChatSession s,JSONObject job,String action){
    if(action.equals("completed"))s.completeReply(job,J.obj("url",URL,"userKey","id:user"));
    else if(action.equals("stopped"))s.webObserver.finishStopped(job);
    else if(action.equals("uncertain"))s.abandonWait();
    else throw new AssertionError(action);
  }
  static ChatSession reopen(ChatSession previous)throws Exception{
    ChatSession next=new ChatSession(new Context(previous.context.root));next.webObserver.restorePending();return next;
  }
  static Object updateResult(DeliveryStore store,String id,String state,String detail)throws Exception{
    return DeliveryStore.class.getDeclaredMethod("update",String.class,String.class,String.class,boolean.class,String.class,String.class)
      .invoke(store,id,state,detail,true,"id:user",URL);
  }

  static void successfulFinalization(){
    for(String action:new String[]{"completed","stopped","uncertain"})scenario("Successful "+action,()->{
      ChatSession s=fresh();JSONObject job=install(s,"task-a");finish(s,job,action);
      check(action+" persists its original delivery state",state(s,"task-a").equals(action));
      check(action+" clears current and durable pending only after writing its receipt",s.pending==null&&s.activeDeliveryId.isEmpty()&&diskPending(s).isEmpty());
      check(action+" ends the matching service once",s.context.endedJobs.equals(Arrays.asList("task-a")));
      check(action+" completion notification boundary is preserved",s.context.completionCalls.size()==(action.equals("completed")?1:0));
      check(action+" preserves the delivery schema",s.deliveries.get("task-a").length()==11);
      if(action.equals("completed")){
        check("Completion persists the existing lastCompletedId and URL keys",s.prefs.diskString("lastCompletedId","").equals("task-a")&&s.prefs.diskString("url","").equals(URL));
        int commits=s.prefs.commits;s.completeReply(job,J.obj("url",URL,"userKey","id:user"));
        check("Repeated callback for a retired task cannot finalize it twice",s.prefs.commits==commits&&s.context.completionCalls.size()==1&&s.context.endedJobs.size()==1);
      }
      if(action.equals("uncertain"))check("Abandonment still means unverified sending rather than stopped",s.deliveries.get("task-a").optString("detail").equals("已解除等待，发送结果仍需在网页核对"));
    });
  }

  static void databaseFailures(){
    for(String action:new String[]{"completed","stopped","uncertain"})for(String failure:new String[]{"throw","missing-row","zero-update"})scenario(action+" "+failure,()->{
      ChatSession s=fresh();JSONObject job=install(s,"task-a");String bytes=diskPending(s);int commits=s.prefs.commits;
      SQLiteDatabase db=s.deliveries.getWritableDatabase();
      if(failure.equals("throw"))db.failWrites=1;else if(failure.equals("missing-row"))db.removeForTest("task-a");else db.zeroNextUpdate=true;
      finish(s,job,action);
      check(action+" "+failure+" preserves the exact pending task",s.pending==job&&s.activeDeliveryId.equals("task-a")&&diskPending(s).equals(bytes)&&s.prefs.commits==commits);
      check(action+" "+failure+" cannot announce completion or stop a service",s.context.completionCalls.isEmpty()&&s.context.endedJobs.isEmpty()&&s.context.serviceJob.equals("task-a"));
      check(action+" "+failure+" reports a failed save",s.status.contains("失败"));
    });
    scenario("Delivery progress deduplication",()->{
      ChatSession s=fresh();install(s,"task-a");s.deliveries.getWritableDatabase().zeroNextUpdate=true;
      s.delivery("task-a","sending","progress",true,"id:user",URL);
      check("A zero-row progress update does not become a successful deduplication signature",s.lastDeliverySignature.isEmpty());
      s.delivery("task-a","sending","progress",true,"id:user",URL);
      check("The same progress can be retried after a zero-row update",state(s,"task-a").equals("sending")&&!s.lastDeliverySignature.isEmpty());
    });
    scenario("Terminal write bypasses progress cache",()->{
      ChatSession s=fresh();JSONObject job=install(s,"task-a");
      s.lastDeliverySignature="task-a|completed|回复已完成|true|id:user|"+URL;
      s.deliveries.getWritableDatabase().failWrites=1;finish(s,job,"completed");
      check("A matching progress signature is never proof of terminal durability",s.pending==job&&state(s,"task-a").equals("awaiting")&&s.context.completionCalls.isEmpty());
    });
    scenario("Store update acknowledgement",()->{
      ChatSession s=fresh();install(s,"task-a");long revision=s.deliveries.revision;
      check("Unchanged existing row acknowledges durable state",Boolean.TRUE.equals(updateResult(s.deliveries,"task-a","awaiting","waiting"))&&s.deliveries.revision==revision);
      check("Missing row cannot acknowledge an update",Boolean.FALSE.equals(updateResult(s.deliveries,"absent","completed","done"))&&s.deliveries.revision==revision);
      s.deliveries.getWritableDatabase().zeroNextUpdate=true;
      check("Zero affected rows cannot advance revision or acknowledge an update",Boolean.FALSE.equals(updateResult(s.deliveries,"task-a","completed","done"))&&s.deliveries.revision==revision);
      check("One changed row acknowledges the update and advances revision",Boolean.TRUE.equals(updateResult(s.deliveries,"task-a","completed","done"))&&s.deliveries.revision==revision+1);
    });
  }

  static void preferenceFailures(){
    for(String action:new String[]{"completed","stopped"})for(SharedPreferences.Failure failure:new SharedPreferences.Failure[]{SharedPreferences.Failure.BEFORE_MEMORY,SharedPreferences.Failure.AFTER_MEMORY,SharedPreferences.Failure.THROW_AFTER_MEMORY})scenario(action+" prefs "+failure,()->{
      ChatSession s=fresh();JSONObject job=install(s,"task-a");String bytes=diskPending(s);s.prefs.nextFailure=failure;finish(s,job,action);
      check(action+" "+failure+" keeps the durable receipt authoritative",state(s,"task-a").equals(action)&&s.pending==null&&s.activeDeliveryId.isEmpty()&&diskPending(s).equals(bytes));
      check(action+" "+failure+" reports incomplete preference cleanup",s.status.contains("清理")&&(s.status.contains("未完成")||s.status.contains("失败")));
      check(action+" "+failure+" retains the correct notification and service effects",s.context.endedJobs.equals(Arrays.asList("task-a"))&&s.context.completionCalls.size()==(action.equals("completed")?1:0));
      ChatSession cold=reopen(s);
      check(action+" "+failure+" cold restore cannot resume a terminal task",cold.pending==null&&diskPending(cold).isEmpty()&&state(cold,"task-a").equals(action));
      check(action+" "+failure+" recovery notification remains deferred",cold.context.completionCalls.isEmpty()&&cold.handler.tasks.size()==(action.equals("completed")?1:0));
      cold.handler.drain();
      check(action+" "+failure+" recovery offers only completed receipts to the existing notice ledger",cold.context.completionCalls.size()==(action.equals("completed")?1:0)&&cold.context.endedJobs.isEmpty());
    });
    for(SharedPreferences.Failure failure:new SharedPreferences.Failure[]{SharedPreferences.Failure.BEFORE_MEMORY,SharedPreferences.Failure.AFTER_MEMORY,SharedPreferences.Failure.THROW_AFTER_MEMORY})scenario("Abandon prefs "+failure,()->{
      ChatSession s=fresh();JSONObject job=install(s,"task-a");String bytes=diskPending(s);s.prefs.nextFailure=failure;finish(s,job,"uncertain");
      check("Abandon "+failure+" retains the current task until cleanup is durable",s.pending==job&&s.activeDeliveryId.equals("task-a")&&diskPending(s).equals(bytes)&&state(s,"task-a").equals("uncertain"));
      check("Abandon "+failure+" does not falsely stop the service or claim release",s.context.endedJobs.isEmpty()&&s.context.completionCalls.isEmpty()&&s.status.contains("失败"));
      ChatSession cold=reopen(s);check("Abandon "+failure+" cold restore agrees that release did not finish",cold.pending!=null&&cold.pending.optString("id").equals("task-a"));
      s.abandonWait();check("Abandon "+failure+" can retry cleanup without changing uncertain meaning",s.pending==null&&diskPending(s).isEmpty()&&state(s,"task-a").equals("uncertain")&&s.context.endedJobs.size()==1);
    });
    scenario("Repeated recovery cleanup failure",()->{
      ChatSession s=fresh();JSONObject job=install(s,"task-a");s.prefs.nextFailure=SharedPreferences.Failure.AFTER_MEMORY;finish(s,job,"completed");
      ChatSession cold=new ChatSession(new Context(s.context.root));cold.prefs.nextFailure=SharedPreferences.Failure.AFTER_MEMORY;cold.webObserver.restorePending();
      check("Recovery retires a terminal task even when cached pending disappears before a failed disk write",cold.pending==null&&cold.prefs.getString("pending","").isEmpty()&&!diskPending(cold).isEmpty()&&cold.status.contains("清理"));
      ChatSession next=reopen(cold);check("A subsequent cold restore retries durable cleanup rather than trusting the old cache",next.pending==null&&diskPending(next).isEmpty());
    });
  }

  static void reentrantOwnership(){
    for(String action:new String[]{"completed","stopped","uncertain"})for(SharedPreferences.Failure failure:new SharedPreferences.Failure[]{SharedPreferences.Failure.NONE,SharedPreferences.Failure.AFTER_MEMORY,SharedPreferences.Failure.THROW_AFTER_MEMORY})scenario(action+" listener "+failure,()->{
      ChatSession s=fresh();JSONObject original=install(s,"task-a");JSONObject[] newer={null};
      s.prefs.nextFailure=failure;s.prefs.onCommit=()->{newer[0]=install(s,"task-b");s.status="new task status";};finish(s,original,action);
      check(action+" "+failure+" listener keeps the newer task and durable cursor",s.pending==newer[0]&&s.activeDeliveryId.equals("task-b")&&J.parse(diskPending(s)).optString("id").equals("task-b"));
      check(action+" "+failure+" listener cannot stop or relabel the newer service",s.context.serviceJob.equals("task-b")&&s.context.endedJobs.isEmpty()&&s.status.equals("new task status"));
    });
    scenario("Completion boundary reentrancy",()->{
      ChatSession s=fresh();JSONObject original=install(s,"task-a");JSONObject[] newer={null};s.context.onCompleted=()->{newer[0]=install(s,"task-b");s.status="new task status";};finish(s,original,"completed");
      check("A completion notification callback cannot let the old finalizer stop a newer task",s.pending==newer[0]&&s.context.serviceJob.equals("task-b")&&s.context.endedJobs.isEmpty()&&s.status.equals("new task status")&&s.wakes==0);
    });
    for(String action:new String[]{"completed","stopped","uncertain"})scenario(action+" service-end reentrancy",()->{
      ChatSession s=fresh();JSONObject original=install(s,"task-a");JSONObject[] newer={null};s.context.onEnd=()->{newer[0]=install(s,"task-b");s.status="new task status";};finish(s,original,action);
      check(action+" service-end callback cannot overwrite or wake on behalf of the newer task",s.pending==newer[0]&&s.context.serviceJob.equals("task-b")&&s.status.equals("new task status")&&s.wakes==0);
    });
    for(String action:new String[]{"completed","stopped"})scenario(action+" stale explicit callback",()->{
      ChatSession s=fresh();JSONObject old=install(s,"task-a"),newer=install(s,"task-b");int commits=s.prefs.commits;finish(s,old,action);
      check(action+" stale callback performs no writes or task effects",s.pending==newer&&s.prefs.commits==commits&&state(s,"task-a").equals("awaiting")&&s.context.endedJobs.isEmpty()&&s.context.completionCalls.isEmpty());
    });
    scenario("Recovery listener reentrancy",()->{
      ChatSession s=fresh();install(s,"task-a");s.deliveries.update("task-a","completed","回复已完成",true,"id:user",URL);
      ChatSession cold=new ChatSession(new Context(s.context.root));JSONObject[] newer={null};cold.prefs.onCommit=()->{newer[0]=install(cold,"task-b");cold.status="new task status";};cold.webObserver.restorePending();cold.handler.drain();
      check("Recovery preference listener keeps a newly installed task",cold.pending==newer[0]&&cold.activeDeliveryId.equals("task-b")&&cold.context.serviceJob.equals("task-b")&&cold.context.endedJobs.isEmpty()&&cold.status.equals("new task status"));
    });
  }

  public static void main(String[] args)throws Exception{
    root=Paths.get(args[0]);successfulFinalization();databaseFailures();preferenceFailures();reentrantOwnership();
    int passed=0;for(int i=0;i<checks.length();i++)if(checks.getJSONObject(i).getBoolean("pass"))passed++;
    System.out.println(J.obj("status",passed==checks.length()?"passed":"failed","passed",passed,"total",checks.length(),"checks",checks,
      "actualAndroidExecution",false,"actualSQLiteExecution",false,"actualNotificationExecution",false,"actualWebsiteExecution",false,
      "hostFileDurability",true,"globalExactlyOnceClaim",false));
    if(passed!=checks.length())System.exit(1);
  }
}

class ChatSession {
  final Context context;final SharedPreferences prefs;final DeliveryStore deliveries;final WebReplyObserver webObserver;final Queue handler=new Queue();
  final Web web=new Web();final Store webStore=new Store();JSONArray attachments=new JSONArray();JSONObject pending;
  String conversation=ReplyTaskPersistenceHost.URL,status="waiting",lastDeliverySignature="",replyHealthStatus="",activeDeliveryId="",driver="",stableReply="",resourceObserverBinding="",resourceObserverDocument="",observedReplyJob="",observedReplyUrl="",observedReplyKey="",observedReplyRevision="",observedReplyMarkdown="";
  long webWorkGeneration,webConfirmationVersion,navigationEpoch,resourceObserverEpoch,resourceObservedAt;int stableTicks,wakes;
  boolean deleted,replyStalled,submitting,operation,configurationCapture,networkReady,offline,navigating,observedReplyHasFiles,navigationDispatched=true;
  ChatSession(Context context){this.context=context;prefs=context.preferences;deliveries=new DeliveryStore(context);String bytes=prefs.getString("pending","");pending=bytes.isEmpty()?null:J.parse(bytes);deliveries.recover(pending);if(pending!=null)activeDeliveryId=pending.optString("id");webObserver=new WebReplyObserver(this);}
  boolean webPerformance(){return true;}
  void setStatus(String message){status=message;}
  void wakeDeferredBrowserSettings(){wakes++;}
  boolean replyObservationAllowed(){throw new AssertionError("No website observation expected");}
  boolean resourceBindingMatches(JSONObject event,Object port){throw new AssertionError("No bridge events expected");}
  boolean targetMatches(String url){throw new AssertionError("No navigation expected");}
  void resourceObserverRouteReady(JSONObject event,Object port){throw new AssertionError("No bridge route expected");}
  void resourceWebsiteObservation(JSONObject event,Object port){throw new AssertionError("No website event expected");}
  void wakePolling(){throw new AssertionError("Finalization must not start a fresh observation");}
  void resetReplyStability(){throw new AssertionError("Navigation archival is outside this persistence host");}
  /* CHAT_MEMBERS */
}
class Queue {final List<Runnable> tasks=new ArrayList<>();void post(Runnable task){tasks.add(task);}void drain(){int count=0;while(!tasks.isEmpty()){if(++count>20)throw new AssertionError("Unbounded scheduling");tasks.remove(0).run();}}}
class Web {final Object current=new Object();final Map<Object,Object> ports=new IdentityHashMap<>();String getUrl(){return ReplyTaskPersistenceHost.URL;}boolean resourcePage(String url){return MainActivity.chatUrl(url);}void evaluateJavascript(String code,Object callback){throw new AssertionError("Finalization must not send a website command");}}
class Store {final java.util.concurrent.Executor worker=task->{throw new AssertionError("No draft archive work expected");};}
class MainActivity {static boolean chatUrl(String url){try{return "chatgpt.com".equals(java.net.URI.create(url).getHost());}catch(Exception invalid){return false;}}}
class LocalDraftPolicy {static long revision(Context context){throw new AssertionError("Draft persistence is outside this host");}}
class DraftArchive {static DraftArchive get(Context context){throw new AssertionError("Draft persistence is outside this host");}void save(String url,String prompt,String reason,long revision){throw new AssertionError("Draft persistence is outside this host");}}
class ChatService {
  static void begin(Context context){throw new AssertionError("Finalization must not start or resend a task");}
  static void completed(Context context,String id,String url){context.completionCalls.add(id);Runnable callback=context.onCompleted;context.onCompleted=null;if(callback!=null)callback.run();}
  static void end(Context context){context.endedJobs.add(context.serviceJob);context.serviceJob="";Runnable callback=context.onEnd;context.onEnd=null;if(callback!=null)callback.run();}
}

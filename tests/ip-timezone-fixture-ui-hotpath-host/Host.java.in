package local.pocketchat;
import android.content.*;import java.io.*;import java.nio.charset.StandardCharsets;import java.nio.file.*;import java.util.*;import java.util.concurrent.*;import java.util.concurrent.atomic.*;import org.json.*;
/** Explicit host boundaries, not Android or encrypted-vault execution. */
public final class Host {
 static final String SOURCE="a".repeat(40),NONCE="b".repeat(32),OTHER="c".repeat(32),PACKAGE="local.pocketchat.test";
 static final Thread MAIN=Thread.currentThread();static IpTimeZoneFixtureApplication app;
 static final Map<String,Integer> io=new ConcurrentHashMap<>();static final List<String> checks=new ArrayList<>(),trace=Collections.synchronizedList(new ArrayList<>());
 static volatile boolean forbidMain;static int passed,loads,saves,firstProfileReads,bootstrapCalls,prepares,outerLoads,hotLookups;
 static volatile Runnable loadHook,saveHook;static volatile java.util.function.IntConsumer itemHook;
 public static void touch(String kind){io.merge(kind,1,Integer::sum);if(forbidMain&&Thread.currentThread()==MAIN)throw new AssertionError("UI context lookup performed "+kind);}
 static void check(String name,boolean yes){if(!yes)throw new AssertionError(name);passed++;checks.add(name);}
 interface Work{void run()throws Exception;}
 static void reject(String name,Work work)throws Exception{boolean denied=false;try{work.run();}catch(Exception expected){denied=true;}check(name,denied);}
 static void bg(Work work)throws Exception{AtomicReference<Throwable> failure=new AtomicReference<>();Thread t=new Thread(()->{try{work.run();}catch(Throwable e){failure.set(e);}},"declared-controller-env-io");t.start();t.join(7000);if(t.isAlive())throw new AssertionError("Background fixture load deadlocked");Throwable e=failure.get();if(e instanceof Exception)throw (Exception)e;if(e!=null)throw new AssertionError(e);}
 public static void atomicSaved(File file)throws Exception{touch("atomic-write");if(file.getName().equals(IpTimeZoneFixtureScopes.MARKER))trace.add(new JSONObject(Files.readString(file.toPath())).optString("phase"));}
 static void reset(String suffix)throws Exception{
  android.os.Looper.bindMain(MAIN);forbidMain=false;io.clear();loads=saves=firstProfileReads=bootstrapCalls=prepares=outerLoads=0;loadHook=saveHook=null;itemHook=null;trace.clear();
  app=new IpTimeZoneFixtureApplication();Context.directory=Files.createTempDirectory("fixture-ui-hotpath-").toFile();Context.application=app;Context.packageName=PACKAGE;
  android.app.Application.processName=PACKAGE+suffix;android.os.Process.uid=10200;android.os.SystemClock.now=5000;android.content.pm.PackageManager.scope="explicit-manual-system-baseline";
  ProfileCatalog.instance=new ProfileCatalog();SecretStore.records.clear();GeckoTimeZoneStore.states.clear();GeckoTimeZoneStore.monitorViolations=0;
  java.lang.reflect.Field seen=IpTimeZoneFixtureScopes.class.getDeclaredField("SEEN");seen.setAccessible(true);((Set<?>)seen.get(null)).clear();java.lang.reflect.Field installed=IpTimeZoneFixtureScopes.class.getDeclaredField("installed");installed.setAccessible(true);installed.set(null,null);
 }
 static Context context(int slot){return Profiles.context(app,slot);}
 static void hot(Context profile,String name)throws Exception{
  io.clear();int l=loads,s=saves;forbidMain=true;
  try{for(int i=0;i<1000;i++){if(profile.getApplicationContext()!=profile||app.profile(Profiles.slot(profile))!=profile)throw new AssertionError(name+" changed cached context");hotLookups+=2;}}
  finally{forbidMain=false;}
  check(name+" zero catalog/vault/filesystem/store IO",io.isEmpty()&&loads==l&&saves==s);
 }
 static void startupAndHot()throws Exception{
  reset("");app.attachBaseContext(app);app.onCreate();Context c=context(0);
  check("Explicit startup seeds manual system before controller exists",loads==1&&saves==1&&GeckoTimeZoneStore.states.get(0)!=null&&GeckoTimeZoneStore.states.get(0).spec.followsSystem());
  check("Startup writer never holds Application profile monitor",GeckoTimeZoneStore.monitorViolations==0);hot(c,"startup");
  io.clear();int l=loads,s=saves;bg(()->check("Background context uses same original object",c.getApplicationContext()==c));
  check("Background rechecks catalog even for seen identity",io.getOrDefault("catalog-identity",0)>0&&loads==l&&saves==s);
  reset(":template_fixture");app.onCreate();check("Declared legacy role retains explicit startup system seed",GeckoTimeZoneStore.states.get(0).spec.followsSystem());hot(context(0),"legacy");
 }
 static void identityTransitions()throws Exception{
  reset("");app.onCreate();Context c=context(0);EnvironmentSpec.Identity first=ProfileCatalog.instance.ids[0];
  ProfileCatalog.instance.ids[0]=new EnvironmentSpec.Identity(0,1,first.environmentId);SecretStore.records.remove(0);GeckoTimeZoneStore.states.remove(0);int before=saves;hot(c,"new generation pending");
  check("Main lookup cannot seed a new generation",saves==before&&!SecretStore.records.containsKey(0));
  trace.clear();bg(()->{GeckoTimeZoneStore.State state=GeckoTimeZoneStore.load(c);check("New generation is system before actual outer loader result",state.identity.equals(ProfileCatalog.instance.ids[0])&&state.spec.followsSystem());});
  check("New generation gets exactly one explicit system seed",saves==before+1&&GeckoTimeZoneStore.monitorViolations==0);
  check("Actual Repository setup completes before outer load transaction",trace.indexOf("fixture-write-system")>=0&&trace.indexOf("fixture-write-system")<trace.indexOf("outer-repository-ready")&&trace.indexOf("outer-repository-ready")<trace.indexOf("outer-transaction-enter")&&trace.indexOf("outer-transaction-enter")<trace.indexOf("outer-loader-body"));
  ProfileCatalog.instance.created[0]=false;ProfileCatalog.instance.deleting[0]=true;int preserved=saves;byte[] bytes=SecretStore.records.get(0).clone();
  bg(()->reject("Deleted identity cannot reach admitted actual load",()->GeckoTimeZoneStore.load(c)));check("Deletion neither recreates nor writes a record",saves==preserved&&Arrays.equals(bytes,SecretStore.records.get(0)));
  ProfileCatalog.instance.created[0]=true;ProfileCatalog.instance.deleting[0]=false;ProfileCatalog.instance.ids[0]=new EnvironmentSpec.Identity(0,2,UUID.randomUUID().toString());SecretStore.records.remove(0);GeckoTimeZoneStore.states.remove(0);hot(c,"slot reuse pending");
  bg(()->check("Reused slot receives fresh UUID before outer loader",GeckoTimeZoneStore.load(c).identity.equals(ProfileCatalog.instance.ids[0])&&GeckoTimeZoneStore.states.get(0).spec.followsSystem()));
  check("Reused slot cannot reuse old seen-owner admission",saves==preserved+1);
  reset("");app.onCreate();Context fresh=context(2);ProfileCatalog.instance.created[2]=true;ProfileCatalog.instance.db.transaction=true;
  bg(()->fresh.getApplicationContext());check("Catalog transaction defers fresh environment setup",!SecretStore.records.containsKey(2));ProfileCatalog.instance.db.transaction=false;
  bg(()->check("Deferred new environment seeds before later actual load",GeckoTimeZoneStore.load(fresh).spec.followsSystem()));
 }
 static void retainedRecords()throws Exception{
  for(String raw:new String[]{"sealed:ip:revision1","sealed:system:revision1","sealed:iana:revision7","corrupt:do-not-parse"}){
   reset("");SecretStore.records.put(0,raw.getBytes(StandardCharsets.UTF_8));app.onCreate();Context c=context(0);check("Startup preserves existing raw record "+raw,loads==0&&saves==0&&Arrays.equals(SecretStore.records.get(0),raw.getBytes(StandardCharsets.UTF_8)));
   EnvironmentSpec.Identity old=ProfileCatalog.instance.ids[0];ProfileCatalog.instance.ids[0]=new EnvironmentSpec.Identity(0,old.generation+1,old.environmentId);io.clear();bg(()->c.getApplicationContext());
   check("Fresh generation validates but never parses/rewrites existing record "+raw,io.getOrDefault("catalog-identity",0)>0&&loads==0&&saves==0&&Arrays.equals(SecretStore.records.get(0),raw.getBytes(StandardCharsets.UTF_8)));hot(c,"retained "+raw);
  }
 }
 static void markerProtection()throws Exception{
  reset(":ip_timezone_setup");app.onCreate();JSONObject proof=IpTimeZoneFixtureScopes.prepareIp(app,SOURCE,NONCE);check("Original allocator arms fresh missing profile6",proof.getBoolean("timezoneSealedRecordMissing")&&!SecretStore.records.containsKey(6));
  android.app.Application.processName=PACKAGE+":profile6";app=new IpTimeZoneFixtureApplication();Context.application=app;app.onCreate();Context c=context(6);hot(c,"armed IP");
  int saved=saves;bg(()->check("Armed slot6 retains genuine default IP on first actual load",GeckoTimeZoneStore.load(c).spec.followsIp()));check("IP marker prevents a manual fixture seed",saves==saved);
  check("Exact nonce can consume scope",IpTimeZoneFixtureScopes.requireArmed(c,SOURCE,NONCE).getString("phase").equals("armed"));reject("Foreign nonce cannot consume scope",()->IpTimeZoneFixtureScopes.requireArmed(c,SOURCE,OTHER));
  EnvironmentSpec.Identity prior=ProfileCatalog.instance.ids[6];ProfileCatalog.instance.ids[6]=new EnvironmentSpec.Identity(6,prior.generation+1,prior.environmentId);int l=outerLoads;
  bg(()->reject("Stale marker owner blocks before actual loader body",()->GeckoTimeZoneStore.load(c)));check("Stale owner performs no actual loader work",outerLoads==l&&saves==saved);
  ProfileCatalog.instance.ids[6]=prior;android.os.SystemClock.now+=IpTimeZoneFixtureScopes.MAX_AGE+1;l=outerLoads;bg(()->reject("Expired marker blocks before actual loader body",()->GeckoTimeZoneStore.load(c)));check("Expired marker performs no actual loader work",outerLoads==l&&saves==saved);
 }
 static void reentryAndInertProcesses()throws Exception{
  reset("");app.onCreate();Context c=context(0);bg(()->{synchronized(app){reject("Background access under Application monitor fails before IO",()->c.getApplicationContext());}});
  check("Recursive writer application access terminates without monitor violation",GeckoTimeZoneStore.monitorViolations==0);
  for(String suffix:new String[]{":gecko_env0_tab0_disable_art_image_",":ip_timezone_setup",":unknown"}){
   reset(suffix);app.onCreate();Context inert=context(0);io.clear();bg(()->check("Inert process keeps cached context "+suffix,inert.getApplicationContext()==inert));check("Inert process never activates catalog or store "+suffix,io.isEmpty()&&loads==0&&saves==0);
  }
 }
 public static void main(String[] args)throws Exception{startupAndHot();identityTransitions();retainedRecords();markerProtection();reentryAndInertProcesses();System.out.println(J.obj("status","passed","passed",passed,"total",passed,"checks",new JSONArray(checks),"mainLookups",hotLookups,"actualAndroidExecution",false));}
}

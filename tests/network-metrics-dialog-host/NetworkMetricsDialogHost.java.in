package local.pocketchat;

import java.util.*;

/** Explicit dialog/view/clock doubles; the complete production show method is inserted verbatim. */
public final class NetworkMetricsDialogHost {
  static int checks;
  static void require(boolean value,String message){checks++;if(!value)throw new AssertionError(message);}
  interface Click {void onClick(View view);}
  interface Shown {void onShow(AlertDialog dialog);}
  interface Dismissed {void onDismiss(AlertDialog dialog);}
  interface DialogClick {void onClick(AlertDialog dialog,int button);}
  interface Probe {void result(boolean ok,String message);}

  static class View {
    static final int VISIBLE=0,GONE=8,ACCESSIBILITY_LIVE_REGION_POLITE=1;
    View parent;String description="";int visibility=VISIBLE;boolean enabled=true;Click click;
    void setContentDescription(String value){description=value;}
    void setVisibility(int value){visibility=value;}
    void setAccessibilityLiveRegion(int value){}
    void setPadding(int l,int t,int r,int b){}
    void setOnClickListener(Click value){click=value;}
    void setEnabled(boolean value){enabled=value;}
    void performClick(){if(enabled&&click!=null)click.onClick(this);}
  }
  static class TextView extends View {
    String text="";final int color;
    TextView(MainActivity a){this(a,0);}
    TextView(MainActivity a,int color){this.color=color;}
    void setText(String value){text=value;}
    void setLineSpacing(int extra,int multiplier){}
  }
  static class Button extends TextView {Button(MainActivity a){super(a);}}
  static class Group extends View {
    final List<View> children=new ArrayList<>();
    void addView(View child){require(child.parent==null,"no live view reparenting");child.parent=this;children.add(child);}
    void addView(View child,LinearLayout.LayoutParams p){require(p.width==-1&&p.height==-2,"body actions wrap height");addView(child);}
  }
  static class LinearLayout extends Group {
    static final int VERTICAL=1;int orientation;
    LinearLayout(MainActivity a){}
    void setOrientation(int value){orientation=value;}
    static class LayoutParams {final int width,height;LayoutParams(int w,int h){width=w;height=h;}}
  }
  static class ScrollView extends Group {ScrollView(MainActivity a){}}
  static class Handler {
    final List<Runnable> pending=new ArrayList<>();int removed,posted;
    void postDelayed(Runnable runnable,long delay){require(delay==1000,"original one-second status interval");pending.add(runnable);posted++;}
    void removeCallbacks(Runnable runnable){pending.removeIf(value->value==runnable);removed++;}
    void next(){require(pending.size()==1,"one live status callback");pending.remove(0).run();}
  }
  static class Session {boolean internal=true,offline;boolean internalNetwork(){return internal;}}
  static class MainActivity {
    AlertDialog networkDialog;final Session session=new Session();final Handler handler=new Handler();
    final List<TextView> labels=new ArrayList<>();int updates,ipOpens,auditOpens,connectionOpens;
    TextView label(String value,int size,int color){TextView v=new TextView(this,color);v.setText(value);labels.add(v);return v;}
    int dp(int value){return value;}
  }
  static class Ui {static final int INK=1;}
  static class DesignUi {static final int RED=2;}
  static class SystemClock {static long now=10000;static long elapsedRealtime(){return now;}}
  static class NativeNetwork {
    static NativeNetwork current;static int gets;
    boolean measuringLatency,ready=true,starting;long lastManualProbe;int probes;Probe callback;
    static NativeNetwork get(MainActivity a){gets++;return current;}
    void measureLatency(Probe callback){this.callback=callback;probes++;}
  }
  static class AlertDialog {
    final MainActivity activity;final Map<Integer,Button> footer=new LinkedHashMap<>();
    final List<String> order=new ArrayList<>();String title;ScrollView view;boolean showing;
    Shown onShow;Dismissed onDismiss;
    AlertDialog(MainActivity a){activity=a;}
    boolean isShowing(){return showing;}
    Button getButton(int id){return footer.get(id);}
    void setOnShowListener(Shown value){onShow=value;}
    void setOnDismissListener(Dismissed value){onDismiss=value;}
    void show(){showing=true;if(onShow!=null)onShow.onShow(this);}
    void dismiss(){if(!showing)return;showing=false;order.add("dismiss");if(onDismiss!=null)onDismiss.onDismiss(this);}
  }
  static class Builder {
    final AlertDialog dialog;
    Builder(MainActivity a){dialog=new AlertDialog(a);}
    Builder setTitle(String title){dialog.title=title;return this;}
    Builder setView(ScrollView view){dialog.view=view;return this;}
    Builder action(int id,String label,DialogClick listener){
      Button button=new Button(dialog.activity);button.setText(label);button.setOnClickListener(v->{if(listener!=null)listener.onClick(dialog,id);dialog.dismiss();});
      dialog.footer.put(id,button);return this;
    }
    Builder setNegativeButton(String text,DialogClick listener){return action(-2,text,listener);}
    Builder setPositiveButton(String text,DialogClick listener){return action(-1,text,listener);}
    Builder setNeutralButton(String text,DialogClick listener){return action(-3,text,listener);}
    AlertDialog create(){return dialog;}
  }
  static class AppAppearance {static Builder dialog(MainActivity a){return new Builder(a);}}
  static class ExitIpUi {static void show(MainActivity a){a.ipOpens++;}}
  static class EnvironmentAuditUi {static void show(MainActivity a){a.auditOpens++;}}
  static class NetworkStatusUi {static void show(MainActivity a){require(a.networkDialog==null,"dismiss old dialog before opening connection details");a.connectionOpens++;}}
  static class NetworkMetricsUi {
    static int detailCalls;
    static String detail(Session session,NativeNetwork network,long wall,long elapsed){require(network==NativeNetwork.current,"same live network identity");detailCalls++;return "controlled network state";}
    static void update(MainActivity a){a.updates++;}
    /* ACTUAL_SHOW */
  }

  static Button button(LinearLayout body,String text){
    List<Button> found=new ArrayList<>();
    for(View view:body.children)if(view instanceof Button&&((Button)view).text.equals(text))found.add((Button)view);
    require(found.size()==1,"one original body action: "+text);return found.get(0);
  }
  static void run(){
    MainActivity a=new MainActivity();NativeNetwork n=new NativeNetwork();NativeNetwork.current=n;
    NetworkMetricsUi.show(a);AlertDialog d=a.networkDialog;
    require(d!=null&&d.isShowing(),"native network dialog shown");
    require(d.title.equals("网络情况"),"original native title");
    require(d.footer.keySet().equals(Collections.singleton(-2)),"only Close remains in native footer");
    require(d.getButton(-2).text.equals("关闭"),"same native negative close action");
    require(d.view.description.equals("当前环境网络详情"),"owned accessible scroll body");
    require(d.view.children.size()==1&&d.view.children.get(0) instanceof LinearLayout,"one scroll content owner");
    LinearLayout body=(LinearLayout)d.view.children.get(0);
    require(body.orientation==LinearLayout.VERTICAL,"scrollable information remains vertical");
    Button measure=button(body,"测一下延迟"),connection=button(body,"连接详情"),verify=button(body,"查看 / 核实出口 IP"),audit=button(body,"环境自检 / 查看变化");
    require(measure.description.equals("测一下网络延迟")&&connection.description.equals("查看当前网络连接详情"),"stable operation descriptions");
    require(measure.parent==body&&connection.parent==body,"optional actions stay in body");
    TextView failure=a.labels.stream().filter(v->v.color==DesignUi.RED).findFirst().orElseThrow();
    require(failure.visibility==View.GONE,"failure initially hidden");
    require(measure.enabled,"original ready/idle internal route allows manual probe");
    require(a.handler.pending.size()==1,"one timer after show");
    int gets=NativeNetwork.gets;NetworkMetricsUi.show(a);
    require(a.networkDialog==d&&NativeNetwork.gets==gets&&a.handler.pending.size()==1,"duplicate visible open preserves dialog and timer");
    a.session.internal=false;a.handler.next();require(!measure.enabled,"phone route disables probe");
    a.session.internal=true;a.session.offline=true;a.handler.next();require(!measure.enabled,"offline disables probe");
    a.session.offline=false;n.ready=false;a.handler.next();require(!measure.enabled,"not-ready disables probe");
    n.ready=true;n.starting=true;a.handler.next();require(!measure.enabled,"starting disables probe");
    n.starting=false;n.measuringLatency=true;a.handler.next();require(!measure.enabled&&measure.text.equals("正在测量…"),"live measurement preserves busy text and disabled state");
    n.measuringLatency=false;n.lastManualProbe=SystemClock.now-4999;a.handler.next();require(!measure.enabled,"manual probe cooldown remains five seconds");
    n.lastManualProbe=SystemClock.now-5000;a.handler.next();require(measure.enabled&&measure.text.equals("测一下延迟"),"probe enabled at original cooldown boundary");
    measure.performClick();require(n.probes==1&&!measure.enabled,"manual probe starts once and disables original button");
    measure.performClick();require(n.probes==1,"disabled probe cannot repeat");
    n.callback.result(false,"controlled failure");require(a.updates==1&&failure.visibility==View.VISIBLE&&failure.text.equals("controlled failure"),"failure callback retains status refresh and visible error");
    n.callback.result(true,"");require(a.updates==2&&failure.visibility==View.GONE&&failure.text.isEmpty(),"success clears error through original callback");
    verify.performClick();audit.performClick();require(a.ipOpens==1&&a.auditOpens==1&&a.networkDialog==d&&d.isShowing(),"existing body routes retain dialog ownership");
    Runnable pending=a.handler.pending.get(0);int detailCalls=NetworkMetricsUi.detailCalls,posts=a.handler.posted;
    connection.performClick();require(a.connectionOpens==1&&!d.isShowing()&&a.networkDialog==null,"connection route closes owned network dialog");
    require(a.handler.pending.isEmpty()&&a.handler.removed==1,"connection dismissal removes original status tick");
    pending.run();require(a.handler.posted==posts&&NetworkMetricsUi.detailCalls==detailCalls,"late status callback after dismissal is inert");
    NetworkMetricsUi.show(a);AlertDialog close=a.networkDialog;close.getButton(-2).performClick();
    require(a.networkDialog==null&&!close.isShowing()&&a.handler.pending.isEmpty(),"native Close retains dismissal and timer cleanup");
    NetworkMetricsUi.show(a);AlertDialog obsolete=a.networkDialog;AlertDialog replacement=new AlertDialog(a);a.networkDialog=replacement;
    obsolete.dismiss();require(a.networkDialog==replacement,"old dismissal cannot clear replacement dialog ownership");
    require(a.handler.pending.isEmpty(),"old timer removed even when owner replaced");
  }
  public static void main(String[] args){run();System.out.println("{\"status\":\"passed\",\"checks\":"+checks+",\"actualAndroidExecution\":false}");}
}

package local.pocketchat;

import java.util.*;
import org.json.JSONObject;

/** Exact production entry/identity methods; View, dialog and preferences are declared boundaries. */
public final class BrowserEntryHost {
  static int checks;
  static void check(boolean value,String message){checks++;if(!value)throw new AssertionError(message);}
  static MainActivity fresh(){ProfileCatalog.row=new JSONObject().put("created",true).put("environmentId","environment-A").put("generation",3);ProfileCatalog.available=true;SystemClock.now=1000;EnvironmentOverviewDashboard.created=0;return new MainActivity();}
  static ChatSession session(){return new ChatSession("environment-A",3);}
  static void rejected(java.util.function.Consumer<Intent> change){
    MainActivity a=fresh();EnvironmentOverviewUi ui=new EnvironmentOverviewUi(a);Intent intent=EnvironmentOverviewUi.browserOpening(a,0);change.accept(intent);
    check(!ui.consume(intent)&&ui.dialog==null&&EnvironmentOverviewDashboard.created==0,"Invalid direct opening must not display or initialize an environment");
  }
  public static void main(String[] args){
    MainActivity a=fresh();EnvironmentOverviewUi ui=new EnvironmentOverviewUi(a);Intent cold=EnvironmentOverviewUi.browserOpening(a,0);
    check(cold.getBooleanExtra(EnvironmentOverviewUi.DIRECT,false)&&"chat".equals(cold.getStringExtra("openWindowAction")),"Direct opening keeps existing engine-selection action");
    check(!cold.hasExtra("url"),"Browser entry supplies no URL that could replace a live page");
    check(ui.consume(cold)&&ui.openingBrowser&&ui.dialog.isShowing(),"Cold direct opening paints a native startup surface");
    check(ui.dashboard==null&&EnvironmentOverviewDashboard.created==0&&ui.frameRegistrations==1,"Cold direct entry has no full dashboard and still registers first-frame startup");
    check(!cold.hasExtra(EnvironmentOverviewUi.NONCE)&&!cold.hasExtra(EnvironmentOverviewUi.DIRECT),"One-shot opening extras are consumed");
    ui.browserReady();check(ui.dialog!=null,"Native startup stays until the browser exists");
    a.session=session();ui.browserReady();check(ui.dialog==null&&!ui.openingBrowser,"Ready browser removes only the transient surface");

    a=fresh();a.session=session();Object document=a.session.document;String url=a.session.url;ui=new EnvironmentOverviewUi(a);
    check(!ui.consume(EnvironmentOverviewUi.browserOpening(a,0))&&ui.dialog==null,"Warm direct entry has no intermediate dashboard or loading screen");
    check(a.session.document==document&&url.equals(a.session.url)&&EnvironmentOverviewDashboard.created==0,"Warm entry preserves the exact current document and URL");
    Intent details=EnvironmentOverviewUi.detailsOpening(a,0);
    check("overview".equals(details.getStringExtra("openWindowAction"))&&!details.hasExtra(EnvironmentOverviewUi.DIRECT),"Details remain an explicit action separate from engine launch");
    check(ui.consume(details)&&ui.dashboard!=null&&EnvironmentOverviewDashboard.created==1,"Explicit details still render the original dashboard");
    ui.browserReady();check(ui.dialog!=null&&ui.dialog.isShowing(),"Browser readiness never auto-closes explicit details");

    a=fresh();ui=new EnvironmentOverviewUi(a);Intent first=EnvironmentOverviewUi.browserOpening(a,0),replay=new Intent(first);
    check(ui.consume(first),"First identity-bound opening accepted");ui.close();
    check(!ui.consume(replay)&&ui.dialog==null,"Consumed opening nonce cannot be replayed");
    rejected(i->i.putExtra(EnvironmentOverviewUi.SOURCE,"foreign-source"));
    rejected(i->i.putExtra(EnvironmentOverviewUi.NONCE,"not-a-nonce"));
    rejected(i->i.putExtra(EnvironmentOverviewUi.ID,"other-environment"));
    rejected(i->i.putExtra(EnvironmentOverviewUi.SLOT,1));
    rejected(i->i.putExtra(EnvironmentOverviewUi.GENERATION,4));
    rejected(i->i.putExtra(EnvironmentOverviewUi.AT,-1L));
    rejected(i->i.putExtra(EnvironmentOverviewUi.AT,2000L));
    rejected(i->{SystemClock.now=62000;});
    rejected(i->i.putExtra("openConversation","https://chatgpt.com/c/another"));
    rejected(i->i.putExtra("openDownload","task"));
    rejected(i->{ProfileCatalog.row.put("generation",4);});
    rejected(i->{ProfileCatalog.available=false;});
    a=fresh();a.session=new ChatSession("stale-owner",3);ui=new EnvironmentOverviewUi(a);
    check(!ui.consume(EnvironmentOverviewUi.browserOpening(a,0))&&ui.dialog==null,"A live session from another identity is rejected");
    a=fresh();a.preferences.commitOk=false;ui=new EnvironmentOverviewUi(a);
    check(!ui.consume(EnvironmentOverviewUi.browserOpening(a,0))&&ui.dialog==null,"Failed durable nonce write cannot open a browser surface");

    BrowserStartupGate gate=new BrowserStartupGate("environment-A",0,3);gate.foreground(true);
    check(!gate.take(),"Cold direct browser still requires a painted native frame");gate.frame();gate.foreground(false);
    check(!gate.take(),"Background frame cannot initialize a browser");gate.foreground(true);
    check(gate.take()&&!gate.take(),"Foreground startup is issued exactly once");
    check(!gate.matches("environment-A",0,4)&&!gate.matches("environment-B",0,3),"Startup cannot cross identity or generation");
    System.out.println("{\"passed\":"+checks+",\"actualAndroidExecution\":false}");
  }
}

class EnvironmentOverviewUi {
  final MainActivity a;final Set<String> consumed=new LinkedHashSet<>();
  Dialog dialog;ChatSession owner;EnvironmentOverviewState state;EnvironmentOverviewDashboard dashboard;
  boolean checking,painted,openingBrowser;long checkSequence;int frameRegistrations;
  EnvironmentOverviewUi(MainActivity a){this.a=a;}
  void close(){if(state!=null)state.close();dialog=null;state=null;dashboard=null;owner=null;openingBrowser=false;}
  void render(){}void resume(){}void afterFirstFrame(Runnable action){frameRegistrations++;}
  void checkRoute(){}void queryIp(){}void inspectIdentity(){}void details(){}
  /* PRODUCTION_METHODS */
}

class Context{}
class MainActivity extends Context {
  ChatSession session;final Prefs preferences=new Prefs();boolean destroyed,finishing;
  boolean isDestroyed(){return destroyed;}boolean isFinishing(){return finishing;}int dp(int value){return value;}
  Prefs getSharedPreferences(String name,int mode){return preferences;}
}
class ChatSession {final String environmentId;final int environmentGeneration;final Object document=new Object();String url="https://github.com/example/project";ChatSession(String id,int generation){environmentId=id;environmentGeneration=generation;}}
class Profiles {static int slot(MainActivity a){return 0;}static String display(Context c,int slot){return "Daily browser";}static Class<?> activity(int slot){return MainActivity.class;}}
class ProfileCatalog {static JSONObject row;static boolean available;static final ProfileCatalog instance=new ProfileCatalog();static ProfileCatalog get(Context c){return instance;}JSONObject item(int slot){return row;}boolean available(int slot){return available;}}
class NetworkStatusUi {static boolean current(MainActivity a,ChatSession session){return a.session==session;}}
class SystemClock {static long now;static long elapsedRealtime(){return now;}}
class Prefs {boolean commitOk=true;Prefs edit(){return this;}Prefs putString(String key,String value){return this;}boolean commit(){return commitOk;}}
class Intent {
  static final int FLAG_ACTIVITY_NEW_TASK=1,FLAG_ACTIVITY_REORDER_TO_FRONT=2;final Map<String,Object> extras=new HashMap<>();
  Intent(Context context,Class<?> type){}Intent(Intent other){extras.putAll(other.extras);}Intent addFlags(int flags){return this;}
  Intent putExtra(String key,Object value){extras.put(key,value);return this;}void removeExtra(String key){extras.remove(key);}boolean hasExtra(String key){return extras.containsKey(key);}
  String getStringExtra(String key){Object value=extras.get(key);return value instanceof String?(String)value:null;}
  int getIntExtra(String key,int fallback){Object value=extras.get(key);return value instanceof Integer?(Integer)value:fallback;}
  long getLongExtra(String key,long fallback){Object value=extras.get(key);return value instanceof Long?(Long)value:fallback;}
  boolean getBooleanExtra(String key,boolean fallback){Object value=extras.get(key);return value instanceof Boolean?(Boolean)value:fallback;}
}
class View {void setPadding(int left,int top,int right,int bottom){}void setBackgroundColor(int color){}}
class TextView extends View {void setGravity(int gravity){}}
class LinearLayout extends View {static class LayoutParams{LayoutParams(int width,int height){}}void setGravity(int gravity){}void addView(View view,LayoutParams params){}}
class Gravity {static final int CENTER=1;}
class WindowManager {static class LayoutParams {static final int FLAG_DIM_BEHIND=1;}}
class Window {static final int FEATURE_NO_TITLE=1;void clearFlags(int value){}void setDimAmount(int value){}void setDecorFitsSystemWindows(boolean value){}void setLayout(int width,int height){}}
class Dialog {boolean shown;View content;interface Listener{void dismiss(Dialog dialog);}void requestWindowFeature(int feature){}void setContentView(View view){content=view;}void setOnDismissListener(Listener listener){}void show(){shown=true;}boolean isShowing(){return shown;}Window getWindow(){return new Window();}}
class ThemedDialog extends Dialog {ThemedDialog(MainActivity a){}}
class EnvironmentOverviewDashboard extends View {static int created;EnvironmentOverviewDashboard(MainActivity a,int slot,Runnable check,Runnable ip,Runnable identity,Runnable details,Runnable enter){created++;}}
class DesignUi {static LinearLayout column(Context context){return new LinearLayout();}}
class ReferenceUi {static final int CHAT_BG=0,TEXT=1,MUTED=2;static TextView text(Context c,String text,int size,int color,boolean bold){return new TextView();}static void insets(MainActivity a,View content){}}
class AppAppearance {static void window(Window window){}}

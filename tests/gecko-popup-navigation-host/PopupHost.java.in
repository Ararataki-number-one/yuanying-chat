package local.pocketchat;

import java.util.*;
import java.util.function.*;
import org.json.*;

@UI_SOURCE@

/** The complete new UI class runs at these explicit, non-Android boundaries. */
public final class PopupHost {
  static final List<JSONObject> checks=new ArrayList<>();
  static void check(String name,boolean pass){if(!pass)throw new AssertionError(name);checks.add(J.obj("name",name,"pass",true));}
  static final String GPT="https://chatgpt.com/c/original",SITE="https://example.com/form",DEST="https://accounts.google.com/login";
  static final class Scene {
    final OwnerBoundary owner=new OwnerBoundary();final WebBoundary web=owner.web;final ActivityBoundary activity=new ActivityBoundary(owner,web);final GeckoPopupNavigationUi ui=new GeckoPopupNavigationUi(web);
    Scene(){web.displayContext.base=activity;web.popup=ui;}
    void offer(){ui.offer(web.current,DEST);}
    void generic(){web.url=SITE;owner.driverDocument="document-generic-0001";owner.lastDocumentId=owner.driverDocument;}
    void drive(){for(int n=0;n<50;n++){boolean work=owner.environmentIo.one()|owner.handler.one()|owner.guards.one()|owner.drivers.one();if(!work)return;}throw new AssertionError("Boundary loop exceeded");}
    void open(){offer();ui.action.click();drive();}
    void confirm(){ui.dialog.primary().click();drive();}
  }
  static void passive(){
    Scene s=new Scene();s.offer();ButtonBoundary original=s.ui.action;check("A website popup creates one nonmodal action and no inspection",original!=null&&s.activity.modals==0&&s.owner.driverCalls==0&&s.owner.guardCalls==0&&s.web.adds==1&&original.minHeight>=48);
    s.ui.offer(s.web.current,"https://www.example.org/latest");check("Repeated popup targets replace only the existing document action",s.ui.action==original&&s.web.adds==1&&s.ui.pending.target.equals("https://www.example.org/latest"));
    s.ui.invalidate();s.offer();check("A dismissed document cannot cause repeated native offer creation",s.ui.action==null&&s.activity.application.callbacks.isEmpty());s.web.timeZoneGates.get(s.web.current).documentSerial++;s.offer();check("A genuinely new native document can offer one new action",s.ui.action!=null&&s.web.adds==2);
    for(String target:Arrays.asList("about:blank","",null,"javascript:alert(1)","file:///private","https://127.0.0.1/","https://user:pass@example.com/","https://example.com/pocketchat-identity/v1/document?nonce=x"," https://example.com/"))check("Unsafe or opaque popup has no current-page action: "+target,!GeckoPopupNavigationUi.targetAllowed(target));
    check("Public HTTP and HTTPS targets use the actual shared policy",GeckoPopupNavigationUi.targetAllowed("http://example.com/path")&&GeckoPopupNavigationUi.targetAllowed(DEST));
  }
  static void generic(){
    Scene s=new Scene();s.generic();s.open();check("Generic pages require an explicit manual preservation confirmation",s.ui.dialog!=null&&s.ui.attempt.manual&&s.ui.dialog.primary().label.startsWith("已保存输入")&&s.owner.driverCalls==0&&s.owner.guardCalls==0&&s.owner.context.archiveCalls==0&&s.owner.browses==0);
    s.confirm();check("Generic confirmation delegates one normal browse without GPT automation",s.owner.browses==1&&s.owner.destination.equals(DEST)&&s.owner.driverCalls==0&&s.owner.guardCalls==0&&s.owner.context.archiveCalls==0&&s.ui.action==null&&s.ui.dialog==null&&s.activity.application.callbacks.isEmpty()&&!s.owner.operation&&!s.owner.configurationCapture);
    Scene cancel=new Scene();cancel.generic();cancel.open();cancel.ui.dialog.cancel.run();cancel.drive();check("Cancelling never navigates or creates a native input save",cancel.owner.browses==0&&cancel.owner.context.archiveCalls==0);
  }
  static void gpt(){
    Scene s=new Scene();s.open();check("GPT inspects actual guard and complete page before user confirmation",s.ui.dialog!=null&&s.owner.guardCalls==1&&s.owner.driverCalls==1&&s.owner.context.archiveCalls==0&&s.owner.browses==0);s.confirm();
    check("GPT archives under the environment writer lease and preserves exact input",s.owner.context.catalogLeases==1&&s.owner.context.archiveCalls==1&&s.owner.context.archived.equals("unsent exact draft\n")&&s.owner.context.archivedRevision==0);
    check("GPT rereads twice and rechecks tasks before one normal browse",s.owner.driverCalls==3&&s.owner.guardCalls==2&&s.owner.browses==1&&!s.owner.operation&&!s.owner.configurationCapture&&s.owner.memory.remembers==1&&s.web.checkpoints==1);
    Scene failed=new Scene();failed.owner.context.archiveWorks=false;failed.open();failed.confirm();check("Failed archive keeps the original page and clears only its capture",failed.owner.browses==0&&!failed.owner.operation&&!failed.owner.configurationCapture&&failed.owner.context.archiveCalls==1);
    Scene disabled=new Scene();disabled.owner.context.saving=false;disabled.open();check("Disabled draft saving requires an explicit manual GPT confirmation",disabled.ui.attempt.manual&&disabled.ui.dialog.primary().label.startsWith("已保存输入"));disabled.confirm();check("Disabled saving never archives while still rereading the exact GPT input",disabled.owner.context.archiveCalls==0&&disabled.owner.browses==1&&disabled.owner.driverCalls==3&&disabled.owner.guardCalls==2);
  }
  static void focus(){
    Scene s=new Scene();s.generic();s.open();s.drive();check("The helper's own modal focus does not cancel the user's confirmation",s.ui.dialog!=null&&s.ui.pending!=null&&!s.web.focus&&s.ui.dialog.decor.focus);
    ActivityBoundary other=new ActivityBoundary(new OwnerBoundary(),new OwnerBoundary().web);s.activity.application.pause(other);check("Another Activity cannot retire this page's action",s.ui.pending!=null);
    s.activity.application.pause(s.activity);s.activity.active=true;s.owner.uiVisible=true;s.web.focus=true;s.drive();check("Pause then resume cannot resurrect the old confirmation",s.ui.pending==null&&s.ui.dialog==null&&s.ui.action==null&&s.activity.application.callbacks.isEmpty()&&s.owner.browses==0);
    Scene covered=new Scene();covered.generic();covered.open();ViewBoundary decor=covered.ui.dialog.decor;decor.focus=false;decor.tree.fire(false);covered.drive();check("Losing the confirmation window's focus invalidates its capability",covered.ui.pending==null&&covered.ui.dialog==null&&covered.owner.browses==0&&covered.activity.application.callbacks.isEmpty());
    Scene closed=new Scene();closed.open();closed.ui.close();closed.ui.close();closed.drive();check("Close unregisters lifecycle and removes overlay and modal exactly once",closed.ui.closed&&closed.ui.pending==null&&closed.ui.action==null&&closed.ui.dialog==null&&closed.activity.application.callbacks.isEmpty());
  }
  static void change(Scene s,String kind){
    switch(kind){case "activity":s.web.displayContext.base=new ActivityBoundary(s.owner,s.web);break;case "session-owner":s.activity.session=new OwnerBoundary();break;case "sdk":s.web.current=new SessionBoundary();break;case "runtime":s.web.runtime=new Object();break;case "gate":WebBoundary.TimeZoneGate replacement=new WebBoundary.TimeZoneGate();replacement.epoch=s.web.timeZoneGates.get(s.web.current).epoch;s.web.timeZoneGates.put(s.web.current,replacement);break;case "document":s.web.timeZoneGates.get(s.web.current).documentSerial++;break;case "page-port":s.web.ports.put(s.web.current,new Object());break;case "route-port":s.web.routePort=new Object();break;case "url":s.web.url=SITE+"?different";break;case "navigation":s.owner.navigationEpoch++;break;case "connection":s.owner.connectionEpoch++;break;case "identity":s.web.identityPolicyRevision++;break;case "protection":s.web.nativeProtection.value++;break;case "desired":s.owner.timeZone.revision++;break;case "route":s.web.route="route-b";break;case "draft-policy":s.owner.context.revision++;break;case "draft-saving":s.owner.context.saving=!s.owner.context.saving;break;case "work":s.owner.fileWorkGeneration++;break;case "scope":s.owner.memory.namespace="another-cookie-scope";break;case "destroyed":s.web.destroyed=true;break;case "closed-sdk":s.web.current.open=false;break;case "network":s.owner.guard.permitted=false;break;case "visible":s.owner.uiVisible=false;break;case "addon":s.web.addonDisabled=true;break;default:throw new AssertionError(kind);}
  }
  static void fence(String kind){Scene s=new Scene();s.generic();s.open();change(s,kind);s.confirm();check("Changed popup capability never navigates: "+kind,s.owner.browses==0);}
  static void inputs(){
    for(String kind:Arrays.asList("incomplete","length","document","wrong-url","unknown-guard","busy-guard")){
      Scene s=new Scene();if(kind.equals("incomplete"))s.owner.complete=false;if(kind.equals("length"))s.owner.badLength=true;if(kind.equals("document"))s.owner.driverDocument="";if(kind.equals("wrong-url"))s.owner.driverUrl=SITE;if(kind.equals("unknown-guard"))s.owner.known=false;if(kind.equals("busy-guard"))s.owner.guardReply=true;s.open();check("Unconfirmed initial GPT state cannot open a navigation confirmation: "+kind,s.ui.dialog==null&&s.owner.browses==0&&s.owner.context.archiveCalls==0);
    }
    Scene changed=new Scene();changed.open();changed.ui.dialog.primary().click();changed.owner.context.draft="newly typed input";changed.drive();check("Changed GPT input is never replaced after its old copy was archived",changed.owner.browses==0&&changed.owner.context.archived.equals("unsent exact draft\n"));
    Scene late=new Scene();late.open();late.ui.dialog.primary().click();late.owner.environmentIo.one();late.owner.handler.one();late.owner.drivers.one();late.owner.known=false;late.drive();check("Unknown final task guard cannot authorize page replacement",late.owner.browses==0);
    Scene catalog=new Scene();catalog.open();catalog.ui.dialog.primary().click();catalog.owner.context.catalogGeneration++;catalog.drive();check("A stale environment cannot publish an archived draft into its replacement",catalog.owner.context.archiveCalls==0&&catalog.owner.browses==0);
    Scene policy=new Scene();policy.open();policy.ui.dialog.primary().click();policy.owner.context.revision++;policy.drive();check("A changed draft policy retires the pending input capture",policy.owner.browses==0&&policy.owner.context.archiveCalls==1&&!policy.owner.operation&&!policy.owner.configurationCapture);
  }
  static void route(){Scene s=new Scene();s.generic();s.offer();s.web.ipRouteNeedsReload=true;s.ui.action.click();check("IP route changes require independent timezone retry before navigation",s.owner.browses==0&&s.ui.dialog==null&&s.owner.status.contains("独立时区"));Scene initial=new Scene();initial.web.ipRouteNeedsReload=true;initial.offer();check("An already stale IP route offers no hidden bypass",initial.ui.action==null&&initial.owner.status.contains("独立时区"));}
  static void captures(){Scene s=new Scene();s.open();s.ui.dialog.primary().click();s.owner.operationGeneration++;s.drive();check("An old capture cannot clear a newer task's ownership",s.owner.browses==0&&s.owner.operation&&s.owner.configurationCapture);}
  static void run(String group){if(group.startsWith("fence:")){fence(group.substring(6));return;}switch(group){case "passive":passive();return;case "generic":generic();return;case "gpt":gpt();return;case "focus":focus();return;case "inputs":inputs();return;case "route":route();return;case "captures":captures();return;default:throw new AssertionError(group);}}
  public static void main(String[] args){if(args.length>0)run(args[0]);else{for(String group:Arrays.asList("passive","generic","gpt","focus","inputs","route","captures"))run(group);for(String kind:Arrays.asList("activity","session-owner","sdk","runtime","gate","document","page-port","route-port","url","navigation","connection","identity","protection","desired","route","draft-policy","draft-saving","work","scope","destroyed","closed-sdk","network","visible","addon"))fence(kind);}JSONArray rows=new JSONArray();for(JSONObject row:checks)rows.put(row);System.out.println(J.obj("status","passed","passed",checks.size(),"total",checks.size(),"checks",rows,"actualAndroidExecution",false,"actualGeckoExecution",false,"actualSqliteExecution",false,"scope","Complete actual popup helper plus actual task/draft/fence/URL policies at declared native-widget, lifecycle, archive-writer, driver and browse boundaries. No browser, Android window, real database or navigation executes."));}
}

class ContextBoundary {boolean saving=true,archiveWorks=true;long revision;int slot,catalogGeneration=1,catalogLeases,archiveCalls;String environment="00000000-0000-0000-0000-000000000001",draft="unsent exact draft\n",archived="";long archivedRevision=-1;PrefsBoundary getSharedPreferences(String name,int mode){return new PrefsBoundary(this);}}
class PrefsBoundary {final ContextBoundary context;PrefsBoundary(ContextBoundary context){this.context=context;}long getLong(String key,long fallback){return context.revision;}}
class AppPrefsBoundary {static boolean enabled(ContextBoundary context,String key){if(!key.equals("saveDraft"))throw new AssertionError(key);return context.saving;}}
class DraftPolicyBoundary {@DRAFT_METHODS@}
class ProfilesBoundary {static int slot(ContextBoundary context){return context.slot;}}
class BundleBoundary {}
class ActivityBoundary extends ContextBoundary {OwnerBoundary session;WebBoundary remote;boolean active=true,destroyed,finishing;int modals;final ApplicationBoundary application=new ApplicationBoundary();ActivityBoundary(OwnerBoundary session,WebBoundary remote){this.session=session;this.remote=remote;}boolean isDestroyed(){return destroyed;}boolean isFinishing(){return finishing;}ApplicationBoundary getApplication(){return application;}@CHAT_METHOD@}
class UriBoundary {final java.net.URI value;UriBoundary(String raw){value=java.net.URI.create(raw);}static UriBoundary parse(String raw){return new UriBoundary(raw);}String getScheme(){return value.getScheme();}String getHost(){return value.getHost();}String getUserInfo(){return value.getUserInfo();}int getPort(){return value.getPort();}}
class ApplicationBoundary {interface ActivityLifecycleCallbacks {void onActivityCreated(ActivityBoundary a,BundleBoundary b);void onActivityStarted(ActivityBoundary a);void onActivityResumed(ActivityBoundary a);void onActivityPaused(ActivityBoundary a);void onActivityStopped(ActivityBoundary a);void onActivitySaveInstanceState(ActivityBoundary a,BundleBoundary b);void onActivityDestroyed(ActivityBoundary a);}final Set<ActivityLifecycleCallbacks> callbacks=new HashSet<>();void registerActivityLifecycleCallbacks(ActivityLifecycleCallbacks value){callbacks.add(value);}void unregisterActivityLifecycleCallbacks(ActivityLifecycleCallbacks value){callbacks.remove(value);}void pause(ActivityBoundary value){value.active=false;for(ActivityLifecycleCallbacks callback:new ArrayList<>(callbacks))callback.onActivityPaused(value);}}
class TreeBoundary {interface OnWindowFocusChangeListener {void onWindowFocusChanged(boolean focused);}final List<OnWindowFocusChangeListener> callbacks=new ArrayList<>();boolean isAlive(){return true;}void addOnWindowFocusChangeListener(OnWindowFocusChangeListener value){callbacks.add(value);}void removeOnWindowFocusChangeListener(OnWindowFocusChangeListener value){callbacks.remove(value);}void fire(boolean focused){for(OnWindowFocusChangeListener callback:new ArrayList<>(callbacks))callback.onWindowFocusChanged(focused);}}
class ViewBoundary {boolean focus=true,shown=true;final TreeBoundary tree=new TreeBoundary();boolean hasWindowFocus(){return focus;}boolean isShown(){return shown;}TreeBoundary getViewTreeObserver(){return tree;}}
class ButtonBoundary extends ViewBoundary {String label;Runnable click;boolean enabled=true;int minHeight;ButtonBoundary(String label,Runnable click){this.label=label;this.click=click;}void click(){if(enabled)click.run();}void setEnabled(boolean value){enabled=value;}void setTextSize(int value){}void setMaxLines(int value){}void setMaxWidth(int value){}void setMinimumHeight(int value){minHeight=value;}void setMinimumWidth(int value){}void setElevation(int value){}void setContentDescription(String value){}void bringToFront(){}}
class GravityBoundary {static final int TOP=1,CENTER_HORIZONTAL=2;}
class FrameBoundary {static class LayoutParams {int leftMargin,rightMargin,topMargin;LayoutParams(int a,int b,int c){}}}
class DesignBoundary {static int dp(ContextBoundary c,int value){return value;}}
class WindowBoundary {final ViewBoundary decor;WindowBoundary(ViewBoundary decor){this.decor=decor;}ViewBoundary getDecorView(){return decor;}}
class UiBoundary {static ButtonBoundary button(ActivityBoundary activity,String label,boolean primary,Runnable click){return new ButtonBoundary(label,click);}static class Modal {final ActivityBoundary activity;final ViewBoundary decor=new ViewBoundary();final List<String> notes=new ArrayList<>();boolean showing;Runnable cancel=this::dismiss;Consumer<Object> dismissed;ButtonBoundary primary;Modal(ActivityBoundary activity,String title){this.activity=activity;}void note(String value){notes.add(value);}void setOnDismissListener(Consumer<Object> value){dismissed=value;}void buttons(String back,Runnable cancel,String title,Runnable accept){this.cancel=cancel;primary=new ButtonBoundary(title,accept);}void show(){showing=true;activity.modals++;activity.remote.focus=false;decor.focus=true;activity.remote.popup.focusChanged(false);}boolean isShowing(){return showing;}ButtonBoundary primary(){return primary;}WindowBoundary getWindow(){return new WindowBoundary(decor);}void dismiss(){if(!showing)return;showing=false;decor.focus=false;decor.tree.fire(false);activity.remote.focus=activity.active;if(dismissed!=null)dismissed.accept(this);}}}
class SessionBoundary {boolean open=true;boolean isOpen(){return open;}}
class ProtectionBoundary {long value=1;long token(){return value;}}
class WrapperBoundary {ContextBoundary base;ContextBoundary getBaseContext(){return base;}}
class GuardBoundary {boolean permitted=true;boolean allowed(){return permitted;}}
class StatusBoundary {long revision=1;JSONObject status(){return J.obj("desiredRevision",revision);}}
class QueueBoundary {final List<Runnable> tasks=new ArrayList<>();void execute(Runnable value){tasks.add(value);}void post(Runnable value){tasks.add(value);}boolean one(){if(tasks.isEmpty())return false;tasks.remove(0).run();return true;}}
class WebBoundary extends ViewBoundary {final OwnerBoundary owner;final WrapperBoundary displayContext=new WrapperBoundary();SessionBoundary current=new SessionBoundary();Object runtime=new Object(),routePort=new Object();boolean destroyed,failed,addonDisabled,visible=true,ipRouteNeedsReload,tzAllowed=true;long identityPolicyRevision=1;String url=PopupHost.GPT,route="route-a";final ProtectionBoundary nativeProtection=new ProtectionBoundary();final Map<SessionBoundary,TimeZoneGate> timeZoneGates=new IdentityHashMap<>();final Map<SessionBoundary,Object> ports=new IdentityHashMap<>();final Set<SessionBoundary> crashed=Collections.newSetFromMap(new IdentityHashMap<SessionBoundary,Boolean>());int adds,removes,checkpoints;GeckoPopupNavigationUi popup;static final class TimeZoneGate {String epoch="native-open-epoch";long documentSerial;boolean ready=true;}WebBoundary(OwnerBoundary owner){this.owner=owner;timeZoneGates.put(current,new TimeZoneGate());ports.put(current,new Object());}String getUrl(){return url;}String ipRouteStamp(){return route;}boolean hasVisibleDocument(){return visible;}boolean readingOwnerVisible(){return true;}boolean timeZoneAllows(SessionBoundary value){return value==current&&tzAllowed&&timeZoneGates.get(value)!=null&&timeZoneGates.get(value).ready;}void addView(ButtonBoundary action,FrameBoundary.LayoutParams layout){adds++;}void removeView(ButtonBoundary action){removes++;}void checkpointState(){checkpoints++;}}
class OwnerBoundary {final ContextBoundary context=new ContextBoundary();final WebBoundary web=new WebBoundary(this);final MemoryBoundary memory=new MemoryBoundary();final MemoryBoundary pageMemory=memory;final GuardBoundary guard=new GuardBoundary();final StatusBoundary timeZone=new StatusBoundary();final QueueBoundary environmentIo=new QueueBoundary(),handler=new QueueBoundary(),guards=new QueueBoundary(),drivers=new QueueBoundary();boolean deleted,uiVisible=true,browserPaused,submitting,operation,configurationCapture,transferActive,files,uncertain,reply,known=true,guardReply,complete=true,badLength;Object pending;int environmentGeneration=1,guardCalls,driverCalls,browses;String environmentId=context.environment,lastDocumentId="document-current-0001",driverDocument=lastDocumentId,driverUrl="",destination="",status="";long navigationEpoch=1,connectionEpoch=2,fileWorkGeneration,webWorkGeneration,operationGeneration;boolean fileWorkActive(){return files;}boolean resourceFilesUncertain(){return uncertain;}boolean currentReplyActive(){return reply;}void setStatus(String value){status=value;}void changed(){}void requestTaskGuardStatus(String key,Consumer<TaskGuardSnapshot> done){guardCalls++;guards.post(()->done.accept(new TaskGuardSnapshot(known,guardReply,files,submitting,operation,transferActive,context.slot,environmentGeneration,environmentId,navigationEpoch,"observer-binding",driverDocument,1,fileWorkGeneration+webWorkGeneration+operationGeneration)));}void asyncDriver(String action,JSONObject args,int timeout,Consumer<JSONObject> done){if(!action.equals("page-state")||timeout!=2500)throw new AssertionError("Unexpected DOM command");driverCalls++;drivers.post(()->done.accept(J.obj("ok",true,"url",driverUrl.isEmpty()?web.url:driverUrl,"documentId",driverDocument,"draft",context.draft,"draftComplete",complete,"draftLength",context.draft.length()+(badLength?1:0))));}void browse(String target,String label){if(operation||configurationCapture||web.popup.action!=null||web.popup.dialog!=null)throw new AssertionError("Normal browse did not release its capture and UI");browses++;destination=target;navigationEpoch++;}}
class TimezoneBoundary {@TIMEZONE_MEMBERS@}
class MemoryBoundary {String namespace="same-profile-cookie-scope";int remembers,forgets;String scope(){return namespace;}void remember(String scope,String url,JSONObject page){remembers++;}void forget(String url){forgets++;}@MEMORY_METHODS@}
class EnvironmentSpecBoundary {@IDENTITY@static JSONObject object(Object... values){return J.obj(values);}}
class CatalogBoundary {final ContextBoundary context;CatalogBoundary(ContextBoundary context){this.context=context;}static CatalogBoundary get(ContextBoundary context){return new CatalogBoundary(context);}interface Action<T>{T run()throws Exception;}<T>T withIdentity(EnvironmentSpecBoundary.Identity expected,Action<T> work)throws Exception{context.catalogLeases++;if(expected.slot!=context.slot||expected.generation!=context.catalogGeneration||!expected.environmentId.equals(context.environment))throw new Exception("Stale environment");return work.run();}}
class ArchiveBoundary {final ContextBoundary context;ArchiveBoundary(ContextBoundary context){this.context=context;}static ArchiveBoundary get(ContextBoundary context){return new ArchiveBoundary(context);}boolean save(String url,String body,String origin,long revision){context.archiveCalls++;if(!context.archiveWorks||!context.saving||revision!=context.revision)return false;context.archived=body;context.archivedRevision=revision;return true;}}

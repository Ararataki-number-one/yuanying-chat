  static void addonEntryBoundary(){
    for(String path:new String[]{"load","native","restore","delegate"}){
      WebBoundary web=new WebBoundary();web.addonRejected=true;
      if(path.equals("load"))web.loadUrl(SITE);else if(path.equals("native"))web.loadSessionUri(web.current,SITE);else if(path.equals("restore"))web.restoreCheckpoint(web.current,new StateBoundary(SITE),SITE,7);else check("Disabled addon declaration denies the actual navigation delegate",web.onLoadRequest(web.current,new LoadRequest(SITE)).value==AllowOrDeny.DENY);
      check("Independent addon refusal precedes SDK timezone work: "+path,web.addonChecks>0&&web.current.reads==0&&web.current.events.isEmpty()&&web.owner.timeZone.calls.isEmpty());
    }
  }
  public static void main(String[] args){
    if(args.length>0){switch(args[0]){
      case "load-first-gate":firstLoad();break;case "restore-first-gate":checkpoint();break;case "navigation-first-gate":navigation();break;
      case "ready-gate":case "controller-gate":gate(args[0]);break;case "retired-gate":retired();break;
      case "window-port":case "window-session":windowChanged(args[0]);break;case "navigation-epoch":changedEpoch();break;
      case "restore-epoch":case "restore-current":changedRestore(args[0]);break;case "after-worker-gate":filteredRecheck();break;case "send-port":send(args[0]);directSendPort();break;case "reply-port":send(args[0]);break;
      case "explicit-native-queue":nativeAfterLoad(SITE,OTHER);break;case "claim-clears-native-queue":loadAfterNative(SITE,OTHER);break;case "restore-clears-main-queue":restoreAfterLoad(SITE,OTHER);break;case "worker-intent-owner":writerAfterLoad(SITE,OTHER);break;
      case "secondary-epoch":secondaryNavigation();break;case "native-same-url-intent":sameNativeIntent();break;case "document-serial":documentRevalidation();break;
      case "held-route":case "held-header":heldRequests();break;case "held-queue-cap":heldQueueBound();break;
      case "held-identity":heldOwnership("identity");break;case "held-desired":heldOwnership("desired");break;
      case "proof-before-requests":proofBeforeRequests();break;
      default:throw new AssertionError(args[0]);
    }}else{firstLoad();checkpoint();navigation();gate("");retired();windowChanged("window-port");windowChanged("window-session");changedEpoch();changedRestore("restore-epoch");changedRestore("restore-current");timeout();disconnected();send("all");popups();filteredRestore();filteredRecheck();guards();intentOwnership();directSendPort();secondaryNavigation();sameNativeIntent();documentRevalidation();heldRequests();for(String kind:new String[]{"navigation","connection","identity","protection","desired","port","closed","destroyed","deleted","current"})heldOwnership(kind);heldQueueBound();heldNewDocument();proofBeforeRequests();addonEntryBoundary();}
    System.out.println(J.obj("status","passed","passed",checks.length(),"total",checks.length(),"checks",checks,"actualAndroidExecution",false,"actualGeckoExecution",false,"nativeTimezoneReadback",false,"dateIntlEffectVerified",false,"workerEffectVerified",false).toString());
  }
}

class WebBoundary {
  @METHODS@
  final OwnerBoundary owner=new OwnerBoundary();final MetadataBoundary metadata=new MetadataBoundary();final StoreBoundary sessionStore=new StoreBoundary();
  final Map<SessionBoundary,TimeZoneGate> timeZoneGates=new IdentityHashMap<>();final Map<SessionBoundary,String> timeZoneLoads=new IdentityHashMap<>(),locations=new IdentityHashMap<>(),deferredGeneralLoads=new IdentityHashMap<>();
  final Map<SessionBoundary,Object> timeZoneIntents=new IdentityHashMap<>(),nativeTimeZoneIntents=new IdentityHashMap<>();
  final List<SessionBoundary> popups=new ArrayList<>();final Set<SessionBoundary> crashed=Collections.newSetFromMap(new IdentityHashMap<>());
  final Map<SessionBoundary,StateBoundary> states=new IdentityHashMap<>();final Map<SessionBoundary,Long> stateDraftRevisions=new IdentityHashMap<>();
  SessionBoundary current=new SessionBoundary(),primary=current;PortBoundary routePort=new PortBoundary();ExitBoundary exitIpPage;
  boolean destroyed,ready=true,privacyReady=true,requestHeadersInstalled=true,protectedNetwork=true,identityAllowed=true,routeReady=true;String queued="";StateBoundary startupState;long startupDraftRevision=7;
  long identityPolicyRevision=1;final ProtectionBoundary nativeProtection=new ProtectionBoundary();
  int routeCalls,headerCalls;boolean routeDecision=true,headerDecision=true;
  // Addon terminal lifecycle is exercised in its independent actual-method
  // suite. Original timezone cases explicitly declare that dependency enabled.
  boolean addonRejected;int addonChecks;
  boolean rejectDisabledNavigation(SessionBoundary session,String target){addonChecks++;return addonRejected;}
  ProtectionRestore generalRestore,protectionRestore;
  final BrowserBridgeRequests cookieCallbacks=new BrowserBridgeRequests(new BrowserBridgeRequests.Timer(){public void schedule(Runnable task,long delay){owner.handler.postDelayed(task,delay);}public void cancel(Runnable task){owner.handler.removeCallbacks(task);}},null);
  WebBoundary(){locations.put(current,"");}
  JSONObject timeZoneStatus(){return J.obj("boundary","metadata-only");}
  boolean allowedUrl(String target){return GeckoNavigationPolicy.publicWeb(target);}
  boolean identityRequestAllowed(String target){return identityAllowed;}
  boolean protectionAllowsNetwork(){return protectedNetwork;}
  JSONObject route(String target){routeCalls++;return J.obj("allowed",routeDecision,"routeTarget",target);}
  JSONObject blocked(){return J.obj("allowed",false);}
  ResultBoundary<Object> requestHeaderPolicy(String target){headerCalls++;return ResultBoundary.fromValue(J.obj("allowed",headerDecision,"headerTarget",target).toString());}
  String protectionSummary(){return "Protection boundary";}
  boolean retainGeneralRoute(SessionBoundary session,String target){return routeReady;}
  boolean generalRouteReady(){return routeReady;}
  boolean reopenCurrent(){return false;}
  void closeExitIpPage(){}
  void resumeForBoundary(){resumeProtectedLoads();}
}
class OwnerBoundary {
  boolean deleted;long navigationEpoch=1,connectionEpoch=1;int changed;String status="";final ContextBoundary context=new ContextBoundary();final HandlerBoundary handler=new HandlerBoundary();final ControllerBoundary timeZone=new ControllerBoundary();final GuardBoundary guard=new GuardBoundary();
  void changed(){changed++;}void setStatus(String value){status=value;}
}
class ControllerBoundary {
  interface NativeAccess {boolean current();void read(String token,Consumer<String> ok,Consumer<Throwable> fail);void apply(String zone,String token,Consumer<String> ok,Consumer<Throwable> fail);}
  static final class Call {final Object session;final String sessionId;String epoch;final NativeAccess access;final Consumer<Boolean> done;boolean ready,revalidation;Call(Object s,String id,String e,NativeAccess a,Consumer<Boolean> d){session=s;sessionId=id;epoch=e;access=a;done=d;}}
  final List<Call> calls=new ArrayList<>();final Map<Object,Call> callsBySession=new IdentityHashMap<>();final List<String> retired=new ArrayList<>();boolean systemPopups=true;
  void prepare(Object session,String id,String epoch,NativeAccess access,Consumer<Boolean> done){Call call=new Call(session,id,epoch,access,done);calls.add(call);callsBySession.put(session,call);}
  void revalidate(Object session,String id,String epoch,NativeAccess access,Consumer<Boolean> done){Call old=callsBySession.get(session);if(old!=null)old.ready=false;prepare(session,id,epoch,access,done);calls.get(calls.size()-1).revalidation=true;}
  long desiredRevision=1;JSONObject status(){return J.obj("desiredRevision",desiredRevision);}
  boolean allowed(Object session,String epoch){Call call=callsBySession.get(session);return call!=null&&call.ready&&call.epoch.equals(epoch)&&call.access.current();}
  boolean popupAllowed(){return systemPopups;}
  void retire(Object session,String epoch){retired.add(epoch);Call call=callsBySession.get(session);if(call!=null&&call.epoch.equals(epoch))callsBySession.remove(session);}
  void complete(Call call,boolean decision){call.ready=decision;call.done.accept(decision);}
}
class SessionBoundary {
  static int sequence;final String id="sdk-session-"+(++sequence);boolean open=true,throwRead;int reads;final List<ResultBoundary<String>> pending=new ArrayList<>();final List<String> loads=new ArrayList<>(),events=new ArrayList<>();final List<StateBoundary> restored=new ArrayList<>();
  boolean isOpen(){return open;}String getId(){return id;}
  ResultBoundary<String> getUserAgent(){reads++;if(throwRead)throw new IllegalStateException("SDK read boundary failure");ResultBoundary<String> result=new ResultBoundary<>();pending.add(result);return result;}
  void loadUri(String target){loads.add(target);events.add("load "+target);}void restoreState(StateBoundary state){restored.add(state);events.add("restore "+state.url);}
}
class ResultBoundary<T> {
  boolean completed;T value;Throwable error;final List<Consumer<T>> success=new ArrayList<>();final List<Consumer<Throwable>> failure=new ArrayList<>();
  static <T> ResultBoundary<T> fromValue(T value){ResultBoundary<T> result=new ResultBoundary<>();result.complete(value);return result;}
  void accept(Consumer<T> ok,Consumer<Throwable> bad){if(completed){if(error==null)ok.accept(value);else bad.accept(error);}else{success.add(ok);failure.add(bad);}}
  void complete(T value){if(completed)throw new IllegalStateException("Double result completion");completed=true;this.value=value;for(Consumer<T> callback:new ArrayList<>(success))callback.accept(value);}
  void fail(Throwable error){if(completed)throw new IllegalStateException("Double result failure");completed=true;this.error=error;for(Consumer<Throwable> callback:new ArrayList<>(failure))callback.accept(error);}
}
class HandlerBoundary {
  static class Task {final Runnable task;final long at;Task(Runnable r,long a){task=r;at=a;}}
  long now;final List<Task> tasks=new ArrayList<>();
  void post(Runnable task){postDelayed(task,0);}void postDelayed(Runnable task,long delay){tasks.add(new Task(task,now+delay));}void removeCallbacks(Runnable task){tasks.removeIf(t->t.task==task);}
  void advance(long delta){now+=delta;drain();}void drain(){while(true){Task next=null;for(Task task:tasks)if(task.at<=now&&(next==null||task.at<next.at))next=task;if(next==null)return;tasks.remove(next);next.task.run();}}
}
class PortBoundary {boolean fail;final List<JSONObject> messages=new ArrayList<>();void postMessage(JSONObject message){if(fail)throw new IllegalStateException("Native port post boundary failure");messages.add(message);}}
class StateBoundary {
  final String url;StateBoundary(String url){this.url=url;}int size(){return 1;}int getCurrentIndex(){return 0;}StateBoundary get(int index){return this;}String getUri(){return url;}
  public String toString(){return J.obj("boundaryUrl",url).toString();}static StateBoundary fromString(String raw){String url=J.parse(raw).optString("boundaryUrl");return url.isEmpty()?null:new StateBoundary(url);}
}
class IdentityBoundary {@IDENTITY_METHOD@}
class ContextBoundary {boolean keepDrafts=true;long revision=7;}
class DraftPolicyBoundary {static boolean enabled(ContextBoundary context){return context.keepDrafts;}static long revision(ContextBoundary context){return context.revision;}static String checkpoint(String raw,boolean keep){return raw;}}
class StoreBoundary {final ExecutorBoundary io=new ExecutorBoundary();}
class ExecutorBoundary {final List<Runnable> tasks=new ArrayList<>();void execute(Runnable task){tasks.add(task);}void drain(){while(!tasks.isEmpty())tasks.remove(0).run();}}
class MetadataBoundary {JSONObject timeZonePolicy;}
class ProtectionBoundary {long value=1;long token(){return value;}}
class GuardBoundary {boolean permitted=true;boolean allowed(){return permitted;}}
class ExitBoundary {SessionBoundary aux;}

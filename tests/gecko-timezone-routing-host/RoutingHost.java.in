package local.pocketchat;

import java.io.IOException;
import java.util.*;
import java.util.function.Consumer;
import org.json.*;

/** Actual app methods; every browser, scheduling and controller double is named Boundary. */
public final class RoutingHost {
  static final String SITE="https://example.com/first",OTHER="https://example.org/next";
  static final JSONArray checks=new JSONArray();
  static void check(String name,boolean value){checks.put(J.obj("name",name,"pass",value));if(!value)throw new AssertionError(name);}
  static void sdk(WebBoundary web){web.current.pending.get(web.current.pending.size()-1).complete("SDK window readiness boundary; value is not a UA proof");}
  static void allow(WebBoundary web){web.owner.timeZone.complete(web.owner.timeZone.calls.get(web.owner.timeZone.calls.size()-1),true);}
  static void firstLoad(){
    WebBoundary web=new WebBoundary();web.loadUrl(SITE);
    check("First navigation waits for the SDK window barrier",web.current.loads.isEmpty()&&web.current.reads==1&&web.owner.timeZone.calls.isEmpty());
    sdk(web);check("SDK readiness starts controller preparation without loading",web.owner.timeZone.calls.size()==1&&web.current.loads.isEmpty());
    ControllerBoundary.Call call=web.owner.timeZone.calls.get(0);
    check("Controller receives the exact native object session id and open epoch",call.session==web.current&&call.sessionId.equals(web.current.getId())&&call.epoch.equals(web.timeZoneGates.get(web.current).epoch)&&call.access.current());
    allow(web);check("Allowed current session loads its first URL exactly once",web.current.loads.equals(List.of(SITE))&&web.queued.isEmpty()&&web.timeZoneAllows(web.current));
    check("Window deadline is removed after SDK success",web.owner.handler.tasks.isEmpty());
    check("Prepared browser navigation proceeds without replay",web.onLoadRequest(web.current,new LoadRequest(SITE)).value==AllowOrDeny.ALLOW&&web.current.loads.size()==1);
  }
  static void checkpoint(){
    WebBoundary web=new WebBoundary();StateBoundary state=new StateBoundary(SITE);web.restoreCheckpoint(web.current,state,SITE,7);
    check("Checkpoint restoration waits for the SDK window barrier",web.current.restored.isEmpty()&&web.current.reads==1&&web.owner.timeZone.calls.isEmpty());
    sdk(web);check("Checkpoint restoration also waits for controller completion",web.current.restored.isEmpty()&&web.current.loads.isEmpty());
    allow(web);check("Prepared checkpoint restores the original SDK state",web.current.restored.equals(List.of(state))&&web.current.loads.isEmpty());
    WebBoundary startup=new WebBoundary();startup.startupState=state;startup.loadUrl(SITE);
    check("Startup checkpoint remains queued while timezone is pending",startup.startupState==state&&startup.current.restored.isEmpty());
    sdk(startup);allow(startup);check("Startup load uses the prepared checkpoint without an extra URL load",startup.current.restored.equals(List.of(state))&&startup.current.loads.isEmpty()&&startup.startupState==null);
  }
  static void navigation(){
    WebBoundary web=new WebBoundary();ResultBoundary<AllowOrDeny> first=web.onLoadRequest(web.current,new LoadRequest(SITE));
    check("First browser navigation is denied while its timezone is pending",first.value==AllowOrDeny.DENY&&web.current.loads.isEmpty()&&web.current.reads==1);
    check("Duplicate pending browser callbacks remain denied",web.onLoadRequest(web.current,new LoadRequest(SITE)).value==AllowOrDeny.DENY&&web.current.reads==1);
    sdk(web);allow(web);check("Duplicate first-navigation callbacks replay only one URI",web.current.loads.equals(List.of(SITE))&&web.timeZoneLoads.isEmpty());
    WebBoundary latest=new WebBoundary();latest.loadSessionUri(latest.current,SITE);latest.loadSessionUri(latest.current,OTHER);sdk(latest);allow(latest);
    check("Only the latest pending browser target can replay",latest.current.loads.equals(List.of(OTHER)));
    WebBoundary blank=new WebBoundary();check("Blank bootstrap navigation does not wait for timezone",blank.onLoadRequest(blank.current,new LoadRequest("about:blank")).value==AllowOrDeny.ALLOW&&blank.current.reads==0);
  }
  static void gate(String focus){
    WebBoundary web=new WebBoundary();web.prepareTimeZone(web.current,ok->{});sdk(web);ControllerBoundary.Call call=web.owner.timeZone.calls.get(0);call.ready=true;
    check("A controller permission alone cannot bypass the unfinished UI gate",!web.timeZoneAllows(web.current));
    web.timeZoneGates.get(web.current).ready=true;call.ready=false;
    check("Ready UI gate still requires exact controller session and epoch permission",!web.timeZoneAllows(web.current));
    call.ready=true;call.epoch="different-open-epoch";check("Exact controller epoch is required even for the same native object",!web.timeZoneAllows(web.current));
    call.epoch=web.timeZoneGates.get(web.current).epoch;web.owner.timeZone.callsBySession.remove(web.current);
    check("Exact native object cannot borrow another surface permission",!web.timeZoneAllows(web.current));
  }
  static void retired(){
    WebBoundary web=new WebBoundary();List<Boolean> old=new ArrayList<>();web.prepareTimeZone(web.current,old::add);sdk(web);WebBoundary.TimeZoneGate oldGate=web.timeZoneGates.get(web.current);ControllerBoundary.Call call=web.owner.timeZone.calls.get(0);
    web.retireTimeZone(web.current);check("Retirement releases old waiters with false and retires exact epoch",old.equals(List.of(false))&&web.owner.timeZone.retired.equals(List.of(call.epoch)));
    WebBoundary.TimeZoneGate replacement=new WebBoundary.TimeZoneGate();web.timeZoneGates.put(web.current,replacement);List<Boolean> late=new ArrayList<>();oldGate.waiting.add(late::add);web.finishTimeZone(web.current,oldGate,true);
    check("A retired gate callback cannot finish or notify its replacement",late.isEmpty()&&!replacement.ready&&web.owner.changed==0);
    web.owner.timeZone.complete(call,true);check("Late controller callback after retirement cannot load",web.current.loads.isEmpty()&&!replacement.ready);
    web.timeZoneLoads.put(web.current,SITE);web.retireTimeZones();check("Bulk retirement clears deferred URI and all gate ownership",web.timeZoneGates.isEmpty()&&web.timeZoneLoads.isEmpty());
  }
  static void windowChanged(String kind){
    WebBoundary web=new WebBoundary();SessionBoundary original=web.current;web.loadUrl(SITE);
    if(kind.equals("window-port"))web.routePort=new PortBoundary();else original.open=false;
    original.pending.get(0).complete("window ready");
    check(kind.equals("window-port")?"Changed native port cannot enter controller preparation":"Closed native session cannot enter controller preparation",web.owner.timeZone.calls.isEmpty()&&original.loads.isEmpty());
  }
  static void changedEpoch(){
    WebBoundary web=new WebBoundary();web.loadSessionUri(web.current,SITE);sdk(web);web.owner.navigationEpoch++;allow(web);
    check("A queued URI cannot load after its navigation epoch changes",web.current.loads.isEmpty());
  }
  static void changedRestore(String kind){
    WebBoundary web=new WebBoundary();SessionBoundary original=web.current;web.restoreCheckpoint(original,new StateBoundary(SITE),SITE,7);sdk(web);
    if(kind.equals("restore-epoch"))web.owner.navigationEpoch++;else{web.current=new SessionBoundary();web.locations.put(web.current,"");}
    allow(web);check(kind.equals("restore-epoch")?"A checkpoint cannot restore after its navigation epoch changes":"A checkpoint cannot restore into a replaced current surface",original.restored.isEmpty()&&original.loads.isEmpty());
  }
  static void timeout(){
    for(boolean system:new boolean[]{true,false}){
      WebBoundary web=new WebBoundary();web.loadUrl(SITE);web.owner.handler.advance(4999);
      check("SDK barrier stays pending before its five-second deadline "+system,web.owner.timeZone.calls.isEmpty()&&web.current.loads.isEmpty());
      web.owner.handler.advance(1);check("SDK barrier deadline supplies one unready native-access boundary "+system,web.owner.timeZone.calls.size()==1&&web.current.loads.isEmpty());
      ControllerBoundary.Call call=web.owner.timeZone.calls.get(0);List<Throwable> rejected=new ArrayList<>();call.access.read("timeout-token",value->{throw new AssertionError("Timeout invented a native ACK");},rejected::add);
      check("Timed out SDK window cannot invent native readback "+system,rejected.size()==1&&web.routePort.messages.isEmpty());
      web.owner.timeZone.complete(call,system);check("Only scripted default-system controller fallback may continue "+system,system?web.current.loads.equals(List.of(SITE)):web.current.loads.isEmpty());
      web.current.pending.get(0).complete("late SDK completion");check("Late SDK completion cannot create a second preparation "+system,web.owner.timeZone.calls.size()==1&&web.current.loads.size()==(system?1:0));
    }
    for(boolean throwsSynchronously:new boolean[]{false,true}){
      WebBoundary web=new WebBoundary();web.current.throwRead=throwsSynchronously;web.loadUrl(SITE);if(!throwsSynchronously)web.current.pending.get(0).fail(new IOException("SDK boundary unavailable"));
      check("SDK failure becomes unready controller input without loading "+throwsSynchronously,web.owner.timeZone.calls.size()==1&&web.current.loads.isEmpty());
    }
  }
  static void disconnected(){
    WebBoundary web=new WebBoundary();web.loadUrl(SITE);sdk(web);ControllerBoundary.Call old=web.owner.timeZone.calls.get(0);web.routePort=null;web.retireTimeZones();web.owner.timeZone.complete(old,true);
    check("Disconnect and late controller completion never load a page",web.current.loads.isEmpty()&&web.timeZoneGates.isEmpty());
    web.routePort=new PortBoundary();web.loadUrl(SITE);sdk(web);allow(web);check("Reconnected owner needs fresh preparation before first load",web.current.reads==2&&web.current.loads.equals(List.of(SITE)));
    for(String kind:new String[]{"closed","deleted","destroyed","unknown"}){
      WebBoundary unavailable=new WebBoundary();SessionBoundary session=unavailable.current;if(kind.equals("closed"))session.open=false;if(kind.equals("deleted"))unavailable.owner.deleted=true;if(kind.equals("destroyed"))unavailable.destroyed=true;if(kind.equals("unknown"))unavailable.locations.clear();List<Boolean> values=new ArrayList<>();unavailable.prepareTimeZone(session,values::add);
      check("Unavailable native surface fails without SDK work "+kind,values.equals(List.of(false))&&session.reads==0&&!unavailable.timeZoneAllows(session));
    }
  }
  static void send(String kind){
    WebBoundary web=new WebBoundary();web.prepareTimeZone(web.current,ok->{});sdk(web);ControllerBoundary.Call call=web.owner.timeZone.calls.get(0);PortBoundary old=web.routePort;List<String> ok=new ArrayList<>();List<Throwable> bad=new ArrayList<>();
    if(kind.equals("send-port")){web.routePort=new PortBoundary();call.access.read("read-token",ok::add,bad::add);check("A changed port is rejected before posting a native timezone request",old.messages.isEmpty()&&bad.size()==1&&ok.isEmpty());return;}
    call.access.read("read-token",ok::add,bad::add);JSONObject read=old.messages.get(0);int id=read.optInt("id");
    check("Native read uses exact SDK session identity token and correlation id",read.length()==4&&read.optString("kind").equals("timezoneRead")&&read.optString("sessionId").equals(web.current.getId())&&read.optString("requestToken").equals("read-token")&&id>0&&!read.has("zoneId"));
    check("Wrong port and wrong id cannot claim a native reply",!web.cookieCallbacks.complete(new PortBoundary(),id,"boundary receipt")&&!web.cookieCallbacks.complete(old,id+100,"boundary receipt")&&ok.isEmpty());
    if(kind.equals("reply-port")){web.routePort=new PortBoundary();web.cookieCallbacks.complete(old,id,"boundary receipt");check("A reply on a retired port cannot complete native timezone access",ok.isEmpty()&&bad.size()==1);return;}
    check("Exact port and id complete only the matching callback",web.cookieCallbacks.complete(old,id,"boundary read receipt")&&ok.equals(List.of("boundary read receipt"))&&!web.cookieCallbacks.complete(old,id,"duplicate"));
    call.access.apply("Asia/Shanghai","apply-token",ok::add,bad::add);JSONObject apply=old.messages.get(1);check("Native apply preserves requested zone and gets a distinct request id",apply.length()==5&&apply.optString("kind").equals("timezoneApply")&&apply.optString("sessionId").equals(web.current.getId())&&apply.optString("requestToken").equals("apply-token")&&apply.optString("zoneId").equals("Asia/Shanghai")&&apply.optInt("id")!=id);
    web.cookieCallbacks.cancel(old);check("Connection cancellation fails pending timezone access without a receipt",bad.size()==1&&ok.size()==1&&web.cookieCallbacks.size()==0);
    old.fail=true;call.access.read("post-failure",ok::add,bad::add);check("Native post exception fails correlated request",bad.size()==2&&web.cookieCallbacks.size()==0);
    old.fail=false;call.access.read("native-timeout",ok::add,bad::add);web.owner.handler.advance(6000);check("Native request timeout produces failure rather than a positive ACK",bad.size()==3&&ok.size()==1&&web.cookieCallbacks.size()==0);
  }
  static void popups(){
    WebBoundary web=new WebBoundary();SessionBoundary popup=new SessionBoundary();web.locations.put(popup,SITE);web.popups.add(popup);List<Boolean> values=new ArrayList<>();
    check("Default-system popup admission is delegated without native override proof",web.timeZoneAllows(popup));web.prepareTimeZone(popup,values::add);check("Default-system popup does not open an SDK readiness cycle",values.equals(List.of(true))&&popup.reads==0&&web.owner.timeZone.calls.isEmpty());
    web.owner.timeZone.systemPopups=false;values.clear();check("Custom-zone popup is denied before it can claim timezone readiness",!web.timeZoneAllows(popup));web.prepareTimeZone(popup,values::add);web.loadSessionUri(popup,SITE);
    check("Custom-zone popup never starts an unopened SDK readiness cycle",values.equals(List.of(false))&&popup.reads==0&&popup.loads.isEmpty()&&web.owner.timeZone.calls.isEmpty());
    check("Unknown native object cannot borrow default-system popup permission",!web.timeZoneAllows(new SessionBoundary()));
  }
  static void filteredRestore(){
    WebBoundary web=new WebBoundary();web.owner.context.keepDrafts=false;web.restoreCheckpoint(web.current,new StateBoundary(SITE),SITE,7);sdk(web);allow(web);
    check("Filtered SDK checkpoint waits on its declared writer boundary",web.sessionStore.io.tasks.size()==1&&web.current.restored.isEmpty());web.sessionStore.io.drain();check("Filtered SDK checkpoint waits on its handler boundary",web.current.restored.isEmpty());web.owner.handler.drain();check("Filtered checkpoint restores only after both boundaries and timezone permission",web.current.restored.size()==1&&web.current.loads.isEmpty());
    for(String kind:new String[]{"epoch","current","closed","guard"}){
      WebBoundary stale=new WebBoundary();stale.owner.context.keepDrafts=false;stale.restoreCheckpoint(stale.current,new StateBoundary(SITE),SITE,7);sdk(stale);allow(stale);SessionBoundary original=stale.current;stale.sessionStore.io.drain();
      if(kind.equals("epoch"))stale.owner.navigationEpoch++;if(kind.equals("current"))stale.current=new SessionBoundary();if(kind.equals("closed"))original.open=false;if(kind.equals("guard"))stale.owner.guard.permitted=false;stale.owner.handler.drain();
      check("Filtered checkpoint rejects changed callback context "+kind,original.restored.isEmpty()&&original.loads.isEmpty());
    }
  }
  static void filteredRecheck(){
    WebBoundary web=new WebBoundary();web.owner.context.keepDrafts=false;web.restoreCheckpoint(web.current,new StateBoundary(SITE),SITE,7);sdk(web);allow(web);web.sessionStore.io.drain();
    // The old port is a different actual native connection. Scripted controller
    // permission for that connection no longer passes NativeAccess.current().
    web.routePort=new PortBoundary();web.owner.handler.drain();
    check("Writer completion rechecks timezone permission before restoring SDK state",web.current.restored.isEmpty()&&web.current.loads.isEmpty()&&web.current.reads==2);
    sdk(web);check("Retired-port checkpoint waits for a fresh controller decision",web.owner.timeZone.calls.size()==2&&web.current.restored.isEmpty());allow(web);
    check("Fresh checkpoint permission still uses the existing writer boundary",web.sessionStore.io.tasks.size()==1&&web.current.restored.isEmpty());web.sessionStore.io.drain();web.owner.handler.drain();
    check("Fresh current-port checkpoint restores once after renewed permission",web.current.restored.size()==1&&web.current.loads.isEmpty());
  }
  static void guards(){
    for(String kind:new String[]{"route","protection","identity","url"}){
      WebBoundary web=new WebBoundary();if(kind.equals("route"))web.owner.guard.permitted=false;if(kind.equals("protection"))web.protectedNetwork=false;if(kind.equals("identity"))web.identityAllowed=false;String target=kind.equals("url")?"file:///private":SITE;web.loadSessionUri(web.current,target);
      check("URI entry guard rejects before any SDK preparation "+kind,web.current.reads==0&&web.current.loads.isEmpty());
    }
    WebBoundary latest=new WebBoundary();latest.loadUrl(SITE);latest.loadUrl(OTHER);sdk(latest);allow(latest);check("Multiple first-load requests use the newest queued URL exactly once",latest.current.loads.equals(List.of(OTHER)));
    for(String kind:new String[]{"guard","identity","protection"}){
      WebBoundary web=new WebBoundary();web.loadSessionUri(web.current,SITE);sdk(web);if(kind.equals("guard"))web.owner.guard.permitted=false;if(kind.equals("identity"))web.identityAllowed=false;if(kind.equals("protection"))web.protectedNetwork=false;allow(web);check("Queued URI rechecks current authorization before loading "+kind,web.current.loads.isEmpty());
    }
  }
  static void nativeAfterLoad(String oldUrl,String explicitUrl){
    WebBoundary web=new WebBoundary();web.loadUrl(explicitUrl);
    check("Explicit first load denies the older native reload",web.onLoadRequest(web.current,new LoadRequest(oldUrl)).value==AllowOrDeny.DENY);
    check("Explicit load intent prevents a second native reload queue",web.timeZoneLoads.isEmpty()&&web.timeZoneGates.get(web.current).waiting.size()==1&&web.current.reads==1);
    sdk(web);allow(web);check("Explicit first load remains the only visible navigation",web.current.events.equals(List.of("load "+explicitUrl))&&web.timeZoneIntents.isEmpty());
  }
  static void loadAfterNative(String oldUrl,String explicitUrl){
    WebBoundary web=new WebBoundary();check("Native reload first waits on timezone",web.onLoadRequest(web.current,new LoadRequest(oldUrl)).value==AllowOrDeny.DENY);web.loadUrl(explicitUrl);sdk(web);allow(web);
    check("An explicit target supersedes an already deferred native reload",web.current.events.equals(List.of("load "+explicitUrl))&&web.timeZoneLoads.isEmpty()&&web.timeZoneIntents.isEmpty());
  }
  static void nativeAfterRestore(String oldUrl,String restoredUrl){
    WebBoundary web=new WebBoundary();StateBoundary state=new StateBoundary(restoredUrl);web.restoreCheckpoint(web.current,state,restoredUrl,7);
    check("Explicit checkpoint denies the older native reload",web.onLoadRequest(web.current,new LoadRequest(oldUrl)).value==AllowOrDeny.DENY&&web.timeZoneLoads.isEmpty());sdk(web);allow(web);
    check("Explicit checkpoint remains the only visible navigation",web.current.events.equals(List.of("restore "+restoredUrl))&&web.timeZoneIntents.isEmpty());
  }
  static void restoreAfterNative(String oldUrl,String restoredUrl){
    WebBoundary web=new WebBoundary();web.onLoadRequest(web.current,new LoadRequest(oldUrl));StateBoundary state=new StateBoundary(restoredUrl);web.restoreCheckpoint(web.current,state,restoredUrl,7);sdk(web);allow(web);
    check("Explicit checkpoint supersedes the already deferred native reload",web.current.events.equals(List.of("restore "+restoredUrl))&&web.timeZoneLoads.isEmpty()&&web.timeZoneIntents.isEmpty());
  }
  static void restoreAfterLoad(String loadedUrl,String restoredUrl){
    WebBoundary web=new WebBoundary();web.loadUrl(loadedUrl);web.restoreCheckpoint(web.current,new StateBoundary(restoredUrl),restoredUrl,7);sdk(web);allow(web);
    // Actual resumeProtectedLoads is the later app protection retry. This makes
    // the stale queued URL bug visible as a second load, not just a map check.
    web.resumeForBoundary();
    check("A restored checkpoint cannot revive the earlier main URL on protection retry",web.current.events.equals(List.of("restore "+restoredUrl))&&web.queued.isEmpty()&&web.timeZoneIntents.isEmpty());
  }
  static void loadAfterRestore(String restoredUrl,String loadedUrl){
    WebBoundary web=new WebBoundary();web.restoreCheckpoint(web.current,new StateBoundary(restoredUrl),restoredUrl,7);web.loadUrl(loadedUrl);sdk(web);allow(web);
    check("A newer explicit URL suppresses the pending checkpoint callback",web.current.events.equals(List.of("load "+loadedUrl))&&web.timeZoneIntents.isEmpty());
  }
  static void newestRestore(String oldUrl,String newestUrl){
    WebBoundary web=new WebBoundary();web.restoreCheckpoint(web.current,new StateBoundary(oldUrl),oldUrl,7);web.restoreCheckpoint(web.current,new StateBoundary(newestUrl),newestUrl,7);sdk(web);allow(web);
    check("Two same-epoch pending checkpoints restore only the latest intent",web.current.events.equals(List.of("restore "+newestUrl))&&web.current.reads==1&&web.timeZoneIntents.isEmpty());
    WebBoundary writer=new WebBoundary();writer.owner.context.keepDrafts=false;writer.restoreCheckpoint(writer.current,new StateBoundary(oldUrl),oldUrl,7);sdk(writer);allow(writer);writer.restoreCheckpoint(writer.current,new StateBoundary(newestUrl),newestUrl,7);writer.sessionStore.io.drain();writer.owner.handler.drain();
    check("Two same-epoch checkpoint writers restore only the latest intent",writer.current.events.equals(List.of("restore "+newestUrl))&&writer.timeZoneIntents.isEmpty());
  }
  static void writerAfterLoad(String restoredUrl,String loadedUrl){
    WebBoundary web=new WebBoundary();web.owner.context.keepDrafts=false;web.restoreCheckpoint(web.current,new StateBoundary(restoredUrl),restoredUrl,7);sdk(web);allow(web);
    check("Old checkpoint writer is pending before the new explicit load",web.sessionStore.io.tasks.size()==1&&web.current.events.isEmpty());web.loadUrl(loadedUrl);web.sessionStore.io.drain();web.owner.handler.drain();
    check("A superseded writer cannot restore its checkpoint after a newer explicit load",web.current.events.equals(List.of("load "+loadedUrl))&&web.timeZoneIntents.isEmpty());
  }
  static void intentOwnership(){
    WebBoundary web=new WebBoundary();Object old=web.claimTimeZoneIntent(web.current,false),latest=web.claimTimeZoneIntent(web.current,false);web.clearTimeZoneIntent(web.current,old);
    check("Old cleanup cannot erase a newer exact-object intent",web.timeZoneIntents.get(web.current)==latest);web.retireTimeZone(web.current);
    check("Retirement clears explicit intent even before a gate exists",!web.hasTimeZoneIntent(web.current));
    for(boolean swap:new boolean[]{false,true}){
      String first=swap?OTHER:SITE,last=swap?SITE:OTHER;
      nativeAfterLoad(first,last);loadAfterNative(first,last);nativeAfterRestore(first,last);restoreAfterNative(first,last);restoreAfterLoad(first,last);loadAfterRestore(first,last);newestRestore(first,last);writerAfterLoad(first,last);
    }
  }
  static WebBoundary prepared(){WebBoundary web=new WebBoundary();web.loadUrl(SITE);sdk(web);allow(web);return web;}
  static void sdk(SessionBoundary session){session.pending.get(session.pending.size()-1).complete("SDK document window boundary");}
  static boolean accepted(ResultBoundary<Object> result){return result.completed&&J.parse((String)result.value).optBoolean("allowed");}
  static void directSendPort(){
    WebBoundary web=new WebBoundary();web.prepareTimeZone(web.current,ignored->{});sdk(web);PortBoundary old=web.routePort;web.routePort=new PortBoundary();List<String> good=new ArrayList<>();List<Throwable> bad=new ArrayList<>();
    web.sendTimeZone(old,web.current,web.timeZoneGates.get(web.current),"timezoneRead","","direct-port-token",good::add,bad::add);
    check("A changed port is rejected before posting a native timezone request",old.messages.isEmpty()&&good.isEmpty()&&bad.size()==1);
  }
  static void secondaryNavigation(){
    WebBoundary web=prepared();SessionBoundary secondary=new SessionBoundary();web.locations.put(secondary,"");web.loadSessionUri(secondary,SITE);web.loadSessionUri(secondary,OTHER);web.owner.navigationEpoch++;
    sdk(secondary);allow(web);
    check("A secondary session replays its newest target despite the primary navigation epoch advancing",secondary.events.equals(List.of("load "+OTHER))&&web.current.events.equals(List.of("load "+SITE))&&web.timeZoneLoads.isEmpty()&&web.nativeTimeZoneIntents.isEmpty());
  }
  static void sameNativeIntent(){
    WebBoundary web=new WebBoundary();web.loadSessionUri(web.current,SITE);web.loadSessionUri(web.current,SITE);sdk(web);
    WebBoundary.TimeZoneGate gate=web.timeZoneGates.get(web.current);List<Consumer<Boolean>> callbacks=new ArrayList<>(gate.waiting);Object newest=web.nativeTimeZoneIntents.get(web.current);
    check("Same-URL native requests keep distinct exact-object intents",callbacks.size()==2&&newest!=null);
    // This is the real gate-completion state immediately before the actual
    // waiting callbacks run. Isolate which produced closure may consume it.
    web.owner.timeZone.calls.get(0).ready=true;gate.ready=true;callbacks.get(0).accept(true);
    check("Old same-URL native completion cannot consume the newer exact intent",web.current.loads.isEmpty()&&web.nativeTimeZoneIntents.get(web.current)==newest&&web.timeZoneLoads.get(web.current).equals(SITE));
    callbacks.get(1).accept(true);check("Latest same-URL native intent alone loads once",web.current.events.equals(List.of("load "+SITE))&&web.nativeTimeZoneIntents.isEmpty()&&web.timeZoneLoads.isEmpty());
  }
  static void documentRevalidation(){
    WebBoundary web=prepared();SessionBoundary session=web.current;WebBoundary.TimeZoneGate gate=web.timeZoneGates.get(session);String epoch=gate.epoch;ControllerBoundary.Call original=web.owner.timeZone.calls.get(0);
    web.revalidateTimeZone(session);ControllerBoundary.Call changed=web.owner.timeZone.calls.get(1);
    check("Document commit immediately retires ready state within the same SDK open epoch",web.timeZoneGates.get(session)==gate&&gate.epoch.equals(epoch)&&gate.documentSerial==1&&gate.preparing&&gate.revalidating&&!gate.ready&&!web.timeZoneAllows(session)&&changed.revalidation);
    check("Document commit revalidation invalidates the previous native-access generation",!original.access.current()&&changed.access.current()&&session.reads==2);
    List<String> good=new ArrayList<>();List<Throwable> bad=new ArrayList<>();changed.access.read("committed-context-token",good::add,bad::add);
    check("Committed native read waits on its actual SDK window boundary",web.routePort.messages.isEmpty()&&good.isEmpty()&&bad.isEmpty());
    sdk(web);JSONObject request=web.routePort.messages.get(0);web.cookieCallbacks.complete(web.routePort,request.optInt("id"),"native boundary response");

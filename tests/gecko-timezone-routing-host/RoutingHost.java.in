    switch(kind){case "navigation":web.owner.navigationEpoch++;break;case "connection":web.owner.connectionEpoch++;break;case "identity":web.identityPolicyRevision++;break;case "protection":web.nativeProtection.value++;break;case "desired":web.owner.timeZone.desiredRevision++;break;case "port":web.routePort=new PortBoundary();break;case "closed":original.open=false;break;case "destroyed":web.destroyed=true;break;case "deleted":web.owner.deleted=true;break;case "current":web.current=new SessionBoundary();break;default:throw new AssertionError(kind);}

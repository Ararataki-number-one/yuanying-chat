final class GeckoSettings {boolean desktop,policyAcknowledged=true,rfpAcknowledged;String[] requestedLocales={"en-US"},expectedSdkLocales={"en-US"};JSONObject acceptedBrowserIdentity=J.obj("templateId","test-template");String getUserAgentString(){return "Mozilla Firefox/157.0 HOST BOUNDARY";}}
final class Prefs {final Map<String,Object> values=new HashMap<>();String getString(String k,String d){Object v=values.get(k);return v instanceof String?(String)v:d;}boolean getBoolean(String k,boolean d){Object v=values.get(k);return v instanceof Boolean?(Boolean)v:d;}void put(String k,Object v){values.put(k,v);}Editor edit(){return new Editor();}final class Editor{Editor putString(String k,String v){values.put(k,v);return this;}boolean commit(){return true;}}}

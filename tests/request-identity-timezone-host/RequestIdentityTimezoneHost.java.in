package local.pocketchat;

import android.os.SystemClock;
import java.io.*;
import java.net.*;
import java.nio.file.*;
import java.util.*;
import java.util.concurrent.*;
import java.util.function.*;
import org.json.*;

/** Explicit SDK/clock/UI/storage adapters. ACK messages are inputs, never native evidence. */
public final class RequestIdentityTimezoneHost {
  static final List<String> checks=new ArrayList<>();static Path root;static int ordinal;
  static void check(String name,boolean pass){if(!pass)throw new AssertionError(name);checks.add(name);}
  static ChatSession session()throws Exception{
    SystemClock.now=1000;ChatSession s=new ChatSession(new TestContext(root.resolve("case-"+(++ordinal)),new EnvironmentSpec.Identity(2,4,GeckoTimeZoneHost.ID)));
    GeckoTimeZoneStore.State initial=GeckoTimeZoneStore.load(s.context);GeckoTimeZoneStore.save(s.context,initial.identity,initial.revision,GeckoTimeZoneSpec.of("America/New_York"));s.timeZone.load();s.pump();
    s.web.url="https://chatgpt.com/c/a";s.web.locations.put(s.web.current,s.web.url);s.web.visible=true;s.prefs.put("requestIdentityEndpoint","https://detector.example/pocketchat-identity/v1/");
    Native initialNative=s.web.commit(false,"6");accept(s,initialNative);return s;
  }
  static void bootstrap(ChatSession s,Native n)throws Exception{n.readSuccess.accept(n.ack(n.readToken,"",n.context));s.pump();}
  static void accept(ChatSession s,Native n)throws Exception{bootstrap(s,n);if(n.applySuccess!=null)n.applySuccess.accept(n.ack(n.applyToken,n.zone,n.context));s.pump();}
  static RequestIdentityAuditSession start(ChatSession s){RequestIdentityAuditSession q=s.audit.requestIdentity;check("Explicit idle start accepted",q.start(()->s.completions++));check("Original exact draft/credential preflight opens one detector URL",q.opening&&s.web.loads==1&&q.scopeRegistered&&q.originalUrl.equals("https://chatgpt.com/c/a"));return q;}
  static Native committed(ChatSession s,RequestIdentityAuditSession q)throws Exception{s.web.url=q.documentUrl;s.web.locations.put(s.web.current,s.web.url);Native n=s.web.commit(true,"7");check("Authorized own navigation survives full-stamp document invalidation",q.pageStarted(q.documentUrl)&&q.active&&q.documentProofPending&&!q.documentProofBound);return n;}
  static JSONObject observation(ChatSession s){return J.obj("connectionEpoch",s.connectionEpoch,"executionId",EnvironmentAudit.OBSERVATION_EXECUTION_ID,"policy",s.audit.policyStamp());}
  static void legal()throws Exception{
    ChatSession s=session();RequestIdentityAuditSession q=start(s);String oldPolicy=q.policy,configuration=q.configurationPolicy;JSONObject oldObservation=observation(s);Native n=committed(s,q);
    check("Commit revokes ordinary observation despite identical desired configuration",!s.audit.observationCurrent(oldObservation)&&!oldPolicy.equals(s.audit.policyStamp())&&configuration.equals(s.audit.requestIdentityPolicyStamp()));
    check("Pending native proof cannot collect or issue detector subrequests",!q.fresh()&&!q.allowsRequest(q.documentUrl)&&s.web.auditCalls==0&&q.policy.equals(oldPolicy));
    check("Page finish does not start collection before proof",q.pageFinished(q.documentUrl)&&s.web.auditCalls==0&&q.documentFinished);
    boolean[] resumed={false};s.web.timeZoneGates.get(s.web.current).networkWaiting.add(ready->resumed[0]=ready&&q.allowsRequest(q.documentUrl));
    bootstrap(s,n);n.applySuccess.accept(n.ack(n.applyToken,n.zone,n.context));s.handler.drain();
    check("Correct ACK still waits for actual receipt writer",q.documentProofPending&&!q.documentProofBound&&q.policy.equals(oldPolicy)&&s.web.auditCalls==0);
    s.environmentIo.drain();check("Writer publication still waits for UI ownership recheck",q.documentProofPending&&!q.documentProofBound);s.handler.drain();
    check("Exact native proof synchronously rebinds full stamp before held HTTP",q.documentProofBound&&!q.documentProofPending&&q.fresh()&&resumed[0]&&q.policy.equals(s.audit.policyStamp())&&!q.policy.equals(oldPolicy));
    check("Expected native state is recaptured only after fresh writer confirmation",q.expected.optBoolean("timezoneNativeReadback")&&q.expected.optString("timezoneRequestedZone").equals("America/New_York")&&q.expected.optLong("configurationRevision")==s.revision);
    check("Proof starts one collector after previously finished document",s.web.auditCalls==1&&q.collecting&&s.web.evidenceCalls==1);
    check("Old ordinary observation remains history after legal audit rebind",!s.audit.observationCurrent(oldObservation));
    long observed=q.expected.optLong("timezoneObservationStartedAt");s.web.timeZoneGates.get(s.web.current).proofWaiting.add(ready->{});s.web.finishTimeZone(s.web.current,s.web.timeZoneGates.get(s.web.current),true);
    check("Duplicate ready notification does not restart collection",s.web.auditCalls==1&&q.expected.optLong("timezoneObservationStartedAt")==observed);
    Native next=s.web.commit(true,"8");check("Later document proof invalidates completed detector binding",!q.routeFresh()&&!q.fresh()&&!q.allowsRequest(q.documentUrl));
    q.pollServer(q.id);check("Later revalidation aborts rather than promoting an old report",!q.active&&s.observed==0&&s.audit.report.length()==0);accept(s,next);check("Late confirmation cannot revive cancelled detector",!q.active&&!q.fresh()&&s.web.auditCalls==1);
  }
  static void configurationChanges()throws Exception{
    for(String change:new String[]{"configuration","endpoint","frame-endpoint","route","connection","file","revision","runtime","sdk","reopened","navigation","url","nonce","environment","generation","deleted","network","guard","privacy","protection","expired"}){
      ChatSession s=session();RequestIdentityAuditSession q=start(s);Native n=committed(s,q);String originalNonce=q.nonce;
      if(change.equals("configuration"))s.web.settings.desktop=true;
      if(change.equals("endpoint"))s.prefs.put("requestIdentityEndpoint","https://other.example/pocketchat-identity/v1/");
      if(change.equals("frame-endpoint")){q.frameEnabled=true;q.frameEndpoint="https://frame.example/pocketchat-identity/v1/";s.prefs.put("requestIdentityFrameEndpoint","https://changed-frame.example/pocketchat-identity/v1/");}
      if(change.equals("route"))s.prefs.put("proxy","new-route");if(change.equals("connection"))s.connectionEpoch++;if(change.equals("file"))s.fileWorkGeneration++;if(change.equals("revision"))s.revision++;
      if(change.equals("runtime"))s.web.runtime=new Object();if(change.equals("sdk")){s.web.current=new GeckoSession();s.web.locations.put(s.web.current,q.documentUrl);}
      if(change.equals("reopened")){s.web.timeZoneGates.put(s.web.current,new GeckoWebView.TimeZoneGate());check("Original open incarnation remains part of configuration fence",!q.configurationFresh());}
      if(change.equals("navigation"))s.navigationEpoch++;if(change.equals("url"))s.web.url="https://elsewhere.example/";if(change.equals("nonce"))q.nonce="00000000000000000000000000000000";
      if(change.equals("environment"))s.environmentId=GeckoTimeZoneHost.OTHER;if(change.equals("generation"))s.environmentGeneration++;if(change.equals("deleted"))s.deleted=true;if(change.equals("network"))s.networkReady=false;if(change.equals("guard"))s.guard.allowed=false;if(change.equals("privacy"))s.privacy.navigate=false;if(change.equals("protection"))s.web.protectedNetwork=false;if(change.equals("expired"))SystemClock.now=q.deadline+1;
      // Actual gate callback, with actual Controller/Store strict ACK inputs, not a forged audit-ready callback.
      accept(s,n);
      if(q.active&&!q.documentProofBound)s.handler.fire(6000);
      check("Changed configuration cannot rebind detector proof: "+change,!q.documentProofBound&&!q.fresh()&&s.observed==0&&s.web.auditCalls==0);
      if(q.active)q.cancel();q.nonce=originalNonce;
    }
  }
  static void proofFailure()throws Exception{
    for(String failure:new String[]{"native-read","wrong-native-token","wrong-native-context","writer","timeout"}){
      ChatSession s=session();RequestIdentityAuditSession q=start(s);Native n=committed(s,q);
      if(failure.equals("native-read"))n.readFailure.accept(new IOException("controlled native read failure"));
      else if(failure.equals("timeout"))s.handler.fire(6000);
      else{bootstrap(s,n);if(failure.equals("writer"))s.context.vault.failPut=true;n.applySuccess.accept(n.ack(failure.equals("wrong-native-token")?"ffffffffffffffffffffffffffffffffffffffffffffffffffffffffffffffff":n.applyToken,n.zone,failure.equals("wrong-native-context")?"8":n.context));}
      s.pump();check("Unconfirmed actual proof cannot rebind the audit",!q.documentProofBound&&!q.active&&s.web.auditCalls==0&&s.observed==0&&s.audit.report.length()==0);
      if(n.applySuccess!=null)n.applySuccess.accept(n.ack(n.applyToken,n.zone,n.context));s.pump();check("Late native callbacks cannot promote failed proof: "+failure,!q.active&&!q.documentProofBound&&s.web.auditCalls==0);
    }
  }
  static void preflightAndScope()throws Exception{
    ChatSession s=session();s.deferInspect=true;RequestIdentityAuditSession q=s.audit.requestIdentity;check("Preflight can wait on actual driver boundary",q.start(null)&&q.active&&!q.opening);s.web.commit(true,"7");s.pendingInspect.accept(J.obj("busy",false,"url",q.originalUrl));check("Preflight still requires original full policy rather than stable configuration only",!q.active&&s.web.loads==0);
    s=session();q=start(s);Native n=committed(s,q);accept(s,n);check("Only exact detector URL is admitted after proof",q.allowsRequest(q.documentUrl)&&q.allowsRequest(q.endpoint+"worker.js?nonce="+q.nonce)&&!q.allowsRequest(q.endpoint+"worker.js?nonce=ffffffffffffffffffffffffffffffff")&&!q.allowsRequest("https://other.example/pocketchat-identity/v1/document?nonce="+q.nonce)&&!q.allowsRequest(q.documentUrl+"&extra=1"));
    q.pageStarted("https://unowned.example/");check("A second or foreign page start cannot reuse detector opening",!q.active&&s.observed==0);
    s=session();q=start(s);q.pageStarted("https://unowned.example/");check("Foreign first navigation aborts without rebind",!q.active&&!q.documentProofBound&&s.web.auditCalls==0);
    s=session();q=start(s);n=committed(s,q);q.cancel();accept(s,n);check("Explicit cancellation wins over a late actual proof",!q.active&&!q.documentProofBound&&s.completions==1);
    s=session();q=start(s);s.handler.fire(20500);check("Original preparation timeout has no new grace budget",!q.active&&s.web.loads==1&&s.observed==0);
    s=session();q=start(s);n=committed(s,q);q.pageFinished(q.documentUrl);s.handler.fire(20500);accept(s,n);check("Original overall timeout cannot be extended by late proof",!q.active&&!q.documentProofBound&&s.web.auditCalls==0);
  }

  static JSONObject signal(RequestIdentityAuditSession q){return J.obj("ua",q.expected.optString("ua"),"language",q.expected.optString("language"),"languages",J.arr(q.expected.optString("language")));}
  static JSONObject response(RequestIdentityAuditSession q)throws Exception{JSONObject server=RequestIdentityAuditHost.server();server.put("nonce",q.nonce);JSONArray events=server.getJSONArray("events");for(int i=0;i<events.length();i++)events.getJSONObject(i).getJSONObject("headers").put("userAgent",q.expected.optString("ua")).put("acceptLanguage",q.expected.optString("language"));return J.obj("ok",true,"nonce",q.nonce,"source","extension-background-control","httpStatus",200,"server",server);}
  static void reportLifecycle()throws Exception{
    ChatSession s=session();RequestIdentityAuditSession q=start(s);Native n=committed(s,q);accept(s,n);q.pageFinished(q.documentUrl);JSONObject js=J.obj("schema",1,"nonce",q.nonce,"status","complete","source","controlled-top-level-document","document",signal(q),"worker",signal(q));
    s.web.auditCallback.accept(J.obj("id",String.valueOf(q.id),"requestIdentity",js).toString());check("Document result alone cannot finish before independent service records",q.active&&q.webDone&&!q.controlDone&&s.observed==0);
    s.web.evidenceCallback.accept(response(q).toString());
    check("Matching bounded document and service responses complete current observation",!q.active&&s.observed==1&&s.audit.recorded==1&&s.audit.saves==1&&s.audit.report.optBoolean("fresh")&&s.audit.requestIdentityReport.optString("status").equals("observed"));
    check("Completed report preserves exact rebound full policy and native revision",s.audit.report.optString("policy").equals(s.audit.policyStamp())&&s.audit.requestIdentityReport.optLong("configurationRevision")==s.revision&&s.audit.observationCurrent(s.audit.requestIdentityReport));
    check("Current detector result never claims complete fingerprint acceptance",!s.audit.requestIdentityReport.optBoolean("fingerprintTemplateAcceptance")&&!s.audit.requestIdentityReport.optBoolean("fullDesktopUaConsistency"));
    s.web.commit(true,"8");check("Saved report becomes history on later native document transition",!s.audit.observationCurrent(s.audit.requestIdentityReport)&&s.observed==1&&s.audit.recorded==1);
    for(String late:new String[]{"configuration","document","endpoint","cancel"}){
      s=session();q=start(s);n=committed(s,q);accept(s,n);q.pageFinished(q.documentUrl);Consumer<String> collector=s.web.auditCallback,evidence=s.web.evidenceCallback;JSONObject service=response(q);String request=String.valueOf(q.id);
      if(late.equals("configuration"))s.web.settings.desktop=true;if(late.equals("document"))s.web.commit(true,"8");if(late.equals("endpoint"))s.prefs.put("requestIdentityEndpoint","https://changed.example/pocketchat-identity/v1/");if(late.equals("cancel"))q.cancel();
      collector.accept(J.obj("id",request,"requestIdentity",J.obj()).toString());evidence.accept(service.toString());
      check("Late collector cannot record after ownership changes: "+late,!q.active&&s.observed==0&&s.audit.recorded==0&&s.audit.report.length()==0);
    }
  }
  static void openProof()throws Exception{
    ChatSession s=session();Object old=s.web.identityAuditNativeOpen();GeckoWebView.TimeZoneGate replacement=new GeckoWebView.TimeZoneGate();replacement.ready=true;s.web.timeZoneGates.put(s.web.current,replacement);
    Native n=new Native(s.web.current,"native_session_"+ordinal,replacement.epoch);s.timeZone.prepare(s.web.current,n.sid,n.epoch,n,ready->s.web.finishTimeZone(s.web.current,replacement,ready));accept(s,n);
    List<Boolean> result=new ArrayList<>();s.web.awaitIdentityAuditDocumentProof(s.web.url,s.navigationEpoch,s.web.current,s.web.runtime,old,result::add);
    check("Actual proof rejects the same SDK object with a different open gate",result.equals(Arrays.asList(false)));
  }
  public static void main(String[] args)throws Exception{root=Paths.get(args[0]);Files.createDirectories(root);legal();configurationChanges();proofFailure();preflightAndScope();reportLifecycle();openProof();System.out.println(J.obj("status","passed","passed",checks.size(),"total",checks.size(),"checks",new JSONArray(checks)));}
}
final class Native implements GeckoTimeZoneController.NativeAccess {
  final Object session;final String sid,epoch;String context="7",zone="",readToken,applyToken;Consumer<String> readSuccess,applySuccess;Consumer<Throwable> readFailure,applyFailure;boolean live=true;
  Native(Object session,String sid,String epoch){this.session=session;this.sid=sid;this.epoch=epoch;}
  public boolean current(){return live;}public void read(String token,Consumer<String> ok,Consumer<Throwable> fail){readToken=token;readSuccess=ok;readFailure=fail;}public void apply(String zone,String token,Consumer<String> ok,Consumer<Throwable> fail){this.zone=zone;applyToken=token;applySuccess=ok;applyFailure=fail;}
  String ack(String token,String zone,String context){return J.obj("schema",1,"status","applied","requestToken",token,"sessionId",sid,"requestedZoneId",zone,"nativeZoneId",zone,"contextId",context,"nativeSettingReadback",true,"scope","top-browsing-context","workerCoverageVerified",false,"serviceWorkerCoverageVerified",false).toString();}
}
final class WorkQueue implements Executor {final Deque<Runnable> tasks=new ArrayDeque<>();public void execute(Runnable r){tasks.add(r);}void drain(){while(!tasks.isEmpty())tasks.remove().run();}}
final class HandlerBoundary {
 final WorkQueue immediate=new WorkQueue();final Map<Runnable,Long> delayed=new LinkedHashMap<>();void post(Runnable r){immediate.execute(r);}void postDelayed(Runnable r,long delay){delayed.put(r,delay);}void removeCallbacks(Runnable r){delayed.remove(r);}void drain(){immediate.drain();}void fire(long delay){for(Map.Entry<Runnable,Long> e:new ArrayList<>(delayed.entrySet()))if(e.getValue()==delay){delayed.remove(e.getKey());e.getKey().run();}drain();}
}
final class ChatSession {
 final TestContext context;final WorkQueue environmentIo=new WorkQueue();final HandlerBoundary handler=new HandlerBoundary();final Privacy privacy=new Privacy();final Guard guard=new Guard();final Prefs prefs=new Prefs();final PageMemory pageMemory=new PageMemory();final GeckoWebView web;final GeckoTimeZoneController timeZone;final EnvironmentAudit audit;
 String environmentId=GeckoTimeZoneHost.ID;int environmentGeneration=4;boolean deleted,navigating,networkReady=true,deferInspect;long connectionEpoch=1,navigationEpoch=1,fileWorkGeneration=1,revision=1;int completions,observed;Consumer<JSONObject> pendingInspect;
 ChatSession(TestContext c){context=c;web=new GeckoWebView(this);timeZone=new GeckoTimeZoneController(this);audit=new EnvironmentAudit(this);}void pump(){for(int i=0;i<100&&(!environmentIo.tasks.isEmpty()||!handler.immediate.tasks.isEmpty());i++){environmentIo.drain();handler.drain();}if(!environmentIo.tasks.isEmpty()||!handler.immediate.tasks.isEmpty())throw new AssertionError("unbounded controlled queues");}
 boolean currentReplyActive(){return false;}boolean resourceFilesUncertain(){return false;}boolean internalNetwork(){return false;}long identityAuditAppliedRevision(){return revision;}void requestTaskGuardStatus(String reason,Consumer<Guard> done){done.accept(guard);}void updateBrowserActivity(){}void changed(){}void setStatus(String text){}void identityObserved(JSONObject report){observed++;}
 void beginNavigation(String url,String status){navigationEpoch++;navigating=true;}void finishNavigation(String message,boolean failed){navigating=false;}void navigate(String url,String status){web.url=url;navigationEpoch++;}
 void asyncDriver(String name,JSONObject input,int timeout,Consumer<JSONObject> done){if(timeout!=2000)throw new AssertionError("original preflight budget");if(name.equals("web-inspect")){if(deferInspect){pendingInspect=done;return;}done.accept(J.obj("busy",false,"url",web.url));}else if(name.equals("page-state")){done.accept(J.obj("ok",true,"url",web.url,"documentId","document-0123456789abcdef","draftComplete",true,"draftLength",0,"draft",""));}else throw new AssertionError(name);}
}
final class EnvironmentAudit {
 static final String OBSERVATION_EXECUTION_ID=UUID.randomUUID().toString();final ChatSession session;final RequestIdentityAuditSession requestIdentity;final ServiceProbe serviceProbe=new ServiceProbe();boolean running,networkRun,geckoRun;String lastError="",auditUrl="";long serial,auditNavigation,identityAppliedRevision;Runnable completed;JSONObject report=new JSONObject(),requestIdentityReport=new JSONObject();int retired,recorded,saves;
 EnvironmentAudit(ChatSession s){session=s;requestIdentity=new RequestIdentityAuditSession(this);}boolean current(long id){return running&&serial==id;}void retirePageCheck(){retired++;}/* Dedicated request-identity fixture has no pending ordinary audit; keep its original retirement counter. */void nativeDocumentProofChanged(Object nativeSession,String epoch){retirePageCheck();}void cleanup(){running=false;}void refresh(boolean force){}boolean save(){saves++;return true;}void decorateObservation(JSONObject report,String url,long navigation){}void recordObservation(JSONObject report,String url){recorded++;}
 /*@@AUDIT@@*/
}
final class GeckoWebView {
 static final String VERSION="GeckoView 157.0 HOST SDK BOUNDARY";final ChatSession owner;GeckoSession current=new GeckoSession();Object runtime=new Object();boolean destroyed,visible,protectedNetwork=true;String url="";long identityPolicyRevision=1;int loads,auditCalls,evidenceCalls;Consumer<String> auditCallback,evidenceCallback;final GeckoSettings settings=new GeckoSettings();final Map<GeckoSession,String> locations=new IdentityHashMap<>();final Set<GeckoSession> popups=Collections.newSetFromMap(new IdentityHashMap<GeckoSession,Boolean>());final Map<GeckoSession,TimeZoneGate> timeZoneGates=new IdentityHashMap<>();WebExtension.Port routePort=new WebExtension.Port();final NativeProtection nativeProtection=new NativeProtection();final Metadata metadata=new Metadata();ExitIpPage exitIpPage;
 GeckoWebView(ChatSession s){owner=s;locations.put(current,"");}static boolean active(GeckoWebView v){return !v.destroyed;}Object nativeRuntimeIdentity(){return runtime;}GeckoSettings getSettings(){return settings;}String getUrl(){return url;}boolean hasVisibleDocument(){return visible;}boolean protectionAllowsNetwork(){return protectedNetwork;}String identityLanguage(){return "en-US";}void timezoneConfigurationChanged(){}void loadUrl(String target){loads++;}void runEnvironmentAudit(JSONObject input,Consumer<String> result){auditCalls++;auditCallback=result;}void cancelEnvironmentAudit(){}
 void requestIdentityScope(JSONObject input,Consumer<String> done){String action=input.optString("action");if(action.equals("register"))done.accept(J.obj("ok",true,"nonce",input.optString("nonce"),"credentialFilter",true,"redirectsBlocked",true).toString());else if(action.equals("evidence")){evidenceCalls++;evidenceCallback=done;}else if(action.equals("cancel"))done.accept("{}");else throw new AssertionError(action);}
 Native commit(boolean revalidate,String context){TimeZoneGate gate=timeZoneGates.get(current);if(gate==null){gate=new TimeZoneGate();timeZoneGates.put(current,gate);}final TimeZoneGate selected=gate;if(revalidate){completeTimeZoneProofs(gate,false);completeTimeZoneRequests(gate,false);gate.documentSerial++;gate.revalidating=true;}gate.preparing=true;gate.ready=false;Native n=new Native(current,"native_session_"+RequestIdentityTimezoneHost.ordinal,gate.epoch);n.context=context;if(revalidate)owner.timeZone.revalidate(current,n.sid,gate.epoch,n,ready->finishTimeZone((GeckoSession)n.session,selected,ready));else owner.timeZone.prepare(current,n.sid,gate.epoch,n,ready->finishTimeZone((GeckoSession)n.session,selected,ready));return n;}
 /*@@WEB@@*/
}

package local.pocketchat;
import java.util.*;
import java.util.concurrent.*;
import java.net.*;
import java.io.*;

/** Host scheduling/transport doubles around exact extracted production methods.
 * Does not execute Android, Gecko, real native sockets, or phone memory reclamation. */
final class SystemClock {static long elapsedRealtime(){return 1000;}}
final class Queue {final List<Runnable> tasks=new ArrayList<>();void postDelayed(Runnable r,long d){tasks.add(r);}}
final class InlineExecutor extends AbstractExecutorService {
  boolean closed;public void shutdown(){closed=true;}public List<Runnable> shutdownNow(){closed=true;return Collections.emptyList();}
  public boolean isShutdown(){return closed;}public boolean isTerminated(){return closed;}public boolean awaitTermination(long n,TimeUnit u){return closed;}
  public void execute(Runnable r){r.run();}
}
final class DummyConnection extends HttpURLConnection {
  int disconnects;DummyConnection()throws Exception{super(new URL("https://controlled.invalid/"));}
  public void disconnect(){disconnects++;}public boolean usingProxy(){return false;}public void connect(){}
}
final class Probe {boolean active;int cancels;void cancel(){cancels++;}}
final class Browser {
  String url="https://chatgpt.com/c/original";boolean ready=true;int cancellations,stops;long cancellationEpoch=-1;ChatSession owner;
  String getUrl(){return url;}boolean hasOpenPopup(){return false;}
  void cancelEnvironmentAudit(){cancellations++;cancellationEpoch=owner.navigationEpoch;}
  void stopLoading(){stops++;}
}
final class Guard {boolean blocked;void setBlocked(boolean value){blocked=value;}}
final class PageMemory {int captures;void capture(Runnable r){captures++;r.run();}}
final class Identity {boolean pendingWork(){return false;}}
final class Trace {void page(String s){}}
final class ChatService {static boolean running;}
final class LoginPagePolicy {static boolean login(String s){return false;}}
final class EnvironmentAudit {
  final ChatSession session;final Probe serviceProbe=new Probe(),requestIdentity=new Probe();
  Object nativeRuntimeIdentity;
  boolean running=true,geckoRun=true;long serial=5,auditNavigation=7;String auditUrl="https://chatgpt.com/c/original",lastError="",report="previous report bytes";
  Runnable completed;FutureTask<Void> nativeWork;final InlineExecutor closer=new InlineExecutor();HttpURLConnection connection;
  EnvironmentAudit(ChatSession s){session=s;nativeWork=new FutureTask<>(()->null);}
  boolean requestIdentityPageSelected(){return requestIdentity.active;}
  __CURRENT__
  __CANCEL__
  __CLEANUP__
  __RETIRE__
}
final class ChatSession {
  final Browser web=new Browser();EnvironmentAudit audit;final Queue handler=new Queue();final Guard guard=new Guard();final PageMemory pageMemory=new PageMemory();final Trace trace=new Trace();final Identity identity=new Identity();
  Object pending;boolean uiVisible,deleted,submitting,operation,inFlight,reply,unknownPage,filesActive,transferActive,connecting,navigating,websiteRecovering,recoveryScheduled,configurationCapture;
  long resourceObserverEpoch=7,navigationEpoch=7,navigationStarted,navigationMono,firstPageVisible,pageUsableAt,connectionEpoch=3,recoveryToken=4;
  boolean replyStalled,websiteConnectionIssue,navigationFailed,spaTransition,documentNavigationSeen,navigationDispatched,awaitNewDocument,networkReady=true;
  String navigationTarget="",navigationLabel="",lastDocumentId="original-document",priorDocumentId="",spaSignature="",status="",draft="retained draft";int spaStable,updates;
  ChatSession(){web.owner=this;audit=new EnvironmentAudit(this);}
  boolean currentReplyActive(){return reply;}boolean resourcePageUnknown(){return unknownPage;}boolean fileWorkActive(){return filesActive;}
  void resetReplyStability(){}void navigationTimeout(long n){}void setStatus(String s){status=s;}
  void finishResourceInspection(){inFlight=false;updateBrowserActivity();}
  void updateBrowserActivity(){updates++;browserWorkActive();}
  __BROWSER_ACTIVE__
  __BEGIN_NAVIGATION__
  __INVALIDATE_CONNECTION__
}
public final class AuditRetirementHost {
  static int checks,invalidatedChecksStillRunning,cancelledFutures,disconnectedConnections,idleActivityHeld;static boolean expectFixed;
  static void check(String name,boolean pass){if(!pass)throw new AssertionError(name);checks++;System.out.println("PASS "+name);}
  static ChatSession armed()throws Exception{ChatSession s=new ChatSession();s.audit.connection=new DummyConnection();return s;}
  static void change(ChatSession s,boolean route){if(route)s.invalidateConnection();else s.beginNavigation("https://chatgpt.com/c/next","loading");}
  static void ordinary(boolean route)throws Exception{
    ChatSession s=armed();EnvironmentAudit a=s.audit;DummyConnection c=(DummyConnection)a.connection;FutureTask<Void> work=a.nativeWork;long serial=a.serial,epoch=s.navigationEpoch;int[] done={0};a.completed=()->done[0]++;
    Object pending=s.pending;String report=a.report,draft=s.draft;
    check("Ordinary page check retains browser activity before invalidation "+route,s.browserWorkActive());
    change(s,route);
    if(a.running)invalidatedChecksStillRunning++;if(work.isCancelled())cancelledFutures++;disconnectedConnections+=c.disconnects;
    check("Native check running matches measured before/after "+route,a.running!=expectFixed);
    check("Pending native future cancellation matches measured before/after "+route,work.isCancelled()==expectFixed);
    check("Native disconnect matches measured before/after "+route,c.disconnects==(expectFixed?1:0));
    check("Completion callback is bounded "+route,done[0]==(expectFixed?1:0));
    check("Old completion identity is rejected immediately only after fix "+route,a.current(serial)!=expectFixed);
    check("Page-side cancellation still targets captured old epoch "+route,s.web.cancellations==(expectFixed?1:0)&&(!expectFixed||s.web.cancellationEpoch==epoch));
    check("Environment navigation epoch continues normally "+route,s.navigationEpoch==epoch+1);
    check("Previous report, draft and pending identity preserved "+route,report.equals(a.report)&&draft.equals(s.draft)&&pending==s.pending);
    if(!route)check("Navigation remains work while check is retired",s.navigating&&s.browserWorkActive());
    s.navigating=false;
    if(s.browserWorkActive())idleActivityHeld++;
    check("Otherwise-idle activity retention matches before/after "+route,s.browserWorkActive()!=expectFixed);
    change(s,route);check("Repeated invalidation does not repeat retired callback "+route,done[0]==(expectFixed?1:0)&&c.disconnects==(expectFixed?1:0));
  }
  static void dedicated()throws Exception{
    for(String kind:new String[]{"identity","service","nonGecko","finished"}){
      ChatSession s=armed();EnvironmentAudit a=s.audit;DummyConnection c=(DummyConnection)a.connection;
      if(kind.equals("identity"))a.requestIdentity.active=true;
      if(kind.equals("service"))a.serviceProbe.active=true;
      if(kind.equals("nonGecko"))a.geckoRun=false;
      if(kind.equals("finished"))a.running=false;
      s.beginNavigation("https://controlled.invalid/check","checking");
      check("Ordinary navigation does not cancel unrelated "+kind,c.disconnects==0&&a.serviceProbe.cancels==0&&a.requestIdentity.cancels==0);
    }
  }
  static void documentControls()throws Exception{
    ChatSession replaced=armed();replaced.web.url="https://chatgpt.com/c/already-replaced";DummyConnection c=(DummyConnection)replaced.audit.connection;
    replaced.beginNavigation(replaced.web.url,"new document");
    check("A replaced document receives no cancellation intended for the old one",replaced.web.cancellations==0);
    check("A replaced document still retires obsolete native work",c.disconnects==(expectFixed?1:0));
    ChatSession noAudit=armed();noAudit.audit=null;noAudit.beginNavigation("https://chatgpt.com/c/next","loading");noAudit.invalidateConnection();
    check("Early session navigation and invalidation allow absent audit",noAudit.navigationEpoch==9);
  }
  static void workProtection()throws Exception{
    for(String kind:new String[]{"reply","pending","submission","uploadOrUncertainSelection","download","inspection","configuration","recovery","unknownPage","foreground"}){
      ChatSession s=armed();
      switch(kind){case "reply":s.reply=true;break;case "pending":s.pending=new Object();break;case "submission":s.submitting=true;break;case "uploadOrUncertainSelection":s.filesActive=true;break;case "download":s.transferActive=true;break;case "inspection":s.inFlight=true;break;case "configuration":s.configurationCapture=true;break;case "recovery":s.recoveryScheduled=true;break;case "unknownPage":s.unknownPage=true;break;case "foreground":s.uiVisible=true;break;}
      s.beginNavigation("https://chatgpt.com/c/next","loading");s.navigating=false;
      check("Retiring optional check keeps actual browser predicate active for "+kind,s.browserWorkActive());
    }
  }
  public static void main(String[] args)throws Exception{
    expectFixed=Boolean.parseBoolean(args[0]);ordinary(false);ordinary(true);dedicated();documentControls();workProtection();
    System.out.println("METRICS {\"invalidatedChecksStillRunning\":"+invalidatedChecksStillRunning+",\"cancelledFutures\":"+cancelledFutures+",\"disconnectedConnections\":"+disconnectedConnections+",\"idleActivityHeld\":"+idleActivityHeld+"}");
    System.out.println("TOTAL "+checks);System.out.println("SCOPE host extracted methods, fake scheduling and native connection; no Android/Gecko/phone memory measurement");
  }
}

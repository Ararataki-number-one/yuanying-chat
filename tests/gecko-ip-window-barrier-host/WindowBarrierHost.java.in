package local.pocketchat;

import java.io.IOException;
import java.util.*;
import java.util.function.Consumer;
import org.json.*;

/** Exact selected app methods; every SDK, controller and transport edge is named Boundary. */
public final class WindowBarrierHost {
  static final JSONArray checks=new JSONArray();
  static void check(String name,boolean okay){checks.put(J.obj("name",name,"pass",okay));if(!okay)throw new AssertionError(name);}
  static void positive(boolean revalidate){
    WebBoundary web=new WebBoundary();SessionBoundary session=web.current;PortBoundary port=web.routePort;web.begin(revalidate);
    check("Pending window has zero IP transport invocations "+revalidate,web.lookups.isEmpty());
    check("Original controller scheduling is preserved "+revalidate,web.owner.timeZone.calls.size()==(revalidate?1:0));
    web.owner.handler.drain();check("Pending result cannot invent readiness "+revalidate,web.lookups.isEmpty());
    session.pending.succeed("SDK completion is a readiness boundary, not a UA proof");
    check("SDK completion does not synchronously enter app continuation "+revalidate,web.lookups.isEmpty());web.owner.handler.drain();
    check("True window forwards one IP lookup "+revalidate,web.lookups.size()==1&&web.owner.timeZone.calls.size()==1);
    ControllerBoundary.Call call=web.owner.timeZone.calls.get(0);WebBoundary.LookupBoundary lookup=web.lookups.get(0);
    check("Positive lookup preserves exact session gate and current port "+revalidate,lookup.session==session&&lookup.gate==web.timeZoneGates.get(session)&&lookup.port==port);
    check("Positive lookup preserves session id epoch token and callback objects "+revalidate,call.session==session&&call.sessionId.equals(session.getId())&&call.epoch.equals(lookup.gate.epoch)&&lookup.token.equals(call.token)&&lookup.ok==call.ok&&lookup.fail==call.fail);
    check("Lookup transport boundary never invents native or page admission "+revalidate,!lookup.gate.ready&&web.finished.isEmpty()&&call.errors.isEmpty());
    check("Success removes only the original five second deadline "+revalidate,web.owner.handler.tasks.isEmpty());
  }
  static void failed(boolean revalidate,String failure){
    WebBoundary web=new WebBoundary();web.current.throwRead=failure.equals("throw");web.begin(revalidate);
    if(failure.equals("timeout")){
      web.owner.handler.advance(4999);check("Original deadline remains pending through4999 "+revalidate,web.lookups.isEmpty()&&web.owner.timeZone.calls.size()==(revalidate?1:0));web.owner.handler.advance(1);
    }else if(failure.equals("error"))web.current.pending.fail(new IOException("Declared SDK failure"));
    web.owner.handler.drain();
    check("False window never invokes IP lookup "+revalidate+" "+failure,web.lookups.isEmpty());
    check("Original first consumer may still prepare a legacy-capable controller "+revalidate+" "+failure,web.owner.timeZone.calls.size()==1);
    ControllerBoundary.Call call=web.owner.timeZone.calls.get(0);
    check("False window reports one IP failure without a response "+revalidate+" "+failure,call.errors.size()==1&&call.responses.isEmpty()&&web.finished.equals(List.of(false)));
    if(failure.equals("timeout")){web.current.pending.succeed("Late SDK success");web.owner.handler.drain();check("Late SDK success cannot revive timed out IP access "+revalidate,web.lookups.isEmpty()&&call.errors.size()==1&&web.owner.timeZone.calls.size()==1);}
  }
  static void changed(String kind){
    WebBoundary web=new WebBoundary();web.begin(true);ControllerBoundary.Call call=web.owner.timeZone.calls.get(0);SessionBoundary original=web.current;
    original.pending.succeed("SDK ready");web.owner.handler.one();
    check("Revalidation lookup still waits for its queued consumer "+kind,web.lookups.isEmpty());
    if(kind.equals("closed"))original.open=false;
    if(kind.equals("destroyed"))web.destroyed=true;
    if(kind.equals("deleted"))web.owner.deleted=true;
    if(kind.equals("port"))web.routePort=new PortBoundary();
    if(kind.equals("retired"))web.timeZoneGates.remove(original);
    if(kind.equals("document"))web.timeZoneGates.get(original).documentSerial++;
    if(kind.equals("route"))web.owner.guard.permitted=false;
    if(kind.equals("reload"))web.ipRouteNeedsReload=true;
    web.owner.handler.drain();
    check("Changed scope cannot invoke IP transport "+kind,web.lookups.isEmpty());
    check("Changed scope reports failure rather than native success "+kind,call.errors.size()==1&&call.responses.isEmpty());
  }
  static void manualRead(){
    WebBoundary web=new WebBoundary();web.owner.timeZone.startIp=false;web.begin(false);web.current.pending.fail(new IOException("SDK unavailable"));web.owner.handler.drain();
    check("Original unready controller entry remains available for system fallback",web.owner.timeZone.calls.size()==1);
    ControllerBoundary.Call call=web.owner.timeZone.calls.get(0);List<Throwable> errors=new ArrayList<>();call.access.read("manual-read",value->{throw new AssertionError("No native ACK");},errors::add);web.owner.handler.drain();
    check("Original native read also rejects a false window",errors.size()==1&&web.nativeSends.isEmpty()&&web.lookups.isEmpty());
    web.owner.timeZone.complete(call,true);check("Declared legacy controller fallback remains unchanged",web.finished.equals(List.of(true)));
  }
  public static void main(String[] args){
    if(args.length>0){switch(args[0]){case "pending":positive(true);break;case "false":failed(true,"error");break;case "scope":changed("document");break;default:throw new AssertionError("Unknown focused control");}}
    else{for(boolean revalidate:new boolean[]{false,true}){positive(revalidate);for(String mode:new String[]{"error","throw","timeout"})failed(revalidate,mode);}for(String kind:new String[]{"closed","destroyed","deleted","port","retired","document","route","reload"})changed(kind);manualRead();}
    System.out.println(J.obj("schema",1,"status","passed","passed",checks.length(),"total",checks.length(),"checks",checks,"actualAndroidExecution",false,"actualGeckoExecution",false,"actualIpTransportExecution",false,"nativeReadbackInvented",false));
  }
}
class WebBoundary {
  final OwnerBoundary owner=new OwnerBoundary();final SessionBoundary current=new SessionBoundary();PortBoundary routePort=new PortBoundary();
  final Map<SessionBoundary,String> locations=new IdentityHashMap<>();final Set<SessionBoundary> popups=new HashSet<>();
  final Map<SessionBoundary,TimeZoneGate> timeZoneGates=new IdentityHashMap<>();
  final MetadataBoundary metadata=new MetadataBoundary();ExitIpPageBoundary exitIpPage;boolean destroyed,ipRouteNeedsReload;
  final List<LookupBoundary> lookups=new ArrayList<>();final List<String> nativeSends=new ArrayList<>();final List<Boolean> finished=new ArrayList<>();int proofCompletions,requestCompletions;
  WebBoundary(){locations.put(current,"");}
  void begin(boolean revalidate){ResultBoundary.handler=owner.handler;startTimeZone(current,ignored->{},revalidate);}
  boolean autoIpMode(){return true;}String ipRouteStamp(){return "route-stamp-boundary";}
  JSONObject timeZoneStatus(){return J.obj("scope","host-only-controller-boundary");}
  void completeTimeZoneProofs(TimeZoneGate gate,boolean ready){proofCompletions++;}
  void completeTimeZoneRequests(TimeZoneGate gate,boolean ready){requestCompletions++;}
  void finishTimeZone(SessionBoundary session,TimeZoneGate gate,boolean ready){if(timeZoneGates.get(session)!=gate)throw new AssertionError("Foreign gate completion");gate.preparing=false;gate.ready=ready;finished.add(ready);}
  static final class LookupBoundary {final SessionBoundary session;final TimeZoneGate gate;final PortBoundary port;final String token;final Consumer<String> ok;final Consumer<Throwable> fail;LookupBoundary(SessionBoundary s,TimeZoneGate g,PortBoundary p,String t,Consumer<String> o,Consumer<Throwable> f){session=s;gate=g;port=p;token=t;ok=o;fail=f;}}
  // Count the actual app-method boundary only. Real IP fetch, lease, native
  // policy and wire are covered by their separate production integration gates.
  void lookupIpTimeZone(SessionBoundary session,TimeZoneGate gate,String token,Consumer<String> ok,Consumer<Throwable> fail){lookups.add(new LookupBoundary(session,gate,routePort,token,ok,fail));}
  void sendTimeZone(PortBoundary port,SessionBoundary session,TimeZoneGate gate,String kind,String zone,String token,Consumer<String> ok,Consumer<Throwable> fail){nativeSends.add(kind);}
  @METHODS@
}
class OwnerBoundary {boolean deleted;final HandlerBoundary handler=new HandlerBoundary();final GuardBoundary guard=new GuardBoundary();final ControllerBoundary timeZone=new ControllerBoundary();}
class GuardBoundary {boolean permitted=true;boolean allowed(){return permitted;}}
class MetadataBoundary {JSONObject timeZonePolicy;}
class ExitIpPageBoundary {SessionBoundary aux;}
class PortBoundary {}
class SessionBoundary {static int next;final String id="declared-sdk-session-"+(++next);boolean open=true,throwRead;ResultBoundary<String> pending;boolean isOpen(){return open;}String getId(){return id;}ResultBoundary<String> getUserAgent(){if(throwRead)throw new IllegalStateException("Declared SDK error");pending=new ResultBoundary<>();return pending;}}
class IdentityBoundary {@IDENTITY@}
class ControllerBoundary {
  interface NativeAccess {boolean current();String ipRouteStamp();void lookupIp(String token,Consumer<String> ok,Consumer<Throwable> fail);void read(String token,Consumer<String> ok,Consumer<Throwable> fail);void apply(String zone,String token,Consumer<String> ok,Consumer<Throwable> fail);}
  static final class Call {final Object session;final String sessionId,epoch,token="a".repeat(64);final NativeAccess access;final Consumer<Boolean> done;final List<String> responses=new ArrayList<>();final List<Throwable> errors=new ArrayList<>();final Consumer<String> ok=responses::add;final Consumer<Throwable> fail;Call(Object session,String id,String epoch,NativeAccess access,Consumer<Boolean> done){this.session=session;sessionId=id;this.epoch=epoch;this.access=access;this.done=done;fail=error->{errors.add(error);done.accept(false);};}}
  final List<Call> calls=new ArrayList<>();boolean startIp=true;
  void prepare(Object session,String id,String epoch,NativeAccess access,Consumer<Boolean> done){Call call=new Call(session,id,epoch,access,done);calls.add(call);if(startIp)access.lookupIp(call.token,call.ok,call.fail);}
  void revalidate(Object session,String id,String epoch,NativeAccess access,Consumer<Boolean> done){prepare(session,id,epoch,access,done);}
  boolean popupAllowed(){return false;}boolean allowed(Object session,String epoch){return false;}
  void complete(Call call,boolean allowed){call.done.accept(allowed);}
}
class HandlerBoundary {
  static final class Task {final Runnable run;final long when;Task(Runnable run,long when){this.run=run;this.when=when;}}
  final List<Task> tasks=new ArrayList<>();long now;
  void post(Runnable task){postDelayed(task,0);}void postDelayed(Runnable task,long delay){tasks.add(new Task(task,now+delay));}
  void removeCallbacks(Runnable task){tasks.removeIf(row->row.run==task);}
  void one(){for(int i=0;i<tasks.size();i++)if(tasks.get(i).when<=now){tasks.remove(i).run.run();return;}throw new AssertionError("No ready declared UI task");}
  void drain(){int count=0;while(tasks.stream().anyMatch(task->task.when<=now)){if(++count>1000)throw new AssertionError("Unbounded host queue");one();}}
  void advance(long delay){now+=delay;drain();}
}
class ResultBoundary<T> {
  static HandlerBoundary handler;final HandlerBoundary dispatcher=handler;boolean done;T value;Throwable error;final List<Runnable> listeners=new ArrayList<>();
  void accept(Consumer<T> okay,Consumer<Throwable> failed){Runnable call=()->{if(error==null)okay.accept(value);else failed.accept(error);};if(done)dispatcher.post(call);else listeners.add(call);}
  void succeed(T supplied){if(done)throw new AssertionError("Repeated SDK completion");done=true;value=supplied;for(Runnable listener:listeners)dispatcher.post(listener);listeners.clear();}
  void complete(T supplied){succeed(supplied);}void fail(Throwable supplied){if(done)throw new AssertionError("Repeated SDK completion");done=true;error=supplied;for(Runnable listener:listeners)dispatcher.post(listener);listeners.clear();}
}

package local.pocketchat;
import java.util.*;
import org.json.*;
/** Actual extracted production busy predicates, with explicit surrounding stubs.
 * This tests gate decisions, not Android scheduling or applying a real route. */
final class ChatSession {
  static ChatSession selected;static ChatSession peek(){return selected;}
  boolean deleted,submitting,operation,transferActive,navigating,connecting,recoveryScheduled;
  int resourceChoosers,resourceFilePreparations;long navigationEpoch=7,resourceWebsiteEpoch=-1;
  boolean resourceWebsiteUploading;JSONObject pending,state=J.obj("busy",false);JSONArray attachments=new JSONArray();
  final ResourceUploadState resourceUploads=new ResourceUploadState();final Browser web=new Browser();final Memory pageMemory=new Memory();
  // This legacy workload fixes the current actor/document and observes file
  // work only. Full task freshness/ownership admission is covered separately.
  final Identity identity=new Identity();long fileWorkGeneration;
  TaskGuardSnapshot taskGuardSnapshot(){return new TaskGuardSnapshot(this);}
  __UPLOADING__
  __FILE_WORK_ACTIVE__
  __RESOURCE_FILES_ACTIVE__
}
final class Browser {long identityPolicyRevision=2;String getUrl(){return "https://chatgpt.com/c/test";}}
final class Identity {long editSerial=3;}
/** Declared snapshot boundary; fileBusy comes from the actual extracted gate. */
final class TaskGuardSnapshot {
  final boolean known=true,fileBusy;
  final int slot=0,generation=1;final String environmentId="file-consumer-fixture";
  final String resourceBinding="file-consumer-binding",documentId="doc";
  final long navigationEpoch,workGeneration;
  TaskGuardSnapshot(ChatSession session){fileBusy=session.fileWorkActive();navigationEpoch=session.navigationEpoch;workGeneration=session.fileWorkGeneration;}
}
final class Memory {String scope(){return "scope";}}
final class MainActivity {static boolean chatUrl(String url){return true;}}
final class WebReplyObserver {static boolean same(String a,String b){return a.equals(b);}}
final class BrowserRuntimePolicy {static boolean sameDocument(String a,String b){return a.equals(b);}}
final class Profile {Prefs getSharedPreferences(String name,int mode){return new Prefs();}}
final class Prefs {String getString(String key,String fallback){return fallback;}}
final class NativeNetwork {boolean starting,measuringLatency;static final NativeNetwork instance=new NativeNetwork();static NativeNetwork get(Profile profile){return instance;}}
final class NetworkRegion {__BACKGROUND_BUSY__}
final class ProfileUi {__WORKING__}
final class NetworkUiProvider {
  boolean saving;final Profile profile=new Profile();
  static final class Transition {ChatSession session;boolean capture=true,immediate;long epoch=7,browserPolicy,identityEdit;String url="https://chatgpt.com/c/test",scope="scope";TaskGuardSnapshot work;
    Transition(){ChatSession selected=ChatSession.peek();if(selected==null)throw new AssertionError("Cold transition is outside the file-consumer host");browserPolicy=selected.web.identityPolicyRevision;identityEdit=selected.identity.editSerial;work=selected.taskGuardSnapshot();}
  }
  boolean owns(Transition transition){return true;}
  boolean currentEnvironment(Transition transition){return true;}
  boolean coldPending(){throw new AssertionError("Cold admission is outside the file-consumer host");}
  static boolean taskIdle(ChatSession session,TaskGuardSnapshot guard){
    if(session.pending!=null||session.submitting||session.operation||session.transferActive||session.state.optBoolean("busy"))throw new AssertionError("Non-file task admission is outside the file-consumer host");
    return guard!=null&&guard.known&&!guard.fileBusy;
  }
  __FENCE_IDLE__
}
public final class FileWorkConsumersHostTest {
  static int checks;
  static void gate(String name,ChatSession session,boolean busy){
    ChatSession.selected=session;NetworkUiProvider.Transition transition=new NetworkUiProvider.Transition();transition.session=session;
    if(session.fileWorkActive()!=busy||NetworkRegion.backgroundBusy(session)!=busy||ProfileUi.working(session)!=busy||new NetworkUiProvider().fenceIdle(transition)==busy)throw new AssertionError(name);
    checks++;System.out.println("PASS "+name);
  }
  public static void main(String[] args){
    ChatSession session=new ChatSession();gate("Idle gates agree before file work",session,false);
    session.resourceChoosers=1;gate("Chooser blocks maintenance UI and final capture fence",session,true);session.resourceChoosers=0;
    session.resourceFilePreparations=1;gate("Preparation beginning after capture blocks final settings fence",session,true);session.resourceFilePreparations=0;
    session.resourceUploads.add(Arrays.asList("report.txt"),"doc",7,1000);gate("Unknown selection blocks every work consumer without fabricating an upload",session,true);
    String id=session.resourceUploads.batches.keySet().iterator().next();
    for(int sequence=1;sequence<=2;sequence++)session.resourceUploads.observe(J.obj("ok",true,"documentId","doc","batches",J.arr(J.obj("batchId",id,"sequence",sequence,"files",J.arr(J.obj("name","report.txt","state","removed"))))),"doc",7);
    gate("Confirmed removal releases all three consumers together",session,false);
    session.resourceWebsiteEpoch=7;session.resourceWebsiteUploading=true;gate("Current website upload blocks all consumers",session,true);
    session.resourceWebsiteEpoch=6;gate("An old document upload cannot keep the new page busy",session,false);
    session.attachments=J.arr(J.obj("state","uploading"));gate("Legacy uploading remains protected during migration",session,true);
    session.attachments=J.arr(J.obj("state","ready"));gate("Completed legacy files alone do not keep gates busy",session,false);
    System.out.println("TOTAL "+checks);
  }
}

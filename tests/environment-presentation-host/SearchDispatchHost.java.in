package local.pocketchat;
import java.util.*;
/** The two actual source callbacks use a controlled Handler, cached-snapshot and rendering boundaries. */
class View {static final int GONE=8,VISIBLE=0;}
class EnvironmentHomeSnapshot {boolean stars;}
class DesignUi {static class Stars {static void setting(boolean value){}}}
public final class SearchDispatchHost {
  static int checks;static void check(boolean value,String label){checks++;if(!value)throw new AssertionError(label);}
  static class ClockHandler {
    final Set<Runnable> pending=new LinkedHashSet<>();int posts;
    void removeCallbacks(Runnable value){pending.remove(value);}
    void postDelayed(Runnable value,long delay){if(delay!=48)throw new AssertionError("search delay");posts++;pending.add(value);}
    void flush(){List<Runnable> jobs=new ArrayList<>(pending);pending.clear();for(Runnable job:jobs)job.run();}
  }
  static class Current {
    final ClockHandler handler=new ClockHandler();boolean workspaceVisible=true;Object snapshot;int catalogReads,renders;
    static final String SNAPSHOT_READ_PROBLEM="环境记录暂时无法读取，请稍后重试";
    boolean snapshotReadIssue,destroyed,finishing;
    static final class Label {String text="";int visibility;void setText(String next){text=next;}void setVisibility(int next){visibility=next;}}
    final Label problem=new Label();
    boolean isDestroyed(){return destroyed;}boolean isFinishing(){return finishing;}
    final Runnable searchRender=this::renderCached;
    CURRENT_SHOW_PROBLEM
    CURRENT_ACCEPT
    void loadOnce(){snapshot=new Object();catalogReads++;}
    void renderSnapshot(Object value){if(value!=snapshot)throw new AssertionError("foreign snapshot");renders++;}
    CURRENT_RENDER
    CURRENT_SCHEDULE
    CURRENT_CALLBACK
  }
  static class Baseline {
    int catalogReads,renders;String lastSignature="";
    void refresh(){catalogReads++;renders++;}
    BASELINE_CALLBACK
  }
  public static void main(String[] args){
    Baseline old=new Baseline();for(int i=0;i<100;i++)old.onTextChanged("typing-"+i,0,0,1);
    Current current=new Current();current.loadOnce();for(int i=0;i<100;i++)current.onTextChanged("typing-"+i,0,0,1);
    check(old.catalogReads==100,"baseline actual callback dispatched100catalog-reading refreshes");check(current.catalogReads==1,"typing reuses initial snapshot with zero new catalog reads");check(current.handler.pending.size()==1,"100events coalesce into one pending render");check(current.renders==0,"input callback does not render synchronously");current.handler.flush();check(current.renders==1,"settled typing renders exactly once");
    current.workspaceVisible=false;for(int i=0;i<100;i++)current.onTextChanged("hidden-"+i,0,0,1);check(current.handler.pending.isEmpty(),"hidden typing schedules no callback");
    current.workspaceVisible=true;current.onTextChanged("pause-next",0,0,1);current.workspaceVisible=false;current.handler.flush();check(current.renders==1,"a queued callback cannot render after pause");
    current.workspaceVisible=true;current.onTextChanged("resume",0,0,1);current.handler.flush();check(current.renders==2,"visible search resumes using current snapshot");
    current.snapshot=null;current.onTextChanged("cold",0,0,1);current.handler.flush();check(current.renders==2,"first-load typing waits for a real snapshot");
    current.workspaceVisible=true;current.showProblem(Current.SNAPSHOT_READ_PROBLEM);check(current.snapshotReadIssue,"read error owns its message");current.acceptSnapshot(new EnvironmentHomeSnapshot());check(!current.snapshotReadIssue&&current.problem.text.isEmpty(),"successful snapshot clears its own transient read error");
    current.showProblem("Copy operation failed");current.acceptSnapshot(new EnvironmentHomeSnapshot());check(current.problem.text.equals("Copy operation failed"),"successful background refresh preserves unrelated operation failure");
    current.workspaceVisible=false;current.showProblem(Current.SNAPSHOT_READ_PROBLEM);current.acceptSnapshot(new EnvironmentHomeSnapshot());check(current.snapshotReadIssue,"hidden success cannot clear visible error state");current.workspaceVisible=true;current.destroyed=true;int rendered=current.renders;current.acceptSnapshot(new EnvironmentHomeSnapshot());check(current.renders==rendered,"destroyed activity rejects accepted snapshot");
    System.out.println("{\"passed\":"+checks+",\"baselineTypingCatalogRefreshes\":"+old.catalogReads+",\"optimizedTypingAdditionalCatalogReads\":"+(current.catalogReads-1)+",\"typingEvents\":100,\"coalescedSearchRenders\":1,\"offscreenCallbacks\":0,\"actualAndroidExecution\":false}");
  }
}

package local.pocketchat;
import java.util.*;
import org.json.*;

/** Exact production members, controlled SDK/Android boundary objects only. */
public final class PageBridgeLifecycleHost {
  static final List<JSONObject> checks=new ArrayList<>();
  static void check(String name,boolean ok){checks.add(J.obj("name",name,"passed",ok));}
  static final String URL="https://chatgpt.com/c/controlled";
  static final class Clock implements BrowserBridgeRequests.Timer {
    final Set<Runnable> tasks=new HashSet<>();
    public void schedule(Runnable r,long delay){tasks.add(r);}
    public void cancel(Runnable r){tasks.remove(r);}
  }
  static final class GeckoSession {
    interface PermissionDelegate {class ContentPermission {}}
    interface NavigationDelegate {void onLocationChange(GeckoSession s,String target,List<PermissionDelegate.ContentPermission> p,Boolean gesture);}
  }
  static final class WebExtension {
    interface MessageDelegate {void onConnect(Port p);}
    interface PortDelegate {void onPortMessage(Object value,Port port);void onDisconnect(Port p);}
    static final class Sender {GeckoSession session;String url;boolean top=true;boolean isTopLevel(){return top;}}
    static final class Port {
      final Sender sender=new Sender();String name="pocketpage";PortDelegate delegate;
      final List<JSONObject> sent=new ArrayList<>();
      Port(GeckoSession s,String url){sender.session=s;sender.url=url;}
      void setDelegate(PortDelegate d){delegate=d;}
      void postMessage(JSONObject value){sent.add(value);}
      void message(JSONObject value){delegate.onPortMessage(value,this);}
    }
  }
  interface ValueCallback<T>{void onReceiveValue(T value);}
  static final class AppAppearance {static boolean dark(){return false;}}
  static final class MainActivity {static final String ORIGIN="https://chatgpt.com";static boolean chatUrl(String s){return s!=null&&s.startsWith(ORIGIN+"/");}}
  static final class LoginPagePolicy {static boolean login(String s){return false;}}
  static final class Owner {
    final Reading reading=new Reading();final Observer webObserver=new Observer();final Prefs prefs=new Prefs();
    int changes,connected,disconnected;void changed(){changes++;}
    void resourceObserverConnected(Object p){connected++;}void resourceObserverDisconnected(Object p){disconnected++;}
  }
  static final class Reading {int measured;void viewportMeasured(float width){measured++;}}
  static final class Observer {int replies,ready;void receive(JSONObject value,Object port){replies++;}void pageReady(){ready++;}}
  static final class Prefs {Prefs edit(){return this;}Prefs putString(String k,String v){return this;}void apply(){}}
  static final class Appearance {
    int receipts,connects,disconnects;
    void receive(Object p,JSONObject data){receipts++;}void disconnect(Object p){disconnects++;}
    boolean connect(Object p,String doc,boolean dark){connects++;return true;}
  }
  static final class Client {void onPageStarted(Object unused,String target,Object icon){}}
  static final class Bridge {
    boolean destroyed;String url=URL;float readingLayout=1;int appearanceRequests,visible;
    // Existing bridge cases display their primary surface, with no auxiliary
    // IP document. Actual surface ownership belongs to the separate overview host.
    boolean auxiliaryPageVisible;
    boolean readingOwnerVisible(){if(auxiliaryPageVisible)throw new AssertionError("Auxiliary IP page is outside this bridge fixture");return true;}
    final Owner owner=new Owner();final Clock clock=new Clock();
    final BrowserBridgeRequests callbacks=new BrowserBridgeRequests(clock,"null");
    final Map<GeckoSession,String> locations=new IdentityHashMap<>(),loadingTargets=new IdentityHashMap<>();
    final Map<GeckoSession,WebExtension.Port> ports=new IdentityHashMap<>();
    final Map<GeckoSession,Float> viewportWidths=new IdentityHashMap<>(),pageScales=new IdentityHashMap<>();
    final Set<GeckoSession> painted=Collections.newSetFromMap(new IdentityHashMap<>()),usable=Collections.newSetFromMap(new IdentityHashMap<>()),crashed=Collections.newSetFromMap(new IdentityHashMap<>()),pendingLoads=Collections.newSetFromMap(new IdentityHashMap<>());
    final Map<GeckoSession,Long> appearanceLoads=new IdentityHashMap<>();
    final Map<WebExtension.Port,Long> appearanceConnections=new IdentityHashMap<>();
    final Map<WebExtension.Port,String> appearanceDocuments=new IdentityHashMap<>();
    final Set<WebExtension.Port> staleAppearanceConnections=Collections.newSetFromMap(new IdentityHashMap<>());
    final Appearance appearanceSync=new Appearance();final Client client=new Client();
    GeckoSession current=new GeckoSession();
    Bridge(){locations.put(current,url);}
    String getUrl(){return url;}void getScale(){}void pageVisible(GeckoSession s){visible++;}void cancelZoom(){}
    void appearance(WebExtension.Port p){appearanceRequests++;}boolean appearancePage(String target){return MainActivity.chatUrl(target);}
    void retireAppearance(WebExtension.Port p){appearanceSync.disconnect(p);appearanceConnections.remove(p);appearanceDocuments.remove(p);staleAppearanceConnections.remove(p);}
    /* PAGE_MESSAGES */;
    /* APPEARANCE_COMMITTED */
    /* APPEARANCE_READY */
    /* EVALUATE */
    /* AUDIT */
    final GeckoSession.NavigationDelegate navigation=new GeckoSession.NavigationDelegate(){
      /* LOCATION */
    };
    WebExtension.Port connect(GeckoSession s){WebExtension.Port p=new WebExtension.Port(s,locations.get(s));pageMessages.onConnect(p);return p;}
    void commit(){appearanceLoads.put(current,appearanceLoads.getOrDefault(current,0L)+1);pendingLoads.add(current);navigation.onLocationChange(current,url,Collections.emptyList(),false);}
  }
  static JSONObject result(int id,String value){return J.obj("kind","result","id",id,"result",value);}
  static JSONObject ready(String document){return J.obj("kind","documentReady","url",URL,"appearanceProtocol",1,"appearanceDocument",document);}
  static int request(Bridge b,WebExtension.Port p,List<String> out){return b.callbacks.add(p,out::add,10000);}
  static void staleWindow(){
    Bridge b=new Bridge();WebExtension.Port old=b.connect(b.current);List<String> out=new ArrayList<>();int id=request(b,old,out);
    b.commit();
    check("Authoritative same-URL reload marks the old document port stale",b.staleAppearanceConnections.contains(old));
    check("Authoritative commit cancels the stale document request immediately",out.equals(Arrays.asList("null"))&&b.callbacks.size()==0&&b.clock.tasks.isEmpty());
    int completed=out.size();old.message(result(id,"late-old-document"));
    check("A result from the old document cannot finish after commit",out.size()==completed&&!out.contains("late-old-document"));
    old.message(ready("old-document-identity-123456"));
    check("Old same-URL documentReady cannot mark the new document usable",!b.usable.contains(b.current)&&b.visible==0&&b.owner.changes==0);
    old.message(J.obj("kind","ready","appearanceProtocol",1,"appearanceDocument","old-document-identity-123456"));
    check("The stale ready event cannot install the page reply observer",b.owner.webObserver.ready==0);
    old.message(J.obj("kind","reply","text","{}"));
    check("Old reply observations do not enter the active document observer",b.owner.webObserver.replies==0);
    old.message(J.obj("kind","scale","width",400));
    check("Old geometry cannot change the new document viewport",!b.viewportWidths.containsKey(b.current)&&b.owner.reading.measured==0);
    int before=b.appearanceSync.receipts;old.message(J.obj("kind","appearanceReceipt"));
    check("Stale appearance receipts retain the existing rejection",b.appearanceSync.receipts==before);
    List<String> eval=new ArrayList<>();b.evaluateJavascript("'new document check'",eval::add);
    check("Evaluation is unavailable rather than dispatched to the retired document",old.sent.isEmpty()&&eval.equals(Arrays.asList("null"))&&b.callbacks.size()==0);
    List<String> audit=new ArrayList<>();b.runEnvironmentAudit(new JSONObject(),audit::add);
    check("Audit is unavailable rather than dispatched to the retired document",old.sent.isEmpty()&&audit.equals(Arrays.asList("null"))&&b.callbacks.size()==0);
    Bridge reentrant=new Bridge();WebExtension.Port rp=reentrant.connect(reentrant.current);List<String> repeated=new ArrayList<>();
    reentrant.callbacks.add(rp,value->reentrant.evaluateJavascript("'retry'",repeated::add),10000);reentrant.commit();
    check("Cancellation reentry cannot create a new request on the retired port",rp.sent.isEmpty()&&repeated.equals(Arrays.asList("null"))&&reentrant.callbacks.size()==0&&reentrant.clock.tasks.isEmpty());
    Bridge auditing=new Bridge();WebExtension.Port ap=auditing.connect(auditing.current);List<String> observations=new ArrayList<>();int aid=request(auditing,ap,observations);auditing.commit();
    ap.message(J.obj("kind","auditResult","id",aid,"result","late-audit"));
    check("An old audit cannot confirm an observation after document commit",observations.equals(Arrays.asList("null"))&&auditing.callbacks.size()==0);
  }
  static void replacement(){
    Bridge b=new Bridge();WebExtension.Port old=b.connect(b.current);b.commit();WebExtension.Port fresh=b.connect(b.current);List<String> out=new ArrayList<>();int id=request(b,fresh,out);
    old.delegate.onDisconnect(old);
    check("Late old disconnect leaves the new document port registered",b.ports.get(b.current)==fresh&&b.callbacks.size()==1&&out.isEmpty());
    old.message(result(id,"wrong-port"));old.message(J.obj("kind","auditResult","id",id,"result","wrong-audit-port"));
    check("An old port cannot answer a request belonging to the replacement port",out.isEmpty()&&b.callbacks.size()==1);
    fresh.message(ready("new-document-identity-123456"));
    check("The replacement same-URL document accepts its own identity and ready",b.usable.contains(b.current)&&b.visible==1&&"new-document-identity-123456".equals(b.appearanceDocuments.get(fresh)));
    fresh.message(result(id,"fresh-result"));
    check("The new document keeps normal request completion",out.equals(Arrays.asList("fresh-result"))&&b.callbacks.size()==0);
    fresh.message(J.obj("kind","reply","text","{}"));
    check("Normal active-document observations still reach the observer",b.owner.webObserver.replies==1);
  }
  static void earlyConnection(){
    Bridge b=new Bridge();b.appearanceLoads.put(b.current,1L);b.pendingLoads.add(b.current);WebExtension.Port fresh=b.connect(b.current);List<String> out=new ArrayList<>();int id=request(b,fresh,out);
    fresh.message(J.obj("kind","ready","appearanceProtocol",1,"appearanceDocument","early-document-identity-123456"));
    b.navigation.onLocationChange(b.current,b.url,Collections.emptyList(),false);
    check("New-document connection before location commit preserves matching load ticket",!b.staleAppearanceConnections.contains(fresh)&&b.callbacks.size()==1&&out.isEmpty());
    fresh.message(result(id,"early-valid"));
    check("A matching early-connected document keeps its native callback",out.equals(Arrays.asList("early-valid")));
    fresh.message(ready("early-document-identity-123456"));
    check("Early-connected document remains usable after commit",b.usable.contains(b.current)&&b.visible==1);
  }
  static void nonCommit(){
    Bridge b=new Bridge();WebExtension.Port page=b.connect(b.current);List<String> out=new ArrayList<>();int id=request(b,page,out);
    b.navigation.onLocationChange(b.current,"https://chatgpt.com/c/same-document",Collections.emptyList(),true);
    check("A same-document SPA location change does not retire its existing bridge",!b.staleAppearanceConnections.contains(page)&&b.callbacks.size()==1&&out.isEmpty());
    page.message(result(id,"spa-valid"));check("SPA document still completes its own evaluation",out.equals(Arrays.asList("spa-valid")));
    Bridge download=new Bridge();WebExtension.Port dp=download.connect(download.current);List<String> response=new ArrayList<>();int did=request(download,dp,response);
    download.appearanceLoads.put(download.current,1L);download.pendingLoads.add(download.current);
    dp.message(result(did,"download-document-retained"));
    check("Uncommitted download load keeps the current document callback",response.equals(Arrays.asList("download-document-retained"))&&!download.staleAppearanceConnections.contains(dp));
    download.evaluateJavascript("'still-current'",null);
    check("Uncommitted download load does not disable active-document evaluation",dp.sent.size()==1&&"evaluate".equals(dp.sent.get(0).optString("kind")));
  }
  static void existingBoundaries(){
    Bridge b=new Bridge();WebExtension.Port p=b.connect(b.current);List<String> out=new ArrayList<>();int id=request(b,p,out);
    p.message(J.obj("kind","unknown-native-action","id",id,"result","unexpected"));
    check("Unknown actions still cannot complete native requests",out.isEmpty()&&b.callbacks.size()==1);
    p.delegate.onPortMessage("not-a-json-message",p);
    check("Non-object messages retain rejection",out.isEmpty()&&b.callbacks.size()==1);
    p.message(J.obj("kind","auditResult","id",id,"result",String.join("",Collections.nCopies(64001,"a"))));
    check("Oversized audit results keep the original 64000-character bound",out.isEmpty()&&b.callbacks.size()==1);
    p.message(J.obj("kind","auditResult","id",id,"result","null"));
    check("A bounded active audit result is still delivered",out.equals(Arrays.asList("null"))&&b.callbacks.size()==0);
    int before=b.owner.webObserver.replies;p.message(J.obj("kind","reply","text",String.join("",Collections.nCopies(2*1024*1024+1,"a"))));
    check("Reply observations keep the original two-megacharacter bound",b.owner.webObserver.replies==before);
    GeckoSession inactive=new GeckoSession();b.locations.put(inactive,URL);WebExtension.Port other=b.connect(inactive);List<String> otherOut=new ArrayList<>();request(b,other,otherOut);
    WebExtension.Port primary=b.ports.get(b.current);request(b,primary,new ArrayList<>());b.commit();
    check("A document commit leaves other-session requests and timers intact",b.callbacks.size()==1&&otherOut.isEmpty()&&b.clock.tasks.size()==1);
    WebExtension.Port subframe=new WebExtension.Port(b.current,URL);subframe.sender.top=false;b.pageMessages.onConnect(subframe);
    check("Subframes retain the existing top-level admission restriction",subframe.delegate==null&&b.ports.get(b.current)==primary);
    WebExtension.Port route=new WebExtension.Port(b.current,URL);route.name="pocketroute";b.pageMessages.onConnect(route);
    check("Route/native messaging ports are not admitted as page ports",route.delegate==null&&b.ports.get(b.current)==primary);
  }
  public static void main(String[] args){staleWindow();replacement();earlyConnection();nonCommit();existingBoundaries();int pass=0;for(JSONObject v:checks)if(v.optBoolean("passed"))pass++;System.out.println(J.obj("status",pass==checks.size()?"passed":"failed","passed",pass,"total",checks.size(),"checks",checks));}
}
final class J {
  // Match production J's checked Android-JSON boundary as well as desktop JSON.
  static JSONObject obj(Object... values){JSONObject o=new JSONObject();try{for(int i=0;i<values.length;i+=2)o.put(String.valueOf(values[i]),values[i+1]);}catch(org.json.JSONException invalid){throw new IllegalArgumentException(invalid);}return o;}
  static JSONObject parse(String value){try{return new JSONObject(value);}catch(Exception ignored){return new JSONObject();}}
}

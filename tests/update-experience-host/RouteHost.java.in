package local.pocketchat;
import android.content.Context;
import java.io.*;
import java.net.*;
import java.util.concurrent.*;
/** Only owning-environment admission is adapted. Factory below is exact production source. */
final class AppUpdateRoute {
 enum Purpose { FEED, APK, HISTORY }
 static final String DIRECT="direct",INTERNAL="internal";
 static volatile boolean admitted=true;static volatile int selectedSlot=-1;static volatile boolean internal;
 static final class Unavailable extends IOException {Unavailable(String value){super(value);}}
 static final class Scope {final int slot,generation=1;final String source;Scope(int slot,String source){this.slot=slot;this.source=source;}}
 static final class Lease {final int port=9911;final Scope scope;Lease(Scope scope){this.scope=scope;}}
 static final class Selection {final Scope scope;final Lease lease;Selection(Scope scope){this.scope=scope;lease=internal?new Lease(scope):null;}}
 static Selection select(Context c,int slot,Scope expected){selectedSlot=slot;return new Selection(new Scope(slot,internal?INTERNAL:DIRECT));}
 static boolean validScope(Context c,Scope scope){return admitted;}
 static boolean valid(Context c,Lease lease){return admitted;}
 interface Opener {HttpURLConnection open(String url,Proxy proxy)throws IOException;}
 static final Opener OFFICIAL=(url,proxy)->(HttpURLConnection)new URL(url).openConnection(proxy);
 @FACTORY@
}

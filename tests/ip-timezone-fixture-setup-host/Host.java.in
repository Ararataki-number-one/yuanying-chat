/** Real fixture classes; Android lifecycle/catalog/vault are declared host collaborators. */
public final class Host {
  static int passed;static final JSONArray checks=new JSONArray();
  static final String SOURCE="a".repeat(40),NONCE="b".repeat(32),OTHER="c".repeat(32);
  static final List<String> trace=Collections.synchronizedList(new ArrayList<>());
  static volatile java.util.function.IntConsumer itemHook;static volatile Runnable loadHook,saveHook;
  static int loads,saves,prepares,bootstrapCalls,firstProfileReads;
  static IpTimeZoneFixtureApplication app;
  public static void atomicSaved(File file)throws Exception{if(file.getName().equals(IpTimeZoneFixtureScopes.MARKER)){JSONObject value=new JSONObject(Files.readString(file.toPath()));trace.add("scope-"+value.optString("phase"));}}
  interface Work {void run()throws Exception;}
  static void check(String name,boolean ok){if(!ok)throw new AssertionError(name);passed++;checks.put(J.obj("name",name,"pass",true));}
  static void reject(String name,Work work){boolean denied=false;try{work.run();}catch(Exception expected){denied=true;}check(name,denied);}
  static void reset(String process)throws Exception{
    app=new IpTimeZoneFixtureApplication();android.content.Context.directory=Files.createTempDirectory("ip-fixture-host-").toFile();android.content.Context.application=app;android.content.Context.packageName="local.pocketchat.test";
    android.app.Application.processName="local.pocketchat.test"+process;android.os.SystemClock.now=5000;android.os.Binder.uid=2000;
    android.content.pm.PackageManager.scope="explicit-manual-system-baseline";ProfileCatalog.instance=new ProfileCatalog();SecretStore.records.clear();GeckoTimeZoneStore.states.clear();
    loads=saves=prepares=bootstrapCalls=firstProfileReads=0;GeckoTimeZoneStore.monitorViolations=0;trace.clear();itemHook=null;loadHook=null;saveHook=null;
    java.lang.reflect.Field cache=IpTimeZoneFixtureScopes.class.getDeclaredField("installed");cache.setAccessible(true);cache.set(null,null);
    java.lang.reflect.Field seen=IpTimeZoneFixtureScopes.class.getDeclaredField("SEEN");seen.setAccessible(true);((Set<?>)seen.get(null)).clear();
  }
  static Context profile(int slot){return Profiles.context(app,slot);}
  static byte[] raw(int slot)throws Exception{return new SecretStore(profile(slot)).get(GeckoTimeZoneStore.STORE);}
  static void raw(int slot,String value)throws Exception{new SecretStore(profile(slot)).put(GeckoTimeZoneStore.STORE,value.getBytes(StandardCharsets.UTF_8));}
  static void attach(){app.attachBaseContext(app);}
  static void onCreate(){app.onCreate();}
  static JSONObject armed()throws Exception{return IpTimeZoneFixtureScopes.prepareIp(app,SOURCE,NONCE);}
  static void markerChange(String key,Object value)throws Exception{JSONObject m=IpTimeZoneFixtureScopes.read(app,IpTimeZoneFixtureScopes.MARKER);m.put(key,value);IpTimeZoneFixtureScopes.write(app,IpTimeZoneFixtureScopes.MARKER,m);}
  static void applicationAndGeneric()throws Exception{
    reset(":ip_timezone_setup");attach();check("setup attach runs real PocketApplication bootstrap entry",bootstrapCalls==1);onCreate();check("dedicated setup onCreate never initializes catalog",ProfileCatalog.instance.opens==0&&loads==0&&saves==0);
    reset(":profile6");attach();check("early attach profile access is inert until fixture scope declared",firstProfileReads>0&&loads==0&&saves==0);onCreate();check("generic setup follows metadata and application lifecycle",loads==1&&saves==1&&GeckoTimeZoneStore.states.get(0).spec.followsSystem());
    check("generic fixture setup executes outside Application profile monitor",GeckoTimeZoneStore.monitorViolations==0);
    reset("");android.content.pm.PackageManager.scope="wrong";reject("missing declared generic scope fails closed",Host::onCreate);check("undeclared fixture writes no TZ record",saves==0);
    reset("");android.content.Context.packageName="local.pocketchat";reject("production package cannot use fixture Application",Host::onCreate);check("production package no fixture writes",loads==0&&saves==0);
    for(String selection:new String[]{"sealed:ip:revision1","sealed:system:revision1","sealed:iana:revision7","corrupt:preserve-bytes"}){
      reset("");raw(0,selection);onCreate();check("existing raw selection remains byte identical "+selection,Arrays.equals(raw(0),selection.getBytes(StandardCharsets.UTF_8)));check("existing selection is not parsed or saved by generic fixture "+selection,loads==0&&saves==0);
    }
    reset("");ProfileCatalog.instance.created[2]=true;ProfileCatalog.instance.db.transaction=true;IpTimeZoneFixtureScopes.prepareGeneric(app,profile(2),2);check("catalog transaction reentry defers generic setup",loads==0&&saves==0);ProfileCatalog.instance.db.transaction=false;IpTimeZoneFixtureScopes.prepareGeneric(app,profile(2),2);check("next ordinary context access performs deferred setup",loads==1&&saves==1);
    reset("");synchronized(app){reject("holding Application profile monitor is refused",()->IpTimeZoneFixtureScopes.prepareGeneric(app,profile(0),0));}check("rejected app monitor does no store I/O",loads==0&&saves==0);
    reset("");loadHook=()->{Context nested=Profiles.context(app,0);IpTimeZoneFixtureScopes.prepareGeneric(app,nested,0);};IpTimeZoneFixtureScopes.prepareGeneric(app,profile(0),0);check("writer's recursive profile access cannot deadlock or reseed",loads==1&&saves==1);IpTimeZoneFixtureScopes.prepareGeneric(app,profile(0),0);check("seen owner avoids repeated store reads",loads==1&&saves==1);
    reset("");ProfileCatalog.instance.created[1]=false;IpTimeZoneFixtureScopes.prepareGeneric(app,profile(1),1);check("unavailable profile receives no generic seed",loads==0&&saves==0);
    reset("");loadHook=()->ProfileCatalog.instance.ids[0]=new EnvironmentSpec.Identity(0,1,UUID.randomUUID().toString());reject("owner changed during loader cannot manual-seed",()->IpTimeZoneFixtureScopes.prepareGeneric(app,profile(0),0));check("changed owner never reaches generic save",saves==0);
    reset("");saveHook=()->{try{EnvironmentSpec.Identity actual=ProfileCatalog.instance.identity(0);GeckoTimeZoneStore.states.put(0,new GeckoTimeZoneStore.State(actual,7,GeckoTimeZoneSpec.of("Asia/Kathmandu")));new SecretStore(profile(0)).put(GeckoTimeZoneStore.STORE,"concurrent-user-choice".getBytes(StandardCharsets.UTF_8));}catch(Exception e){throw new RuntimeException(e);}};reject("concurrent user save makes stale generic CAS fail",()->IpTimeZoneFixtureScopes.prepareGeneric(app,profile(0),0));check("stale generic CAS preserves concurrent choice",Arrays.equals(raw(0),"concurrent-user-choice".getBytes(StandardCharsets.UTF_8))&&GeckoTimeZoneStore.states.get(0).revision==7);
  }
  static void reservationAndCanonicalDefault()throws Exception{
    reset(":ip_timezone_setup");attach();onCreate();JSONObject setup=armed();check("IP setup returns armed actual identity",setup.getString("status").equals("armed")&&setup.getJSONObject("identity").getInt("slot")==6);
    check("marker existed provisionally before first slot6 profile access",trace.indexOf("slot6-first-profile")>trace.indexOf("scope-provisional"));check("reserved marker existed before actual Profiles.prepare",trace.indexOf("profiles-prepare")>trace.indexOf("scope-reserved"));
    check("IP reservation leaves TZ record truly missing",raw(6)==null&&loads==0&&saves==0);check("scope setup performs actual profile preparation once",prepares==1);
    String before=new String(Files.readAllBytes(IpTimeZoneFixtureScopes.file(app,IpTimeZoneFixtureScopes.MARKER).toPath()),StandardCharsets.UTF_8);reject("second prepare cannot replace armed nonce",()->IpTimeZoneFixtureScopes.prepareIp(app,SOURCE,OTHER));check("failed prepare preserves armed scope bytes",before.equals(Files.readString(IpTimeZoneFixtureScopes.file(app,IpTimeZoneFixtureScopes.MARKER).toPath())));
    android.app.Application.processName="local.pocketchat.test:profile6";attach();onCreate();Context canonical=profile(6);check("real Application profile6 opening does not generic-seed reserved scope",raw(6)==null&&!GeckoTimeZoneStore.states.containsKey(6));final int beforeLoads=loads,beforeSaves=saves;check("canonical fixture requires exact source nonce process and slot",IpTimeZoneFixtureScopes.requireArmed(canonical,SOURCE,NONCE).getString("phase").equals("armed"));
    GeckoTimeZoneStore.State missing=GeckoTimeZoneStore.load(canonical);check("missing default loader reaches IP spec without manual-system seed",missing.spec.followsIp()&&saves==beforeSaves&&loads==beforeLoads+1);
    reject("foreign invocation cannot acquire canonical scope",()->IpTimeZoneFixtureScopes.requireArmed(canonical,SOURCE,OTHER));reject("foreign source cannot acquire canonical scope",()->IpTimeZoneFixtureScopes.requireArmed(canonical,"d".repeat(40),NONCE));reject("other slot cannot acquire canonical scope",()->IpTimeZoneFixtureScopes.requireArmed(profile(0),SOURCE,NONCE));
    android.app.Application.processName="local.pocketchat.test";reject("main process cannot acquire profile6 scope",()->IpTimeZoneFixtureScopes.requireArmed(canonical,SOURCE,NONCE));
    android.app.Application.processName="local.pocketchat.test:ip_timezone_setup";reject("foreign nonce cannot clear scope",()->IpTimeZoneFixtureScopes.clear(app,SOURCE,OTHER));check("foreign clear preserves marker",IpTimeZoneFixtureScopes.read(app,IpTimeZoneFixtureScopes.MARKER)!=null);IpTimeZoneFixtureScopes.clear(app,SOURCE,NONCE);check("exact shell owner may clear marker",IpTimeZoneFixtureScopes.read(app,IpTimeZoneFixtureScopes.MARKER)==null);
    for(String state:new String[]{"created","deleting","resetting"}){reset(":ip_timezone_setup");if(state.equals("created"))ProfileCatalog.instance.created[6]=true;if(state.equals("deleting"))ProfileCatalog.instance.deleting[6]=true;if(state.equals("resetting"))ProfileCatalog.instance.resetting[6]=true;reject("fresh unused slot prerequisite "+state,Host::armed);check("failed slot reservation never arms "+state,!"armed".equals(IpTimeZoneFixtureScopes.read(app,IpTimeZoneFixtureScopes.MARKER).optString("phase"))&&loads==0&&saves==0);}
    reset(":ip_timezone_setup");raw(6,"preexisting:must-preserve");reject("pre-existing sealed IP scope is refused without overwrite",Host::armed);check("pre-existing IP scope bytes remain unchanged",Arrays.equals(raw(6),"preexisting:must-preserve".getBytes(StandardCharsets.UTF_8)));
    reset(":profile6");reject("only dedicated setup process can reserve",Host::armed);check("wrong process creates no scope marker",IpTimeZoneFixtureScopes.read(app,IpTimeZoneFixtureScopes.MARKER)==null);
    reset(":ip_timezone_setup");reject("malformed nonce rejected before file access",()->IpTimeZoneFixtureScopes.prepareIp(app,SOURCE,"bad"));reject("foreign build rejected before marker",()->IpTimeZoneFixtureScopes.prepareIp(app,"f".repeat(40),NONCE));check("invalid invocation creates no marker",IpTimeZoneFixtureScopes.read(app,IpTimeZoneFixtureScopes.MARKER)==null);
  }
  static void markerIdentity()throws Exception{
    for(String key:new String[]{"sourceCommit","sourceTree","apkSha256","sdkRunId","sdkRunAttempt","kind","activity","runNonce"}){reset(":ip_timezone_setup");armed();markerChange(key,"foreign");reject("marker exact installed identity "+key,()->IpTimeZoneFixtureScopes.marker(app));}
    for(Object bad:new Object[]{0,-1,6.5,Boolean.TRUE}){reset(":ip_timezone_setup");armed();markerChange("slot",bad);reject("typed exact scope slot "+bad,()->IpTimeZoneFixtureScopes.marker(app));}
    reset(":ip_timezone_setup");armed();markerChange("createdAtElapsed",6000);reject("future marker cannot admit",()->IpTimeZoneFixtureScopes.marker(app));
    reset(":ip_timezone_setup");armed();android.os.SystemClock.now+=IpTimeZoneFixtureScopes.MAX_AGE+1;reject("expired marker cannot admit",()->IpTimeZoneFixtureScopes.marker(app));
    reset(":ip_timezone_setup");armed();ProfileCatalog.instance.ids[6]=new EnvironmentSpec.Identity(6,1,UUID.randomUUID().toString());reject("reused environment identity invalidates armed marker",()->IpTimeZoneFixtureScopes.marker(app));
    for(String phase:new String[]{"provisional","reserved"}){reset(":ip_timezone_setup");armed();markerChange("phase",phase);markerChange("identity",JSONObject.NULL);check("setup process may inspect unarmed phase "+phase,IpTimeZoneFixtureScopes.marker(app)!=null);android.app.Application.processName="local.pocketchat.test:profile6";reject("profile cannot consume unarmed scope "+phase,()->IpTimeZoneFixtureScopes.marker(app));}
    reset(":ip_timezone_setup");armed();Path m=IpTimeZoneFixtureScopes.file(app,IpTimeZoneFixtureScopes.MARKER).toPath();Files.delete(m);Path outside=Files.createTempFile("foreign-scope-",".json");Files.createSymbolicLink(m,outside);reject("marker leaf symlink cannot be read",()->IpTimeZoneFixtureScopes.marker(app));reject("marker leaf symlink cannot be written",()->IpTimeZoneFixtureScopes.write(app,IpTimeZoneFixtureScopes.MARKER,J.obj()));
    reset(":ip_timezone_setup");Files.write(IpTimeZoneFixtureScopes.file(app,IpTimeZoneFixtureScopes.MARKER).toPath(),new byte[16385]);reject("oversized marker rejected",()->IpTimeZoneFixtureScopes.marker(app));
    reset(":ip_timezone_setup");Files.writeString(IpTimeZoneFixtureScopes.file(app,IpTimeZoneFixtureScopes.MARKER).toPath(),"{\"schema\":1,\"schema\":2}");reject("duplicate marker keys rejected by real JSON policy",()->IpTimeZoneFixtureScopes.marker(app));
  }
  static void concurrency()throws Exception{
    reset(":ip_timezone_setup");CountDownLatch entered=new CountDownLatch(1),release=new CountDownLatch(1),secondStarted=new CountDownLatch(1);AtomicBoolean once=new AtomicBoolean(),secondDone=new AtomicBoolean();AtomicInteger accepted=new AtomicInteger(),denied=new AtomicInteger();
    itemHook=slot->{if(slot==6&&once.compareAndSet(false,true)){entered.countDown();try{if(!release.await(3,TimeUnit.SECONDS))throw new AssertionError("bounded reservation release");}catch(InterruptedException e){throw new AssertionError(e);}}};
    Thread first=new Thread(()->{try{armed();accepted.incrementAndGet();}catch(Exception e){denied.incrementAndGet();}},"first-reservation");
    Thread second=new Thread(()->{secondStarted.countDown();try{IpTimeZoneFixtureScopes.prepareIp(app,SOURCE,OTHER);accepted.incrementAndGet();}catch(Exception e){denied.incrementAndGet();}finally{secondDone.set(true);}},"competing-reservation");
    first.start();check("reservation reached real provisional stage",entered.await(2,TimeUnit.SECONDS));second.start();check("competing shell call dispatched",secondStarted.await(1,TimeUnit.SECONDS));Thread.sleep(75);check("competing reservation cannot inspect or replace in-flight marker",!secondDone.get());release.countDown();first.join(3000);second.join(3000);itemHook=null;check("reservation calls terminate without app/catalog deadlock",!first.isAlive()&&!second.isAlive());check("exactly one competing nonce becomes armed",accepted.get()==1&&denied.get()==1&&NONCE.equals(IpTimeZoneFixtureScopes.marker(app).optString("runNonce")));
    reset(":ip_timezone_setup");CountDownLatch preparing=new CountDownLatch(1),finish=new CountDownLatch(1);AtomicBoolean guard=new AtomicBoolean(),cleared=new AtomicBoolean();itemHook=slot->{if(slot==6&&guard.compareAndSet(false,true)){preparing.countDown();try{finish.await(3,TimeUnit.SECONDS);}catch(InterruptedException e){throw new AssertionError(e);}}};
    Thread prepare=new Thread(()->{try{armed();}catch(Exception e){throw new AssertionError(e);}});Thread clear=new Thread(()->{try{IpTimeZoneFixtureScopes.clear(app,SOURCE,NONCE);cleared.set(true);}catch(Exception e){throw new AssertionError(e);}});prepare.start();check("clear race reached provisional reservation",preparing.await(2,TimeUnit.SECONDS));clear.start();Thread.sleep(75);check("clear ownercheck/delete waits for complete reservation",!cleared.get());finish.countDown();prepare.join(3000);clear.join(3000);itemHook=null;check("clear after reservation removes final armed marker",cleared.get()&&IpTimeZoneFixtureScopes.read(app,IpTimeZoneFixtureScopes.MARKER)==null);
  }
  static void provider()throws Exception{
    reset(":ip_timezone_setup");GeckoIpTimeZoneEvidenceProvider provider=new GeckoIpTimeZoneEvidenceProvider();provider.context=app;check("UID2000 provider startup binds integration package",provider.onCreate());Bundle exact=new Bundle();exact.putString("sourceCommit",SOURCE);exact.putString("runNonce",NONCE);
    Binder.uid=10001;reject("application UID cannot command fixture setup",()->provider.call("prepare",null,exact));reject("application UID cannot read shell report",()->provider.openFile(android.net.Uri.parse("content://local.pocketchat.test.gecko-ip-timezone-evidence/setup"),"r"));Binder.uid=2000;
    reject("unknown shell command refused",()->provider.call("write",null,exact));reject("non-null command arg refused",()->provider.call("prepare","path",exact));Bundle extra=new Bundle();extra.putString("sourceCommit",SOURCE);extra.putString("runNonce",NONCE);extra.putString("path","/private");reject("extra command keys refused",()->provider.call("prepare",null,extra));
    check("exact UID2000 prepare invokes real reservation",provider.call("prepare",null,exact).getString("status").equals("armed"));check("fixed setup evidence opens only generated file",provider.openFile(android.net.Uri.parse("content://local.pocketchat.test.gecko-ip-timezone-evidence/setup"),"r")!=null);
    Path setupPath=IpTimeZoneFixtureScopes.file(app,IpTimeZoneFixtureScopes.SETUP).toPath();Files.delete(setupPath);Path foreign=Files.createTempFile("foreign-provider-",".json");Files.createSymbolicLink(setupPath,foreign);reject("provider refuses real fixed-report leaf symlink",()->provider.openFile(android.net.Uri.parse("content://local.pocketchat.test.gecko-ip-timezone-evidence/setup"),"r"));Files.delete(setupPath);Files.write(setupPath,new byte[4*1024*1024+1]);reject("provider enforces actual fixed-report byte bound",()->provider.openFile(android.net.Uri.parse("content://local.pocketchat.test.gecko-ip-timezone-evidence/setup"),"r"));
    for(String suffix:new String[]{"/setup?x=1","/setup#x","/../../private","/unknown"})reject("provider fixed bounded read path "+suffix,()->provider.openFile(android.net.Uri.parse("content://local.pocketchat.test.gecko-ip-timezone-evidence"+suffix),"r"));reject("provider does not permit writes",()->provider.openFile(android.net.Uri.parse("content://local.pocketchat.test.gecko-ip-timezone-evidence/setup"),"w"));
  }
  public static void main(String[] args)throws Exception{applicationAndGeneric();reservationAndCanonicalDefault();markerIdentity();concurrency();provider();System.out.println(J.obj("status","passed","passed",passed,"total",passed,"checks",checks));}

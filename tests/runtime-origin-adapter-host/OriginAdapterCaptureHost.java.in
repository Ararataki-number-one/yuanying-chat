/** Only extracted fixture methods execute here; app/Gecko callbacks are explicit capture facades. */
public final class OriginAdapterCaptureHost {
  static Path root,output;static String current,baseline;static final List<String> checks=new ArrayList<>();
  static void check(String name,boolean pass){if(!pass)throw new AssertionError(name);checks.add(name);}
  static void write(String name,String text)throws Exception{Files.write(output.resolve(name),text.getBytes(StandardCharsets.UTF_8));}
  static String invoke(String driver,String action,JSONObject args,boolean escaped){String encoded=args.toString().replace("\\/","/");if(escaped)encoded=encoded.replace("/","\\/");return driver.replace("__ACTION__",JSONObject.quote(action)).replace("__ARG__",encoded);}
  public static void main(String[] args)throws Exception{
    String label=args[0];root=Paths.get(args[1]);output=Paths.get(args[2]);Files.createDirectories(output);current=new String(Files.readAllBytes(root.resolve("app/src/main/assets/page-driver.js")),StandardCharsets.UTF_8);baseline=new String(Files.readAllBytes(root.resolve("tests/gecko/assets/performance-baseline/page-driver.js")),StandardCharsets.UTF_8);
    PerformanceHost performance=new PerformanceHost();performance.load("baseline");write("performance-baseline.js",performance.driver);check("Performance baseline actual load reaches controlled URL",performance.session.web.loaded.equals("http://127.0.0.1:8767/performance?variant=baseline"));
    boolean currentFailed=false;try{performance.load("current");}catch(IllegalStateException expected){currentFailed=true;}
    check("Performance current asset exposes old marker failure or fixed current guard",currentFailed==label.equals("before"));if(!currentFailed)write("performance-current.js",performance.driver);
    if(label.equals("after")){
      for(String mode:new String[]{"baseline","current"}){PerformanceHost duplicate=new PerformanceHost();duplicate.duplicate=true;boolean rejected=false;try{duplicate.load(mode);}catch(IllegalStateException expected){rejected=true;}check("Performance rejects ambiguous "+mode+" marker",rejected);}
    }
    CompletionHost completion=new CompletionHost();completion.session.driver=current;completion.completion(1);check("Completion actual method captures four bridge calls",completion.session.web.scripts.size()==4);write("completion-setup.js",completion.session.web.scripts.get(0));write("completion-poll.js",completion.session.web.scripts.get(1));write("completion-prior.js",completion.session.web.scripts.get(2));check("Completion reuses identical poll code",completion.session.web.scripts.get(1).equals(completion.session.web.scripts.get(3)));
    for(boolean escaped:new boolean[]{false,true})for(String expected:new String[]{"https://chatgpt.com/c/reload-A","https://chatgpt.com/c/other","https://other.example/c/reload-A"}){
      CompactHost compact=new CompactHost();compact.replyRaw=J.obj("url","http://127.0.0.1:8765/c/reload-A","nested",J.obj("url","https://detector.example/value")).toString();final String[] normalized={null};compact.evaluateJavascript(invoke(current,"page-state",J.obj("expectedUrl",expected),escaped),value->normalized[0]=value);
      String suffix=expected.contains("other.example")?"wrong-origin":expected.endsWith("/other")?"wrong-path":"valid";write("compact-"+(escaped?"escaped-":"plain-")+suffix+".js",compact.scripts.get(0));check("Compact actual callback maps root URL only "+escaped+suffix,J.parse(normalized[0]).optString("url").equals("https://chatgpt.com/c/reload-A")&&J.parse(normalized[0]).optJSONObject("nested").optString("url").equals("https://detector.example/value"));
    }
    FollowupHost followup=new FollowupHost();followup.owner.driver=current;FollowupHost.FixtureView view=followup.new FixtureView();view.replyRaw=J.obj("url",followup.chat,"nested",J.obj("url","https://detector.example/value")).toString();final String[] normalized={null};view.evaluateJavascript(invoke(current,"page-state",J.obj("expectedUrl",followup.semanticChat),false),value->normalized[0]=value);write("followup-source.js",view.scripts.get(0));
    check("Followup callback maps only root source URL",J.parse(normalized[0]).optString("url").equals(followup.semanticChat)&&J.parse(normalized[0]).optJSONObject("nested").optString("url").equals("https://detector.example/value"));
    check("Followup records exact adapter only when actual current marker matched",followup.sourceDriverGuardRecorded==label.equals("after"));
    if(label.equals("after")){boolean rejected=false;try{FollowupHost.adaptSourceDriver(current+"\n"+FollowupHost.SOURCE_DRIVER_GUARD,followup.chat);}catch(IllegalStateException expected){rejected=true;}check("Followup rejects ambiguous actual source marker",rejected);write("followup-adapter.json",followup.sourceDriverAdapter.toString());}
    System.out.println(J.obj("status","passed","passed",checks.size(),"checks",new JSONArray(checks),"mode",label,"performanceCurrentRejected",currentFailed));
  }
}
final class PerformanceHost {
  static final String ORIGIN="http://127.0.0.1:8767",PATH="/performance";String variant,driver,performanceSource;long deadline;boolean duplicate;
  final Session session=new Session();interface Step{void run()throws Exception;}
  String asset(String name)throws Exception{Path file=name.startsWith("performance-baseline/")?OriginAdapterCaptureHost.root.resolve("tests/gecko/assets/"+name):OriginAdapterCaptureHost.root.resolve("app/src/main/assets/"+name);String value=new String(Files.readAllBytes(file),StandardCharsets.UTF_8);if(duplicate&&name.endsWith("page-driver.js"))value+="\n"+(name.startsWith("performance-baseline")?"location.protocol !== 'https:' || location.hostname !== 'chatgpt.com'":"window !== window.top || location.origin !== 'https://chatgpt.com'");return value;}
  void event(String name,JSONObject value){}void later(Step step,long delay){}void waitDocument(){}
  /* PERFORMANCE_LOAD */
}
final class CompletionHost {
  final Session session=new Session();void event(long serial,String event,JSONObject result){}
  /* COMPLETION */
}
final class CompactHost extends CaptureGecko {
  static final String LOCAL="http://127.0.0.1:8765/";
  /* COMPACT_EVALUATE */
}
final class FollowupHost {
  /* SOURCE_DRIVER_CONSTANT */
  /* SOURCE_DRIVER_GUARD */
  /* ADAPT_SOURCE_DRIVER */
  /* SHA256 */
  String chat="https://fixture.example.test:9443/c/source?fixture=1",semanticChat="https://chatgpt.com/c/source";final Session owner=new Session();
  boolean sourceDriverGuardRecorded;JSONObject sourceDriverAdapter=new JSONObject();final JSONArray normalizations=new JSONArray(),preflightDriverResults=new JSONArray();int normalizationDrops,preflightDriverDrops;static final int NORMALIZATION_LIMIT=64,PREFLIGHT_LIMIT=64;String stage="host-capture";
  JSONObject copy(JSONObject value){return J.parse(value.toString());}
  final class FixtureView extends CaptureGecko {
    /* FOLLOWUP_EVALUATE */
  }
}
class CaptureGecko {
  final List<String> scripts=new ArrayList<>();String replyRaw="{}",loaded="";
  public void evaluateJavascript(String code,ValueCallback<String> callback){scripts.add(code);if(callback!=null)callback.onReceiveValue(replyRaw);}
  void loadUrl(String url){loaded=url;}
}
final class FixtureView extends CaptureGecko {String navigationError="";}
final class Session {String driver="";boolean offline,networkReady=true;final FixtureView web=new FixtureView();final Guard guard=new Guard();final Preferences prefs=new Preferences();final Audit audit=new Audit();}
final class Guard {boolean allowed(){return true;}}
final class Preferences {String getString(String name,String fallback){return fallback;}}
final class Audit {final RequestIdentity requestIdentity=new RequestIdentity();}
final class RequestIdentity {boolean active;}
final class MainActivity {/* MAIN_ORIGIN_CONSTANT */}
final class SystemClock {static long elapsedRealtime(){return 7;}}

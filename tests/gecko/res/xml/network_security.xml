<?xml version="1.0" encoding="utf-8"?>
<!-- INTEGRATION VARIANT ONLY. Release retains app/src/main/res/xml/network_security.xml. -->
<network-security-config>
  <base-config cleartextTrafficPermitted="true" />
  <domain-config cleartextTrafficPermitted="true">
    <domain includeSubdomains="false">127.0.0.1</domain>
    <domain includeSubdomains="false">localhost</domain>
  </domain-config>
  <!-- Gecko's separate ordinary-URL case uses HTTP; Chromium UA-CH cases require HTTPS. -->
  <domain-config cleartextTrafficPermitted="true">
    <domain includeSubdomains="false">fp-a.pocketchat.test</domain>
    <domain includeSubdomains="false">fp-b.pocketchat.test</domain>
    <trust-anchors><certificates src="system" /><certificates src="user" /></trust-anchors>
  </domain-config>
</network-security-config>

[
  {
    "namespace": "pocketNativeTimezone",
    "description": "App-bundled, privileged Gecko capability probe. Native settings only; no page prototype replacement.",
    "types": [
      {
        "id": "Receipt",
        "type": "object",
        "properties": {
          "schema": {"type": "integer", "minimum": 1, "maximum": 1},
          "status": {"type": "string", "enum": ["applied", "read"]},
          "requestToken": {"type": "string"},
          "requestedZoneId": {"type": "string"},
          "nativeZoneId": {"type": "string"},
          "contextId": {"type": "string"},
          "nativeSettingReadback": {"type": "boolean"},
          "scope": {"type": "string", "enum": ["top-browsing-context"]},
          "workerCoverageVerified": {"type": "boolean"},
          "serviceWorkerCoverageVerified": {"type": "boolean"}
        }
      }
    ],
    "functions": [
      {
        "name": "apply",
        "type": "function",
        "async": true,
        "parameters": [
          {"name": "tabId", "type": "integer", "minimum": 0},
          {"name": "zoneId", "type": "string", "maxLength": 80},
          {"name": "requestToken", "type": "string", "minLength": 1, "maxLength": 160}
        ],
        "returns": {"$ref": "Receipt"}
      },
      {
        "name": "read",
        "type": "function",
        "async": true,
        "parameters": [
          {"name": "tabId", "type": "integer", "minimum": 0},
          {"name": "requestToken", "type": "string", "minLength": 1, "maxLength": 160}
        ],
        "returns": {"$ref": "Receipt"}
      }
    ]
  }
]

{
  "manifest_version": 2,
  "name": "PocketChat integration certificate import observer",
  "version": "1.0.0",
  "browser_specific_settings": {"gecko": {"id": "tls-fixture-trust@pocketchat.local"}},
  "permissions": ["nativeMessaging", "geckoViewAddons"],
  "background": {"scripts": ["background.js"]},
  "experiment_apis": {
    "pocketFixtureTrust": {
      "schema": "schema.json",
      "parent": {
        "scopes": ["addon_parent"],
        "paths": [["pocketFixtureTrust"]],
        "script": "parent.js"
      }
    }
  }
}

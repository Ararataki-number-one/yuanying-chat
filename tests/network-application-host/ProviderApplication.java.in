package local.pocketchat;
import java.util.*;import java.util.concurrent.*;import org.json.*;
final class SystemClock {static long now;static long elapsedRealtime(){return now;}}
final class TestQueue {static boolean worker;final ArrayDeque<Runnable> tasks=new ArrayDeque<>();void post(Runnable run){tasks.add(run);}void postDelayed(Runnable run,long delay){tasks.add(()->{SystemClock.now+=delay;run.run();});}void execute(Runnable run){tasks.add(run);}boolean one(boolean work){Runnable run=tasks.poll();if(run==null)return false;worker=work;try{run.run();}finally{worker=false;}return true;}}
final class ChatSession {
 static ChatSession instance;static ChatSession peek(){return instance;}boolean deleted,networkReady=true,offline,connecting,internal=true;int environmentGeneration=3;String environmentId="11111111-1111-1111-1111-111111111111",networkIssue="",appliedIdentity="route";
 long connectionEpoch=1;final Web web=new Web();final Identity identity=new Identity();final Guard guard=new Guard();final Prefs prefs=new Prefs();String networkIdentity(){return "route";}boolean internalNetwork(){return internal;}
 static final class Web {Object current=new Object();long identityPolicyRevision=1;final Metadata metadata=new Metadata();Metadata getSettings(){return metadata;}}
 static final class Metadata {boolean policyAcknowledged=true;JSONObject acceptedBrowserIdentity=J.obj("desktop",false);}
 static final class Identity {long editSerial;}
 static final class Guard {boolean allowed=true;boolean allowed(){return allowed;}}
 static final class Prefs {String proxy="";String getString(String key,String fallback){return proxy;}}
}
final class NetworkHealthPolicy {enum Admission {VERIFIED,DEGRADED_VERIFICATION,BLOCKED;boolean usable(){return this!=BLOCKED;}}}
final class NativeNetwork {
 boolean starting,ready=true,fresh=true;JSONObject settings=J.obj("entry","new","exit","fixed");Transport transport=new Transport();ExitRouteReceipt verifiedRoute=new ExitRouteReceipt();int freshCalls;boolean workerOnly=true;
 NetworkHealthPolicy.Admission admission=NetworkHealthPolicy.Admission.VERIFIED;
 static NativeNetwork peek(){return null;}
 static String hash(String value){return Integer.toHexString(value.hashCode());}
 static boolean subscribedExit(JSONObject value){return "subscription".equals(value.optString("exitSource"));}
 static String transportFingerprint(JSONObject value){return value.optString("entry")+":"+value.optString("exit");}
 NetworkHealthPolicy.Admission connectionAdmission(){return ready?admission:NetworkHealthPolicy.Admission.BLOCKED;}
 boolean coreAlive(){return ready;}
 boolean verifiedRouteCurrent(){freshCalls++;workerOnly&=TestQueue.worker;return fresh;}
 static final class Transport {JSONObject state=J.obj("alive",true);}
 static final class ExitRouteReceipt {String configuration="new:fixed",entry="Entry|new",fingerprint="exit-fingerprint";boolean matches(NativeNetwork network,JSONObject state){return state.optBoolean("alive")&&configuration.equals(transportFingerprint(network.settings));}}
}
final class NetworkApplyCoordinator {static final String AUTO="idle",DEFER="defer",IMMEDIATE="immediate";}
final class NetworkShareSelection {static void savedActive(Profile profile,EnvironmentSpec.Identity owner,JSONObject settings,EnvironmentSpec model){}static void invalidateSaved(Profile profile,EnvironmentSpec.Identity owner){}}
final class SecretStore {SecretStore(Profile profile){}JSONObject settings(){return new JSONObject();}}
final class NetworkCoreApplication {EnvironmentSpec.Identity identity;NativeNetwork.ExitRouteReceipt route;boolean current(NativeNetwork network){return false;}static NetworkCoreApplication observed(NativeNetwork network){return null;}}
final class Profile {EnvironmentSpec.Identity identity;EnvironmentSpec model;String pending="candidate",active="published";}
final class EnvironmentSpecRuntime {
 interface Action<T>{T run()throws Exception;}static <T>T withIntent(Profile profile,Action<T> action)throws Exception{return action.run();}
 static void requireIdentity(Profile profile,EnvironmentSpec.Identity expected)throws Exception{if(!expected.equals(profile.identity))throw new Exception("identity changed");}
 static EnvironmentSpec.NetworkBinding binding(EnvironmentSpec.Identity id,String mode,JSONObject settings,String proxy){return route(mode,settings.optString("entry"),settings.optString("exit"),proxy);}
 static EnvironmentSpec.NetworkBinding route(String mode,String entry,String exit,String proxy){return new EnvironmentSpec.NetworkBinding(mode,"source",entry,"exit",exit,"manual",proxy,"","");}
}
final class EnvironmentSpecRepository {final Profile profile;EnvironmentSpecRepository(Profile profile){this.profile=profile;}EnvironmentSpec load(){return profile.model;}}
final class NetworkChanges {static final class Pending {final String value;Pending(String value){this.value=value;}public String toString(){return value;}}static Pending pendingStrict(Profile profile){return new Pending(profile.pending);}static String hash(Profile profile){return profile.active;}static boolean clearIfCurrent(Profile profile,String snapshot){if(!profile.pending.equals(snapshot))return false;profile.pending="";return true;}}
final class GeckoWebView {static final String VERSION="actual-gecko";}
final class NetworkUiProvider {
 final Map<String,JSONObject> jobs=new HashMap<>();final Map<String,Choice> choices=new HashMap<>();int selectedCount;String selectedId,selectedPolicy;
 void selectPolicy(String id,String action,JSONObject candidate,String baseline,String policy){selectedCount++;selectedId=id;selectedPolicy=policy;}
 final TestQueue main=new TestQueue(),io=new TestQueue();final Map<String,RequestBinding> bindings=new HashMap<>();final Profile profile=new Profile();boolean maintenanceStopped;long saveRevision=1;String activeApply="save";Transition activeTransition;boolean completed,ok;String message;JSONObject result;int completions;
 @METHODS@
 static final class Transition {String id="save",expectedPendingSnapshot="candidate",publishedHash="published";long revision=1;boolean cancelled,cancelledByUser,cancellationConfirmed,confirmed=true,settledRoute,pendingReleased;ChatSession session;}
 void rollbackApplied(Transition transition,String reason){finish(transition.id,false,reason);}
 void finish(String id,boolean ok,String message){completed=true;this.ok=ok;this.message=message;completions++;RequestBinding binding=bindings.get(id);result=binding==null?null:binding.outcome;}
}

final class NetworkCatalog {static String subscriptionName(JSONObject value){return value.optString("subscriptionName");}}
final class WindowNetworkState {@RUNNING@}

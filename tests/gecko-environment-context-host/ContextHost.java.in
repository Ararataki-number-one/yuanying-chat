package local.pocketchat;

import java.io.File;
import java.util.*;
import java.util.concurrent.Executor;

/** Full production adapter and selected real profile methods on named host boundaries. */
public final class ContextHost {
  static int checks;
  static void check(String name,boolean result){if(!result)throw new AssertionError(name);checks++;System.out.println("PASS "+name);}
  static void register(GeckoEnvironmentContext context,CallbacksBoundary callback){
    try{context.getApplicationContext().registerComponentCallbacks(callback);}
    catch(StackOverflowError recursive){throw new AssertionError("Callback registration must reach the actual Application without recursion");}
  }
  static void unregister(GeckoEnvironmentContext context,CallbacksBoundary callback){
    try{context.getApplicationContext().unregisterComponentCallbacks(callback);}
    catch(StackOverflowError recursive){throw new AssertionError("Callback unregistration must reach the actual Application without recursion");}
  }
  static void emit(PocketApplication app,ConfigurationBoundary configuration,int level){app.onConfigurationChanged(configuration);app.onLowMemory();app.onTrimMemory(level);}
  public static void main(String[] args){
    PocketApplication app=new PocketApplication(new File(args[0]));
    for(int slot:new int[]{0,2,7}){
      ProfileContext profile=(ProfileContext)app.profile(slot);GeckoEnvironmentContext context=new GeckoEnvironmentContext(profile);
      check("Gecko keeps its isolated application context "+slot,context.getApplicationContext()==context);
      check("The original cached profile context remains the delegate "+slot,context.getBaseContext()==profile&&profile.getApplicationContext()==profile&&app.profile(slot)==profile);
      check("The selected environment slot is preserved "+slot,context.slot==slot);
      check("Existing global helper unwraps only the profile to the Application "+slot,Profiles.global(context.getBaseContext())==app);
      Callback first=new Callback(),second=new Callback();ConfigurationBoundary configuration=new ConfigurationBoundary();
      register(context,first);emit(app,configuration,15);
      check("Registered callback receives real controller dispatch once "+slot,first.configuration==configuration&&first.configurations==1&&first.lowMemory==1&&first.trimMemory==1&&first.level==15);
      register(context,second);unregister(context,first);emit(app,configuration,40);
      check("Unregister removes exactly the registered callback "+slot,first.configurations==1&&first.lowMemory==1&&first.trimMemory==1&&second.configurations==1&&second.lowMemory==1&&second.trimMemory==1&&second.level==40);
      unregister(context,second);emit(app,configuration,80);
      check("Released callbacks receive no later configuration or memory events "+slot,second.configurations==1&&second.lowMemory==1&&second.trimMemory==1);
      PrefsBoundary prefs=context.getApplicationContext().getSharedPreferences("chat",0);prefs.value="environment"+slot;
      check("Application-context preferences stay in the selected profile "+slot,prefs==app.preferences.get(slot==0?"chat":"env"+slot+"_chat")&&prefs==profile.getSharedPreferences("chat",0));
      check("Profile directories remain isolated "+slot,context.getNoBackupFilesDir().equals(slot==0?app.noBackup:new File(app.noBackup,"profiles/env"+slot))&&context.getFilesDir().equals(slot==0?app.files:new File(app.files,"profiles/env"+slot)));
      ServiceConnectionBoundary connection=new ServiceConnectionBoundary();Executor executor=Runnable::run;
      IntentBoundary socket=new IntentBoundary().setClassName("local.pocketchat","org.mozilla.gecko.process.GeckoChildProcessServices$socket");
      check("Environment socket binding retains the native return value "+slot,context.bindService(socket,connection,17));
      check("Socket service routing and the caller intent remain isolated "+slot,app.bound!=socket&&app.bound.getComponent().getClassName().equals("local.pocketchat.GeckoEnvironmentServices$E"+slot+"socket")&&socket.getComponent().getClassName().equals("org.mozilla.gecko.process.GeckoChildProcessServices$socket")&&app.connection==connection&&app.flags==17);
      IntentBoundary gpu=new IntentBoundary().setClassName("local.pocketchat","org.mozilla.gecko.process.GeckoChildProcessServices$gpu");context.bindService(gpu,23,executor,connection);
      check("Executor binding preserves the environment and callback owner "+slot,app.bound.getComponent().getClassName().equals("local.pocketchat.GeckoEnvironmentServices$E"+slot+"gpu")&&app.executor==executor&&app.connection==connection&&app.flags==23);
      IntentBoundary isolated=new IntentBoundary().setClassName("local.pocketchat","org.mozilla.gecko.process.GeckoChildProcessServices$isolated");context.bindIsolatedService(isolated,29,"content_1",executor,connection);
      check("Isolated service instances retain the selected environment prefix "+slot,app.bound==isolated&&app.instance.equals("environment"+slot+"_content_1")&&app.flags==29&&app.executor==executor&&app.connection==connection);
      for(String type:new String[]{"isolated","zygoteTab"}){IntentBoundary original=new IntentBoundary().setClassName("local.pocketchat","org.mozilla.gecko.process.GeckoChildProcessServices$"+type);context.bindService(original,connection,31);check("Native special service routing is unchanged "+slot+" "+type,app.bound==original);}
      IntentBoundary unrelated=new IntentBoundary().setClassName("local.pocketchat","local.pocketchat.ControlledService");context.bindService(unrelated,connection,37);
      check("Non-Gecko service binding stays untouched "+slot,app.bound==unrelated);
      boolean rejected=false;try{context.bindService(new IntentBoundary().setClassName("local.pocketchat","org.mozilla.gecko.process.GeckoChildProcessServices$unknown"),connection,41);}catch(IllegalStateException expected){rejected=true;}
      check("Unknown Gecko process types remain rejected "+slot,rejected&&app.bound==unrelated);
    }
    check("Callback routing never merges environment preferences",app.preferences.get("chat").value.equals("environment0")&&app.preferences.get("env2_chat").value.equals("environment2")&&app.preferences.get("env7_chat").value.equals("environment7"));
    System.out.println("TOTAL "+checks);
  }
}

@GECKO_CONTEXT@

class Profiles {
  static final int MAX=8;
  @PROFILES@
}
class ProfileContext extends ContextWrapperBoundary {
  final int slot;final boolean ownsProcess=true;
  ProfileContext(ContextBoundary base,int id){super(base);slot=id;}
  @PROFILE_CONTEXT@
}
class PocketApplication extends ApplicationBoundary {
  final ContextBoundary[] profiles=new ContextBoundary[Profiles.MAX];
  PocketApplication(File directory){super(directory);}
  @APPLICATION_CONTEXT@
}

abstract class ContextBoundary {
  static final int MODE_MULTI_PROCESS=4;
  abstract ContextBoundary getApplicationContext();
  @API32_CONTEXT_CALLBACKS@
  abstract PrefsBoundary getSharedPreferences(String name,int mode);
  abstract File getFilesDir();abstract File getCacheDir();abstract File getNoBackupFilesDir();
  String getPackageName(){return "local.pocketchat";}
  abstract boolean bindService(IntentBoundary intent,ServiceConnectionBoundary connection,int flags);
  abstract boolean bindService(IntentBoundary intent,int flags,Executor executor,ServiceConnectionBoundary connection);
  abstract boolean bindIsolatedService(IntentBoundary intent,int flags,String instance,Executor executor,ServiceConnectionBoundary connection);
}
// API 32 ContextWrapper inherits the two Context callback methods above.
class ContextWrapperBoundary extends ContextBoundary {
  private final ContextBoundary base;
  ContextWrapperBoundary(ContextBoundary base){this.base=base;}
  ContextBoundary getBaseContext(){return base;}
  public ContextBoundary getApplicationContext(){return base.getApplicationContext();}
  public PrefsBoundary getSharedPreferences(String name,int mode){return base.getSharedPreferences(name,mode);}
  public File getFilesDir(){return base.getFilesDir();}public File getCacheDir(){return base.getCacheDir();}public File getNoBackupFilesDir(){return base.getNoBackupFilesDir();}
  public boolean bindService(IntentBoundary intent,ServiceConnectionBoundary connection,int flags){return base.bindService(intent,connection,flags);}
  public boolean bindService(IntentBoundary intent,int flags,Executor executor,ServiceConnectionBoundary connection){return base.bindService(intent,flags,executor,connection);}
  public boolean bindIsolatedService(IntentBoundary intent,int flags,String instance,Executor executor,ServiceConnectionBoundary connection){return base.bindIsolatedService(intent,flags,instance,executor,connection);}
}
class ApplicationBoundary extends ContextBoundary {
  final ComponentCallbacksControllerBoundary mCallbacksController=new ComponentCallbacksControllerBoundary();
  final Map<String,PrefsBoundary> preferences=new HashMap<>();final File files,cache,noBackup;
  IntentBoundary bound;ServiceConnectionBoundary connection;Executor executor;int flags;String instance="";
  ApplicationBoundary(File directory){files=new File(directory,"files");cache=new File(directory,"cache");noBackup=new File(directory,"no-backup");}
  public ContextBoundary getApplicationContext(){return this;}
  @API32_APPLICATION_CALLBACKS@
  public PrefsBoundary getSharedPreferences(String name,int mode){return preferences.computeIfAbsent(name,ignored->new PrefsBoundary());}
  public File getFilesDir(){return files;}public File getCacheDir(){return cache;}public File getNoBackupFilesDir(){return noBackup;}
  public boolean bindService(IntentBoundary intent,ServiceConnectionBoundary connection,int flags){bound=intent;this.connection=connection;this.flags=flags;return true;}
  public boolean bindService(IntentBoundary intent,int flags,Executor executor,ServiceConnectionBoundary connection){this.executor=executor;return bindService(intent,connection,flags);}
  public boolean bindIsolatedService(IntentBoundary intent,int flags,String instance,Executor executor,ServiceConnectionBoundary connection){this.instance=instance;return bindService(intent,flags,executor,connection);}
  static String getProcessName(){return "local.pocketchat";}
}
class BuildBoundary {static final class VERSION {static final int SDK_INT=32;}}
class PrefsBoundary {String value="";}
interface CallbacksBoundary {void onConfigurationChanged(ConfigurationBoundary configuration);void onLowMemory();}
interface Callbacks2Boundary extends CallbacksBoundary {void onTrimMemory(int level);}
class ConfigurationBoundary {}
class Callback implements Callbacks2Boundary {ConfigurationBoundary configuration;int configurations,lowMemory,trimMemory,level;public void onConfigurationChanged(ConfigurationBoundary value){configuration=value;configurations++;}public void onLowMemory(){lowMemory++;}public void onTrimMemory(int value){trimMemory++;level=value;}}
class ServiceConnectionBoundary {}
class ComponentNameBoundary {final String packageName,className;ComponentNameBoundary(String packageName,String className){this.packageName=packageName;this.className=className;}String getClassName(){return className;}}
class IntentBoundary {ComponentNameBoundary component;IntentBoundary(){}IntentBoundary(IntentBoundary source){component=source.component;}ComponentNameBoundary getComponent(){return component;}IntentBoundary setClassName(String packageName,String className){component=new ComponentNameBoundary(packageName,className);return this;}}

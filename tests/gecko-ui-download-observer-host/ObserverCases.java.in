package local.pocketchat;

import android.app.Activity;
import android.content.Intent;
import android.os.Handler;
import android.os.Looper;
import android.util.Log;
import android.view.ViewGroup;
import android.widget.Button;
import org.json.JSONObject;
import java.util.function.Consumer;

/** Android boundaries here are controlled host adapters, never device evidence. */
public final class ObserverCases {
  static final String SOURCE="a".repeat(40), INITIAL="1".repeat(32), FRESH="2".repeat(32), LATER="3".repeat(32);
  static int checks,scenarios;
  static void check(boolean value,String message){checks++;if(!value)throw new AssertionError(message);}
  static JSONObject packet()throws Exception{return new JSONObject(Log.records.get(Log.records.size()-1));}
  static final class Fixture {
    final HostActivity activity=new HostActivity();
    final ViewGroup root=new ViewGroup();
    final ViewGroup nested=new ViewGroup();
    final Button button=new Button();
    final Intent initialIntent;
    final DownloadLocationLayoutEvidence initialObserver;
    Fixture(){
      Log.records.clear();
      root.children.add(nested);nested.children.add(button);
      initialIntent=new Intent().putExtra("visualAction","downloads").putExtra("visualNonce",INITIAL);
      activity.intent=initialIntent;
      activity.downloadObservationNonces.add(INITIAL);
      initialObserver=new DownloadLocationLayoutEvidence(activity,root,INITIAL);
      activity.downloadLocationEvidence=initialObserver;
    }
    Intent request(){return new Intent().putExtra("visualObserveAction","download-location")
      .putExtra("visualObserveNonce",FRESH).putExtra("visualParentNonce",INITIAL).putExtra("visualSourceCommit",SOURCE);}
    void noMutation(){
      check(activity.intent==initialIntent,"Original invocation intent must not be replaced");
      check(activity.mutations==0&&root.mutations==0&&nested.mutations==0&&button.mutations==0,"Observation must not mutate native UI");
    }
  }

  static void clippedThenFresh()throws Exception{
    scenarios++;Fixture f=new Fixture();
    check(f.root.observer.listeners.contains(f.initialObserver),"Initial observer registered");
    check(f.initialObserver.handler.delayed.size()==1,"Initial timeout registered");
    f.initialObserver.onPreDraw();
    check(Log.records.size()==1,"Initial observation emits exactly one raw record");
    String initialRaw=Log.records.get(0);JSONObject initial=new JSONObject(initialRaw);
    check(initial.getString("status").equals("observed"),"Initial actual observation status");
    check(initial.getInt("height")==144&&initial.getInt("visibleHeight")==78,"Clipped initial geometry must remain clipped");
    check(initial.getInt("top")==750,"Initial observed screen position preserved");
    check(initial.getString("nonce").equals(INITIAL)&&initial.getString("invocationNonce").equals(INITIAL),"Original nonce ownership");
    check(f.initialObserver.closed&&f.initialObserver.handler.delayed.isEmpty(),"Initial first frame closes its own observer/timer");
    check(f.root.observer.listeners.isEmpty(),"Initial listener is removed");
    check(initial.getBoolean("actualAndroidLayout"),"Actual observer payload shape retained; host report separately declares synthetic boundaries");
    // Controlled boundary simulates the geometry after the parent runner's real
    // swipe; the observer itself receives no API that changes this geometry.
    f.button.top=400;f.button.visibleHeight=144;
    int scheduled=Handler.allDelays.size();
    f.activity.onNewIntent(f.request());
    DownloadLocationLayoutEvidence fresh=f.activity.downloadLocationEvidence;
    check(fresh!=f.initialObserver&&fresh.root==f.root&&fresh.activity==f.activity,"Fresh sample retains actual Activity/root owner");
    check(!fresh.closed&&Log.records.size()==1,"Fresh sample runs asynchronously on its posted read");
    check(Handler.allDelays.size()==scheduled+1&&fresh.handler.delayed.size()==1,"Fresh sample owns one separate timeout");
    check(f.activity.handler.posted.size()==1,"One readonly fresh observation post");
    f.activity.handler.runPosted();
    check(Log.records.size()==2,"Exactly one fresh packet");
    JSONObject current=packet();
    check(current.getString("status").equals("observed"),"Fresh native layout observed");
    check(current.getInt("visibleHeight")==144&&current.getInt("height")==144&&current.getInt("top")==400,"Fresh geometry reflects current same-button boundary");
    check(current.getString("nonce").equals(FRESH)&&current.getString("invocationNonce").equals(INITIAL),"Fresh nonce retains invocation ownership");
    check(current.getString("sourceCommit").equals(SOURCE),"Actual source asset carried into evidence");
    for(String key:new String[]{"activityIdentity","rootIdentity","buttonIdentity"})check(initial.getInt(key)==current.getInt(key),"Identity proof retained: "+key);
    check(initialRaw.equals(Log.records.get(0)),"Old clipped raw payload is not modified");
    check(fresh.closed&&fresh.handler.delayed.isEmpty()&&f.root.observer.listeners.isEmpty(),"Fresh sample releases its timeout/listener");
    int emitted=Log.records.size();fresh.onPreDraw();fresh.run();f.initialObserver.run();
    check(Log.records.size()==emitted,"Closed observers cannot emit later synthetic success");
    f.noMutation();
  }

  static void reject(String name,Consumer<Fixture> alter,Consumer<Intent> requestAlter,String reason)throws Exception{
    scenarios++;Fixture f=new Fixture();alter.accept(f);Intent request=f.request();requestAlter.accept(request);
    DownloadLocationLayoutEvidence before=f.activity.downloadLocationEvidence;
    int registrations=f.root.observer.added,scheduled=Handler.allDelays.size(),nonces=f.activity.downloadObservationNonces.size();
    f.activity.onNewIntent(request);
    check(Log.records.size()==1,name+": explicit rejection packet required");
    JSONObject p=packet();check(p.getString("status").equals("rejected"),name+": no observed success");
    check(p.getString("reason").equals(reason),name+": exact rejection reason");
    check(f.activity.downloadLocationEvidence==before,name+": no observer replacement before validation");
    check(f.root.observer.added==registrations&&Handler.allDelays.size()==scheduled,name+": rejected request schedules no observer");
    check(f.activity.handler.posted.isEmpty()&&f.activity.downloadObservationNonces.size()==nonces,name+": rejection changes neither posts nor nonce ownership");
    check(!f.initialObserver.closed,name+": rejection leaves prior pending observer intact");
    f.activity.handler.runPosted();check(Log.records.size()==1,name+": no delayed successful response");
    f.noMutation();f.initialObserver.close();
  }

  static void rejectionCases()throws Exception{
    reject("foreign source",f->{},i->i.putExtra("visualSourceCommit","b".repeat(40)),"source");
    reject("missing source",f->{},i->i.extras.remove("visualSourceCommit"),"source");
    reject("dirty source",f->f.activity.assets.stamp="{\"sourceCommit\":\""+SOURCE+"\",\"dirtySource\":true}",i->{},"invalid-observation");
    reject("malformed asset",f->f.activity.assets.stamp="not json",i->{},"invalid-observation");
    reject("oversized asset",f->f.activity.assets.stamp=" ".repeat(8193),i->{},"invalid-observation");
    reject("short asset source",f->f.activity.assets.stamp="{\"sourceCommit\":\"abc\",\"dirtySource\":false}",i->{},"invalid-observation");
    reject("foreign package",f->f.activity.packageName="local.pocketchat",i->{},"test-package");
    reject("wrong scene",f->f.activity.intent.putExtra("visualAction","chat"),i->{},"scene");
    reject("missing observer",f->f.activity.downloadLocationEvidence=null,i->{},"scene");
    reject("wrong action",f->{},i->i.putExtra("visualObserveAction","force-layout"),"action");
    reject("missing action",f->{},i->i.extras.remove("visualObserveAction"),"action");
    reject("foreign parent",f->{},i->i.putExtra("visualParentNonce","4".repeat(32)),"nonce");
    reject("missing parent",f->{},i->i.extras.remove("visualParentNonce"),"nonce");
    reject("malformed nonce",f->{},i->i.putExtra("visualObserveNonce","not-a-nonce"),"nonce");
    reject("uppercase nonce",f->{},i->i.putExtra("visualObserveNonce","A".repeat(32)),"nonce");
    reject("short nonce",f->{},i->i.putExtra("visualObserveNonce","2".repeat(31)),"nonce");
    reject("missing nonce",f->{},i->i.extras.remove("visualObserveNonce"),"nonce");
    reject("initial nonce replay",f->{},i->i.putExtra("visualObserveNonce",INITIAL),"nonce");
    reject("used fresh nonce",f->f.activity.downloadObservationNonces.add(FRESH),i->{},"nonce");
    reject("unreadable extras",f->{},i->i.unreadable=true,"invalid-observation");
    scenarios++;Fixture f=new Fixture();int registrations=f.root.observer.added;
    f.activity.onNewIntent(null);
    check(packet().getString("reason").equals("action")&&packet().getString("status").equals("rejected"),"Null request explicitly rejected");
    check(f.root.observer.added==registrations&&f.activity.downloadLocationEvidence==f.initialObserver,"Null request cannot create observer");
    f.noMutation();f.initialObserver.close();
  }

  static void notReady(String name,Consumer<Fixture> alter)throws Exception{
    scenarios++;Fixture f=new Fixture();alter.accept(f);
    f.initialObserver.onPreDraw();
    check(Log.records.isEmpty()&&!f.initialObserver.closed,name+": not-ready views cannot produce an observed packet");
    check(f.initialObserver.handler.delayed.size()==1,name+": existing five-second failure timer remains");
    f.initialObserver.handler.runDelayed();
    check(Log.records.size()==1&&packet().getString("status").equals("failed"),name+": timer emits explicit failure");
    check(f.initialObserver.closed&&f.root.observer.listeners.isEmpty(),name+": failure cleans listener");
    f.initialObserver.onPreDraw();check(Log.records.size()==1,name+": no success after failure");f.noMutation();
  }

  static void readinessAndFailureCases()throws Exception{
    notReady("root requests layout",f->f.root.requested=true);
    notReady("button requests layout",f->f.button.requested=true);
    notReady("button not laid out",f->f.button.laidOut=false);
    notReady("button detached",f->f.button.attached=false);
    notReady("background window",f->f.button.focused=false);
    notReady("missing layout",f->f.button.layout=null);
    notReady("no matching button",f->f.button.text="别的按钮");
    notReady("multiple matching buttons",f->f.root.children.add(new Button()));
    for(int lines:new int[]{0,9}){
      scenarios++;Fixture f=new Fixture();f.button.layout.lineCount=lines;f.initialObserver.onPreDraw();
      check(Log.records.size()==1&&packet().getString("status").equals("failed"),"Impossible line count must fail");
      check(f.initialObserver.closed,"Impossible layout releases observer");f.noMutation();
    }
    for(String nonce:new String[]{null,"bad"}){
      scenarios++;Fixture f=new Fixture();f.initialObserver.close();
      DownloadLocationLayoutEvidence invalid=new DownloadLocationLayoutEvidence(f.activity,f.root,nonce,INITIAL);
      invalid.onPreDraw();check(packet().getString("status").equals("failed"),"Malformed observation nonce cannot produce success");
      check(invalid.closed,"Malformed nonce observer closed");f.noMutation();
    }
    scenarios++;Fixture f=new Fixture();f.initialObserver.close();
    DownloadLocationLayoutEvidence badParent=new DownloadLocationLayoutEvidence(f.activity,f.root,FRESH,"bad");
    badParent.onPreDraw();check(packet().getString("status").equals("failed"),"Malformed invocation nonce rejected in actual observer");f.noMutation();
  }

  static void unchangedNegativeGeometry()throws Exception{
    scenarios++;Fixture f=new Fixture();f.button.shown=false;f.button.enabled=false;f.button.clickable=false;f.button.globallyVisible=false;
    f.button.visibleWidth=0;f.button.visibleHeight=0;f.button.layout.ellipsisCount=2;
    f.initialObserver.onPreDraw();JSONObject p=packet();
    check(!p.getBoolean("shown")&&!p.getBoolean("enabled")&&!p.getBoolean("clickable"),"Negative view properties are reported unchanged, never forced true");
    check(p.getInt("visibleWidth")==0&&p.getInt("visibleHeight")==0,"Invisible geometry stays invisible for downstream strict verifier");
    check(p.getJSONArray("lines").getJSONObject(0).getInt("ellipsisCount")==2,"Truncated glyph evidence is not repaired");f.noMutation();
  }

  static void stalePostAndReplay()throws Exception{
    scenarios++;Fixture f=new Fixture();f.initialObserver.onPreDraw();f.button.visibleHeight=144;
    f.activity.onNewIntent(f.request());DownloadLocationLayoutEvidence superseded=f.activity.downloadLocationEvidence;
    f.activity.onNewIntent(f.request().putExtra("visualObserveNonce",LATER));
    check(superseded.closed,"Replacing fresh observer closes superseded observer");
    check(f.activity.handler.posted.size()==2,"Both original readonly posts remain explicitly queued");
    f.activity.handler.runPosted();
    check(Log.records.size()==2&&packet().getString("nonce").equals(LATER),"Stale posted observer emits no packet");
    int registered=f.root.observer.added;DownloadLocationLayoutEvidence current=f.activity.downloadLocationEvidence;
    f.activity.onNewIntent(f.request());
    check(packet().getString("status").equals("rejected")&&packet().getString("reason").equals("nonce"),"Consumed fresh nonce cannot be replayed after newer observation");
    check(f.root.observer.added==registered&&f.activity.downloadLocationEvidence==current,"Replay cannot recreate native observation");f.noMutation();
  }

  static void closedBeforePostedRead()throws Exception{
    scenarios++;Fixture f=new Fixture();f.activity.onNewIntent(f.request());
    DownloadLocationLayoutEvidence fresh=f.activity.downloadLocationEvidence;fresh.close();fresh.close();
    f.activity.handler.runPosted();fresh.run();fresh.onPreDraw();
    check(Log.records.isEmpty(),"Closing before readonly post prevents all observed success");
    check(fresh.handler.delayed.isEmpty()&&f.root.observer.listeners.isEmpty(),"Close cancels timer and listeners idempotently");f.noMutation();
  }

  public static void main(String[] args)throws Exception{
    clippedThenFresh();rejectionCases();readinessAndFailureCases();unchangedNegativeGeometry();stalePostAndReplay();closedBeforePostedRead();
    check(!Handler.allDelays.isEmpty(),"Actual observer timers exercised");
    for(long delay:Handler.allDelays)check(delay==5000,"Every actual observer keeps the original five-second budget");
    System.out.println(new JSONObject().put("status","passed").put("passed",checks).put("total",checks)
      .put("scenarios",scenarios).put("observerTimersChecked",Handler.allDelays.size()).put("actualAndroidExecution",false));
  }
}

final class HostActivity extends Activity {
  DownloadLocationLayoutEvidence downloadLocationEvidence;
  final java.util.Set<String> downloadObservationNonces=new java.util.HashSet<>();
  final Handler handler=new Handler(Looper.getMainLooper());
  /* ACTUAL_ACTIVITY_MEMBERS */
}

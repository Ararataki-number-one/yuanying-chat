package local.pocketchat;
import org.json.*;import java.util.*;import android.content.Context;import android.database.Cursor;import android.database.sqlite.SQLiteDatabase;
public final class SnapshotCases {
 static final JSONArray checks=new JSONArray(),measurements=new JSONArray();static void check(String name,boolean pass){checks.put(J.obj("name",name,"pass",pass));}
 static JSONObject item(String id,int slot,String state,String uri,long time){return J.obj("id",id,"slot",slot,"state",state,"uri",uri,"name",id+".txt","time",time,"received",1,"total",100);}
 static void install(JSONArray files,JSONArray tasks,JSONArray deleted){DownloadLibrary.instance=new DownloadLibrary();SQLiteDatabase db=DownloadLibrary.instance.db;for(int i=0;i<files.length();i++)db.add("files",files.getJSONObject(i));for(int i=0;i<tasks.length();i++)db.add("tasks",tasks.getJSONObject(i));for(int i=0;i<deleted.length();i++)db.addDelete(deleted.getJSONObject(i).getString("uri"),deleted.getJSONObject(i).getLong("time"));}
 static String identity(JSONArray rows){JSONArray out=new JSONArray();for(int i=0;i<rows.length();i++)out.put(rows.getJSONObject(i));return out.toString();}
 static void counts(){for(int count:new int[]{100,1000}){
  JSONArray files=new JSONArray(),tasks=new JSONArray();for(int i=0;i<count;i++){JSONObject row=item("saved"+i,i%8,"saved","content://file/"+i,1000+i);files.put(row);tasks.put(new JSONObject(row.toString()));}tasks.put(item("active",0,"downloading","",2000+count));
  install(files,tasks,new JSONArray());JSONArray before=LegacyDisplay.rows(new Context());SQLiteDatabase old=DownloadLibrary.instance.db;
  check(count+" legacy exact read path uses four queries",old.queries==4&&old.jsonReads==3*count+1);
  install(files,tasks,new JSONArray());JSONArray after=DownloadDisplaySnapshot.read(new Context());SQLiteDatabase next=DownloadLibrary.instance.db;
  check(count+" snapshot exact read path uses one statement",next.queries==1&&next.jsonReads==2*count+1);
  check(count+" complete rows/order remain equal",identity(before).equals(identity(after))&&after.length()==count+1&&after.getJSONObject(0).optString("id").equals("active"));
  check(count+" read statement takes no write transaction",next.begins==0&&next.successes==0&&next.ends==0&&!next.inTransaction());
  measurements.put(J.obj("savedRows",count,"activeRows",1,"oldQueries",old.queries,"newQueries",next.queries,"oldParsedJsonRows",old.jsonReads,"newParsedJsonRows",next.jsonReads,"completeRowsIdentical",true));
 }}
 static void boundaries(){
  JSONObject saved=item("same-a",0,"saved","content://same",100),tie=item("same-b",1,"saved","content://same",100),newer=item("newer",2,"saved","content://new",200);
  JSONArray files=new JSONArray().put(saved).put(tie).put(newer),tasks=new JSONArray().put(item("same-a",0,"failed","content://same",100)).put(item("same-b",1,"failed","content://same",100)).put(item("old",3,"failed","content://new",199)).put(item("deleted",4,"failed","content://deleted",90)).put(item("later",4,"failed","content://deleted",101)).put(item("active",0,"downloading","",500));JSONArray deleted=new JSONArray().put(J.obj("uri","content://deleted","time",100));
  install(files,tasks,deleted);String before=identity(LegacyDisplay.rows(new Context()));install(files,tasks,deleted);JSONArray after=DownloadDisplaySnapshot.read(new Context());check("Equal-time different-ID, tombstone cutoff and newer replacement retain exact pruning",before.equals(identity(after)));
  for(int stage:new int[]{0,1,4}){install(files,tasks,deleted);SQLiteDatabase db=DownloadLibrary.instance.db;db.failRead=stage;boolean failed=false;try{DownloadDisplaySnapshot.read(new Context());}catch(IllegalStateException expected){failed=true;}check("Cursor failure after "+stage+" rows is not authoritative empty success",failed&&db.successes==0&&db.ends==0&&db.closed==1);}
  install(files,tasks,deleted);SQLiteDatabase db=DownloadLibrary.instance.db;final SQLiteDatabase changed=db;db.mutateAfterFirstRead=()->changed.clear("tasks");String stable=identity(DownloadDisplaySnapshot.read(new Context()));check("A source change while consuming the statement does not split the snapshot",stable.equals(before)&&db.tables.get("tasks").isEmpty());
  install(files,tasks,deleted);db=DownloadLibrary.instance.db;db.failQuery=1;boolean escaped=false;try{DownloadDisplaySnapshot.read(new Context());}catch(IllegalStateException expected){escaped=true;}check("Statement failure escapes read for outer retry and creates no transaction",escaped&&db.ends==0&&db.begins==0);

 }
 public static void main(String[] ignored){counts();boundaries();int passed=0;for(int i=0;i<checks.length();i++)if(checks.getJSONObject(i).getBoolean("pass"))passed++;System.out.println(J.obj("status",passed==checks.length()?"passed":"failed","passed",passed,"total",checks.length(),"checks",checks,"measurements",measurements));if(passed!=checks.length())System.exit(1);}
}
class DownloadLibrary {
 static DownloadLibrary instance;final SQLiteDatabase db=new SQLiteDatabase();static DownloadLibrary get(Context c){return instance;}void migrate(){}void migrateTasks(){}SQLiteDatabase getReadableDatabase(){return db;}
 /* LEGACY_MEMBERS */
}
class LegacyDisplay {/* LEGACY_DISPLAY */}
class ProfileCatalog {static ProfileCatalog get(Context c){return new ProfileCatalog();}Map<Integer,String> names(){return new HashMap<>();}}

package local.pocketchat;

import android.content.Context;
import android.net.Uri;
import android.os.Binder;
import android.os.ParcelFileDescriptor;
import android.util.AtomicFile;
import android.util.Log;
import java.io.File;
import java.io.FileNotFoundException;
import java.nio.charset.StandardCharsets;
import java.nio.file.Files;
import java.security.MessageDigest;
import java.util.ArrayList;
import java.util.HashSet;
import java.util.List;
import java.util.Set;
import java.util.concurrent.CountDownLatch;
import java.util.concurrent.TimeUnit;
import java.util.concurrent.atomic.AtomicReference;
import org.json.JSONArray;
import org.json.JSONObject;

/** Complete actual classes run with explicit synthetic Android boundary adapters. */
public final class JournalCases {
  static int checks,scenarios,nextNonce;
  static final List<File> temporaryRoots=new ArrayList<>();
  interface Throwing {void run()throws Exception;}
  static void check(boolean value,String message){checks++;if(!value)throw new AssertionError(message);}
  static void rejects(Class<? extends Throwable> type,Throwing work,String message)throws Exception{
    try{work.run();}catch(Throwable error){check(type.isInstance(error),message+": wrong exception "+error);return;}throw new AssertionError(message+": accepted");
  }
  static void await(CountDownLatch latch)throws Exception{if(!latch.await(15,TimeUnit.SECONDS))throw new AssertionError("Controlled worker barrier did not drain");}
  static void drain()throws Exception{CountDownLatch done=new CountDownLatch(1);Runnable barrier=done::countDown;try{IntegrationEventStore.IO.execute(barrier);}catch(java.util.concurrent.RejectedExecutionException full){if(IntegrationEventStore.IO.isShutdown())throw full;IntegrationEventStore.IO.getQueue().put(barrier);}await(done);check(IntegrationEventStore.pendingBytes==0,"Actual worker releases all reserved queue bytes");}
  static String nonce(){return String.format(java.util.Locale.ROOT,"%032x",++nextNonce);}
  static final class Fixture {
    final Context context;
    final IntegrationEvidenceProvider provider=new IntegrationEvidenceProvider();
    final String nonce=nonce();
    final int slot;
    final IntegrationEventStore store;
    Fixture()throws Exception{this(1);}
    Fixture(int selectedSlot)throws Exception{
      slot=selectedSlot;File directory=Files.createTempDirectory("journal-case-").toFile();temporaryRoots.add(directory);context=new Context(directory);
      provider.context=context;check(provider.onCreate(),"Actual provider accepts owned test package");
      store=new IntegrationEventStore(context,slot,nonce,"readingFixtureCookieCleanup",23,J.obj("sourceCommit","a".repeat(40)));
    }
    File journal()throws Exception{return IntegrationEventStore.journalFile(context,slot,nonce);}
    File payload(int sequence)throws Exception{return IntegrationEventStore.file(context,slot,nonce,sequence);}
    Uri journalUri(){return Uri.parse("content://local.pocketchat.test.evidence/gecko-event-receipts/"+slot+"/"+nonce);}
    byte[] providerBytes()throws Exception{try(ParcelFileDescriptor descriptor=provider.openFile(journalUri(),"r")){return descriptor.bytes();}}
    JSONObject snapshot()throws Exception{return new JSONObject(new String(providerBytes(),StandardCharsets.UTF_8));}
  }
  static List<String> markers(String nonce)throws Exception{
    List<String> values=new ArrayList<>();for(String raw:Log.records){JSONObject value=new JSONObject(raw);if(nonce.equals(value.optString("runNonce"))&&"eventReceipt".equals(value.optString("kind")))values.add(raw);}return values;
  }
  static List<String> errors(String nonce)throws Exception{
    List<String> values=new ArrayList<>();for(String raw:Log.records){JSONObject value=new JSONObject(raw);if(nonce.equals(value.optString("runNonce"))&&"eventTransportError".equals(value.optString("kind")))values.add(raw);}return values;
  }
  static String sha(byte[] bytes)throws Exception{StringBuilder result=new StringBuilder();for(byte value:MessageDigest.getInstance("SHA-256").digest(bytes))result.append(String.format(java.util.Locale.ROOT,"%02x",value&255));return result.toString();}
  static JSONArray verifyJournal(Fixture f,int count)throws Exception{
    JSONObject journal=f.snapshot();
    check(journal.getInt("schema")==1&&journal.getString("status").equals("committed"),"Only actual committed native envelope is accepted");
    check(journal.getString("runNonce").equals(f.nonce)&&journal.getInt("processSlot")==f.slot,"Journal retains exact native invocation owner");
    check(journal.getString("fixtureAction").equals("readingFixtureCookieCleanup")&&journal.getLong("command")==23,"Journal retains exact action and native command");
    JSONArray receipts=journal.getJSONArray("receipts");List<String> logged=markers(f.nonce);
    check(receipts.length()==count&&logged.size()==count,"Journal/log exact successful prefix length");
    for(int index=0;index<count;index++){
      String marker=receipts.getString(index);check(marker.equals(logged.get(index)),"Journal stores exact original native marker bytes; no receipt reconstruction");
      JSONObject receipt=new JSONObject(marker);check(receipt.getInt("sequence")==index+1,"Native prefix remains strictly contiguous without sorting/filling");
      byte[] raw=Files.readAllBytes(f.payload(index+1).toPath());
      check(receipt.getInt("payloadBytes")==raw.length&&receipt.getString("payloadSha256").equals(sha(raw)),"Receipt binds the exact completed payload bytes");
      JSONObject payload=new JSONObject(new String(raw,StandardCharsets.UTF_8));
      check(payload.getInt("sequence")==index+1&&payload.getString("runNonce").equals(f.nonce)&&payload.getLong("command")==23,"Payload identity matches native marker");
      check(payload.getJSONObject("event").getString("kind").equals(receipt.getString("eventKind")),"Exact native event kind preserved");
    }
    return receipts;
  }
  static void happyPathAndOrdering()throws Exception{
    scenarios++;Fixture f=new Fixture();
    f.store.emit("initialRouteReady",J.obj("value","unicode 保存; \"quoted\"\nline"));
    f.store.emit("readingFixtureCookieCleanup",J.obj("sameSession",true));drain();
    JSONArray receipts=verifyJournal(f,2);
    check(receipts.getString(0).contains("initialRouteReady"),"Actual first marker retained");
    List<String> ops=AtomicFile.operations;
    for(int sequence=1;sequence<=2;sequence++){
      int payloadFinish=ops.indexOf("finish:"+f.payload(sequence).getName());
      int log=ops.indexOf("log:"+receipts.getString(sequence-1));
      int journalFinish=-1;for(int i=payloadFinish+1;i<log;i++)if(ops.get(i).equals("finish:"+f.journal().getName()))journalFinish=i;
      check(payloadFinish>=0&&journalFinish>payloadFinish&&log>journalFinish,"Each actual publication orders payload -> journal -> log");
    }
    check(AtomicFile.lastWriter!=Thread.currentThread()&&AtomicFile.lastWriter.getName().equals("integration-event-io"),"All real file commits execute on original dedicated worker");
    try(ParcelFileDescriptor descriptor=f.provider.openFile(Uri.parse("content://local.pocketchat.test.evidence/gecko-events/1/"+f.nonce+"/1"),"r")){
      check(java.util.Arrays.equals(descriptor.bytes(),Files.readAllBytes(f.payload(1).toPath())),"Existing full payload provider stays byte exact");
    }
  }
  static void stableAtomicPrefix()throws Exception{
    scenarios++;Fixture f=new Fixture();f.store.emit("first",J.obj("index",1));drain();byte[] previous=f.providerBytes();
    CountDownLatch inside=new CountDownLatch(1),release=new CountDownLatch(1);
    AtomicFile.beforeCommit=file->{if(file.equals(uncheckedJournal(f))){inside.countDown();try{await(release);}catch(Exception error){throw new java.io.IOException(error);}}};
    f.store.emit("second",J.obj("index",2));await(inside);
    check(f.payload(2).isFile(),"Second payload is already committed before journal replacement");
    check(java.util.Arrays.equals(previous,f.providerBytes()),"Provider exposes only previous complete prefix during next commit");
    check(markers(f.nonce).size()==1,"Uncommitted journal cannot log its second marker");
    ParcelFileDescriptor oldDescriptor=f.provider.openFile(f.journalUri(),"r");
    AtomicFile.beforeCommit=null;release.countDown();drain();
    try{check(java.util.Arrays.equals(previous,oldDescriptor.bytes()),"Already opened real file descriptor retains immutable old prefix");}finally{oldDescriptor.close();}
    verifyJournal(f,2);
  }
  static File uncheckedJournal(Fixture f){try{return f.journal();}catch(Exception error){throw new IllegalStateException(error);}}
  static void pendingBeforeFirstCommit()throws Exception{
    scenarios++;Fixture f=new Fixture();CountDownLatch inside=new CountDownLatch(1),release=new CountDownLatch(1);
    AtomicFile.beforeCommit=file->{if(file.equals(uncheckedJournal(f))){inside.countDown();try{await(release);}catch(Exception error){throw new java.io.IOException(error);}}};
    f.store.emit("first",J.obj("index",1));await(inside);
    check(f.payload(1).isFile()&&!f.journal().exists(),"First payload may exist before any committed native receipt");
    JSONObject pending=f.snapshot();check(pending.getString("status").equals("pending")&&!pending.has("receipts"),"Payload presence cannot fabricate an empty committed receipt snapshot");
    check(markers(f.nonce).isEmpty(),"First native log receipt also waits for journal commit");
    AtomicFile.beforeCommit=null;release.countDown();drain();verifyJournal(f,1);
    scenarios++;Fixture failed=new Fixture();AtomicFile.failName=failed.journal().getName();AtomicFile.failPhase="write";
    failed.store.emit("first",J.obj());drain();
    check(failed.store.publicationFailed&&failed.payload(1).isFile()&&!failed.journal().exists(),"Failed first journal retains no falsely committed receipt");
    check(failed.snapshot().getString("status").equals("pending")&&markers(failed.nonce).isEmpty(),"Failed first publication is not reinterpreted as successful evidence");
    check(errors(failed.nonce).size()==1,"Failed first native commit retains its explicit transport error");
  }
  static CountDownLatch holdWorker()throws Exception{
    CountDownLatch inside=new CountDownLatch(1),release=new CountDownLatch(1);
    IntegrationEventStore.IO.execute(()->{inside.countDown();try{await(release);}catch(Exception error){throw new IllegalStateException(error);}});await(inside);return release;
  }
  static void injectedFailure(String target,String phase)throws Exception{
    scenarios++;Fixture f=new Fixture();f.store.emit("first",J.obj("index",1));drain();byte[] previous=f.providerBytes();
    CountDownLatch release=holdWorker();AtomicFile.failName=target.equals("journal")?f.journal().getName():f.payload(2).getName();AtomicFile.failPhase=phase;
    f.store.emit("second",J.obj("index",2));f.store.emit("third",J.obj("index",3));release.countDown();drain();
    check(f.store.publicationFailed,target+" "+phase+": actual worker poisons failed invocation");
    check(java.util.Arrays.equals(previous,f.providerBytes()),target+" "+phase+": durable committed prefix survives failure");
    check(markers(f.nonce).size()==1,target+" "+phase+": failed and later queued event cannot become success");
    check(!f.payload(3).exists(),target+" "+phase+": poisoned queued event cannot publish payload");
    check(!errors(f.nonce).isEmpty(),target+" "+phase+": native transport failure remains explicit");
    rejects(IllegalStateException.class,()->f.store.emit("fourth",J.obj()),target+" "+phase+": future synchronous emit fails closed");
    check(java.util.Arrays.equals(previous,f.providerBytes()),"Later emit cannot repair/fill failed journal gap");
    Fixture other=new Fixture();other.store.emit("independent",J.obj("ok",true));drain();verifyJournal(other,1);
  }
  static void concurrentProducers()throws Exception{
    scenarios++;Fixture f=new Fixture();int threads=6,each=8;CountDownLatch ready=new CountDownLatch(threads),start=new CountDownLatch(1),done=new CountDownLatch(threads);AtomicReference<Throwable> failed=new AtomicReference<>();
    for(int worker=0;worker<threads;worker++){final int owner=worker;new Thread(()->{ready.countDown();try{await(start);for(int i=0;i<each;i++)f.store.emit("concurrent",J.obj("owner",owner,"index",i));}catch(Throwable error){failed.compareAndSet(null,error);}finally{done.countDown();}},"controlled-producer-"+worker).start();}
    await(ready);start.countDown();await(done);check(failed.get()==null,"Actual synchronized emit accepts concurrent producers");drain();
    verifyJournal(f,threads*each);Set<String> observed=new HashSet<>();
    for(int i=1;i<=threads*each;i++){JSONObject result=new JSONObject(Files.readString(f.payload(i).toPath())).getJSONObject("event").getJSONObject("result");observed.add(result.getInt("owner")+":"+result.getInt("index"));}
    check(observed.size()==threads*each,"Concurrent native snapshots lose or duplicate no offered event");
  }
  static void queueCountBound()throws Exception{
    scenarios++;Fixture f=new Fixture();f.store.emit("prefix",J.obj());drain();byte[] old=f.providerBytes();CountDownLatch release=holdWorker();
    for(int i=0;i<128;i++)f.store.emit("queued",J.obj("index",i));
    check(IntegrationEventStore.IO.getQueue().size()==128,"Actual original queue caps at128 queued tasks");
    rejects(java.util.concurrent.RejectedExecutionException.class,()->f.store.emit("overflow",J.obj()),"129th queued event rejected");
    check(f.store.publicationFailed,"Queue rejection poisons invocation before any gap can publish");
    release.countDown();drain();check(java.util.Arrays.equals(old,f.providerBytes())&&markers(f.nonce).size()==1,"Queue overflow keeps old prefix and admits no queued replacement success");
  }
  static void queueByteBound()throws Exception{
    scenarios++;Fixture f=new Fixture();CountDownLatch release=holdWorker();String blob="x".repeat(1800000);
    for(int i=0;i<4;i++)f.store.emit("large",J.obj("blob",blob,"index",i));
    check(IntegrationEventStore.pendingBytes>7*1024*1024-256*1024&&IntegrationEventStore.pendingBytes<=8*1024*1024,"Real serialized pending payload bytes remain bounded");
    rejects(IllegalStateException.class,()->f.store.emit("over-byte-budget",J.obj("blob",blob)),"Queue byte budget rejects fifth large payload");
    release.countDown();drain();check(!f.journal().exists()&&markers(f.nonce).isEmpty(),"Byte-budget failure cannot expose an empty or gapped committed journal");
    check(f.snapshot().getString("status").equals("pending"),"Absent committed journal stays explicitly pending");
  }
  static void eventAndJournalBounds()throws Exception{
    scenarios++;Fixture f=new Fixture();rejects(IllegalStateException.class,()->f.store.emit("oversize",J.obj("blob","x".repeat(IntegrationEventStore.MAX_BYTES))),"Actual payload MAX_BYTES rejected");
    rejects(IllegalStateException.class,()->f.store.emit("later",J.obj()),"Oversize poisons subsequent emits");
    check(!f.journal().exists(),"Rejected oversize payload produces no committed journal");
    scenarios++;Fixture journal=new Fixture();String kind="k".repeat(1200000);
    for(int i=0;i<3;i++){journal.store.emit(kind,J.obj("index",i));drain();}
    byte[] old=journal.providerBytes();check(old.length<IntegrationEventStore.MAX_JOURNAL_BYTES,"Three actual large markers fit bounded journal");
    journal.store.emit(kind,J.obj("index",3));drain();
    check(journal.store.publicationFailed&&java.util.Arrays.equals(old,journal.providerBytes()),"Actual journal bound preserves last complete prefix");
    check(markers(journal.nonce).size()==3,"Oversized next journal never logs successful fourth receipt");
  }
  static void providerBoundaries()throws Exception{
    scenarios++;Fixture f=new Fixture();int pipeBefore=ParcelFileDescriptor.pipes,openBefore=ParcelFileDescriptor.opened;
    byte[] raw=f.providerBytes();JSONObject pending=new JSONObject(new String(raw,StandardCharsets.UTF_8));
    check(raw.length<512&&pending.getInt("schema")==1&&pending.getString("status").equals("pending"),"Native absent-journal pipe is explicitly pending and bounded");
    check(pending.getString("runNonce").equals(f.nonce)&&pending.getInt("processSlot")==1&&!pending.has("receipts"),"Pending cannot invent empty successful receipt list");
    check(ParcelFileDescriptor.pipes==pipeBefore+1&&ParcelFileDescriptor.opened==openBefore,"Absent journal uses actual provider pipe branch");
    for(int uid:new int[]{0,1000,10000}){Binder.uid=uid;rejects(SecurityException.class,()->f.provider.openFile(f.journalUri(),"r"),"Only shell UID2000 may read journal");}Binder.uid=2000;
    for(String mode:new String[]{"w","rw","wa","",null})rejects(SecurityException.class,()->f.provider.openFile(f.journalUri(),mode),"Journal provider is read-only");
    for(String path:new String[]{"/gecko-event-receipts/-1/"+f.nonce,"/gecko-event-receipts/8/"+f.nonce,"/gecko-event-receipts/01/"+f.nonce,"/gecko-event-receipts/0/bad","/gecko-event-receipts/0/"+"A".repeat(32),"/gecko-event-receipts/0/"+f.nonce+"/extra","/gecko-event-receipts/0/..","/unowned"})
      rejects(FileNotFoundException.class,()->f.provider.openFile(Uri.parse("content://local.pocketchat.test.evidence"+path),"r"),"Malformed journal ownership path rejected");
    for(int slot=0;slot<8;slot++){
      Uri uri=Uri.parse("content://local.pocketchat.test.evidence/gecko-event-receipts/"+slot+"/"+f.nonce);
      try(ParcelFileDescriptor descriptor=f.provider.openFile(uri,"r")){JSONObject p=new JSONObject(new String(descriptor.bytes(),StandardCharsets.UTF_8));check(p.getInt("processSlot")==slot&&p.getString("status").equals("pending"),"All eight valid slots retain explicit pending ownership");}
    }
    IntegrationEvidenceProvider foreign=new IntegrationEvidenceProvider();foreign.context=f.context;f.context.packageName="local.pocketchat";
    rejects(SecurityException.class,foreign::onCreate,"Provider refuses non-test package");f.context.packageName="local.pocketchat.test";
    f.journal().getParentFile().mkdirs();Files.write(f.journal().toPath(),new byte[0]);
    rejects(FileNotFoundException.class,()->f.provider.openFile(f.journalUri(),"r"),"Zero byte journal is failed evidence, not pending");
    Files.write(f.journal().toPath(),new byte[IntegrationEventStore.MAX_JOURNAL_BYTES+1]);
    rejects(FileNotFoundException.class,()->f.provider.openFile(f.journalUri(),"r"),"Journal provider enforces4MiB bound");
    Files.delete(f.journal().toPath());f.journal().mkdir();
    rejects(FileNotFoundException.class,()->f.provider.openFile(f.journalUri(),"r"),"Journal directory cannot masquerade as committed file");
    scenarios++;Fixture payload=new Fixture();payload.payload(1).getParentFile().mkdirs();Files.write(payload.payload(1).toPath(),new byte[IntegrationEventStore.MAX_BYTES+1]);
    rejects(FileNotFoundException.class,()->payload.provider.openFile(Uri.parse("content://local.pocketchat.test.evidence/gecko-events/1/"+payload.nonce+"/1"),"r"),"Existing payload provider retains original2MiB bound");
  }
  static void constructorAndPathOwnership()throws Exception{
    scenarios++;Fixture f=new Fixture();
    for(int slot:new int[]{-1,8})rejects(SecurityException.class,()->new IntegrationEventStore(f.context,slot,f.nonce,"case",1,J.obj("sourceCommit","a".repeat(40))),"Store slot ownership required");
    for(String nonce:new String[]{null,"bad","A".repeat(32)})rejects(SecurityException.class,()->IntegrationEventStore.journalFile(f.context,0,nonce),"Journal file cannot escape native nonce ownership");
    rejects(SecurityException.class,()->new IntegrationEventStore(f.context,0,f.nonce,"bad/action",1,J.obj()),"Store action syntax required");
    rejects(SecurityException.class,()->new IntegrationEventStore(f.context,0,f.nonce,"case",0,J.obj()),"Native positive command required");
    check(f.journal().getParentFile().getCanonicalFile().equals(new File(f.context.directory,"integration-events").getCanonicalFile()),"Journal resolves inside original global evidence directory");
    File journal=f.journal();journal.getParentFile().mkdirs();File outside=new File(f.context.directory,"outside.json");Files.writeString(outside.toPath(),"outside must stay private");Files.createSymbolicLink(journal.toPath(),outside.toPath());
    rejects(SecurityException.class,()->f.provider.openFile(f.journalUri(),"r"),"Canonical ownership check rejects journal symlink escape");
  }
  static void cleanup()throws Exception{
    for(File root:temporaryRoots)try(java.util.stream.Stream<java.nio.file.Path> paths=Files.walk(root.toPath())){paths.sorted(java.util.Comparator.reverseOrder()).forEach(path->{try{Files.deleteIfExists(path);}catch(Exception failure){throw new IllegalStateException(failure);}});}
  }
  public static void main(String[] args)throws Exception{
    try{
      happyPathAndOrdering();stableAtomicPrefix();pendingBeforeFirstCommit();for(String target:new String[]{"payload","journal"})for(String phase:new String[]{"start","write","finish"})injectedFailure(target,phase);
      concurrentProducers();queueCountBound();queueByteBound();eventAndJournalBounds();providerBoundaries();constructorAndPathOwnership();
      System.out.println(J.obj("schema",1,"status","passed","passed",checks,"total",checks,"scenarios",scenarios,"actualAndroidExecution",false));
    }finally{AtomicFile.beforeCommit=null;IntegrationEventStore.IO.shutdownNow();IntegrationEventStore.IO.awaitTermination(15,TimeUnit.SECONDS);cleanup();}
  }
}

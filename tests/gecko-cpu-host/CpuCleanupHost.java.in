package local.pocketchat;

import java.io.*;
import java.nio.file.*;
import java.util.*;

/** Real filesystem test of the actual current deletion branch and erase code. */
public final class CpuCleanupHost {
  static final List<String> checks=new ArrayList<>();
  static final String[] OLD_PRIVATE={"network","network-ui","exit-baseline","exit-region","subscription","subscription-meta","subscription-ui","exit-subscription","exit-subscription-meta","exit-subscription-ui","pending-network","environment-spec","browser-reset","environment-audit"};
  static void check(String name,boolean valid){if(!valid)throw new AssertionError(name);checks.add(name);}
  static Path file(Path base,String relative,byte...bytes)throws IOException{Path value=base.resolve(relative);Files.createDirectories(value.getParent());Files.write(value,bytes);return value;}
  static Map<Path,byte[]> protectedFiles(Path data)throws IOException{
    Map<Path,byte[]> expected=new LinkedHashMap<>();
    for(String relative:new String[]{"no_backup/profiles/env3/gecko-cpu.sealed","no_backup/profiles/env3/gecko-cpu.lock","no_backup/shared-maintenance.lock","files/profiles/env3/private.txt","no_backup/shared-catalog.sealed","files/shared-download-library.db","files/saved-downloads/user.bin","files/profiles/env2/saved-downloads/user.bin","files/profiles/env3/saved-downloads/user.bin"}){
      Path value=relative.endsWith(".lock")?file(data,relative):file(data,relative,(byte)9,(byte)8,(byte)7);expected.put(value,Files.readAllBytes(value));
    }
    return expected;
  }
  static void preserved(Map<Path,byte[]> expected,String scope)throws IOException{for(Map.Entry<Path,byte[]> entry:expected.entrySet())check(scope+" preserved "+entry.getKey().getFileName(),Files.isRegularFile(entry.getKey())&&Arrays.equals(entry.getValue(),Files.readAllBytes(entry.getKey())));}
  static void slotZero(Path data,boolean malformed)throws Exception{
    Files.createDirectories(data.resolve("cache"));Files.createDirectories(data.resolve("no_backup"));Files.createDirectories(data.resolve("files"));
    Map<Path,byte[]> protectedFiles=protectedFiles(data);Path cpu=file(data,"no_backup/gecko-cpu.sealed",malformed?(byte)255:(byte)0,(byte)3,(byte)1),cpuLock=file(data,"no_backup/gecko-cpu.lock");
    for(String name:OLD_PRIVATE)file(data,"no_backup/"+name+".sealed",(byte)255,(byte)2);
    for(String relative:new String[]{"no_backup/gecko-browser.yaml","no_backup/network-runtime/state","no_backup/environment-spec.lock","no_backup/gecko-browser/session","no_backup/gecko-session.json","no_backup/subscription-preview-old.sealed","files/network-import.json","cache/gecko-uploads/file","cache/download-old.part","cache/browser-download-old.part"})file(data,relative,(byte)6);
    SecretStore.removed.clear();ActualDeletionCleanup.run(data.toFile(),0,new FixtureProfile(data,0));
    check("CPU sealed file removed for "+(malformed?"malformed":"stale opaque")+" slot-zero record",!Files.exists(cpu));
    check("Empty CPU store lock removed for "+(malformed?"malformed":"stale opaque")+" slot-zero record",!Files.exists(cpuLock));
    for(String name:OLD_PRIVATE)check("Original private sealed name still removed: "+name,!Files.exists(data.resolve("no_backup/"+name+".sealed")));
    Set<String> expected=new HashSet<>(Arrays.asList(OLD_PRIVATE));expected.add("gecko-cpu");check("Every original private name and CPU reaches the remove boundary",SecretStore.removed.containsAll(expected));
    check("Actual startup profile and runtime leftovers removed",!Files.exists(data.resolve("no_backup/gecko-browser"))&&!Files.exists(data.resolve("no_backup/network-runtime"))&&!Files.exists(data.resolve("no_backup/gecko-browser.yaml")));
    check("Actual temporary upload/download cleanup remains",!Files.exists(data.resolve("cache/gecko-uploads"))&&!Files.exists(data.resolve("cache/download-old.part"))&&!Files.exists(data.resolve("cache/browser-download-old.part")));
    check("Trusted root directories remain",Files.isDirectory(data.resolve("no_backup"))&&Files.isDirectory(data.resolve("cache"))&&Files.isDirectory(data.resolve("files")));
    preserved(protectedFiles,"Slot zero");
  }
  static void slotTwo(Path data)throws Exception{
    Files.createDirectories(data.resolve("cache"));Files.createDirectories(data.resolve("no_backup"));Files.createDirectories(data.resolve("files"));Map<Path,byte[]> protectedFiles=protectedFiles(data);
    file(data,"files/profiles/env2/private.txt",(byte)4);file(data,"cache/profiles/env2/old-cache",(byte)5);file(data,"no_backup/profiles/env2/gecko-cpu.sealed",(byte)255);file(data,"no_backup/gecko-cpu.sealed",(byte)1);byte[] zero=Files.readAllBytes(data.resolve("no_backup/gecko-cpu.sealed"));Path cpuLock=file(data,"no_backup/profiles/env2/gecko-cpu.lock"),zeroLock=file(data,"no_backup/gecko-cpu.lock");
    SecretStore.removed.clear();ActualDeletionCleanup.run(data.toFile(),2,new FixtureProfile(data,2));
    check("Existing slot-N branch removes CPU sidecar with private environment tree",!Files.exists(data.resolve("no_backup/profiles/env2"))&&!Files.exists(data.resolve("cache/profiles/env2"))&&!Files.exists(data.resolve("files/profiles/env2/private.txt")));
    check("Existing slot-N branch removes its empty CPU store lock",!Files.exists(cpuLock));
    check("Slot-N branch does not call slot-zero sealed name removal",SecretStore.removed.isEmpty());
    check("Slot-N cleanup leaves default environment CPU record byte-identical",Arrays.equals(zero,Files.readAllBytes(data.resolve("no_backup/gecko-cpu.sealed"))));
    check("Slot-N cleanup preserves default environment empty CPU lock",Files.isRegularFile(zeroLock)&&Files.size(zeroLock)==0);
    preserved(protectedFiles,"Slot two");
  }
  static String quoted(String value){return "\""+value.replace("\\","\\\\").replace("\"","\\\"")+"\"";}
  public static void main(String[] args)throws Exception{Path root=Paths.get(args[0]);slotZero(root.resolve("stale"),false);slotZero(root.resolve("corrupt"),true);slotTwo(root.resolve("slot-two"));StringBuilder names=new StringBuilder();for(String name:checks){if(names.length()>0)names.append(',');names.append(quoted(name));}System.out.println("{\"status\":\"passed\",\"passed\":"+checks.size()+",\"total\":"+checks.size()+",\"checks\":["+names+"]}");}
}

final class FixtureProfile {
  final Path data;final int slot;FixtureProfile(Path data,int slot){this.data=data;this.slot=slot;}
  File folder(String name){return data.resolve(slot==0?name:name+"/profiles/env"+slot).toFile();}
  File getNoBackupFilesDir(){return folder("no_backup");}File getCacheDir(){return folder("cache");}File getFilesDir(){return folder("files");}
}
/** Opaque sealed-file removal boundary only, no Android Keystore/decryption. */
final class SecretStore {
  static final Set<String> removed=new HashSet<>();final FixtureProfile profile;SecretStore(FixtureProfile profile){this.profile=profile;}
  void remove(String name)throws IOException{if(!name.matches("[a-z-]+"))throw new IOException("Invalid fixture sealed name");removed.add(name);Files.deleteIfExists(new File(profile.getNoBackupFilesDir(),name+".sealed").toPath());}
}

final class ActualDeletionCleanup {
  static void run(File data,int slot,FixtureProfile profile)throws Exception{
/*ACTUAL_CLEANUP_BRANCH*/
  }
/*ACTUAL_ERASE_METHOD*/
}

package local.pocketchat;

import android.content.Context;import android.os.*;import org.json.*;import java.util.*;import java.util.concurrent.*;import java.util.concurrent.atomic.*;

/** Actual cache/query/page/read-gate code; declared snapshot/update-provider adapters and counted JSON reads. */
public final class DownloadWorkerPerformanceCases {
  static final boolean before=Boolean.getBoolean("before");static final JSONArray checks=new JSONArray(),measurements=new JSONArray();
  static void check(String name,boolean value){checks.put(J.obj("name",name,"pass",value));if(!value)throw new AssertionError(name);}
  static final class CountingRow extends JSONObject {
    static long names;
    @Override public String optString(String key,String fallback){if(key.equals("name"))names++;return super.optString(key,fallback);}
  }
  static void rows(int count)throws Exception{
    DownloadDisplaySnapshot.data=new JSONArray();DownloadDisplaySnapshot.owners=new LinkedHashMap<>();DownloadDisplaySnapshot.owners.put(0,new DownloadOwnerLabels.Owner(0,"工作","owner",1,true,false,false));
    for(int i=0;i<count;i++){CountingRow row=new CountingRow();row.put("slot",0).put("id","file"+i).put("state","saved").put("name","report-"+((i*7919)%count)+".pdf").put("mime","application/pdf").put("uri","content://fixture/"+i).put("time",i+1).put("environmentId","owner").put("environmentGeneration",1);DownloadDisplaySnapshot.data.put(row);}
    DownloadLibraryChanges.revision.incrementAndGet();DownloadDisplaySnapshot.reads=AppUpdates.calls=0;CountingRow.names=0;
  }
  static DownloadDisplayCache.Page read(String anchor,String viewed,DownloadQuery query)throws Exception{
    CompletableFuture<DownloadDisplayCache.Page> result=new CompletableFuture<>();DownloadDisplayCache.request(new Context(),0,anchor,viewed,query,result::complete,result::completeExceptionally);return result.get(30,TimeUnit.SECONDS);
  }
  static void pagination()throws Exception{
    rows(10000);DownloadQuery query=new DownloadQuery("report","",0,4);DownloadDisplayCache.Page first=read("","",query);long firstNames=CountingRow.names;
    check("Ten-thousand-record filename view has exact bounded first page",first.window.total==10000&&first.window.rows.length()==40);CountingRow.names=0;
    DownloadDisplayCache.Page current=first;Set<String> seen=new HashSet<>();String anchor=current.window.next;
    for(int page=0;page<6;page++){current=read(anchor,"",query);check("Subsequent discovered page remains bounded",current.window.rows.length()==40);for(int i=0;i<current.window.rows.length();i++)check("Subsequent pages contain distinct identities",seen.add(DownloadListPolicy.key(current.window.rows.getJSONObject(i))));anchor=current.window.next;}
    long laterNames=CountingRow.names;measurements.put(J.obj("workload","10000 rows, name search+sort, six later pages","initialNameReads",firstNames,"laterPageNameReads",laterNames,"snapshotReads",DownloadDisplaySnapshot.reads,"displayedRows",seen.size()));
    check("Paging reuses the existing full snapshot",DownloadDisplaySnapshot.reads==1);
    if(before)check("Captured baseline scans and re-sorts history for every uncached page",laterNames>100000);else check("Indexed pages do no whole-library filename reads",laterNames==0);
    CountingRow.names=0;DownloadDisplayCache.Page same=read(current.window.rows.length()==0?"":DownloadListPolicy.key(current.window.rows.getJSONObject(0)),"",query);int reused=0;Map<String,String> prior=same.times;
    for(int i=0;i<100;i++){DownloadDisplayCache.Page next=read(DownloadListPolicy.key(same.window.rows.getJSONObject(0)),"",query);if(prior==next.times)reused++;prior=next.times;same=next;}
    measurements.put(J.obj("workload","100 same-page progress/status requests","reusedPreparedMetadataMaps",reused,"historyNameReads",CountingRow.names));
    check("Same-page refresh does not re-scan names",CountingRow.names==0);if(before)check("Captured baseline copies prepared metadata maps",reused==0);else check("Prepared metadata maps are shared across unchanged refreshes",reused==100);
    DownloadLibraryChanges.revision.incrementAndGet();CountingRow.names=0;read("","",query);check("A changed library invalidates the selected index",CountingRow.names>0&&DownloadDisplaySnapshot.reads==2);
    if(!before){DownloadDisplayCache.Page kept=read("0:id:file0","0:id:file9999",DownloadQuery.all());boolean includes=false;for(int i=0;i<kept.window.rows.length();i++)includes|="file9999".equals(kept.window.rows.getJSONObject(i).optString("id"));check("Index still follows a surviving viewed row outside the anchor window",includes);}
  }
  static void staleQueue()throws Exception{
    rows(10000);CountDownLatch workerHeld=new CountDownLatch(1),release=new CountDownLatch(1),callbacks=new CountDownLatch(100);AtomicInteger succeeded=new AtomicInteger(),cancelled=new AtomicInteger();
    DownloadDisplayCache.worker.execute(()->{workerHeld.countDown();try{release.await();}catch(InterruptedException error){throw new RuntimeException(error);}});check("Worker held before queued search workload",workerHeld.await(5,TimeUnit.SECONDS));
    /* SCOPE_DECLARATION */
    for(int i=0;i<100;i++){DownloadQuery query=new DownloadQuery("report "+i,"",0,0);/* QUEUED_REQUEST */}
    release.countDown();check("Every obsolete/current request completes a callback",callbacks.await(30,TimeUnit.SECONDS));
    measurements.put(J.obj("workload","100 queued searches, only final view remains","successCallbacks",succeeded.get(),"cancelCallbacks",cancelled.get(),"historyNameReads",CountingRow.names,"snapshotReads",DownloadDisplaySnapshot.reads,"providerReads",AppUpdates.calls));
    if(before)check("Captured baseline executes all obsolete full-library searches",succeeded.get()==100&&cancelled.get()==0&&CountingRow.names==1000000&&AppUpdates.calls==100);
    else check("Obsolete scopes stop before snapshot/query/provider work and release loading callbacks",succeeded.get()==1&&cancelled.get()==99&&CountingRow.names==10000&&DownloadDisplaySnapshot.reads==1&&AppUpdates.calls==1);
  }
  static void independentScopes()throws Exception{
    /* INDEPENDENT_SCOPES */
  }
  static void readGate()throws Exception{
    /* READ_GATE */
  }
  public static void main(String[] args)throws Exception{
    pagination();staleQueue();independentScopes();readGate();System.out.println(J.obj("status","passed","variant",before?"before":"after","checks",checks,"total",checks.length(),"measurements",measurements,"actualAndroidExecution",false,"actualSqliteExecution",false,"phoneFrameMeasurement",false,"scope","Production cache/query/page/read-gate on real serial worker/main queue; counted JSON field reads and explicit snapshot/provider adapters. No elapsed-time or phone-FPS claim.").toString(2));
  }
}
class DownloadDisplaySnapshot{static JSONArray data;static Map<Integer,DownloadOwnerLabels.Owner> owners;static int reads;static JSONArray read(Context c){reads++;return data;}static Map<Integer,DownloadOwnerLabels.Owner> owners(Context c){return owners;}}
class DownloadLibraryChanges{static final AtomicLong revision=new AtomicLong();}
class Profiles{static Context global(Context c){return c;}}
class AppUpdates{static int calls;static Bundle call(Context c,String method,Bundle ignored){calls++;Bundle b=new Bundle();b.putLong("packageStoredBytes",calls);return b;}}
